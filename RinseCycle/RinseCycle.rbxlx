----------------------------------------------------------------------------------------------------
-- Plans: each character's loop, as steps that each say where they are and how they're posed
----------------------------------------------------------------------------------------------------

type Step = { T0: number, Dur: number, Root: (number) -&gt; (number, number, number), Pose: (number, any) -&gt; Pose, Hold: { [string]: any }? }

local Plan = {}
Plan.__index = Plan

local WALK_SPEED = 115 -- studs a second
local TURN_SPEED = 3.2 -- radians a second

local function newPlan(actor: any, x: number, z: number, phi: number): any
	local self = setmetatable({}, Plan)
	self.Actor = actor
	self.X, self.Z, self.Phi = x, z, phi
	self.T = 0
	self.Steps = {} :: { Step }
	self.Sit = nil :: any -- the seat while sitting
	return self
end

function Plan:add(dur: number, root: (number) -&gt; (number, number, number), pose: (number, any) -&gt; Pose, hold: { [string]: any }?)
	table.insert(self.Steps, { T0 = self.T, Dur = dur, Root = root, Pose = pose, Hold = hold })
	self.T += dur
end

-- Stand (or sit, if seated) where we are for dur seconds.
function Plan:still(dur: number, pose: (number, any) -&gt; Pose, hold: { [string]: any }?)
	local x, z, phi = self.X, self.Z, self.Phi
	local seat = self.Sit
	self:add(dur, function()
		return x, z, phi
	end, function(u, ctx)
		local p = pose(u, ctx)
		if seat then
			p.sit = p.sit or 1
			p.seat = seat.Top
		end
		return p
	end, hold)
	self.Steps[#self.Steps].Seated = seat ~= nil
end

-- Splits a step at `at` seconds; the second half carries `hold`.
function Plan:split(step: any, at: number, hold: { [string]: any }?)
	for i, st in self.Steps do
		if st == step then
			local root, pose = st.Root, st.Pose
			local rest = { T0 = st.T0 + at, Dur = st.Dur - at, Hold = hold, Seated = st.Seated, Offset = (st.Offset or 0) + at }
			rest.Root = function(u)
				return root(u + at)
			end
			rest.Pose = function(u, ctx)
				return pose(u + at, ctx)
			end
			st.Dur = at
			table.insert(self.Steps, i + 1, rest)
			return rest
		end
	end
	return nil
end

-- A still step whose held props change halfway (picking something up / putting it down).
function Plan:swap(dur: number, pose: (number, any) -&gt; Pose, before: { [string]: any }?, after: { [string]: any }?)
	self:still(dur, pose, before)
	self:split(self.Steps[#self.Steps], dur / 2, after)
end

-- Turn on the spot to face phi (little steps while turning).
function Plan:turn(phi: number, hold: { [string]: any }?, carry: ((number, any) -&gt; Pose)?)
	local from = self.Phi
	local d = angleDiff(from, phi)
	if math.abs(d) &lt; 0.05 then
		self.Phi = phi
		return
	end
	local dur = math.max(0.3, math.abs(d) / TURN_SPEED)
	local x, z = self.X, self.Z
	self:add(dur, function(u)
		return x, z, from + d * smooth(u / dur)
	end, function(u, ctx)
		local p = if carry then carry(u, ctx) else {}
		p.walk = u / dur * PI * 2
		p.stride = 0.25
		return p
	end, hold)
	self.Phi = phi
end

-- Walk through points (room x, z), turning first to face the way.
function Plan:walk(points: { Vector2 }, hold: { [string]: any }?, carry: ((number, any) -&gt; Pose)?, speed: number?, backwards: boolean?)
	local pts = { Vector2.new(self.X, self.Z) }
	for _, p in points do
		table.insert(pts, p)
	end
	local lens = {}
	local total = 0
	for i = 2, #pts do
		lens[i] = (pts[i] - pts[i - 1]).Magnitude
		total += lens[i]
	end
	if total &lt; 1 then
		return
	end
	local first = pts[2] - pts[1]
	if not backwards then
		self:turn(phiOf(first.X, first.Y), hold, carry)
	end
	local v = speed or (if backwards then WALK_SPEED * 0.45 else WALK_SPEED)
	local dur = total / v
	local function at(d: number): Vector2
		d = math.clamp(d, 0, total)
		for i = 2, #pts do
			if d &lt;= lens[i] or i == #pts then
				local k = if lens[i] &gt; 0 then math.clamp(d / lens[i], 0, 1) else 1
				return pts[i - 1]:Lerp(pts[i], k)
			end
			d -= lens[i]
		end
		return pts[#pts]
	end
	local startPhi = self.Phi
	local stride = self.Actor.S * 0.95
	self:add(dur, function(u)
		local d = u * v
		local p = at(d)
		local ahead = at(d + 45) - at(d - 45)
		local phi = if ahead.Magnitude &gt; 1 and not backwards then phiOf(ahead.X, ahead.Y) else startPhi
		return p.X, p.Y, phi
	end, function(u, ctx)
		local p = if carry then carry(u, ctx) else {}
		p.stride = math.clamp(math.min(u / 0.3, (dur - u) / 0.45), 0.15, 1) * (p.stride or 1)
		p.walk = (if backwards then -1 else 1) * u * v / stride * PI
		p.bob = math.abs(math.sin(u * v / stride * PI)) * 0.04
		return p
	end, hold)
	local last = pts[#pts]
	local lastDir = pts[#pts] - pts[#pts - 1]
	self.X, self.Z = last.X, last.Y
	if not backwards then
		self.Phi = phiOf(lastDir.X, lastDir.Y)
	end
end

-- While sitting down / standing up with something in both hands, keep it at chest height.
local function carryArms(p: any, ctx: any, hold: { [string]: any }?): any
	if not hold then
		return p
	end
	local both = false
	for _, h in hold do
		if type(h) == "table" and h[1] == "both" then
			both = true
		end
	end
	if not both then
		return p
	end
	local s = ctx.Actor.S
	local pelvis = lerp(2 * s, (p.seat or 0) + 0.37 * s, p.sit or 0)
	local h = pelvis + 1.65 * s
	local toWorld = ctx.Origin * rootCF(ctx.X, ctx.Z, ctx.Phi)
	p.armL = { at = (toWorld * CFrame.new(-0.5 * s, h, -0.85 * s)).Position }
	p.armR = { at = (toWorld * CFrame.new(0.5 * s, h, -0.85 * s)).Position }
	return p
end

-- From beside a seat: turn to the seat's facing and slide into it while sitting down.
function Plan:sitDown(seat: any, hold: { [string]: any }?, slide: boolean?)
	self:turn(seat.Phi, hold)
	local x0, z0 = self.X, self.Z
	local phi = seat.Phi
	local dur = 1.1
	-- step in front of the seat first, then sit (or, `slide`, sit while sliding on sideways)
	self:add(dur, function(u)
		if slide then
			local k = smooth(u / dur)
			return lerp(x0, seat.X, k), lerp(z0, seat.Z, k), phi
		end
		local k = smooth(u / (dur * 0.55))
		return lerp(x0, seat.X, k), lerp(z0, seat.Z, k), phi
	end, function(u, ctx)
		local p
		if slide then
			p = { sit = smooth(u / dur * 1.4), seat = seat.Top, legs = { kneeL = -PI / 2, kneeR = -PI / 2 }, armL = { p = 0.25, r = 0.08, e = 0.55 }, armR = { p = 0.25, r = 0.08, e = 0.55 } }
		else
			p = { sit = smooth((u / dur - 0.5) / 0.5), seat = seat.Top, walk = if u &lt; dur * 0.55 then u / dur * 9 else nil, stride = 0.3, armL = { p = 0.25, r = 0.08, e = 0.55 }, armR = { p = 0.25, r = 0.08, e = 0.55 } }
		end
		return carryArms(p, ctx, hold)
	end, hold)
	self.X, self.Z, self.Phi = seat.X, seat.Z, phi
	self.Sit = seat
end

-- Stand up and slide out to the side point.
function Plan:standUp(to: Vector2, hold: { [string]: any }?, slide: boolean?)
	local seat = self.Sit
	local x1, z1 = to.X, to.Y
	local phi = self.Phi
	local dur = 1.1
	-- stand up in place first, then step out to the side (or, `slide`, slide off sideways)
	self:add(dur, function(u)
		if slide then
			local k = smooth(u / dur)
			return lerp(seat.X, x1, k), lerp(seat.Z, z1, k), phi
		end
		local k = smooth((u / dur - 0.45) / 0.55)
		return lerp(seat.X, x1, k), lerp(seat.Z, z1, k), phi
	end, function(u, ctx)
		local p
		if slide then
			p = { sit = 1 - smooth((u / dur - 0.3) / 0.7), seat = seat.Top, legs = { kneeL = -PI / 2 * (1 - smooth((u / dur - 0.3) / 0.7)), kneeR = -PI / 2 * (1 - smooth((u / dur - 0.3) / 0.7)) }, armL = { p = 0.25, r = 0.08, e = 0.55 }, armR = { p = 0.25, r = 0.08, e = 0.55 } }
		else
			p = { sit = 1 - smooth(u / dur / 0.5), seat = seat.Top, walk = if u &gt; dur * 0.45 then u / dur * 9 else nil, stride = 0.3, armL = { p = 0.25, r = 0.08, e = 0.55 }, armR = { p = 0.25, r = 0.08, e = 0.55 } }
		end
		return carryArms(p, ctx, hold)
	end, hold)
	self.X, self.Z = x1, z1
	self.Sit = nil
end

-- Pads the plan with `fill` until it's exactly `period` long.
function Plan:finish(period: number, fill: (number, any) -&gt; Pose)
	local left = period - self.T
	assert(left &gt; -1e-6, "NPC plan for " .. self.Actor.Name .. " is " .. string.format("%.2f", self.T) .. "s, longer than the loop (" .. period .. "s)")
	if left &gt; 1e-3 then
		self:still(left, fill)
	end
end

function Plan:eval(t: number, origin: CFrame?): (CFrame, Pose, { [string]: any }?, number, Step)
	local steps = self.Steps
	local lo, hi = 1, #steps
	while lo &lt; hi do
		local mid = (lo + hi + 1) // 2
		if steps[mid].T0 &lt;= t then
			lo = mid
		else
			hi = mid - 1
		end
	end
	local st = steps[lo]
	local u = math.clamp(t - st.T0, 0, st.Dur)
	local x, z, phi = st.Root(u)
	local ctx = { T = t, U = u, Dur = st.Dur, X = x, Z = z, Phi = phi, Actor = self.Actor, Seated = st.Seated, Origin = origin or CFrame.identity }
	local pose = st.Pose(u, ctx)
	return rootCF(x, z, phi), pose, st.Hold, u, st
end

----------------------------------------------------------------------------------------------------
-- Pose helpers (u = seconds into the step; world points are built from ctx)
----------------------------------------------------------------------------------------------------

-- A point in front of the character: right (+x), up (y studs above the floor), forward.
local function local3(ctx: any, right: number, up: number, fwd: number): Vector3
	return (ctx.Origin * rootCF(ctx.X, ctx.Z, ctx.Phi) * CFrame.new(right, up, -fwd)).Position
end

local function breathe(u: number): number
	return math.sin(u * 1.7) * 0.012
end

local function lookAround(u: number, amp: number?): any
	local a = amp or 0.35
	return { yaw = math.sin(u * 0.45) * a + math.sin(u * 1.13) * a * 0.3, pitch = math.sin(u * 0.31) * 0.06 }
end

local P = {}

function P.idle(u: number, _ctx: any?): Pose
	return { bob = breathe(u), head = lookAround(u), armL = { p = 0.03, r = 0.06, e = 0.12 }, armR = { p = 0.03, r = 0.06, e = 0.12 } }
end

-- Seated at a table: hands resting on it.
function P.rest(u: number, ctx: any): Pose
	local s = ctx.Actor.S
	return {
		bob = breathe(u),
		head = lookAround(u, 0.3),
		armL = { at = local3(ctx, -0.55 * s, 150 + 28, 1.25 * s) },
		armR = { at = local3(ctx, 0.55 * s, 150 + 28, 1.25 * s) },
	}
end

-- Eating with a fork: plate -&gt; mouth, about every 3.4 s.
function P.eat(u: number, ctx: any): Pose
	local s = ctx.Actor.S
	local cyc = (u % 3.4) / 3.4
	local up = if cyc &lt; 0.35 then 0 elseif cyc &lt; 0.5 then smooth((cyc - 0.35) / 0.15) elseif cyc &lt; 0.72 then 1 else 1 - smooth((cyc - 0.72) / 0.14)
	local plate = local3(ctx, 0.3 * s, 150 + 26, 1.5 * s)
	local chew = if cyc &gt; 0.55 and cyc &lt; 0.95 then math.sin(u * 14) * 0.03 else 0
	return {
		bob = breathe(u),
		lean = 0.08 + up * 0.08,
		head = { yaw = 0, pitch = -0.12 + up * 0.1 + chew, roll = 0 },
		armL = { at = local3(ctx, -0.6 * s, 150 + 28, 1.2 * s) },
		armR = {
			at = function(b)
				local mouth = (b.Head * CFrame.new(0.3 * s, -0.25 * s, -0.75 * s)).Position
				return plate:Lerp(mouth, up)
			end,
			pole = Vector3.new(0, -1, 0),
		},
	}
end


-- Seated / standing activities. Every function takes (u, ctx) and returns a pose.
local TABLE = 150 -- table top, studs above the floor


-- Eating something held in the right hand (a pizza slice, a turkey leg): hand to mouth every 3 s.
function P.bite(u: number, ctx: any): Pose
	local s = ctx.Actor.S
	local cyc = (u % 3) / 3
	local up = if cyc &lt; 0.2 then smooth(cyc / 0.2) elseif cyc &lt; 0.55 then 1 else 1 - smooth((cyc - 0.55) / 0.3)
	local chew = if cyc &gt; 0.25 and cyc &lt; 0.6 then math.sin(u * 16) * 0.035 else 0
	local low = local3(ctx, 0.5 * s, TABLE + 30, 1.1 * s)
	return {
		bob = breathe(u),
		lean = 0.05,
		head = { pitch = -0.05 + chew, yaw = math.sin(u * 0.4) * 0.15 },
		armL = { at = local3(ctx, -0.6 * s, TABLE + 24, 1.2 * s) },
		armR = {
			at = function(b)
				return low:Lerp((b.Head * CFrame.new(0.25 * s, -0.25 * s, -0.8 * s)).Position, up)
			end,
			pole = Vector3.new(0, -1, 0),
		},
	}
end

-- Drinking from a cup held in the right hand: a few sips.
function P.drink(u: number, ctx: any): Pose
	local s = ctx.Actor.S
	local cyc = (u % 4) / 4
	local up = if cyc &lt; 0.25 then smooth(cyc / 0.25) elseif cyc &lt; 0.7 then 1 else 1 - smooth((cyc - 0.7) / 0.25)
	local low = local3(ctx, 0.45 * s, TABLE + 30, 1.25 * s)
	return {
		bob = breathe(u),
		head = { pitch = up * 0.3 },
		armL = { at = local3(ctx, -0.6 * s, TABLE + 24, 1.2 * s) },
		armR = {
			at = function(b)
				return low:Lerp((b.Head * CFrame.new(0.15 * s, -0.3 * s, -0.85 * s)).Position, up)
			end,
			pole = Vector3.new(0, -1, 0),
		},
	}
end

-- Chatting: nodding, hands moving, turned towards `yaw`.
function P.talkTo(yaw: number): (number, any) -&gt; Pose
	return function(u: number, ctx: any): Pose
		local s = ctx.Actor.S
		local g = math.sin(u * 2.3)
		return {
			bob = breathe(u),
			twist = yaw * 0.12,
			head = { yaw = yaw * 0.75 + math.sin(u * 0.9) * 0.08, pitch = math.sin(u * 3.1) * 0.06 },
			armL = { at = local3(ctx, -0.6 * s, TABLE + 24, 1.2 * s) },
			armR = { at = local3(ctx, 0.45 * s + math.sin(u * 1.7) * 8, (if ctx.Seated then 118 else 100) + 1.9 * s + g * 8, 0.95 * s) },
		}
	end
end

function P.laugh(u: number, ctx: any): Pose
	local s = ctx.Actor.S
	local shake = math.sin(u * 18) * 0.02
	return {
		bob = shake,
		lean = (if ctx.Seated then -0.04 else -0.12) + math.sin(u * 9) * 0.03,
		head = { pitch = 0.3 + shake },
		armL = { at = local3(ctx, -0.35 * s, (ctx.Seated and 120 or 100) + 1.8 * s, 0.6 * s) },
		armR = { at = local3(ctx, 0.35 * s, (ctx.Seated and 120 or 100) + 1.8 * s, 0.6 * s) },
	}
end

-- Waving at the players (they're in the dishwasher, at the origin).
function P.wave(u: number, ctx: any): Pose
	local s = ctx.Actor.S
	local dx, dz = -ctx.X, -60 - ctx.Z
	local yaw = angleDiff(ctx.Phi, phiOf(dx, dz))
	return {
		bob = breathe(u),
		head = { yaw = math.clamp(yaw, -1, 1), pitch = 0.1 },
		armL = if ctx.Seated then { at = local3(ctx, -0.6 * s, TABLE + 24, 1.2 * s) } else nil,
		armR = { p = 2.5, r = 0.12 + math.sin(u * 9) * 0.14, e = 0.55 + math.sin(u * 9) * 0.3 },
	}
end

-- The same wave with the left hand (for people whose right side is against a wall).
function P.waveLeft(u: number, ctx: any): Pose
	local p = P.wave(u, ctx)
	local s = ctx.Actor.S
	p.armL = p.armR
	p.armR = if ctx.Seated then { at = local3(ctx, 0.6 * s, TABLE + 32, 1.2 * s) } else nil
	return p
end

function P.clap(u: number, ctx: any): Pose
	local s = ctx.Actor.S
	local k = math.abs(math.sin(u * 7))
	local base = (ctx.Seated and 120 or 100) + 2.3 * s
	return {
		bob = breathe(u),
		head = { pitch = 0.1 },
		armL = { at = local3(ctx, -0.12 * s - k * 0.35 * s, base, 1.1 * s) },
		armR = { at = local3(ctx, 0.12 * s + k * 0.35 * s, base, 1.1 * s) },
	}
end

function P.stretch(u: number, ctx: any): Pose
	local s = ctx.Actor.S
	local k = smooth(math.min(u, 4 - u) / 1.2)
	local base = if ctx.Seated then 118 else 100
	return {
		lean = -0.03 * k,
		head = { pitch = 0.25 * k },
		armL = { at = local3(ctx, -0.6 * s, TABLE + 32, 1.2 * s):Lerp(local3(ctx, -0.55 * s, base + 5.2 * s, 0.25 * s), k) },
		armR = { at = local3(ctx, 0.6 * s, TABLE + 32, 1.2 * s):Lerp(local3(ctx, 0.55 * s, base + 5.2 * s, 0.25 * s), k) },
	}
end

-- Holding a newspaper open in front of the face.
function P.read(u: number, ctx: any): Pose
	local s = ctx.Actor.S
	local turn = math.sin(u * 0.5) * 0.08
	return {
		bob = breathe(u),
		lean = 0.04,
		head = { yaw = turn * 0.5, pitch = -0.3 },
		-- held at arm's length below the chin, so the paper never meets the face
		armL = { at = local3(ctx, -0.66 * s + turn * 20, (if ctx.Seated then 84 else 60) + 2.0 * s, 1.15 * s) },
		armR = { at = local3(ctx, 0.66 * s + turn * 20, (if ctx.Seated then 84 else 60) + 2.0 * s, 1.15 * s) },
	}
end

-- Dozing off at the table, then a start.
function P.doze(u: number, ctx: any): Pose
	local s = ctx.Actor.S
	local k = smooth(u / 2)
	return {
		bob = math.sin(u * 1.1) * 0.02,
		lean = 0.08 * k,
		head = { pitch = -0.55 * k + math.sin(u * 1.1) * 0.05, roll = 0.15 * k },
		armL = { at = local3(ctx, -0.55 * s, TABLE + 24, 1.15 * s) },
		armR = { at = local3(ctx, 0.55 * s, TABLE + 24, 1.15 * s) },
	}
end

function P.startle(u: number, ctx: any): Pose
	local k = 1 - smooth(u / 1.5)
	return {
		bob = math.sin(u * 20) * 0.02 * k,
		lean = (if ctx.Seated then -0.02 else -0.1) * k,
		head = { pitch = 0.2 * k, yaw = math.sin(u * 8) * 0.3 * k },
		armL = { p = 1.2 * k, r = 0.8 * k, e = 0.8 },
		armR = { p = 1.2 * k, r = 0.8 * k, e = 0.8 },
	}
end

-- Both hands reaching to (right, up, forward) points and back: pick up / put down over `dur`.
function P.reach(lr: number, lu: number, lf: number, rr: number, ru: number, rf: number, dur: number, lean: number?): (number, any) -&gt; Pose
	return function(u: number, ctx: any): Pose
		local k = math.sin(math.clamp(u / dur, 0, 1) * PI)
		local s = ctx.Actor.S
		local restL = local3(ctx, -0.45 * s, 100 + 1.4 * s, 0.75 * s)
		local restR = local3(ctx, 0.45 * s, 100 + 1.4 * s, 0.75 * s)
		return {
			lean = (lean or 0.25) * k,
			head = { pitch = -0.35 * k },
			armL = { at = restL:Lerp(local3(ctx, lr, lu, lf), k) },
			armR = { at = restR:Lerp(local3(ctx, rr, ru, rf), k) },
		}
	end
end

-- Carrying something in both hands in front of the chest (used while walking too).
function P.carry(u: number, ctx: any): Pose
	local s = ctx.Actor.S
	local h = (if ctx.Seated then 118 else 100) + 1.65 * s
	return {
		head = { pitch = -0.08 },
		armL = { at = local3(ctx, -0.5 * s, h, 0.85 * s) },
		armR = { at = local3(ctx, 0.5 * s, h, 0.85 * s) },
	}
end

-- One hand reaching forward (to a fridge, a shelf, the fire).
function P.reachOne(fwd: number, up: number, dur: number): (number, any) -&gt; Pose
	return function(u: number, ctx: any): Pose
		local s = ctx.Actor.S
		local k = math.sin(math.clamp(u / dur, 0, 1) * PI)
		return {
			lean = 0.15 * k,
			head = { pitch = -0.1 * k },
			armR = { at = local3(ctx, 0.5 * s, 100 + 1.2 * s, 0.4 * s):Lerp(local3(ctx, 0.3 * s, up, fwd), k) },
		}
	end
end

function P.point(target: Vector3): (number, any) -&gt; Pose
	return function(u: number, ctx: any): Pose
		local s = ctx.Actor.S
		local dx, dz = target.X - ctx.X, target.Z - ctx.Z
		local yaw = angleDiff(ctx.Phi, phiOf(dx, dz))
		local k = smooth(math.min(u, 3 - u) / 0.5)
		return {
			bob = breathe(u),
			head = { yaw = math.clamp(yaw, -1, 1) * k, pitch = 0.1 * k },
			armL = if ctx.Seated then { at = local3(ctx, -0.6 * s, TABLE + 24, 1.2 * s) } else nil,
			armR = { p = 1.4 * k, y = -yaw * 0.6 * k, r = 0.1, e = 0.05 },
		}
	end
end


----------------------------------------------------------------------------------------------------
-- Scene
----------------------------------------------------------------------------------------------------

local Scene = {}
Scene.__index = Scene

local function newScene(origin: CFrame, parent: Instance): any
	local self = setmetatable({}, Scene)
	local folder = Instance.new("Folder")
	folder.Name = "LevelNPCs"
	folder.Parent = parent
	self.Folder = folder
	local actors = Instance.new("Folder")
	actors.Name = "Actors"
	actors.Parent = folder
	self.ActorFolder = actors
	self.CutsceneMode = false
	self.Origin = origin
	self.Actors = {} :: { any }
	self.Plans = {} :: { any }
	self.Props = {} :: { [string]: any }
	self.Placements = {} :: { [string]: { any } }
	self.Period = 60
	return self
end

function Scene:actor(name: string, lookName: string): any
	local a = buildActor(name, LOOKS[lookName], self.ActorFolder)
	table.insert(self.Actors, a)
	return a
end

function Scene:prop(name: string, kind: string): any
	local p = buildProp(name, PROPS[kind](), self.Folder)
	self.Props[name] = p
	self.Placements[name] = {}
	return p
end

-- The prop sits at `cf` (room space, or a function of the loop time giving one) from loop time t0
-- to t1 (wrapping round the loop).
function Scene:place(name: string, t0: number, t1: number, cf: CFrame | (number) -&gt; CFrame)
	table.insert(self.Placements[name], { t0 % self.Period, t1 % self.Period, cf, t1 - t0 &gt;= self.Period })
end

local function inRange(t: number, a: number, b: number, all: boolean): boolean
	if all then
		return true
	end
	if a &lt;= b then
		return t &gt;= a and t &lt; b
	end
	return t &gt;= a or t &lt; b
end


function Scene:Update(clock: number)
	local t = clock % self.Period
	local parts, cframes = {}, {}
	local origin = self.Origin
	local held: { [string]: boolean } = {}
	-- While a story cutscene plays in this room, the room's people step out: only the furniture
	-- they brought stays (the cutscene brings its own cast).
	local still = self.CutsceneMode
	self.ActorFolder.Parent = if still then nil else self.Folder
	for _, plan in (if still then {} else self.Plans) do
		local root, pose, hold, u, step = plan:eval(t, origin)
		u += step.Offset or 0
		local a = plan.Actor
		a:Pose(origin * root, pose)
		a:Emit(parts, cframes)
		if hold then
			for name, how in hold do
				local prop = self.Props[name]
				if prop then
					held[name] = true
					local spec = if type(how) == "table" then how else { how }
					local where = spec[1]
					local b = a.Bones
					local base
					if where == "R" or where == "L" then
						local g = b["Grip" .. where]
						base = CFrame.new(g.Position) * (origin * root).Rotation
					elseif where == "both" then
						base = CFrame.new(b.GripL.Position:Lerp(b.GripR.Position, 0.5)) * (origin * root).Rotation
					elseif where == "Rhand" or where == "Lhand" then
						base = b["Grip" .. string.sub(where, 1, 1)]
					elseif where == "Head" then
						base = b.Head
					else
						base = origin * root
					end
					local off = spec.off or CFrame.identity
					if type(off) == "function" then
						off = off(u)
					end
					prop:SetScale(if spec.scale then spec.scale(u) else 1)
					prop:SetVisible(true)
					prop:Emit(base * off, parts, cframes)
				end
			end
		end
	end
	for name, prop in self.Props do
		if held[name] then
			continue
		end
		if still and (string.sub(name, 1, 4) ~= "Furn" or (self.CutsceneHide and self.CutsceneHide[name])) then
			prop:SetVisible(false)
			continue
		end
		local shown = false
		for _, pl in self.Placements[name] do
			if inRange(t, pl[1], pl[2], pl[4]) then
				local cf = pl[3]
				if type(cf) == "function" then
					cf = cf(t)
				end
				prop:SetScale(1)
				prop:SetVisible(true)
				prop:Emit(origin * cf, parts, cframes)
				shown = true
				break
			end
		end
		if not shown then
			prop:SetVisible(false)
		end
	end
	local ok = pcall(function()
		Workspace:BulkMoveTo(parts, cframes, Enum.BulkMoveMode.FireCFrameChanged)
	end)
	if not ok then
		for i, p in parts do
			p.CFrame = cframes[i]
		end
	end
end

function Scene:Destroy()
	self.Folder:Destroy()
end


----------------------------------------------------------------------------------------------------
-- The casts
----------------------------------------------------------------------------------------------------

local V2 = Vector2.new
local FORK_HOLD = { "Rhand", off = CFrame.Angles(PI / 2, 0, 0) }
local TOP = FLOOR + 150 -- table top (room y)

local function seat(x: number, z: number, phi: number, top: number): any
	return { X = x, Z = z, Phi = phi, Top = top }
end

local function seated(plan: any, st: any)
	plan.X, plan.Z, plan.Phi = st.X, st.Z, st.Phi
	plan.Sit = st
end


-- Level 1: Family Dinner ---------------------------------------------------------------------------
-- The room's four dining chairs are too close together for grown-ups this size, so the client hides
-- them and seats the family on its own chairs: Dad and the kid on the far side, Mum on the near
-- side (nearest the sink) and Grandpa in a tall chair at the end of the table.
local function buildFamily(scene: any)
	scene.Period = 60
	scene.Hide = { "TablePlate", "ChairSeat", "ChairBack", "ChairLeg" }
	-- Seats sit 5 studs in front of each chair's centre (people perch forward a little).
	local function place(name: string, kind: string, x: number, z: number, phi: number)
		scene:prop(name, kind)
		scene:place(name, 0, 60, rootCF(x, z, phi))
	end
	place("FurnChairDad", "FurnChair", -80, -455, 0)
	place("FurnChairKid", "FurnKidChair", 100, -468, 0)
	place("FurnChairMum", "FurnChair", 0, -205, PI)
	place("FurnChairGrandpa", "FurnHighChair", -340, -380, PI / 2)
	local dadSeat = seat(-80, -452, 0, 98)
	local kidSeat = seat(100, -463, 0, 108)
	local mumSeat = seat(0, -210, PI, 98)
	local gpSeat = seat(-328, -380, PI / 2, 98)

	-- Everyone's dinner, and what's on the table (placed from each seat: right, forward).
	local function atSeat(st: any, right: number, fwd: number, up: number?): CFrame
		local cf = rootCF(st.X, st.Z, st.Phi) * CFrame.new(right, 0, -fwd)
		return CFrame.new(cf.X, TOP + (up or 0), cf.Z) * cf.Rotation
	end
	for i, st in { dadSeat, kidSeat, mumSeat } do
		scene:prop("Meal" .. i, "Spaghetti")
		scene:place("Meal" .. i, 0, 60, atSeat(st, -4, 76))
		scene:prop("Fork" .. i, "Fork")
		scene:place("Fork" .. i, 0, 60, atSeat(st, 34, 72, 1) * CFrame.Angles(0, 0.2, 0))
	end

	-- Dad: stays at the table and enjoys it.
	local dad = scene:actor("Dad", "Dad")
	local pd = newPlan(dad, 0, 0, 0)
	seated(pd, dadSeat)
	scene:prop("DadGlass", "Glass")
	scene:place("DadGlass", 0, 60, atSeat(dadSeat, 30, 64))
	pd:still(9, P.eat, { Fork1 = FORK_HOLD })
	pd:still(6, P.talkTo(-0.9))
	pd:still(5, P.drink, { DadGlass = { "R", off = CFrame.new(0, -9, 0) } })
	pd:still(8, P.eat, { Fork1 = FORK_HOLD })
	pd:still(4, P.wave)
	pd:still(4, P.laugh)
	pd:still(9, P.eat, { Fork1 = FORK_HOLD })
	pd:still(4, P.stretch)
	pd:still(5, P.talkTo(0.8))
	pd:finish(60, P.rest)
	table.insert(scene.Plans, pd)

	-- Grandpa: in his armchair in the corner with the paper, a cup of tea and forty winks.
	local gp = scene:actor("Grandpa", "Grandpa")
	local pg = newPlan(gp, 0, 0, 0)
	seated(pg, gpSeat)
	scene:prop("FurnSideTable", "FurnSideTable")
	local side = rootCF(gpSeat.X, gpSeat.Z, gpSeat.Phi) * CFrame.new(108, 0, -42)
	scene:place("FurnSideTable", 0, 60, side)
	scene:prop("Paper", "Newspaper")
	scene:prop("Tea", "TeaCup")
	scene:place("Tea", 0, 60, side * CFrame.new(-10, 128, 0))
	local paperHold = { "both", off = CFrame.new(0, 10, -3) * CFrame.Angles(-0.35, 0, 0) }
	-- hands resting on the lap
	local function lap(u: number, ctx: any): Pose
		local s = ctx.Actor.S
		return {
			bob = breathe(u),
			head = lookAround(u, 0.3),
			armL = { at = local3(ctx, -0.45 * s, 150, 0.9 * s) },
			armR = { at = local3(ctx, 0.45 * s, 150, 0.9 * s) },
		}
	end
	local function sip(u: number, ctx: any): Pose
		local s = ctx.Actor.S
		local cyc = (u % 4) / 4
		local up = if cyc &lt; 0.25 then smooth(cyc / 0.25) elseif cyc &lt; 0.7 then 1 else 1 - smooth((cyc - 0.7) / 0.25)
		local low = (ctx.Origin * side * CFrame.new(-10, 140, 0)).Position
		return {
			bob = breathe(u),
			head = { pitch = up * 0.3, yaw = 0.2 * (1 - up) },
			armL = { at = local3(ctx, -0.45 * s, 150, 0.9 * s) },
			armR = {
				at = function(b)
					return low:Lerp((b.Head * CFrame.new(0.15 * s, -0.3 * s, -0.85 * s)).Position, up)
				end,
			},
		}
	end
	local function doze(u: number, ctx: any): Pose
		local p = lap(u, ctx)
		local k = smooth(u / 2)
		p.lean = 0.06 * k
		p.head = { pitch = -0.55 * k + math.sin(u * 1.1) * 0.05, roll = 0.15 * k }
		p.bob = math.sin(u * 1.1) * 0.02
		return p
	end
	pg:still(16, P.read, { Paper = paperHold })
	pg:still(1, lap, { Paper = { "both", off = CFrame.new(0, -2, -10) * CFrame.Angles(-PI / 2, 0, 0) } })
	pg:still(6, sip, { Tea = { "R", off = CFrame.new(0, -5, 0) } })
	pg:still(4, P.wave)
	pg:still(14, doze)
	pg:still(2, P.startle)
	pg:still(3, P.laugh)
	pg:finish(60, P.read)
	pg.Steps[#pg.Steps].Hold = { Paper = paperHold }
	for _, st in pg.Steps do
		if st.Hold == nil and st.T0 &gt; 16 and st.T0 &lt; 45 then
			st.Hold = { Paper = { "both", off = CFrame.new(0, -2, -10) * CFrame.Angles(-PI / 2, 0, 0) } }
		end
	end
	table.insert(scene.Plans, pg)

	-- The kid: eats, then fetches a juice from the fridge.
	local kid = scene:actor("Kid", "Kid")
	local pk = newPlan(kid, 0, 0, 0)
	seated(pk, kidSeat)
	scene:prop("Juice", "Juice")
	local juiceHold = { "R", off = CFrame.new(0, -8, 0) }
	local juiceSpot = atSeat(kidSeat, 20, 64)
	local grab = P.reachOne(64, TABLE + 30, 1)
	pk:still(10, P.eat, { Fork2 = FORK_HOLD })
	pk:still(5, P.talkTo(0.9))
	local pickT = pk.T
	pk:swap(1, grab, nil, { Juice = juiceHold })
	pk:standUp(V2(185, -447), { Juice = juiceHold }, true)
	pk:walk({ V2(222, -435), V2(222, -290), V2(220, -205) }, { Juice = juiceHold })
	pk:turn(PI / 2, { Juice = juiceHold })
	pk:still(2, P.reachOne(1.6 * kid.S, 120, 2), { Juice = juiceHold })
	pk:walk({ V2(222, -290), V2(222, -435), V2(185, -447) }, { Juice = juiceHold })
	pk:sitDown(kidSeat, { Juice = juiceHold }, true)
	pk:still(7, P.drink, { Juice = juiceHold })
	local putT = pk.T
	pk:swap(1, grab, { Juice = juiceHold }, nil)
	pk:still(4, P.wave)
	pk:finish(60, P.eat)
	pk.Steps[#pk.Steps].Hold = { Fork2 = FORK_HOLD }
	scene:place("Juice", putT + 0.5, pickT + 0.5 + 60, juiceSpot)
	table.insert(scene.Plans, pk)

	-- Mum: gathers up the spare plates, washes them at the sink right beside the dishwasher, brings
	-- them back and sits down to eat.
	local mum = scene:actor("Mum", "Mum")
	local pm = newPlan(mum, 0, 0, 0)
	seated(pm, mumSeat)
	scene:prop("Stack", "CleanStack")
	scene:prop("WashPlate", "WashPlate")
	local tableSpot = atSeat(mumSeat, 0, 92)
	local counterSpot = W(-222, 112, -32)
	local carry = { Stack = { "both", off = CFrame.new(0, -8, -4) } }
	local toTable = P.reach(-0.48 * S, TABLE + 38, 1.85 * S, 0.48 * S, TABLE + 38, 1.85 * S, 1.2, 0.12)
	local toCounter = P.reach(-1.6 * S, 172, 1.3 * S, -1.2 * S, 172, 1.3 * S, 1.2, 0.2)
	pm:still(7, P.eat, { Fork3 = FORK_HOLD })
	local t1 = pm.T
	pm:swap(1.2, toTable, nil, carry)
	pm:standUp(V2(-190, -205), carry)
	pm:walk({ V2(-200, -165), V2(-150, -165), V2(-150, -102) }, carry, P.carry)
	local t2 = pm.T
	pm:swap(1.2, toCounter, carry, nil)
	-- washing: leaning over the sink, one plate in the suds
	pm:still(9, function(u, ctx)
		local s = ctx.Actor.S
		local c = math.sin(u * 5)
		local d = math.cos(u * 5)
		local out = (rootCF(ctx.X, ctx.Z, ctx.Phi)).RightVector
		return {
			lean = 0.3,
			head = { pitch = -0.4, yaw = math.sin(u * 0.6) * 0.1 },
			armL = { at = local3(ctx, -0.05 * s + c * 6, 176, 1.7 * s), pole = (ctx.Origin.Rotation * -out) + Vector3.new(0, -0.3, 0) },
			armR = { at = local3(ctx, 0.35 * s + c * 12, 178 + d * 5, 1.65 * s + d * 8), pole = (ctx.Origin.Rotation * out) + Vector3.new(0, -0.3, 0) },
		}
	end, { WashPlate = { "Lhand", off = CFrame.new(0, -4, -6) * CFrame.Angles(0, 0, PI / 2) } })
	local t3 = pm.T
	pm:swap(1.2, toCounter, nil, carry)
	pm:walk({ V2(-150, -165) }, carry, P.carry, nil, true)
	pm:walk({ V2(-200, -165), V2(-190, -205) }, carry, P.carry)
	pm:sitDown(mumSeat, carry)
	local t4 = pm.T
	pm:swap(1.2, toTable, carry, nil)
	pm:still(6, P.eat, { Fork3 = FORK_HOLD })
	pm:still(5, P.talkTo(0.8))
	pm:finish(60, P.eat)
	pm.Steps[#pm.Steps].Hold = { Fork3 = FORK_HOLD }
	-- the plates: on the table, in her hands, on the counter, in her hands, on the table
	scene:place("Stack", t4 + 0.6, t1 + 0.6 + 60, tableSpot)
	scene:place("Stack", t2 + 0.6, t3 + 0.6, counterSpot)
	table.insert(scene.Plans, pm)
end

-- Level 2: Pizza Party -----------------------------------------------------------------------------
-- The chef works the brick oven from the open floor east of the right-hand table and serves that
-- table from its end with the peel; two guests at that table take the slices as they come. A kid at
-- the other table has their own pizza, and the waiter brings drinks from the fridges on the left.
local function buildPizzeria(scene: any)
	scene.Period = 48
	scene.Hide = { "Pizza", "PizzaSauce", "Pepperoni", "StoolSeat", "StoolPost" }
	scene.HideWhere = function(name: string, pos: Vector3): boolean
		-- the stools everywhere; the pizza only on the right-hand table (the chef serves that one)
		return name == "StoolSeat" or name == "StoolPost" or pos.X &gt; 0
	end
	local tray = W(150, TOP + 0.4, -400)
	scene:prop("Tray", "Tray")
	scene:place("Tray", 0, 48, tray)
	local function stool(name: string, st: any)
		scene:prop(name, "FurnStool")
		scene:place(name, 0, 48, rootCF(st.X, st.Z, st.Phi) * CFrame.new(0, 0, 6))
	end
	local function atSeat(st: any, right: number, fwd: number, up: number?): CFrame
		local cf = rootCF(st.X, st.Z, st.Phi) * CFrame.new(right, 0, -fwd)
		return CFrame.new(cf.X, TOP + (up or 0.4), cf.Z) * cf.Rotation
	end

	-- The chef ---------------------------------------------------------------------------------
	local chef = scene:actor("Chef", "Chef")
	scene:prop("Peel", "Peel")
	scene:prop("Raw", "RawPizza")
	scene:prop("Hot", "HotPizza")
	local mouth = V2(250, -250)
	local home = V2(316, -425)
	local dir = (mouth - home).Unit
	local facing = phiOf(dir.X, dir.Y)
	local pushed = home + dir * 40
	local serveAt = V2(300, -384)
	local pc = newPlan(chef, home.X, home.Y, facing)
	local function peelPose(fwd: number, up: number)
		return function(u, ctx)
			local s = ctx.Actor.S
			return {
				bob = breathe(u),
				lean = 0.08,
				head = { pitch = -0.1 },
				-- one hand on the handle (a two-handed grip would cross the arms into a block)
				armL = { p = 0.35, r = 0.12, e = 0.7 },
				armR = { at = local3(ctx, 0.35 * s, up, fwd) },
			}
		end
	end
	local peelOff = CFrame.new(0, 0, 0.2 * S) * CFrame.Angles(-0.06, 0, 0)
	local peelHold = { "R", off = peelOff }
	local onPeel = { "R", off = peelOff * CFrame.new(0, 3, -110) }
	local function slide(from: Vector2, to: Vector2, dur: number, fwdA: number, fwdB: number, hold: any)
		pc:add(dur, function(u)
			local p = from:Lerp(to, smooth(u / dur))
			return p.X, p.Y, facing
		end, function(u, ctx)
			local k = smooth(u / dur)
			local p = peelPose(lerp(fwdA, fwdB, k), 150)(u, ctx)
			p.walk = u / dur * PI * 2
			p.stride = 0.3
			return p
		end, hold)
		pc.X, pc.Z = to.X, to.Y
	end
	local pizzaIn = W(250, FLOOR + 113, -190)
	-- 1. slide the raw pizza in
	pc:still(1.5, peelPose(0.6 * S, 150), { Peel = peelHold, Raw = onPeel })
	slide(home, pushed, 1.6, 0.6 * S, 1.2 * S, { Peel = peelHold, Raw = onPeel })
	local tIn = pc.T
	slide(pushed, home, 1.4, 1.2 * S, 0.6 * S, { Peel = peelHold })
	-- 2. wait for it: wipe the brow, check on the guests, tap a foot
	pc:still(6.5, function(u, ctx)
		local s = ctx.Actor.S
		local wipe = if u &gt; 2 and u &lt; 3.6 then math.sin((u - 2) / 1.6 * PI) else 0
		return {
			bob = breathe(u),
			head = { yaw = if u &gt; 4 then 0.9 else 0.1, pitch = 0.05 },
			armL = { at = local3(ctx, -0.3 * s, 100 + 1.3 * s, 0.8 * s) },
			armR = if wipe &gt; 0 then { at = local3(ctx, 0.2 * s, 100 + 3.1 * s, 0.45 * s):Lerp(local3(ctx, -0.1 * s, 100 + 3.3 * s, 0.4 * s), (math.sin(u * 8) + 1) / 2) } else { at = local3(ctx, 0.3 * s, 100 + 1.3 * s, 0.8 * s) },
			legs = { kneeR = if u &gt; 4.5 then -math.abs(math.sin(u * 7)) * 0.3 else nil },
		}
	end, { Peel = { "L", off = CFrame.Angles(-1.35, 0, 0) } })
	-- 3. pull it out, cooked
	slide(home, pushed, 1.4, 0.6 * S, 1.2 * S, { Peel = peelHold })
	local tOut = pc.T
	slide(pushed, home, 1.6, 1.2 * S, 0.6 * S, { Peel = peelHold, Hot = onPeel })
	scene:place("Raw", tIn, tOut, pizzaIn)
	-- 4. turn round and slide it onto the table
	local carrying = { Peel = peelHold, Hot = onPeel }
	pc:walk({ serveAt }, carrying, peelPose(0.6 * S, 150), 60)
	pc:turn(-PI / 2, carrying, peelPose(0.6 * S, 150))
	pc:swap(1.6, function(u, ctx)
		local k = math.sin(math.clamp(u / 1.6, 0, 1) * PI)
		return peelPose(lerp(0.6, 1.3, k) * S, lerp(150, 146, k))(u, ctx)
	end, carrying, { Peel = peelHold })
	local tServe = pc.T - 0.8
	pc:still(2.5, function(u, ctx)
		local p = peelPose(0.6 * S, 150)(u, ctx)
		p.head = { yaw = 0.3, pitch = -0.15 }
		return p
	end, { Peel = peelHold })
	pc:still(2.5, P.point(Vector3.new(0, 0, -40)), { Peel = { "L", off = CFrame.Angles(-1.35, 0, 0) } })
	pc:walk({ home }, { Peel = peelHold }, peelPose(0.6 * S, 150), 60)
	pc:turn(facing, { Peel = peelHold }, peelPose(0.6 * S, 150))
	-- 5. a breather, then dip the peel for the next pizza
	pc:still(4, P.laugh, { Peel = { "L", off = CFrame.Angles(-1.35, 0, 0) } })
	pc:still(4, P.idle, { Peel = { "L", off = CFrame.Angles(-1.35, 0, 0) } })
	pc:swap(2, peelPose(0.6 * S, 132), { Peel = peelHold }, { Peel = peelHold, Raw = onPeel })
	pc:finish(48, peelPose(0.6 * S, 150))
	pc.Steps[#pc.Steps].Hold = { Peel = peelHold, Raw = onPeel }
	table.insert(scene.Plans, pc)

	-- The guests at the right-hand table take the slices in turns --------------------------------
	local g1 = scene:actor("Guest1", "Guest1")
	local nearSeat = seat(122, -300, PI, 94)
		stool("FurnStool1", nearSeat)
	local slices = {}
	for i = 1, 6 do
		local name = "Slice" .. i
		scene:prop(name, "Slice")
		slices[i] = name
	end
	-- slice i: crust out at angle a, tip at the centre
	local function sliceSpot(i: number): CFrame
		local a = (i - 1) / 6 * PI * 2
		return tray * CFrame.new(0, 1.2, 0) * CFrame.Angles(0, a, 0) * CFrame.new(0, 0, -34) * CFrame.Angles(0, PI, 0)
	end
	local takes = { 2.0, 6.6, 11.2, 15.8, 20.4, 25.0 } -- after serving
	local eatDur = 3.4
	for gi, guest in { { a = g1, st = nearSeat, first = 1 } } do
		local pl = newPlan(guest.a, 0, 0, 0)
		seated(pl, guest.st)
		local sodaName = "Soda" .. gi
		scene:prop(sodaName, "Soda")
		scene:place(sodaName, 0, 48, atSeat(guest.st, 30, 64))
		local sodaHold = { "R", off = CFrame.new(0, -11, 0) }
		local before = tServe - 0.5
		local chunks = {
			{ 5, P.talkTo(if gi == 1 then 0.3 else -0.3) },
			{ 4, P.drink, { [sodaName] = sodaHold } },
			{ 3, P.laugh },
			{ 3, P.wave },
		}
		local t = 0
		local idx = gi
		while t &lt; before - 0.01 do
			local c = chunks[(idx - 1) % #chunks + 1]
			local d = math.min(c[1], before - t)
			pl:still(d, c[2], c[3])
			t += d
			idx += 1
		end
		pl:still(1.5, P.clap)
		for k = guest.first, 6 do
			local takeAt = math.max(tServe + takes[k], pl.T)
			if takeAt - pl.T &gt; 1e-3 then
				pl:still(takeAt - pl.T, P.rest)
			end
			local sliceName = slices[k]
			local off = CFrame.new(0, 0, 6) * CFrame.Angles(0.5, 0, 0)
			local s = guest.a.S
			pl:swap(1.2, function(u, ctx)
				local p = P.rest(u, ctx)
				local kk = math.sin(math.clamp(u / 1.2, 0, 1) * PI)
				local spot = (scene.Origin * sliceSpot(k) * CFrame.new(0, 26, 4)).Position
				p.armR = { at = local3(ctx, 0.5 * s, TABLE + 34, 1.1 * s):Lerp(spot, kk) }
				p.lean = 0.12 * kk
				return p
			end, nil, { [sliceName] = { "R", off = off } })
			pl:still(eatDur, P.bite, {
				[sliceName] = {
					"R",
					off = off,
					scale = function(u)
						return math.max(0.25, 1 - u / eatDur * 0.85)
					end,
				},
			})
			scene:place(sliceName, tServe, takeAt + 0.6, sliceSpot(k))
		end
		local rest = 48 - pl.T
		if rest &gt; 0 then
			pl:still(math.min(3, rest), function(u, ctx)
				local s = ctx.Actor.S
				return {
					lean = -0.03,
					head = { pitch = 0.15 },
					armL = { at = local3(ctx, -0.25 * s, 118 + 1.3 * s, 0.62 * s + math.sin(u * 6) * 3) },
					armR = { at = local3(ctx, 0.25 * s, 118 + 1.3 * s, 0.62 * s) },
				}
			end)
		end
		pl:finish(48, P.talkTo(if gi == 1 then 0.3 else -0.3))
		table.insert(scene.Plans, pl)
	end

	-- A kid at the other table with their own pizza, and the waiter --------------------------------
	local g3 = scene:actor("Guest3", "Guest3")
	local kidSeat = seat(-250, -400, PI / 2, 94)
	stool("FurnStool3", kidSeat)
	local p3 = newPlan(g3, 0, 0, 0)
	seated(p3, kidSeat)
	scene:prop("KidSlice", "Slice")
	local kidSlice = {
		"R",
		off = CFrame.new(0, 0, 5) * CFrame.Angles(0.5, 0, 0),
		scale = function(u)
			return math.max(0.25, 1 - u / 9 * 0.8)
		end,
	}
	p3:still(9, P.bite, { KidSlice = kidSlice })
	p3:still(3, P.wave)
	p3:still(4, P.talkTo(-0.8))
	p3:still(9, P.bite, { KidSlice = kidSlice })
	p3:still(3, P.clap)
	p3:still(4, P.laugh)
	p3:still(9, P.bite, { KidSlice = kidSlice })
	p3:finish(48, P.rest)
	table.insert(scene.Plans, p3)

	local g2 = scene:actor("Guest2", "Guest2")
	local eastSeat = seat(-50, -400, -PI / 2, 94)
	stool("FurnStool2", eastSeat)
	local p2 = newPlan(g2, 0, 0, 0)
	seated(p2, eastSeat)
	scene:prop("G2Slice", "Slice")
	scene:prop("G2Soda", "Soda")
	scene:place("G2Soda", 0, 48, atSeat(eastSeat, 30, 64))
	local g2Slice = {
		"R",
		off = CFrame.new(0, 0, 5) * CFrame.Angles(0.5, 0, 0),
		scale = function(u)
			return math.max(0.25, 1 - u / 9 * 0.8)
		end,
	}
	p2:still(5, P.talkTo(0.4))
	p2:still(9, P.bite, { G2Slice = g2Slice })
	p2:still(4, P.drink, { G2Soda = { "R", off = CFrame.new(0, -11, 0) } })
	p2:still(3, P.laugh)
	p2:still(9, P.bite, { G2Slice = g2Slice })
	p2:still(3, P.wave)
	p2:still(4, P.clap)
	p2:finish(48, P.rest)
	table.insert(scene.Plans, p2)

	local waiter = scene:actor("Waiter", "Waiter")
	local fridge = V2(-148, -118)
	local serve = V2(-178, -268)
	local pw = newPlan(waiter, fridge.X, fridge.Y, 0)
	scene:prop("DrinkTray", "Tray")
	scene:prop("Pad", "Notepad")
	scene:prop("Pencil", "Pencil")
	scene:prop("SodaA", "Soda")
	scene:prop("SodaB", "Soda")
	local trayHold = { "both", off = CFrame.new(0, -3, -6) }
	local full = { DrinkTray = trayHold, SodaA = { "both", off = CFrame.new(-14, -2, -6) }, SodaB = { "both", off = CFrame.new(14, -2, -6) } }
	local empty = { DrinkTray = trayHold }
	local tucked = { DrinkTray = { "L", off = CFrame.new(0, 40, 14) * CFrame.Angles(PI / 2, 0, 0) } }
	local putDown = P.reach(-0.48 * S, TABLE + 34, 1.75 * S, 0.48 * S, TABLE + 34, 1.75 * S, 1.4, 0.2)
	-- fetch drinks from the fridge, step back from the counter and bring them over
	pw:swap(1.4, P.reachOne(1.25 * S, 160, 1.4), nil, full)
	pw:walk({ V2(-148, -165) }, full, P.carry, nil, true)
	pw:walk({ serve }, full, P.carry)
	pw:turn(PI, full, P.carry)
	local tPut = pw.T
	pw:swap(1.4, putDown, full, empty)
	-- take an order from the kid
	pw:still(5, function(u, ctx)
		local s = ctx.Actor.S
		local w = math.sin(u * 9) * 4
		return {
			bob = breathe(u),
			head = { yaw = -0.7, pitch = -0.15 + (if u % 2 &lt; 1 then 0.2 else 0) },
			armL = { at = local3(ctx, -0.1 * s, 100 + 2 * s, 0.8 * s) },
			armR = { at = local3(ctx, 0.15 * s + w, 100 + 2.05 * s, 0.7 * s) },
		}
	end, { Pad = { "L", off = CFrame.new(4, 6, -4) * CFrame.Angles(-1.1, 0, 0) }, Pencil = { "R", off = CFrame.Angles(0.6, 0.4, 0) }, DrinkTray = tucked.DrinkTray })
	-- say hello to the tiny people in the dishwasher
	pw:walk({ V2(-178, -190) }, tucked, nil, nil, true)
	pw:turn(0.35, tucked)
	pw:still(3, P.wave, tucked)
	pw:still(3, P.laugh, tucked)
	-- clear the empties from the table
	pw:turn(PI, tucked)
	pw:walk({ serve }, empty, P.carry)
	local tClear = pw.T
	pw:swap(1.4, putDown, empty, full)
	pw:walk({ V2(-148, -165) }, full, P.carry, nil, true)
	pw:turn(0, full, P.carry)
	pw:walk({ fridge }, full, P.carry)
	pw:swap(1.4, P.reachOne(1.25 * S, 160, 1.4), full, nil)
	pw:finish(48, P.idle)
	scene:place("SodaA", tPut + 0.7, tClear + 0.7, W(-192, TOP + 0.4, -358))
	scene:place("SodaB", tPut + 0.7, tClear + 0.7, W(-150, TOP + 0.4, -358))
	table.insert(scene.Plans, pw)
end

-- Level 3: Royal Banquet ---------------------------------------------------------------------------
local function buildCastle(scene: any)
	scene.Period = 60

	-- The room's throne stands too close to the end of the table for a king this size, so on this
	-- client it's swapped for a throne at the head of the table on the right (in place of that chair).
	local kingSeat = seat(94, -414, -PI / 2, 98)
	scene.Hide = { "ThroneSeat", "ThroneBack", "ThroneSpike", "ChairSeat", "ChairBack", "ChairCrest", "ChairLeg", "PlatterOnTable", "GobletStem", "GobletCup", "CandelabraBase", "CandelabraStem", "CandelabraArm", "Candle", "Flame" }
	scene.HideWhere = function(name: string, pos: Vector3): boolean
		if string.sub(name, 1, 6) == "Throne" then
			return true
		end
		-- the chair the throne replaces, and the two places nobody uses at the near end (the
		-- servant's way to the table)
		if string.sub(name, 1, 5) == "Chair" or name == "PlatterOnTable" or string.sub(name, 1, 6) == "Goblet" then
			return true -- a feast for two: the other chairs and places are cleared away
		end
		if string.sub(name, 1, 6) == "Candel" or name == "Candle" or name == "Flame" then
			return pos.Z &gt; -300 -- the candelabra at the near end (where the roast goes)
		end
		return false
	end
	scene:prop("FurnQueenChair", "FurnHighChair")
	scene:place("FurnQueenChair", 0, 60, rootCF(-116, -414, PI / 2))
	scene:prop("FurnThrone", "FurnThrone")
	scene:place("FurnThrone", 0, 60, rootCF(116, -414, -PI / 2))
	local function atKing(right: number, fwd: number, up: number?): CFrame
		local cf = rootCF(kingSeat.X, kingSeat.Z, kingSeat.Phi) * CFrame.new(right, 0, -fwd)
		return CFrame.new(cf.X, TOP + (up or 0), cf.Z) * cf.Rotation
	end

	-- The king on his throne.
	local king = scene:actor("King", "King")
	local pkg = newPlan(king, 0, 0, 0)
	seated(pkg, kingSeat)
	scene:prop("KingLeg", "TurkeyLeg")
	scene:prop("KingCup", "Goblet")
	scene:prop("Scepter", "Scepter")
	scene:place("KingCup", 0, 60, atKing(24, 60))
	local legHold = { "R", off = CFrame.new(0, 0, 4) * CFrame.Angles(0.9, 0, 0) }
	local cupHold = { "R", off = CFrame.new(0, -12, 0) }
	local scepterHold = { "L", off = CFrame.Angles(-0.25, 0, 0) }
	pkg:still(8, P.bite, { KingLeg = legHold, Scepter = scepterHold })
	pkg:still(5, P.drink, { KingCup = cupHold, Scepter = scepterHold })
	pkg:still(4, P.laugh)
	pkg:still(3, P.point(Vector3.new(0, 0, -40)), { Scepter = scepterHold })
	pkg:still(8, P.bite, { KingLeg = legHold, Scepter = scepterHold })
	pkg:still(4, P.clap)
	pkg:still(5, P.talkTo(-0.7), { Scepter = scepterHold })
	pkg:still(4, function(u, ctx) -- a royal toast
		local s = ctx.Actor.S
		local k = smooth(math.min(u, 4 - u) / 0.8)
		return { head = { pitch = 0.2 * k }, armR = { p = 2.6 * k, r = 0.3, e = 0.3 }, armL = { at = local3(ctx, -0.6 * s, TABLE + 24, 1.2 * s) } }
	end, { KingCup = cupHold, Scepter = scepterHold })
	pkg:still(8, P.bite, { KingLeg = legHold, Scepter = scepterHold })
	pkg:finish(60, P.rest)
	pkg.Steps[#pkg.Steps].Hold = { Scepter = scepterHold }
	scene:place("KingLeg", 0, 60, atKing(-6, 70, 5) * CFrame.Angles(0, 0.4, 0))
	table.insert(scene.Plans, pkg)

	-- The queen and two nobles along the sides.
	local diners = {
		{ "Queen", "Queen", seat(-94, -414, PI / 2, 98), 1 },
	}
	for _, d in diners do
		local a = scene:actor(d[1], d[2])
		local pl = newPlan(a, 0, 0, 0)
		local st = d[3]
		seated(pl, st)
		local cup = d[1] .. "Cup"
		scene:prop(cup, "Goblet")
		local function atSeat(right: number, fwd: number, up: number?): CFrame
			local cf = rootCF(st.X, st.Z, st.Phi) * CFrame.new(right, 0, -fwd)
			return CFrame.new(cf.X, TOP + (up or 0), cf.Z) * cf.Rotation
		end
		scene:place(cup, 0, 60, atSeat(24, 60))
		local hold = { [cup] = { "R", off = CFrame.new(0, -12, 0) } }
		local fork = d[1] .. "Fork"
		scene:prop(fork, "Fork")
		scene:place(fork, 0, 60, atSeat(40, 50, 1))
		local fh = { [fork] = FORK_HOLD }
		local order = {
			{ { 7, P.eat, fh }, { 4, P.drink, hold }, { 5, P.talkTo(0.7) }, { 4, P.laugh }, { 8, P.eat, fh }, { 4, P.clap }, { 6, P.talkTo(-0.5) } },
			{ { 5, P.talkTo(-0.6) }, { 8, P.eat, fh }, { 4, P.clap }, { 5, P.drink, hold }, { 4, P.laugh }, { 8, P.eat, fh }, { 4, P.wave } },
			{ { 8, P.eat, fh }, { 4, P.laugh }, { 5, P.drink, hold }, { 4, P.clap }, { 6, P.talkTo(0.8) }, { 8, P.eat, fh } },
			{ { 4, P.drink, hold }, { 8, P.eat, fh }, { 5, P.talkTo(0.7) }, { 4, P.clap }, { 4, P.wave }, { 8, P.eat, fh } },
		}
		for _, c in order[d[4]] do
			if pl.T + c[1] &lt;= 60 then
				pl:still(c[1], c[2], c[3])
			end
		end
		pl:finish(60, P.rest)
		table.insert(scene.Plans, pl)
	end

	-- A servant carries the roast from the mantel over the fire to the end of the table, fetches it
	-- back later and puts it back to keep warm.
	local servant = scene:actor("Servant", "Servant")
	scene:prop("Roast", "Roast")
	local mantelSpot = W(378, FLOOR + 212, -240) * CFrame.Angles(0, PI / 2, 0)
	local tableEnd = W(0, TOP + 0.4, -266)
	scene:prop("ServTray", "Tray")
	local trayOnly = { ServTray = { "both", off = CFrame.new(0, -4, -12) } }
	local roast = { ServTray = trayOnly.ServTray, Roast = { "both", off = CFrame.new(0, -2, -12) } }
	local atMantel = P.reach(-0.48 * S, 222, 1.4 * S, 0.48 * S, 222, 1.4 * S, 1.6, 0)
	local atTable = P.reach(-0.48 * S, TABLE + 34, 1.55 * S, 0.48 * S, TABLE + 34, 1.55 * S, 1.4, 0.2)
	local back = V2(255, -240)
	local up = V2(290, -240)
	local toTable = { V2(250, -182), V2(12, -182), V2(0, -184) }
	local toFire = { V2(40, -182), V2(250, -182), back }
	local ps = newPlan(servant, back.X, back.Y, PI / 2)
	ps:still(2, P.carry, trayOnly)
	ps:walk({ up }, trayOnly, P.carry, 60)
	local tFire = ps.T
	ps:swap(1.6, atMantel, trayOnly, roast)
	ps:walk({ back }, roast, P.carry, nil, true)
	ps:walk(toTable, roast, P.carry, 95)
	ps:turn(PI, roast, P.carry)
	local tServe = ps.T
	ps:swap(1.4, atTable, roast, trayOnly)
	ps:still(1.2, function(u, ctx)
		local p = P.carry(u, ctx)
		p.lean = 0.3 * math.sin(math.clamp(u / 1.2, 0, 1) * PI) -- a bow
		return p
	end, trayOnly)
	ps:walk(toFire, trayOnly, P.carry, 95)
	ps:turn(PI / 2, trayOnly, P.carry)
	ps:still(6, function(u, ctx) -- a moment by the fire
		local p = P.carry(u, ctx)
		p.head = { yaw = math.sin(u * 0.5) * 0.5 }
		p.bob = breathe(u)
		return p
	end, trayOnly)
	ps:walk(toTable, trayOnly, P.carry, 95)
	ps:turn(PI, trayOnly, P.carry)
	local tTake = ps.T
	ps:swap(1.4, atTable, trayOnly, roast)
	ps:walk(toFire, roast, P.carry, 95)
	ps:turn(PI / 2, roast, P.carry)
	ps:walk({ up }, roast, P.carry, 60)
	local tBack = ps.T
	ps:swap(1.6, atMantel, roast, trayOnly)
	ps:walk({ back }, trayOnly, P.carry, nil, true)
	ps:finish(60, P.carry)
	ps.Steps[#ps.Steps].Hold = trayOnly
	table.insert(scene.Plans, ps)
	scene:place("Roast", tServe + 0.7, tTake + 0.7, tableEnd)
	scene:place("Roast", tBack + 0.8, tFire + 0.8 + 60, mantelSpot)

	-- The jester juggles for the king, bows, and cartwheels.
	local jester = scene:actor("Jester", "Jester")
	-- He plays to the players: always turned toward the dishwasher (the room origin).
	local JX, JZ = -205, -200
	local facePlayers = math.atan2(-JX, -JZ)
	local pj = newPlan(jester, JX, JZ, facePlayers)
	local balls = { "BallA", "BallB", "BallC" }
	local ballColors = { rgb(255, 80, 80), rgb(80, 180, 255), rgb(255, 220, 60) }
	for i, n in balls do
		local b = scene:prop(n, "Ball")
		for _, pc in b.Pieces do
			pc.Part.Color = ballColors[i]
		end
	end
	local function juggleHolds(): any
		local h = {}
		for i, n in balls do
			h[n] = {
				"root",
				off = function(u)
					local s = S
					local ph = (u * 1.4 + (i - 1) / 3) % 1
					local fromX = if ph &lt; 0.5 then -0.45 else 0.45
					local x = lerp(fromX, -fromX, ph % 0.5 * 2) * s
					local y = 100 + 1.7 * s + math.sin((ph % 0.5) * 2 * PI) * 1.6 * s
					return CFrame.new(x, y, -0.9 * s)
				end,
			}
		end
		return h
	end
	local function juggle(u: number, ctx: any): Pose
		local s = ctx.Actor.S
		local l = math.sin(u * 1.4 * PI * 2)
		return {
			bob = math.abs(math.sin(u * 4)) * 0.03,
			head = { pitch = 0.3 + math.sin(u * 2.8 * PI) * 0.1 },
			armL = { at = local3(ctx, -0.45 * s, 100 + (1.7 + l * 0.15) * s, 0.85 * s) },
			armR = { at = local3(ctx, 0.45 * s, 100 + (1.7 - l * 0.15) * s, 0.85 * s) },
		}
	end
	local function bow(u: number, ctx: any): Pose
		local k = math.sin(math.clamp(u / 2.2, 0, 1) * PI)
		return { lean = 0.45 * k, head = { pitch = -0.3 * k }, armL = { p = -0.3 * k, r = 0.35 * k, e = 0.2 }, armR = { p = 0.5 * k, r = -0.1, e = 1.8 * k } }
	end
	-- Cartwheels run along the open lane parallel to the dishwasher wall (room X), squared up to the
	-- players, so the spinning arms and legs clear the pillars, the guards and the table.
	local function cartwheel(fromX: number, toX: number, dur: number)
		pj:add(dur, function(u)
			return lerp(fromX, toX, smooth(u / dur)), JZ, 0
		end, function(u, ctx)
			local s = ctx.Actor.S
			local k = math.clamp(u / dur, 0, 1)
			local th = smooth(k) * PI * 2 * (if toX &gt; fromX then -1 else 1)
			local lift = math.sin(k * PI) * 0.7
			return {
				body = CFrame.new(0, (1.1 + lift) * s, 0) * CFrame.Angles(0, 0, th) * CFrame.new(0, -1.1 * s, 0),
				armL = { p = 0, r = 2.9, e = 0 },
				armR = { p = 0, r = 2.9, e = 0 },
				legs = { outL = 0.5 * math.sin(k * PI), outR = 0.5 * math.sin(k * PI) },
			}
		end)
		pj.X, pj.Z, pj.Phi = toX, JZ, 0
	end
	pj:still(9, juggle, juggleHolds())
	pj:still(2.2, bow)
	pj:turn(0)
	cartwheel(JX, JX + 16, 1.1)
	pj:still(1.2, function(u, ctx)
		local p = P.idle(u, ctx)
		p.armL = { p = 0.2, r = 2.6, e = 0.2 }
		p.armR = { p = 0.2, r = 2.6, e = 0.2 }
		return p
	end)
	cartwheel(JX + 16, JX + 34, 1.1)
	pj:still(1.2, P.laugh)
	cartwheel(JX + 34, JX, 1.6) -- and one big one back to his spot
	pj:turn(facePlayers)
	pj:still(9, juggle, juggleHolds())
	pj:still(2.2, bow)
	pj:still(4, P.wave)
	pj:finish(60, juggle)
	pj.Steps[#pj.Steps].Hold = juggleHolds()
	-- between juggling the balls are tucked away
	table.insert(scene.Plans, pj)

	-- Guards: one on duty by the right-hand pillars, one marching along the left side.
	local g1 = scene:actor("Guard1", "Guard")
	local g2 = scene:actor("Guard2", "Guard")
	scene:prop("Spear1", "Spear")
	scene:prop("Spear2", "Spear")
	local spear = function(name: string)
		return { [name] = { "R", off = CFrame.new(0, 0, 0) } }
	end
	local function attention(u: number, ctx: any): Pose
		return {
			bob = breathe(u) * 0.5,
			head = { yaw = math.sin(u * 0.25) * 0.25 },
			armR = { p = 0.35, r = 0.12, e = 1.2 },
			armL = { p = 0, r = 0.02, e = 0.05 },
		}
	end
	-- both stand their posts (a patrol would swing their arms into the armour and pillars)
	local function stomp(u: number, ctx: any): Pose
		local p = attention(u, ctx)
		p.walk = u * PI * 2
		p.stride = 0.25
		return p
	end
	local pa = newPlan(g1, 285, -400, 0)
	pa:still(18, attention, spear("Spear1"))
	pa:still(3, P.point(Vector3.new(0, 0, -40)), spear("Spear1"))
	pa:still(3, stomp, spear("Spear1"))
	pa:still(20, attention, spear("Spear1"))
	pa:still(3, stomp, spear("Spear1"))
	pa:finish(60, attention)
	pa.Steps[#pa.Steps].Hold = spear("Spear1")
	table.insert(scene.Plans, pa)

	local pb = newPlan(g2, -270, -400, 0)
	pb:still(9, attention, spear("Spear2"))
	pb:still(3, stomp, spear("Spear2"))
	pb:still(14, attention, spear("Spear2"))
	pb:still(3, P.laugh, spear("Spear2"))
	pb:still(12, attention, spear("Spear2"))
	pb:still(3, stomp, spear("Spear2"))
	pb:finish(60, attention)
	pb.Steps[#pb.Steps].Hold = spear("Spear2")
	table.insert(scene.Plans, pb)
end

local BUILDERS = { buildFamily, buildPizzeria, buildCastle }

function LevelNPCs.Build(levelIndex: number, origin: CFrame, parent: Instance): any
	local self = newScene(origin, parent)
	local build = BUILDERS[levelIndex] or BUILDERS[1]
	build(self)
	return self
end

-- A test lineup of every look in a few poses (for screenshots).
function LevelNPCs.Lineup(origin: CFrame, parent: Instance): any
	local self = newScene(origin, parent)
	local names = { "Dad", "Mum", "Kid", "Grandpa", "Chef", "Waiter", "Guest1", "Guest2", "King", "Queen", "Noble1", "Servant", "Guard", "Jester" }
	for i, n in names do
		local a = self:actor(n, n)
		local x = (i - 7.5) * 150
		local plan = newPlan(a, x, 0, 0)
		plan:still(10, P.idle)
		plan:finish(10, P.idle)
		table.insert(self.Plans, plan)
	end
	self.Period = 10
	return self
end

----------------------------------------------------------------------------------------------------
-- Runtime: the people for the dishwasher you're playing in
----------------------------------------------------------------------------------------------------

local initialized = false
local cutsceneMode = false
local cutsceneHide: { [string]: boolean } = {}

-- The story cutscene is playing in this room: hide the room's people (their furniture stays,
-- except the pieces named in `hide`, which the cutscene brings and moves itself).
function LevelNPCs.SetCutscene(on: boolean, hide: { string }?)
	cutsceneMode = on == true
	cutsceneHide = {}
	for _, n in (hide or {}) :: { string } do
		cutsceneHide[n] = true
	end
end

function LevelNPCs.Init()
	if initialized then
		return
	end
	initialized = true
	local ClientState = require(script.Parent:WaitForChild("ClientState")) :: any
	local current: any = nil
	local currentArena: Instance? = nil
	local hidden: { [BasePart]: boolean } = {}
	local added: RBXScriptConnection? = nil
	local failed = false

	-- Furniture the NPCs replace (and the right table's pizza in the pizzeria) is hidden on this
	-- client only; it can't be reached from the dishwasher anyway.
	local function hidePart(scene: any, part: Instance)
		if not part:IsA("BasePart") or not scene.HideSet[part.Name] then
			return
		end
		if scene.HideWhere then
			local p = scene.Origin:PointToObjectSpace(part.Position)
			if not scene.HideWhere(part.Name, Vector3.new(p.X, p.Y, -p.Z)) then
				return
			end
		end
		part.LocalTransparencyModifier = 1
		hidden[part] = true
	end

	local function teardown()
		if added then
			added:Disconnect()
			added = nil
		end
		if current then
			pcall(function()
				current:Destroy()
			end)
			current = nil
		end
		for part in hidden do
			if part.Parent then
				part.LocalTransparencyModifier = 0
			end
		end
		table.clear(hidden)
		currentArena = nil
	end

	RunService.Heartbeat:Connect(function()
		local arena = ClientState.GetArena()
		if arena ~= currentArena then
			teardown()
			local originPos = arena and arena:GetAttribute("Origin")
			if arena and typeof(originPos) == "Vector3" then
				currentArena = arena
				local level = tonumber(arena:GetAttribute("Level")) or 1
				local ok, scene = pcall(LevelNPCs.Build, level, CFrame.new(originPos), Workspace)
				if ok then
					current = scene
					scene.HideSet = {}
					for _, n in scene.Hide or {} do
						scene.HideSet[n] = true
					end
					for _, d in arena:GetDescendants() do
						hidePart(scene, d)
					end
					added = arena.DescendantAdded:Connect(function(d)
						hidePart(scene, d)
					end)
				elseif not failed then
					failed = true
					warn("[LevelNPCs] couldn't build the level's people: " .. tostring(scene))
				end
			end
		end
		if current then
			current.CutsceneMode = cutsceneMode
			current.CutsceneHide = cutsceneHide
			local okNow, now = pcall(function()
				return Workspace:GetServerTimeNow()
			end)
			local ok, err = pcall(current.Update, current, if okNow and type(now) == "number" then now else os.clock())
			if not ok and not failed then
				failed = true
				warn("[LevelNPCs] " .. tostring(err))
			end
		end
	end)
end

LevelNPCs.P = P
LevelNPCs.newPlan = newPlan
LevelNPCs.newScene = newScene
LevelNPCs.rootCF = rootCF

-- The rig's building blocks, for anything else that wants to build people the same way: the
-- same rig, looks, props, plans and poses as the people in the rooms.
LevelNPCs.Kit = {
	S = S,
	FLOOR = FLOOR,
	TABLE = TABLE,
	P = P,
	LOOKS = LOOKS,
	PROPS = PROPS,
	newPlan = newPlan,
	newScene = newScene,
	newPart = newPart,
	rootCF = rootCF,
	W = W,
	seat = seat,
	seated = seated,
	smooth = smooth,
	lerp = lerp,
	local3 = local3,
	breathe = breathe,
	lookAround = lookAround,
	angleDiff = angleDiff,
	phiOf = phiOf,
	disc = disc,
	hairShort = hairShort,
	hairLong = hairLong,
	partyHat = partyHat,
	crown = crown,
	glasses = glasses,
	beard = beard,
	apron = apron,
	belt = belt,
	collar = collar,
	FORK_HOLD = FORK_HOLD,
}

return LevelNPCs</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000003C"><Properties><string name="Name">MusicPlayer</string><ProtectedString name="Source">--[[
	MusicPlayer - background music. The lobby and dishwasher runs each have their own playlist
	(Config.Music, IDs from StoreIds &gt; Music), played shuffled, one track after another. Each track
	crossfades into the next (the next one starts 30 seconds before the end), and there's a
	short fade when switching between lobby and run. A "Music" button in the left column turns it
	off / on (remembered for this session). Plays nothing until track IDs are filled in.
]]

local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local Client = script.Parent
local ClientState = require(Client:WaitForChild("ClientState"))

local MusicPlayer = {}

local FADE = 1.2 -- a plain switch (lobby &lt;-&gt; run)
local FADE_OUT = 3 -- the old track fades out over this...
local FADE_IN = 2 -- ...while the next fades in over this

local initialized = false
local enabled = true
local current: Sound? = nil
local currentList = ""
local token = 0

local function fadeOut(sound: Sound, seconds: number?)
	local t = seconds or FADE
	TweenService:Create(sound, TweenInfo.new(t), { Volume = 0 }):Play()
	task.delay(t + 0.1, function()
		sound:Destroy()
	end)
end

-- Plays the given playlist, shuffled, until something else is chosen.
local function listIds(name: string): { number }
	local show = (Config.AbuseShow :: any).Music
	if string.sub(name, 1, 5) == "Abuse" and show then
		return show[string.sub(name, 6)] or {}
	end
	return (Config.Music :: any)[name] or {}
end

-- Plays the given playlist, shuffled, until something else is chosen. There is never silence: a new
-- track is started and loaded first, and only then does the old one fade out (3 s) as the new one
-- fades in (2 s). Tracks hand over 30 seconds before they end (a long track often ends in a quiet
-- tail), or 6 s before for short ones.
local function playList(name: string)
	local ids = listIds(name)
	if name == currentList and current then
		return
	end
	currentList = name
	token += 1
	local myToken = token
	local previous: Sound? = current
	current = nil
	if not enabled or #ids == 0 then
		if previous then
			fadeOut(previous, FADE)
		end
		return
	end
	task.spawn(function()
		local order = table.clone(ids)
		local index = 0
		local failures = 0
		while myToken == token do
			index += 1
			if index &gt; #order then
				-- reshuffle for the next round
				for i = #order, 2, -1 do
					local j = math.random(1, i)
					order[i], order[j] = order[j], order[i]
				end
				index = 1
			end
			local sound = Instance.new("Sound")
			sound.Name = "Music"
			sound.SoundId = "rbxassetid://" .. tostring(order[index])
			sound.Volume = 0
			sound.Parent = SoundService
			current = sound
			sound:Play()
			-- wait for it to load before the old one fades out (a track that never loads is skipped)
			local started = os.clock()
			while myToken == token and sound.Parent and not sound.IsLoaded and os.clock() - started &lt; 8 do
				task.wait(0.1)
			end
			if myToken ~= token or not sound.Parent then
				return -- another playlist took over (it fades this one out)
			end
			if not sound.IsLoaded then
				sound:Destroy()
				current = previous
				failures += 1
				if failures &gt;= #order * 2 then
					if previous then
						fadeOut(previous, FADE)
						current = nil
					end
					return
				end
				continue
			end
			TweenService:Create(sound, TweenInfo.new(FADE_IN), { Volume = Config.Music.Volume }):Play()
			if previous then
				fadeOut(previous, FADE_OUT)
				previous = nil
			end
			-- play until it is time to hand over to the next track
			while myToken == token and sound.Parent do
				if sound.IsLoaded and sound.TimeLength &gt; 0 then
					local handOver = if sound.TimeLength &gt; 75 then sound.TimeLength - 30 else math.max(1, sound.TimeLength - 6)
					if sound.TimePosition &gt;= handOver then
						break
					end
				end
				if not sound.IsPlaying and os.clock() - started &gt; 12 then
					break -- it stopped by itself
				end
				task.wait(0.4)
			end
			if myToken ~= token then
				return
			end
			previous = sound
		end
	end)
end

local function refresh()
	-- During the Admin Abuse show its own music plays (the server sets the attribute "AbuseMusic").
	local show = ReplicatedStorage:GetAttribute("AbuseMusic")
	if show == "Warm" or show == "Heat" then
		playList("Abuse" .. show)
		return
	end
	playList(if ClientState.Run then "Run" else "Lobby")
end

function MusicPlayer.IsEnabled(): boolean
	return enabled
end

function MusicPlayer.SetEnabled(on: boolean)
	enabled = on
	currentList = ""
	if current then
		fadeOut(current)
		current = nil
	end
	token += 1
	refresh()
end

-- Loads the show tracks ahead of time, so there is no gap when it starts.
local function preloadShow()
	local ContentProvider = game:GetService("ContentProvider")
	local list = {}
	local show = (Config.AbuseShow :: any).Music
	for _, key in { "Warm", "Heat" } do
		for _, id in (show and show[key]) or {} do
			local sound = Instance.new("Sound")
			sound.SoundId = "rbxassetid://" .. tostring(id)
			table.insert(list, sound)
		end
	end
	pcall(function()
		ContentProvider:PreloadAsync(list)
	end)
	for _, sound in list do
		sound:Destroy()
	end
end

function MusicPlayer.Init()
	if initialized then
		return
	end
	initialized = true
	task.spawn(function()
		task.wait(8)
		preloadShow()
	end)
	ClientState.Changed:Connect(function(kind)
		if kind == "Run" then
			refresh()
		end
	end)
	ReplicatedStorage:GetAttributeChangedSignal("AbuseMusic"):Connect(refresh)
	refresh()
end

return MusicPlayer</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000003D"><Properties><string name="Name">PartyUI</string><ProtectedString name="Source">--[[
	PartyUI - everything shown while ClientState.Party ~= nil (standing in a lobby pad).

	Two screens, Search-for-the-Needle style:
	  * Create Party (host, Status == "Picking"): a big card for the chosen dishwasher with
	    Public/Friends, Party Size -/+ and CREATE, a list of every dishwasher on the right, and BACK
	    underneath. Nothing is sent until CREATE (PartyAction "Create" { Level, MaxPlayers, Privacy });
	    BACK sends "Leave".
	  * Waiting card (everyone, Status == "Waiting"/"Launching"): a compact card at the top right with
	    the dishwasher, "2/4", "Teleporting in 12", member avatars, and [Start] (host) / [Leave].

	Works with mouse, touch and gamepad: the Create screen selects CREATE for gamepads, and B backs out.
	The server validates and rate-limits every PartyAction.
]]

local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Types = require(Shared:WaitForChild("Types"))

local Client = script.Parent
local ClientState = require(Client:WaitForChild("ClientState"))
local UIKit = require(Client:WaitForChild("UIKit"))

local Colors = UIKit.Theme.Colors

local PartyUI = {}

local CREATE_SIZE = Vector2.new(940, 600)
local WAIT_WIDTH = 300
local RIGHT_COLUMN_CLEARANCE = 132 -- the HUD's right-hand button column

local initialized = false

local root: Frame
local createScreen: Frame
local createScale: UIScale
local leftCard: Frame
local levelList: ScrollingFrame
local waitCard: Frame
local waitContent: Frame
local waitStatus: TextLabel? = nil
local createButton: TextButton? = nil

-- Create-screen selections (local until CREATE is pressed).
local selLevel = 1
local selMax = Config.Party.MaxPlayers
local selPrivacy = "Public"
local wasPicking = false

----------------------------------------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------------------------------------

local thumbCache: { [number]: string } = {}
local thumbPending: { [number]: boolean } = {}

local function fetchThumbnail(userId: number, onReady: (content: string) -&gt; ())
	local cached = thumbCache[userId]
	if cached then
		onReady(cached)
		return
	end
	if thumbPending[userId] then
		return
	end
	thumbPending[userId] = true
	task.spawn(function()
		local ok, content = pcall(function()
			return Players:GetUserThumbnailAsync(userId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
		end)
		thumbPending[userId] = nil
		if ok and type(content) == "string" and content ~= "" then
			thumbCache[userId] = content
			onReady(content)
		end
	end)
end

local function sendPartyAction(action: string, value: any?)
	local ok, err = pcall(function()
		Remotes.Event("PartyAction"):FireServer(action, value)
	end)
	if not ok then
		warn("[PartyUI] PartyAction failed: " .. tostring(err))
	end
end

local function unlocked(): number
	local party = ClientState.Party :: Types.PartyState?
	if party then
		return math.max(1, party.HostUnlocked)
	end
	local meta = ClientState.Meta :: Types.MetaState?
	return if meta then meta.Unlocked else 1
end

local function bestTime(levelIndex: number): number?
	local meta = ClientState.Meta :: Types.MetaState?
	local t = meta and meta.BestTimes[levelIndex]
	return if t and t &gt; 0 then t else nil
end

local LEVEL_EMOJI = { "🍝", "🍕", "👑" } -- one per level, on its card

-- "Map thumbnail" art for a dishwasher: a gradient in its theme colours, the level's emoji big on a
-- soft glow, and a few bubbles. Built from UI only (no uploaded images).
local function levelArt(parent: Instance, levelIndex: number, size: UDim2, iconSize: number, locked: boolean, emblemAt: UDim2?): Frame
	local level = Config.GetLevel(levelIndex)
	local art = Instance.new("Frame")
	art.Name = "Art"
	art.Size = size
	art.BackgroundColor3 = Color3.new(1, 1, 1)
	art.BorderSizePixel = 0
	art.ClipsDescendants = true
	UIKit.Corner(art, 14)
	UIKit.Gradient(art, UIKit.Lighten(level.Theme.Accent, 0.25), UIKit.Darken(level.Theme.Accent, 0.35))
	for i = 1, 6 do
		local b = Instance.new("Frame")
		local d = 14 + (i * 37) % 30
		b.Size = UDim2.fromOffset(d, d)
		b.Position = UDim2.new((i * 0.173) % 1, 0, (i * 0.311) % 1, 0)
		b.BackgroundColor3 = Color3.new(1, 1, 1)
		b.BackgroundTransparency = 0.75
		UIKit.Corner(b, 999)
		b.Parent = art
	end
	-- A soft glow behind the level's emblem (a padlock while it's locked).
	local emblemSize = math.floor(iconSize * 1.35)
	local at = emblemAt or UDim2.fromScale(0.5, 0.52)
	local glow = Instance.new("Frame")
	glow.AnchorPoint = Vector2.new(0.5, 0.5)
	glow.Position = at
	glow.Size = UDim2.fromOffset(emblemSize * 1.25, emblemSize * 1.25)
	glow.BackgroundColor3 = Color3.new(1, 1, 1)
	glow.BackgroundTransparency = 0.72
	glow.BorderSizePixel = 0
	UIKit.Corner(glow, 999)
	glow.Parent = art
	if locked then
		UIKit.Icon("Lock", emblemSize, {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = at,
			Parent = art,
		})
	else
		-- the level's emoji, big, on the glow
		UIKit.Label({
			Text = LEVEL_EMOJI[levelIndex] or "🍽️",
			TextSize = math.floor(emblemSize * 0.8),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = at,
			Size = UDim2.fromOffset(emblemSize, emblemSize),
			Stroke = false,
			Parent = art,
		})
	end
	if locked then
		art.BackgroundColor3 = Color3.fromRGB(120, 125, 135)
	end
	art.Parent = parent
	return art
end

local function listLayout(parent: Instance, dir: Enum.FillDirection, pad: number, hAlign: Enum.HorizontalAlignment?): UIListLayout
	local l = Instance.new("UIListLayout")
	l.SortOrder = Enum.SortOrder.LayoutOrder
	l.FillDirection = dir
	l.Padding = UDim.new(0, pad)
	l.HorizontalAlignment = hAlign or Enum.HorizontalAlignment.Center
	-- Scrolling lists must be top-aligned: a centred list taller than its frame spills above the
	-- top, where it can't be scrolled to (that's what cut off the first dishwasher card).
	l.VerticalAlignment = if parent:IsA("ScrollingFrame") then Enum.VerticalAlignment.Top else Enum.VerticalAlignment.Center
	l.Parent = parent
	return l
end

local function panel(parent: Instance, size: UDim2): Frame
	local f = Instance.new("Frame")
	f.Size = size
	f.BackgroundColor3 = Color3.new(1, 1, 1)
	f.BorderSizePixel = 0
	UIKit.Corner(f, 18)
	UIKit.Gradient(f, Colors.Panel, Colors.PanelDark)
	UIKit.Stroke(f, Colors.Ink, 3)
	f.Parent = parent
	return f
end

----------------------------------------------------------------------------------------------------
-- Create Party screen
----------------------------------------------------------------------------------------------------

local renderCreate: () -&gt; ()

local function renderLevelList()
	for _, child in levelList:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	local maxUnlocked = unlocked()
	for i, level in Config.Levels do
		local locked = i &gt; maxUnlocked
		local selected = i == selLevel
		local card = Instance.new("TextButton")
		card.Name = "Level" .. i
		card.LayoutOrder = i
		card.Size = UDim2.new(1, -8, 0, 112)
		card.AutoButtonColor = false
		card.Text = ""
		card.BackgroundTransparency = 1
		card.SelectionImageObject = nil
		card.Parent = levelList
		local art = levelArt(card, i, UDim2.fromScale(1, 1), 54, locked, UDim2.new(0, 60, 0.5, 0))
		local stroke = UIKit.Stroke(art, if selected then Color3.new(1, 1, 1) else Colors.Ink, if selected then 4 else 2)
		stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		UIKit.Label({
			Text = string.upper(level.Name),
			TextSize = 24,
			AnchorPoint = Vector2.new(1, 1),
			Position = UDim2.new(1, -10, 1, -6),
			Size = UDim2.new(1, -130, 0, 30),
			TextXAlignment = Enum.TextXAlignment.Right,
			TextScaled = true,
			Parent = art,
		})
		UIKit.Label({
			Text = "CHAPTER " .. i,
			TextSize = 18,
			AnchorPoint = Vector2.new(1, 1),
			Position = UDim2.new(1, -10, 1, -36),
			Size = UDim2.new(1, -130, 0, 22),
			TextXAlignment = Enum.TextXAlignment.Right,
			TextColor3 = Color3.fromRGB(255, 220, 110),
			Parent = art,
		})
		local best = bestTime(i)
		UIKit.Label({
			Text = if locked then string.format("Clear %s to unlock", Config.GetLevel(i - 1).Name) elseif best then "Best " .. UIKit.Time(best) else "Not cleared yet",
			TextSize = 15,
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -10, 0, 6),
			Size = UDim2.new(1, -130, 0, 20),
			TextXAlignment = Enum.TextXAlignment.Right,
			TextScaled = true,
			TextColor3 = Color3.fromRGB(235, 240, 250),
			Parent = art,
		})
		card.Activated:Connect(function()
			if locked then
				UIKit.PlaySound("Error")
				UIKit.Toast("Clear " .. Config.GetLevel(i - 1).Name .. " first!", "Bad")
				return
			end
			UIKit.PlaySound("Click")
			selLevel = i
			renderCreate()
		end)
	end
	-- The next chapter, still being written.
	local n = #Config.Levels + 1
	local soon = Instance.new("TextButton")
	soon.Name = "ComingSoon"
	soon.LayoutOrder = n
	soon.Size = UDim2.new(1, -8, 0, 112)
	soon.AutoButtonColor = false
	soon.Text = ""
	soon.BackgroundColor3 = Color3.fromRGB(96, 102, 116)
	soon.BorderSizePixel = 0
	soon.SelectionImageObject = nil
	UIKit.Corner(soon, 14)
	UIKit.Gradient(soon, Color3.fromRGB(124, 130, 146), Color3.fromRGB(78, 84, 98))
	local soonStroke = UIKit.Stroke(soon, Colors.Ink, 2)
	soonStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	soon.Parent = levelList
	UIKit.Icon("Lock", 64, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 60, 0.5, 0), Parent = soon })
	UIKit.Label({
		Text = "CHAPTER " .. n,
		TextSize = 18,
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -10, 1, -36),
		Size = UDim2.new(1, -130, 0, 22),
		TextXAlignment = Enum.TextXAlignment.Right,
		TextColor3 = Color3.fromRGB(255, 220, 110),
		Parent = soon,
	})
	UIKit.Label({
		Text = "MORE CHAPTERS COMING SOON",
		TextSize = 22,
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -10, 1, -6),
		Size = UDim2.new(1, -130, 0, 28),
		TextXAlignment = Enum.TextXAlignment.Right,
		TextScaled = true,
		Parent = soon,
	})
	soon.Activated:Connect(function()
		-- Chapter 4 is a Roblox event: open its page so players can RSVP (StoreIds &gt; EventIds &gt; Chapter4).
		local StoreIds = require(Shared:WaitForChild("StoreIds")) :: any
		local id = tostring(StoreIds.EventIds and StoreIds.EventIds.Chapter4 or "")
		if id ~= "" and id ~= "0" then
			local ok, err = pcall(function()
				game:GetService("SocialService"):PromptRsvpToEventAsync(id)
			end)
			if ok then
				UIKit.PlaySound("Click")
				return
			end
			warn("[PartyUI] RSVP prompt failed: " .. tostring(err))
		end
		UIKit.PlaySound("Error")
		UIKit.Toast("The next chapter is on its way. Stay tuned!", "Info")
	end)
end

function renderCreate()
	for _, child in leftCard:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	local level = Config.GetLevel(selLevel)

	local art = levelArt(leftCard, selLevel, UDim2.new(1, -24, 0, 190), 110, false)
	art.Position = UDim2.fromOffset(12, 12)
	UIKit.Label({
		Text = "CHAPTER " .. selLevel,
		TextSize = 22,
		Position = UDim2.fromOffset(14, 10),
		Size = UDim2.fromOffset(200, 28),
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = art,
	})
	UIKit.Label({
		Text = string.upper(level.Name),
		TextSize = 44,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 208),
		Size = UDim2.new(1, -24, 0, 50),
		TextScaled = true,
		Parent = leftCard,
	})
	UIKit.Label({
		Text = "CREATE PARTY",
		TextSize = 26,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 254),
		Size = UDim2.new(1, -24, 0, 32),
		Parent = leftCard,
	})
	local divider = Instance.new("Frame")
	divider.Size = UDim2.new(0.8, 0, 0, 3)
	divider.AnchorPoint = Vector2.new(0.5, 0)
	divider.Position = UDim2.new(0.5, 0, 0, 288)
	divider.BackgroundColor3 = Color3.new(1, 1, 1)
	divider.BorderSizePixel = 0
	divider.Parent = leftCard

	-- Public / Friends.
	local privacyRow = Instance.new("Frame")
	privacyRow.BackgroundTransparency = 1
	privacyRow.AnchorPoint = Vector2.new(0.5, 0)
	privacyRow.Position = UDim2.new(0.5, 0, 0, 298)
	privacyRow.Size = UDim2.new(1, -24, 0, 50)
	privacyRow.Parent = leftCard
	listLayout(privacyRow, Enum.FillDirection.Horizontal, 10)
	for _, option in { { "Public", "PUBLIC", Colors.Primary }, { "Friends", "FRIENDS", Colors.Accent } } do
		local key = option[1]
		UIKit.Button({
			Text = option[2],
			Size = UDim2.fromOffset(180, 46),
			Color = if selPrivacy == key then option[3] else Colors.Disabled,
			TextSize = 22,
			Parent = privacyRow,
			OnClick = function()
				selPrivacy = key
				renderCreate()
			end,
		})
	end

	-- Party size.
	UIKit.Label({
		Text = "Party Size:",
		TextSize = 28,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 350),
		Size = UDim2.new(1, -24, 0, 32),
		Parent = leftCard,
	})
	local sizeRow = Instance.new("Frame")
	sizeRow.BackgroundTransparency = 1
	sizeRow.AnchorPoint = Vector2.new(0.5, 0)
	sizeRow.Position = UDim2.new(0.5, 0, 0, 382)
	sizeRow.Size = UDim2.new(1, -24, 0, 52)
	sizeRow.Parent = leftCard
	listLayout(sizeRow, Enum.FillDirection.Horizontal, 16)
	UIKit.Button({
		Text = "−",
		Size = UDim2.fromOffset(60, 50),
		Color = Colors.PanelLight,
		Disabled = selMax &lt;= 1,
		LayoutOrder = 1,
		Parent = sizeRow,
		OnClick = function()
			selMax = math.max(1, selMax - 1)
			renderCreate()
		end,
	})
	local count = UIKit.Card({ Size = UDim2.fromOffset(70, 50), LayoutOrder = 2, Parent = sizeRow })
	UIKit.Label({ Text = tostring(selMax), TextSize = 36, Size = UDim2.fromScale(1, 1), Parent = count })
	UIKit.Button({
		Text = "+",
		Size = UDim2.fromOffset(60, 50),
		Color = Colors.PanelLight,
		Disabled = selMax &gt;= Config.Party.MaxPlayers,
		LayoutOrder = 3,
		Parent = sizeRow,
		OnClick = function()
			selMax = math.min(Config.Party.MaxPlayers, selMax + 1)
			renderCreate()
		end,
	})

	createButton = UIKit.Button({
		Name = "Create",
		Text = "CREATE",
		Size = UDim2.fromOffset(300, 60),
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -14),
		Color = Colors.Good,
		TextSize = 32,
		Parent = leftCard,
		OnClick = function()
			sendPartyAction("Create", { Level = selLevel, MaxPlayers = selMax, Privacy = selPrivacy })
		end,
	})

	renderLevelList()
	if UIKit.IsGamepad() and createButton then
		GuiService.SelectedObject = createButton
	end
end

local function layoutCreate()
	local canvas = UIKit.CanvasSize()
	local inset = UIKit.TopInset()
	local fit = math.clamp(math.min((canvas.X - 24) / CREATE_SIZE.X, (canvas.Y - inset - 24) / CREATE_SIZE.Y), 0.4, 1)
	createScale.Scale = fit
	createScreen.Position = UDim2.new(0.5, 0, 0.5, math.floor(inset / 2))
end

local function buildCreateScreen()
	createScreen = Instance.new("Frame")
	createScreen.Name = "CreateParty"
	createScreen.AnchorPoint = Vector2.new(0.5, 0.5)
	createScreen.Size = UDim2.fromOffset(CREATE_SIZE.X, CREATE_SIZE.Y)
	createScreen.BackgroundTransparency = 1
	createScreen.Visible = false
	createScreen.ZIndex = 20
	createScreen.Parent = root
	createScale = Instance.new("UIScale")
	createScale.Parent = createScreen

	leftCard = panel(createScreen, UDim2.fromOffset(540, 520))
	leftCard.Name = "Selected"

	local right = panel(createScreen, UDim2.fromOffset(380, 520))
	right.Name = "Dishwashers"
	right.Position = UDim2.fromOffset(560, 0)
	UIKit.Label({
		Text = "CHAPTERS",
		TextSize = 26,
		Position = UDim2.fromOffset(0, 10),
		Size = UDim2.new(1, 0, 0, 30),
		Parent = right,
	})
	levelList = Instance.new("ScrollingFrame")
	levelList.Name = "List"
	levelList.Position = UDim2.fromOffset(12, 48)
	levelList.Size = UDim2.new(1, -18, 1, -60)
	levelList.BackgroundTransparency = 1
	levelList.BorderSizePixel = 0
	levelList.ScrollBarThickness = 6
	levelList.AutomaticCanvasSize = Enum.AutomaticSize.Y
	levelList.CanvasSize = UDim2.new()
	levelList.Parent = right
	listLayout(levelList, Enum.FillDirection.Vertical, 10, Enum.HorizontalAlignment.Left)
	local listPad = Instance.new("UIPadding")
	listPad.PaddingTop = UDim.new(0, 8)
	listPad.PaddingBottom = UDim.new(0, 8)
	listPad.PaddingLeft = UDim.new(0, 6)
	listPad.PaddingRight = UDim.new(0, 6)
	listPad.Parent = levelList

	UIKit.Button({
		Text = "BACK",
		Size = UDim2.fromOffset(200, 56),
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0, 270, 1, 0),
		Color = Colors.Bad,
		TextSize = 30,
		Parent = createScreen,
		OnClick = function()
			sendPartyAction("Leave", nil)
		end,
	})
end

----------------------------------------------------------------------------------------------------
-- Waiting card
----------------------------------------------------------------------------------------------------

local function renderWait(party: Types.PartyState)
	for _, child in waitContent:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	local level = Config.GetLevel(party.Level)
	local launching = party.Status == "Launching"

	local art = levelArt(waitContent, party.Level, UDim2.new(1, 0, 0, 110), 64, false)
	art.LayoutOrder = 1
	UIKit.Label({
		Text = string.format("CH. %d: %s", party.Level, string.upper(level.Name)),
		TextSize = 22,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -4),
		Size = UDim2.new(1, -12, 0, 26),
		TextScaled = true,
		Parent = art,
	})
	UIKit.Label({
		Text = if party.Privacy == "Public" then "🌐" else "👥",
		TextSize = 20,
		Position = UDim2.fromOffset(6, 4),
		Size = UDim2.fromOffset(26, 26),
		Parent = art,
	})

	UIKit.Label({
		Text = string.format("%d/%d", #party.Members, party.MaxPlayers),
		TextSize = 54,
		Size = UDim2.new(1, 0, 0, 58),
		LayoutOrder = 2,
		Parent = waitContent,
	})
	local status = UIKit.Label({
		Text = if launching then "Teleporting..." else "",
		TextSize = 24,
		Size = UDim2.new(1, 0, 0, 30),
		TextColor3 = if launching then Colors.Good else Colors.Text,
		LayoutOrder = 3,
		Parent = waitContent,
	})
	waitStatus = if launching then nil else status

	local avatars = Instance.new("Frame")
	avatars.BackgroundTransparency = 1
	avatars.Size = UDim2.new(1, 0, 0, 46)
	avatars.LayoutOrder = 4
	avatars.Parent = waitContent
	listLayout(avatars, Enum.FillDirection.Horizontal, 6)
	for _, member in party.Members do
		local isHost = member.UserId == party.HostUserId
		local avatarSize = if #party.Members &gt; 5 then 34 else 42 -- up to 8 fit on one row
		local img = UIKit.New("ImageLabel", {
			Size = UDim2.fromOffset(avatarSize, avatarSize),
			BackgroundColor3 = Colors.PanelLight,
			ScaleType = Enum.ScaleType.Crop,
			Parent = avatars,
		}) :: ImageLabel
		UIKit.Corner(img, 999)
		UIKit.Stroke(img, if isHost then Colors.Coin else Colors.Ink, if isHost then 3 else 2)
		fetchThumbnail(member.UserId, function(image)
			if img.Parent then
				img.Image = image
			end
		end)
	end

	local buttons = Instance.new("Frame")
	buttons.BackgroundTransparency = 1
	buttons.Size = UDim2.new(1, 0, 0, 48)
	buttons.LayoutOrder = 5
	buttons.Parent = waitContent
	listLayout(buttons, Enum.FillDirection.Horizontal, 10)
	if party.IsHost then
		UIKit.Button({
			Text = "START",
			Size = UDim2.fromOffset(130, 44),
			Color = Colors.Good,
			Disabled = launching,
			Parent = buttons,
			OnClick = function()
				sendPartyAction("StartNow", nil)
			end,
		})
	end
	UIKit.Button({
		Text = "LEAVE",
		Size = UDim2.fromOffset(130, 44),
		Color = Colors.Bad,
		Disabled = launching,
		Parent = buttons,
		OnClick = function()
			sendPartyAction("Leave", nil)
		end,
	})
	if waitStatus then
		local remaining = math.max(0, math.ceil(party.EndsAt - workspace:GetServerTimeNow()))
		waitStatus.Text = string.format("Teleporting in %d", remaining)
	end
end

local function buildWaitCard()
	waitCard = panel(root, UDim2.fromOffset(WAIT_WIDTH, 0))
	waitCard.Name = "PartyWaiting"
	waitCard.AnchorPoint = Vector2.new(1, 0)
	waitCard.AutomaticSize = Enum.AutomaticSize.Y
	waitCard.Visible = false
	waitCard.ZIndex = 10
	waitContent = Instance.new("Frame")
	waitContent.BackgroundTransparency = 1
	waitContent.Size = UDim2.new(1, 0, 0, 0)
	waitContent.AutomaticSize = Enum.AutomaticSize.Y
	waitContent.Parent = waitCard
	UIKit.Padding(waitContent, 12)
	listLayout(waitContent, Enum.FillDirection.Vertical, 6)
end

local function layoutWait()
	local safe = UIKit.SafeInsets()
	waitCard.Position = UDim2.new(1, -(RIGHT_COLUMN_CLEARANCE + safe.Right), 0, UIKit.TopInset() + 90)
end

----------------------------------------------------------------------------------------------------
-- Render
----------------------------------------------------------------------------------------------------

local function render()
	local party = ClientState.Party :: Types.PartyState?
	local picking = party ~= nil and party.Status == "Picking" and party.IsHost
	if picking and not wasPicking and party then
		-- Fresh Create screen: start from the server's defaults (their best dishwasher).
		selLevel = math.clamp(party.Level, 1, unlocked())
		selMax = party.MaxPlayers
		selPrivacy = party.Privacy
		UIKit.CloseWindow()
	end
	wasPicking = picking

	createScreen.Visible = picking
	if picking then
		layoutCreate()
		renderCreate()
	elseif GuiService.SelectedObject and GuiService.SelectedObject:IsDescendantOf(createScreen) then
		GuiService.SelectedObject = nil
	end

	local waiting = party ~= nil and not picking
	waitCard.Visible = waiting
	if waiting and party then
		layoutWait()
		renderWait(party)
	else
		waitStatus = nil
	end
end

local function countdownLoop()
	while true do
		local party = ClientState.Party
		if party and party.Status == "Waiting" and waitStatus and waitStatus.Parent then
			local remaining = math.max(0, math.ceil(party.EndsAt - workspace:GetServerTimeNow()))
			waitStatus.Text = string.format("Teleporting in %d", remaining)
			task.wait(0.1)
		else
			task.wait(0.5)
		end
	end
end

function PartyUI.Init()
	if initialized then
		return
	end
	initialized = true

	local _gui, r = UIKit.CreateScreen("PartyUI", 8)
	root = r
	buildCreateScreen()
	buildWaitCard()

	UIKit.LayoutChanged:Connect(function()
		if createScreen.Visible then
			layoutCreate()
		end
		if waitCard.Visible then
			layoutWait()
		end
	end)

	ClientState.Changed:Connect(function(kind)
		if kind == "Party" or (kind == "Meta" and createScreen.Visible) then
			render()
		end
	end)

	-- B on a gamepad (or Backspace) backs out of the Create screen, like the BACK button.
	UserInputService.InputBegan:Connect(function(input, processed)
		if not createScreen.Visible then
			return
		end
		if input.KeyCode == Enum.KeyCode.ButtonB or (not processed and input.KeyCode == Enum.KeyCode.Backspace) then
			sendPartyAction("Leave", nil)
		end
	end)

	render()
	task.spawn(countdownLoop)
end

return PartyUI</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000003E"><Properties><string name="Name">PetRenderer</string><ProtectedString name="Source">-- PetRenderer: client-side visuals for every player's equipped pets. The server only replicates
-- state (EquippedPets/&lt;slot&gt; StringValue = pet id, its Target ObjectValue = the grime part being
-- cleaned); this module is the only thing that actually builds and moves pet models. See
-- DESIGN.md section 6 ("PetRenderer") and section 4 ("Equipped pets for rendering").
--
--   * One local Folder, workspace.ClientPets, holds every model this client has built (for every
--     player, including the local one).
--   * A single RunService.RenderStepped connection drives every pet every frame; per-player /
--     per-slot state lives in `owners`, cleaned up on PlayerRemoving, folder/slot removal, or the
--     model failing to exist.
--   * Hovering over a live grime part takes priority; otherwise the pet holds a formation slot
--     behind its owner. Both cases are just a target CFrame that GetPivot() lerps toward.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local PetModels = require(Shared:WaitForChild("PetModels"))

local PetRenderer = {}

----------------------------------------------------------------------------------------------------
-- Tuning
----------------------------------------------------------------------------------------------------

local HOVER_OFFSET = 2.5 -- studs off the grime part along its surface normal (XVector, per DESIGN)
local FORMATION_BACK = 3.5 -- studs from the owner to the front edge of the first row of pets
local FORMATION_GAP = 1.0 -- clear space between neighbouring pets (sideways and between rows)
local FORMATION_ROW = 3 -- pets per row behind the owner
local BOB_SPEED = 3
local BOB_HEIGHT = 0.4
local LERP_RATE = 10 -- pivot:Lerp(target, 1 - exp(-LERP_RATE * dt))
local HIDE_DISTANCE = 400
local TILT_STRENGTH = 0.012
local MAX_TILT = math.rad(10)

----------------------------------------------------------------------------------------------------
-- State
----------------------------------------------------------------------------------------------------

type Slot = {
	Value: StringValue,
	Number: number, -- tonumber(Value.Name); used only to order the formation consistently
	Model: Model?,
	Target: BasePart?,
	Hidden: boolean?,
	LastPos: Vector3?,
	BasePivot: CFrame?, -- the smoothed pose without tilt (tilt is re-applied each frame, never compounded)
	Tilt: Vector2?, -- smoothed (pitch, roll)
	Size: Vector3?, -- the model's bounding size, so the formation can space pets so they never touch
	Conns: { RBXScriptConnection },
}

type OwnerState = {
	Player: Player,
	Folder: Folder,
	Slots: { [StringValue]: Slot },
	Conns: { RBXScriptConnection },
}

local initialized = false
local clientPetsFolder: Folder? = nil
local owners: { [Player]: OwnerState } = {}
-- Connections on the Player instance itself (waiting for EquippedPets to appear/disappear), kept
-- separate from OwnerState so they survive the folder coming and going.
local playerConns: { [Player]: { RBXScriptConnection } } = {}
local elapsed = 0

----------------------------------------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------------------------------------

local function ensureClientPetsFolder(): Folder
	if clientPetsFolder and clientPetsFolder.Parent then
		return clientPetsFolder
	end
	local existing = workspace:FindFirstChild("ClientPets")
	if existing and existing:IsA("Folder") then
		clientPetsFolder = existing
	else
		local folder = Instance.new("Folder")
		folder.Name = "ClientPets"
		folder.Parent = workspace
		clientPetsFolder = folder
	end
	return clientPetsFolder :: Folder
end

-- Local-only visibility toggle: cheap to call every frame, so instead we only touch parts when the
-- hidden state actually flips (LocalTransparencyModifier never replicates, so this doesn't affect
-- anyone else's view).
local function setHidden(slot: Slot, hidden: boolean)
	if slot.Hidden == hidden or not slot.Model then
		return
	end
	slot.Hidden = hidden
	for _, part in slot.Model:GetDescendants() do
		if part:IsA("BasePart") then
			part.LocalTransparencyModifier = if hidden then 1 else 0
		elseif part:IsA("ParticleEmitter") or part:IsA("Trail") or part:IsA("Light") then
			-- Golden / Rainbow sparkles, halo and trail go with the pet (left on, they'd keep
			-- glowing where it was hidden).
			part.Enabled = not hidden
			if hidden and part:IsA("ParticleEmitter") then
				part:Clear()
			elseif hidden and part:IsA("Trail") then
				part:Clear()
			end
		end
	end
end

-- A little pitch/roll target based on how the pet is currently moving, so it doesn't glide like a robot.
local function tiltFor(pivot: CFrame, velocity: Vector3): Vector2
	local localVel = pivot:VectorToObjectSpace(velocity)
	local pitch = math.clamp(localVel.Z * TILT_STRENGTH, -MAX_TILT, MAX_TILT) -- moving forward (-Z) leans in slightly
	local roll = math.clamp(-localVel.X * TILT_STRENGTH, -MAX_TILT, MAX_TILT)
	return Vector2.new(pitch, roll)
end

----------------------------------------------------------------------------------------------------
-- Slot lifecycle
----------------------------------------------------------------------------------------------------

local function destroySlot(slot: Slot)
	for _, conn in slot.Conns do
		conn:Disconnect()
	end
	table.clear(slot.Conns)
	if slot.Model then
		slot.Model:Destroy()
		slot.Model = nil
	end
end

local function buildModel(slot: Slot, petId: string)
	if slot.Model then
		slot.Model:Destroy()
		slot.Model = nil
	end
	local ok, model = pcall(PetModels.Build, petId, tonumber(slot.Value:GetAttribute("Tier")))
	if not ok or not model then
		return
	end
	-- Defensive: PetModels already builds with these off, but a client-only render model must never
	-- interact with anything physically, whatever the shared builder does.
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.Anchored = true
			part.CanCollide = false
			part.CanQuery = false
			part.CanTouch = false
		end
	end
	model.Parent = ensureClientPetsFolder()
	slot.Model = model
	slot.Size = model:GetExtentsSize()
	slot.Hidden = nil -- force the next setHidden call to actually apply
	slot.LastPos = nil
	slot.BasePivot = nil
	slot.Tilt = nil
end

local function hookTargetValue(slot: Slot, stringValue: StringValue)
	local targetValue = stringValue:FindFirstChild("Target")
	if not targetValue or not targetValue:IsA("ObjectValue") then
		-- The server may parent Target a moment after the slot itself; keep watching for it.
		local conn
		conn = stringValue.ChildAdded:Connect(function(child)
			if child.Name == "Target" and child:IsA("ObjectValue") then
				conn:Disconnect()
				local i = table.find(slot.Conns, conn)
				if i then
					table.remove(slot.Conns, i)
				end
				hookTargetValue(slot, stringValue)
			end
		end)
		table.insert(slot.Conns, conn)
		return
	end
	local target = targetValue.Value
	slot.Target = if typeof(target) == "Instance" and target:IsA("BasePart") then target else nil
	table.insert(
		slot.Conns,
		targetValue.Changed:Connect(function(value)
			slot.Target = if typeof(value) == "Instance" and value:IsA("BasePart") then value else nil
		end)
	)
end

local function addSlot(ownerState: OwnerState, stringValue: StringValue)
	if ownerState.Slots[stringValue] then
		return
	end
	local slot: Slot = {
		Value = stringValue,
		Number = tonumber(stringValue.Name) or 0,
		Model = nil,
		Target = nil,
		Hidden = nil,
		LastPos = nil,
		Conns = {},
	}
	ownerState.Slots[stringValue] = slot
	buildModel(slot, stringValue.Value)
	hookTargetValue(slot, stringValue)
	table.insert(
		slot.Conns,
		stringValue.Changed:Connect(function(newId)
			-- The pet in this slot was swapped in place (unequip + equip without the slot itself
			-- being removed). Rebuild the model; the Target watcher stays valid (same StringValue).
			buildModel(slot, newId)
		end)
	)
end

local function removeSlot(ownerState: OwnerState, stringValue: StringValue)
	local slot = ownerState.Slots[stringValue]
	if not slot then
		return
	end
	ownerState.Slots[stringValue] = nil
	destroySlot(slot)
end

----------------------------------------------------------------------------------------------------
-- Owner (player) lifecycle
----------------------------------------------------------------------------------------------------

local function cleanupOwner(player: Player)
	local ownerState = owners[player]
	if not ownerState then
		return
	end
	owners[player] = nil
	for _, conn in ownerState.Conns do
		conn:Disconnect()
	end
	for stringValue, slot in ownerState.Slots do
		destroySlot(slot)
	end
	table.clear(ownerState.Slots)
end

local function trackFolder(player: Player, folder: Folder)
	if owners[player] then
		return
	end
	local ownerState: OwnerState = {
		Player = player,
		Folder = folder,
		Slots = {},
		Conns = {},
	}
	owners[player] = ownerState

	for _, child in folder:GetChildren() do
		if child:IsA("StringValue") then
			addSlot(ownerState, child)
		end
	end
	table.insert(
		ownerState.Conns,
		folder.ChildAdded:Connect(function(child)
			if child:IsA("StringValue") then
				addSlot(ownerState, child)
			end
		end)
	)
	table.insert(
		ownerState.Conns,
		folder.ChildRemoved:Connect(function(child)
			if child:IsA("StringValue") then
				removeSlot(ownerState, child)
			end
		end)
	)
	table.insert(
		ownerState.Conns,
		folder.Destroying:Connect(function()
			cleanupOwner(player)
		end)
	)
end

local function trackPlayer(player: Player)
	if playerConns[player] then
		return
	end
	local conns: { RBXScriptConnection } = {}
	playerConns[player] = conns

	local existing = player:FindFirstChild("EquippedPets")
	if existing and existing:IsA("Folder") then
		trackFolder(player, existing)
	end
	table.insert(
		conns,
		player.ChildAdded:Connect(function(child)
			if child.Name == "EquippedPets" and child:IsA("Folder") then
				trackFolder(player, child)
			end
		end)
	)
	table.insert(
		conns,
		player.ChildRemoved:Connect(function(child)
			if child.Name == "EquippedPets" then
				cleanupOwner(player)
			end
		end)
	)
end

local function untrackPlayer(player: Player)
	cleanupOwner(player)
	local conns = playerConns[player]
	if conns then
		playerConns[player] = nil
		for _, conn in conns do
			conn:Disconnect()
		end
	end
end

----------------------------------------------------------------------------------------------------
-- Per-frame movement
----------------------------------------------------------------------------------------------------

-- Slots ordered by their StringValue name ("1", "2", ...) so the formation is stable frame to frame
-- even though `Slots` itself is a dictionary. Reused per owner per frame; small (&lt;= a handful).
local orderScratch: { Slot } = {}

local function updateOwner(ownerState: OwnerState, dt: number, camPos: Vector3)
	local player = ownerState.Player
	local character = player.Character
	local ownerRoot = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local ownerAlive = ownerRoot ~= nil and ownerRoot:IsA("BasePart") and humanoid ~= nil and humanoid.Health &gt; 0

	local farAway = false
	if ownerAlive then
		farAway = (camPos - (ownerRoot :: BasePart).Position).Magnitude &gt; HIDE_DISTANCE
	end
	-- An admin who is hidden (invisible, spectating, controlling someone): their pets hide too.
	local adminHidden = character ~= nil and character:GetAttribute("AdminHidden") == true
	local hideAll = (not ownerAlive) or farAway or adminHidden

	table.clear(orderScratch)
	for _, slot in ownerState.Slots do
		table.insert(orderScratch, slot)
	end
	table.sort(orderScratch, function(a, b)
		return a.Number &lt; b.Number
	end)
	local count = #orderScratch

	for i, slot in orderScratch do
		local model = slot.Model
		if not model or not model.Parent or not model.PrimaryPart then
			continue
		end
		setHidden(slot, hideAll)
		if hideAll then
			continue
		end

		local targetCFrame: CFrame? = nil
		local grime = slot.Target
		if grime and grime.Parent and grime:IsA("BasePart") then
			local ok, pos, cf = pcall(function()
				return grime.Position, grime.CFrame
			end)
			if ok then
				local hoverPos = pos + cf.XVector * HOVER_OFFSET
				targetCFrame = CFrame.lookAt(hoverPos, pos)
			end
		end

		if not targetCFrame then
			-- Rows of up to FORMATION_ROW behind the owner, spaced by the biggest pet's size so no two
			-- pets ever overlap (bigger pets simply spread out more).
			local root = ownerRoot :: BasePart
			local cell = 0
			for _, other in orderScratch do
				local size = other.Size or Vector3.new(3, 3, 3)
				cell = math.max(cell, size.X, size.Z)
			end
			local rowIndex = (i - 1) // FORMATION_ROW
			local col = (i - 1) % FORMATION_ROW
			local inRow = math.min(FORMATION_ROW, count - rowIndex * FORMATION_ROW)
			local x = (col - (inRow - 1) / 2) * (cell + FORMATION_GAP)
			local z = FORMATION_BACK + cell / 2 + rowIndex * (cell + FORMATION_GAP)
			local bob = math.sin(elapsed * BOB_SPEED + i) * BOB_HEIGHT
			local localOffset = CFrame.new(x, 0, z)
			local worldPos = (root.CFrame * localOffset).Position + Vector3.new(0, bob, 0)
			-- Face the same way as the owner (a sidekick formation), not rotated by the arc angle.
			targetCFrame = CFrame.new(worldPos) * (root.CFrame - root.CFrame.Position)
		end

		-- Smooth the untilted pose; the tilt is layered on top for display only, so it can't build up.
		local current = slot.BasePivot or model:GetPivot()
		local alpha = 1 - math.exp(-LERP_RATE * dt)
		local newPivot = current:Lerp(targetCFrame :: CFrame, alpha)
		slot.BasePivot = newPivot

		local tilt = slot.Tilt or Vector2.zero
		if slot.LastPos and dt &gt; 1e-4 then
			local velocity = (newPivot.Position - slot.LastPos) / dt
			tilt = tilt:Lerp(tiltFor(newPivot, velocity), 1 - math.exp(-8 * dt))
		end
		slot.Tilt = tilt
		slot.LastPos = newPivot.Position

		model:PivotTo(newPivot * CFrame.Angles(tilt.X, 0, tilt.Y))
	end
end

local function onRenderStepped(dt: number)
	elapsed += dt
	local camera = workspace.CurrentCamera
	local camPos = if camera then camera.CFrame.Position else Vector3.zero
	for _, ownerState in owners do
		local ok, err = pcall(updateOwner, ownerState, dt, camPos)
		if not ok then
			warn("[PetRenderer] update failed: " .. tostring(err))
		end
	end
end

-- Where a player's pet (by slot number) is drawn right now, for pop-ups over its head.
function PetRenderer.PetPosition(player: Player, number: number): Vector3?
	local state = owners[player]
	if not state then
		return nil
	end
	for _, slot in state.Slots do
		if slot.Number == number and slot.Model and not slot.Hidden then
			local ok, cf, size = pcall(slot.Model.GetBoundingBox, slot.Model)
			if ok then
				return cf.Position + Vector3.new(0, size.Y / 2 + 1, 0)
			end
		end
	end
	return nil
end

----------------------------------------------------------------------------------------------------
-- Init
----------------------------------------------------------------------------------------------------

function PetRenderer.Init()
	if initialized then
		return
	end
	initialized = true

	ensureClientPetsFolder()

	for _, player in Players:GetPlayers() do
		trackPlayer(player)
	end
	Players.PlayerAdded:Connect(trackPlayer)
	Players.PlayerRemoving:Connect(untrackPlayer)

	RunService.RenderStepped:Connect(onRenderStepped)
end

return PetRenderer</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000003F"><Properties><string name="Name">PetsUI</string><ProtectedString name="Source">-- PetsUI: the "Pets" inventory window and the "Eggs" hatchery window, plus the full-screen hatch
-- reveal animation. Everything here is built with UIKit; see DESIGN.md section 6 ("PetsUI") for
-- the contract. Both windows rebuild their contents from ClientState.Meta whenever it changes and
-- the relevant window is open, so a purchase/hatch/equip anywhere refreshes what's on screen.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local PetModels = require(Shared:WaitForChild("PetModels"))
local Types = require(Shared:WaitForChild("Types"))

local Client = script.Parent
local ClientState = require(Client:WaitForChild("ClientState"))
local UIKit = require(Client:WaitForChild("UIKit"))
local ShopUI = require(Client:WaitForChild("ShopUI"))

local PetsUI = {}

local C = UIKit.Theme.Colors

----------------------------------------------------------------------------------------------------
-- Small shared helpers
----------------------------------------------------------------------------------------------------

-- A safe pet definition even for an id that has left Config (kept in the profile, per DESIGN /
-- PetService "profile hygiene"), so the inventory never errors on a stale entry.
local PLACEHOLDER_DEF = { Name = "???", Rarity = "Common", PowerShare = 0, CoinBonus = 0 }
local function petDef(id: string)
	return Config.Pets[id] or PLACEHOLDER_DEF
end

local function rarityOrder(rarity: string): number
	local def = Config.Rarities[rarity]
	return (def and def.Order) or 0
end

local ZERO_STATS = { Speed = 0, Capacity = 0, CoinBonus = 0 }
local function petStats(id: string, tier: number?)
	return Config.PetStats(id, tier) or ZERO_STATS
end

-- "Golden Rubber Duck" / "Rubber Duck".
local function petTitle(id: string, tier: number?): string
	local t = Config.PetTier(tier)
	return if t.Name ~= "" then t.Name .. " " .. petDef(id).Name else petDef(id).Name
end

-- meta.Pets sorted best-first: speed (tier included), then rarity, then Uid (stable).
local function sortedPetList(meta: Types.MetaState)
	local list = {}
	for _, entry in meta.Pets do
		local tier = entry.Tier or 1
		table.insert(list, { Uid = entry.Uid, Id = entry.Id, Tier = tier, Def = petDef(entry.Id), Stats = petStats(entry.Id, tier) })
	end
	table.sort(list, function(a, b)
		if a.Stats.Speed ~= b.Stats.Speed then
			return a.Stats.Speed &gt; b.Stats.Speed
		end
		local ra, rb = rarityOrder(a.Def.Rarity), rarityOrder(b.Def.Rarity)
		if ra ~= rb then
			return ra &gt; rb
		end
		return a.Uid &lt; b.Uid
	end)
	return list
end

local function isEquipped(meta: Types.MetaState, uid: string): boolean
	return table.find(meta.Equipped, uid) ~= nil
end

-- Pets show two numbers: cleaning speed out of 100 (100 = the best pet in the game) and the coin
-- multiplier they add while equipped.
local function speedText(id: string, tier: number?): string
	return Config.PetSpeedRating(id, tier) .. "/100"
end
local function coinText(mult: number): string
	return string.format("x%.2f", mult)
end

----------------------------------------------------------------------------------------------------
-- Module state
----------------------------------------------------------------------------------------------------

local initialized = false
local root: Frame

local petsContent: Frame
local indexPanel: Frame
local indexButton: TextButton
local equipBestButton: TextButton
local refreshIndex: () -&gt; ()
local toggleIndex: () -&gt; ()
local eggsContent: Frame

-- Pets window
local gridScroll: ScrollingFrame
local equippedLabel: TextLabel
local countLabel: TextLabel
local detailEmpty: Frame
local detailFilled: Frame
local detailViewport: ViewportFrame
local detailName: TextLabel
local detailRarity: TextLabel
local detailPower: TextLabel
local speedFill: Frame
local detailCoin: TextLabel
local equipButton: TextButton
local deleteConfirmFrame: Frame
local selectedUid: string? = nil
local deleteToken = 0

-- Merge mode: pick MergeCount pets of one rarity; they become one pet of the next rarity.
local MERGE_COUNT = Config.PetRules.MergeCount or 3
local mergeMode = false
local mergeSel: { string } = {}
local mergeButton: TextButton
local mergePanel: Frame
local mergeInfo: TextLabel
local mergeResult: TextLabel
local mergeGo: TextButton
local mergePreview: Frame
local mergeViewport: ViewportFrame
local mergeEmpty: TextLabel
local detailsCard: Frame

-- Eggs window
local eggTabsHolder: Frame
local eggViewport: ViewportFrame
local eggNameLabel: TextLabel
local eggCostLabel: TextLabel
local eggLockedLabel: TextLabel
local oddsScroll: ScrollingFrame
local hatch1Button: TextButton
local hatch3Button: TextButton
local currentEggId: string? = nil

----------------------------------------------------------------------------------------------------
-- Pets window: grid + details panel
----------------------------------------------------------------------------------------------------

local GRID_CELL = Vector2.new(122, 198) -- name, rarity, speed, LIMITED, then the EQUIPPED tag (each on its own line)
local GRID_GAP = 10

-- Merge rule (same as the server): three of the same pet at the same tier -&gt; that pet, next tier.
local function petOf(uid: string?)
	local meta = ClientState.Meta
	if not uid or not meta then
		return nil
	end
	for _, pet in meta.Pets do
		if pet.Uid == uid then
			return pet
		end
	end
	return nil
end
local function canMergeWith(first, pet): boolean
	local limited = Config.Pets[pet.Id]
	if limited and limited.Event then
		return false -- limited pets can't be upgraded
	end
	local tier = pet.Tier or 1
	if tier &gt;= #Config.PetTiers then
		return false
	end
	return first == nil or (first.Id == pet.Id and (first.Tier or 1) == tier)
end

-- Golden and Rainbow pets are shown by their look, not by a word in the name: a gold card, or a
-- card with a slowly turning rainbow edge. These gradients turn every frame while visible.
local RAINBOW = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 80, 80)),
	ColorSequenceKeypoint.new(0.2, Color3.fromRGB(255, 190, 60)),
	ColorSequenceKeypoint.new(0.4, Color3.fromRGB(110, 230, 90)),
	ColorSequenceKeypoint.new(0.6, Color3.fromRGB(70, 200, 255)),
	ColorSequenceKeypoint.new(0.8, Color3.fromRGB(170, 110, 255)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 80, 80)),
})
local GOLD_EDGE = Color3.fromRGB(255, 205, 60)
local spinning: { [UIGradient]: boolean } = setmetatable({}, { __mode = "k" }) :: any
task.spawn(function()
	while true do
		local angle = (os.clock() * 90) % 360
		for gradient in spinning do
			if gradient.Parent then
				gradient.Rotation = angle
			else
				spinning[gradient] = nil
			end
		end
		task.wait(1 / 30)
	end
end)

-- A card's edge for a pet's tier: a gold glow, or a slowly turning rainbow one. The card itself
-- (and the pet) keep their normal colours; the GOLD / RAINBOW tag says which.
local function paintTier(_card: Frame, stroke: UIStroke?, tier: number)
	if not stroke then
		return
	end
	if tier == 2 then
		stroke.Color = GOLD_EDGE
		stroke.Thickness = 4
	elseif tier &gt;= 3 then
		stroke.Color = Color3.new(1, 1, 1)
		stroke.Thickness = 4
		local g = Instance.new("UIGradient")
		g.Color = RAINBOW
		g.Parent = stroke
		spinning[g] = true
	end
end

-- The small GOLD / RAINBOW tag on a card.
local function tierTag(card: Frame, tier: number)
	if tier &lt;= 1 then
		return
	end
	local rainbow = tier &gt;= 3
	local text = if rainbow then "RAINBOW" else "GOLD"
	local tag = Instance.new("Frame")
	tag.Name = "TierTag"
	-- Centred just under the pet, above its name (the corners hold SELECTED / merge badges).
	tag.AnchorPoint = Vector2.new(0.5, 0)
	tag.Position = UDim2.new(0.5, 0, 0, 76)
	tag.Size = UDim2.fromOffset(#text * 7 + 12, 18)
	tag.BackgroundColor3 = if rainbow then Color3.new(1, 1, 1) else GOLD_EDGE
	tag.ZIndex = 7
	UIKit.Corner(tag, 9)
	if rainbow then
		local g = Instance.new("UIGradient")
		g.Color = RAINBOW
		g.Parent = tag
	end
	UIKit.Label({ Text = text, TextSize = 12, Size = UDim2.fromScale(1, 1), Parent = tag, ZIndex = 8 })
	tag.Parent = card
end

-- A text label coloured like the tier (gold, or rainbow).
local function paintTierText(label: TextLabel, tier: number)
	local old = label:FindFirstChild("TierGradient")
	if old then
		old:Destroy()
	end
	label.TextColor3 = C.Text
	if tier == 2 then
		label.TextColor3 = GOLD_EDGE
	elseif tier &gt;= 3 then
		local g = Instance.new("UIGradient")
		g.Name = "TierGradient"
		g.Color = RAINBOW
		g.Parent = label
	end
end

-- A bright ring just outside a card (selection / merge pick). Its own frame, because a card can
-- only show one UIStroke and that one is the rarity / tier edge.
local function outerRing(card: Frame, color: Color3)
	local ring = Instance.new("Frame")
	ring.Name = "OuterRing"
	ring.BackgroundTransparency = 1
	ring.Size = UDim2.new(1, 12, 1, 12)
	ring.Position = UDim2.fromOffset(-6, -6)
	ring.ZIndex = 6
	UIKit.Corner(ring, 16)
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 4
	stroke.Color = color
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = ring
	ring.Parent = card
	local tint = Instance.new("Frame")
	tint.Name = "Tint"
	tint.Size = UDim2.fromScale(1, 1)
	tint.BackgroundColor3 = color
	tint.BackgroundTransparency = 0.78
	tint.ZIndex = 4
	UIKit.Corner(tint, 12)
	tint.Parent = card
end

local function pill(card: Frame, text: string, color: Color3, pos: UDim2, anchor: Vector2, name: string)
	local tag = Instance.new("Frame")
	tag.Name = name
	tag.AnchorPoint = anchor
	tag.Position = pos
	tag.Size = UDim2.fromOffset(#text * 8 + 14, 20)
	tag.BackgroundColor3 = color
	tag.ZIndex = 7
	UIKit.Corner(tag, 10)
	UIKit.Label({ Text = text, TextSize = 13, Size = UDim2.fromScale(1, 1), Parent = tag, ZIndex = 8 })
	tag.Parent = card
end

local function buildPetCard(parent: Instance, entry, equipped: boolean, onClick: (uid: string) -&gt; (), copies: number?)
	local tier = entry.Tier or 1
	local card = UIKit.Card({
		Size = UDim2.fromOffset(GRID_CELL.X, GRID_CELL.Y),
		Color = C.PanelLight,
		StrokeColor = UIKit.RarityColor(entry.Def.Rarity),
		Parent = parent,
	})
	local stroke = card:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Thickness = 3
		stroke.Transparency = 0
	end
	paintTier(card, stroke, tier)
	tierTag(card, tier)

	-- Invisible hit surface. Not a UIKit.Button: we want the plain card look, not the chunky style.
	local hit = Instance.new("TextButton")
	hit.Name = "Hit"
	hit.BackgroundTransparency = 1
	hit.Text = ""
	hit.Size = UDim2.fromScale(1, 1)
	hit.ZIndex = 9
	hit.AutoButtonColor = false
	hit.Parent = card

	local viewport = UIKit.Viewport({
		Model = PetModels.Build(entry.Id, entry.Tier),
		Size = UDim2.fromOffset(GRID_CELL.X - 16, 86),
		Position = UDim2.new(0.5, 0, 0, 6),
		AnchorPoint = Vector2.new(0.5, 0),
		Parent = card,
	})
	viewport.ZIndex = 1

	UIKit.Label({
		Text = entry.Def.Name,
		Size = UDim2.new(1, -10, 0, 20),
		Position = UDim2.new(0.5, 0, 0, 96),
		AnchorPoint = Vector2.new(0.5, 0),
		TextSize = 16,
		TextScaled = true,
		Parent = card,
		ZIndex = 2,
	})
	UIKit.Label({
		Text = entry.Def.Rarity,
		Size = UDim2.new(1, -10, 0, 16),
		Position = UDim2.new(0.5, 0, 0, 118),
		AnchorPoint = Vector2.new(0.5, 0),
		TextSize = 14,
		TextColor3 = UIKit.RarityColor(entry.Def.Rarity),
		Parent = card,
		ZIndex = 2,
	})
	UIKit.Label({
		Text = "Speed " .. speedText(entry.Id, entry.Tier),
		Size = UDim2.new(1, -10, 0, 16),
		Position = UDim2.new(0.5, 0, 0, 135),
		AnchorPoint = Vector2.new(0.5, 0),
		TextSize = 13,
		TextColor3 = C.TextDim,
		Parent = card,
		ZIndex = 2,
	})
	if entry.Def.Limited then
		UIKit.Label({
			Text = "LIMITED PET",
			Size = UDim2.new(1, -10, 0, 16),
			Position = UDim2.new(0.5, 0, 0, 152),
			AnchorPoint = Vector2.new(0.5, 0),
			TextSize = 13,
			TextColor3 = Color3.fromRGB(255, 205, 60),
			Parent = card,
			ZIndex = 2,
		})
	end

	if equipped then
		pill(card, "EQUIPPED", C.Good, UDim2.new(0.5, 0, 1, -6), Vector2.new(0.5, 1), "EquippedTag")
	end

	if mergeMode then
		local pick = table.find(mergeSel, entry.Uid)
		local blocked = not canMergeWith(petOf(mergeSel[1]), entry)
		if pick then
			outerRing(card, C.Good)
			local badge = Instance.new("Frame")
			badge.Name = "MergeBadge"
			badge.Size = UDim2.fromOffset(30, 30)
			badge.AnchorPoint = Vector2.new(1, 0)
			badge.Position = UDim2.new(1, -4, 0, 4)
			badge.BackgroundColor3 = C.Good
			badge.ZIndex = 7
			UIKit.Corner(badge, 15)
			UIKit.Label({ Text = tostring(pick), TextSize = 20, Size = UDim2.fromScale(1, 1), Parent = badge, ZIndex = 8 })
			badge.Parent = card
		elseif blocked then
			local shade = Instance.new("Frame")
			shade.Name = "Blocked"
			shade.Size = UDim2.fromScale(1, 1)
			shade.BackgroundColor3 = Color3.new(0, 0, 0)
			shade.BackgroundTransparency = 0.45
			shade.ZIndex = 5
			UIKit.Corner(shade, 12)
			shade.Parent = card
		elseif (copies or 0) &gt;= MERGE_COUNT and tier &lt; #Config.PetTiers then
			-- You have enough of this one to merge.
			pill(card, "x" .. tostring(copies), Color3.fromRGB(170, 110, 255), UDim2.new(1, -4, 0, 4), Vector2.new(1, 0), "CopiesTag")
		end
	elseif selectedUid == entry.Uid then
		outerRing(card, C.Primary)
		pill(card, "SELECTED", C.Primary, UDim2.new(1, -4, 0, 4), Vector2.new(1, 0), "SelectedTag")
	end

	hit.Activated:Connect(function()
		onClick(entry.Uid)
	end)
	return card
end

local function refreshDetailPanel(meta: Types.MetaState?)
	local entry = nil
	if meta and selectedUid then
		for _, pet in meta.Pets do
			if pet.Uid == selectedUid then
				entry = { Uid = pet.Uid, Id = pet.Id, Tier = pet.Tier or 1, Def = petDef(pet.Id), Stats = petStats(pet.Id, pet.Tier) }
				break
			end
		end
	end
	if not entry then
		selectedUid = nil
		detailEmpty.Visible = true
		detailFilled.Visible = false
		return
	end

	detailEmpty.Visible = false
	detailFilled.Visible = true
	deleteConfirmFrame.Visible = false

	UIKit.SetViewportModel(detailViewport, PetModels.Build(entry.Id, entry.Tier), true)
	detailName.Text = entry.Def.Name
	local tierDef = Config.PetTier(entry.Tier)
	detailRarity.Text = if tierDef.Name ~= "" then tierDef.Name .. "  •  " .. entry.Def.Rarity else entry.Def.Rarity
	if entry.Def.Limited then
		detailRarity.Text ..= "  •  LIMITED (" .. entry.Def.Limited .. ")"
	end
	if (entry.Tier or 1) &gt; 1 then
		paintTierText(detailRarity, entry.Tier or 1)
	else
		paintTierText(detailRarity, 1)
		detailRarity.TextColor3 = UIKit.RarityColor(entry.Def.Rarity)
	end
	local rating = Config.PetSpeedRating(entry.Id, entry.Tier)
	detailPower.Text = "Cleaning speed  " .. rating .. "/100"
	speedFill.Size = UDim2.fromScale(rating / 100, 1)
	detailCoin.Text = "Coin multiplier  " .. coinText(Config.PetCoinMult(entry.Id, entry.Tier))

	local equipped = isEquipped(meta :: Types.MetaState, entry.Uid)
	equipButton.Text = if equipped then "Unequip" else "Equip"
	equipButton.BackgroundColor3 = if equipped then C.Warning else C.Good
end

local function refreshMergePanel()
	local first = petOf(mergeSel[1])
	mergeInfo.Text = string.format("Picked %d/%d", #mergeSel, MERGE_COUNT)
	-- The preview card: repainted from scratch each time.
	for _, child in mergePreview:GetChildren() do
		if child:IsA("UIGradient") or child.Name == "TierTag" then
			child:Destroy()
		end
	end
	local previewStroke = mergePreview:FindFirstChildOfClass("UIStroke")
	if previewStroke then
		for _, child in previewStroke:GetChildren() do
			child:Destroy()
		end
		previewStroke.Color = C.Disabled
		previewStroke.Thickness = 2
	end
	mergePreview.BackgroundColor3 = C.PanelLight
	if first then
		local nextTier = (first.Tier or 1) + 1
		paintTier(mergePreview, previewStroke, nextTier)
		tierTag(mergePreview, nextTier)
		UIKit.SetViewportModel(mergeViewport, PetModels.Build(first.Id, nextTier), true)
		mergeResult.Text = "Makes: " .. petTitle(first.Id, nextTier)
		paintTierText(mergeResult, nextTier)
	else
		UIKit.SetViewportModel(mergeViewport, nil, true)
		mergeResult.Text = "Pick a pet to merge"
		paintTierText(mergeResult, 1)
		mergeResult.TextColor3 = C.TextDim
	end
	UIKit.SetButtonColor(mergeGo, if #mergeSel == MERGE_COUNT then C.Good else C.Disabled)
end

local function selectPet(uid: string?)
	if mergeMode then
		local meta = ClientState.Meta
		if uid and meta then
			local at = table.find(mergeSel, uid)
			if at then
				table.remove(mergeSel, at)
			elseif #mergeSel &lt; MERGE_COUNT then
				local pet = petOf(uid)
				if pet and (pet.Tier or 1) &gt;= #Config.PetTiers then
					UIKit.Toast("Rainbow pets are already maxed!", "Bad")
				elseif pet and not canMergeWith(petOf(mergeSel[1]), pet) then
					UIKit.Toast("Pick three of the SAME pet at the same tier.", "Bad")
				elseif pet then
					table.insert(mergeSel, uid)
				end
			end
		end
		refreshMergePanel()
		PetsUI._refreshGrid()
		return
	end
	selectedUid = uid
	deleteConfirmFrame.Visible = false
	refreshDetailPanel(ClientState.Meta)
	-- The grid highlights the selection: cheapest is a full rebuild, and this list is at most
	-- Config.PetRules.MaxInventory (60) cards, so it's not worth a more surgical update.
	PetsUI._refreshGrid()
end

-- Picks the first set of MERGE_COUNT identical pets (same pet, same tier), preferring ones you
-- don't have equipped.
local function autoPick()
	local meta = ClientState.Meta
	if not meta then
		return
	end
	local groups: { [string]: { any } } = {}
	local order: { string } = {}
	for _, entry in sortedPetList(meta) do
		if (entry.Tier or 1) &lt; #Config.PetTiers then
			local key = entry.Id .. "#" .. (entry.Tier or 1)
			if not groups[key] then
				groups[key] = {}
				table.insert(order, key)
			end
			table.insert(groups[key], entry)
		end
	end
	for _, key in order do
		local group = groups[key]
		if #group &gt;= MERGE_COUNT then
			table.sort(group, function(a, b)
				local ea, eb = isEquipped(meta, a.Uid), isEquipped(meta, b.Uid)
				if ea ~= eb then
					return not ea
				end
				return a.Uid &lt; b.Uid
			end)
			table.clear(mergeSel)
			for i = 1, MERGE_COUNT do
				table.insert(mergeSel, group[i].Uid)
			end
			refreshMergePanel()
			PetsUI._refreshGrid()
			return
		end
	end
	UIKit.Toast(string.format("You need %d of the same pet to merge.", MERGE_COUNT), "Info")
end

local function setMergeMode(on: boolean)
	mergeMode = on
	table.clear(mergeSel)
	mergePanel.Visible = on
	detailEmpty.Parent = if on then nil else detailsCard
	detailFilled.Parent = if on then nil else detailsCard
	mergeButton.Text = if on then "Done" else "Merge"
	if on then
		refreshMergePanel()
	end
	PetsUI._refreshGrid()
end

local function doMerge()
	if #mergeSel ~= MERGE_COUNT then
		UIKit.Toast(string.format("Pick %d pets of the same rarity first.", MERGE_COUNT), "Bad")
		return
	end
	local result = ClientState.MetaRequest("Merge", table.clone(mergeSel))
	if not result.Ok then
		UIKit.Toast(result.Error or "Couldn't merge those.", "Bad")
		return
	end
	table.clear(mergeSel)
	UIKit.PlaySound("Hatch")
	UIKit.Confetti()
	local made = result.Pets and result.Pets[1]
	UIKit.Toast(if made then ("You made a " .. petTitle(made.Id, made.Tier) .. "!") else "Merged!", "Good")
	refreshMergePanel()
end

local function doEquipToggle()
	local uid = selectedUid
	local meta = ClientState.Meta
	if not uid or not meta then
		return
	end
	local equipped = isEquipped(meta, uid)
	-- All slots full: offer the +2 Pet Slots pass (if they don't have it yet).
	if not equipped and #meta.Equipped &gt;= meta.PetSlots and not (meta.Passes and meta.Passes.PetSlots) then
		UIKit.Toast("All your pet slots are full! Get +2 Pet Slots to bring more pets.", "Info")
		ShopUI.BuyPass("PetSlots")
		return
	end
	local result = ClientState.MetaRequest(if equipped then "Unequip" else "Equip", uid)
	if not result.Ok then
		UIKit.Toast(result.Error or "Couldn't do that.", "Bad")
	end
end

local function armDeleteConfirm()
	deleteToken += 1
	local token = deleteToken
	deleteConfirmFrame.Visible = true
	task.delay(4, function()
		if deleteToken == token then
			deleteConfirmFrame.Visible = false
		end
	end)
end

local function doDelete()
	deleteToken += 1
	deleteConfirmFrame.Visible = false
	local uid = selectedUid
	if not uid then
		return
	end
	local result = ClientState.MetaRequest("Delete", uid)
	if not result.Ok then
		UIKit.Toast(result.Error or "Couldn't delete that.", "Bad")
	else
		selectedUid = nil
	end
end

function PetsUI._refreshGrid()
	local meta = ClientState.Meta
	for _, child in gridScroll:GetChildren() do
		if child:IsA("Frame") or child:IsA("TextButton") then
			child:Destroy()
		end
	end
	if not meta then
		return
	end
	local list = sortedPetList(meta)
	local copies: { [string]: number } = {}
	for _, entry in list do
		local key = entry.Id .. "#" .. (entry.Tier or 1)
		copies[key] = (copies[key] or 0) + 1
	end
	-- Merge mode only shows pets you can merge right now: ones you have MERGE_COUNT+ of (same pet,
	-- same tier, not Rainbow yet), and once you've picked one, only that pet.
	local first = if mergeMode then petOf(mergeSel[1]) else nil
	local shown = 0
	for _, entry in list do
		local key = entry.Id .. "#" .. (entry.Tier or 1)
		local mergeable = (copies[key] or 0) &gt;= MERGE_COUNT and (entry.Tier or 1) &lt; #Config.PetTiers and not entry.Def.Event
		if mergeMode and (not mergeable or (first and not canMergeWith(first, entry))) then
			continue
		end
		shown += 1
		buildPetCard(gridScroll, entry, isEquipped(meta, entry.Uid), selectPet, copies[key])
	end
	mergeEmpty.Visible = mergeMode and shown == 0
	local equippedCount = math.min(#meta.Equipped, meta.PetSlots)
	equippedLabel.Text = string.format("Equipped %d/%d   Coins %s", equippedCount, meta.PetSlots, coinText(1 + Config.PetCoinBonus(meta.Pets, meta.Equipped, meta.PetIndex)))
	countLabel.Text = string.format("%d/%d", #meta.Pets, meta.MaxPets)
	refreshDetailPanel(meta)
	if indexPanel and indexPanel.Visible then
		refreshIndex()
	end
end


-- The collection (index): tabs for Normal / Golden / Rainbow / Limited. Every pet you have EVER owned
-- (even if merged or deleted since) shows in colour; the rest are "?". Finishing a tier's tab pays the set prize.
local TIER_DOT = { Color3.fromRGB(190, 215, 240), Color3.fromRGB(255, 205, 60), Color3.fromRGB(255, 120, 220), Color3.fromRGB(255, 130, 90) }
local TAB_NAMES = { "Normal", "Golden", "Rainbow", "Limited" }
local indexTab = 1
local function buildIndexPanel(parent: Frame)
	indexPanel = Instance.new("Frame")
	indexPanel.Name = "IndexPanel"
	indexPanel.BackgroundColor3 = C.PanelDark
	indexPanel.BackgroundTransparency = 0
	indexPanel.Position = UDim2.new(0, 0, 0, 48)
	indexPanel.Size = UDim2.new(1, 0, 1, -48)
	indexPanel.Visible = false
	indexPanel.ZIndex = 20
	UIKit.Corner(indexPanel, 12)
	indexPanel.Parent = parent

	local tabs = Instance.new("Frame")
	tabs.Name = "Tabs"
	tabs.BackgroundTransparency = 1
	tabs.Size = UDim2.new(1, -16, 0, 40)
	tabs.Position = UDim2.fromOffset(8, 6)
	tabs.ZIndex = 21
	tabs.Parent = indexPanel
	local tabLayout = Instance.new("UIListLayout")
	tabLayout.FillDirection = Enum.FillDirection.Horizontal
	tabLayout.Padding = UDim.new(0, 8)
	tabLayout.Parent = tabs
	local tabButtons: { TextButton } = {}

	local info = UIKit.Label({ Name = "SetInfo", Text = "", TextSize = 18, TextScaled = true, Size = UDim2.new(1, -16, 0, 22), Position = UDim2.fromOffset(8, 52), ZIndex = 21, Parent = indexPanel })
	local barBack = Instance.new("Frame")
	barBack.Name = "BarBack"
	barBack.BackgroundColor3 = C.PanelLight
	barBack.Size = UDim2.new(1, -16, 0, 10)
	barBack.Position = UDim2.fromOffset(8, 78)
	barBack.ZIndex = 21
	UIKit.Corner(barBack, 5)
	barBack.Parent = indexPanel
	local barFill = Instance.new("Frame")
	barFill.BackgroundColor3 = C.Good
	barFill.Size = UDim2.fromScale(0, 1)
	barFill.ZIndex = 22
	UIKit.Corner(barFill, 5)
	barFill.Parent = barBack

	local scroll = Instance.new("ScrollingFrame")
	scroll.Name = "Species"
	scroll.BackgroundTransparency = 1
	scroll.BorderSizePixel = 0
	scroll.Position = UDim2.fromOffset(8, 96)
	scroll.Size = UDim2.new(1, -16, 1, -104)
	scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
	scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroll.ScrollBarThickness = 8
	scroll.ScrollBarImageColor3 = C.Primary
	scroll.ZIndex = 21
	scroll.Parent = indexPanel
	local grid = Instance.new("UIGridLayout")
	grid.CellSize = UDim2.fromOffset(122, 126)
	grid.CellPadding = UDim2.fromOffset(8, 8)
	grid.SortOrder = Enum.SortOrder.LayoutOrder
	grid.Parent = scroll

	refreshIndex = function()
		local meta = ClientState.Meta
		local index = meta and meta.PetIndex or {}
		for i, button in tabButtons do
			UIKit.SetButtonColor(button, if i == indexTab then TIER_DOT[i] else C.PanelLight)
		end
		for _, child in scroll:GetChildren() do
			if child:IsA("Frame") then
				child:Destroy()
			end
		end
		local limitedTab = indexTab == 4
		local list: { string } = Config.CollectionSpecies(limitedTab)
		if limitedTab then
			local only = {}
			for _, id in list do
				if Config.Pets[id].Event then
					table.insert(only, id)
				end
			end
			list = only
		end
		-- progress line
		local have = 0
		for _, id in list do
			local found = if limitedTab then (tonumber(index[id]) or 0) &gt; 0 else Config.CollectionHas(index, id, indexTab)
			if found then
				have += 1
			end
		end
		if limitedTab then
			info.Text = string.format("Limited pets  %d/%d  -  exclusive, can't be merged, and gone for good when an event ends", have, #list)
			info.TextColor3 = TIER_DOT[4]
		else
			local set = Config.Collection.Sets[indexTab]
			local done = have &gt;= #list
			info.Text = string.format("%s set  %d/%d  -  %s", TAB_NAMES[indexTab], have, #list, if done then string.format("complete! +%d%% coins", math.floor(set.Bonus * 100 + 0.5)) else string.format("reward: +%d%% coins and %d Gems", math.floor(set.Bonus * 100 + 0.5), set.Gems))
			info.TextColor3 = if done then C.Good else TIER_DOT[indexTab]
		end
		barFill.Size = UDim2.fromScale(math.clamp(have / math.max(1, #list), 0, 1), 1)
		barFill.BackgroundColor3 = TIER_DOT[indexTab]
		-- cards
		for order, id in list do
			local def = Config.Pets[id]
			local tierToShow = if limitedTab then 1 else indexTab
			local found = if limitedTab then (tonumber(index[id]) or 0) &gt; 0 else Config.CollectionHas(index, id, indexTab)
			local card = UIKit.Card({ LayoutOrder = order, Color = C.PanelLight, StrokeColor = if found then UIKit.RarityColor(def.Rarity) else C.Disabled, Parent = scroll })
			card.ZIndex = 22
			if found then
				local viewport = UIKit.Viewport({
					Model = PetModels.Build(id, tierToShow),
					Size = UDim2.fromOffset(102, 70),
					Position = UDim2.new(0.5, 0, 0, 4),
					AnchorPoint = Vector2.new(0.5, 0),
					Parent = card,
				})
				viewport.ZIndex = 22
			else
				UIKit.Label({ Text = "?", TextSize = 46, TextColor3 = C.Disabled, Size = UDim2.new(1, 0, 0, 70), Position = UDim2.fromOffset(0, 4), ZIndex = 23, Parent = card })
			end
			UIKit.Label({
				Text = if found then def.Name else "???",
				TextSize = 15,
				TextScaled = true,
				TextColor3 = if found then UIKit.RarityColor(def.Rarity) else C.Disabled,
				Size = UDim2.new(1, -8, 0, 20),
				Position = UDim2.fromOffset(4, 78),
				ZIndex = 23,
				Parent = card,
			})
			UIKit.Label({
				Text = if found then def.Rarity else "Not found yet",
				TextSize = 13,
				TextScaled = true,
				TextColor3 = C.TextDim,
				Size = UDim2.new(1, -8, 0, 16),
				Position = UDim2.fromOffset(4, 100),
				ZIndex = 23,
				Parent = card,
			})
			if not found then
				local shade = Instance.new("Frame")
				shade.BackgroundColor3 = Color3.new(0, 0, 0)
				shade.BackgroundTransparency = 0.45
				shade.Size = UDim2.fromScale(1, 1)
				shade.ZIndex = 24
				UIKit.Corner(shade, 12)
				shade.Parent = card
			end
		end
	end

	for i, name in TAB_NAMES do
		local button = UIKit.Button({
			Text = name,
			Size = UDim2.new(0.25, -6, 1, 0),
			Color = C.PanelLight,
			TextSize = 20,
			Parent = tabs,
			OnClick = function()
				indexTab = i
				refreshIndex()
			end,
		})
		button.ZIndex = 22
		table.insert(tabButtons, button)
	end
end

local function buildPetsWindow()
	local _window
	_window, petsContent = UIKit.Window({
		Name = "Pets",
