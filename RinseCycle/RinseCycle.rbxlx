	{ Key = "DoubleCoins", Id = 0, Name = "2x Coins", Icon = "💰", Desc = "Double coins from the drain in every run." },
	{ Key = "MegaTank", Id = 0, Name = "Mega Tank", Icon = "🫙", Desc = "Your tank holds twice as much." },
	{ Key = "AutoDrain", Id = 0, Name = "Auto Drain", Icon = "🌀", Desc = "Your tank sells itself the moment it's full." },
	{ Key = "PetSlots", Id = 0, Name = "+2 Pet Slots", Icon = "🐾", Desc = "Equip two more pets." },
	{ Key = "DoubleBubbles", Id = 0, Name = "2x Bubbles", Icon = "🫧", Desc = "Double Bubbles from every finished run." },
}

----------------------------------------------------------------------------------------------------
-- Sounds. The rbxassetid ones are free Creator Store sounds (Roblox / ProSoundEffects). If one ever
-- fails to load, swap it here; Fallback ships inside every Roblox client.
----------------------------------------------------------------------------------------------------
Config.Sounds = {
	Click = { Id = "rbxassetid://9119717523", Volume = 0.5 },
	Scrub = { Id = "rbxassetid://9125409840", Volume = 0.35 },
	Pop = { Id = "rbxassetid://9113537815", Volume = 0.5 },
	Sell = { Id = "rbxassetid://9125498766", Volume = 0.6 },
	Coins = { Id = "rbxassetid://127645268874265", Volume = 0.5 },
	Sparkle = { Id = "rbxassetid://9126073001", Volume = 0.5 },
	Splash = { Id = "rbxassetid://9120585252", Volume = 0.5 },
	Hatch = { Id = "rbxassetid://9113263649", Volume = 0.6 },
	Error = { Id = "rbxassetid://9113649171", Volume = 0.4 },
	Fallback = { Id = "rbxasset://sounds/impact_water.mp3", Volume = 0.4 },
}

----------------------------------------------------------------------------------------------------
-- Helpers (pure functions, safe on client and server)
----------------------------------------------------------------------------------------------------

-- Round to 2 significant figures so prices look clean (1234 -&gt; 1200, 56 -&gt; 56).
function Config.Round2(n: number): number
	if n &lt; 100 then
		return math.floor(n + 0.5)
	end
	local digits = math.floor(math.log10(n)) + 1
	local factor = 10 ^ (digits - 2)
	return math.floor(n / factor + 0.5) * factor
end

function Config.GetLevel(levelIndex: number)
	return Config.Levels[levelIndex] or Config.Levels[1]
end

function Config.GetUpgrade(upgradeId: string)
	for _, u in Config.Upgrades do
		if u.Id == upgradeId then
			return u
		end
	end
	return nil
end

function Config.GetPerk(perkId: string)
	for _, p in Config.Perks do
		if p.Id == perkId then
			return p
		end
	end
	return nil
end

function Config.GetEgg(eggId: string)
	for _, e in Config.Eggs do
		if e.Id == eggId then
			return e
		end
	end
	return nil
end

function Config.GetPass(key: string)
	for _, p in Config.GamePasses do
		if p.Key == key then
			return p
		end
	end
	return nil
end

-- Coin price of the next level of an in-run upgrade, or nil when maxed.
function Config.UpgradeCost(upgradeId: string, currentLevel: number, levelIndex: number): number?
	local u = Config.GetUpgrade(upgradeId)
	if not u or currentLevel &gt;= u.Max then
		return nil
	end
	return Config.Round2(u.Base * (u.Growth ^ currentLevel) * Config.GetLevel(levelIndex).Mult)
end

-- Coin price of a tool in a run.
function Config.ToolCost(toolIndex: number, levelIndex: number): number?
	local t = Config.Tools[toolIndex]
	if not t then
		return nil
	end
	return Config.Round2(t.Cost * Config.GetLevel(levelIndex).Mult)
end

-- Bubble price of the next level of a perk, or nil when maxed.
function Config.PerkCost(perkId: string, currentLevel: number): number?
	local p = Config.GetPerk(perkId)
	if not p or currentLevel &gt;= p.Max then
		return nil
	end
	if p.Costs then
		return p.Costs[currentLevel + 1]
	end
	return Config.Round2(p.Base * (p.Growth ^ currentLevel))
end

-- Sum of CoinBonus over equipped pets. pets = profile.Pets ({ {Uid, Id} }), equipped = { uid, ... }.
function Config.PetCoinBonus(pets, equipped): number
	local byUid = {}
	for _, pet in pets or {} do
		byUid[pet.Uid] = pet.Id
	end
	local total = 0
	for _, uid in equipped or {} do
		local def = Config.Pets[byUid[uid] or ""]
		if def then
			total += def.CoinBonus
		end
	end
	return total
end

--[[
	All stats a player has inside a run.
	  levelIndex : which dishwasher
	  upgrades   : { Hold = n, HandSize = n, ScrubPower = n, TankSize = n, Sneakers = n }
	  toolIndex  : index into Config.Tools
	  perks      : { HeadStart = n, CoinSoap = n, DeepTank = n, ... } (from the profile)
	  passes     : { DoubleCoins = bool, MegaTank = bool, ... }
	  petCoinBonus : Config.PetCoinBonus(...)
]]
function Config.GetRunStats(levelIndex: number, upgrades, toolIndex: number, perks, passes, petCoinBonus: number?)
	local level = Config.GetLevel(levelIndex)
	local tool = Config.Tools[toolIndex] or Config.Tools[1]
	upgrades = upgrades or {}
	perks = perks or {}
	passes = passes or {}
	local b = Config.Base

	local radius = (b.Radius + b.RadiusPerLevel * (upgrades.HandSize or 0)) * tool.Radius
	local power = b.Power * (b.PowerGrowth ^ (upgrades.ScrubPower or 0)) * tool.Power * level.Mult
	local tank = b.Tank * (b.TankGrowth ^ (upgrades.TankSize or 0)) * level.Mult
	tank *= 1 + (perks.DeepTank or 0) * Config.GetPerk("DeepTank").PerLevel
	if passes.MegaTank then
		tank *= 2
	end
	local coinMult = 1 + (perks.CoinSoap or 0) * Config.GetPerk("CoinSoap").PerLevel + (petCoinBonus or 0)
	if passes.DoubleCoins then
		coinMult *= 2
	end

	return {
		Radius = radius,
		Power = power,
		TankMax = math.floor(tank),
		Reach = tool.Reach,
		WalkSpeed = b.WalkSpeed + b.WalkSpeedPerLevel * (upgrades.Sneakers or 0),
		Hold = (upgrades.Hold or 0) &gt;= 1,
		CoinMult = coinMult,
		ToolIndex = toolIndex,
	}
end

-- Coins a run starts with (Head Start perk).
function Config.StartCoins(levelIndex: number, perks): number
	local lvl = (perks and perks.HeadStart) or 0
	return math.floor(lvl * Config.GetPerk("HeadStart").PerLevel * Config.GetLevel(levelIndex).Mult)
end

-- Equip slots for pets.
function Config.PetSlots(perks, passes): number
	local slots = Config.PetRules.BaseSlots + ((perks and perks.PetSlot) or 0)
	if passes and passes.PetSlots then
		slots += 2
	end
	return slots
end

-- Sanity checks that run once when the module is first required (catches typos in the tables above).
do
	for _, level in Config.Levels do
		for _, g in level.Grime do
			assert(Config.GrimeTypes[g.Type], "Config: level " .. level.Name .. " uses unknown grime " .. g.Type)
		end
		for _, kind in Config.DishKinds do
			assert(level.Dishes[kind] ~= nil and level.Spots[kind] ~= nil, "Config: level " .. level.Name .. " missing dish kind " .. kind)
		end
	end
	for _, egg in Config.Eggs do
		local sum = 0
		for _, entry in egg.Pets do
			assert(Config.Pets[entry.Pet], "Config: egg " .. egg.Id .. " has unknown pet " .. entry.Pet)
			sum += entry.Chance
		end
		assert(math.abs(sum - 100) &lt; 0.001, "Config: egg " .. egg.Id .. " chances add to " .. sum)
	end
	for id, pet in Config.Pets do
		assert(Config.Rarities[pet.Rarity], "Config: pet " .. id .. " has unknown rarity")
	end
end

return Config</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000005"><Properties><string name="Name">Format</string><ProtectedString name="Source">-- Number and time formatting for UI text.

local Format = {}

local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi" }

-- 950 -&gt; "950", 1234 -&gt; "1.2K", 15300 -&gt; "15.3K", 2500000 -&gt; "2.5M"
function Format.Short(n: number): string
	n = math.floor(n or 0)
	local negative = n &lt; 0
	n = math.abs(n)
	if n &lt; 1000 then
		return (negative and "-" or "") .. tostring(n)
	end
	local i = 1
	local value = n
	while value &gt;= 1000 and i &lt; #SUFFIXES do
		value /= 1000
		i += 1
	end
	local text
	if value &gt;= 100 then
		text = string.format("%d", math.floor(value))
	elseif value &gt;= 10 then
		text = string.format("%.1f", math.floor(value * 10) / 10)
	else
		text = string.format("%.2f", math.floor(value * 100) / 100)
	end
	text = text:gsub("%.?0+$", "")
	return (negative and "-" or "") .. text .. SUFFIXES[i]
end

-- 1234567 -&gt; "1,234,567"
function Format.Commas(n: number): string
	local s = tostring(math.floor(n or 0))
	local negative = s:sub(1, 1) == "-"
	if negative then
		s = s:sub(2)
	end
	local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if out:sub(1, 1) == "," then
		out = out:sub(2)
	end
	return (negative and "-" or "") .. out
end

-- 75 -&gt; "1:15", 3725 -&gt; "1:02:05"
function Format.Time(seconds: number): string
	seconds = math.max(0, math.floor(seconds or 0))
	local h = seconds // 3600
	local m = (seconds % 3600) // 60
	local s = seconds % 60
	if h &gt; 0 then
		return string.format("%d:%02d:%02d", h, m, s)
	end
	return string.format("%d:%02d", m, s)
end

-- 0.05 -&gt; "+5%", 0.125 -&gt; "+12.5%"
function Format.Percent(fraction: number): string
	local pct = math.floor(fraction * 1000 + 0.5) / 10
	local text = if pct == math.floor(pct) then string.format("%d", pct) else string.format("%.1f", pct)
	return (fraction &gt;= 0 and "+" or "") .. text .. "%"
end

-- 0.5 -&gt; "0.5%", 3.5 -&gt; "3.5%", 60 -&gt; "60%"  (already a percentage)
function Format.Chance(pct: number): string
	if pct == math.floor(pct) then
		return string.format("%d%%", pct)
	end
	return (string.format("%.2f", pct):gsub("0+$", "")) .. "%"
end

return Format</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000006"><Properties><string name="Name">PetModels</string><ProtectedString name="Source">-- PetModels: every pet (and egg) is built here from primitive parts, so the game ships with no
-- uploaded meshes. Shared: the client renders pets in the world and in ViewportFrames with it, and
-- the lobby can use the eggs for its displays.
--
-- Conventions (DESIGN.md "PetModels"):
--   * A pet is ~2.5-3.5 studs tall and faces -Z, so Model:GetPivot().LookVector is where it looks.
--   * PrimaryPart "Root" is an invisible 1x1x1 part at the centre (the pivot). Every other part is
--     placed relative to it, so PivotTo moves the whole pet. There are no welds.
--   * Every part is Anchored, Massless, CastShadow = false and CanCollide/CanQuery/CanTouch = false.
--   * Ellipsoids are Block parts with a SpecialMesh (Sphere), which stretches to the part's Size.
--   * The look is "soap commercial": clean SmoothPlastic, big shiny black eyes with a white
--     highlight, blush cheeks, and Neon/Glass accents. Each pet stays at or under ~25 parts.
--   * Models are built at the origin (Root.CFrame = identity), so "model space" = world space while
--     building. Each id is built once into a template; every call returns a fresh Clone.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local PetModels = {}

----------------------------------------------------------------------------------------------------
-- Palette and shared part options
----------------------------------------------------------------------------------------------------

local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.new(0, 0, 0)
local EYE_COLOR = Color3.fromRGB(28, 24, 40)
local BLUSH_COLOR = Color3.fromRGB(255, 130, 165)
local MOUTH_COLOR = Color3.fromRGB(95, 35, 55)
local NOSE_COLOR = Color3.fromRGB(45, 35, 45)
local BEAK_COLOR = Color3.fromRGB(255, 165, 60)
local SPONGE_COLOR = Color3.fromRGB(255, 221, 87)
local GEM_COLOR = Color3.fromRGB(255, 70, 120)
local SPARKLE_TEXTURE = "rbxasset://textures/particles/sparkles_main.dds"
local RAINBOW = {
	Color3.fromRGB(255, 95, 95),
	Color3.fromRGB(255, 170, 70),
	Color3.fromRGB(255, 230, 90),
	Color3.fromRGB(110, 230, 130),
	Color3.fromRGB(90, 180, 255),
	Color3.fromRGB(190, 130, 255),
}
-- Used when an id is unknown (or a builder fails): a friendly blue-grey "mystery blob".
local PLACEHOLDER_BODY = Color3.fromRGB(185, 195, 215)
local PLACEHOLDER_ACCENT = Color3.fromRGB(120, 200, 255)
local PLACEHOLDER_KEY = "\0Placeholder" -- can never collide with a real pet id
local SHINY_REFLECTANCE = 0.12 -- extra gloss on the main body parts of Shiny pets

type Opts = {
	Material: Enum.Material?,
	Transparency: number?,
	Reflectance: number?,
	Glossy: boolean?, -- a main body part: picks up SHINY_REFLECTANCE on shiny pets
}

-- Frozen option tables shared by every builder (never mutated).
local GLOSSY: Opts = table.freeze({ Glossy = true })
local NEON: Opts = table.freeze({ Material = Enum.Material.Neon })
local SHINE: Opts = table.freeze({ Material = Enum.Material.Neon, Transparency = 0.3 })
local BUBBLE: Opts = table.freeze({ Material = Enum.Material.Glass, Transparency = 0.3, Reflectance = 0.25 })
local FIN: Opts = table.freeze({ Material = Enum.Material.Glass, Transparency = 0.15, Reflectance = 0.1 })
local EYE: Opts = table.freeze({ Reflectance = 0.15 })
local BLUSH: Opts = table.freeze({ Transparency = 0.2 })
local GOLD: Opts = table.freeze({ Reflectance = 0.3, Glossy = true })

type Ctx = {
	Model: Model,
	Root: Part,
	Shiny: boolean,
	Count: number, -- parts created (Root included); checked against the budget in Studio warnings
}

local PART_BUDGET = 26

local function tint(c: Color3, t: number): Color3
	return c:Lerp(WHITE, t)
end

local function shade(c: Color3, t: number): Color3
	return c:Lerp(BLACK, t)
end

----------------------------------------------------------------------------------------------------
-- Part factory
----------------------------------------------------------------------------------------------------

local function applyStatic(part: BasePart)
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Massless = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
end

local function newCtx(name: string, shiny: boolean): Ctx
	local model = Instance.new("Model")
	model.Name = name

	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.one
	root.CFrame = CFrame.identity
	root.Transparency = 1
	applyStatic(root)
	root.Parent = model
	model.PrimaryPart = root

	return { Model = model, Root = root, Shiny = shiny, Count = 1 }
end

-- kind: "Ellipsoid" | "Ball" | "Block" | "Cylinder" (axis = local X) | "Wedge"
local function addPart(ctx: Ctx, name: string, kind: string, size: Vector3, cf: CFrame, color: Color3, opts: Opts?): BasePart
	local part: BasePart
	if kind == "Wedge" then
		part = Instance.new("WedgePart")
	else
		local p = Instance.new("Part")
		if kind == "Ball" then
			p.Shape = Enum.PartType.Ball
		elseif kind == "Cylinder" then
			p.Shape = Enum.PartType.Cylinder
		else
			p.Shape = Enum.PartType.Block
		end
		part = p
	end
	part.Name = name
	part.Size = size
	part.CFrame = cf
	part.Color = color
	part.Material = (opts and opts.Material) or Enum.Material.SmoothPlastic
	part.Transparency = (opts and opts.Transparency) or 0
	local reflectance = (opts and opts.Reflectance) or 0
	if ctx.Shiny and opts and opts.Glossy then
		reflectance = math.max(reflectance, SHINY_REFLECTANCE)
	end
	part.Reflectance = reflectance
	applyStatic(part)
	if kind == "Ellipsoid" then
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere -- stretches to the part's Size: a true ellipsoid
		mesh.Parent = part
	end
	part.Parent = ctx.Model
	ctx.Count += 1
	return part
end

local function ellipsoid(ctx: Ctx, name: string, size: Vector3, cf: CFrame, color: Color3, opts: Opts?): BasePart
	return addPart(ctx, name, "Ellipsoid", size, cf, color, opts)
end

local function ball(ctx: Ctx, name: string, diameter: number, pos: Vector3, color: Color3, opts: Opts?): BasePart
	return addPart(ctx, name, "Ball", Vector3.one * diameter, CFrame.new(pos), color, opts)
end

----------------------------------------------------------------------------------------------------
-- Orientation and surface helpers
----------------------------------------------------------------------------------------------------

-- A CFrame at pos whose LookVector is dir. Flattened features (eyes, cheeks, spots) are thin along
-- their local Z, so this lays them flat on a surface whose outward normal is dir.
local function facing(pos: Vector3, dir: Vector3): CFrame
	local d = dir.Unit
	local up = if math.abs(d.Y) &gt; 0.98 then Vector3.zAxis else Vector3.yAxis
	return CFrame.lookAt(pos, pos + d, up)
end

-- A CFrame at pos whose UpVector is dir (limbs, stalks, crystals).
local function upright(pos: Vector3, dir: Vector3): CFrame
	local y = dir.Unit
	local ref = if math.abs(y.Z) &gt; 0.98 then Vector3.xAxis else Vector3.zAxis
	local x = y:Cross(ref).Unit
	local z = x:Cross(y)
	return CFrame.fromMatrix(pos, x, y, z)
end

-- A rounded limb: an ellipsoid stretched from a to b (slightly past both ends so joints overlap).
local function limb(ctx: Ctx, name: string, a: Vector3, b: Vector3, width: number, color: Color3, opts: Opts?): BasePart
	local length = (b - a).Magnitude
	return ellipsoid(ctx, name, Vector3.new(width, length + width * 0.35, width), upright((a + b) / 2, b - a), color, opts)
end

-- A thin cylinder from a to b (whiskers, eye stalks). Cylinders run along local X, hence the turn.
local function rod(ctx: Ctx, name: string, a: Vector3, b: Vector3, diameter: number, color: Color3, opts: Opts?): BasePart
	local length = (b - a).Magnitude
	local cf = upright((a + b) / 2, b - a) * CFrame.Angles(0, 0, math.pi / 2)
	return addPart(ctx, name, "Cylinder", Vector3.new(length, diameter, diameter), cf, color, opts)
end

-- The front (-Z) surface of an axis-aligned ellipsoid (centre c, full size s) at offset (x, y)
-- from its centre, plus the outward normal there.
local function front(c: Vector3, s: Vector3, x: number, y: number): (Vector3, Vector3)
	local a, b, d = s.X * 0.5, s.Y * 0.5, s.Z * 0.5
	local k = 1 - (x / a) ^ 2 - (y / b) ^ 2
	local z = -d * math.sqrt(math.max(k, 0.01))
	local n = Vector3.new(x / (a * a), y / (b * b), z / (d * d)).Unit
	return c + Vector3.new(x, y, z), n
end

-- The surface of an axis-aligned ellipsoid along `dir` from its centre, plus the outward normal.
local function surface(c: Vector3, s: Vector3, dir: Vector3): (Vector3, Vector3)
	local a, b, d = s.X * 0.5, s.Y * 0.5, s.Z * 0.5
	local u = dir.Unit
	local t = 1 / math.sqrt((u.X / a) ^ 2 + (u.Y / b) ^ 2 + (u.Z / d) ^ 2)
	local p = u * t
	local n = Vector3.new(p.X / (a * a), p.Y / (b * b), p.Z / (d * d)).Unit
	return c + p, n
end

-- A flattened ellipsoid lying on a surface point (p, n), its centre `lift` studs outward
-- (negative = sunk in, so only a soft dome shows).
local function decal(ctx: Ctx, name: string, p: Vector3, n: Vector3, size: Vector3, color: Color3, lift: number, opts: Opts?): BasePart
	return ellipsoid(ctx, name, size, facing(p + n * lift, n), color, opts)
end

----------------------------------------------------------------------------------------------------
-- Faces: eyes (+ highlight), blush cheeks, mouth, all laid on the front of one ellipsoid
----------------------------------------------------------------------------------------------------

type FaceSpec = {
	EyeX: number?, -- eyes at (+-EyeX, EyeY) from the ellipsoid's centre; nil = no eyes
	EyeY: number?,
	Eye: Vector3?, -- eye size (width, height, depth)
	EyeLift: number?, -- extra outward offset (eyes sitting on top of an owl's face discs)
	CheekX: number?,
	CheekY: number?,
	Cheek: Vector3?,
	CheekColor: Color3?,
	MouthY: number?,
	Mouth: Vector3?,
	MouthColor: Color3?,
}

local DEFAULT_EYE = Vector3.new(0.42, 0.54, 0.22)
local DEFAULT_CHEEK = Vector3.new(0.36, 0.21, 0.1)
local DEFAULT_MOUTH = Vector3.new(0.3, 0.17, 0.1)

local function face(ctx: Ctx, c: Vector3, s: Vector3, spec: FaceSpec)
	if spec.EyeX and spec.EyeY then
		local size = spec.Eye or DEFAULT_EYE
		for side = -1, 1, 2 do
			local p, n = front(c, s, side * spec.EyeX, spec.EyeY)
			-- Sink the eye a touch so its rim hides in the curved surface and only a glossy dome shows.
			local cf = facing(p + n * ((spec.EyeLift or 0) - size.Z * 0.15), n)
			ellipsoid(ctx, "Eye", size, cf, EYE_COLOR, EYE)
			-- Highlight up and to the viewer's left (local +X) on both eyes, half-sunk into the eye.
			local shine = cf * CFrame.new(size.X * 0.2, size.Y * 0.2, -size.Z * 0.35)
			addPart(ctx, "EyeShine", "Ball", Vector3.one * (size.X * 0.36), shine, WHITE, NEON)
		end
	end
	if spec.CheekX and spec.CheekY then
		for side = -1, 1, 2 do
			local p, n = front(c, s, side * spec.CheekX, spec.CheekY)
			decal(ctx, "Cheek", p, n, spec.Cheek or DEFAULT_CHEEK, spec.CheekColor or BLUSH_COLOR, -0.02, BLUSH)
		end
	end
	if spec.MouthY then
		local p, n = front(c, s, 0, spec.MouthY)
		decal(ctx, "Mouth", p, n, spec.Mouth or DEFAULT_MOUTH, spec.MouthColor or MOUTH_COLOR, -0.02)
	end
end

--[[
	A pointed ear from one WedgePart. size = (thickness, height, base width).
	A WedgePart's triangle lies in its local YZ plane, so the ear is turned 90 degrees about Y to
	face forward, mirrored per side, then leaned outward by tiltDeg. The inner ear is a smaller
	wedge in the same orientation, scaled about the triangle's centroid height and nudged just in
	front of the ear. Keeping its Z offset at 0 keeps it inside the triangle whichever way the
	slope runs.
]]
local function wedgeEar(ctx: Ctx, side: number, pos: Vector3, size: Vector3, tiltDeg: number, color: Color3, innerColor: Color3?)
	local cf = CFrame.new(pos) * CFrame.Angles(0, 0, -side * math.rad(tiltDeg)) * CFrame.Angles(0, -side * math.pi / 2, 0)
	addPart(ctx, "Ear", "Wedge", size, cf, color, GLOSSY)
	if innerColor then
		local scale = 0.55
		local inner = Vector3.new(size.X * 0.4, size.Y * scale, size.Z * scale)
		-- After the quarter turn, the ear's front face is local -X on the +X side, +X on the -X side.
		local x = -side * (size.X * 0.5 - inner.X * 0.5 + 0.02)
		local y = -size.Y / 6 * (1 - scale) - 0.03
		addPart(ctx, "EarInner", "Wedge", inner, cf * CFrame.new(x, y, 0), innerColor)
	end
end

-- One tentacle hanging from a mantle at angle `a` (radians around Y; 0 = +X, pi/2 = +Z).
-- tiltDeg: how far the tip swings outward (0 = straight down, over 90 = raised up and waving).
-- Returns the tip position.
local function tentacle(ctx: Ctx, a: number, radius: number, y: number, length: number, width: number, tiltDeg: number, color: Color3, curlColor: Color3?, curlSize: number?): Vector3
	local out = Vector3.new(math.cos(a), 0, math.sin(a))
	local t = math.rad(tiltDeg)
	local dir = Vector3.new(0, -math.cos(t), 0) + out * math.sin(t)
	local base = Vector3.new(out.X * radius, y, out.Z * radius)
	local tip = base + dir * length
	limb(ctx, "Tentacle", base, tip, width, color, GLOSSY)
	if curlColor and curlSize then
		-- A little curled-up tip, slightly outward and up so it reads as a curl.
		ball(ctx, "Curl", curlSize, tip + out * (curlSize * 0.25) + Vector3.new(0, curlSize * 0.2, 0), curlColor)
	end
	return tip
end

-- Gold sparkles around shiny pets (and the Sparkle egg). Emitted outward from the Root's surface
-- and slowed by drag, so they twinkle just outside the pet's silhouette.
local function addSparkles(root: BasePart, name: string)
	local e = Instance.new("ParticleEmitter")
	e.Name = name
	e.Texture = SPARKLE_TEXTURE
	e.Color = ColorSequence.new(Color3.fromRGB(255, 240, 150), Color3.fromRGB(255, 190, 40))
	e.LightEmission = 1
	e.LightInfluence = 0
	e.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(0.25, 0.38),
		NumberSequenceKeypoint.new(1, 0),
	})
	e.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.1),
		NumberSequenceKeypoint.new(0.7, 0.2),
		NumberSequenceKeypoint.new(1, 1),
	})
	e.Lifetime = NumberRange.new(0.7, 1.3)
	e.Rate = 7
	e.Speed = NumberRange.new(1.8, 3.2)
	e.Drag = 2.5
	e.SpreadAngle = Vector2.new(180, 180)
	e.Rotation = NumberRange.new(0, 360)
	e.RotSpeed = NumberRange.new(-90, 90)
	e.Shape = Enum.ParticleEmitterShape.Sphere
	e.ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface
	e.ShapeInOut = Enum.ParticleEmitterShapeInOut.Outward
	e.ZOffset = 1
	e.Parent = root
end

----------------------------------------------------------------------------------------------------
-- Pet builders, keyed by Config.Pets[id].Model. Each gets (ctx, bodyColor, accentColor).
----------------------------------------------------------------------------------------------------

local BUILDERS: { [string]: (Ctx, Color3, Color3) -&gt; () } = {}

-- Rubber Duck / Golden Duck: round bath toy with a two-piece bill, stubby wings and a curl on top.
BUILDERS.Duck = function(ctx, body, accent)
	ellipsoid(ctx, "Body", Vector3.new(2.5, 1.8, 2.9), CFrame.new(0, -0.5, 0.2), body, GLOSSY)
	-- Perky tail: tipped up and back (a negative X turn swings local +Z upward).
	ellipsoid(ctx, "Tail", Vector3.new(0.9, 0.55, 1.1), CFrame.new(0, 0.02, 1.4) * CFrame.Angles(math.rad(-35), 0, 0), body, GLOSSY)

	local headC, headS = Vector3.new(0, 0.7, -0.55), Vector3.new(1.75, 1.75, 1.75)
	ellipsoid(ctx, "Head", headS, CFrame.new(headC), body, GLOSSY)
	ellipsoid(ctx, "Bill", Vector3.new(0.95, 0.32, 0.8), CFrame.new(0, 0.5, -1.42), accent)
	ellipsoid(ctx, "BillLower", Vector3.new(0.72, 0.22, 0.58), CFrame.new(0, 0.36, -1.33), shade(accent, 0.12))
	face(ctx, headC, headS, {
		EyeX = 0.36,
		EyeY = 0.24,
		Eye = Vector3.new(0.36, 0.46, 0.2),
		CheekX = 0.6,
		CheekY = 0,
		Cheek = Vector3.new(0.32, 0.18, 0.1),
	})

	for side = -1, 1, 2 do
		local wing = CFrame.new(side * 1.2, -0.4, 0.3) * CFrame.Angles(0, 0, -side * math.rad(22))
		ellipsoid(ctx, "Wing", Vector3.new(0.32, 0.85, 1.3), wing, shade(body, 0.06), GLOSSY)
	end
	ellipsoid(ctx, "Tuft", Vector3.new(0.22, 0.52, 0.22), CFrame.new(0.06, 1.62, -0.52) * CFrame.Angles(0, 0, math.rad(-18)), body, GLOSSY)
	ellipsoid(ctx, "Tuft", Vector3.new(0.17, 0.38, 0.17), CFrame.new(-0.13, 1.56, -0.46) * CFrame.Angles(0, 0, math.rad(24)), body, GLOSSY)
end

-- Soap Slime: a jelly blob (glass shell over a solid core) with a drip on top and soap bubbles.
BUILDERS.Slime = function(ctx, body, accent)
	local shellC, shellS = Vector3.new(0, -0.15, 0), Vector3.new(2.7, 2.3, 2.6)
	ellipsoid(ctx, "Core", Vector3.new(2.25, 1.9, 2.15), CFrame.new(0, -0.2, 0.05), shade(body, 0.05))
	ellipsoid(ctx, "Body", shellS, CFrame.new(shellC), body, { Material = Enum.Material.Glass, Transparency = 0.35, Reflectance = 0.1 })
	ellipsoid(ctx, "Base", Vector3.new(3.1, 0.6, 3.0), CFrame.new(0, -1.15, 0.05), body, GLOSSY)
	ellipsoid(ctx, "Drip", Vector3.new(0.7, 0.95, 0.7), CFrame.new(0.12, 1.02, 0.1) * CFrame.Angles(0, 0, math.rad(-18)), body, {
		Material = Enum.Material.Glass,
		Transparency = 0.2,
		Reflectance = 0.1,
	})

	ball(ctx, "Bubble", 0.5, Vector3.new(1.45, 0.45, -0.25), accent, BUBBLE)
	ball(ctx, "Bubble", 0.34, Vector3.new(-1.5, 0.85, 0.2), accent, BUBBLE)
	ball(ctx, "Bubble", 0.28, Vector3.new(1.15, 1.2, 0.35), accent, BUBBLE)

	-- Soft window-light streak on the shell, above the viewer-left eye.
	local p, n = front(shellC, shellS, 0.75, 0.62)
	ellipsoid(ctx, "Shine", Vector3.new(0.3, 0.55, 0.08), facing(p + n * 0.02, n) * CFrame.Angles(0, 0, math.rad(-30)), WHITE, SHINE)

	face(ctx, shellC, shellS, {
		EyeX = 0.46,
		EyeY = 0.05,
		Eye = Vector3.new(0.44, 0.58, 0.22),
		CheekX = 0.86,
		CheekY = -0.28,
		MouthY = -0.3,
		Mouth = Vector3.new(0.34, 0.2, 0.1),
	})
end

-- Sponge Pup: the body is a kitchen sponge (yellow block with a green scrubber layer and pores),
-- with a round puppy head, floppy scrubber-green ears and a little tongue.
BUILDERS.Pup = function(ctx, body, accent)
	addPart(ctx, "Body", "Block", Vector3.new(2.0, 1.3, 2.5), CFrame.new(0, -0.55, 0.35), body, GLOSSY)
	addPart(ctx, "Scrubber", "Block", Vector3.new(2.06, 0.34, 2.56), CFrame.new(0, 0.26, 0.35), accent)
	local pore = shade(body, 0.2)
	for side = -1, 1, 2 do
		ellipsoid(ctx, "Pore", Vector3.new(0.1, 0.3, 0.36), CFrame.new(side * 1.0, -0.4, 0.15), pore)
		ellipsoid(ctx, "Pore", Vector3.new(0.1, 0.22, 0.26), CFrame.new(side * 1.0, -0.85, 0.95), pore)
	end

	local headC, headS = Vector3.new(0, 0.6, -0.85), Vector3.new(1.85, 1.7, 1.7)
	ellipsoid(ctx, "Head", headS, CFrame.new(headC), body, GLOSSY)
	ellipsoid(ctx, "Snout", Vector3.new(0.95, 0.62, 0.62), CFrame.new(0, 0.28, -1.66), tint(body, 0.5))
	ellipsoid(ctx, "Nose", Vector3.new(0.34, 0.24, 0.2), CFrame.new(0, 0.46, -1.93), NOSE_COLOR, EYE)
	ellipsoid(ctx, "Tongue", Vector3.new(0.26, 0.1, 0.34), CFrame.new(0, -0.05, -1.82) * CFrame.Angles(math.rad(-25), 0, 0), Color3.fromRGB(255, 120, 140))
	face(ctx, headC, headS, {
		EyeX = 0.38,
		EyeY = 0.22,
		Eye = Vector3.new(0.4, 0.52, 0.22),
		CheekX = 0.66,
		CheekY = -0.12,
	})

	for side = -1, 1, 2 do
		-- Floppy ears: the tops lean in, so the bottoms swing out.
		ellipsoid(ctx, "Ear", Vector3.new(0.4, 1.0, 0.62), CFrame.new(side * 0.98, 0.45, -0.8) * CFrame.Angles(0, 0, side * math.rad(22)), accent)
		for _, z in { -0.4, 1.1 } do
			ellipsoid(ctx, "Leg", Vector3.new(0.6, 0.55, 0.62), CFrame.new(side * 0.62, -1.3, z), shade(body, 0.08), GLOSSY)
		end
	end
	ellipsoid(ctx, "Tail", Vector3.new(0.28, 0.7, 0.28), CFrame.new(0, 0.55, 1.62) * CFrame.Angles(math.rad(35), 0, 0), accent)
end

-- Bubble Fish: a round puffy fish with a white band, a V tail, fins, and bubbles from its "o" mouth.
BUILDERS.Fish = function(ctx, body, accent)
	local bodyC, bodyS = Vector3.new(0, 0.05, 0), Vector3.new(1.8, 2.3, 2.8)
	ellipsoid(ctx, "Body", bodyS, CFrame.new(bodyC), body, GLOSSY)
	ellipsoid(ctx, "Belly", Vector3.new(1.62, 1.35, 2.1), CFrame.new(0, -0.45, -0.15), tint(body, 0.55))
	-- Band: the body's cross-section at dz, blown up 8% so a stripe stands proud of the body.
	local dz = 0.45
	local f = math.sqrt(1 - (dz / (bodyS.Z * 0.5)) ^ 2) * 1.08
	ellipsoid(ctx, "Stripe", Vector3.new(bodyS.X * f, bodyS.Y * f, 0.5), CFrame.new(bodyC + Vector3.new(0, 0, dz)), accent)

	local finColor = accent:Lerp(body, 0.3)
	ellipsoid(ctx, "Tail", Vector3.new(0.18, 1.15, 0.95), CFrame.new(0, 0.5, 1.6) * CFrame.Angles(math.rad(40), 0, 0), finColor, FIN)
	ellipsoid(ctx, "Tail", Vector3.new(0.18, 1.15, 0.95), CFrame.new(0, -0.4, 1.6) * CFrame.Angles(math.rad(-40), 0, 0), finColor, FIN)
	ellipsoid(ctx, "Fin", Vector3.new(0.16, 0.8, 1.2), CFrame.new(0, 1.12, 0.25) * CFrame.Angles(math.rad(25), 0, 0), finColor, FIN)
	for side = -1, 1, 2 do
		local cf = CFrame.new(side * 0.92, -0.3, 0.2) * CFrame.Angles(0, 0, -side * math.rad(40)) * CFrame.Angles(math.rad(20), 0, 0)
		ellipsoid(ctx, "SideFin", Vector3.new(0.12, 0.5, 0.8), cf, finColor, FIN)
	end

	face(ctx, bodyC, bodyS, {
		EyeX = 0.42,
		EyeY = 0.35,
		Eye = Vector3.new(0.42, 0.54, 0.22),
		CheekX = 0.6,
		CheekY = -0.08,
		MouthY = -0.32,
		Mouth = Vector3.new(0.3, 0.26, 0.12),
		MouthColor = Color3.fromRGB(235, 95, 130),
	})
	ball(ctx, "Bubble", 0.4, Vector3.new(-0.95, 0.75, -1.25), accent, BUBBLE)
	ball(ctx, "Bubble", 0.28, Vector3.new(-1.15, 1.25, -1.1), accent, BUBBLE)
end

-- Scrub Bunny: chubby bunny with one floppier ear, pink inner ears, buck teeth and a pom tail.
BUILDERS.Bunny = function(ctx, body, accent)
	ellipsoid(ctx, "Body", Vector3.new(2.0, 1.5, 2.0), CFrame.new(0, -0.85, 0.2), body, GLOSSY)
	local headC, headS = Vector3.new(0, 0.3, -0.25), Vector3.new(1.95, 1.65, 1.7)
	ellipsoid(ctx, "Head", headS, CFrame.new(headC), body, GLOSSY)

	for side = -1, 1, 2 do
		local tilt = if side == 1 then 10 else 26 -- one ear flops a little more
		local ear = CFrame.new(side * 0.42, 1.3, -0.2) * CFrame.Angles(0, 0, -side * math.rad(tilt))
		ellipsoid(ctx, "Ear", Vector3.new(0.46, 1.25, 0.3), ear, body, GLOSSY)
		ellipsoid(ctx, "EarInner", Vector3.new(0.26, 0.9, 0.1), ear * CFrame.new(0, -0.02, -0.12), accent)
		ellipsoid(ctx, "Foot", Vector3.new(0.55, 0.32, 0.8), CFrame.new(side * 0.5, -1.5, -0.5), body, GLOSSY)
		ellipsoid(ctx, "Paw", Vector3.new(0.38, 0.34, 0.4), CFrame.new(side * 0.42, -0.72, -0.72), body, GLOSSY)
	end
	ball(ctx, "Tail", 0.7, Vector3.new(0, -0.95, 1.2), tint(body, 0.4))

	local np, nn = front(headC, headS, 0, -0.05)
	decal(ctx, "Nose", np, nn, Vector3.new(0.22, 0.15, 0.14), accent, 0)
	local tp, tn = front(headC, headS, 0, -0.3)
	addPart(ctx, "Teeth", "Block", Vector3.new(0.22, 0.2, 0.06), facing(tp, tn), WHITE)
	face(ctx, headC, headS, {
		EyeX = 0.4,
		EyeY = 0.15,
		Eye = Vector3.new(0.4, 0.5, 0.22),
		CheekX = 0.66,
		CheekY = -0.18,
	})
end

type SudsSpec = { Dir: Vector3, D: number }
local CRAB_SUDS: { SudsSpec } = {
	{ Dir = Vector3.new(0.3, 1, 0.3), D = 0.62 },
	{ Dir = Vector3.new(-0.35, 1, 0.45), D = 0.5 },
	{ Dir = Vector3.new(0.05, 1, 0.85), D = 0.44 },
}

-- Suds Crab: wide shell topped with soap suds, eyes on stalks, big raised claws, little legs.
BUILDERS.Crab = function(ctx, body, accent)
	local bodyC, bodyS = Vector3.new(0, -0.35, 0.05), Vector3.new(2.9, 1.5, 2.1)
	ellipsoid(ctx, "Body", bodyS, CFrame.new(bodyC), body, GLOSSY)
	local limbColor = shade(body, 0.08)

	for side = -1, 1, 2 do
		rod(ctx, "Stalk", Vector3.new(side * 0.45, 0.1, -0.45), Vector3.new(side * 0.5, 0.85, -0.55), 0.18, body)
		local eyePos = Vector3.new(side * 0.5, 1.0, -0.58)
		ball(ctx, "Eye", 0.62, eyePos, EYE_COLOR, EYE)
		ball(ctx, "EyeShine", 0.2, eyePos + Vector3.new(0.12, 0.13, -0.23), WHITE, NEON)

		limb(ctx, "Arm", Vector3.new(side * 1.25, -0.3, -0.35), Vector3.new(side * 1.75, 0, -0.8), 0.32, limbColor)
		local clawPos = Vector3.new(side * 1.85, 0.2, -0.9)
		ellipsoid(ctx, "Claw", Vector3.new(0.85, 0.72, 0.72), CFrame.new(clawPos) * CFrame.Angles(0, 0, side * math.rad(-15)), body, GLOSSY)
		local thumb = CFrame.new(clawPos + Vector3.new(-side * 0.22, 0.42, -0.05)) * CFrame.Angles(0, 0, side * math.rad(25))
		ellipsoid(ctx, "Pincer", Vector3.new(0.28, 0.5, 0.42), thumb, body, GLOSSY)

		for _, z in { 0.1, 0.65 } do
			limb(ctx, "Leg", Vector3.new(side * 1.15, -0.65, z), Vector3.new(side * 1.65, -1.3, z + 0.1), 0.2, limbColor)
		end
	end

	face(ctx, bodyC, bodyS, {
		CheekX = 0.75,
		CheekY = -0.05,
		CheekColor = Color3.fromRGB(255, 190, 205),
		MouthY = -0.2,
		Mouth = Vector3.new(0.34, 0.16, 0.1),
	})
	for _, s in CRAB_SUDS do
		local p, n = surface(bodyC, bodyS, s.Dir)
		ball(ctx, "Suds", s.D, p + n * (s.D * 0.12), accent)
	end
end

-- Mop Cat: pointed wedge ears, white muzzle and whiskers, white paws, and a tail ending in a mop.
BUILDERS.Cat = function(ctx, body, accent)
	ellipsoid(ctx, "Body", Vector3.new(1.9, 1.5, 2.3), CFrame.new(0, -0.8, 0.35), body, GLOSSY)
	local headC, headS = Vector3.new(0, 0.35, -0.4), Vector3.new(2.1, 1.75, 1.75)
	ellipsoid(ctx, "Head", headS, CFrame.new(headC), body, GLOSSY)

	local mp, mn = front(headC, headS, 0, -0.3)
	decal(ctx, "Muzzle", mp, mn, Vector3.new(0.95, 0.55, 0.4), accent, -0.06)
	local np, nn = front(headC, headS, 0, -0.08)
	decal(ctx, "Nose", np, nn, Vector3.new(0.22, 0.14, 0.12), Color3.fromRGB(255, 140, 170), 0.1)

	local whisker = shade(body, 0.45)
	for side = -1, 1, 2 do
		wedgeEar(ctx, side, Vector3.new(side * 0.56, 1.28, -0.35), Vector3.new(0.24, 0.72, 0.62), 12, body, Color3.fromRGB(255, 175, 195))
		for _, dy in { 0.07, -0.08 } do
			local a = mp + mn * 0.1 + Vector3.new(side * 0.36, dy, 0)
			rod(ctx, "Whisker", a, a + Vector3.new(side * 0.55, dy * 1.6, 0.08), 0.035, whisker)
		end
		ellipsoid(ctx, "Paw", Vector3.new(0.5, 0.32, 0.6), CFrame.new(side * 0.45, -1.5, -0.45), accent)
	end

	local tailTip = Vector3.new(0.6, 0.05, 1.85)
	limb(ctx, "Tail", Vector3.new(0.3, -0.95, 1.4), tailTip, 0.34, body, GLOSSY)
	ball(ctx, "Mop", 0.78, tailTip + Vector3.new(0.05, 0.2, 0.05), accent)
	ball(ctx, "Mop", 0.55, tailTip + Vector3.new(0.3, 0.02, 0.2), accent)

	face(ctx, headC, headS, {
		EyeX = 0.42,
		EyeY = 0.12,
		Eye = Vector3.new(0.42, 0.56, 0.22),
		CheekX = 0.72,
		CheekY = -0.2,
	})
end

local OCTO_SPOTS = { Vector3.new(0.55, 0.8, 0.3), Vector3.new(-0.6, 0.6, 0.45), Vector3.new(0.1, 0.95, 0.55) }

-- Octo-Scrubber: round mantle with spots, five curly tentacles and one raised, waving a sponge.
BUILDERS.Octopus = function(ctx, body, accent)
	local mantleC, mantleS = Vector3.new(0, 0.35, 0.05), Vector3.new(2.4, 2.3, 2.3)
	ellipsoid(ctx, "Body", mantleS, CFrame.new(mantleC), body, GLOSSY)
	for i = 0, 5 do
		local a = math.rad(30 + i * 60)
		if i == 5 then
			-- 330 degrees = front, +X side: raised high (tilt &gt; 90) holding up a sponge.
			local tip = tentacle(ctx, a, 0.85, -0.3, 1.05, 0.46, 125, body)
			local sponge = CFrame.new(tip + Vector3.new(0.05, 0.2, 0)) * CFrame.Angles(0, -a, math.rad(20))
			addPart(ctx, "Sponge", "Block", Vector3.new(0.62, 0.4, 0.46), sponge, SPONGE_COLOR)
		else
			tentacle(ctx, a, 0.72, -0.45, 0.95, 0.46, 28, body, accent, 0.42)
		end
	end
	for _, dir in OCTO_SPOTS do
		local p, n = surface(mantleC, mantleS, dir)
		decal(ctx, "Spot", p, n, Vector3.new(0.45, 0.45, 0.1), accent, -0.02)
	end
	face(ctx, mantleC, mantleS, {
		EyeX = 0.45,
		EyeY = -0.05,
		Eye = Vector3.new(0.5, 0.62, 0.24),
		CheekX = 0.82,
		CheekY = -0.38,
		MouthY = -0.42,
		Mouth = Vector3.new(0.34, 0.2, 0.1),
	})
end

-- Rainbow Jelly: glass bell around a glowing core, a rainbow frill and four wavy glowing ribbons.
BUILDERS.Jelly = function(ctx, body, accent)
	local bellC, bellS = Vector3.new(0, 0.5, 0), Vector3.new(2.8, 1.9, 2.8)
	ellipsoid(ctx, "Core", Vector3.new(1.7, 1.15, 1.7), CFrame.new(0, 0.55, 0.1), accent, { Material = Enum.Material.Neon, Transparency = 0.25 })
	ellipsoid(ctx, "Body", bellS, CFrame.new(bellC), body, { Material = Enum.Material.Glass, Transparency = 0.3, Reflectance = 0.15, Glossy = true })

	-- Frill: rainbow beads on the bell at ringY, offset 30 degrees so none sits under the mouth.
	local ringY = 0.05
	local ringR = bellS.X * 0.5 * math.sqrt(1 - ((ringY - bellC.Y) / (bellS.Y * 0.5)) ^ 2)
	for i, color in RAINBOW do
		local a = math.rad(-60 + (i - 1) * 60)
		ball(ctx, "Frill", 0.5, Vector3.new(math.cos(a) * ringR, ringY, math.sin(a) * ringR), color, NEON)
	end

	local ribbon: Opts = { Material = Enum.Material.Neon, Transparency = 0.15 }
	for i = 0, 3 do
		local a = math.rad(45 + i * 90)
		local out = Vector3.new(math.cos(a), 0, math.sin(a))
		local across = Vector3.new(-out.Z, 0, out.X) -- tangent to the ring, for the wiggle
		local top = out * 0.55 + Vector3.new(0, -0.2, 0)
		local mid = out * 0.6 + across * 0.22 + Vector3.new(0, -0.85, 0)
		local bottom = out * 0.55 - across * 0.05 + Vector3.new(0, -1.45, 0)
		local color = if i % 2 == 0 then accent else tint(body, 0.25)
		limb(ctx, "Tentacle", top, mid, 0.2, color, ribbon)
		limb(ctx, "Tentacle", mid, bottom, 0.18, color, ribbon)
	end

	local sp, sn = front(bellC, bellS, 0.85, 0.55)
	ellipsoid(ctx, "Shine", Vector3.new(0.3, 0.52, 0.08), facing(sp + sn * 0.01, sn) * CFrame.Angles(0, 0, math.rad(-25)), WHITE, SHINE)
	face(ctx, bellC, bellS, {
		EyeX = 0.45,
		EyeY = 0.18,
		Eye = Vector3.new(0.46, 0.58, 0.22),
		CheekX = 0.85,
		CheekY = -0.15,
		CheekColor = Color3.fromRGB(255, 80, 140),
		MouthY = -0.2,
		Mouth = Vector3.new(0.32, 0.18, 0.1),
	})
end

-- Foam Fox: white chest and muzzle, pointed ears, dark paws, and a huge tail tipped with foam.
BUILDERS.Fox = function(ctx, body, accent)
	ellipsoid(ctx, "Body", Vector3.new(1.8, 1.45, 2.3), CFrame.new(0, -0.8, 0.4), body, GLOSSY)
	ellipsoid(ctx, "Chest", Vector3.new(1.1, 1.0, 0.8), CFrame.new(0, -0.72, -0.55), accent)
	local headC, headS = Vector3.new(0, 0.35, -0.45), Vector3.new(2.0, 1.65, 1.7)
	ellipsoid(ctx, "Head", headS, CFrame.new(headC), body, GLOSSY)
	ellipsoid(ctx, "Muzzle", Vector3.new(1.25, 0.75, 0.9), CFrame.new(0, -0.05, -1.05), accent)
	ellipsoid(ctx, "Nose", Vector3.new(0.3, 0.22, 0.2), CFrame.new(0, 0.12, -1.47), NOSE_COLOR, EYE)

	for side = -1, 1, 2 do
		wedgeEar(ctx, side, Vector3.new(side * 0.55, 1.35, -0.35), Vector3.new(0.24, 0.9, 0.68), 16, body, accent)
		ellipsoid(ctx, "Paw", Vector3.new(0.45, 0.32, 0.55), CFrame.new(side * 0.42, -1.5, -0.35), shade(body, 0.35))
	end

	local tailTip = Vector3.new(0.5, 0.05, 2.05)
	limb(ctx, "Tail", Vector3.new(0.15, -0.95, 1.35), tailTip, 0.85, body, GLOSSY)
	ball(ctx, "Foam", 0.72, tailTip + Vector3.new(0.05, 0.12, 0.1), accent)
	ball(ctx, "Foam", 0.5, tailTip + Vector3.new(0.32, 0.3, 0.05), accent)
	ball(ctx, "Foam", 0.4, tailTip + Vector3.new(-0.2, 0.4, 0.2), accent)

	face(ctx, headC, headS, {
		EyeX = 0.4,
		EyeY = 0.2,
		Eye = Vector3.new(0.4, 0.52, 0.22),
		CheekX = 0.72,
		CheekY = -0.08,
	})
end

local OWL_CHEVRONS = { { X = -0.25, Y = -0.45 }, { X = 0.25, Y = -0.45 }, { X = 0, Y = -0.8 } }

-- Steam Owl: egg-shaped owl with pale face discs, huge eyes, ear tufts, and puffs of steam.
BUILDERS.Owl = function(ctx, body, accent)
	local bodyC, bodyS = Vector3.new(0, -0.25, 0.05), Vector3.new(2.3, 2.5, 2.2)
	local feather = shade(body, 0.12)
	ellipsoid(ctx, "Body", bodyS, CFrame.new(bodyC), body, GLOSSY)

	local bp, bn = front(bodyC, bodyS, 0, -0.55)
	decal(ctx, "Belly", bp, bn, Vector3.new(1.45, 1.45, 0.5), tint(accent, 0.35), -0.14)
	for _, c in OWL_CHEVRONS do
		local p, n = front(bodyC, bodyS, c.X, c.Y)
		decal(ctx, "Chevron", p, n, Vector3.new(0.26, 0.12, 0.08), shade(accent, 0.25), 0.09)
	end

	for side = -1, 1, 2 do
		local p, n = front(bodyC, bodyS, side * 0.44, 0.3)
		decal(ctx, "FaceDisc", p, n, Vector3.new(0.95, 0.95, 0.3), accent, -0.06)
		ellipsoid(ctx, "Tuft", Vector3.new(0.34, 0.7, 0.3), CFrame.new(side * 0.7, 0.98, -0.1) * CFrame.Angles(0, 0, -side * math.rad(28)), feather, GLOSSY)
		ellipsoid(ctx, "Wing", Vector3.new(0.38, 1.5, 1.2), CFrame.new(side * 1.12, -0.35, 0.15) * CFrame.Angles(0, 0, side * math.rad(8)), feather, GLOSSY)
		ellipsoid(ctx, "Foot", Vector3.new(0.5, 0.25, 0.45), CFrame.new(side * 0.42, -1.5, -0.55), BEAK_COLOR)
	end
	face(ctx, bodyC, bodyS, {
		EyeX = 0.44,
		EyeY = 0.3,
		Eye = Vector3.new(0.5, 0.56, 0.24),
		EyeLift = 0.1, -- sit on the face discs, not the body
		CheekX = 0.78,
		CheekY = -0.32,
	})
	local kp, kn = front(bodyC, bodyS, 0, 0.02)
	ellipsoid(ctx, "Beak", Vector3.new(0.3, 0.45, 0.32), facing(kp + kn * 0.08, kn) * CFrame.Angles(math.rad(-15), 0, 0), BEAK_COLOR)

	ball(ctx, "Steam", 0.5, Vector3.new(0.45, 1.3, 0.3), WHITE, { Transparency = 0.3 })
	ball(ctx, "Steam", 0.34, Vector3.new(0.72, 1.66, 0.4), WHITE, { Transparency = 0.45 })
end

type CrystalSpec = { Dir: Vector3, Size: Vector3, Spin: number }
local TURTLE_CRYSTALS: { CrystalSpec } = {
	{ Dir = Vector3.new(0, 1, 0.1), Size = Vector3.new(0.42, 0.95, 0.42), Spin = 45 },
	{ Dir = Vector3.new(0.55, 0.8, 0.35), Size = Vector3.new(0.34, 0.7, 0.34), Spin = 20 },
	{ Dir = Vector3.new(-0.55, 0.8, 0.1), Size = Vector3.new(0.34, 0.75, 0.34), Spin = 65 },
	{ Dir = Vector3.new(-0.1, 0.75, 0.75), Size = Vector3.new(0.28, 0.55, 0.28), Spin = 30 },
}

-- Crystal Turtle: a glassy shell (glass over a solid core) with glowing crystals growing from it.
BUILDERS.Turtle = function(ctx, body, accent)
	local shellC, shellS = Vector3.new(0, 0.2, 0.25), Vector3.new(2.7, 1.7, 2.9)
	ellipsoid(ctx, "ShellCore", shellS - Vector3.new(0.3, 0.26, 0.3), CFrame.new(shellC), shade(body, 0.12))
	ellipsoid(ctx, "Shell", shellS, CFrame.new(shellC), accent:Lerp(body, 0.45), {
		Material = Enum.Material.Glass,
		Transparency = 0.2,
		Reflectance = 0.2,
		Glossy = true,
	})
	ellipsoid(ctx, "Rim", Vector3.new(3.0, 0.32, 3.2), CFrame.new(0, -0.35, 0.25), shade(body, 0.2), GLOSSY)

	local crystalColor = accent:Lerp(body, 0.25)
	for _, c in TURTLE_CRYSTALS do
		local p, n = surface(shellC, shellS, c.Dir)
		-- Grow mostly upward (not straight out of the curve), spun for variety, 80% above the shell.
		local cf = upright(p, n:Lerp(Vector3.yAxis, 0.4)) * CFrame.Angles(0, math.rad(c.Spin), 0) * CFrame.new(0, c.Size.Y * 0.3, 0)
		addPart(ctx, "Crystal", "Block", c.Size, cf, crystalColor, NEON)
	end

	local headC, headS = Vector3.new(0, -0.05, -1.45), Vector3.new(1.25, 1.15, 1.3)
	ellipsoid(ctx, "Head", headS, CFrame.new(headC), body, GLOSSY)
	face(ctx, headC, headS, {
		EyeX = 0.27,
		EyeY = 0.12,
		Eye = Vector3.new(0.3, 0.4, 0.18),
		CheekX = 0.43,
		CheekY = -0.14,
		Cheek = Vector3.new(0.24, 0.15, 0.08),
		MouthY = -0.22,
		Mouth = Vector3.new(0.22, 0.1, 0.08),
	})
	for side = -1, 1, 2 do
		for _, z in { -0.6, 1.1 } do
			ellipsoid(ctx, "Leg", Vector3.new(0.75, 0.5, 0.75), CFrame.new(side * 1.05, -0.75, z), tint(body, 0.08), GLOSSY)
		end
	end
	ellipsoid(ctx, "Tail", Vector3.new(0.3, 0.25, 0.55), CFrame.new(0, -0.45, 1.8), body)
end

-- Tidal Dragon: chibi dragon with horns, translucent fin-wings, back spikes and a finned tail.
BUILDERS.Dragon = function(ctx, body, accent)
	ellipsoid(ctx, "Body", Vector3.new(1.8, 1.6, 2.2), CFrame.new(0, -0.75, 0.35), body, GLOSSY)
	ellipsoid(ctx, "Belly", Vector3.new(1.2, 1.15, 0.55), CFrame.new(0, -0.85, -0.6), accent)
	local headC, headS = Vector3.new(0, 0.4, -0.45), Vector3.new(1.85, 1.6, 1.7)
	ellipsoid(ctx, "Head", headS, CFrame.new(headC), body, GLOSSY)
	ellipsoid(ctx, "Snout", Vector3.new(1.05, 0.65, 0.78), CFrame.new(0, 0.12, -1.27), tint(body, 0.12), GLOSSY)

	for side = -1, 1, 2 do
		-- Horns lean back (X turn) and slightly outward (Z turn).
		local horn = CFrame.new(side * 0.42, 1.25, -0.15) * CFrame.Angles(0, 0, -side * math.rad(15)) * CFrame.Angles(math.rad(30), 0, 0)
		ellipsoid(ctx, "Horn", Vector3.new(0.22, 0.62, 0.22), horn, accent, GLOSSY)
		-- Two-lobed wing: the inner lobe touches the body, the outer one continues from its top.
		local inner = CFrame.new(side * 0.85, 0.15, 0.85) * CFrame.Angles(0, 0, -side * math.rad(40)) * CFrame.Angles(math.rad(-15), 0, 0)
		ellipsoid(ctx, "Wing", Vector3.new(0.12, 0.95, 1.25), inner, accent, FIN)
		local outer = CFrame.new(side * 1.4, 0.6, 1.0) * CFrame.Angles(0, 0, -side * math.rad(55)) * CFrame.Angles(math.rad(-15), 0, 0)
		ellipsoid(ctx, "Wing", Vector3.new(0.1, 0.7, 0.9), outer, accent, FIN)
		ellipsoid(ctx, "Foot", Vector3.new(0.5, 0.35, 0.6), CFrame.new(side * 0.5, -1.5, -0.3), shade(body, 0.1), GLOSSY)
	end

	local t1, t2, t3 = Vector3.new(0, -1.15, 1.3), Vector3.new(0.2, -0.95, 2.0), Vector3.new(0.35, -0.5, 2.45)
	limb(ctx, "Tail", t1, t2, 0.55, body, GLOSSY)
	limb(ctx, "Tail", t2, t3, 0.4, body, GLOSSY)
	ellipsoid(ctx, "TailFin", Vector3.new(0.12, 0.62, 0.55), CFrame.new(t3 + Vector3.new(0.02, 0.28, 0.12)) * CFrame.Angles(math.rad(20), 0, 0), accent, FIN)
	ellipsoid(ctx, "Spike", Vector3.new(0.12, 0.38, 0.4), CFrame.new(0, 0.1, 0.55) * CFrame.Angles(math.rad(25), 0, 0), accent, GLOSSY)
	ellipsoid(ctx, "Spike", Vector3.new(0.12, 0.34, 0.36), CFrame.new(0, -0.06, 1.0) * CFrame.Angles(math.rad(25), 0, 0), accent, GLOSSY)

	face(ctx, headC, headS, {
		EyeX = 0.38,
		EyeY = 0.25,
		Eye = Vector3.new(0.4, 0.52, 0.22),
		CheekX = 0.68,
		CheekY = -0.06,
	})
end

-- Kraken King: a big octopus with six curled tentacles and a tilted gold crown with a gem.
BUILDERS.Kraken = function(ctx, body, accent)
	local mantleC, mantleS = Vector3.new(0, 0.2, 0.05), Vector3.new(2.5, 2.2, 2.4)
	ellipsoid(ctx, "Body", mantleS, CFrame.new(mantleC), body, GLOSSY)
	local curl = tint(body, 0.35)
	for i = 0, 5 do
		tentacle(ctx, math.rad(30 + i * 60), 0.78, -0.55, 1.05, 0.55, 32, body, curl, 0.48)
	end

	local crown = CFrame.new(0.12, 1.3, 0.1) * CFrame.Angles(0, 0, math.rad(-10))
	addPart(ctx, "Crown", "Cylinder", Vector3.new(0.4, 1.25, 1.25), crown * CFrame.Angles(0, 0, math.pi / 2), accent, GOLD)
	for _, deg in { 210, 330, 90 } do
		local r = math.rad(deg)
		ellipsoid(ctx, "CrownPoint", Vector3.new(0.24, 0.5, 0.24), crown * CFrame.new(math.cos(r) * 0.5, 0.35, math.sin(r) * 0.5), accent, GOLD)
	end
	ball(ctx, "Gem", 0.3, (crown * CFrame.new(0, 0, -0.63)).Position, GEM_COLOR, NEON)

	face(ctx, mantleC, mantleS, {
		EyeX = 0.46,
		EyeY = -0.02,
		Eye = Vector3.new(0.52, 0.64, 0.24),
		CheekX = 0.88,
		CheekY = -0.36,
	})
end

-- Unknown ids (or a failed builder): a friendly blob with an antenna, never an error.
local function buildPlaceholder(ctx: Ctx, body: Color3, accent: Color3)
	local c, s = Vector3.new(0, -0.1, 0), Vector3.new(2.4, 2.2, 2.3)
	ellipsoid(ctx, "Body", s, CFrame.new(c), body, GLOSSY)
	ellipsoid(ctx, "Base", Vector3.new(2.7, 0.5, 2.6), CFrame.new(0, -1.05, 0), shade(body, 0.08))
	rod(ctx, "Antenna", Vector3.new(0, 0.9, 0.1), Vector3.new(0.15, 1.45, 0.15), 0.08, shade(body, 0.2))
	ball(ctx, "AntennaTip", 0.36, Vector3.new(0.16, 1.5, 0.15), accent, NEON)
	face(ctx, c, s, {
		EyeX = 0.44,
		EyeY = 0.1,
		Eye = Vector3.new(0.44, 0.56, 0.22),
		CheekX = 0.82,
		CheekY = -0.2,
		MouthY = -0.3,
	})
end

----------------------------------------------------------------------------------------------------
-- Eggs. The shell is the union of a wide lower ellipsoid and a narrower, taller upper one, which
-- reads as a real egg (fat bottom, pointier top). Patterns follow the egg id:
--   Bubble  -&gt; a pale band and bubble dots        Suds -&gt; a zigzag ribbon of diamonds and dots
--   Sparkle -&gt; a glowing gold band, star glints and gold sparkles       unknown -&gt; plain grey egg
----------------------------------------------------------------------------------------------------

local EGG_LOWER_C, EGG_LOWER_S = Vector3.new(0, -0.25, 0), Vector3.new(2.3, 2.5, 2.3)
local EGG_UPPER_C, EGG_UPPER_S = Vector3.new(0, 0.05, 0), Vector3.new(1.95, 2.9, 1.95)
local EGG_PLAIN = Color3.fromRGB(200, 205, 215)

-- Where a ray from inside an ellipsoid leaves it: (distance, outward normal).
local function exitRay(origin: Vector3, dir: Vector3, c: Vector3, s: Vector3): (number, Vector3)
	local h = s * 0.5
	local u = dir.Unit
	local p = (origin - c) / h
	local d = u / h
	local A = d:Dot(d)
	local B = 2 * p:Dot(d)
	local C = p:Dot(p) - 1
	local t = (-B + math.sqrt(math.max(B * B - 4 * A * C, 0))) / (2 * A)
	local q = origin + u * t - c
	return t, Vector3.new(q.X / (h.X * h.X), q.Y / (h.Y * h.Y), q.Z / (h.Z * h.Z)).Unit
end

-- The egg's outer surface along dir from its centre: the farther of the two shells wins.
local function eggSurface(dir: Vector3): (Vector3, Vector3)
	local t1, n1 = exitRay(Vector3.zero, dir, EGG_LOWER_C, EGG_LOWER_S)
	local t2, n2 = exitRay(Vector3.zero, dir, EGG_UPPER_C, EGG_UPPER_S)
	if t1 &gt;= t2 then
		return dir.Unit * t1, n1
	end
	return dir.Unit * t2, n2
end

-- Radius of the lower shell at height y (the bands sit where it is the outer, near-vertical shell).
local function eggRadiusAt(y: number): number
	local h = EGG_LOWER_S * 0.5
	local dy = (y - EGG_LOWER_C.Y) / h.Y
	return h.X * math.sqrt(math.max(1 - dy * dy, 0))
end

local function eggBand(ctx: Ctx, y: number, height: number, color: Color3, opts: Opts?)
	local d = eggRadiusAt(y) * 2 + 0.06
	addPart(ctx, "Band", "Cylinder", Vector3.new(height, d, d), CFrame.new(0, y, 0) * CFrame.Angles(0, 0, math.pi / 2), color, opts)
end

type DotSpec = { Dir: Vector3, D: number }
-- Kept clear of the band (y near -0.1) and of the shine (upper front, +X).
local EGG_DOTS: { DotSpec } = {
	{ Dir = Vector3.new(-0.6, 0.5, -0.65), D = 0.46 },
	{ Dir = Vector3.new(0.15, 0.8, -0.55), D = 0.32 },
	{ Dir = Vector3.new(-0.2, -0.45, -0.85), D = 0.4 },
	{ Dir = Vector3.new(0.75, -0.5, -0.4), D = 0.34 },
	{ Dir = Vector3.new(-0.9, 0.3, 0.3), D = 0.42 },
	{ Dir = Vector3.new(0.85, 0.3, 0.45), D = 0.38 },
	{ Dir = Vector3.new(0.1, 0.4, 0.9), D = 0.44 },
	{ Dir = Vector3.new(-0.4, -0.6, 0.7), D = 0.34 },
}

local function eggDot(ctx: Ctx, name: string, dir: Vector3, size: Vector3, color: Color3, opts: Opts?, spinDeg: number?)
	local p, n = eggSurface(dir)
	local cf = facing(p + n * (-size.Z * 0.15), n) * CFrame.Angles(0, 0, math.rad(spinDeg or 0))
	if name == "Diamond" or name == "Glint" then
		addPart(ctx, name, "Block", size, cf, color, opts)
	else
		ellipsoid(ctx, name, size, cf, color, opts)
	end
end

local function buildEgg(ctx: Ctx, eggId: string, color: Color3)
	ellipsoid(ctx, "Shell", EGG_LOWER_S, CFrame.new(EGG_LOWER_C), color, { Reflectance = 0.05 })
	ellipsoid(ctx, "Shell", EGG_UPPER_S, CFrame.new(EGG_UPPER_C), color, { Reflectance = 0.05 })

	if eggId == "Bubble" then
		eggBand(ctx, -0.1, 0.28, tint(color, 0.6))
		for _, dot in EGG_DOTS do
			eggDot(ctx, "Dot", dot.Dir, Vector3.new(dot.D, dot.D, 0.1), tint(color, 0.75), { Transparency = 0.1 })
		end
	elseif eggId == "Suds" then
		-- Zigzag ribbon: diamonds edge to edge around the egg just above its widest point.
		for i = 0, 11 do
			local a = math.rad(i * 30)
			eggDot(ctx, "Diamond", Vector3.new(math.cos(a), 0.13, math.sin(a)), Vector3.new(0.42, 0.42, 0.08), WHITE, nil, 45)
		end
		for i = 1, #EGG_DOTS, 2 do
			local dot = EGG_DOTS[i]
			eggDot(ctx, "Dot", dot.Dir, Vector3.new(dot.D * 0.7, dot.D * 0.7, 0.1), shade(color, 0.12))
		end
	elseif eggId == "Sparkle" then
		eggBand(ctx, -0.1, 0.3, Color3.fromRGB(255, 200, 60), NEON)
		for i, dot in EGG_DOTS do
			local glint = if i % 2 == 0 then WHITE else Color3.fromRGB(255, 240, 170)
			eggDot(ctx, "Glint", dot.Dir, Vector3.new(0.2, 0.2, 0.06), glint, NEON, 45)
		end
		addSparkles(ctx.Root, "EggSparkle")
	end

	-- Subtle shine: a soft streak and a dot on the upper front, toward the viewer's left (+X).
	eggDot(ctx, "Shine", Vector3.new(0.5, 0.55, -0.75), Vector3.new(0.3, 0.75, 0.1), WHITE, SHINE, -25)
	eggDot(ctx, "Shine", Vector3.new(0.62, 0.22, -0.75), Vector3.new(0.14, 0.14, 0.08), WHITE, SHINE)
end

----------------------------------------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------------------------------------

local templates: { [string]: Model } = {}

-- Runs a builder into a fresh context. A builder that errors is logged once and replaced by the
-- placeholder, so a typo can never break the UI or the renderer.
local function make(name: string, shiny: boolean, build: (Ctx) -&gt; ()): Model
	local ctx = newCtx(name, shiny)
	local ok, err = pcall(build, ctx)
	if not ok then
		warn(string.format("[PetModels] building %s failed: %s", name, tostring(err)))
		ctx.Model:Destroy()
		ctx = newCtx(name, false)
		buildPlaceholder(ctx, PLACEHOLDER_BODY, PLACEHOLDER_ACCENT)
	elseif ctx.Count &gt; PART_BUDGET then
		warn(string.format("[PetModels] %s uses %d parts (budget %d)", name, ctx.Count, PART_BUDGET))
	end
	return ctx.Model
end

local function makePet(petId: string): Model
	local def = Config.Pets[petId]
	if not def then
		local model = make("Pet", false, function(ctx)
			buildPlaceholder(ctx, PLACEHOLDER_BODY, PLACEHOLDER_ACCENT)
		end)
		model:SetAttribute("PetId", "")
		return model
	end

	local colors = def.Colors or {}
	local body: Color3 = colors.Body or PLACEHOLDER_BODY
	local accent: Color3 = colors.Accent or PLACEHOLDER_ACCENT
	local shiny = def.Shiny == true
	local builder = BUILDERS[def.Model]
	local model = make(petId, shiny, function(ctx)
		if builder then
			builder(ctx, body, accent)
		else
			buildPlaceholder(ctx, body, accent)
		end
		if shiny then
			addSparkles(ctx.Root, "ShinySparkle")
		end
	end)
	model:SetAttribute("PetId", petId)
	model:SetAttribute("Rarity", def.Rarity)
	model:SetAttribute("Shiny", shiny)
	return model
end

-- A cute pet model for Config.Pets[petId] (a placeholder for unknown ids). Unparented; the caller
-- parents it and moves it with PivotTo. Facing -Z, PrimaryPart "Root" at the centre.
function PetModels.Build(petId: string): Model
	local key = if type(petId) == "string" and Config.Pets[petId] then petId else PLACEHOLDER_KEY
	local template = templates[key]
	if not template then
		template = makePet(key)
		templates[key] = template
	end
	return template:Clone()
end

-- An egg model for Config.Eggs (by Id) for UI and lobby displays; a plain grey egg for unknown ids.
function PetModels.Egg(eggId: string): Model
	local egg = if type(eggId) == "string" then Config.GetEgg(eggId) else nil
	local key = "\0Egg:" .. (if egg then egg.Id else "?")
	local template = templates[key]
	if not template then
		local id = if egg then egg.Id else ""
		local color = if egg then egg.Color else EGG_PLAIN
		template = make(if egg then egg.Id .. "Egg" else "Egg", false, function(ctx)
			buildEgg(ctx, id, color)
		end)
		template:SetAttribute("EggId", id)
		templates[key] = template
	end
	return template:Clone()
end

-- True when petId has its own builder (false = it would render as the placeholder).
function PetModels.Has(petId: string): boolean
	if type(petId) ~= "string" then
		return false
	end
	local def = Config.Pets[petId]
	return def ~= nil and BUILDERS[def.Model] ~= nil
end

return PetModels</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000007"><Properties><string name="Name">Remotes</string><ProtectedString name="Source">-- Every RemoteEvent / RemoteFunction the game uses, in one place.
-- The server creates them (Remotes.Setup() from Main); clients wait for them.
-- Payload shapes are documented in DESIGN.md ("Remotes").

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Remotes = {}

Remotes.Events = {
	"PartyAction", -- C-&gt;S (action: string, value: any)
	"PartyState", -- S-&gt;C (state: PartyState?)
	"Scrub", -- C-&gt;S (aimPosition: Vector3, holding: boolean)
	"RunState", -- S-&gt;C (state: RunState?)
	"RunFX", -- S-&gt;C (kind: string, data: table)
	"MetaState", -- S-&gt;C (state: MetaState)
	"Notify", -- S-&gt;C (text: string, kind: "Info" | "Good" | "Bad")
}

Remotes.Functions = {
	"RunRequest", -- C-&gt;S (action: string, value: any) -&gt; { Ok: boolean, Error: string? }
	"MetaRequest", -- C-&gt;S (action: string, value: any) -&gt; { Ok: boolean, Error: string?, ... }
	"GetMeta", -- C-&gt;S () -&gt; MetaState?
}

local FOLDER_NAME = "Remotes"

local function getFolder(): Folder
	if RunService:IsServer() then
		local folder = ReplicatedStorage:FindFirstChild(FOLDER_NAME)
		if not folder then
			folder = Instance.new("Folder")
			folder.Name = FOLDER_NAME
			folder.Parent = ReplicatedStorage
		end
		return folder :: Folder
	end
	return ReplicatedStorage:WaitForChild(FOLDER_NAME) :: Folder
end

-- Server only: create every remote up front so clients never wait forever.
function Remotes.Setup()
	assert(RunService:IsServer(), "Remotes.Setup is server-only")
	local folder = getFolder()
	for _, name in Remotes.Events do
		if not folder:FindFirstChild(name) then
			local r = Instance.new("RemoteEvent")
			r.Name = name
			r.Parent = folder
		end
	end
	for _, name in Remotes.Functions do
		if not folder:FindFirstChild(name) then
			local r = Instance.new("RemoteFunction")
			r.Name = name
			r.Parent = folder
		end
	end
end

function Remotes.Event(name: string): RemoteEvent
	assert(table.find(Remotes.Events, name), "Unknown RemoteEvent " .. name)
	local folder = getFolder()
	if RunService:IsServer() then
		local r = folder:FindFirstChild(name)
		assert(r, "Remotes.Setup() has not created " .. name)
		return r :: RemoteEvent
	end
	return folder:WaitForChild(name) :: RemoteEvent
end

function Remotes.Function(name: string): RemoteFunction
	assert(table.find(Remotes.Functions, name), "Unknown RemoteFunction " .. name)
	local folder = getFolder()
	if RunService:IsServer() then
		local r = folder:FindFirstChild(name)
		assert(r, "Remotes.Setup() has not created " .. name)
		return r :: RemoteFunction
	end
	return folder:WaitForChild(name) :: RemoteFunction
end

return Remotes</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000008"><Properties><string name="Name">Types</string><ProtectedString name="Source">-- Shapes of every table that crosses the network. Annotate with these on both sides, e.g.
--   local state: Types.RunState = { ... }            (server, when building a payload)
--   local run = ClientState.Run :: Types.RunState?   (client, when reading one)
-- so the type checker catches a misspelt field on either end.
--
-- Remote rules to remember: tables sent over remotes lose metatables and Instances outside the
-- receiver's view become nil; mixed or sparse numeric keys break. Only use arrays or string keys.

export type PartyMember = {
	UserId: number,
	Name: string,
	DisplayName: string,
}

-- PartyState (S-&gt;C) - nil when the player is not in a party.
export type PartyState = {
	PadId: number,
	HostUserId: number,
	IsHost: boolean,
	Members: { PartyMember }, -- in join order; Members[1] is the longest-waiting member
	MaxPlayers: number, -- 1..4
	Privacy: "Public" | "Friends",
	Level: number, -- index into Config.Levels
	HostUnlocked: number, -- highest level the host may pick
	EndsAt: number, -- workspace:GetServerTimeNow() when the countdown hits 0
	Status: "Waiting" | "Launching",
}

-- Upgrade levels bought inside a run (keys = Config.Upgrades[i].Id).
export type RunUpgrades = {
	Hold: number,
	HandSize: number,
	ScrubPower: number,
	TankSize: number,
	Sneakers: number,
}

-- Output of Config.GetRunStats.
export type RunStats = {
	Radius: number,
	Power: number,
	TankMax: number,
	Reach: number,
	WalkSpeed: number,
	Hold: boolean,
	CoinMult: number,
	ToolIndex: number,
}

export type ResultRow = {
	UserId: number,
	Name: string,
	Grime: number, -- spots this player (and their pets) cleaned
	Share: number, -- 0..1 of all spots in the run
	Bubbles: number, -- Bubbles this player earned
}

export type RunResults = {
	TimeSeconds: number,
	ParTime: number,
	UnderPar: boolean,
	FirstClear: boolean, -- true for the receiving player only if this was their first clear of the level
	NewBest: boolean, -- receiving player's personal best
	UnlockedLevel: number?, -- level index newly unlocked for the receiving player
	Bubbles: number, -- Bubbles the receiving player earned
	Players: { ResultRow },
	ReturnAt: number, -- server time when everyone is sent back to the lobby
}

-- RunState (S-&gt;C) - nil when the player is not in a run.
export type RunState = {
	Level: number,
	ArenaName: string, -- child of workspace.Arenas
	StartedAt: number, -- server time
	Phase: "Playing" | "Complete",
	Coins: number,
	Tank: number,
	TankMax: number,
	ToolIndex: number,
	Upgrades: RunUpgrades,
	Stats: RunStats,
	DrainPosition: Vector3,
	StationPosition: Vector3,
	Total: number, -- grime spots in the run
	Cleaned: number, -- grime spots cleaned so far
	Members: { number }, -- UserIds still in the run
	Results: RunResults?, -- set when Phase == "Complete"
}

export type PetEntry = {
	Uid: string,
	Id: string, -- key into Config.Pets
}

-- MetaState (S-&gt;C) - the player's permanent data.
export type MetaState = {
	Bubbles: number,
	Perks: { [string]: number }, -- Config.Perks[i].Id -&gt; level
	Pets: { PetEntry },
	Equipped: { string }, -- Uids
	PetSlots: number,
	MaxPets: number,
	Unlocked: number, -- highest level index unlocked
	BestTimes: { number }, -- per level index, seconds; 0 = never cleared
	Stats: {
		Runs: number,
		DishesCleaned: number,
		GrimeCleaned: number,
		EggsHatched: number,
		BubblesEarned: number,
	},
	Passes: { [string]: boolean }, -- Config.GamePasses[i].Key -&gt; owned
}

-- Results of RemoteFunction calls.
export type RequestResult = {
	Ok: boolean,
	Error: string?,
	Pets: { PetEntry }?, -- MetaRequest "Hatch"
}

-- RunFX payloads (S-&gt;C), by kind.
export type FXCleaned = {
	Position: Vector3,
	Color: Color3,
	Units: number,
	By: number, -- UserId (0 if unknown)
	Golden: boolean,
	Bubbles: number, -- golden spots only, else 0
	Pet: boolean, -- cleaned by a pet
}

export type FXDishDone = {
	Position: Vector3,
	Kind: string,
	By: number,
	Bonus: number, -- coins paid to By
}

export type FXSold = {
	Coins: number,
	Units: number,
	By: number,
}

return {}</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000009"><Properties><string name="Name">Util</string><ProtectedString name="Source">-- Small helpers shared by server and client.

local Util = {}

----------------------------------------------------------------------------------------------------
-- Signal: a tiny event object (no BindableEvent, so tables pass through untouched).
--   local s = Util.Signal.new(); local c = s:Connect(fn); s:Fire(...); c:Disconnect()
-- Handlers run in their own thread (task.spawn), so a yielding handler never blocks Fire.
----------------------------------------------------------------------------------------------------
export type Connection = { Connected: boolean, Disconnect: (self: Connection) -&gt; () }
export type Signal = {
	Connect: (self: Signal, fn: (...any) -&gt; ()) -&gt; Connection,
	Once: (self: Signal, fn: (...any) -&gt; ()) -&gt; Connection,
	Fire: (self: Signal, ...any) -&gt; (),
	Wait: (self: Signal) -&gt; ...any,
	DisconnectAll: (self: Signal) -&gt; (),
}

local Signal = {}
Signal.__index = Signal

function Signal.new(): Signal
	return (setmetatable({ _handlers = {} }, Signal) :: any) :: Signal
end

function Signal:Connect(fn)
	local handlers = self._handlers
	local connection
	connection = {
		Connected = true,
		Disconnect = function(c)
			if not c.Connected then
				return
			end
			c.Connected = false
			local i = table.find(handlers, connection)
			if i then
				table.remove(handlers, i)
			end
		end,
		_fn = fn,
	}
	table.insert(handlers, connection)
	return connection
end

function Signal:Once(fn)
	local connection
	connection = self:Connect(function(...)
		connection:Disconnect()
		fn(...)
	end)
	return connection
end

function Signal:Fire(...)
	-- Copy first so handlers can disconnect themselves while we iterate.
	for _, c in table.clone(self._handlers) do
		if c.Connected then
			task.spawn(c._fn, ...)
		end
	end
end

function Signal:Wait()
	local thread = coroutine.running()
	self:Once(function(...)
		task.spawn(thread, ...)
	end)
	return coroutine.yield()
end

function Signal:DisconnectAll()
	for _, c in table.clone(self._handlers) do
		c:Disconnect()
	end
end

Util.Signal = Signal

----------------------------------------------------------------------------------------------------
-- Tables and randomness
----------------------------------------------------------------------------------------------------

function Util.DeepCopy&lt;T&gt;(value: T): T
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for k, v in value :: any do
		copy[Util.DeepCopy(k)] = Util.DeepCopy(v)
	end
	return copy :: any
end

-- Fills missing keys in `target` from `template` (recursively). Used to migrate old save data.
function Util.Reconcile(target: { [any]: any }, template: { [any]: any })
	for k, v in template do
		if target[k] == nil then
			target[k] = Util.DeepCopy(v)
		elseif type(v) == "table" and type(target[k]) == "table" then
			Util.Reconcile(target[k], v)
		end
	end
	return target
end

-- Picks one entry from a list of { ..., [weightKey] = number }. rng is an optional Random.
function Util.WeightedPick&lt;T&gt;(entries: { T }, weightKey: string, rng: Random?): T
	local total = 0
	for _, e in entries do
		total += (e :: any)[weightKey]
	end
	local roll = (if rng then rng:NextNumber() else math.random()) * total
	for _, e in entries do
		roll -= (e :: any)[weightKey]
		if roll &lt;= 0 then
			return e
		end
	end
	return entries[#entries]
end

function Util.Shuffle&lt;T&gt;(list: { T }, rng: Random?): { T }
	for i = #list, 2, -1 do
		local j = if rng then rng:NextInteger(1, i) else math.random(1, i)
		list[i], list[j] = list[j], list[i]
	end
	return list
end

-- Server time that is identical on every client (use for countdowns).
function Util.Now(): number
	return workspace:GetServerTimeNow()
end

-- True if the value is a finite Vector3 (no NaN / inf). Use on anything a client sends.
function Util.IsFiniteVector3(v: any): boolean
	if typeof(v) ~= "Vector3" then
		return false
	end
	for _, n in { v.X, v.Y, v.Z } do
		if n ~= n or n == math.huge or n == -math.huge then
			return false
		end
	end
	return true
end

return Util</ProtectedString></Properties></Item>
</Item>
</Item>
<Item class="ServerScriptService" referent="RBX0000000A"><Properties><string name="Name">ServerScriptService</string></Properties>
<Item class="Folder" referent="RBX0000000B"><Properties><string name="Name">Server</string></Properties>
<Item class="Folder" referent="RBX0000000C"><Properties><string name="Name">Services</string></Properties>
<Item class="ModuleScript" referent="RBX0000000D"><Properties><string name="Name">ArenaBuilder</string><ProtectedString name="Source">-- ArenaBuilder: builds one dishwasher ("arena") for a run, entirely out of primitive parts, and
-- lays out the load of dirty dishes inside it. RoundService calls Build(slot, levelIndex, options)
-- once per run and Destroy(arena) when the run ends; nothing else touches workspace.Arenas directly.
--
-- Coordinate convention ("arena space"): every builder helper below works in local offsets
-- (x = sideways, y = up, z = depth) measured from `origin` (the tub floor centre, see SlotOrigin).
-- `origin.LookVector` is defined to point from the door toward the back wall (DESIGN.md section 5),
-- so +z is "into the tub". `worldPoint`/`worldCFrame` convert those offsets to world space.
--
-- Performance: the whole build (static geometry + every dish + every grime spot) yields with
-- task.wait() every ~200 parts, per DESIGN.md section 3, so a big load never hitches the server.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))

local DishFactory = require(script.Parent:WaitForChild("DishFactory"))

local ArenaBuilder = {}

----------------------------------------------------------------------------------------------------
-- Layout numbers (DESIGN.md section 5, ArenaBuilder). Arena-space units unless noted.
----------------------------------------------------------------------------------------------------
local TUB_HALF_X = 60
local TUB_Z_MIN, TUB_Z_MAX = -50, 50
local TUB_HEIGHT = 80

local DOOR_Z_FAR, DOOR_Z_NEAR = -120, -50 -- door spans this Z range, top at Y = 0
local SPAWN_Z = -95

local DRAIN_POS = Vector3.new(0, 0, -38)
local STATION_OFFSET = Vector3.new(14, 0, -38)

local RACK_HALF_X = 56
local RACK_Z_MIN, RACK_Z_MAX = -28, 46
local BOTTOM_RACK_Y = 3
local TOP_RACK_Y = 34

local PLATE_LINE_X = { -48, -32, -16, 0, 16, 32, 48 } -- spacing 16, matches "line spacing &gt;= 16"
local PLATE_SLOT_Z = { -20, -12, -4, 4, 12, 20, 28, 36 } -- spacing 8, matches "plate spacing &gt;= 8"

local PANPOT_X = { -40, -20, 0, 20, 40 }
local PANPOT_Z = 44

local BASKET_POS = Vector3.new(48, 0, -16) -- front-right, per DESIGN.md
local BASKET_HALF = Vector3.new(7, 5, 7)
local BASKET_RIM_Y = 10
local BASKET_DX = { -5, -2.5, 0, 2.5, 5 }
local BASKET_DZ = { -5, -1.7, 1.7, 5 }

local BOWL_X = { -48, -32, -16, 0, 16, 32, 48 }
local BOWL_Z = { -26, -18, -10, -2 }
local CUP_X = { -48, -24, 0, 24, 48 }
local CUP_Z = { 6, 14 }
local GLASS_X = { -48, -24, 0, 24, 48 }
local GLASS_Z = { 22, 30, 38 }

local TRUSS_X = { -TUB_HALF_X + 2, TUB_HALF_X - 2 }
local TRUSS_Z = -30
local LIFT_X = { -50, 50 }
local LIFT_Z = -34

local YIELD_EVERY = 200

----------------------------------------------------------------------------------------------------
-- Small helpers
----------------------------------------------------------------------------------------------------

local function getArenasFolder(): Folder
	local folder = workspace:FindFirstChild("Arenas")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Arenas"
		folder.Parent = workspace
	end
	return folder :: Folder
end

-- Local (x, y, z) -&gt; world position, in the arena's own space (see file header).
local function worldPoint(origin: CFrame, x: number, y: number, z: number): Vector3
	return origin.Position + origin.RightVector * x + Vector3.new(0, y, 0) + origin.LookVector * z
end

-- A footprint CFrame usable as DishFactory.BuildDish's `cf`: Position is the contact point,
-- LookVector is the "face" direction (defaults to the arena's own forward), UpVector is world up.
local function footprint(origin: CFrame, x: number, y: number, z: number, lookDir: Vector3?): CFrame
	local pos = worldPoint(origin, x, y, z)
	local look = (lookDir or origin.LookVector)
	if look.Magnitude &lt; 1e-4 then
		look = origin.LookVector
	end
	return CFrame.lookAt(pos, pos + look, Vector3.new(0, 1, 0))
end

local function newPart(props: { [string]: any }): BasePart
	local p = Instance.new("Part")
	for k, v in props do
		(p :: any)[k] = v
	end
	p.Anchored = true
	return p
end

----------------------------------------------------------------------------------------------------
-- Static geometry builders. Each takes (model, origin, theme) and parents its parts into `model`
-- (which is already live under workspace.Arenas, so raycasts against dishes work once they're
-- parented too). They return how many parts they added, for the yield budget.
----------------------------------------------------------------------------------------------------

local function buildTub(model: Model, origin: CFrame, theme): number
	local depth = TUB_Z_MAX - TUB_Z_MIN
	local floor = newPart({
		Size = Vector3.new(TUB_HALF_X * 2 + 4, 2, depth),
		CFrame = footprint(origin, 0, -1, (TUB_Z_MIN + TUB_Z_MAX) / 2),
		Color = theme.Tub,
		Material = Enum.Material.Metal,
		CanCollide = true,
		CanQuery = false,
		CanTouch = false,
	})
	floor.Parent = model

	local count = 1
	for _, side in { -1, 1 } do
		local wall = newPart({
			Size = Vector3.new(2, TUB_HEIGHT, depth),
			CFrame = footprint(origin, side * (TUB_HALF_X + 1), TUB_HEIGHT / 2, (TUB_Z_MIN + TUB_Z_MAX) / 2),
			Color = theme.Tub,
			Material = Enum.Material.Metal,
			CanCollide = true,
			CanQuery = false,
			CanTouch = false,
		})
		wall.Parent = model
		count += 1
		-- A few horizontal ribs for a stainless-steel look.
		for i = 1, 5 do
			local ry = i * (TUB_HEIGHT / 6)
			local rib = newPart({
				Size = Vector3.new(0.4, 0.6, depth),
				CFrame = footprint(origin, side * (TUB_HALF_X + 2.1), ry, (TUB_Z_MIN + TUB_Z_MAX) / 2),
				Color = theme.Metal,
				Material = Enum.Material.Metal,
				CanCollide = false,
				CanQuery = false,
				CanTouch = false,
			})
			rib.Parent = model
			count += 1
		end
	end

	local back = newPart({
		Size = Vector3.new(TUB_HALF_X * 2 + 4, TUB_HEIGHT, 2),
		CFrame = footprint(origin, 0, TUB_HEIGHT / 2, TUB_Z_MAX + 1),
		Color = theme.Tub,
		Material = Enum.Material.Metal,
		CanCollide = true,
		CanQuery = false,
		CanTouch = false,
	})
	back.Parent = model
	count += 1

	local ceiling = newPart({
		Size = Vector3.new(TUB_HALF_X * 2 + 4, 2, depth + (DOOR_Z_NEAR - DOOR_Z_FAR)),
		CFrame = footprint(origin, 0, TUB_HEIGHT, (TUB_Z_MIN + DOOR_Z_FAR) / 2),
		Color = theme.Tub,
		Material = Enum.Material.Metal,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		Transparency = 0.15,
	})
	ceiling.Parent = model
	count += 1

	-- Interior mood lighting.
	for _, z in { -10, 30 } do
		local fixture = newPart({
			Size = Vector3.new(6, 1, 2),
			CFrame = footprint(origin, 0, TUB_HEIGHT - 3, z),
			Color = theme.Light,
			Material = Enum.Material.Neon,
			CanCollide = false,
			CanQuery = false,
			CanTouch = false,
		})
		local light = Instance.new("PointLight")
		light.Color = theme.Light
		light.Brightness = 2
		light.Range = 45
		light.Parent = fixture
		fixture.Parent = model
		count += 1
	end

	-- A little floating-bubble mood ambience.
	local bubbleAnchor = newPart({
		Size = Vector3.new(1, 1, 1),
		CFrame = footprint(origin, 0, TUB_HEIGHT / 2, 10),
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
	})
	local attach = Instance.new("Attachment")
	attach.Parent = bubbleAnchor
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = "rbxasset://textures/particles/forcefield_glow_main.dds"
	emitter.Color = ColorSequence.new(theme.Accent)
	emitter.Lifetime = NumberRange.new(4, 7)
	emitter.Speed = NumberRange.new(2, 4)
	emitter.Rate = 1.5
	emitter.Size = NumberSequence.new(0.6, 0.1)
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.6),
		NumberSequenceKeypoint.new(1, 1),
	})
	emitter.SpreadAngle = Vector2.new(40, 40)
	emitter.Parent = attach
	bubbleAnchor.Parent = model
	count += 1

	return count
end

local function buildDoorAndBackdrop(model: Model, origin: CFrame, theme): number
	local count = 0
	local doorLen = DOOR_Z_NEAR - DOOR_Z_FAR
	local doorFloor = newPart({
		Size = Vector3.new(TUB_HALF_X * 2, 2, doorLen),
		CFrame = footprint(origin, 0, -1, (DOOR_Z_FAR + DOOR_Z_NEAR) / 2),
		Color = theme.Rack,
		Material = Enum.Material.Metal,
		CanCollide = true,
		CanQuery = false,
		CanTouch = false,
	})
	doorFloor.Parent = model
	count += 1

	-- Inner panel details: a detergent cup, the rim, and a hinge line at the tub edge.
	local cup = newPart({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(1.5, 5, 5),
		CFrame = footprint(origin, -20, 0.8, DOOR_Z_NEAR - 12) * CFrame.Angles(0, 0, math.rad(90)),
		Color = theme.Accent,
		Material = Enum.Material.Plastic,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
	})
	cup.Parent = model
	count += 1

	local rim = newPart({
		Size = Vector3.new(TUB_HALF_X * 2, 0.4, 1.2),
		CFrame = footprint(origin, 0, 0.2, DOOR_Z_NEAR),
		Color = theme.Metal,
		Material = Enum.Material.Metal,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
	})
	rim.Parent = model
	count += 1

	for _, x in { -TUB_HALF_X + 6, TUB_HALF_X - 6 } do
		local hinge = newPart({
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(4, 1, 1),
			CFrame = footprint(origin, x, 0.5, DOOR_Z_NEAR) * CFrame.Angles(0, math.rad(90), 0),
			Color = theme.Metal,
			Material = Enum.Material.Metal,
			CanCollide = false,
			CanQuery = false,
			CanTouch = false,
		})
		hinge.Parent = model
		count += 1
	end

	-- A low lip at the far end plus invisible safety walls down both sides of the door.
	local lip = newPart({
		Size = Vector3.new(TUB_HALF_X * 2, 3, 2),
		CFrame = footprint(origin, 0, 1.5, DOOR_Z_FAR),
		Color = theme.Rack,
		Material = Enum.Material.Metal,
		CanCollide = true,
		CanQuery = false,
		CanTouch = false,
	})
	lip.Parent = model
	count += 1

	for _, side in { -1, 1 } do
		local wall = newPart({
			Size = Vector3.new(1, 10, doorLen),
			CFrame = footprint(origin, side * TUB_HALF_X, 5, (DOOR_Z_FAR + DOOR_Z_NEAR) / 2),
			Transparency = 1,
			CanCollide = true,
			CanQuery = false,
			CanTouch = false,
		})
		wall.Parent = model
		count += 1
	end

	-- Giant-kitchen backdrop beyond the door, so there's no void: a tiled floor far below,
	-- cabinet-front wall, and a bright window. Pure decoration, kept far from any collidable area.
	local farZ = DOOR_Z_FAR - 45
	local tiles = newPart({
		Size = Vector3.new(400, 2, 300),
		CFrame = footprint(origin, 0, -140, farZ - 80),
		Color = Color3.fromRGB(225, 225, 230),
		Material = Enum.Material.Concrete,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
	})
	tiles.Parent = model
	count += 1

	local cabinets = newPart({
		Size = Vector3.new(400, 260, 6),
		CFrame = footprint(origin, 0, -10, farZ - 20),
		Color = Color3.fromRGB(120, 82, 55),
		Material = Enum.Material.Wood,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
	})
	cabinets.Parent = model
	count += 1

	for i = -3, 3 do
		local seam = newPart({
			Size = Vector3.new(0.6, 260, 6.2),
			CFrame = footprint(origin, i * 55, -10, farZ - 20),
			Color = Color3.fromRGB(90, 60, 40),
			Material = Enum.Material.Wood,
			CanCollide = false,
			CanQuery = false,
			CanTouch = false,
		})
		seam.Parent = model
		count += 1
	end

	local window = newPart({
		Size = Vector3.new(90, 60, 2),
		CFrame = footprint(origin, 120, 80, farZ - 17),
		Color = Color3.fromRGB(255, 250, 210),
		Material = Enum.Material.Neon,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
	})
	local windowLight = Instance.new("SurfaceLight")
	windowLight.Face = Enum.NormalId.Front
	windowLight.Color = Color3.fromRGB(255, 250, 220)
	windowLight.Brightness = 3
	windowLight.Range = 200
	windowLight.Parent = window
	window.Parent = model
	count += 1

	return count
end

local function buildDrainAndStation(model: Model, origin: CFrame, theme): (number, Vector3, Vector3)
	local count = 0
	local radius = Config.Round.DrainRadius

	local grate = newPart({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.6, radius * 2, radius * 2),
		CFrame = footprint(origin, DRAIN_POS.X, 0.3, DRAIN_POS.Z) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(70, 75, 80),
		Material = Enum.Material.DiamondPlate,
		CanCollide = true,
		CanQuery = false,
		CanTouch = false,
	})
	grate.Parent = model
	count += 1

	local ring = newPart({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.2, radius * 1.6, radius * 1.6),
		CFrame = footprint(origin, DRAIN_POS.X, 0.65, DRAIN_POS.Z) * CFrame.Angles(0, 0, math.rad(90)),
		Color = theme.Accent,
		Material = Enum.Material.ForceField,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
	})
	ring.Parent = model
	ring:SetAttribute("SpinSpeed", 2.4)
	CollectionService:AddTag(ring, "SpinY")
	count += 1

	local signPost = newPart({
		Size = Vector3.new(0.6, 6, 0.6),
		CFrame = footprint(origin, DRAIN_POS.X, 3, DRAIN_POS.Z - radius - 1),
		Color = theme.Metal,
		Material = Enum.Material.Metal,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
	})
	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromOffset(220, 44)
	billboard.StudsOffset = Vector3.new(0, 3.4, 0)
	billboard.AlwaysOnTop = true
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.FredokaOne
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0
	label.TextScaled = true
	label.Text = "🌀 DRAIN — stand here to sell"
	label.Parent = billboard
	billboard.Parent = signPost
	signPost.Parent = model
	count += 1

	local stationPos = DRAIN_POS + STATION_OFFSET
	local kioskBase = newPart({
		Size = Vector3.new(4, 4, 4),
		CFrame = footprint(origin, stationPos.X, 2, stationPos.Z),
		Color = theme.Rack,
		Material = Enum.Material.SmoothPlastic,
		CanCollide = true,
		CanQuery = false,
		CanTouch = false,
	})
	local kioskTop = newPart({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.6, 3.2, 3.2),
		CFrame = footprint(origin, stationPos.X, 4.3, stationPos.Z) * CFrame.Angles(0, 0, math.rad(90)),
		Color = theme.Accent,
		Material = Enum.Material.Neon,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
	})
	kioskTop.Parent = model
	count += 1

	local prompt = Instance.new("ProximityPrompt")
	prompt.ObjectText = "Upgrade Station"
	prompt.ActionText = "Open"
	prompt.RequiresLineOfSight = false
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 12
	prompt:SetAttribute("OpenWindow", "Upgrades")
	prompt.Parent = kioskBase
	kioskBase.Parent = model
	count += 1

	return count, worldPoint(origin, DRAIN_POS.X, 0, DRAIN_POS.Z), worldPoint(origin, stationPos.X, 0, stationPos.Z)
end

-- A walkable rack floor (invisible collidable plate + a visible thin wire grid) at height `y`.
local function buildRackFloor(model: Model, origin: CFrame, theme, y: number): number
	local width = RACK_HALF_X * 2
	local depth = RACK_Z_MAX - RACK_Z_MIN
	local plate = newPart({
		Size = Vector3.new(width, 1, depth),
		CFrame = footprint(origin, 0, y - 0.5, (RACK_Z_MIN + RACK_Z_MAX) / 2),
		Transparency = 1,
		CanCollide = true,
		CanQuery = false,
		CanTouch = false,
	})
	plate.Parent = model
	local count = 1

	for _, x in { -48, -32, -16, 0, 16, 32, 48 } do
		local bar = newPart({
			Size = Vector3.new(0.3, 0.3, depth),
			CFrame = footprint(origin, x, y, (RACK_Z_MIN + RACK_Z_MAX) / 2),
			Color = theme.Rack,
			Material = Enum.Material.Metal,
			CanCollide = false,
			CanQuery = false,
			CanTouch = false,
		})
		bar.Parent = model
		count += 1
	end
	for i = 0, 6 do
		local z = RACK_Z_MIN + (depth / 6) * i
		local bar = newPart({
			Size = Vector3.new(width, 0.3, 0.3),
			CFrame = footprint(origin, 0, y, z),
			Color = theme.Rack,
			Material = Enum.Material.Metal,
			CanCollide = false,
			CanQuery = false,
			CanTouch = false,
		})
		bar.Parent = model
		count += 1
	end

	return count
end

local function buildRamp(model: Model, origin: CFrame, theme): number
	local ramp = newPart({
		Size = Vector3.new(RACK_HALF_X * 2, 1, 8),
		CFrame = footprint(origin, 0, BOTTOM_RACK_Y / 2 - 0.3, RACK_Z_MIN - 3) * CFrame.Angles(math.rad(-19), 0, 0),
		Color = theme.Rack,
		Material = Enum.Material.Metal,
		CanCollide = true,
		CanQuery = false,
		CanTouch = false,
	})
	ramp.Parent = model
	return 1
end

local function buildCutleryBasket(model: Model, origin: CFrame, theme): number
	local count = 0
	local wallColor = theme.Metal
	local base = newPart({
		Size = Vector3.new(BASKET_HALF.X * 2, 1, BASKET_HALF.Z * 2),
		CFrame = footprint(origin, BASKET_POS.X, BOTTOM_RACK_Y + 0.5, BASKET_POS.Z),
		Color = wallColor,
		Material = Enum.Material.Metal,
		CanCollide = true,
		CanQuery = false,
		CanTouch = false,
	})
	base.Parent = model
	count += 1

	local wallY = BASKET_RIM_Y - BOTTOM_RACK_Y
	for _, offset in {
		{ dx = -BASKET_HALF.X, dz = 0, size = Vector3.new(0.4, wallY, BASKET_HALF.Z * 2) },
		{ dx = BASKET_HALF.X, dz = 0, size = Vector3.new(0.4, wallY, BASKET_HALF.Z * 2) },
		{ dx = 0, dz = -BASKET_HALF.Z, size = Vector3.new(BASKET_HALF.X * 2, wallY, 0.4) },
		{ dx = 0, dz = BASKET_HALF.Z, size = Vector3.new(BASKET_HALF.X * 2, wallY, 0.4) },
	} do
		local wall = newPart({
			Size = offset.size,
			CFrame = footprint(origin, BASKET_POS.X + offset.dx, BOTTOM_RACK_Y + wallY / 2, BASKET_POS.Z + offset.dz),
			Color = wallColor,
			Material = Enum.Material.DiamondPlate,
			Transparency = 0.35,
			CanCollide = true,
			CanQuery = false,
			CanTouch = false,
		})
		wall.Parent = model
		count += 1
	end

	return count
end

local function buildTrussAndLifts(model: Model, origin: CFrame, theme): number
	local count = 0
	for _, x in TRUSS_X do
		local segments = 3
		local segHeight = TOP_RACK_Y / segments
		for i = 1, segments do
			local truss = Instance.new("TrussPart")
			truss.Size = Vector3.new(2, segHeight, 2)
			truss.CFrame = footprint(origin, x, segHeight * (i - 0.5), TRUSS_Z)
			truss.Anchored = true
			truss.Color = theme.Metal
			truss.Material = Enum.Material.Metal
			truss.Parent = model
			count += 1
		end
	end

	for _, x in LIFT_X do
		local lift = newPart({
			Size = Vector3.new(6, TOP_RACK_Y + 2, 6),
			CFrame = footprint(origin, x, (TOP_RACK_Y + 2) / 2, LIFT_Z),
			Color = theme.Accent,
			Material = Enum.Material.ForceField,
			Transparency = 0.75,
			CanCollide = false,
			CanQuery = false,
			CanTouch = false,
		})
		lift:SetAttribute("LiftSpeed", 45)
		CollectionService:AddTag(lift, "BubbleLift")

		local attach = Instance.new("Attachment")
		attach.Position = Vector3.new(0, -(TOP_RACK_Y + 2) / 2 + 1, 0)
		attach.Parent = lift
		local emitter = Instance.new("ParticleEmitter")
		emitter.Texture = "rbxasset://textures/particles/forcefield_glow_main.dds"
		emitter.Color = ColorSequence.new(Color3.new(1, 1, 1))
		emitter.Lifetime = NumberRange.new(1.4, 2.2)
		emitter.Speed = NumberRange.new(6, 10)
		emitter.Rate = 8
		emitter.Size = NumberSequence.new(0.9, 0.2)
		emitter.SpreadAngle = Vector2.new(8, 8)
		emitter.Parent = attach

		lift.Parent = model
		count += 1
	end

	return count
end

local function buildSprayArms(model: Model, origin: CFrame, theme): number
	local count = 0
	for _, y in { 1.5, 31 } do
		local speed = 0.8 + (y &gt; 20 and 0.3 or 0)
		for _, axis in { "X", "Z" } do
			local size = if axis == "X" then Vector3.new(RACK_HALF_X * 2 - 4, 0.8, 0.8) else Vector3.new(0.8, 0.8, RACK_Z_MAX - RACK_Z_MIN - 4)
			local arm = newPart({
				Size = size,
				CFrame = footprint(origin, 0, y, (RACK_Z_MIN + RACK_Z_MAX) / 2),
				Color = theme.Metal,
				Material = Enum.Material.Metal,
				CanCollide = false,
				CanQuery = false,
				CanTouch = false,
			})
			arm:SetAttribute("SpinSpeed", speed)
			CollectionService:AddTag(arm, "SpinY")
			arm.Parent = model
			count += 1

			-- Nozzle holes along the arm.
			local length = if axis == "X" then size.X else size.Z
			for i = 1, 5 do
				local t = (i - 3) * (length / 6)
				local nozzlePos = if axis == "X" then footprint(origin, t, y + 0.5, (RACK_Z_MIN + RACK_Z_MAX) / 2) else footprint(origin, 0, y + 0.5, (RACK_Z_MIN + RACK_Z_MAX) / 2 + t)
				local nozzle = newPart({
					Shape = Enum.PartType.Cylinder,
					Size = Vector3.new(0.5, 0.3, 0.3),
					CFrame = nozzlePos * CFrame.Angles(0, 0, math.rad(90)),
					Color = theme.Metal,
					Material = Enum.Material.Metal,
					CanCollide = false,
					CanQuery = false,
					CanTouch = false,
				})
				nozzle.Parent = model
				count += 1
			end
		end
	end
	return count
end

----------------------------------------------------------------------------------------------------
-- Dish layout: turns level.Dishes / level.Spots into placed dishes + grime.
----------------------------------------------------------------------------------------------------

type PlacedDish = {
	Id: number,
	Kind: string,
	Model: Model,
	Grime: { BasePart },
	Center: Vector3,
}

-- Builds a flat list of footprint specs { x, y, z, look } for a kind, capped to however many fit.
local function plateSlots(): { { x: number, y: number, z: number, look: string } }
	local slots = {}
	for li, x in PLATE_LINE_X do
		local look = if li % 2 == 0 then "forward" else "backward"
		for _, z in PLATE_SLOT_Z do
			table.insert(slots, { x = x, y = BOTTOM_RACK_Y, z = z, look = look })
		end
	end
	return slots
end

local function gridSlots(xs: { number }, zs: { number }, y: number): { { x: number, y: number, z: number } }
	local slots = {}
	for _, x in xs do
		for _, z in zs do
			table.insert(slots, { x = x, y = y, z = z })
		end
	end
	return slots
end

local function panPotSlots(): { { x: number, y: number, z: number } }
	local slots = {}
	for _, x in PANPOT_X do
		table.insert(slots, { x = x, y = BOTTOM_RACK_Y, z = PANPOT_Z })
	end
	return slots
end

local function basketSlots(): { { x: number, y: number, z: number } }
	local slots = {}
	for _, dx in BASKET_DX do
		for _, dz in BASKET_DZ do
			table.insert(slots, { x = BASKET_POS.X + dx, y = BOTTOM_RACK_Y, z = BASKET_POS.Z + dz })
		end
	end
	return slots
end

local KIND_SLOTS = {
	Plate = plateSlots,
	Bowl = function()
		return gridSlots(BOWL_X, BOWL_Z, TOP_RACK_Y)
	end,
	Cup = function()
		return gridSlots(CUP_X, CUP_Z, TOP_RACK_Y)
	end,
	Glass = function()
		return gridSlots(GLASS_X, GLASS_Z, TOP_RACK_Y)
	end,
	Pan = panPotSlots,
	Pot = panPotSlots,
	Fork = basketSlots,
	Knife = basketSlots,
	Spoon = basketSlots,
}

-- Builds every dish of one kind, applies grime, and appends to `dishes`/yield bookkeeping.
local function buildKind(
	model: Model,
	origin: CFrame,
	theme,
	kind: string,
	wantCount: number,
	spotsPerDish: number,
	levelIndex: number,
	rng: Random,
	grimeFolder: Folder,
	dishes: { [number]: PlacedDish },
	nextId: () -&gt; number,
	yieldTick: (number) -&gt; ()
): number
	if wantCount &lt;= 0 then
		return 0
	end
	local slotsFn = KIND_SLOTS[kind]
	if not slotsFn then
		warn("[ArenaBuilder] No layout for dish kind " .. tostring(kind))
		return 0
	end
	local slots = slotsFn()
	-- Shared slot pools (Pan/Pot share panPotSlots, Fork/Knife/Spoon share basketSlots): offset by
	-- kind so different kinds sharing a pool don't stack on the same spots.
	local shift = 0
	if kind == "Pot" then
		shift = 2 -- Pan takes the first slots, Pot continues after (both counts are small)
	elseif kind == "Knife" then
		shift = 6
	elseif kind == "Spoon" then
		shift = 12
	end

	local placed = 0
	local totalGrime = 0
	for i = 1, wantCount do
		local slot = slots[i + shift]
		if not slot then
			warn(string.format("[ArenaBuilder] Only %d/%d slots available for %s; skipping the rest", math.max(0, #slots - shift), wantCount, kind))
			break
		end
		local lookDir = nil
		if slot.look == "backward" then
			lookDir = -origin.LookVector
		elseif slot.look == "forward" then
			lookDir = origin.LookVector
		end
		local cf = footprint(origin, slot.x, slot.y, slot.z, lookDir)
		local dish = DishFactory.BuildDish(kind, cf, theme, rng)
		dish.Parent = model -- must be live under workspace before ApplyGrime raycasts against it

		local id = nextId()
		local grime = DishFactory.ApplyGrime(dish, id, spotsPerDish, levelIndex, rng, 0, grimeFolder)
		-- Golden chance is applied per-arena by the caller via `spotsPerDish`'s sibling call below;
		-- see Build(), which passes the real GoldenChance through a closure-captured value instead.
		dishes[id] = {
			Id = id,
			Kind = kind,
			Model = dish,
			Grime = grime,
			Center = dish:GetPivot().Position,
		}
		placed += 1
		totalGrime += #grime
		yieldTick(1 + #dish:GetChildren() + #grime)
	end
	return totalGrime
end

----------------------------------------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------------------------------------

function ArenaBuilder.Init()
	getArenasFolder()
end

function ArenaBuilder.SlotOrigin(slot: number): CFrame
	local w = Config.World
	local pos = w.ArenaRowStart + w.ArenaSpacing * (slot - 1)
	return CFrame.new(pos)
end

function ArenaBuilder.Build(slot: number, levelIndex: number, options: { GrimeScale: number, GoldenChance: number }): any
	assert(type(slot) == "number", "ArenaBuilder.Build: slot must be a number")
	local level = Config.GetLevel(levelIndex)
	local theme = level.Theme
	local origin = ArenaBuilder.SlotOrigin(slot)
	local rng = Random.new()
	local grimeScale = (options and options.GrimeScale) or 1
	local goldenChance = (options and options.GoldenChance) or level.GoldenChance

	local arenasFolder = getArenasFolder()
	local name = "Arena_" .. slot
	local existing = arenasFolder:FindFirstChild(name)
	if existing then
		existing:Destroy()
	end

	local model = Instance.new("Model")
	model.Name = name
	model.Parent = arenasFolder -- live in workspace now, so dish raycasts work as we build

	local grimeFolder = Instance.new("Folder")
	grimeFolder.Name = "Grime"
	grimeFolder.Parent = model

	local pending = 0
	local function yieldTick(n: number)
		pending += n
		if pending &gt;= YIELD_EVERY then
			pending = 0
			task.wait()
		end
	end

	yieldTick(buildTub(model, origin, theme))
	yieldTick(buildDoorAndBackdrop(model, origin, theme))
	local drainCount, drainPos, stationPos = buildDrainAndStation(model, origin, theme)
	yieldTick(drainCount)
	yieldTick(buildRackFloor(model, origin, theme, BOTTOM_RACK_Y))
	yieldTick(buildRackFloor(model, origin, theme, TOP_RACK_Y))
	yieldTick(buildRamp(model, origin, theme))
	yieldTick(buildCutleryBasket(model, origin, theme))
	yieldTick(buildTrussAndLifts(model, origin, theme))
	yieldTick(buildSprayArms(model, origin, theme))

	local dishes: { [number]: PlacedDish } = {}
	local dishIdCounter = 0
	local function nextId(): number
		dishIdCounter += 1
		return dishIdCounter
	end

	-- ApplyGrime takes a single goldenChance; wrap it so buildKind's call site stays simple while
	-- still using the real per-run chance computed above.
	local totalGrime = 0
	for _, kind in Config.DishKinds do
		local wantCount = level.Dishes[kind] or 0
		if wantCount &gt; 0 then
			local spotsPerDish = math.max(1, math.floor((level.Spots[kind] or 1) * grimeScale + 0.5))
			local slotsFn = KIND_SLOTS[kind]
			if slotsFn then
				local shift = 0
				if kind == "Pot" then
					shift = 2
				elseif kind == "Knife" then
					shift = 6
				elseif kind == "Spoon" then
					shift = 12
				end
				local slots = slotsFn()
				for i = 1, wantCount do
					local slotSpec = slots[i + shift]
					if not slotSpec then
						warn(string.format("[ArenaBuilder] Only %d slots available for %s; filling what fits", math.max(0, #slots - shift), kind))
						break
					end
					local lookDir = nil
					if slotSpec.look == "backward" then
						lookDir = -origin.LookVector
					elseif slotSpec.look == "forward" then
						lookDir = origin.LookVector
					end
					local cf = footprint(origin, slotSpec.x, slotSpec.y, slotSpec.z, lookDir)
					local dish = DishFactory.BuildDish(kind, cf, theme, rng)
					dish.Parent = model

					local id = nextId()
					local grime = DishFactory.ApplyGrime(dish, id, spotsPerDish, levelIndex, rng, goldenChance, grimeFolder)
					dishes[id] = {
						Id = id,
						Kind = kind,
						Model = dish,
						Grime = grime,
						Center = dish:GetPivot().Position,
					}
					totalGrime += #grime
					yieldTick(1 + #dish:GetChildren() + #grime)
				end
			end
		end
	end

	model:SetAttribute("Level", levelIndex)
	model:SetAttribute("Total", totalGrime)
	model:SetAttribute("Cleaned", 0)

	local spawns: { CFrame } = {}
	for _, x in { -9, -3, 3, 9 } do
		table.insert(spawns, footprint(origin, x, 0.5, SPAWN_Z))
	end

	local arena = {
		Slot = slot,
		Name = name,
		Model = model,
		Origin = origin,
		Spawns = spawns,
		DrainPosition = drainPos,
		DrainRadius = Config.Round.DrainRadius,
		StationPosition = stationPos,
		GrimeFolder = grimeFolder,
		Dishes = dishes,
		TotalGrime = totalGrime,
		KillY = origin.Position.Y - 60,
	}
	return arena
end

function ArenaBuilder.Destroy(arena: any)
	if not arena then
		return
	end
	if typeof(arena.Model) == "Instance" and arena.Model.Parent then
		arena.Model:Destroy()
	end
end

return ArenaBuilder</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000000E"><Properties><string name="Name">Characters</string><ProtectedString name="Source">-- Character helpers shared by every server service: collision groups, teleporting,
-- walk speed that survives respawns, and "where should this player respawn".

local Players = game:GetService("Players")
local PhysicsService = game:GetService("PhysicsService")

local Characters = {}

Characters.Groups = {
	Players = "Players", -- every character by default (players never collide with each other)
	PartyMember = "PartyMember", -- characters waiting inside a party pad (the pad's walls block them)
	PadBarrier = "PadBarrier", -- pad walls: only block PartyMember
	NoCollide = "NoCollide", -- decoration / grime / effects: collide with nothing
}

local groupOf: { [Player]: string } = {}
local walkSpeedOf: { [Player]: number? } = {}
local respawnResolvers: { (Player) -&gt; CFrame? } = {}

local function registerGroup(name: string)
	local ok = pcall(function()
		if not workspace:IsCollisionGroupRegistered(name) then
			workspace:RegisterCollisionGroup(name)
		end
	end)
	if not ok then
		-- Older engines: collision groups still live on PhysicsService.
		pcall(function()
			if not PhysicsService:IsCollisionGroupRegistered(name) then
				PhysicsService:RegisterCollisionGroup(name)
			end
		end)
	end
end

local function setCollidable(a: string, b: string, collidable: boolean)
	local ok = pcall(function()
		workspace:CollisionGroupSetCollidable(a, b, collidable)
	end)
	if not ok then
		pcall(function()
			PhysicsService:CollisionGroupSetCollidable(a, b, collidable)
		end)
	end
end

local function applyGroup(character: Model, group: string)
	for _, d in character:GetDescendants() do
		if d:IsA("BasePart") then
			d.CollisionGroup = group
		end
	end
end

local function onCharacterAdded(player: Player, character: Model)
	applyGroup(character, groupOf[player] or Characters.Groups.Players)
	-- Accessories and tools arrive after CharacterAdded; keep them in the same group.
	character.DescendantAdded:Connect(function(d)
		if d:IsA("BasePart") then
			d.CollisionGroup = groupOf[player] or Characters.Groups.Players
		end
	end)

	local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
	local speed = walkSpeedOf[player]
	if humanoid and speed then
		humanoid.WalkSpeed = speed
	end

	-- Let services decide where this player should be (party pad, dishwasher, lobby).
	task.defer(function()
		for _, resolve in respawnResolvers do
			local ok, cf = pcall(resolve, player)
			if ok and cf then
				Characters.Teleport(player, cf)
				break
			end
		end
	end)
end

-- Call once from Main before anything else touches characters.
function Characters.Setup()
	for _, name in Characters.Groups :: { [string]: string } do
		registerGroup(name)
	end
	local g = Characters.Groups
	setCollidable(g.Players, g.Players, false)
	setCollidable(g.Players, g.PartyMember, false)
	setCollidable(g.PartyMember, g.PartyMember, false)
	setCollidable(g.PadBarrier, "Default", false)
	setCollidable(g.PadBarrier, g.Players, false)
	setCollidable(g.PadBarrier, g.PartyMember, true)
	setCollidable(g.PadBarrier, g.NoCollide, false)
	for _, other in { "Default", g.Players, g.PartyMember, g.NoCollide } do
		setCollidable(g.NoCollide, other, false)
	end

	local function hook(player: Player)
		player.CharacterAdded:Connect(function(character)
			onCharacterAdded(player, character)
		end)
		if player.Character then
			onCharacterAdded(player, player.Character)
		end
	end
	Players.PlayerAdded:Connect(hook)
	for _, p in Players:GetPlayers() do
		hook(p)
	end
	Players.PlayerRemoving:Connect(function(p)
		groupOf[p] = nil
		walkSpeedOf[p] = nil
	end)
end

-- Put a player's character (now and after every respawn) into a collision group.
function Characters.SetGroup(player: Player, group: string)
	groupOf[player] = group
	if player.Character then
		applyGroup(player.Character, group)
	end
end

function Characters.GetRoot(player: Player): BasePart?
	local character = player.Character
	if not character then
		return nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health &lt;= 0 then
		return nil
	end
	return character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

function Characters.IsAlive(player: Player): boolean
	return Characters.GetRoot(player) ~= nil
end

-- Moves a character to stand at `cframe` (feet roughly at cframe.Position). Returns false if the
-- player has no living character. Velocity is cleared so nobody keeps flying after a teleport.
function Characters.Teleport(player: Player, cframe: CFrame): boolean
	local character = player.Character
	local root = Characters.GetRoot(player)
	if not character or not root then
		return false
	end
	if workspace.StreamingEnabled then
		pcall(function()
			player:RequestStreamAroundAsync(cframe.Position, 2)
		end)
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local lift = (humanoid and humanoid.HipHeight or 2) + root.Size.Y / 2 + 0.5
	character:PivotTo(cframe + Vector3.new(0, lift, 0))
	for _, d in character:GetDescendants() do
		if d:IsA("BasePart") then
			d.AssemblyLinearVelocity = Vector3.zero
			d.AssemblyAngularVelocity = Vector3.zero
		end
	end
	return true
end

-- Walk speed that is re-applied after every respawn. nil resets to the default 16.
function Characters.SetWalkSpeed(player: Player, speed: number?)
	walkSpeedOf[player] = speed
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.WalkSpeed = speed or 16
	end
end

--[[
	Register a function that says where a player should appear after (re)spawning.
	It returns a CFrame to teleport them there, or nil to let the next resolver (or the
	normal SpawnLocation) decide. Resolvers are asked in the order they were added.
]]
function Characters.AddRespawnResolver(resolver: (Player) -&gt; CFrame?)
	table.insert(respawnResolvers, resolver)
end

return Characters</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000000F"><Properties><string name="Name">DataService</string><ProtectedString name="Source">-- DataService: every player's permanent profile (Bubbles, perks, pets, unlocks, best times, stats).
--
-- Life of a profile:
--   join     -&gt; a Session is created and loaded in the background. The load is one UpdateAsync that
--               takes a session lock ({ JobId, Time }) so two servers never own the same save. If
--               another server holds a fresh lock (a server hop in progress), we wait and retry, and
--               steal the lock after LOCK_RETRIES attempts (that server has probably crashed).
--   playing  -&gt; services read and change the profile table directly (Get), or through the helpers
--               below. PushMeta sends the client a MetaState snapshot (coalesced to one per 0.1 s).
--   autosave -&gt; every AUTOSAVE_INTERVAL seconds (plus a random offset per player), the profile is
--               written and the lock refreshed. A save only lands while we still own the lock.
--   leave    -&gt; a final save that also clears the lock, so the next server can load straight away.
--
-- Data is NEVER wiped. If a save exists but can't be read (DataStore errors after every retry, or a
-- damaged record), the player plays on a temporary default profile that is never saved, and is told
-- so. Only profiles that loaded successfully (and whose lock we still hold) are ever written.
--
-- Offline mode (unpublished place, or Studio without API access): profiles live in memory only,
-- everything else works the same, and each player is told once that progress won't save.
--
-- Passes are runtime-only (MarketService fills them in) and never saved.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Types = require(Shared:WaitForChild("Types"))
local Util = require(Shared:WaitForChild("Util"))

local DataService = {}

----------------------------------------------------------------------------------------------------
-- Tunables
----------------------------------------------------------------------------------------------------

local STORE_NAME = "RinseCycle_Profiles_v1"
local KEY_PREFIX = "u_"
local PROFILE_VERSION = 1

local LOCK_TTL = 1800 -- seconds; an older lock belongs to a server that died without releasing it
local LOCK_RETRIES = 6 -- locked loads to wait through before stealing the lock
local LOCK_WAIT_MIN, LOCK_WAIT_MAX = 3, 5 -- seconds between locked load attempts
local LOAD_ATTEMPTS = 6 -- DataStore errors tolerated while loading before falling back to a temp profile
local FINAL_SAVE_ATTEMPTS = 3
local RECEIPT_SAVE_ATTEMPTS = 2

local AUTOSAVE_INTERVAL = 120
local AUTOSAVE_JITTER = 30 -- random extra seconds before a player's first autosave, so saves spread out
local AUTOSAVE_TICK = 5 -- how often the autosave loop looks for due saves
local AUTOSAVE_RETRY = 30 -- a failed autosave tries again this soon
local SAVE_SOON_DELAY = 10 -- a level unlock is written within this many seconds
local SHUTDOWN_WAIT = 25

local PUSH_COALESCE = 0.1
local MAX_RECEIPTS = 50
local PROBE_WAIT = 5 -- max seconds IsOffline() waits for the Studio probe
local SAME_USER_WAIT = 30 -- max seconds a rejoin waits for this server to finish the previous session
local NOTICE_FALLBACK = 8 -- toasts go out this long after loading even if the client never asked for meta
local NOTICE_AFTER_READY = 1.5 -- ...or this long after the client's first GetMeta (its UI is up by then)
local META_REQUESTS_PER_SECOND = 3 -- GetMeta budget per player (burst of the same size)

local MSG_OFFLINE = "Progress won't save in this test (turn on Studio API access)."
local MSG_LOAD_FAILED = "We couldn't load your save - progress this session won't be saved. Rejoin to try again."
local MSG_LOCK_LOST = "Your save was opened on another server - progress here won't be saved. Rejoin to fix it."

----------------------------------------------------------------------------------------------------
-- Types
----------------------------------------------------------------------------------------------------

export type Profile = {
	Version: number,
	Bubbles: number,
	Perks: { [string]: number }, -- Config.Perks[i].Id -&gt; level
	Pets: { Types.PetEntry },
	Equipped: { string }, -- Uids, slot order
	NextUid: number,
	Unlocked: number, -- highest level index the player may pick
	BestTimes: { number }, -- one per Config.Levels entry, seconds, 0 = never cleared
	Stats: {
		Runs: number,
		DishesCleaned: number,
		GrimeCleaned: number,
		EggsHatched: number,
		BubblesEarned: number,
	},
	Receipts: { string }, -- recent developer-product PurchaseIds, newest last
}

-- A Bubbles or stat change that arrived before the profile finished loading (replayed on load).
type PendingChange = { Stat: string?, Amount: number } -- Stat nil = Bubbles

-- A one-shot gate: threads that wait on it sleep until it opens (or their timeout passes).
type Latch = { Open: boolean, Threads: { thread } }

type Session = {
	Player: Player,
	UserId: number,
	Key: string,
	Profile: Profile?, -- nil while loading
	CanSave: boolean, -- true only for a profile loaded from the DataStore whose lock we still hold
	Left: boolean, -- PlayerRemoving has fired
	Finalizing: boolean, -- the final (lock-releasing) save has started; nothing is saved after it
	Released: boolean, -- the lock has been cleared
	Busy: boolean, -- a save is in flight (saves for one session never overlap)
	SaveQueue: { thread },
	Loaded: Latch, -- opens when Profile is set, or the player leaves
	Done: Latch, -- opens when this session is completely finished (final save landed or given up)
	Previous: Session?, -- this user's previous session on this server, if it was still finishing
	NextAutosave: number, -- os.clock()
	Pending: { PendingChange }, -- Bubbles/stat changes that arrived while the profile was still loading
	Notices: { { string } }, -- { text, kind } toasts waiting for the client's UI
	ClientReady: boolean, -- the client has asked for its MetaState at least once
}

----------------------------------------------------------------------------------------------------
-- State
----------------------------------------------------------------------------------------------------

local TEMPLATE: Profile = {
	Version = PROFILE_VERSION,
	Bubbles = 0,
	Perks = {},
	Pets = {},
	Equipped = {},
	NextUid = 1,
	Unlocked = 1,
	BestTimes = {},
	Stats = { Runs = 0, DishesCleaned = 0, GrimeCleaned = 0, EggsHatched = 0, BubblesEarned = 0 },
	Receipts = {},
}
for _, perk in Config.Perks do
	TEMPLATE.Perks[perk.Id] = 0
end
for i = 1, #Config.Levels do
	TEMPLATE.BestTimes[i] = 0
end

local sessions: { [Player]: Session } = {}
local lastSessionOf: { [number]: Session } = {} -- userId -&gt; newest session on this server (until Done)
local passesOf: { [Player]: { [string]: boolean } } = {}
local pushQueued: { [Player]: boolean } = {}
local metaBudget: { [Player]: { Tokens: number, At: number } } = {}

local detection: Latch = { Open = false, Threads = {} } -- opens once we know whether we're offline
local offline = false
local shuttingDown = false
local activeJobs = 0 -- loads and saves in flight (BindToClose waits for these)
local initialized = false
local started = false

local store: DataStore? = nil
local rng = Random.new()

local metaRemote: RemoteEvent
local notifyRemote: RemoteEvent

DataService.ProfileLoaded = Util.Signal.new() -- (player, profile), for loaded, temporary and offline profiles
DataService.PassesChanged = Util.Signal.new() -- (player), after a pass (or pass-limited Equipped) changes

----------------------------------------------------------------------------------------------------
-- Small helpers
----------------------------------------------------------------------------------------------------

local function isFinite(n: any): boolean
	return type(n) == "number" and n == n and n ~= math.huge and n ~= -math.huge
end

-- A finite, non-negative whole number, or `default`.
local function toCount(value: any, default: number): number
	if not isFinite(value) then
		return default
	end
	return math.max(0, math.floor(value))
end

local function isPlayer(value: any): boolean
	return typeof(value) == "Instance" and value:IsA("Player")
end

local function isHere(player: Player): boolean
	return player.Parent == Players
end

local function newLatch(): Latch
	return { Open = false, Threads = {} }
end

local function openLatch(latch: Latch)
	if latch.Open then
		return
	end
	latch.Open = true
	local threads = latch.Threads
	latch.Threads = {}
	for _, thread in threads do
		task.spawn(thread)
	end
end

-- Yields until the latch opens or `timeout` seconds pass. Returns true if it opened.
local function waitLatch(latch: Latch, timeout: number): boolean
	if latch.Open then
		return true
	end
	local thread = coroutine.running()
	table.insert(latch.Threads, thread)
	task.delay(timeout, function()
		-- Still waiting? Then the latch never opened for us: wake up empty-handed.
		local index = table.find(latch.Threads, thread)
		if index then
			table.remove(latch.Threads, index)
			task.spawn(thread)
		end
	end)
	coroutine.yield()
	return latch.Open
end

-- Runs fn(...) as a tracked job so BindToClose knows to wait for it. Never throws.
local function track(fn: (...any) -&gt; ...any, ...: any)
	activeJobs += 1
	local ok, err = pcall(fn, ...)
	activeJobs -= 1
	if not ok then
		warn("[DataService] " .. tostring(err))
	end
end

local function getStore(): DataStore?
	if store then
		return store
	end
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = result
	end
	return store
end

local function newProfile(): Profile
	return Util.DeepCopy(TEMPLATE)
end

----------------------------------------------------------------------------------------------------
-- Offline detection
----------------------------------------------------------------------------------------------------

local function setOffline(value: boolean, reason: string?)
	offline = value
	if value then
		warn("[DataService] Offline mode: progress will not be saved (" .. tostring(reason) .. ")")
	end
	openLatch(detection)
end

-- A live server always has DataStores (an outage there is handled by retries and temp profiles, never
-- by turning saving off for the whole server). Only Studio can lack API access, so only Studio probes.
local function detectOffline()
	if game.PlaceId == 0 then
		setOffline(true, "the place isn't published")
		return
	end
	if not RunService:IsStudio() then
		setOffline(false)
		return
	end
	task.spawn(function()
		local ok, err = pcall(function()
			DataStoreService:GetDataStore(STORE_NAME):GetAsync("__probe")
		end)
		if ok then
			setOffline(false)
			return
		end
		local message = tostring(err)
		if
			string.find(message, "StudioAccessToApisNotAllowed", 1, true)
			or string.find(message, "API", 1, true)
			or string.find(string.lower(message), "publish", 1, true)
		then
			setOffline(true, message)
		else
			-- Some other hiccup: stay online. Loads retry and fall back to temp profiles if it persists.
			warn("[DataService] DataStore probe failed: " .. message)
			setOffline(false)
		end
	end)
end

----------------------------------------------------------------------------------------------------
-- Profile repair (runs after every load, outside the UpdateAsync transform)
----------------------------------------------------------------------------------------------------

-- Pet slots used to trim Equipped while loading. Pass ownership isn't known yet at that point, so a
-- slot pass that is on sale counts as owned; SetPass trims again once MarketService knows for sure.
local function loadSlotCap(player: Player, profile: Profile): number
	local passes = table.clone(passesOf[player] or {})
	local pass = Config.GetPass("PetSlots")
	if pass and type(pass.Id) == "number" and pass.Id &gt; 0 and passes.PetSlots == nil then
		passes.PetSlots = true
	end
	return Config.PetSlots(profile.Perks, passes)
end

local function sanitizeProfile(profile: Profile, player: Player)
	local p = profile :: any
	p.Lock = nil
	-- Reconcile only fills missing keys; wrong types from damaged or ancient saves are repaired below.
	Util.Reconcile(p, TEMPLATE :: any)

	p.Version = if isFinite(p.Version) then math.max(p.Version, PROFILE_VERSION) else PROFILE_VERSION
	p.Bubbles = toCount(p.Bubbles, 0)

	if type(p.Perks) ~= "table" then
		p.Perks = Util.DeepCopy(TEMPLATE.Perks)
	end
	for _, perk in Config.Perks do
		p.Perks[perk.Id] = toCount(p.Perks[perk.Id], 0)
	end

	-- Pets: keep every well-formed entry (extra fields included). Uids become strings, and duplicate
	-- or missing uids get fresh ones so every pet stays addressable.
	local rawPets = if type(p.Pets) == "table" then p.Pets else {}
	local pets, seen, needsUid = {}, {}, {}
	local maxUid = 0
	for _, entry in rawPets do
		if type(entry) == "table" and type(entry.Id) == "string" then
			local uid = entry.Uid
			if isFinite(uid) then
				uid = tostring(math.floor(uid))
			end
			if type(uid) ~= "string" or uid == "" or seen[uid] then
				table.insert(needsUid, entry)
			else
				seen[uid] = true
				entry.Uid = uid
				table.insert(pets, entry)
				local n = tonumber(uid)
				if n and isFinite(n) and n &gt; maxUid and n &lt; 1e12 then
					maxUid = math.floor(n)
				end
			end
		end
	end
	local nextUid = math.max(toCount(p.NextUid, 1), maxUid + 1, 1)
	for _, entry in needsUid do
		entry.Uid = tostring(nextUid)
		nextUid += 1
		table.insert(pets, entry)
	end
	p.Pets = pets
	p.NextUid = nextUid

	-- Equipped: only uids that exist (with a pet id the game knows), no repeats, at most the slots.
	local idOf = {}
	for _, pet in pets do
		idOf[pet.Uid] = pet.Id
	end
	local cap = loadSlotCap(player, p)
	local equipped, used = {}, {}
	for _, uid in (if type(p.Equipped) == "table" then p.Equipped else {}) do
		if isFinite(uid) then
			uid = tostring(math.floor(uid))
		end
		if type(uid) == "string" and not used[uid] and idOf[uid] and Config.Pets[idOf[uid]] and #equipped &lt; cap then
			used[uid] = true
			table.insert(equipped, uid)
		end
	end
	p.Equipped = equipped

	-- BestTimes: exactly one entry per level.
	local rawTimes = if type(p.BestTimes) == "table" then p.BestTimes else {}
	local times = {}
	for i = 1, #Config.Levels do
		local t = rawTimes[i]
		times[i] = if isFinite(t) and t &gt; 0 then t else 0
	end
	p.BestTimes = times

	-- Unlocked: a valid level, and never below "one past every level already cleared".
	local unlocked = math.clamp(toCount(p.Unlocked, 1), 1, #Config.Levels)
	for i, t in times do
		if t &gt; 0 then
			unlocked = math.max(unlocked, math.min(i + 1, #Config.Levels))
		end
	end
	p.Unlocked = unlocked

	if type(p.Stats) ~= "table" then
		p.Stats = Util.DeepCopy(TEMPLATE.Stats)
	end
	for key in TEMPLATE.Stats :: any do
		p.Stats[key] = toCount(p.Stats[key], 0)
	end

	local receipts = {}
	if type(p.Receipts) == "table" then
		for _, id in p.Receipts do
			if type(id) == "string" then
				table.insert(receipts, id)
			end
		end
	end
	while #receipts &gt; MAX_RECEIPTS do
		table.remove(receipts, 1)
	end
	p.Receipts = receipts
end

-- Copy of the profile that is safe to store: no runtime-only keys ("Lock", anything starting with
-- "_"), no Instances or functions, and no NaN/inf (which the DataStore refuses to encode).
local function cleanValue(value: any, depth: number): any
	local kind = type(value)
	if kind == "number" then
		return if isFinite(value) then value else 0
	elseif kind == "string" or kind == "boolean" then
		return value
	elseif kind == "table" and depth &lt; 8 then
		local out = {}
		for k, v in value do
			if type(k) == "string" or type(k) == "number" then
				out[k] = cleanValue(v, depth + 1)
			end
		end
		return out
	end
	return nil
end

local function serialize(profile: Profile): { [string]: any }
	local out = {}
	for key, value in profile :: any do
		if type(key) == "string" and key ~= "Lock" and string.sub(key, 1, 1) ~= "_" then
			out[key] = cleanValue(value, 1)
		end
	end
	return out
end

----------------------------------------------------------------------------------------------------
-- Profile edits shared by the public API and the "arrived while loading" replay
----------------------------------------------------------------------------------------------------

local function applyBubbles(profile: Profile, amount: number)
	profile.Bubbles = math.max(0, profile.Bubbles + amount)
	if amount &gt; 0 then
		profile.Stats.BubblesEarned += amount
	end
end

local function applyStat(profile: Profile, statName: string, amount: number)
	local stats = profile.Stats :: any
	stats[statName] = math.max(0, (stats[statName] or 0) + amount)
end

----------------------------------------------------------------------------------------------------
-- MetaState, leaderstats and toasts
----------------------------------------------------------------------------------------------------

local function buildMeta(player: Player, profile: Profile): Types.MetaState
	local passes = passesOf[player] or {}
	local passCopy = {}
	for _, pass in Config.GamePasses do
		passCopy[pass.Key] = passes[pass.Key] == true
	end
	local perks = {}
	for _, perk in Config.Perks do
		perks[perk.Id] = profile.Perks[perk.Id] or 0
	end
	-- Pets whose id was removed from Config stay in the save but are hidden from the client, which
	-- could not draw them.
	local pets, known = {}, {}
	for _, pet in profile.Pets do
		if type(pet) == "table" and Config.Pets[pet.Id] then
			table.insert(pets, { Uid = pet.Uid, Id = pet.Id })
			known[pet.Uid] = true
		end
	end
	local equipped = {}
	for _, uid in profile.Equipped do
		if known[uid] then
			table.insert(equipped, uid)
		end
	end
	local stats = profile.Stats
	local state: Types.MetaState = {
		Bubbles = profile.Bubbles,
		Perks = perks,
		Pets = pets,
		Equipped = equipped,
		PetSlots = Config.PetSlots(profile.Perks, passes),
		MaxPets = Config.PetRules.MaxInventory,
		Unlocked = profile.Unlocked,
		BestTimes = table.clone(profile.BestTimes),
		Stats = {
			Runs = stats.Runs,
			DishesCleaned = stats.DishesCleaned,
			GrimeCleaned = stats.GrimeCleaned,
			EggsHatched = stats.EggsHatched,
			BubblesEarned = stats.BubblesEarned,
		},
		Passes = passCopy,
	}
	return state
end

local function setupLeaderstats(player: Player)
	if player:FindFirstChild("leaderstats") then
		return
	end
	local folder = Instance.new("Folder")
	folder.Name = "leaderstats"
	-- Children are created in display order: Bubbles, then Dishes.
	for _, name in { "Bubbles", "Dishes" } do
		local value = Instance.new("IntValue")
		value.Name = name
		value.Value = 0
		value.Parent = folder
	end
	folder.Parent = player
end

local function setLeaderstat(player: Player, name: string, amount: number)
	local folder = player:FindFirstChild("leaderstats")
	local value = folder and folder:FindFirstChild(name)
	if value and value:IsA("IntValue") then
		value.Value = math.floor(amount)
	end
end

local function pushNow(player: Player)
	local session = sessions[player]
	local profile = session and session.Profile
	if not profile or not isHere(player) then
		return
	end
	player:SetAttribute("Bubbles", profile.Bubbles)
	setLeaderstat(player, "Bubbles", profile.Bubbles)
	setLeaderstat(player, "Dishes", profile.Stats.DishesCleaned)
	metaRemote:FireClient(player, buildMeta(player, profile))
end

local function flushNotices(session: Session)
	local player = session.Player
	if #session.Notices == 0 or not isHere(player) then
		return
	end
	local list = session.Notices
	session.Notices = {}
	for _, notice in list do
		notifyRemote:FireClient(player, notice[1], notice[2])
	end
end

-- Toasts sent the instant a player joins can arrive before their UI exists, so they wait until the
-- client has asked for its MetaState (or a fallback delay passes).
local function queueNotice(session: Session, text: string, kind: string)
	table.insert(session.Notices, { text, kind })
	task.delay(if session.ClientReady then NOTICE_AFTER_READY else NOTICE_FALLBACK, flushNotices, session)
end

----------------------------------------------------------------------------------------------------
-- Saving
----------------------------------------------------------------------------------------------------

local function ownsLock(record: { [string]: any }): boolean
	local lock = record.Lock
	return type(lock) == "table" and lock.JobId == game.JobId
end

local function lockedElsewhere(record: { [string]: any }): boolean
	local lock = record.Lock
	if type(lock) ~= "table" or lock.JobId == game.JobId or not isFinite(lock.Time) then
		return false
	end
	return os.time() - lock.Time &lt; LOCK_TTL
end

-- Saves for one session run one at a time (an autosave and the final save must never race).
local function acquireSaveSlot(session: Session)
	while session.Busy do
		table.insert(session.SaveQueue, coroutine.running())
		coroutine.yield()
	end
	session.Busy = true
end

local function releaseSaveSlot(session: Session)
	session.Busy = false
	local nextThread = table.remove(session.SaveQueue, 1)
	if nextThread then
		task.spawn(nextThread)
	end
end

-- One UpdateAsync: writes the profile and refreshes the lock (or clears it when `release`).
-- It only writes while this server still owns the lock; otherwise saving stops for this session.
local function writeProfile(session: Session, release: boolean): boolean
	local profile = session.Profile
	local dataStore = getStore()
	if not profile or not dataStore then
		return false
	end
	-- Everything that could be slow happens before UpdateAsync: the transform itself must not yield.
	local payload = serialize(profile)
	local userIds = { session.UserId }
	local outcome = "Error"
	local ok, err = pcall(function()
		dataStore:UpdateAsync(session.Key, function(old)
			if old == nil then
				outcome = "Missing" -- the save was erased (e.g. a data-removal request); don't resurrect it
				return nil
			end
			if type(old) ~= "table" or not ownsLock(old) then
				outcome = "LockLost"
				return nil
			end
			payload.Lock = if release then nil else { JobId = game.JobId, Time = os.time() }
			outcome = "Ok"
			return payload, userIds
		end)
	end)
	if not ok then
		warn(string.format("[DataService] save failed for %s: %s", session.Key, tostring(err)))
		return false
	end
	if outcome == "Ok" then
		return true
	end
	-- Another server owns this save now (or it's gone). Writing from here would clobber it.
	session.CanSave = false
	warn(string.format("[DataService] stopped saving %s (%s)", session.Key, outcome))
	if outcome == "LockLost" and not session.Left and isHere(session.Player) then
		queueNotice(session, MSG_LOCK_LOST, "Bad")
	end
	return false
end

local function saveSession(session: Session, release: boolean, attempts: number): boolean
	if not session.CanSave or not session.Profile or session.Released then
		return false
	end
	acquireSaveSlot(session)
	local saved = false
	for attempt = 1, attempts do
		if not session.CanSave or session.Released then
			break
		end
		saved = writeProfile(session, release)
		if saved or not session.CanSave then
			break
		end
		if attempt &lt; attempts then
			task.wait(attempt * 2)
		end
	end
	if saved and release then
		session.Released = true
	end
	releaseSaveSlot(session)
	return saved
end

local function autosave(session: Session)
	if not saveSession(session, false, 1) and session.CanSave and not session.Finalizing then
		session.NextAutosave = math.min(session.NextAutosave, os.clock() + AUTOSAVE_RETRY)
	end
end

-- Marks a session completely finished: wakes anyone waiting on it and forgets it.
local function finishSession(session: Session)
	openLatch(session.Loaded)
	openLatch(session.Done)
	if lastSessionOf[session.UserId] == session then
		lastSessionOf[session.UserId] = nil
	end
end

-- The last save of a session: writes the profile and releases the lock. Safe to call more than once.
local function finalize(session: Session)
	if session.Finalizing then
		return
	end
	session.Finalizing = true
	if session.CanSave and session.Profile then
		if not saveSession(session, true, FINAL_SAVE_ATTEMPTS) and session.CanSave then
			warn("[DataService] final save failed for " .. session.Key .. "; its lock expires on its own")
		end
	end
	finishSession(session)
end

----------------------------------------------------------------------------------------------------
-- Loading
----------------------------------------------------------------------------------------------------

-- Loads the record and takes the session lock. Returns:
--   "Ok", record   -&gt; we own the lock and have the data (a brand-new player gets the template)
--   "Abort", nil   -&gt; the player left or the server is closing; nothing was locked
--   "Failed", nil  -&gt; DataStore errors on every attempt, or a record we can't read
local function loadFromStore(session: Session): (string, any)
	local lockedTries, errorTries = 0, 0
	while true do
		if session.Left or shuttingDown or not isHere(session.Player) then
			return "Abort", nil
		end
		local steal = lockedTries &gt;= LOCK_RETRIES
		local status: string? = nil
		local record: any = nil
		local ok, err = false, "DataStoreService unavailable"
		local dataStore = getStore()
		if dataStore then
			local userIds = { session.UserId }
			ok, err = pcall(function()
				dataStore:UpdateAsync(session.Key, function(old)
					-- Must not yield. UpdateAsync may call this more than once; the last call wins.
					status, record = nil, nil
					if old ~= nil and type(old) ~= "table" then
						status = "Corrupt"
						return nil
					end
					if old ~= nil and not steal and lockedElsewhere(old) then
						status = "Locked"
						return nil
					end
					local data = if old ~= nil then old else Util.DeepCopy(TEMPLATE) :: any
					data.Lock = { JobId = game.JobId, Time = os.time() }
					status, record = "Ok", data
					return data, userIds
				end)
			end)
		end

		if ok and status == "Ok" then
			if steal then
				warn("[DataService] took over a stale session lock for " .. session.Key)
			end
			return "Ok", record
		elseif ok and status == "Corrupt" then
			warn("[DataService] unreadable save for " .. session.Key .. "; it will not be touched")
			return "Failed", nil
		elseif ok and status == "Locked" then
			-- Another server is still saving this player (a server hop). Give it a moment.
			lockedTries += 1
			task.wait(rng:NextNumber(LOCK_WAIT_MIN, LOCK_WAIT_MAX))
		else
			errorTries += 1
			warn(string.format("[DataService] load attempt %d for %s failed: %s", errorTries, session.Key, tostring(err)))
			if errorTries &gt;= LOAD_ATTEMPTS then
				return "Failed", nil
			end
			task.wait(math.min(1.5 * errorTries, 6) + rng:NextNumber(0, 1))
		end
	end
end

local function loadSession(session: Session)
	local player = session.Player

	-- A quick rejoin to this same server: let the previous session's final save land first, or we
	-- could read the save from before it.
	local previous = session.Previous
	session.Previous = nil
	if previous then
		waitLatch(previous.Done, SAME_USER_WAIT)
	end
	if not detection.Open then
		waitLatch(detection, PROBE_WAIT * 3)
	end

	local profile: Profile
	local canSave = false
	local notice: string? = nil
	local noticeKind = "Info"
	if offline then
		profile = newProfile()
		notice = MSG_OFFLINE
	else
		local status, record = loadFromStore(session)
		if status == "Abort" then
			finishSession(session)
			return
		end
		if status == "Ok" then
			profile = record
			canSave = true
		else
			-- Never overwrite a save we couldn't read: play on a temporary profile that is never saved.
			profile = newProfile()
			notice, noticeKind = MSG_LOAD_FAILED, "Bad"
			warn("[DataService] using a temporary unsaved profile for " .. session.Key)
		end
	end

	sanitizeProfile(profile, player)
	-- Rewards that arrived while we were loading.
	for _, change in session.Pending do
		if change.Stat then
			applyStat(profile, change.Stat, change.Amount)
		else
			applyBubbles(profile, change.Amount)
		end
	end
	session.Pending = {}

	session.Profile = profile
	session.CanSave = canSave
	session.NextAutosave = os.clock() + AUTOSAVE_INTERVAL + rng:NextNumber(0, AUTOSAVE_JITTER)

	if session.Left or not isHere(player) then
		-- They left while we were loading: hand the lock straight back.
		finalize(session)
		return
	end

	openLatch(session.Loaded)
	if notice then
		queueNotice(session, notice, noticeKind)
	end
	DataService.ProfileLoaded:Fire(player, profile)
	pushNow(player)

	if shuttingDown then
		finalize(session)
	end
end

local function ensureSession(player: Player): Session?
	local existing = sessions[player]
	if existing then
		return existing
	end
	if not isHere(player) then
		return nil
	end
	local userId = player.UserId
	local previous = lastSessionOf[userId]
	local session: Session = {
		Player = player,
		UserId = userId,
		Key = KEY_PREFIX .. tostring(userId),
		Profile = nil,
		CanSave = false,
		Left = false,
		Finalizing = false,
		Released = false,
		Busy = false,
		SaveQueue = {},
		Loaded = newLatch(),
		Done = newLatch(),
		Previous = if previous and not previous.Done.Open then previous else nil,
		NextAutosave = math.huge,
		Pending = {},
		Notices = {},
		ClientReady = false,
	}
	sessions[player] = session
	lastSessionOf[userId] = session
	if not passesOf[player] then
		passesOf[player] = {}
	end
	setupLeaderstats(player)
	task.spawn(track, loadSession, session)
	return session
end

local function onPlayerRemoving(player: Player)
	local session = sessions[player]
	sessions[player] = nil
	passesOf[player] = nil
	pushQueued[player] = nil
	metaBudget[player] = nil
	if not session then
		return
	end
	session.Left = true
	openLatch(session.Loaded) -- WaitFor callers wake up and get nil
	if session.Profile then
		task.spawn(track, finalize, session)
	end
	-- Still loading: loadSession notices Left and releases the lock itself.
end

----------------------------------------------------------------------------------------------------
-- GetMeta
----------------------------------------------------------------------------------------------------

local function allowMetaRequest(player: Player): boolean
	local now = os.clock()
	local budget = metaBudget[player]
	if not budget then
		budget = { Tokens = META_REQUESTS_PER_SECOND, At = now }
		metaBudget[player] = budget
	end
	budget.Tokens = math.min(META_REQUESTS_PER_SECOND, budget.Tokens + (now - budget.At) * META_REQUESTS_PER_SECOND)
	budget.At = now
	if budget.Tokens &lt; 1 then
		return false
	end
	budget.Tokens -= 1
	return true
end

local function onGetMeta(player: Player): Types.MetaState?
	local session = sessions[player]
	if not session or not isHere(player) or not allowMetaRequest(player) then
		return nil
	end
	if not session.ClientReady then
		-- The client's remotes are hooked up now; anything waiting to be said can go out shortly.
		session.ClientReady = true
		task.delay(NOTICE_AFTER_READY, flushNotices, session)
	end
	local profile = session.Profile
	if not profile then
		return nil
	end
	return buildMeta(player, profile)
end

----------------------------------------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------------------------------------

function DataService.Init()
	if initialized then
		return
	end
	initialized = true

	metaRemote = Remotes.Event("MetaState")
	notifyRemote = Remotes.Event("Notify")
	Remotes.Function("GetMeta").OnServerInvoke = onGetMeta

	detectOffline()

	Players.PlayerAdded:Connect(function(player)
		ensureSession(player)
	end)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, player in Players:GetPlayers() do
		ensureSession(player)
	end

	game:BindToClose(function()
		shuttingDown = true
		if not detection.Open then
			waitLatch(detection, 3)
		end
		if offline then
			return
		end
		for _, session in sessions do
			if session.Profile then
				task.spawn(track, finalize, session)
			end
		end
		-- Sessions still loading abort (or release right after loading); PlayerRemoving saves run too.
		local deadline = os.clock() + SHUTDOWN_WAIT
		while activeJobs &gt; 0 and os.clock() &lt; deadline do
			task.wait(0.25)
		end
		if activeJobs &gt; 0 then
			warn(string.format("[DataService] shutdown: %d save(s) still running after %ds", activeJobs, SHUTDOWN_WAIT))
		end
	end)
end

function DataService.Start()
	if started then
		return
	end
	started = true
	task.spawn(function()
		while true do
			task.wait(AUTOSAVE_TICK)
			if not shuttingDown and not offline then
				local now = os.clock()
				for _, session in sessions do
					if
						session.CanSave
						and session.Profile
						and not session.Finalizing
						and not session.Busy
						and now &gt;= session.NextAutosave
					then
						session.NextAutosave = now + AUTOSAVE_INTERVAL
						task.spawn(track, autosave, session)
					end
				end
			end
		end
	end)
end

-- The player's profile, or nil while it's loading (or after they left).
function DataService.Get(player: Player): Profile?
	local session = sessions[player]
	return session and session.Profile
end

-- Yields until the profile is ready (or `timeout` seconds pass, default 60, or the player leaves).
function DataService.WaitFor(player: Player, timeout: number?): Profile?
	if not isPlayer(player) then
		return nil
	end
	local session = ensureSession(player)
	if not session then
		return nil
	end
	if not session.Profile then
		waitLatch(session.Loaded, if isFinite(timeout) then math.max(0, timeout :: number) else 60)
	end
	return DataService.Get(player)
end

-- Coalesces MetaState pushes: any number of calls within PUSH_COALESCE seconds send one snapshot.
function DataService.PushMeta(player: Player)
	if not isPlayer(player) or pushQueued[player] or not sessions[player] then
		return
	end
	pushQueued[player] = true
	task.delay(PUSH_COALESCE, function()
		if not pushQueued[player] then
			return -- the player left in the meantime
		end
		pushQueued[player] = nil
		pushNow(player)
	end)
end

-- Adds (or with a negative amount, removes) Bubbles. Positive amounts also count toward
-- Stats.BubblesEarned. `reason` is only used in warnings. Returns false if nothing was applied.
function DataService.AddBubbles(player: Player, amount: number, reason: string?): boolean
	if not isFinite(amount) then
		warn("[DataService] AddBubbles ignored a bad amount (" .. tostring(reason) .. ")")
		return false
	end
	local rounded = math.floor(amount + 0.5)
	local session = sessions[player]
	if not session then
		return false
	end
	if rounded == 0 then
		return true
	end
	local profile = session.Profile
	if not profile then
		table.insert(session.Pending, { Amount = rounded })
		return true
	end
	applyBubbles(profile, rounded)
	DataService.PushMeta(player)
	return true
end

-- Takes Bubbles if the player has enough. Returns true when paid.
function DataService.SpendBubbles(player: Player, amount: number): boolean
	local profile = DataService.Get(player)
	if not profile or not isFinite(amount) or amount &lt; 0 then
		return false
	end
	local cost = math.ceil(amount)
	if profile.Bubbles &lt; cost then
		return false
	end
	profile.Bubbles -= cost
	DataService.PushMeta(player)
	return true
end

-- Adds to one of profile.Stats (Runs, DishesCleaned, GrimeCleaned, EggsHatched, BubblesEarned).
function DataService.AddStat(player: Player, statName: string, amount: number): boolean
	if type(statName) ~= "string" or (TEMPLATE.Stats :: any)[statName] == nil or not isFinite(amount) then
		return false
	end
	local rounded = math.floor(amount + 0.5)
	local session = sessions[player]
	if not session then
		return false
	end
	if rounded == 0 then
		return true
	end
	local profile = session.Profile
	if not profile then
		table.insert(session.Pending, { Stat = statName, Amount = rounded })
		return true
	end
	applyStat(profile, statName, rounded)
	DataService.PushMeta(player)
	return true
end

-- Runtime pass ownership ({ [Key] = true }). Read-only for callers.
function DataService.GetPasses(player: Player): { [string]: boolean }
	return passesOf[player] or {}
end

-- Records pass ownership for this session. When it changes, Equipped is trimmed to the (possibly
-- smaller) slot count, MetaState is pushed and PassesChanged fires so run stats and pets update.
function DataService.SetPass(player: Player, key: string, owned: boolean)
	if not isPlayer(player) or type(key) ~= "string" then
		return
	end
	local passes = passesOf[player]
	if not passes then
		if not isHere(player) then
			return
		end
		passes = {}
		passesOf[player] = passes
	end
	local value = owned == true
	local changed = (passes[key] == true) ~= value
	passes[key] = value

	-- Loading trims Equipped as if an on-sale slot pass were owned; now that we know, trim for real.
	local trimmed = false
	local profile = DataService.Get(player)
	if profile then
		local slots = Config.PetSlots(profile.Perks, passes)
		while #profile.Equipped &gt; slots do
			table.remove(profile.Equipped)
			trimmed = true
		end
	end

	if changed or trimmed then
		DataService.PushMeta(player)
		DataService.PassesChanged:Fire(player)
	end
end

function DataService.GetPetSlots(player: Player): number
	local profile = DataService.Get(player)
	return Config.PetSlots(profile and profile.Perks, passesOf[player] or {})
end

-- Records a finished run. Returns (firstClear, newBest, unlockedLevel?). A first clear also counts as
-- a new best. The next level unlocks if it exists and wasn't unlocked yet.
function DataService.RecordClear(player: Player, levelIndex: number, seconds: number): (boolean, boolean, number?)
	local session = sessions[player]
	local profile = session and session.Profile
	if
		not session
		or not profile
		or not isFinite(levelIndex)
		or levelIndex ~= math.floor(levelIndex)
		or not Config.Levels[levelIndex]
		or not isFinite(seconds)
		or seconds &lt;= 0
	then
		return false, false, nil
	end

	local time = math.max(0.1, math.floor(seconds * 10 + 0.5) / 10) -- tenths, like the leaderboards
	local previous = profile.BestTimes[levelIndex] or 0
	local firstClear = previous &lt;= 0
	local newBest = firstClear or time &lt; previous
	if newBest then
		profile.BestTimes[levelIndex] = time
	end

	local unlocked: number? = nil
	local nextLevel = levelIndex + 1
	if Config.Levels[nextLevel] and profile.Unlocked &lt; nextLevel then
		profile.Unlocked = nextLevel
		unlocked = nextLevel
	end
	profile.Stats.Runs += 1

	-- Unlocks and best times are the progress players care most about: write them soon.
	session.NextAutosave = math.min(session.NextAutosave, os.clock() + SAVE_SOON_DELAY)
	DataService.PushMeta(player)
	return firstClear, newBest, unlocked
end

function DataService.IsOffline(): boolean
	-- Resolves instantly except in a published place's Studio session, where the probe takes a moment.
	if not detection.Open then
		waitLatch(detection, PROBE_WAIT)
	end
	return offline
end

-- (Addition) Saves the player's profile right now and yields until done. True only if it was
-- written; always false offline and for temporary profiles. MarketService uses it for receipts.
function DataService.Save(player: Player): boolean
	local session = sessions[player]
	if not session or not session.Profile or not session.CanSave or session.Finalizing then
		return false
	end
	activeJobs += 1
	local ok, saved = pcall(saveSession, session, false, RECEIPT_SAVE_ATTEMPTS)
	activeJobs -= 1
	if not ok then
		warn("[DataService] " .. tostring(saved))
		return false
	end
	if saved then
		session.NextAutosave = os.clock() + AUTOSAVE_INTERVAL
	end
	return saved == true
end

-- (Addition) True when this player's progress is being persisted: the profile loaded from the
-- DataStore and this server still owns its lock. False offline and for temporary profiles.
function DataService.CanSave(player: Player): boolean
	local session = sessions[player]
	return session ~= nil and session.Profile ~= nil and session.CanSave and not session.Finalizing
end

return DataService</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000010"><Properties><string name="Name">DishFactory</string><ProtectedString name="Source">-- DishFactory: builds one dish (plate/bowl/cup/glass/fork/knife/spoon/pan/pot) out of primitive
-- parts, and covers a built dish in grime spots that sit on its real, raycast-checked surfaces.
--
-- Everything here works in the dish's own "anchor" frame: `cf` (a CFrame passed to BuildDish) whose
-- Position is the contact point where the dish touches the rack/basket, and whose axes we reuse as
-- a local coordinate system for the rest of the geometry:
--   local X = cf.RightVector   (sideways across the dish)
--   local Y = cf.UpVector      (straight up from the contact point)
--   local Z = cf.LookVector    (the direction a plate's face points; "forward" for everything else)
-- BuildDish stores that CFrame on the model (attribute "Anchor") so ApplyGrime can rebuild the same
-- local geometry later without needing the caller to pass it again.
--
-- This module owns no state that outlives a single Init() except the bowl template in
-- ServerStorage.DishTemplates, so it has no server dependencies (see DESIGN.md section 3's graph).

local ServerStorage = game:GetService("ServerStorage")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Util = require(Shared:WaitForChild("Util"))

local DishFactory = {}

----------------------------------------------------------------------------------------------------
-- Sizes (DESIGN.md section 5, ArenaBuilder/DishFactory), relative to a ~5 stud tall character.
----------------------------------------------------------------------------------------------------
local SIZE = {
	Plate = { Diameter = 11, Thickness = 0.6 },
	Bowl = { Diameter = 9, Depth = 4.5 },
	Cup = { Diameter = 5, Height = 6 },
	Glass = { Diameter = 4.5, Height = 8 },
	Fork = { Height = 13 },
	Knife = { Height = 13 },
	Spoon = { Height = 13 },
	Pan = { Diameter = 16, Depth = 3 },
	Pot = { Diameter = 14, Height = 10 },
}

local BRIGHT_COLORS = {
	Color3.fromRGB(255, 90, 90),
	Color3.fromRGB(90, 140, 255),
	Color3.fromRGB(90, 220, 120),
	Color3.fromRGB(255, 210, 60),
	Color3.fromRGB(255, 120, 200),
	Color3.fromRGB(255, 160, 60),
	Color3.fromRGB(170, 110, 255),
	Color3.fromRGB(90, 220, 220),
}

----------------------------------------------------------------------------------------------------
-- Template state (built once in Init)
----------------------------------------------------------------------------------------------------
local templatesFolder: Folder? = nil
local bowlShellTemplate: BasePart? = nil -- a hollowed-out PartOperation, or nil if GeometryService failed

----------------------------------------------------------------------------------------------------
-- Small geometry helpers, all working in an anchor CFrame's local axes.
----------------------------------------------------------------------------------------------------

-- Local (x = Right, y = Up, z = Look) -&gt; world position.
local function localPos(anchor: CFrame, x: number, y: number, z: number): Vector3
	return anchor.Position + anchor.RightVector * x + anchor.UpVector * y + anchor.LookVector * z
end

-- Local (x, y, z) -&gt; world direction (not normalized to a point, just a direction/offset).
local function localDir(anchor: CFrame, x: number, y: number, z: number): Vector3
	return anchor.RightVector * x + anchor.UpVector * y + anchor.LookVector * z
end

-- A part whose local X axis is `axisWorld` (used for Shape = Cylinder, where X is the axis).
local function axisCFrame(pos: Vector3, axisWorld: Vector3, hintWorld: Vector3): CFrame
	local ok, cf = pcall(CFrame.fromMatrix, pos, axisWorld.Unit, hintWorld.Unit)
	if ok then
		return cf
	end
	-- axisWorld and hintWorld were (nearly) parallel; fall back to a safe hint.
	return CFrame.fromMatrix(pos, axisWorld.Unit, Vector3.new(0, 1, 0))
end

local function newPart(shape: Enum.PartType?, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?): BasePart
	local p = Instance.new("Part")
	if shape then
		p.Shape = shape
	end
	p.Size = Vector3.new(math.max(size.X, 0.05), math.max(size.Y, 0.05), math.max(size.Z, 0.05))
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.Anchored = true
	p.CanCollide = true
	p.CanTouch = false
	p.CanQuery = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	return p
end

local function newWedge(size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?): BasePart
	local p = Instance.new("WedgePart")
	p.Size = Vector3.new(math.max(size.X, 0.05), math.max(size.Y, 0.05), math.max(size.Z, 0.05))
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.Anchored = true
	p.CanCollide = true
	p.CanTouch = false
	p.CanQuery = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	return p
end

-- A small "D" shaped handle bracket (three parts) attached to the side of a cylindrical body.
-- `attachY0`/`attachY1` are local heights of the two attach points; `out` is how far it pokes out.
local function buildHandle(anchor: CFrame, radius: number, attachY0: number, attachY1: number, out: number, thickness: number, color: Color3, material: Enum.Material?): { BasePart }
	local parts = {}
	local midY = (attachY0 + attachY1) / 2
	local armHeight = math.abs(attachY1 - attachY0)

	-- Outer vertical bar.
	local barCF = axisCFrame(localPos(anchor, 0, midY, radius + out / 2), anchor.UpVector, anchor.LookVector)
	table.insert(parts, newPart(nil, Vector3.new(thickness, armHeight, thickness), barCF, color, material))

	-- Top and bottom stubs connecting the bar to the body.
	for _, y in { attachY0, attachY1 } do
		local stubCF = axisCFrame(localPos(anchor, 0, y, radius + out / 2), anchor.LookVector, anchor.UpVector)
		table.insert(parts, newPart(nil, Vector3.new(out + thickness, thickness, thickness), stubCF, color, material))
	end
	return parts
end

----------------------------------------------------------------------------------------------------
-- Per-kind builders. Each returns (parts: {BasePart}, primaryIndex: number).
----------------------------------------------------------------------------------------------------

local function buildPlate(anchor: CFrame, theme, rng: Random)
	local s = SIZE.Plate
	local radius = s.Diameter / 2
	local center = localPos(anchor, 0, radius, 0)
	local cf = axisCFrame(center, anchor.LookVector, anchor.UpVector)
	-- The rim is the full thickness/diameter; the body sits inset (recessed) inside it, so both
	-- faces show a proud rim ring around a slightly recessed centre.
	local rim = newPart(Enum.PartType.Cylinder, Vector3.new(s.Thickness, s.Diameter, s.Diameter), cf, theme.PlateRim, Enum.Material.SmoothPlastic)
	local body = newPart(Enum.PartType.Cylinder, Vector3.new(s.Thickness * 0.65, s.Diameter * 0.82, s.Diameter * 0.82), cf, theme.Plate, Enum.Material.SmoothPlastic)
	return { rim, body }, 1
end

local function buildBowlFallback(anchor: CFrame, theme, rng: Random)
	local s = SIZE.Bowl
	local radius = s.Diameter / 2
	local parts = {}
	local base = newPart(Enum.PartType.Ball, Vector3.new(s.Diameter * 0.85, s.Depth * 0.7, s.Diameter * 0.85), CFrame.new(localPos(anchor, 0, s.Depth * 0.35, 0)) * anchor.Rotation, theme.Bowl)
	table.insert(parts, base)

	local wallCount = 10
	for i = 1, wallCount do
		local theta = (i - 1) / wallCount * math.pi * 2 + rng:NextNumber() * 0.15
		local out = Vector3.new(math.cos(theta), 0, math.sin(theta))
		local outWorld = localDir(anchor, out.X, 0, out.Z).Unit
		local pos = localPos(anchor, out.X * radius * 0.92, s.Depth * 0.55, out.Z * radius * 0.92)
		local cf = CFrame.lookAt(pos, pos + outWorld, anchor.UpVector) * CFrame.Angles(math.rad(18), 0, 0)
		local wall = newPart(nil, Vector3.new(radius * 0.72, s.Depth * 0.95, 0.5), cf, theme.Bowl)
		table.insert(parts, wall)
	end
	return parts, 1
end

local function buildBowl(anchor: CFrame, theme, rng: Random)
	if bowlShellTemplate then
		local ok, clone = pcall(function()
			return bowlShellTemplate:Clone()
		end)
		if ok and clone then
			local s = SIZE.Bowl
			clone.CFrame = CFrame.new(localPos(anchor, 0, s.Depth, 0)) * anchor.Rotation
			clone.Color = theme.Bowl
			clone.Anchored = true
			clone.CanCollide = true
			clone.CanTouch = false
			clone.CanQuery = true
			clone.Name = "Bowl"
			return { clone }, 1
		end
	end
	return buildBowlFallback(anchor, theme, rng)
end

-- Shared body for Cup/Glass/Pot: an upright (or upside-down) cylinder, contact point at local y=0.
local function buildCylinderBody(anchor: CFrame, diameter: number, height: number, color: Color3, material: Enum.Material?): BasePart
	local center = localPos(anchor, 0, height / 2, 0)
	local cf = axisCFrame(center, anchor.UpVector, anchor.LookVector)
	return newPart(Enum.PartType.Cylinder, Vector3.new(height, diameter, diameter), cf, color, material)
end

local function buildCup(anchor: CFrame, theme, rng: Random)
	local s = SIZE.Cup
	local body = buildCylinderBody(anchor, s.Diameter, s.Height, theme.Cup)
	local handle = buildHandle(anchor, s.Diameter / 2, s.Height * 0.28, s.Height * 0.72, 1.1, 0.5, theme.Cup)
	local parts = { body }
	for _, h in handle do
		table.insert(parts, h)
	end
	return parts, 1
end

local function buildGlass(anchor: CFrame, theme, rng: Random)
	local s = SIZE.Glass
	local body = buildCylinderBody(anchor, s.Diameter, s.Height, theme.Glass, Enum.Material.Glass)
	return { body }, 1
end

local function buildPan(anchor: CFrame, theme, rng: Random)
	local s = SIZE.Pan
	local body = buildCylinderBody(anchor, s.Diameter, s.Depth, theme.Metal, Enum.Material.Metal)
	local handleLen = 9
	local handleCF = axisCFrame(
		localPos(anchor, s.Diameter / 2 + handleLen / 2, s.Depth * 0.6, 0),
		anchor.RightVector,
		anchor.UpVector
	)
	local handle = newPart(Enum.PartType.Cylinder, Vector3.new(handleLen, 0.9, 0.9), handleCF, theme.Metal, Enum.Material.Metal)
	return { body, handle }, 1
end

local function buildPot(anchor: CFrame, theme, rng: Random)
	local s = SIZE.Pot
	local body = buildCylinderBody(anchor, s.Diameter, s.Height, theme.Metal, Enum.Material.Metal)
	local parts = { body }
	-- Two loop handles on opposite sides near the rim.
	for _, side in { 1, -1 } do
		local y0, y1 = s.Height * 0.72, s.Height * 0.92
		local mid = (y0 + y1) / 2
		local out = 1.4
		local barCF = axisCFrame(
			localPos(anchor, side * (s.Diameter / 2 + out * 0.5), mid, 0),
			anchor.LookVector,
			anchor.UpVector
		)
		table.insert(parts, newPart(nil, Vector3.new(0.5, math.abs(y1 - y0), 0.5), barCF, theme.Metal, Enum.Material.Metal))
		for _, y in { y0, y1 } do
			local stubCF = axisCFrame(
				localPos(anchor, side * (s.Diameter / 2 + out * 0.5) * 0.5, y, 0),
				anchor.RightVector,
				anchor.UpVector
			)
			table.insert(parts, newPart(nil, Vector3.new(out + 0.5, 0.5, 0.5), stubCF, theme.Metal, Enum.Material.Metal))
		end
	end
	return parts, 1
end

-- Cutlery: a handle standing up from the basket floor (local y=0), a head at the top.
local function buildFork(anchor: CFrame, theme, rng: Random)
	local total = SIZE.Fork.Height
	local handleH = total * 0.6
	local headH = total - handleH
	local handleCF = axisCFrame(localPos(anchor, 0, handleH / 2, 0), anchor.UpVector, anchor.LookVector)
	local handle = newPart(Enum.PartType.Cylinder, Vector3.new(handleH, 0.9, 0.6), handleCF, theme.Metal, Enum.Material.Metal)

	local neckCF = axisCFrame(localPos(anchor, 0, handleH + headH * 0.12, 0), anchor.UpVector, anchor.LookVector)
	local neck = newPart(nil, Vector3.new(headH * 0.24, 2.6, 1.4), neckCF, theme.Metal, Enum.Material.Metal)

	local parts = { handle, neck }
	local tineCount = 4
	local spread = 2.6
	for i = 1, tineCount do
		local x = (i - (tineCount + 1) / 2) * (spread / (tineCount - 1))
		local tineCF = axisCFrame(localPos(anchor, x, handleH + headH * 0.6, 0), anchor.UpVector, anchor.LookVector)
		table.insert(parts, newPart(Enum.PartType.Cylinder, Vector3.new(headH * 0.8, 0.32, 0.32), tineCF, theme.Metal, Enum.Material.Metal))
	end
	return parts, 1
end

local function buildKnife(anchor: CFrame, theme, rng: Random)
	local total = SIZE.Knife.Height
	local handleH = total * 0.45
	local bladeH = total - handleH
	local handleCF = axisCFrame(localPos(anchor, 0, handleH / 2, 0), anchor.UpVector, anchor.LookVector)
	local handle = newPart(Enum.PartType.Cylinder, Vector3.new(handleH, 1.0, 0.7), handleCF, Color3.fromRGB(60, 60, 65), Enum.Material.SmoothPlastic)

	-- Tapered blade: a wedge with its point up.
	local bladeCF = CFrame.new(localPos(anchor, 0, handleH, -0.35)) * anchor.Rotation * CFrame.Angles(math.rad(90), 0, 0)
	local blade = newWedge(Vector3.new(0.35, 1.8, bladeH), bladeCF, theme.Metal, Enum.Material.Metal)
	return { handle, blade }, 1
end

local function buildSpoon(anchor: CFrame, theme, rng: Random)
	local total = SIZE.Spoon.Height
	local handleH = total * 0.68
	local handleCF = axisCFrame(localPos(anchor, 0, handleH / 2, 0), anchor.UpVector, anchor.LookVector)
	local handle = newPart(Enum.PartType.Cylinder, Vector3.new(handleH, 0.9, 0.6), handleCF, theme.Metal, Enum.Material.Metal)

	local bowlCenter = localPos(anchor, 0, handleH + 1.6, 0)
	local bowl = Instance.new("Part")
	bowl.Shape = Enum.PartType.Ball
	bowl.Size = Vector3.new(2.0, 2.0, 2.0)
	bowl.CFrame = CFrame.new(bowlCenter) * anchor.Rotation
	bowl.Color = theme.Metal
	bowl.Material = Enum.Material.Metal
	bowl.Anchored = true
	bowl.CanCollide = true
	bowl.CanTouch = false
	bowl.CanQuery = true
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Scale = Vector3.new(1.3, 1.9, 1.0)
	mesh.Parent = bowl
	return { handle, bowl }, 1
end

local BUILDERS: { [string]: (CFrame, any, Random) -&gt; ({ BasePart }, number) } = {
	Plate = buildPlate,
	Bowl = buildBowl,
	Cup = buildCup,
	Glass = buildGlass,
	Fork = buildFork,
	Knife = buildKnife,
	Spoon = buildSpoon,
	Pan = buildPan,
	Pot = buildPot,
}

----------------------------------------------------------------------------------------------------
-- Init: prebuild the hollow-bowl template. Falls back silently (see buildBowlFallback) on any error.
----------------------------------------------------------------------------------------------------
local function tryBuildBowlShell(): BasePart?
	local GeometryService = game:GetService("GeometryService")
	local s = SIZE.Bowl
	local farAway = Vector3.new(0, 4000, 0) -- keep it well clear of anything else being built

	local outer = Instance.new("Part")
	outer.Shape = Enum.PartType.Ball
	outer.Size = Vector3.new(s.Diameter, s.Diameter, s.Diameter)
	outer.CFrame = CFrame.new(farAway)
	outer.Anchored = true
	outer.Parent = ServerStorage

	local hollow = Instance.new("Part")
	hollow.Shape = Enum.PartType.Ball
	hollow.Size = Vector3.new(s.Diameter - 1, s.Diameter - 0.6, s.Diameter - 1)
	hollow.CFrame = CFrame.new(farAway + Vector3.new(0, 1.1, 0))
	hollow.Anchored = true
	hollow.Parent = ServerStorage

	local lid = Instance.new("Part")
	lid.Size = Vector3.new(s.Diameter + 4, s.Diameter, s.Diameter + 4)
	lid.CFrame = CFrame.new(farAway + Vector3.new(0, s.Diameter / 2 + s.Depth, 0))
	lid.Anchored = true
	lid.Parent = ServerStorage

	local ok, result = pcall(function()
		return GeometryService:SubtractAsync(outer, { hollow, lid }, { SplitApart = false })
	end)

	if hollow.Parent then
		hollow:Destroy()
	end
	if lid.Parent then
		lid:Destroy()
	end
	if outer.Parent then
		outer:Destroy()
	end

	if ok and type(result) == "table" and result[1] then
		local shell = result[1] :: BasePart
		shell.Name = "BowlShell"
		shell.Anchored = true
		shell.CanCollide = true
		shell.CanTouch = false
		shell.CanQuery = true
		shell.Parent = templatesFolder
		return shell
	end
	return nil
end

function DishFactory.Init()
	local folder = ServerStorage:FindFirstChild("DishTemplates")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "DishTemplates"
		folder.Parent = ServerStorage
	end
	templatesFolder = folder :: Folder

	local ok, shellOrErr = pcall(tryBuildBowlShell)
	if ok and shellOrErr then
		bowlShellTemplate = shellOrErr
	else
		bowlShellTemplate = nil
		if not ok then
			warn("[DishFactory] GeometryService bowl template failed, using fallback bowl: " .. tostring(shellOrErr))
		end
	end
end

----------------------------------------------------------------------------------------------------
-- BuildDish
----------------------------------------------------------------------------------------------------
function DishFactory.BuildDish(kind: string, cf: CFrame, theme, rng: Random): Model
	local builder = BUILDERS[kind]
	local model = Instance.new("Model")
	model.Name = kind

	if not builder then
		warn("[DishFactory] Unknown dish kind " .. tostring(kind))
		local stub = newPart(nil, Vector3.new(1, 1, 1), cf, Color3.new(1, 0, 1))
		stub.Parent = model
		model.PrimaryPart = stub
		model:SetAttribute("Anchor", cf)
		model:SetAttribute("Kind", kind)
		return model
	end

	local parts, primaryIndex = builder(cf, theme, rng)
	for _, part in parts do
		part.Parent = model
	end
	model.PrimaryPart = parts[primaryIndex] or parts[1]
	model:SetAttribute("Anchor", cf)
	model:SetAttribute("Kind", kind)
	return model
end

----------------------------------------------------------------------------------------------------
-- Grime placement: per-kind candidate rays, in the dish's local (Right, Up, Look) axes.
-- Returns (localOrigin, localDirection); both get converted to world space before raycasting.
----------------------------------------------------------------------------------------------------
local function candidatePlate(rng: Random)
	local side = if rng:NextNumber() &lt; 0.5 then 1 else -1
	local r = math.sqrt(rng:NextNumber()) * 4.2
	local theta = rng:NextNumber() * math.pi * 2
	local x, y = r * math.cos(theta), SIZE.Plate.Diameter / 2 + r * math.sin(theta)
	return Vector3.new(x, y, side * 3), Vector3.new(0, 0, -side)
end

local function candidateBowl(rng: Random)
	local s = SIZE.Bowl
	local theta = rng:NextNumber() * math.pi * 2
	local frac = rng:NextNumber()
	local r = (s.Diameter / 2 - 0.3) * frac
	local y = 0.3 + s.Depth * 0.85 * frac
	local x, z = r * math.cos(theta), r * math.sin(theta)
	local ox, oz = x * 1.6, z * 1.6
	local origin = Vector3.new(ox, y + 3, oz)
	local target = Vector3.new(x, y, z)
	return origin, (target - origin)
end

local function candidateCylinderSide(diameter: number, height: number, rng: Random)
	local theta = rng:NextNumber() * math.pi * 2
	local y = rng:NextNumber() * height
	local radius = diameter / 2
	local nx, nz = math.cos(theta), math.sin(theta)
	local x, z = nx * radius, nz * radius
	return Vector3.new(x + nx * 3, y, z + nz * 3), Vector3.new(-nx, 0, -nz)
end

local function candidateCylinderTop(diameter: number, height: number, rng: Random)
	local r = math.sqrt(rng:NextNumber()) * (diameter / 2 - 0.2)
	local theta = rng:NextNumber() * math.pi * 2
	local x, z = r * math.cos(theta), r * math.sin(theta)
	return Vector3.new(x, height + 3, z), Vector3.new(0, -1, 0)
end

local function candidateCupLike(diameter: number, height: number, rng: Random)
	if rng:NextNumber() &lt; 0.75 then
		return candidateCylinderSide(diameter, height, rng)
	end
	return candidateCylinderTop(diameter, height, rng)
end

local function candidatePan(rng: Random)
	local s = SIZE.Pan
	local r = math.sqrt(rng:NextNumber()) * (s.Diameter / 2 - 0.5)
	local theta = rng:NextNumber() * math.pi * 2
	local x, z = r * math.cos(theta), r * math.sin(theta)
	return Vector3.new(x, s.Depth + 3, z), Vector3.new(0, -1, 0)
end

local function candidateCutlery(height: number, rng: Random)
	local side = if rng:NextNumber() &lt; 0.5 then 1 else -1
	local y = height * (0.62 + rng:NextNumber() * 0.36)
	local z = (rng:NextNumber() - 0.5) * 1.0
	return Vector3.new(side * 3, y, z), Vector3.new(-side, 0, 0)
end

local CANDIDATES: { [string]: (Random) -&gt; (Vector3, Vector3) } = {
	Plate = candidatePlate,
	Bowl = candidateBowl,
	Cup = function(rng)
		return candidateCupLike(SIZE.Cup.Diameter, SIZE.Cup.Height, rng)
	end,
	Glass = function(rng)
		return candidateCupLike(SIZE.Glass.Diameter, SIZE.Glass.Height, rng)
	end,
	Pan = candidatePan,
	Pot = function(rng)
		return candidateCupLike(SIZE.Pot.Diameter, SIZE.Pot.Height, rng)
	end,
	Fork = function(rng)
		return candidateCutlery(SIZE.Fork.Height, rng)
	end,
	Knife = function(rng)
		return candidateCutlery(SIZE.Knife.Height, rng)
	end,
	Spoon = function(rng)
		return candidateCutlery(SIZE.Spoon.Height, rng)
	end,
}

----------------------------------------------------------------------------------------------------
-- Grime shape builders. `cf` already has local X = outward normal, sitting ~0.05 studs proud.
----------------------------------------------------------------------------------------------------
local function shapeBlob(cf: CFrame, size: number, color: Color3, material: Enum.Material)
	local part = newPart(Enum.PartType.Cylinder, Vector3.new(0.12, size, size), cf, color, material)
	part.CanCollide = false
	return part, {}
end

local function shapeStreak(cf: CFrame, size: number, color: Color3, material: Enum.Material)
	local part = newPart(nil, Vector3.new(0.1, size * 1.7, size * 0.5), cf, color, material)
	part.CanCollide = false
	return part, {}
end

local function shapeCrumbs(cf: CFrame, size: number, color: Color3, material: Enum.Material, rng: Random)
	local part = newPart(Enum.PartType.Cylinder, Vector3.new(0.1, size * 0.7, size * 0.7), cf, color, material)
	part.CanCollide = false
	local bits = {}
	local n = rng:NextInteger(3, 5)
	for _ = 1, n do
		local dy = (rng:NextNumber() - 0.5) * size * 0.9
		local dz = (rng:NextNumber() - 0.5) * size * 0.9
		local s = size * rng:NextNumber(0.12, 0.22)
		local bit = Instance.new("Part")
		bit.Shape = Enum.PartType.Ball
		bit.Size = Vector3.new(s, s, s)
		bit.CFrame = cf * CFrame.new(0.04, dy, dz)
		bit.Color = color
		bit.Material = material
		bit.Anchored = true
		bit.CanCollide = false
		bit.CanTouch = false
		bit.CanQuery = false
		bit.CastShadow = false
		table.insert(bits, bit)
	end
	return part, bits
end

local function shapeSprinkles(cf: CFrame, size: number, color: Color3, material: Enum.Material, rng: Random)
	local part = newPart(Enum.PartType.Cylinder, Vector3.new(0.1, size * 0.8, size * 0.8), cf, color, material)
	part.CanCollide = false
	local sticks = {}
	local n = rng:NextInteger(6, 10)
	for _ = 1, n do
		local dy = (rng:NextNumber() - 0.5) * size * 0.8
		local dz = (rng:NextNumber() - 0.5) * size * 0.8
		local spin = rng:NextNumber() * math.pi * 2
		local stick = Instance.new("Part")
		stick.Shape = Enum.PartType.Cylinder
		stick.Size = Vector3.new(size * 0.35, 0.12, 0.12)
		stick.CFrame = cf * CFrame.new(0.03, dy, dz) * CFrame.Angles(spin, rng:NextNumber() * math.pi, 0)
		stick.Color = BRIGHT_COLORS[rng:NextInteger(1, #BRIGHT_COLORS)]
		stick.Material = Enum.Material.SmoothPlastic
		stick.Anchored = true
		stick.CanCollide = false
		stick.CanTouch = false
		stick.CanQuery = false
		stick.CastShadow = false
		table.insert(sticks, stick)
	end
	return part, sticks
end

----------------------------------------------------------------------------------------------------
-- ApplyGrime
----------------------------------------------------------------------------------------------------
local GOLDEN_COLOR = Color3.fromRGB(255, 213, 80)
local RAY_ATTEMPTS = 8

function DishFactory.ApplyGrime(dish: Model, dishId: number, count: number, levelIndex: number, rng: Random, goldenChance: number, folder: Folder): { BasePart }
	local kind = dish:GetAttribute("Kind")
	local anchor = dish:GetAttribute("Anchor")
	if typeof(anchor) ~= "CFrame" or typeof(kind) ~= "string" then
		warn("[DishFactory] ApplyGrime: dish is missing its Anchor/Kind attributes")
		return {}
	end
	local candidateFn = CANDIDATES[kind]
	if not candidateFn then
		return {}
	end

	local level = Config.GetLevel(levelIndex)
	local levelMult = level.Mult

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { dish }

	local placed: { BasePart } = {}
	count = math.max(1, count)

	for _ = 1, count do
		local hitPos, hitNormal = nil, nil
		for _attempt = 1, RAY_ATTEMPTS do
			local lo, ld = candidateFn(rng)
			if ld.Magnitude &gt; 1e-4 then
				local originWorld = localPos(anchor, lo.X, lo.Y, lo.Z)
				local dirWorld = localDir(anchor, ld.X, ld.Y, ld.Z).Unit * 40
				local result = workspace:Raycast(originWorld, dirWorld, params)
				if result then
					hitPos, hitNormal = result.Position, result.Normal
					break
				end
			end
		end
		if hitPos and hitNormal then
			local entry = Util.WeightedPick(level.Grime, "Weight", rng)
			local grimeType = Config.GrimeTypes[entry.Type]
			if grimeType then
				local golden = rng:NextNumber() &lt; goldenChance
				local size = rng:NextNumber(grimeType.Size[1], grimeType.Size[2])
				local hint = if math.abs(hitNormal:Dot(Vector3.new(0, 1, 0))) &gt; 0.9 then anchor.RightVector else Vector3.new(0, 1, 0)
				local cf = axisCFrame(hitPos + hitNormal * 0.05, hitNormal, hint)
				cf = cf * CFrame.Angles(rng:NextNumber() * math.pi * 2, 0, 0)

				local color = if golden then GOLDEN_COLOR else grimeType.Color
				local material = grimeType.Material

				local part: BasePart, children: { BasePart }
				if grimeType.Shape == "Crumbs" then
					part, children = shapeCrumbs(cf, size, color, material, rng)
				elseif grimeType.Shape == "Sprinkles" then
					part, children = shapeSprinkles(cf, size, color, material, rng)
				elseif grimeType.Shape == "Streak" then
					part, children = shapeStreak(cf, size, color, material)
				else
					part, children = shapeBlob(cf, size, color, material)
				end

				part.CanTouch = false
				part.CanQuery = true
				part.CastShadow = false
				part.CollisionGroup = "NoCollide"

				local hp = math.max(1, math.floor(grimeType.HP * levelMult + 0.5))
				local units = math.max(1, math.floor(grimeType.Units * levelMult + 0.5))
				local minTool = grimeType.MinTool
				if golden then
					units = math.floor(units * Config.Round.GoldenUnitsMult + 0.5)
					minTool = 1
					part.Material = if rng:NextNumber() &lt; 0.5 then Enum.Material.Neon else Enum.Material.Foil
					part.Color = GOLDEN_COLOR
					local attach = Instance.new("Attachment")
					attach.Parent = part
					local emitter = Instance.new("ParticleEmitter")
					emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
					emitter.Lifetime = NumberRange.new(0.5, 1.0)
					emitter.Rate = 6
					emitter.Speed = NumberRange.new(0.5, 1.5)
					emitter.Size = NumberSequence.new(0.4, 0)
					emitter.Color = ColorSequence.new(GOLDEN_COLOR)
					emitter.Parent = attach
				end

				part:SetAttribute("HP", hp)
				part:SetAttribute("MaxHP", hp)
				part:SetAttribute("Units", units)
				part:SetAttribute("Type", entry.Type)
				part:SetAttribute("DishId", dishId)
				part:SetAttribute("Golden", golden)
				part:SetAttribute("MinTool", minTool)
				part:SetAttribute("BaseSize", part.Size)

				for _, child in children do
					child.Parent = part
					child:SetAttribute("BaseSize", child.Size)
				end

				part.Parent = folder
				table.insert(placed, part)
			end
		end
	end

	return placed
end

----------------------------------------------------------------------------------------------------
-- SetGrimeHealth: cheap per-frame-ish update while a spot is being scrubbed.
----------------------------------------------------------------------------------------------------
function DishFactory.SetGrimeHealth(part: BasePart, fraction: number)
	fraction = math.clamp(fraction, 0, 1)
	local shrink = 0.55 + 0.45 * fraction
	local transparency = (1 - fraction) * 0.85

	local baseSize = part:GetAttribute("BaseSize")
	if typeof(baseSize) == "Vector3" then
		part.Size = baseSize * shrink
	end
	part.Transparency = transparency

	for _, child in part:GetChildren() do
		if child:IsA("BasePart") then
			local childBase = child:GetAttribute("BaseSize")
			if typeof(childBase) == "Vector3" then
				child.Size = childBase * shrink
			end
			child.Transparency = transparency
		end
	end
end

----------------------------------------------------------------------------------------------------
-- Sparkle: the finished-dish effect. Server-side so every client sees the same thing.
----------------------------------------------------------------------------------------------------
function DishFactory.Sparkle(dish: Model)
	if not dish or not dish.Parent then
		return
	end
	local root = dish.PrimaryPart or dish:FindFirstChildWhichIsA("BasePart")
	if not root then
		return
	end

	local ok = pcall(function()
		local highlight = Instance.new("Highlight")
		highlight.FillColor = Color3.new(1, 1, 1)
		highlight.FillTransparency = 0.3
		highlight.OutlineTransparency = 1
		highlight.Adornee = dish
		highlight.Parent = dish
		Debris:AddItem(highlight, 0.5)

		local attach = Instance.new("Attachment")
		attach.Parent = root
		local emitter = Instance.new("ParticleEmitter")
		emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		emitter.Lifetime = NumberRange.new(0.4, 0.9)
		emitter.Rate = 0
		emitter.Speed = NumberRange.new(2, 6)
		emitter.SpreadAngle = Vector2.new(180, 180)
		emitter.Size = NumberSequence.new(0.7, 0)
		emitter.Color = ColorSequence.new(Color3.new(1, 1, 1))
		emitter.Parent = attach
		emitter:Emit(24)
		Debris:AddItem(attach, 1.5)
	end)
	if not ok then
		warn("[DishFactory] Sparkle effect failed")
	end
end

return DishFactory</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000011"><Properties><string name="Name">LeaderboardService</string><ProtectedString name="Source">-- Lobby leaderboards: "Fastest Clean" (one board that cycles through the levels) and
-- "Most Dishes Cleaned".
--
--   * OrderedDataStores: RinseCycle_Fastest_L&lt;n&gt; holds best times in tenths of a second (ascending,
--     lower is better), RinseCycle_Dishes holds lifetime DishesCleaned (descending). Keys are
--     "u_" .. userId, the same as the profile store.
--   * Every REFRESH_INTERVAL seconds: write the online players' values (times only when they
--     improved, and only values that changed since this server last wrote them), read the top 10
--     of every store, and redraw.
--   * Offline (Studio without API access) the boards rank the players in this server instead.
--   * The Times board switches level every CYCLE_INTERVAL seconds, from cached rows.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))

local LobbyBuilder = require(script.Parent:WaitForChild("LobbyBuilder"))
local DataService = require(script.Parent:WaitForChild("DataService"))

local LeaderboardService = {}

----------------------------------------------------------------------------------------------------
-- Tunables
----------------------------------------------------------------------------------------------------

local REFRESH_INTERVAL = 120
local OFFLINE_REFRESH_INTERVAL = 10 -- offline boards are free to rebuild, so keep them fresh
local FIRST_REFRESH_DELAY = 8 -- give the first players' profiles a moment to load
local CYCLE_INTERVAL = 8
local TOP_N = 10
local KEY_PREFIX = "u_"
local ROW_HEIGHT = 34

local MEDALS = { "🥇", "🥈", "🥉" }
local ROW_COLORS = {
	Color3.fromRGB(255, 215, 90),
	Color3.fromRGB(220, 230, 240),
	Color3.fromRGB(240, 170, 110),
}

----------------------------------------------------------------------------------------------------
-- State
----------------------------------------------------------------------------------------------------

type Row = { Name: string, Value: number }

local levelCount = #Config.Levels
local timesTop: { [number]: { Row } } = {}
local dishesTop: { Row } = {}
local shownLevel = 1

local timeStores: { [number]: OrderedDataStore } = {}
local dishesStore: OrderedDataStore? = nil

-- What this server last wrote per user, so unchanged values aren't rewritten every refresh.
local writtenTimes: { [number]: { [number]: number } } = {}
local writtenDishes: { [number]: number } = {}
local nameCache: { [number]: string } = {}

----------------------------------------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------------------------------------

local function toTenths(seconds: number): number
	return math.max(1, math.floor(seconds * 10 + 0.5))
end

-- 753 tenths -&gt; "1:15.3"
local function formatTenths(tenths: number): string
	return string.format("%s.%d", Format.Time(tenths // 10), tenths % 10)
end

local function nameFor(userId: number): string
	local cached = nameCache[userId]
	if cached then
		return cached
	end
	local player = Players:GetPlayerByUserId(userId)
	if player then
		nameCache[userId] = player.Name
		return player.Name
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	if ok and type(name) == "string" then
		nameCache[userId] = name
		return name
	end
	return "Player " .. tostring(userId)
end

local function openStores(): boolean
	if dishesStore then
		return true
	end
	local ok = pcall(function()
		for i = 1, levelCount do
			timeStores[i] = DataStoreService:GetOrderedDataStore("RinseCycle_Fastest_L" .. i)
		end
		dishesStore = DataStoreService:GetOrderedDataStore("RinseCycle_Dishes")
	end)
	return ok and dishesStore ~= nil
end

----------------------------------------------------------------------------------------------------
-- Drawing
----------------------------------------------------------------------------------------------------

local function clearList(list: Frame)
	for _, child in list:GetChildren() do
		if not child:IsA("UIListLayout") then
			child:Destroy()
		end
	end
end

local function label(props: { [string]: any }, parent: Instance): TextLabel
	local lbl = Instance.new("TextLabel")
	lbl.BackgroundTransparency = 1
	lbl.Font = Enum.Font.FredokaOne
	lbl.TextScaled = true
	lbl.TextColor3 = Color3.new(1, 1, 1)
	for k, v in props do
		(lbl :: any)[k] = v
	end
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Color = Color3.fromRGB(10, 30, 60)
	stroke.Parent = lbl
	lbl.Parent = parent
	return lbl
end

local function drawRows(list: Frame, rows: { Row }, valueText: (number) -&gt; string, emptyText: string)
	clearList(list)
	if #rows == 0 then
		label({
			Name = "Empty",
			Size = UDim2.new(1, 0, 0, ROW_HEIGHT * 1.5),
			Text = emptyText,
			TextColor3 = Color3.fromRGB(190, 220, 245),
		}, list)
		return
	end
	for rank, row in rows do
		local frame = Instance.new("Frame")
		frame.Name = "Row" .. rank
		frame.LayoutOrder = rank
		frame.Size = UDim2.new(1, 0, 0, ROW_HEIGHT)
		frame.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
		frame.BackgroundTransparency = rank % 2 == 1 and 0.9 or 0.95
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 8)
		corner.Parent = frame

		local color = ROW_COLORS[rank] or Color3.new(1, 1, 1)
		label({
			Name = "Rank",
			Size = UDim2.new(0, 60, 1, -4),
			Position = UDim2.new(0, 4, 0, 2),
			Text = MEDALS[rank] or ("#" .. rank),
			TextColor3 = color,
		}, frame)
		label({
			Name = "Player",
			Size = UDim2.new(1, -230, 1, -4),
			Position = UDim2.new(0, 72, 0, 2),
			Text = row.Name,
			TextColor3 = color,
			TextXAlignment = Enum.TextXAlignment.Left,
		}, frame)
		label({
			Name = "Value",
			Size = UDim2.new(0, 150, 1, -4),
			Position = UDim2.new(1, -154, 0, 2),
			Text = valueText(row.Value),
			TextColor3 = color,
			TextXAlignment = Enum.TextXAlignment.Right,
		}, frame)
		frame.Parent = list
	end
end

local function drawTimes()
	local lobby = LobbyBuilder.GetLobby()
	if not lobby then
		return
	end
	local board = lobby.Boards.Times
	local level = Config.Levels[shownLevel]
	board.Title.Text = string.format("⏱️ Fastest Clean: %s %s", level.Icon, level.Name)
	drawRows(board.List, timesTop[shownLevel] or {}, formatTenths, "No clears yet!")
end

local function drawDishes()
	local lobby = LobbyBuilder.GetLobby()
	if not lobby then
		return
	end
	local board = lobby.Boards.Dishes
	board.Title.Text = "🍽️ Most Dishes Cleaned"
	drawRows(board.List, dishesTop, Format.Commas, "No dishes cleaned yet!")
end

----------------------------------------------------------------------------------------------------
-- Refresh
----------------------------------------------------------------------------------------------------

-- Offline: rank the players in this server from their in-memory profiles.
local function refreshOffline()
	for i = 1, levelCount do
		local rows: { Row } = {}
		for _, player in Players:GetPlayers() do
			local profile = DataService.Get(player)
			local best = profile and profile.BestTimes[i]
			if best and best &gt; 0 then
				table.insert(rows, { Name = player.Name, Value = toTenths(best) })
			end
		end
		table.sort(rows, function(a, b)
			return a.Value &lt; b.Value
		end)
		timesTop[i] = { table.unpack(rows, 1, math.min(#rows, TOP_N)) }
	end

	local rows: { Row } = {}
	for _, player in Players:GetPlayers() do
		local profile = DataService.Get(player)
		local dishes = profile and profile.Stats.DishesCleaned or 0
		if dishes &gt; 0 then
			table.insert(rows, { Name = player.Name, Value = dishes })
		end
	end
	table.sort(rows, function(a, b)
		return a.Value &gt; b.Value
	end)
	dishesTop = { table.unpack(rows, 1, math.min(#rows, TOP_N)) }
end

local function writeOnline()
	for _, player in Players:GetPlayers() do
		local profile = DataService.Get(player)
		if not profile then
			continue
		end
		local userId = player.UserId
		local key = KEY_PREFIX .. userId

		local written = writtenTimes[userId] or {}
		writtenTimes[userId] = written
		for i = 1, levelCount do
			local best = profile.BestTimes[i]
			local store = timeStores[i]
			if not best or best &lt;= 0 or not store then
				continue
			end
			local tenths = toTenths(best)
			if written[i] and written[i] &lt;= tenths then
				continue
			end
			local ok = pcall(function()
				(store :: any):UpdateAsync(key, function(old: any): number?
					if type(old) == "number" and old &lt;= tenths then
						return nil -- the stored time is already as good or better
					end
					return tenths
				end)
			end)
			if ok then
				written[i] = tenths
			end
		end

		local dishes = math.floor(profile.Stats.DishesCleaned or 0)
		if dishes &gt; 0 and writtenDishes[userId] ~= dishes and dishesStore then
			local store = dishesStore :: OrderedDataStore
			local ok = pcall(function()
				store:SetAsync(key, dishes)
			end)
			if ok then
				writtenDishes[userId] = dishes
			end
		end
	end
end

-- Returns nil if the read failed, so the board keeps its last good rows.
local function readTop(store: OrderedDataStore, ascending: boolean): { Row }?
	local ok, entries = pcall(function()
		local pages = store:GetSortedAsync(ascending, TOP_N)
		return pages:GetCurrentPage()
	end)
	if not ok or type(entries) ~= "table" then
		return nil
	end
	local rows: { Row } = {}
	for _, entry in entries do
		local userId = tonumber((string.match(tostring(entry.key), "^" .. KEY_PREFIX .. "(%d+)$")))
		local value = tonumber(entry.value)
		if userId and value and value &gt; 0 then
			table.insert(rows, { Name = nameFor(userId), Value = value })
		end
	end
	return rows
end

local function refreshOnline()
	writeOnline()
	for i = 1, levelCount do
		local store = timeStores[i]
		local rows = store and readTop(store, true)
		if rows then
			timesTop[i] = rows
		end
	end
	if dishesStore then
		local rows = readTop(dishesStore, false)
		if rows then
			dishesTop = rows
		end
	end
end

----------------------------------------------------------------------------------------------------
-- Lifecycle
----------------------------------------------------------------------------------------------------

function LeaderboardService.Init()
	for i = 1, levelCount do
		timesTop[i] = {}
	end
end

function LeaderboardService.Start()
	if not LobbyBuilder.GetLobby() then
		warn(string.format("[%s] LeaderboardService: no lobby, boards disabled", Config.GameName))
		return
	end
	drawTimes()
	drawDishes()

	task.spawn(function()
		task.wait(FIRST_REFRESH_DELAY)
		while true do
			local offline = DataService.IsOffline() or not openStores()
			local ok, err = pcall(if offline then refreshOffline else refreshOnline)
			if not ok then
				warn(string.format("[%s] LeaderboardService refresh failed: %s", Config.GameName, tostring(err)))
			end
			drawTimes()
			drawDishes()
			task.wait(if offline then OFFLINE_REFRESH_INTERVAL else REFRESH_INTERVAL)
		end
	end)

	task.spawn(function()
		while true do
			task.wait(CYCLE_INTERVAL)
			shownLevel = shownLevel % levelCount + 1
			drawTimes()
		end
	end)
end

return LeaderboardService</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000012"><Properties><string name="Name">LobbyBuilder</string><ProtectedString name="Source">-- LobbyBuilder: builds the entire lobby world at boot (a giant, bright kitchen seen from the point
-- of view of a tiny water-person). Nothing here is an uploaded asset: every part is primitives.
--
-- Layout (floor top at Y = 0, centred on Config.World.LobbyOrigin):
--   CENTRE  a round spawn plaza with the SpawnLocations (built FIRST) and a fountain/tap centrepiece
--   NORTH   a giant stainless dishwasher facade built into the cabinet run, with the game's title
--   (row)   the party pads, in front of the dishwasher
--   WEST    the Soap Shop (perks)
--   EAST    the Egg Hatchery (pets) + a Pet Stand
--   SOUTH   the two leaderboard boards + a How to Play board
-- A perimeter of giant kitchen cabinets (with invisible barrier walls behind them) rings the floor.
--
-- Build() is the only entry point that creates anything; GetLobby()/GetSpawnCFrame() just read back
-- what was built. It has no server-side dependencies (see DESIGN.md's dependency graph), so other
-- services require it, never the other way around.

local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))

local LobbyBuilder = {}

----------------------------------------------------------------------------------------------------
-- Types (mirrors DESIGN.md section 5; other services copy these shapes rather than requiring us for
-- them, but exporting is harmless and helps anyone who does).
----------------------------------------------------------------------------------------------------
export type PadGui = { Count: TextLabel, Title: TextLabel, Status: TextLabel, Privacy: TextLabel }
export type PadInfo = {
	Id: number,
	Model: Model,
	Zone: BasePart,
	Floor: BasePart,
	Inside: CFrame,
	Exit: CFrame,
	Barriers: { BasePart },
	Gui: PadGui,
}
export type BoardInfo = { Part: BasePart, Title: TextLabel, List: Frame }
export type Lobby = {
	Model: Model,
	Pads: { PadInfo },
	Boards: { Times: BoardInfo, Dishes: BoardInfo },
}

----------------------------------------------------------------------------------------------------
-- Layout constants
----------------------------------------------------------------------------------------------------
local ORIGIN = Config.World.LobbyOrigin

local FLOOR_X, FLOOR_Z = 300, 260
local TILE = 20
local NORTH_Z = ORIGIN.Z - FLOOR_Z / 2 -- -130
local SOUTH_Z = ORIGIN.Z + FLOOR_Z / 2 -- 130
local WEST_X = ORIGIN.X - FLOOR_X / 2 -- -150
local EAST_X = ORIGIN.X + FLOOR_X / 2 -- 150

local BARRIER_HEIGHT = 150
local MAIN_FLOOR_Y = 0 -- top of the main checkered floor

local PAD_COUNT = Config.Party.PadCount
local PAD_SIZE = 16
local PAD_Z = -85
local PAD_SPACING = 40
local PAD_WALL_HEIGHT = 10
local PAD_FLOOR_Y = 0.3 -- top of a pad's glowing floor

local DISHWASHER_WIDTH = 150
local DISHWASHER_HEIGHT = 70

-- Colors
local TILE_A = Color3.fromRGB(255, 255, 255)
local TILE_B = Color3.fromRGB(203, 233, 238)
local CABINET_BODY = Color3.fromRGB(232, 243, 248)
local CABINET_DOOR = Color3.fromRGB(207, 224, 235)
local CABINET_HANDLE = Color3.fromRGB(214, 218, 222)
local COUNTER_COLOR = Color3.fromRGB(255, 255, 255)
local STEEL = Color3.fromRGB(198, 203, 209)

----------------------------------------------------------------------------------------------------
-- Build bookkeeping: a soft ~2500-part budget, yielding every ~200 parts so the server never hitches.
----------------------------------------------------------------------------------------------------
local lobby: Lobby? = nil
local partsBuilt = 0

local function maybeYield()
	partsBuilt += 1
	if partsBuilt % 200 == 0 then
		task.wait()
	end
end

-- Creates a BasePart (or SpawnLocation), applies props, parents last, and counts toward the budget.
local function mkPart(className: string, props: { [string]: any }, parent: Instance): BasePart
	local inst = Instance.new(className) :: BasePart
	inst.Anchored = true
	if props.CanCollide == nil then
		inst.CanCollide = true
	end
	if props.CanTouch == nil then
		inst.CanTouch = false
	end
	if props.CastShadow == nil then
		inst.CastShadow = true
	end
	for k, v in props do
		(inst :: any)[k] = v
	end
	inst.Parent = parent
	maybeYield()
	return inst :: BasePart
end

-- Non-part instances (GUIs, lights, particles, models, folders...) don't count toward the budget.
local function mk(className: string, props: { [string]: any }?, parent: Instance?): Instance
	local inst = Instance.new(className)
	if props then
		for k, v in props do
			(inst :: any)[k] = v
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

----------------------------------------------------------------------------------------------------
-- Floor: a checkerboard of ~20-stud CeramicTiles in two soft tones.
----------------------------------------------------------------------------------------------------
local function buildFloor(parent: Instance)
	local tilesX = math.floor(FLOOR_X / TILE)
	local tilesZ = math.floor(FLOOR_Z / TILE)
	for ix = 0, tilesX - 1 do
		for iz = 0, tilesZ - 1 do
			local cx = WEST_X + TILE * (ix + 0.5)
			local cz = NORTH_Z + TILE * (iz + 0.5)
			local light = (ix + iz) % 2 == 0
			mkPart("Part", {
				Name = "Tile",
				Size = Vector3.new(TILE, 1, TILE),
				CFrame = CFrame.new(cx, MAIN_FLOOR_Y - 0.5, cz),
				Color = light and TILE_A or TILE_B,
				Material = Enum.Material.CeramicTiles,
				CanQuery = false,
			}, parent)
		end
	end
end

----------------------------------------------------------------------------------------------------
-- Perimeter kitchen cabinets: a run of modules (body + door + handle) along a wall, a countertop
-- slab with overhang, and a tiled backsplash above. `skip` cuts a gap for something built into the
-- wall (only the north wall's dishwasher needs this).
----------------------------------------------------------------------------------------------------
type Skip = { min: number, max: number }

local MODULE = 10
local CABINET_DEPTH = 6
local CABINET_HEIGHT = 34
local COUNTER_HEIGHT = 2
local COUNTER_OVERHANG = 1.5
local BACKSPLASH_HEIGHT = 6

-- wallZ: the outer Z of the wall. faceDir: +1 or -1, the direction the cabinets face into the room.
local function buildWallNS(parent: Instance, wallZ: number, faceDir: number, length: number, skip: Skip?)
	local innerZ = wallZ + faceDir * CABINET_DEPTH / 2
	local startX = ORIGIN.X - length / 2
	local count = math.floor(length / MODULE)

	local function inSkip(x: number): boolean
		return skip ~= nil and x &gt; skip.min and x &lt; skip.max
	end

	for i = 0, count - 1 do
		local cx = startX + MODULE * (i + 0.5)
		if not inSkip(cx) then
			mkPart("Part", {
				Name = "CabinetBody",
				Size = Vector3.new(MODULE - 0.4, CABINET_HEIGHT, CABINET_DEPTH),
				CFrame = CFrame.new(cx, CABINET_HEIGHT / 2, innerZ),
				Color = CABINET_BODY,
				Material = Enum.Material.SmoothPlastic,
			}, parent)
			mkPart("Part", {
				Name = "CabinetDoor",
				Size = Vector3.new(MODULE - 1.2, CABINET_HEIGHT - 4, 0.3),
				CFrame = CFrame.new(cx, CABINET_HEIGHT / 2, innerZ + faceDir * (CABINET_DEPTH / 2 + 0.16)),
				Color = CABINET_DOOR,
				Material = Enum.Material.SmoothPlastic,
				CanCollide = false,
				CanQuery = false,
			}, parent)
			mkPart("Part", {
				Name = "Handle",
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(3, 0.4, 0.4),
				CFrame = CFrame.new(cx + MODULE * 0.28, CABINET_HEIGHT / 2, innerZ + faceDir * (CABINET_DEPTH / 2 + 0.35))
					* CFrame.Angles(0, 0, math.rad(90)),
				Color = CABINET_HANDLE,
				Material = Enum.Material.Metal,
				CanCollide = false,
				CanQuery = false,
			}, parent)
		end
	end

	local segments: { { number } } = {}
	if skip then
		if skip.min &gt; startX then
			table.insert(segments, { startX, skip.min })
		end
		if skip.max &lt; startX + length then
			table.insert(segments, { skip.max, startX + length })
		end
	else
		table.insert(segments, { startX, startX + length })
	end
	for _, seg in segments do
		local segLen = seg[2] - seg[1]
		local segCenter = (seg[1] + seg[2]) / 2
		if segLen &gt; 1 then
			mkPart("Part", {
				Name = "Countertop",
				Size = Vector3.new(segLen + COUNTER_OVERHANG, COUNTER_HEIGHT, CABINET_DEPTH + COUNTER_OVERHANG),
				CFrame = CFrame.new(segCenter, CABINET_HEIGHT + COUNTER_HEIGHT / 2, innerZ + faceDir * (COUNTER_OVERHANG / 2)),
				Color = COUNTER_COLOR,
				Material = Enum.Material.Marble,
			}, parent)
			mkPart("Part", {
				Name = "Backsplash",
				Size = Vector3.new(segLen, BACKSPLASH_HEIGHT, 0.4),
				CFrame = CFrame.new(segCenter, CABINET_HEIGHT + COUNTER_HEIGHT + BACKSPLASH_HEIGHT / 2, innerZ),
				Color = TILE_A,
				Material = Enum.Material.CeramicTiles,
				CanQuery = false,
			}, parent)
		end
	end
end

-- wallX: the outer X of the wall. faceDir: +1 or -1, the direction the cabinets face into the room.
local function buildWallEW(parent: Instance, wallX: number, faceDir: number, length: number)
	local innerX = wallX + faceDir * CABINET_DEPTH / 2
	local startZ = ORIGIN.Z - length / 2
	local count = math.floor(length / MODULE)

	for i = 0, count - 1 do
		local cz = startZ + MODULE * (i + 0.5)
		mkPart("Part", {
			Name = "CabinetBody",
			Size = Vector3.new(CABINET_DEPTH, CABINET_HEIGHT, MODULE - 0.4),
			CFrame = CFrame.new(innerX, CABINET_HEIGHT / 2, cz),
			Color = CABINET_BODY,
			Material = Enum.Material.SmoothPlastic,
		}, parent)
		mkPart("Part", {
			Name = "CabinetDoor",
			Size = Vector3.new(0.3, CABINET_HEIGHT - 4, MODULE - 1.2),
			CFrame = CFrame.new(innerX + faceDir * (CABINET_DEPTH / 2 + 0.16), CABINET_HEIGHT / 2, cz),
			Color = CABINET_DOOR,
			Material = Enum.Material.SmoothPlastic,
			CanCollide = false,
			CanQuery = false,
		}, parent)
		mkPart("Part", {
			Name = "Handle",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(3, 0.4, 0.4),
			CFrame = CFrame.new(innerX + faceDir * (CABINET_DEPTH / 2 + 0.35), CABINET_HEIGHT / 2, cz + MODULE * 0.28)
				* CFrame.Angles(math.rad(90), 0, 0),
			Color = CABINET_HANDLE,
			Material = Enum.Material.Metal,
			CanCollide = false,
			CanQuery = false,
		}, parent)
	end

	mkPart("Part", {
		Name = "Countertop",
		Size = Vector3.new(CABINET_DEPTH + COUNTER_OVERHANG, COUNTER_HEIGHT, length + COUNTER_OVERHANG),
		CFrame = CFrame.new(innerX + faceDir * (COUNTER_OVERHANG / 2), CABINET_HEIGHT + COUNTER_HEIGHT / 2, ORIGIN.Z),
		Color = COUNTER_COLOR,
		Material = Enum.Material.Marble,
	}, parent)
	mkPart("Part", {
		Name = "Backsplash",
		Size = Vector3.new(0.4, BACKSPLASH_HEIGHT, length),
		CFrame = CFrame.new(innerX, CABINET_HEIGHT + COUNTER_HEIGHT + BACKSPLASH_HEIGHT / 2, ORIGIN.Z),
		Color = TILE_A,
		Material = Enum.Material.CeramicTiles,
		CanQuery = false,
	}, parent)
end

----------------------------------------------------------------------------------------------------
-- Invisible barrier walls up to Y = 150, just past the cabinet run, so nobody can leave.
----------------------------------------------------------------------------------------------------
local function buildBarriers(parent: Instance)
	local thickness = 4
	local margin = CABINET_DEPTH + 2
	mkPart("Part", {
		Name = "BarrierNorth",
		Size = Vector3.new(FLOOR_X + thickness * 2, BARRIER_HEIGHT, thickness),
		CFrame = CFrame.new(ORIGIN.X, BARRIER_HEIGHT / 2, NORTH_Z - margin),
		Transparency = 1,
		CanQuery = false,
	}, parent)
	mkPart("Part", {
		Name = "BarrierSouth",
		Size = Vector3.new(FLOOR_X + thickness * 2, BARRIER_HEIGHT, thickness),
		CFrame = CFrame.new(ORIGIN.X, BARRIER_HEIGHT / 2, SOUTH_Z + margin),
		Transparency = 1,
		CanQuery = false,
	}, parent)
	mkPart("Part", {
		Name = "BarrierWest",
		Size = Vector3.new(thickness, BARRIER_HEIGHT, FLOOR_Z + thickness * 2),
		CFrame = CFrame.new(WEST_X - margin, BARRIER_HEIGHT / 2, ORIGIN.Z),
		Transparency = 1,
		CanQuery = false,
	}, parent)
	mkPart("Part", {
		Name = "BarrierEast",
		Size = Vector3.new(thickness, BARRIER_HEIGHT, FLOOR_Z + thickness * 2),
		CFrame = CFrame.new(EAST_X + margin, BARRIER_HEIGHT / 2, ORIGIN.Z),
		Transparency = 1,
		CanQuery = false,
	}, parent)
end

----------------------------------------------------------------------------------------------------
-- NORTH: the giant stainless dishwasher facade, built into the cabinet run's gap, with a glowing
-- control strip and the big "RINSE CYCLE" title sign.
----------------------------------------------------------------------------------------------------
local function buildDishwasherFacade(parent: Instance)
	local z = NORTH_Z + 0.15
	local cx, cy = ORIGIN.X, DISHWASHER_HEIGHT / 2

	mkPart("Part", {
		Name = "DishwasherFace",
		Size = Vector3.new(DISHWASHER_WIDTH, DISHWASHER_HEIGHT, 3),
		CFrame = CFrame.new(cx, cy, z),
		Color = STEEL,
		Material = Enum.Material.Metal,
	}, parent)
	mkPart("Part", {
		Name = "DoorTrim",
		Size = Vector3.new(DISHWASHER_WIDTH - 6, DISHWASHER_HEIGHT - 10, 0.4),
		CFrame = CFrame.new(cx, cy, z + 1.7),
		Color = Color3.fromRGB(168, 174, 180),
		Material = Enum.Material.DiamondPlate,
		CanCollide = false,
		CanQuery = false,
	}, parent)

	-- Control strip: a housing plus a row of glowing buttons.
	mkPart("Part", {
		Name = "ControlStrip",
		Size = Vector3.new(DISHWASHER_WIDTH * 0.7, 6, 1.5),
		CFrame = CFrame.new(cx, DISHWASHER_HEIGHT * 0.78, z + 1.2),
		Color = Color3.fromRGB(58, 63, 68),
		Material = Enum.Material.Metal,
		CanCollide = false,
		CanQuery = false,
	}, parent)
	local buttonColors = {
		Color3.fromRGB(120, 220, 255),
		Color3.fromRGB(255, 210, 90),
		Color3.fromRGB(120, 255, 150),
		Color3.fromRGB(255, 120, 150),
	}
	for i, color in buttonColors do
		local bx = cx - DISHWASHER_WIDTH * 0.32 + (i - 1) * 16
		mkPart("Part", {
			Name = "ControlButton",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(1.2, 3, 3),
			CFrame = CFrame.new(bx, DISHWASHER_HEIGHT * 0.78, z + 1.95) * CFrame.Angles(0, 0, math.rad(90)),
			Color = color,
			Material = Enum.Material.Neon,
			CanCollide = false,
			CanQuery = false,
		}, parent)
	end

	-- Title sign, mounted above the control strip.
	local signPart = mkPart("Part", {
		Name = "TitleSign",
		Size = Vector3.new(DISHWASHER_WIDTH * 0.62, DISHWASHER_HEIGHT * 0.34, 0.6),
		CFrame = CFrame.new(cx, DISHWASHER_HEIGHT * 0.88, z + 1.9),
		Color = Color3.fromRGB(40, 122, 192),
		Material = Enum.Material.SmoothPlastic,
		CanCollide = false,
		CanQuery = false,
	}, parent)
	local gui = mk("SurfaceGui", {
		Name = "TitleGui",
		Face = Enum.NormalId.Front,
		CanvasSize = Vector2.new(1024, 512),
		LightInfluence = 0,
	}, signPart)
	local titleLabel = mk("TextLabel", {
		Name = "Title",
		Size = UDim2.fromScale(1, 0.66),
		Position = UDim2.fromScale(0, 0.04),
		BackgroundTransparency = 1,
		Text = "RINSE CYCLE",
		Font = Enum.Font.FredokaOne,
		TextScaled = true,
		TextColor3 = Color3.fromRGB(255, 255, 255),
	}, gui) :: TextLabel
	mk("UIStroke", { Thickness = 8, Color = Color3.fromRGB(18, 58, 108) }, titleLabel)
	mk("UIGradient", {
		Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(190, 230, 255)),
		Rotation = 90,
	}, titleLabel)
	local subLabel = mk("TextLabel", {
		Name = "Subtitle",
		Size = UDim2.fromScale(1, 0.22),
		Position = UDim2.fromScale(0, 0.74),
		BackgroundTransparency = 1,
		Text = "Walk into a pad to start a party!",
		Font = Enum.Font.GothamBold,
		TextScaled = true,
		TextColor3 = Color3.fromRGB(255, 255, 255),
	}, gui) :: TextLabel
	mk("UIStroke", { Thickness = 3, Color = Color3.fromRGB(18, 58, 108) }, subLabel)
end

----------------------------------------------------------------------------------------------------
-- CENTRE: the spawn plaza (a giant plate) with the SpawnLocations. Built before anything else in
-- Build() so a player who spawns while the rest of the lobby is still going up has a floor.
----------------------------------------------------------------------------------------------------
local function buildSpawnPlaza(parent: Instance): { SpawnLocation }
	mkPart("Part", {
		Name = "SpawnPlate",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(2, 80, 80),
		CFrame = CFrame.new(ORIGIN.X, 0.5, ORIGIN.Z) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(250, 250, 248),
		Material = Enum.Material.SmoothPlastic,
	}, parent)
	mkPart("Part", {
		Name = "SpawnPlateRim",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.7, 82, 82),
		CFrame = CFrame.new(ORIGIN.X, 1.35, ORIGIN.Z) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(130, 190, 235),
		Material = Enum.Material.SmoothPlastic,
		CanCollide = false,
		CanQuery = false,
	}, parent)

	local spawns: { SpawnLocation } = {}
	local count = 6
	local radius = 26
	for i = 1, count do
		local angle = (i - 1) / count * math.pi * 2
		local pos = Vector3.new(ORIGIN.X + math.cos(angle) * radius, 1.6, ORIGIN.Z + math.sin(angle) * radius)
		local sp = mkPart("SpawnLocation", {
			Name = "Spawn" .. i,
			Size = Vector3.new(6, 1, 6),
			CFrame = CFrame.new(pos, pos + Vector3.new(0, 0, -10)),
			Neutral = true,
			Duration = 0,
			Transparency = 1,
			CanCollide = true,
			CanQuery = false,
		}, parent) :: SpawnLocation
		table.insert(spawns, sp)
	end
	return spawns
end

----------------------------------------------------------------------------------------------------
-- Centrepiece: a giant chrome tap arching over a basin, with a translucent water column and rising
-- bubbles (a cheap ParticleEmitter, not physics).
----------------------------------------------------------------------------------------------------
local function buildFountain(parent: Instance)
	local cx, cz = ORIGIN.X, ORIGIN.Z
	local tapColor = Color3.fromRGB(226, 229, 233)

	mkPart("Part", {
		Name = "Basin",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(3, 22, 22),
		CFrame = CFrame.new(cx, 1.5, cz) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(225, 240, 250),
		Material = Enum.Material.Marble,
	}, parent)
	mkPart("Part", {
		Name = "BasinRim",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(1.5, 23, 23),
		CFrame = CFrame.new(cx, 3, cz) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(255, 255, 255),
		Material = Enum.Material.SmoothPlastic,
		CanCollide = false,
		CanQuery = false,
	}, parent)
	mkPart("Part", {
		Name = "Pedestal",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(20, 6, 6),
		CFrame = CFrame.new(cx, 13, cz) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(210, 215, 220),
		Material = Enum.Material.Metal,
	}, parent)

	-- The arch: a chain of small cylinder segments tracing a semicircle from the pedestal up and over.
	local archRadius = 9
	local segs = 8
	for i = 0, segs do
		local t = i / segs
		local angle = math.rad(180 * t)
		local px = cx - archRadius * math.cos(angle)
		local py = 16 + archRadius * math.sin(angle)
		mkPart("Part", {
			Name = "TapSeg" .. i,
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(1.6, 1.6, 1.6),
			CFrame = CFrame.new(px, py, cz),
			Color = tapColor,
			Material = Enum.Material.Metal,
			CanCollide = false,
			CanQuery = false,
		}, parent)
	end
	local spoutPos = Vector3.new(cx + archRadius, 16, cz)
	mkPart("Part", {
		Name = "Spout",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(2, 1.4, 1.4),
		CFrame = CFrame.new(spoutPos) * CFrame.Angles(0, 0, math.rad(90)),
		Color = tapColor,
		Material = Enum.Material.Metal,
		CanCollide = false,
		CanQuery = false,
	}, parent)

	local waterTop, waterBottom = 15.5, 3.2
	local water = mkPart("Part", {
		Name = "WaterColumn",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(waterTop - waterBottom, 3, 3),
		CFrame = CFrame.new(spoutPos.X, (waterTop + waterBottom) / 2, spoutPos.Z) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(150, 220, 255),
		Material = Enum.Material.Glass,
		Transparency = 0.35,
		CanCollide = false,
		CanQuery = false,
		CastShadow = false,
	}, parent)

	mk("ParticleEmitter", {
		Texture = "rbxasset://textures/particles/forcefield_glow_main.dds",
		Color = ColorSequence.new(Color3.fromRGB(255, 255, 255)),
		Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.6),
			NumberSequenceKeypoint.new(1, 0.1),
		}),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.3),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Lifetime = NumberRange.new(1.5, 2.5),
		Rate = 12,
		Speed = NumberRange.new(1, 2),
		SpreadAngle = Vector2.new(20, 20),
		Acceleration = Vector3.new(0, 4, 0),
		EmissionDirection = Enum.NormalId.Top,
	}, water)
end

----------------------------------------------------------------------------------------------------
-- Party pads: 6 in a row in front of the dishwasher. Each is a glowing floor, 4 glass walls with an
-- entrance arch on the +Z side (which faces the lobby centre), a billboard, and an invisible Zone.
-- Inside faces +Z; Exit is further along +Z, out past the archway.
----------------------------------------------------------------------------------------------------
local function buildPad(parent: Instance, id: number): PadInfo
	local totalWidth = (PAD_COUNT - 1) * PAD_SPACING
	local cx = ORIGIN.X - totalWidth / 2 + (id - 1) * PAD_SPACING
	local cz = PAD_Z
	local half = PAD_SIZE / 2

	local model = mk("Model", { Name = "Pad" .. id }, parent) :: Model

	local floor = mkPart("Part", {
		Name = "Floor",
		Size = Vector3.new(PAD_SIZE, 0.3, PAD_SIZE),
		CFrame = CFrame.new(cx, 0.15, cz),
		Color = Color3.fromRGB(125, 195, 255),
		Material = Enum.Material.Neon,
		CanQuery = false,
	}, model)
	mkPart("Part", {
		Name = "Rim",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.6, PAD_SIZE + 1, PAD_SIZE + 1),
		CFrame = CFrame.new(cx, 0.05, cz) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(255, 255, 255),
		Material = Enum.Material.Neon,
		Transparency = 0.35,
		CanCollide = false,
		CanQuery = false,
	}, model)

	local barriers: { BasePart } = {}
	local wallSpecs = {
		{ name = "BarrierBack", size = Vector3.new(PAD_SIZE, PAD_WALL_HEIGHT, 0.6), offset = Vector3.new(0, 0, -half) },
		{ name = "BarrierLeft", size = Vector3.new(0.6, PAD_WALL_HEIGHT, PAD_SIZE), offset = Vector3.new(-half, 0, 0) },
		{ name = "BarrierRight", size = Vector3.new(0.6, PAD_WALL_HEIGHT, PAD_SIZE), offset = Vector3.new(half, 0, 0) },
		-- The +Z (entrance) side is two stub walls either side of an archway, not a full wall.
		{ name = "BarrierFrontL", size = Vector3.new(PAD_SIZE * 0.32, PAD_WALL_HEIGHT, 0.6), offset = Vector3.new(-half * 0.68, 0, half) },
		{ name = "BarrierFrontR", size = Vector3.new(PAD_SIZE * 0.32, PAD_WALL_HEIGHT, 0.6), offset = Vector3.new(half * 0.68, 0, half) },
	}
	for _, spec in wallSpecs do
		local b = mkPart("Part", {
			Name = spec.name,
			Size = spec.size,
			CFrame = CFrame.new(cx + spec.offset.X, PAD_WALL_HEIGHT / 2, cz + spec.offset.Z),
			Material = Enum.Material.Glass,
			Color = Color3.fromRGB(200, 230, 255),
			Transparency = 0.8,
			CanCollide = true,
			CanTouch = false,
			CollisionGroup = "PadBarrier",
		}, model)
		table.insert(barriers, b)
	end
	-- Arch frame + corner posts over the entrance.
	mkPart("Part", {
		Name = "ArchFrame",
		Size = Vector3.new(PAD_SIZE * 0.72, 1, 1),
		CFrame = CFrame.new(cx, PAD_WALL_HEIGHT, cz + half),
		Color = Color3.fromRGB(255, 255, 255),
		Material = Enum.Material.SmoothPlastic,
		CanCollide = false,
		CanQuery = false,
	}, model)
	for _, sx in { -1, 1 } do
		mkPart("Part", {
			Name = "Post",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(PAD_WALL_HEIGHT, 1, 1),
			CFrame = CFrame.new(cx + sx * half, PAD_WALL_HEIGHT / 2, cz + half) * CFrame.Angles(0, 0, math.rad(90)),
			Color = Color3.fromRGB(255, 255, 255),
			Material = Enum.Material.SmoothPlastic,
			CanCollide = false,
			CanQuery = false,
		}, model)
	end

	local zone = mkPart("Part", {
		Name = "Zone",
		Size = Vector3.new(PAD_SIZE - 1, 12, PAD_SIZE - 1),
		CFrame = CFrame.new(cx, 6, cz),
		Transparency = 1,
		CanCollide = false,
		CanTouch = false,
		CanQuery = false,
	}, model)

	-- Billboard, floating over the pad.
	local guiAnchor = mkPart("Part", {
		Name = "GuiAnchor",
		Size = Vector3.new(1, 1, 1),
		CFrame = CFrame.new(cx, PAD_WALL_HEIGHT + 3, cz),
		Transparency = 1,
		CanCollide = false,
		CanTouch = false,
		CanQuery = false,
	}, model)
	local billboard = mk("BillboardGui", {
		Name = "PadGui",
		Size = UDim2.fromOffset(220, 112),
		StudsOffset = Vector3.new(0, 2, 0),
		MaxDistance = 160,
		AlwaysOnTop = true,
	}, guiAnchor)
	local bg = mk("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(11, 37, 69),
		BackgroundTransparency = 0.25,
	}, billboard) :: Frame
	mk("UICorner", { CornerRadius = UDim.new(0, 12) }, bg)
	mk("UIStroke", { Thickness = 2, Color = Color3.fromRGB(255, 255, 255), Transparency = 0.4 }, bg)
	local titleLbl = mk("TextLabel", {
		Name = "Title",
		Size = UDim2.new(1, 0, 0, 28),
		Position = UDim2.new(0, 0, 0, 4),
		BackgroundTransparency = 1,
		Text = "Party Pad",
		Font = Enum.Font.FredokaOne,
		TextScaled = true,
		TextColor3 = Color3.new(1, 1, 1),
	}, bg) :: TextLabel
	local countLbl = mk("TextLabel", {
		Name = "Count",
		Size = UDim2.new(1, 0, 0, 32),
		Position = UDim2.new(0, 0, 0, 32),
		BackgroundTransparency = 1,
		Text = "0/4",
		Font = Enum.Font.FredokaOne,
		TextScaled = true,
		TextColor3 = Color3.fromRGB(255, 230, 120),
	}, bg) :: TextLabel
	local statusLbl = mk("TextLabel", {
		Name = "Status",
		Size = UDim2.new(1, 0, 0, 28),
		Position = UDim2.new(0, 0, 0, 64),
		BackgroundTransparency = 1,
		Text = "Walk in to start a party!",
		Font = Enum.Font.GothamBold,
		TextScaled = true,
		TextWrapped = true,
		TextColor3 = Color3.fromRGB(220, 235, 255),
	}, bg) :: TextLabel
	local privacyLbl = mk("TextLabel", {
		Name = "Privacy",
		Size = UDim2.new(1, 0, 0, 18),
		Position = UDim2.new(0, 0, 0, 92),
		BackgroundTransparency = 1,
		Text = "",
		Font = Enum.Font.GothamBold,
		TextScaled = true,
		TextColor3 = Color3.fromRGB(190, 210, 230),
	}, bg) :: TextLabel

	local insidePos = Vector3.new(cx, PAD_FLOOR_Y, cz)
	local exitPos = Vector3.new(cx, MAIN_FLOOR_Y, cz + 14)

	return {
		Id = id,
		Model = model,
		Zone = zone,
		Floor = floor,
		Inside = CFrame.new(insidePos, insidePos + Vector3.new(0, 0, 1)),
		Exit = CFrame.new(exitPos, exitPos + Vector3.new(0, 0, 1)),
		Barriers = barriers,
		Gui = { Count = countLbl, Title = titleLbl, Status = statusLbl, Privacy = privacyLbl },
	}
end

----------------------------------------------------------------------------------------------------
-- WEST: the Soap Shop. A giant pump-bottle "building" behind a counter with the perks prompt.
----------------------------------------------------------------------------------------------------
local function buildSoapShop(parent: Instance)
	local x = WEST_X + 22
	local z = ORIGIN.Z - 10

	local counter = mkPart("Part", {
		Name = "Counter",
		Size = Vector3.new(14, 4, 8),
		CFrame = CFrame.new(x, 2, z),
		Color = Color3.fromRGB(255, 255, 255),
		Material = Enum.Material.SmoothPlastic,
	}, parent)
	mkPart("Part", {
		Name = "CounterTop",
		Size = Vector3.new(15, 0.6, 9),
		CFrame = CFrame.new(x, 4.3, z),
		Color = Color3.fromRGB(120, 200, 255),
		Material = Enum.Material.Neon,
		CanQuery = false,
	}, parent)

	local bottleX, bottleZ = x, z - 10
	mkPart("Part", {
		Name = "BottleBody",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(26, 10, 10),
		CFrame = CFrame.new(bottleX, 13, bottleZ) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(150, 220, 255),
		Material = Enum.Material.Glass,
		Transparency = 0.15,
	}, parent)
	mkPart("Part", {
		Name = "BottleCap",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(6, 6, 6),
		CFrame = CFrame.new(bottleX, 26, bottleZ) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(255, 255, 255),
		Material = Enum.Material.SmoothPlastic,
	}, parent)
	mkPart("Part", {
		Name = "PumpNeck",
		Size = Vector3.new(1.4, 6, 1.4),
		CFrame = CFrame.new(bottleX + 1, 30, bottleZ),
		Color = Color3.fromRGB(220, 220, 225),
		Material = Enum.Material.Metal,
		CanCollide = false,
		CanQuery = false,
	}, parent)
	mkPart("Part", {
		Name = "PumpHead",
		Size = Vector3.new(4, 1.4, 1.4),
		CFrame = CFrame.new(bottleX + 3, 33.5, bottleZ),
		Color = Color3.fromRGB(255, 120, 170),
		Material = Enum.Material.SmoothPlastic,
		CanCollide = false,
		CanQuery = false,
	}, parent)

	local signPart = mkPart("Part", {
		Name = "ShopSign",
		Size = Vector3.new(20, 6, 0.6),
		CFrame = CFrame.new(x, 22, z + 5),
		Color = Color3.fromRGB(255, 255, 255),
		Material = Enum.Material.SmoothPlastic,
		CanCollide = false,
		CanQuery = false,
	}, parent)
	local gui = mk("SurfaceGui", { Face = Enum.NormalId.Front, CanvasSize = Vector2.new(512, 150), LightInfluence = 0 }, signPart)
	local signLbl = mk("TextLabel", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "🧴 SOAP SHOP",
		Font = Enum.Font.FredokaOne,
		TextScaled = true,
		TextColor3 = Color3.fromRGB(20, 110, 190),
	}, gui) :: TextLabel
	mk("UIStroke", { Thickness = 4, Color = Color3.fromRGB(255, 255, 255) }, signLbl)

	local prompt = mk("ProximityPrompt", {
		ActionText = "Open Shop",
		ObjectText = "Soap Shop",
		RequiresLineOfSight = false,
		HoldDuration = 0,
		MaxActivationDistance = 12,
	}, counter) :: ProximityPrompt
	prompt:SetAttribute("OpenWindow", "Shop")
end

----------------------------------------------------------------------------------------------------
-- EAST: the Egg Hatchery (one pedestal per Config.Eggs entry) and a small Pet Stand.
----------------------------------------------------------------------------------------------------
local function fallbackEggModel(egg: any): Model
	local m = Instance.new("Model")
	m.Name = "Egg_" .. tostring(egg.Id)
	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.new(6, 8, 6)
	root.Color = egg.Color
	root.Material = Enum.Material.SmoothPlastic
	root.Anchored = true
	root.CanCollide = false
	root.CanTouch = false
	root.CanQuery = false
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Scale = Vector3.new(1, 1.35, 1)
	mesh.Parent = root
	root.Parent = m
	m.PrimaryPart = root
	return m
end

local function buildEggHatchery(parent: Instance)
	local x = EAST_X - 22

	mkPart("Part", {
		Name = "CartonBase",
		Size = Vector3.new(10, 2, 60),
		CFrame = CFrame.new(x, 1, ORIGIN.Z),
		Color = Color3.fromRGB(220, 195, 150),
		Material = Enum.Material.WoodPlanks,
	}, parent)
	mkPart("Part", {
		Name = "CartonBackWall",
		Size = Vector3.new(2, 8, 60),
		CFrame = CFrame.new(x + 5, 5, ORIGIN.Z),
		Color = Color3.fromRGB(220, 195, 150),
		Material = Enum.Material.WoodPlanks,
		CanCollide = false,
		CanQuery = false,
	}, parent)

	local petModelsOk, PetModels = pcall(function()
		return require(Shared:WaitForChild("PetModels"))
	end)

	local eggs = Config.Eggs
	local n = #eggs
	local spacing = 55 / math.max(n, 1)
	for i, egg in eggs do
		local ez = ORIGIN.Z - 27.5 + (i - 1) * spacing + spacing / 2

		mkPart("Part", {
			Name = "EggCup" .. i,
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(3, 5, 5),
			CFrame = CFrame.new(x - 3, 4.5, ez) * CFrame.Angles(0, 0, math.rad(90)),
			Color = egg.Color,
			Material = Enum.Material.SmoothPlastic,
		}, parent)

		local eggModel: Model? = nil
		if petModelsOk then
			local ok2, result = pcall((PetModels :: any).Egg, egg.Id)
			if ok2 and typeof(result) == "Instance" then
				eggModel = result :: Model
			end
		end
		if not eggModel then
			eggModel = fallbackEggModel(egg)
		end
		local model = eggModel :: Model
		model.Parent = parent
		pcall(function()
			model:PivotTo(CFrame.new(x - 3, 10, ez))
		end)
		for _, d in model:GetDescendants() do
			if d:IsA("BasePart") then
				d.Anchored = true
				d.CanCollide = false
				d.CanTouch = false
				d.CanQuery = false
				maybeYield()
			end
		end

		local anchor = mkPart("Part", {
			Name = "EggGuiAnchor" .. i,
			Size = Vector3.new(1, 1, 1),
			CFrame = CFrame.new(x - 3, 16, ez),
			Transparency = 1,
			CanCollide = false,
			CanTouch = false,
			CanQuery = false,
		}, parent)
		local billboard = mk("BillboardGui", {
			Size = UDim2.fromOffset(200, 96),
			StudsOffset = Vector3.new(0, 1, 0),
			MaxDistance = 100,
			AlwaysOnTop = true,
		}, anchor)
		local bg = mk("Frame", {
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = Color3.fromRGB(11, 37, 69),
			BackgroundTransparency = 0.25,
		}, billboard)
		mk("UICorner", { CornerRadius = UDim.new(0, 10) }, bg)
		mk("TextLabel", {
			Size = UDim2.new(1, 0, 0, 26),
			BackgroundTransparency = 1,
			Text = egg.Name,
			Font = Enum.Font.FredokaOne,
			TextScaled = true,
			TextColor3 = Color3.new(1, 1, 1),
		}, bg)
		mk("TextLabel", {
			Size = UDim2.new(1, 0, 0, 24),
			Position = UDim2.new(0, 0, 0, 28),
			BackgroundTransparency = 1,
			Text = "🫧 " .. tostring(egg.Cost),
			Font = Enum.Font.GothamBold,
			TextScaled = true,
			TextColor3 = Color3.fromRGB(255, 210, 120),
		}, bg)
		if egg.RequiredLevel and egg.RequiredLevel &gt; 1 then
			mk("TextLabel", {
				Size = UDim2.new(1, 0, 0, 20),
				Position = UDim2.new(0, 0, 0, 56),
				BackgroundTransparency = 1,
				Text = "Unlocks at Level " .. tostring(egg.RequiredLevel),
				Font = Enum.Font.GothamBold,
				TextScaled = true,
				TextColor3 = Color3.fromRGB(255, 150, 150),
			}, bg)
		end

		local promptPart = mkPart("Part", {
			Name = "EggPromptPart" .. i,
			Size = Vector3.new(4, 1, 4),
			CFrame = CFrame.new(x - 3, 7.2, ez),
			Transparency = 1,
			CanCollide = false,
			CanTouch = false,
		}, parent)
		local prompt = mk("ProximityPrompt", {
			ActionText = "Hatch",
			ObjectText = egg.Name,
			RequiresLineOfSight = false,
			HoldDuration = 0,
			MaxActivationDistance = 12,
		}, promptPart) :: ProximityPrompt
		prompt:SetAttribute("OpenWindow", "Eggs")
		prompt:SetAttribute("EggId", egg.Id)
	end

	local standX, standZ = x, ORIGIN.Z + 34
	mkPart("Part", {
		Name = "PetStandBase",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(4, 8, 8),
		CFrame = CFrame.new(standX, 2, standZ) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(255, 220, 240),
		Material = Enum.Material.SmoothPlastic,
	}, parent)
	local standSign = mkPart("Part", {
		Name = "PetStandSign",
		Size = Vector3.new(6, 4, 0.4),
		CFrame = CFrame.new(standX, 8, standZ),
		Color = Color3.fromRGB(255, 255, 255),
		CanCollide = false,
		CanQuery = false,
	}, parent)
	local sgui = mk("SurfaceGui", { Face = Enum.NormalId.Front, CanvasSize = Vector2.new(200, 120), LightInfluence = 0 }, standSign)
	mk("TextLabel", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "🐾 Pet Stand",
		Font = Enum.Font.FredokaOne,
		TextScaled = true,
		TextColor3 = Color3.fromRGB(255, 120, 180),
	}, sgui)
	local standPromptPart = mkPart("Part", {
		Name = "PetStandPromptPart",
		Size = Vector3.new(4, 1, 4),
		CFrame = CFrame.new(standX, 4.5, standZ),
		Transparency = 1,
		CanCollide = false,
		CanTouch = false,
	}, parent)
	local standPrompt = mk("ProximityPrompt", {
		ActionText = "My Pets",
		ObjectText = "Pet Stand",
		RequiresLineOfSight = false,
		HoldDuration = 0,
		MaxActivationDistance = 12,
	}, standPromptPart) :: ProximityPrompt
	standPrompt:SetAttribute("OpenWindow", "Pets")
end

