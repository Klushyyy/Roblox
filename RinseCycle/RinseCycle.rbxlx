Config.DevProducts = {
	{ Key = "Bubbles1", Id = 0, Price = 19, Kind = "Bubbles", Amount = 250, Name = "Handful of Bubbles", Icon = "🧼" },
	{ Key = "Bubbles2", Id = 0, Price = 49, Kind = "Bubbles", Amount = 800, Name = "Bucket of Bubbles", Icon = "🧼" },
