<Item class="ModuleScript" referent="RBX0000000E"><Properties><string name="Name">ArenaBuilder</string><ProtectedString name="Source">-- ArenaBuilder: builds one dishwasher ("arena") for a run, sitting in a family kitchen, and lays out
-- the load of dirty dishes inside it. RoundService calls Build(slot, levelIndex, options) once per
-- run and Destroy(arena) when the run ends; nothing else touches workspace.Arenas directly.
--
-- Coordinate convention ("arena space"): every builder helper below works in local offsets
-- (x = sideways, y = up, z = depth) measured from `origin` (the tub floor centre, see SlotOrigin).
-- `origin.LookVector` points from the door toward the back wall, so +z is "into the tub" and the
-- open door and the rest of the kitchen are at -z.
--
-- The dishwasher is sized so a ~5 stud character is a tiny person inside a real machine:
--   * tub interior X +-56, Z -50..62, 100 tall; the open door lies flat in front (Z -50..-121)
--   * bottom rack floor at Y 4: three rows of standing plates, pans/pots and a cutlery basket
--   * top rack floor at Y 50: tilted bowls, upturned mugs and glasses
--   * bubble-lift pads (tag "LiftPad", attribute LiftTo) carry you up; a chute on the top rack
--     drops you straight onto the drain. The client does the teleport (Effects).
--   * the kitchen floor is 24 studs below the tub; falling off the door teleports you back.
--
-- Everything the spray can hit lives in two folders on the arena Model: "Dishes" and "Grime" (dirt).
-- Nothing else is aimable (SprayController only raycasts those), so walls never block a scrub.
--
-- Performance: the build yields with task.wait() every ~200 parts.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))

local DishFactory = require(script.Parent:WaitForChild("DishFactory"))
local ToolModels = require(Shared:WaitForChild("ToolModels"))

local ArenaBuilder = {}

----------------------------------------------------------------------------------------------------
-- Layout numbers (arena space).
----------------------------------------------------------------------------------------------------
local TUB_HALF_X = 56
local TUB_Z_MIN, TUB_Z_MAX = -50, 62
local TUB_HEIGHT = 100

local DOOR_Z_NEAR, DOOR_Z_FAR = -50, -121 -- the open door lies flat over this Z range, top at Y = 0
local DOOR_THICK = 4
local SPAWN_Z = -100

local KITCHEN_FLOOR_Y = -24
local COUNTER_TOP_Y = 112
local ROOM_HALF_X = 420
local ROOM_Z_FRONT, ROOM_Z_BACK = -520, 76
local ROOM_HEIGHT = 520

local DRAIN_POS = Vector3.new(0, 0, -49) -- clear of the rack ramp (Z -41..-36)

local BOTTOM_RACK_Y = 4
local TOP_RACK_Y = 50
local RACK_HALF_X = 54
local BOTTOM_RACK_Z = { -36, 60 }
local TOP_RACK_Z = { -40, 60 }

-- Bottom rack: three rows of plates facing the door, spaced so a character fits between them.
local PLATE_ROW_X = { -34, 0, 34 }
local PLATE_Z = { -28, -21, -14, -7, 0, 7, 14, 21, 28 }
local PAN_SLOTS = { { x = -43, z = 47 }, { x = 43, z = 47 } }
local POT_SLOTS = { { x = -22, z = 47 }, { x = 22, z = 47 } }
local BASKET_CENTER = Vector3.new(0, 0, 47)
local BASKET_HALF = Vector3.new(10, 8, 9)
local BASKET_X = { -7.5, -2.5, 2.5, 7.5 }
local BASKET_Z = { 40.5, 44, 47.5, 51, 54.5 }

-- Top rack.
local BOWL_X = { -30, -15, 0, 15, 30 }
local BOWL_Z = { -24, -6 }
local CUP_X = { -40, -24, -8, 8, 24, 40 }
local CUP_Z = { 10, 24 }
local GLASS_X = { -42, -30, -18, -6, 6, 18, 30, 42 }
local GLASS_Z = { 38, 52 }

local BOWL_TILT = math.rad(50)
local PAN_TILT = math.rad(55)

-- Lifts (tub floor front corners -&gt; top rack) and the chute (top rack -&gt; drain).
local LIFTS = {
	{ from = Vector3.new(-47, 0, -45), to = Vector3.new(-47, TOP_RACK_Y, -34) },
	{ from = Vector3.new(47, 0, -45), to = Vector3.new(47, TOP_RACK_Y, -34) },
}
local CHUTE = { from = Vector3.new(0, TOP_RACK_Y, -36), to = Vector3.new(0, 0, -49) }

-- Tool shop counter on the left of the open door.
local SHOP_X = -49
local SHOP_Z = { -112, -60 }

local YIELD_EVERY = 200

-- Kitchen palette (theme-independent: every level is the same family kitchen).
local K = {
	Floor = Color3.fromRGB(196, 158, 116),
	Wall = Color3.fromRGB(214, 230, 238),
	Cabinet = Color3.fromRGB(244, 241, 234),
	CabinetDoor = Color3.fromRGB(236, 232, 224),
	Counter = Color3.fromRGB(235, 235, 238),
	Tile = Color3.fromRGB(250, 250, 250),
	Handle = Color3.fromRGB(170, 175, 182),
	Kick = Color3.fromRGB(70, 66, 62),
	Wood = Color3.fromRGB(150, 105, 70),
	Steel = Color3.fromRGB(200, 205, 212),
	Frame = Color3.fromRGB(230, 232, 235),
}

----------------------------------------------------------------------------------------------------
-- Small helpers
----------------------------------------------------------------------------------------------------

local function getArenasFolder(): Folder
	local folder = workspace:FindFirstChild("Arenas")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Arenas"
		folder.Parent = workspace
	end
	return folder :: Folder
end

-- Local (x, y, z) -&gt; world position, in the arena's own space (see file header).
local function worldPoint(origin: CFrame, x: number, y: number, z: number): Vector3
	return origin.Position + origin.RightVector * x + Vector3.new(0, y, 0) + origin.LookVector * z
end

-- A CFrame at local (x, y, z), axis-aligned with the arena (LookVector = into the tub), optionally
-- facing `lookDir` instead. Used both for plain parts and as DishFactory's footprint.
local function footprint(origin: CFrame, x: number, y: number, z: number, lookDir: Vector3?): CFrame
	local pos = worldPoint(origin, x, y, z)
	local look = (lookDir or origin.LookVector)
	if look.Magnitude &lt; 1e-4 then
		look = origin.LookVector
	end
	return CFrame.lookAt(pos, pos + look, Vector3.new(0, 1, 0))
end

type Builder = {
	model: Model,
	origin: CFrame,
	count: number,
}

-- A decoration/structure part in arena space. Static, no touch, not aimable. Box centred at (x,y,z).
local function box(b: Builder, name: string, size: Vector3, x: number, y: number, z: number, color: Color3, material: Enum.Material?, props: { [string]: any }?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = footprint(b.origin, x, y, z)
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.Anchored = true
	p.CanTouch = false
	p.CanQuery = false
	p.CanCollide = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if props then
		for k, v in props do
			(p :: any)[k] = v
		end
	end
	p.Parent = b.model
	b.count += 1
	return p
end

-- Box from min/max corners (arena space). Handy for walls and cabinets.
local function span(b: Builder, name: string, x0: number, x1: number, y0: number, y1: number, z0: number, z1: number, color: Color3, material: Enum.Material?, props: { [string]: any }?): Part
	return box(b, name, Vector3.new(math.abs(x1 - x0), math.abs(y1 - y0), math.abs(z1 - z0)), (x0 + x1) / 2, (y0 + y1) / 2, (z0 + z1) / 2, color, material, props)
end

-- Upright cylinder (axis = world Y) centred at (x, y, z).
local function cyl(b: Builder, name: string, height: number, diameter: number, x: number, y: number, z: number, color: Color3, material: Enum.Material?, props: { [string]: any }?): Part
	local p = box(b, name, Vector3.new(height, diameter, diameter), x, y, z, color, material, props)
	p.Shape = Enum.PartType.Cylinder
	p.CFrame = footprint(b.origin, x, y, z) * CFrame.Angles(0, 0, math.rad(90))
	return p
end

local function noCollide(): { [string]: any }
	return { CanCollide = false, CastShadow = false }
end

-- A world-sized sign (it scales with distance like a real object, so it never fills the screen).
-- It hangs off its own unrotated, invisible anchor `offsetY` above `parent`: cylinders are rotated
-- 90 degrees internally and a BillboardGui's offset follows that rotation, which is what used to
-- bury signs in the floor.
local function sign(parent: BasePart, text: string, widthStuds: number, heightStuds: number, offsetY: number, color: Color3?): TextLabel
	local anchor = Instance.new("Part")
	anchor.Name = "SignAnchor"
	anchor.Size = Vector3.new(0.2, 0.2, 0.2)
	anchor.CFrame = CFrame.new(parent.Position + Vector3.new(0, offsetY, 0))
	anchor.Transparency = 1
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.CastShadow = false
	anchor.Parent = parent.Parent
	local gui = Instance.new("BillboardGui")
	gui.Name = "Sign"
	gui.Size = UDim2.fromScale(widthStuds, heightStuds)
	gui.LightInfluence = 0
	gui.MaxDistance = 160
	gui.AlwaysOnTop = false
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = color or Color3.new(1, 1, 1)
	label.Text = text
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 3
	stroke.Color = Color3.fromRGB(12, 30, 60)
	stroke.Parent = label
	label.Parent = gui
	gui.Parent = anchor
	return label
end

----------------------------------------------------------------------------------------------------
-- The kitchen around the dishwasher
----------------------------------------------------------------------------------------------------

local function buildKitchen(b: Builder)
	local fy = KITCHEN_FLOOR_Y
	local shadowless = { CastShadow = false }

	-- Floor, walls, ceiling. Walls and ceiling don't cast shadows so daylight still fills the room.
	span(b, "KitchenFloor", -ROOM_HALF_X, ROOM_HALF_X, fy - 4, fy, ROOM_Z_FRONT, ROOM_Z_BACK, K.Floor, Enum.Material.WoodPlanks)
	span(b, "BackWall", -ROOM_HALF_X, ROOM_HALF_X, fy, fy + ROOM_HEIGHT, ROOM_Z_BACK, ROOM_Z_BACK + 4, K.Wall, nil, shadowless)
	span(b, "FrontWall", -ROOM_HALF_X, ROOM_HALF_X, fy, fy + ROOM_HEIGHT, ROOM_Z_FRONT - 4, ROOM_Z_FRONT, K.Wall, nil, shadowless)
	for _, side in { -1, 1 } do
		span(b, "SideWall", side * ROOM_HALF_X, side * (ROOM_HALF_X + 4), fy, fy + ROOM_HEIGHT, ROOM_Z_FRONT, ROOM_Z_BACK, K.Wall, nil, shadowless)
		-- Skirting board.
		span(b, "Skirting", side * (ROOM_HALF_X - 2), side * ROOM_HALF_X, fy, fy + 10, ROOM_Z_FRONT, ROOM_Z_BACK, Color3.new(1, 1, 1), nil, noCollide())
	end
	span(b, "Ceiling", -ROOM_HALF_X, ROOM_HALF_X, fy + ROOM_HEIGHT, fy + ROOM_HEIGHT + 4, ROOM_Z_FRONT, ROOM_Z_BACK, Color3.fromRGB(248, 248, 246), nil, shadowless)
	-- Ceiling lamp.
	local lamp = cyl(b, "CeilingLamp", 4, 70, 0, fy + ROOM_HEIGHT - 4, -200, Color3.fromRGB(255, 248, 225), Enum.Material.Neon, noCollide())
	lamp.CastShadow = false

	-- Base cabinets either side of the dishwasher, with doors, handles and a toe kick.
	local cabFront = -54
	for _, side in { -1, 1 } do
		local x0, x1 = side * 62, side * ROOM_HALF_X
		span(b, "Cabinets", x0, x1, fy + 12, COUNTER_TOP_Y - 6, cabFront, ROOM_Z_BACK, K.Cabinet)
		span(b, "ToeKick", x0, x1, fy, fy + 12, cabFront + 8, ROOM_Z_BACK, K.Kick)
		local width = math.abs(x1 - x0)
		local doors = math.floor(width / 80)
		local doorW = width / doors
		for i = 0, doors - 1 do
			local cx = side * (62 + doorW * (i + 0.5))
			-- Drawer on top, door below.
			box(b, "Drawer", Vector3.new(doorW - 6, 26, 1.5), cx, COUNTER_TOP_Y - 24, cabFront - 0.75, K.CabinetDoor)
			box(b, "DrawerHandle", Vector3.new(24, 2.5, 2.5), cx, COUNTER_TOP_Y - 24, cabFront - 2.5, K.Handle, Enum.Material.Metal, noCollide())
			box(b, "Door", Vector3.new(doorW - 6, 66, 1.5), cx, fy + 12 + 38, cabFront - 0.75, K.CabinetDoor)
			box(b, "DoorHandle", Vector3.new(2.5, 20, 2.5), cx + side * -(doorW / 2 - 12), fy + 12 + 55, cabFront - 2.5, K.Handle, Enum.Material.Metal, noCollide())
		end
	end

	-- Countertop across the whole run (including over the dishwasher) with a tiled backsplash.
	span(b, "Countertop", -ROOM_HALF_X, ROOM_HALF_X, COUNTER_TOP_Y - 6, COUNTER_TOP_Y, cabFront - 6, ROOM_Z_BACK, K.Counter, Enum.Material.Marble, shadowless)
	span(b, "Backsplash", -ROOM_HALF_X, ROOM_HALF_X, COUNTER_TOP_Y, COUNTER_TOP_Y + 70, ROOM_Z_BACK - 1, ROOM_Z_BACK, K.Tile, Enum.Material.CeramicTiles, noCollide())

	-- Upper cabinets, leaving a gap for the window over the sink.
	local upperY0, upperY1 = COUNTER_TOP_Y + 120, COUNTER_TOP_Y + 270
	for _, seg in { { -ROOM_HALF_X, -220 }, { -40, ROOM_HALF_X } } do
		span(b, "UpperCabinets", seg[1], seg[2], upperY0, upperY1, ROOM_Z_BACK - 40, ROOM_Z_BACK, K.Cabinet, nil, shadowless)
		local w = seg[2] - seg[1]
		local n = math.floor(w / 70)
		for i = 0, n - 1 do
			local cx = seg[1] + w / n * (i + 0.5)
			box(b, "UpperDoor", Vector3.new(w / n - 5, upperY1 - upperY0 - 8, 1.2), cx, (upperY0 + upperY1) / 2, ROOM_Z_BACK - 40.6, K.CabinetDoor, nil, noCollide())
			box(b, "UpperHandle", Vector3.new(2.5, 16, 2.5), cx + (w / n / 2 - 10), upperY0 + 16, ROOM_Z_BACK - 42, K.Handle, Enum.Material.Metal, noCollide())
		end
	end

	-- Window over the sink: frame, glowing sky panel, and cross bars.
	local wx0, wx1 = -210, -50
	local wy0, wy1 = COUNTER_TOP_Y + 90, COUNTER_TOP_Y + 260
	local sky = span(b, "WindowSky", wx0, wx1, wy0, wy1, ROOM_Z_BACK - 0.5, ROOM_Z_BACK + 0.5, Color3.fromRGB(190, 225, 255), Enum.Material.Neon, noCollide())
	sky.CastShadow = false
	span(b, "WindowSill", wx0 - 8, wx1 + 8, wy0 - 6, wy0, ROOM_Z_BACK - 10, ROOM_Z_BACK, Color3.new(1, 1, 1), nil, noCollide())
	for _, x in { wx0, (wx0 + wx1) / 2, wx1 } do
		span(b, "WindowBar", x - 3, x + 3, wy0, wy1, ROOM_Z_BACK - 3, ROOM_Z_BACK, Color3.new(1, 1, 1), nil, noCollide())
	end
	for _, y in { wy0, (wy0 + wy1) / 2, wy1 } do
		span(b, "WindowBar", wx0, wx1, y - 3, y + 3, ROOM_Z_BACK - 3, ROOM_Z_BACK, Color3.new(1, 1, 1), nil, noCollide())
	end

	-- Sink in the counter under the window, and a tall faucet.
	local sinkX = (wx0 + wx1) / 2
	span(b, "Sink", sinkX - 60, sinkX + 60, COUNTER_TOP_Y - 0.4, COUNTER_TOP_Y + 0.2, -10, 50, K.Steel, Enum.Material.Metal, noCollide())
	span(b, "SinkBasin", sinkX - 54, sinkX + 54, COUNTER_TOP_Y - 0.2, COUNTER_TOP_Y + 0.4, -4, 44, Color3.fromRGB(120, 125, 132), Enum.Material.Metal, noCollide())
	cyl(b, "FaucetBase", 6, 10, sinkX, COUNTER_TOP_Y + 3, 60, K.Steel, Enum.Material.Metal, noCollide())
	cyl(b, "FaucetPipe", 60, 5, sinkX, COUNTER_TOP_Y + 33, 60, K.Steel, Enum.Material.Metal, noCollide())
	box(b, "FaucetSpout", Vector3.new(5, 5, 40), sinkX, COUNTER_TOP_Y + 62, 42, K.Steel, Enum.Material.Metal, noCollide())
	-- Dish soap bottle next to the sink.
	cyl(b, "SoapBottle", 40, 16, sinkX + 90, COUNTER_TOP_Y + 20, 40, Color3.fromRGB(80, 200, 120), Enum.Material.Glass, { CanCollide = false, Transparency = 0.15 })
	cyl(b, "SoapCap", 8, 9, sinkX + 90, COUNTER_TOP_Y + 44, 40, Color3.new(1, 1, 1), nil, noCollide())

	-- A kettle and a fruit bowl on the counter to the right.
	cyl(b, "Kettle", 40, 34, 230, COUNTER_TOP_Y + 20, 30, K.Steel, Enum.Material.Metal, noCollide())
	box(b, "KettleHandle", Vector3.new(26, 5, 5), 230, COUNTER_TOP_Y + 44, 30, Color3.fromRGB(40, 40, 44), nil, noCollide())
	cyl(b, "FruitBowl", 14, 60, 330, COUNTER_TOP_Y + 7, 20, Color3.fromRGB(230, 120, 80), nil, noCollide())
	for i, c in { Color3.fromRGB(230, 50, 50), Color3.fromRGB(255, 200, 40), Color3.fromRGB(120, 200, 60) } do
		local ball = box(b, "Fruit", Vector3.new(18, 18, 18), 318 + i * 7, COUNTER_TOP_Y + 20, 14 + (i % 2) * 10, c, nil, noCollide())
		ball.Shape = Enum.PartType.Ball
	end

	-- Fridge on the right wall.
	span(b, "Fridge", 300, ROOM_HALF_X, fy, fy + 380, -260, -120, Color3.fromRGB(235, 238, 242), Enum.Material.SmoothPlastic)
	box(b, "FridgeHandle", Vector3.new(3, 90, 3), 297, fy + 230, -150, K.Handle, Enum.Material.Metal, noCollide())
	box(b, "FridgeHandle", Vector3.new(3, 60, 3), 297, fy + 110, -150, K.Handle, Enum.Material.Metal, noCollide())
	box(b, "FridgeSeam", Vector3.new(1, 2, 140), 299.8, fy + 170, -190, Color3.fromRGB(180, 185, 190), nil, noCollide())

	-- Kitchen table with chairs out in the room, behind the players.
	local tz, tyTop = -330, fy + 150
	span(b, "TableTop", -150, 150, tyTop - 8, tyTop, tz - 90, tz + 90, K.Wood, Enum.Material.Wood)
	for _, lx in { -135, 135 } do
		for _, lz in { tz - 75, tz + 75 } do
			span(b, "TableLeg", lx - 6, lx + 6, fy, tyTop - 8, lz - 6, lz + 6, K.Wood, Enum.Material.Wood)
		end
	end
	for _, cx in { -80, 80 } do
		for _, dir in { -1, 1 } do
			local cz = tz + dir * 125
			span(b, "ChairSeat", cx - 40, cx + 40, fy + 90, fy + 98, cz - 35, cz + 35, K.Wood, Enum.Material.Wood)
			span(b, "ChairBack", cx - 40, cx + 40, fy + 98, fy + 200, cz + dir * 30, cz + dir * 36, K.Wood, Enum.Material.Wood)
			for _, lx in { cx - 34, cx + 34 } do
				for _, lz in { cz - 29, cz + 29 } do
					span(b, "ChairLeg", lx - 4, lx + 4, fy, fy + 90, lz - 4, lz + 4, K.Wood, Enum.Material.Wood)
				end
			end
		end
	end
	-- Plates waiting on the table, for flavour.
	for i = 0, 2 do
		cyl(b, "TablePlate", 2, 60, -80 + i * 80, tyTop + 1, tz, Color3.new(1, 1, 1), nil, noCollide())
	end
end

----------------------------------------------------------------------------------------------------
-- The dishwasher body, tub and door
----------------------------------------------------------------------------------------------------

local function buildTub(b: Builder, theme)
	local steel = theme.Tub
	local zMid = (TUB_Z_MIN + TUB_Z_MAX) / 2

	-- Tub floor and walls. They don't cast shadows, so the room's daylight still reaches inside.
	span(b, "TubFloor", -TUB_HALF_X - 2, TUB_HALF_X + 2, -2, 0, TUB_Z_MIN, TUB_Z_MAX, steel, Enum.Material.Metal)
	for _, side in { -1, 1 } do
		span(b, "TubWall", side * TUB_HALF_X, side * (TUB_HALF_X + 2), 0, TUB_HEIGHT, TUB_Z_MIN, TUB_Z_MAX, steel, Enum.Material.Metal)
		-- Pressed ribs and rack rails on the side walls.
		for i = 1, 6 do
			local y = i * (TUB_HEIGHT / 7)
			span(b, "Rib", side * (TUB_HALF_X - 0.3), side * TUB_HALF_X, y - 0.4, y + 0.4, TUB_Z_MIN + 4, TUB_Z_MAX - 4, theme.Metal, Enum.Material.Metal, noCollide())
		end
		for _, y in { BOTTOM_RACK_Y - 1, TOP_RACK_Y - 1 } do
			span(b, "RackRail", side * (TUB_HALF_X - 1.6), side * TUB_HALF_X, y - 0.8, y + 0.8, TUB_Z_MIN + 2, TUB_Z_MAX - 2, theme.Rack, Enum.Material.Metal, noCollide())
		end
	end
	-- The tub casts shadows (it's a closed box, like a real machine): the inside is lit by the
	-- interior lights below rather than blasted by daylight.
	span(b, "TubBack", -TUB_HALF_X - 2, TUB_HALF_X + 2, 0, TUB_HEIGHT, TUB_Z_MAX, TUB_Z_MAX + 2, steel, Enum.Material.Metal)
	span(b, "TubCeiling", -TUB_HALF_X - 2, TUB_HALF_X + 2, TUB_HEIGHT, TUB_HEIGHT + 2, TUB_Z_MIN, TUB_Z_MAX, steel, Enum.Material.Metal)

	-- Filter cup in the floor at the back, heating element loop.
	cyl(b, "Filter", 0.4, 14, 0, 0.2, 30, Color3.fromRGB(120, 125, 130), Enum.Material.DiamondPlate, noCollide())
	for _, x in { -40, 40 } do
		span(b, "Heater", x - 0.6, x + 0.6, 0.4, 1.4, -10, 50, Color3.fromRGB(90, 90, 95), Enum.Material.Metal, noCollide())
	end
	span(b, "Heater", -40, 40, 0.4, 1.4, 49.4, 50.6, Color3.fromRGB(90, 90, 95), Enum.Material.Metal, noCollide())

	-- Front frame around the opening, the machine's side panels, and the toe kick under the door.
	-- (Offsets of 0.2 keep every face off its neighbours' planes, so nothing flickers.)
	span(b, "FrameTop", -TUB_HALF_X - 6.2, TUB_HALF_X + 6.2, TUB_HEIGHT - 0.2, COUNTER_TOP_Y - 6, TUB_Z_MIN - 3.2, TUB_Z_MIN + 2, K.Frame, Enum.Material.Metal)
	for _, side in { -1, 1 } do
		span(b, "FrameSide", side * (TUB_HALF_X - 0.2), side * (TUB_HALF_X + 6), KITCHEN_FLOOR_Y, TUB_HEIGHT, TUB_Z_MIN - 3, TUB_Z_MIN + 2, K.Frame, Enum.Material.Metal)
		span(b, "Gasket", side * (TUB_HALF_X - 0.4), side * TUB_HALF_X, 0, TUB_HEIGHT - 0.4, TUB_Z_MIN - 0.5, TUB_Z_MIN + 1, Color3.fromRGB(50, 50, 55), nil, noCollide())
	end
	span(b, "UnderTub", -TUB_HALF_X - 5.8, TUB_HALF_X + 5.8, KITCHEN_FLOOR_Y + 12, -2.2, TUB_Z_MIN + 1, TUB_Z_MAX, Color3.fromRGB(90, 90, 95), Enum.Material.Metal)
	span(b, "ToeKick", -TUB_HALF_X, TUB_HALF_X, KITCHEN_FLOOR_Y, KITCHEN_FLOOR_Y + 12, TUB_Z_MIN + 6, TUB_Z_MAX, K.Kick)

	-- Interior lights so the load is easy to see (PointLight range tops out at 60 studs).
	for _, spot in { { -30, 90, -20 }, { 30, 90, -20 }, { -30, 90, 35 }, { 30, 90, 35 }, { -30, 44, 0 }, { 30, 44, 0 }, { 0, 44, 40 } } do
		local lightPart = box(b, "InteriorLight", Vector3.new(1, 1, 1), spot[1], spot[2], spot[3], theme.Light, nil, { Transparency = 1, CanCollide = false, CastShadow = false })
		local light = Instance.new("PointLight")
		light.Color = theme.Light
		light.Brightness = if spot[2] &gt; 60 then 0.45 else 0.6
		light.Range = 60
		light.Shadows = false
		light.Parent = lightPart
	end

	-- Drifting bubbles for mood.
	local bubbleAnchor = box(b, "BubbleAnchor", Vector3.new(80, 1, 80), 0, 30, zMid, theme.Accent, nil, { Transparency = 1, CanCollide = false })
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = "rbxasset://textures/particles/forcefield_glow_main.dds"
	emitter.Color = ColorSequence.new(Color3.new(1, 1, 1))
	emitter.LightEmission = 0.3
	emitter.Lifetime = NumberRange.new(5, 8)
	emitter.Speed = NumberRange.new(1, 3)
	emitter.Rate = 3
	emitter.Size = NumberSequence.new(0.8, 0.3)
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.2, 0.6),
		NumberSequenceKeypoint.new(1, 1),
	})
	emitter.SpreadAngle = Vector2.new(30, 30)
	emitter.EmissionDirection = Enum.NormalId.Top
	emitter.Parent = bubbleAnchor
end

local function buildDoor(b: Builder, theme)
	local zMid = (DOOR_Z_NEAR + DOOR_Z_FAR) / 2

	-- Inner panel (the floor you stand on) and the outer skin below it.
	span(b, "DoorInner", -TUB_HALF_X, TUB_HALF_X, -1, 0, DOOR_Z_FAR, DOOR_Z_NEAR, theme.Tub, Enum.Material.Metal)
	span(b, "DoorOuter", -TUB_HALF_X - 4, TUB_HALF_X + 4, -DOOR_THICK, -1, DOOR_Z_FAR - 6, DOOR_Z_NEAR, K.Frame, Enum.Material.Metal)
	-- Raised edges down the sides of the inner panel.
	for _, side in { -1, 1 } do
		span(b, "DoorEdge", side * (TUB_HALF_X - 2), side * TUB_HALF_X, 0, 2, DOOR_Z_FAR, DOOR_Z_NEAR, theme.Metal, Enum.Material.Metal)
		-- Invisible safety wall so nobody walks off the side.
		-- Invisible safety wall, as tall as the tub, so nobody can jump off the door.
		span(b, "SafetyWall", side * TUB_HALF_X, side * (TUB_HALF_X + 1), 0, TUB_HEIGHT, DOOR_Z_FAR - 6, DOOR_Z_NEAR, Color3.new(1, 1, 1), nil, { Transparency = 1, CastShadow = false })
		-- Hinge.
		cyl(b, "Hinge", 6, 5, side * (TUB_HALF_X - 6), -2, DOOR_Z_NEAR + 1, K.Steel, Enum.Material.Metal, noCollide())
	end
	span(b, "SafetyWall", -TUB_HALF_X - 1, TUB_HALF_X + 1, 0, TUB_HEIGHT, DOOR_Z_FAR - 7, DOOR_Z_FAR - 6, Color3.new(1, 1, 1), nil, { Transparency = 1, CastShadow = false })
	-- A lid over the door area as well, level with the tub ceiling.
	span(b, "SafetyLid", -TUB_HALF_X - 1, TUB_HALF_X + 1, TUB_HEIGHT, TUB_HEIGHT + 1, DOOR_Z_FAR - 7, DOOR_Z_NEAR - 3.2, Color3.new(1, 1, 1), nil, { Transparency = 1, CastShadow = false })

	-- Control strip along the far edge (the top of the door when it's closed), with buttons.
	span(b, "ControlStrip", -TUB_HALF_X - 4.3, TUB_HALF_X + 4.3, -DOOR_THICK - 0.3, 3, DOOR_Z_FAR - 6.3, DOOR_Z_FAR, Color3.fromRGB(40, 44, 52), Enum.Material.SmoothPlastic)
	for i = -3, 3 do
		local lit = i == 0
		box(b, "Button", Vector3.new(4, 0.6, 3), i * 9, 3.3, DOOR_Z_FAR - 3, if lit then theme.Accent else Color3.fromRGB(90, 95, 105), if lit then Enum.Material.Neon else nil, noCollide())
	end

	-- Detergent dispenser and rinse-aid cap on the inner panel.
	span(b, "Dispenser", 12, 22, 0, 0.9, zMid - 4, zMid + 4, Color3.fromRGB(220, 224, 230), Enum.Material.SmoothPlastic)
	span(b, "DispenserLid", 12.4, 21.6, 0.9, 1.2, zMid - 3.6, zMid + 3.6, Color3.fromRGB(245, 247, 250), nil, noCollide())
	span(b, "DispenserHinge", 12.4, 21.6, 0.9, 1.5, zMid - 3.9, zMid - 3.3, Color3.fromRGB(180, 185, 192), nil, noCollide())
	cyl(b, "DispenserButton", 0.3, 1.4, 17, 1.35, zMid + 2, theme.Accent, Enum.Material.Neon, noCollide())
	cyl(b, "RinseAid", 1, 4.5, 28, 0.5, zMid, Color3.fromRGB(220, 224, 230), nil, noCollide())
	cyl(b, "RinseAidCap", 0.3, 3.2, 28, 1.15, zMid, theme.Accent, nil, noCollide())
end

----------------------------------------------------------------------------------------------------
-- Racks
----------------------------------------------------------------------------------------------------

-- A walkable rack floor: invisible collidable plate + a visible wire grid, frame and wheels.
local function buildRack(b: Builder, theme, y: number, zRange: { number }, wheels: boolean)
	local z0, z1 = zRange[1], zRange[2]
	local width = RACK_HALF_X * 2
	local depth = z1 - z0
	span(b, "RackFloor", -RACK_HALF_X, RACK_HALF_X, y - 1, y, z0, z1, Color3.new(1, 1, 1), nil, { Transparency = 1, CastShadow = false })

	local wire = { CanCollide = false }
	for x = -RACK_HALF_X, RACK_HALF_X, 4 do
		box(b, "Wire", Vector3.new(0.3, 0.3, depth), x, y - 0.15, (z0 + z1) / 2, theme.Rack, Enum.Material.SmoothPlastic, wire)
	end
	for z = z0, z1, 4 do
		box(b, "Wire", Vector3.new(width, 0.3, 0.3), 0, y - 0.45, z, theme.Rack, Enum.Material.SmoothPlastic, wire)
	end
	-- Chunky frame around the edge.
	for _, side in { -1, 1 } do
		box(b, "RackFrame", Vector3.new(0.9, 2.4, depth), side * RACK_HALF_X, y + 0.6, (z0 + z1) / 2, theme.Rack, nil, wire)
		if wheels then
			for _, z in { z0 + 8, z1 - 8 } do
				cyl(b, "Wheel", 3, 1, side * (RACK_HALF_X + 0.8), y - 1.2, z, Color3.fromRGB(60, 60, 64), nil, noCollide()).CFrame = footprint(b.origin, side * (RACK_HALF_X + 0.8), y - 1.2, z)
			end
		end
	end
	for _, z in { z0, z1 } do
		box(b, "RackFrame", Vector3.new(width, 2.4, 0.9), 0, y + 0.6, z, theme.Rack, nil, wire)
	end
end

-- Tines: the rows of little prongs plates stand in. Pure decoration.
local function buildTines(b: Builder, theme)
	local props = { CanCollide = false, CastShadow = false }
	for _, x in PLATE_ROW_X do
		for _, dx in { -9, 9 } do
			for _, z in PLATE_Z do
				box(b, "Tine", Vector3.new(0.35, 5, 0.35), x + dx, BOTTOM_RACK_Y + 2.5, z + 3.5, theme.Rack, nil, props)
			end
		end
	end
end

-- Ramp from the tub floor up onto the bottom rack.
local function buildRamp(b: Builder, theme)
	local z0, z1 = BOTTOM_RACK_Z[1] - 5, BOTTOM_RACK_Z[1]
	local wedge = Instance.new("WedgePart")
	wedge.Name = "Ramp"
	wedge.Size = Vector3.new(RACK_HALF_X * 2 - 20, BOTTOM_RACK_Y, z1 - z0)
	-- A wedge slopes down toward its LookVector, so point that at the door: low end by the drain,
	-- high end at the rack.
	wedge.CFrame = footprint(b.origin, 0, BOTTOM_RACK_Y / 2, (z0 + z1) / 2, -b.origin.LookVector)
	wedge.Color = theme.Rack
	wedge.Material = Enum.Material.DiamondPlate
	wedge.Anchored = true
	wedge.CanTouch = false
	wedge.CanQuery = false
	wedge.Parent = b.model
	b.count += 1
end

local function buildCutleryBasket(b: Builder, theme)
	local c, h = BASKET_CENTER, BASKET_HALF
	local y0 = BOTTOM_RACK_Y
	span(b, "BasketBase", c.X - h.X, c.X + h.X, y0, y0 + 0.6, c.Z - h.Z, c.Z + h.Z, theme.Rack)
	local props = { CanCollide = true, Transparency = 0.2 }
	span(b, "BasketWall", c.X - h.X - 0.5, c.X - h.X, y0, y0 + h.Y, c.Z - h.Z, c.Z + h.Z, theme.Rack, Enum.Material.DiamondPlate, props)
	span(b, "BasketWall", c.X + h.X, c.X + h.X + 0.5, y0, y0 + h.Y, c.Z - h.Z, c.Z + h.Z, theme.Rack, Enum.Material.DiamondPlate, props)
	span(b, "BasketWall", c.X - h.X, c.X + h.X, y0, y0 + h.Y, c.Z - h.Z - 0.5, c.Z - h.Z, theme.Rack, Enum.Material.DiamondPlate, props)
	span(b, "BasketWall", c.X - h.X, c.X + h.X, y0, y0 + h.Y, c.Z + h.Z, c.Z + h.Z + 0.5, theme.Rack, Enum.Material.DiamondPlate, props)
	-- Handle arching over the middle.
	span(b, "BasketHandle", c.X - 0.4, c.X + 0.4, y0 + h.Y, y0 + h.Y + 5, c.Z - h.Z, c.Z - h.Z + 0.8, theme.Rack, nil, noCollide())
	span(b, "BasketHandle", c.X - 0.4, c.X + 0.4, y0 + h.Y, y0 + h.Y + 5, c.Z + h.Z - 0.8, c.Z + h.Z, theme.Rack, nil, noCollide())
	span(b, "BasketHandle", c.X - 0.4, c.X + 0.4, y0 + h.Y + 4.2, y0 + h.Y + 5, c.Z - h.Z, c.Z + h.Z, theme.Rack, nil, noCollide())
end

local function sprayEmitter(parent: Instance, rate: number, speed: number, direction: Enum.NormalId)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = "Spray"
	emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	emitter.Color = ColorSequence.new(Color3.fromRGB(200, 235, 255))
	emitter.LightEmission = 0.25
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.28), NumberSequenceKeypoint.new(1, 0.12) })
	emitter.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(0.8, 0.5), NumberSequenceKeypoint.new(1, 1) })
	emitter.Lifetime = NumberRange.new(0.9, 1.4)
	emitter.Rate = rate
	emitter.Speed = NumberRange.new(speed * 0.8, speed)
	emitter.SpreadAngle = Vector2.new(18, 18)
	emitter.Acceleration = Vector3.new(0, -45, 0)
	emitter.EmissionDirection = direction
	emitter.Parent = parent
end

-- The spray arms spin (client side, tag SpinY) and throw arcs of droplets up into the load. A thin
-- drizzle falls from the ceiling. Kept light so it never gets in the way of aiming.
local function buildSprayArms(b: Builder, theme)
	for _, y in { 2, TOP_RACK_Y - 3 } do
		cyl(b, "ArmHub", 1.5, 5, 0, y, 10, theme.Metal, Enum.Material.Metal, noCollide())
		local length = RACK_HALF_X * 1.6
		local arm = box(b, "SprayArm", Vector3.new(length, 0.9, 3), 0, y, 10, theme.Metal, Enum.Material.Metal, noCollide())
		arm:SetAttribute("SpinSpeed", if y &gt; 10 then 1.1 else 0.8)
		CollectionService:AddTag(arm, "SpinY")
		for _, f in { -0.42, -0.2, 0.2, 0.42 } do
			local attach = Instance.new("Attachment")
			attach.Position = Vector3.new(length * f, 0.5, 0)
			attach.Parent = arm
			sprayEmitter(attach, 5, if y &gt; 10 then 22 else 30, Enum.NormalId.Top)
		end
	end
	local drizzle = box(b, "Drizzle", Vector3.new(TUB_HALF_X * 1.8, 1, (TUB_Z_MAX - TUB_Z_MIN) * 0.9), 0, TUB_HEIGHT - 2, (TUB_Z_MIN + TUB_Z_MAX) / 2, theme.Light, nil, { Transparency = 1, CanCollide = false, CastShadow = false })
	sprayEmitter(drizzle, 14, 4, Enum.NormalId.Bottom)
end

-- Bubble lifts and the drain chute. The client teleports whoever steps on a pad (Effects).
local function buildLifts(b: Builder, theme)
	local function pad(name: string, from: Vector3, to: Vector3, label: string, columnHeight: number)
		local p = cyl(b, name, 0.4, 8, from.X, from.Y + 0.2, from.Z, theme.Accent, Enum.Material.Neon, noCollide())
		p:SetAttribute("LiftTo", worldPoint(b.origin, to.X, to.Y + 3, to.Z))
		CollectionService:AddTag(p, "LiftPad")
		local ring = cyl(b, name .. "Ring", 0.2, 10, from.X, from.Y + 0.1, from.Z, Color3.new(1, 1, 1), Enum.Material.Neon, noCollide())
		ring.Transparency = 0.4
		if columnHeight &gt; 0 then
			local column = cyl(b, name .. "Column", columnHeight, 7, from.X, from.Y + columnHeight / 2, from.Z, theme.Accent, Enum.Material.ForceField, noCollide())
			column.Transparency = 0.6
		end
		local emitter = Instance.new("ParticleEmitter")
		emitter.Texture = "rbxasset://textures/particles/forcefield_glow_main.dds"
		emitter.Color = ColorSequence.new(Color3.new(1, 1, 1))
		emitter.Lifetime = NumberRange.new(1.2, 2)
		emitter.Speed = NumberRange.new(8, 14)
		emitter.Rate = 10
		emitter.Size = NumberSequence.new(0.9, 0.3)
		emitter.SpreadAngle = Vector2.new(10, 10)
		emitter.EmissionDirection = if to.Y &gt; from.Y then Enum.NormalId.Right else Enum.NormalId.Left
		emitter.Parent = p
		sign(p, label, 12, 2.6, 7)
	end
	for _, lift in LIFTS do
		pad("BubbleLift", lift.from, lift.to, "⬆️ Bubble Lift", TOP_RACK_Y)
	end
	pad("DrainChute", CHUTE.from, CHUTE.to, "⬇️ Chute to the drain", 0)
end

local function buildDrain(b: Builder, theme): Vector3
	cyl(b, "DrainGrate", 0.5, 15, DRAIN_POS.X, 0.25, DRAIN_POS.Z, Color3.fromRGB(70, 75, 80), Enum.Material.DiamondPlate)
	local ring = cyl(b, "DrainSwirl", 0.2, 13, DRAIN_POS.X, 0.6, DRAIN_POS.Z, theme.Accent, Enum.Material.ForceField, noCollide())
	ring:SetAttribute("SpinSpeed", 2.4)
	CollectionService:AddTag(ring, "SpinY")
	local post = box(b, "DrainSign", Vector3.new(0.6, 0.6, 0.6), DRAIN_POS.X, 1, DRAIN_POS.Z, Color3.new(1, 1, 1), nil, { Transparency = 1, CanCollide = false })
	sign(post, "🌀 DRAIN\nstand here to sell", 16, 5, 8, Color3.fromRGB(150, 230, 255))
	return worldPoint(b.origin, DRAIN_POS.X, 0, DRAIN_POS.Z)
end

----------------------------------------------------------------------------------------------------
-- Tool shop on the door (walk up to a tool and press the prompt to buy it) and the upgrade book.
----------------------------------------------------------------------------------------------------

-- A SurfaceGui sign on a real part, facing `facing` (so it never floats, sinks or flickers).
local function signBoard(b: Builder, name: string, size: Vector3, pos: Vector3, facing: Vector3, color: Color3): (Part, SurfaceGui)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = CFrame.lookAt(pos, pos + facing)
	p.Color = color
	p.Material = Enum.Material.SmoothPlastic
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Parent = b.model
	b.count += 1
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.LightInfluence = 0
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 60
	gui.Parent = p
	return p, gui
end

local function guiText(parent: Instance, name: string, text: string, pos: UDim2, size: UDim2, color: Color3): TextLabel
	local label = Instance.new("TextLabel")
	label.Name = name
	label.BackgroundTransparency = 1
	label.Position = pos
	label.Size = size
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = color
	label.Text = text
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 3
	stroke.Color = Color3.fromRGB(12, 30, 60)
	stroke.Parent = label
	label.Parent = parent
	return label
end

-- The Tool Shop: a chrome wire shelving unit (it matches the dishwasher racks) standing on the
-- left of the open door, facing the players. Two shelves, the tools on the upper ones, a price tag
-- on the front lip of each spot, a sign on top. Buy any tool in any order with the prompt.
local function buildShop(b: Builder, theme, levelIndex: number): Vector3
	local z0, z1 = SHOP_Z[1], SHOP_Z[2]
	local depth = 9
	local x0, x1 = SHOP_X - depth / 2, SHOP_X + depth / 2 -- x1 is the front, facing the players
	local toPlayers = b.origin.RightVector
	local chrome = Color3.fromRGB(215, 220, 228)
	-- Two display shelves at waist and head height for a ~5 stud character (anything higher can't be
	-- seen from the floor).
	local shelfYs = { 4, 12.5 }
	local topY = 21
	local TOOL_SCALE = 1.45

	-- Four corner posts plus a middle pair, floor to top, with little feet.
	for _, x in { x0, x1 } do
		for _, z in { z0, (z0 + z1) / 2, z1 } do
			cyl(b, "ShelfPost", topY, 0.7, x, topY / 2, z, chrome, Enum.Material.Metal)
			cyl(b, "ShelfFoot", 0.4, 1.3, x, 0.2, z, Color3.fromRGB(60, 62, 70), nil, noCollide())
		end
	end
	-- Shelves: a solid (invisible-ish) board so things rest on something, plus wire detail.
	for _, y in shelfYs do
		span(b, "ShelfBoard", x0, x1, y - 0.25, y, z0, z1, Color3.fromRGB(235, 238, 242), Enum.Material.DiamondPlate, { Transparency = 0.25 })
		for _, x in { x0, x1 } do
			span(b, "ShelfRail", x - 0.2, x + 0.2, y, y + 0.9, z0, z1, chrome, Enum.Material.Metal, noCollide())
		end
		for z = z0 + 3, z1 - 3, 3 do
			span(b, "ShelfWire", x0, x1, y + 0.01, y + 0.07, z - 0.08, z + 0.08, chrome, Enum.Material.Metal, noCollide())
		end
	end
	span(b, "ShelfTop", x0 - 0.3, x1 + 0.3, topY, topY + 0.4, z0 - 0.3, z1 + 0.3, chrome, Enum.Material.Metal)

	-- Sign across the top.
	local _, headerGui = signBoard(b, "ShopSign", Vector3.new(z1 - z0 - 4, 4, 0.5), worldPoint(b.origin, x1 - 0.5, topY + 2.6, (z0 + z1) / 2), toPlayers, theme.Accent)
	guiText(headerGui, "Title", "🧽 TOOL SHOP  •  any tool, any order", UDim2.fromScale(0.03, 0.1), UDim2.fromScale(0.94, 0.8), Color3.new(1, 1, 1))

	-- Tools 2..6: the tall ones (sponge, nozzle, washer) on the middle shelf, the short ones on top.
	local third = (z1 - z0) / 3
	local spots = {
		[2] = { y = shelfYs[1], z = z1 - third / 2 },
		[4] = { y = shelfYs[1], z = (z0 + z1) / 2 - 3 },
		[5] = { y = shelfYs[1], z = z0 + third / 2 },
		[3] = { y = shelfYs[2], z = z1 - third * 0.8 },
		[6] = { y = shelfYs[2], z = z0 + third * 0.8 },
	}
	for i = 2, #Config.Tools do
		local tool = Config.Tools[i]
		local spot = spots[i]
		if not spot then
			break
		end
		-- Upper-shelf tools stand on tall risers so they show above the shelf lip from the floor.
		local riser = if spot.y &gt; shelfYs[1] then 2.6 else 0.4
		local pedestal = cyl(b, "Pedestal", riser, 6.4, SHOP_X - 0.5, spot.y + riser / 2, spot.z, Color3.new(1, 1, 1), nil, noCollide())
		pedestal.Name = "ToolDisplay_" .. i
		cyl(b, "PedestalGlow", 0.12, 7, SHOP_X - 0.5, spot.y + 0.06, spot.z, tool.Color, Enum.Material.Neon, noCollide())
		local okModel, model = pcall(ToolModels.Build, i, TOOL_SCALE)
		if okModel and model then
			local basePos = worldPoint(b.origin, SHOP_X - 0.5, spot.y + riser, spot.z)
			model:PivotTo(CFrame.lookAt(basePos, basePos + toPlayers) * CFrame.Angles(0, math.rad(25), 0))
			model.Parent = b.model
			b.count += #model:GetChildren()
		end

		local cost = Config.ToolCost(i, levelIndex) or 0
		-- Lower shelf: the tag stands on the front edge. Upper shelf: it hangs under the lip, so it
		-- doesn't hide the tool from someone looking up at it.
		local tagY = if spot.y &gt; shelfYs[1] then spot.y - 1.4 else spot.y + 1.1
		local tagPos = worldPoint(b.origin, x1 - 0.5, tagY, spot.z)
		local tag, tagGui = signBoard(b, "PriceTag_" .. i, Vector3.new(6, 2, 0.2), tagPos, toPlayers, Color3.fromRGB(255, 250, 235))
		tag.CFrame = tag.CFrame * CFrame.Angles(math.rad(if spot.y &gt; shelfYs[1] then 12 else -12), 0, 0)
		tag:SetAttribute("ToolIndex", i)
		guiText(tagGui, "Title", tool.Icon .. " " .. tool.Name, UDim2.fromScale(0.03, 0.02), UDim2.fromScale(0.94, 0.5), Color3.new(1, 1, 1))
		guiText(tagGui, "Price", "💰 " .. Format.Short(cost), UDim2.fromScale(0.03, 0.52), UDim2.fromScale(0.94, 0.46), Color3.fromRGB(255, 210, 60))

		local prompt = Instance.new("ProximityPrompt")
		prompt.ActionText = "Buy"
		prompt.ObjectText = string.format("%s  💰%s", tool.Name, Format.Short(cost))
		prompt.HoldDuration = 0
		prompt.RequiresLineOfSight = false
		prompt.MaxActivationDistance = 14
		prompt:SetAttribute("BuyTool", i)
		prompt.Parent = pedestal
	end

	return worldPoint(b.origin, SHOP_X + depth, 0, (z0 + z1) / 2)
end

----------------------------------------------------------------------------------------------------
-- Dish layout
----------------------------------------------------------------------------------------------------

type PlacedDish = {
	Id: number,
	Kind: string,
	Model: Model,
	Grime: { BasePart },
	Center: Vector3,
}

type Slot = { x: number, y: number, z: number }

local function grid(xs: { number }, zs: { number }, y: number): { Slot }
	local slots = {}
	for _, z in zs do
		for _, x in xs do
			table.insert(slots, { x = x, y = y, z = z })
		end
	end
	return slots
end

-- Front-to-back, filling every row a little before moving back, so small loads still look spread out.
local function plateSlots(): { Slot }
	local slots = {}
	for _, z in PLATE_Z do
		for _, x in PLATE_ROW_X do
			table.insert(slots, { x = x, y = BOTTOM_RACK_Y, z = z })
		end
	end
	return slots
end

local function listSlots(list: { { x: number, z: number } }): { Slot }
	local slots = {}
	for _, s in list do
		table.insert(slots, { x = s.x, y = BOTTOM_RACK_Y, z = s.z })
	end
	return slots
end

-- Cutlery shares one basket: each kind takes every third slot so the basket looks mixed.
local function basketSlots(offset: number): { Slot }
	local all = grid(BASKET_X, BASKET_Z, BOTTOM_RACK_Y + 0.6)
	local slots = {}
	for i = offset, #all, 3 do
		table.insert(slots, all[i])
	end
	return slots
end

local KIND_SLOTS: { [string]: () -&gt; { Slot } } = {
	Plate = plateSlots,
	Bowl = function()
		return grid(BOWL_X, BOWL_Z, TOP_RACK_Y)
	end,
	Cup = function()
		return grid(CUP_X, CUP_Z, TOP_RACK_Y)
	end,
	Glass = function()
		return grid(GLASS_X, GLASS_Z, TOP_RACK_Y)
	end,
	Pan = function()
		return listSlots(PAN_SLOTS)
	end,
	Pot = function()
		return listSlots(POT_SLOTS)
	end,
	Fork = function()
		return basketSlots(1)
	end,
	Knife = function()
		return basketSlots(2)
	end,
	Spoon = function()
		return basketSlots(3)
	end,
}

-- The CFrame DishFactory builds a dish at: contact point + orientation for that kind.
local function dishFrame(origin: CFrame, kind: string, slot: Slot, rng: Random): CFrame
	local toDoor = -origin.LookVector
	if kind == "Plate" then
		-- Plates face the door, with a tiny random lean so the rows don't look copy-pasted.
		return footprint(origin, slot.x, slot.y, slot.z, toDoor) * CFrame.Angles(math.rad(rng:NextNumber(-4, 4)), 0, 0)
	elseif kind == "Bowl" then
		-- Lean the opening toward the door so the inside is visible and reachable.
		local r = DishFactory.Size("Bowl").Diameter / 2
		local lift = r * (1 - math.cos(BOWL_TILT)) + 0.2
		return footprint(origin, slot.x, slot.y + lift, slot.z) * CFrame.Angles(BOWL_TILT, 0, 0)
	elseif kind == "Pan" then
		local r = DishFactory.Size("Pan").Diameter / 2
		local lift = r * math.sin(PAN_TILT) + 0.2
		-- Spin about the pan's own axis so the handle points up and back, away from the pots.
		return footprint(origin, slot.x, slot.y + lift, slot.z) * CFrame.Angles(PAN_TILT, 0, 0) * CFrame.Angles(0, math.pi / 2, 0)
	elseif kind == "Fork" or kind == "Knife" or kind == "Spoon" then
		return footprint(origin, slot.x, slot.y, slot.z, toDoor) * CFrame.Angles(0, math.rad(rng:NextNumber(-20, 20)), math.rad(rng:NextNumber(-6, 6)))
	end
	return footprint(origin, slot.x, slot.y, slot.z, toDoor) * CFrame.Angles(0, rng:NextNumber() * math.pi * 2, 0)
end

----------------------------------------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------------------------------------

function ArenaBuilder.Init()
	getArenasFolder()
end

function ArenaBuilder.SlotOrigin(slot: number): CFrame
	local w = Config.World
	local pos = w.ArenaRowStart + w.ArenaSpacing * (slot - 1)
	return CFrame.new(pos)
end

function ArenaBuilder.Build(slot: number, levelIndex: number, options: { GrimeScale: number, GoldenChance: number }): any
	assert(type(slot) == "number", "ArenaBuilder.Build: slot must be a number")
	local level = Config.GetLevel(levelIndex)
	local theme = level.Theme
	local origin = ArenaBuilder.SlotOrigin(slot)
	local rng = Random.new()
	local grimeScale = (options and options.GrimeScale) or 1
	local goldenChance = (options and options.GoldenChance) or level.GoldenChance

	local arenasFolder = getArenasFolder()
	local name = "Arena_" .. slot
	local existing = arenasFolder:FindFirstChild(name)
	if existing then
		existing:Destroy()
	end

	local model = Instance.new("Model")
	model.Name = name
	model.Parent = arenasFolder -- live in workspace now, so dish raycasts work as we build

	local dishesFolder = Instance.new("Folder")
	dishesFolder.Name = "Dishes"
	dishesFolder.Parent = model

	local grimeFolder = Instance.new("Folder")
	grimeFolder.Name = "Grime"
	grimeFolder.Parent = model

	local b: Builder = { model = model, origin = origin, count = 0 }
	local pending = 0
	local function yieldTick()
		if b.count - pending &gt;= YIELD_EVERY then
			pending = b.count
			task.wait()
		end
	end

	buildKitchen(b)
	yieldTick()
	buildTub(b, theme)
	buildDoor(b, theme)
	yieldTick()
	buildRack(b, theme, BOTTOM_RACK_Y, BOTTOM_RACK_Z, true)
	yieldTick()
	buildRack(b, theme, TOP_RACK_Y, TOP_RACK_Z, true)
	yieldTick()
	buildTines(b, theme)
	buildRamp(b, theme)
	buildCutleryBasket(b, theme)
	buildSprayArms(b, theme)
	buildLifts(b, theme)
	local drainPos = buildDrain(b, theme)
	local stationPos = buildShop(b, theme, levelIndex)
	yieldTick()

	local dishes: { [number]: PlacedDish } = {}
	local nextId = 0
	local totalGrime = 0
	for _, kind in Config.DishKinds do
		local wantCount = level.Dishes[kind] or 0
		local slotsFn = KIND_SLOTS[kind]
		if wantCount &gt; 0 and slotsFn then
			local spotsPerDish = math.max(1, math.floor((level.Spots[kind] or 1) * grimeScale + 0.5))
			local slots = slotsFn()
			if wantCount &gt; #slots then
				warn(string.format("[ArenaBuilder] Only %d slots for %d %s; filling what fits", #slots, wantCount, kind))
			end
			for i = 1, math.min(wantCount, #slots) do
				local cf = dishFrame(origin, kind, slots[i], rng)
				local dish = DishFactory.BuildDish(kind, cf, theme, rng)
				dish.Parent = dishesFolder

				nextId += 1
				local grime = DishFactory.ApplyGrime(dish, nextId, spotsPerDish, levelIndex, rng, goldenChance, grimeFolder)
				dishes[nextId] = {
					Id = nextId,
					Kind = kind,
					Model = dish,
					Grime = grime,
					Center = dish:GetPivot().Position,
				}
				totalGrime += #grime
				b.count += #dish:GetChildren() + #grime * 5
				yieldTick()
			end
		end
	end

	model:SetAttribute("Level", levelIndex)
	model:SetAttribute("Total", totalGrime)
	model:SetAttribute("Cleaned", 0)

	local spawns: { CFrame } = {}
	for _, x in { -9, -3, 3, 9 } do
		table.insert(spawns, footprint(origin, x, 0.5, SPAWN_Z))
	end

	local arena = {
		Slot = slot,
		Name = name,
		Model = model,
		Origin = origin,
		Spawns = spawns,
		DrainPosition = drainPos,
		DrainRadius = Config.Round.DrainRadius,
		StationPosition = stationPos,
		GrimeFolder = grimeFolder,
		Dishes = dishes,
		TotalGrime = totalGrime,
		KillY = origin.Position.Y - 14, -- the kitchen floor is at -24
	}
	return arena
end

function ArenaBuilder.Destroy(arena: any)
	if not arena then
		return
	end
	if typeof(arena.Model) == "Instance" and arena.Model.Parent then
		arena.Model:Destroy()
	end
end

return ArenaBuilder</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000000F"><Properties><string name="Name">Characters</string><ProtectedString name="Source">-- Character helpers shared by every server service: collision groups, teleporting,
-- walk speed that survives respawns, and "where should this player respawn".

local Players = game:GetService("Players")
local PhysicsService = game:GetService("PhysicsService")

local Characters = {}

Characters.Groups = {
	Players = "Players", -- every character by default (players never collide with each other)
	PartyMember = "PartyMember", -- characters waiting inside a party pad (the pad's walls block them)
	PadBarrier = "PadBarrier", -- pad walls: only block PartyMember
	NoCollide = "NoCollide", -- decoration / grime / effects: collide with nothing
}

local groupOf: { [Player]: string } = {}
local walkSpeedOf: { [Player]: number? } = {}
local respawnResolvers: { (Player) -&gt; CFrame? } = {}

local function registerGroup(name: string)
	local ok = pcall(function()
		if not workspace:IsCollisionGroupRegistered(name) then
			workspace:RegisterCollisionGroup(name)
		end
	end)
	if not ok then
		-- Older engines: collision groups still live on PhysicsService.
		pcall(function()
			if not PhysicsService:IsCollisionGroupRegistered(name) then
				PhysicsService:RegisterCollisionGroup(name)
			end
		end)
	end
end

local function setCollidable(a: string, b: string, collidable: boolean)
	local ok = pcall(function()
		workspace:CollisionGroupSetCollidable(a, b, collidable)
	end)
	if not ok then
		pcall(function()
			PhysicsService:CollisionGroupSetCollidable(a, b, collidable)
		end)
	end
end

local function applyGroup(character: Model, group: string)
	for _, d in character:GetDescendants() do
		if d:IsA("BasePart") then
			d.CollisionGroup = group
		end
	end
end

local function onCharacterAdded(player: Player, character: Model)
	applyGroup(character, groupOf[player] or Characters.Groups.Players)
	-- Accessories and tools arrive after CharacterAdded; keep them in the same group.
	character.DescendantAdded:Connect(function(d)
		if d:IsA("BasePart") then
			d.CollisionGroup = groupOf[player] or Characters.Groups.Players
		end
	end)

	local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
	local speed = walkSpeedOf[player]
	if humanoid and speed then
		humanoid.WalkSpeed = speed
	end

	-- Let services decide where this player should be (party pad, dishwasher, lobby).
	task.defer(function()
		for _, resolve in respawnResolvers do
			local ok, cf = pcall(resolve, player)
			if ok and cf then
				Characters.Teleport(player, cf)
				break
			end
		end
	end)
end

-- Call once from Main before anything else touches characters.
function Characters.Setup()
	for _, name in Characters.Groups :: { [string]: string } do
		registerGroup(name)
	end
	local g = Characters.Groups
	setCollidable(g.Players, g.Players, false)
	setCollidable(g.Players, g.PartyMember, false)
	setCollidable(g.PartyMember, g.PartyMember, false)
	setCollidable(g.PadBarrier, "Default", false)
	setCollidable(g.PadBarrier, g.Players, false)
	setCollidable(g.PadBarrier, g.PartyMember, true)
	setCollidable(g.PadBarrier, g.NoCollide, false)
	for _, other in { "Default", g.Players, g.PartyMember, g.NoCollide } do
		setCollidable(g.NoCollide, other, false)
	end

	local function hook(player: Player)
		player.CharacterAdded:Connect(function(character)
			onCharacterAdded(player, character)
		end)
		if player.Character then
			onCharacterAdded(player, player.Character)
		end
	end
	Players.PlayerAdded:Connect(hook)
	for _, p in Players:GetPlayers() do
		hook(p)
	end
	Players.PlayerRemoving:Connect(function(p)
		groupOf[p] = nil
		walkSpeedOf[p] = nil
	end)
end

-- Put a player's character (now and after every respawn) into a collision group.
function Characters.SetGroup(player: Player, group: string)
	groupOf[player] = group
	if player.Character then
		applyGroup(player.Character, group)
	end
end

function Characters.GetRoot(player: Player): BasePart?
	local character = player.Character
	if not character then
		return nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health &lt;= 0 then
		return nil
	end
	return character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

function Characters.IsAlive(player: Player): boolean
	return Characters.GetRoot(player) ~= nil
end

-- Moves a character to stand at `cframe` (feet roughly at cframe.Position). Returns false if the
-- player has no living character. Velocity is cleared so nobody keeps flying after a teleport.
function Characters.Teleport(player: Player, cframe: CFrame): boolean
	local character = player.Character
	local root = Characters.GetRoot(player)
	if not character or not root then
		return false
	end
	if workspace.StreamingEnabled then
		pcall(function()
			player:RequestStreamAroundAsync(cframe.Position, 2)
		end)
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local lift = (humanoid and humanoid.HipHeight or 2) + root.Size.Y / 2 + 0.5
	character:PivotTo(cframe + Vector3.new(0, lift, 0))
	for _, d in character:GetDescendants() do
		if d:IsA("BasePart") then
			d.AssemblyLinearVelocity = Vector3.zero
			d.AssemblyAngularVelocity = Vector3.zero
		end
	end
	return true
end

-- Walk speed that is re-applied after every respawn. nil resets to the lobby default
-- (StarterPlayer.CharacterWalkSpeed, which Main sets from Config.World.LobbyWalkSpeed).
function Characters.SetWalkSpeed(player: Player, speed: number?)
	walkSpeedOf[player] = speed
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.WalkSpeed = speed or game:GetService("StarterPlayer").CharacterWalkSpeed
	end
end

--[[
	Register a function that says where a player should appear after (re)spawning.
	It returns a CFrame to teleport them there, or nil to let the next resolver (or the
	normal SpawnLocation) decide. Resolvers are asked in the order they were added.
]]
function Characters.AddRespawnResolver(resolver: (Player) -&gt; CFrame?)
	table.insert(respawnResolvers, resolver)
end

return Characters</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000010"><Properties><string name="Name">DataService</string><ProtectedString name="Source">-- DataService: every player's permanent profile (Bubbles, perks, pets, unlocks, best times, stats).
--
-- Life of a profile:
--   join     -&gt; a Session is created and loaded in the background. The load is one UpdateAsync that
--               takes a session lock ({ JobId, Time }) so two servers never own the same save. If
--               another server holds a fresh lock (a server hop in progress), we wait and retry, and
--               steal the lock after LOCK_RETRIES attempts (that server has probably crashed).
--   playing  -&gt; services read and change the profile table directly (Get), or through the helpers
--               below. PushMeta sends the client a MetaState snapshot (coalesced to one per 0.1 s).
--   autosave -&gt; every AUTOSAVE_INTERVAL seconds (plus a random offset per player), the profile is
--               written and the lock refreshed. A save only lands while we still own the lock.
--   leave    -&gt; a final save that also clears the lock, so the next server can load straight away.
--
-- Data is NEVER wiped. If a save exists but can't be read (DataStore errors after every retry, or a
-- damaged record), the player plays on a temporary default profile that is never saved, and is told
-- so. Only profiles that loaded successfully (and whose lock we still hold) are ever written.
--
-- Offline mode (unpublished place, or Studio without API access): profiles live in memory only,
-- everything else works the same, and each player is told once that progress won't save.
--
-- Passes are runtime-only (MarketService fills them in) and never saved.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Types = require(Shared:WaitForChild("Types"))
local Util = require(Shared:WaitForChild("Util"))

local DataService = {}

----------------------------------------------------------------------------------------------------
-- Tunables
----------------------------------------------------------------------------------------------------

local STORE_NAME = "RinseCycle_Profiles_v1"
local KEY_PREFIX = "u_"
local PROFILE_VERSION = 1

local LOCK_TTL = 1800 -- seconds; an older lock belongs to a server that died without releasing it
local LOCK_RETRIES = 6 -- locked loads to wait through before stealing the lock
local LOCK_WAIT_MIN, LOCK_WAIT_MAX = 3, 5 -- seconds between locked load attempts
local LOAD_ATTEMPTS = 6 -- DataStore errors tolerated while loading before falling back to a temp profile
local FINAL_SAVE_ATTEMPTS = 3
local RECEIPT_SAVE_ATTEMPTS = 2

local AUTOSAVE_INTERVAL = 120
local AUTOSAVE_JITTER = 30 -- random extra seconds before a player's first autosave, so saves spread out
local AUTOSAVE_TICK = 5 -- how often the autosave loop looks for due saves
local AUTOSAVE_RETRY = 30 -- a failed autosave tries again this soon
local SAVE_SOON_DELAY = 10 -- a level unlock is written within this many seconds
local SHUTDOWN_WAIT = 25

local PUSH_COALESCE = 0.1
local MAX_RECEIPTS = 50
local PROBE_WAIT = 5 -- max seconds IsOffline() waits for the Studio probe
local SAME_USER_WAIT = 30 -- max seconds a rejoin waits for this server to finish the previous session
local NOTICE_FALLBACK = 8 -- toasts go out this long after loading even if the client never asked for meta
local NOTICE_AFTER_READY = 1.5 -- ...or this long after the client's first GetMeta (its UI is up by then)
local META_REQUESTS_PER_SECOND = 3 -- GetMeta budget per player (burst of the same size)

local MSG_OFFLINE = "Progress won't save in this test (turn on Studio API access)."
local MSG_LOAD_FAILED = "We couldn't load your save - progress this session won't be saved. Rejoin to try again."
local MSG_LOCK_LOST = "Your save was opened on another server - progress here won't be saved. Rejoin to fix it."

----------------------------------------------------------------------------------------------------
-- Types
----------------------------------------------------------------------------------------------------

export type Profile = {
	Version: number,
	Bubbles: number,
	Gems: number, -- premium currency
	Rank: string, -- equipped rank id ("" = none)
	Ranks: { string }, -- owned rank ids
	Perks: { [string]: number }, -- Config.Perks[i].Id -&gt; level
	Pets: { Types.PetEntry },
	Equipped: { string }, -- Uids, slot order
	NextUid: number,
	Unlocked: number, -- highest level index the player may pick
	BestTimes: { number }, -- one per Config.Levels entry, seconds, 0 = never cleared
	Stats: {
		Runs: number,
		DishesCleaned: number,
		GrimeCleaned: number,
		EggsHatched: number,
		BubblesEarned: number,
	},
	Receipts: { string }, -- recent developer-product PurchaseIds, newest last
}

-- A Bubbles or stat change that arrived before the profile finished loading (replayed on load).
type PendingChange = { Stat: string?, Amount: number } -- Stat nil = Bubbles

-- A one-shot gate: threads that wait on it sleep until it opens (or their timeout passes).
type Latch = { Open: boolean, Threads: { thread } }

type Session = {
	Player: Player,
	UserId: number,
	Key: string,
	Profile: Profile?, -- nil while loading
	CanSave: boolean, -- true only for a profile loaded from the DataStore whose lock we still hold
	Left: boolean, -- PlayerRemoving has fired
	Finalizing: boolean, -- the final (lock-releasing) save has started; nothing is saved after it
	Released: boolean, -- the lock has been cleared
	Busy: boolean, -- a save is in flight (saves for one session never overlap)
	SaveQueue: { thread },
	Loaded: Latch, -- opens when Profile is set, or the player leaves
	Done: Latch, -- opens when this session is completely finished (final save landed or given up)
	Previous: Session?, -- this user's previous session on this server, if it was still finishing
	NextAutosave: number, -- os.clock()
	Pending: { PendingChange }, -- Bubbles/stat changes that arrived while the profile was still loading
	Notices: { { string } }, -- { text, kind } toasts waiting for the client's UI
	ClientReady: boolean, -- the client has asked for its MetaState at least once
}

----------------------------------------------------------------------------------------------------
-- State
----------------------------------------------------------------------------------------------------

local TEMPLATE: Profile = {
	Version = PROFILE_VERSION,
	Bubbles = 0,
	Gems = 0,
	Rank = "",
	Ranks = {},
	Perks = {},
	Pets = {},
	Equipped = {},
	NextUid = 1,
	Unlocked = 1,
	BestTimes = {},
	Stats = { Runs = 0, DishesCleaned = 0, GrimeCleaned = 0, EggsHatched = 0, BubblesEarned = 0 },
	Receipts = {},
}
for _, perk in Config.Perks do
	TEMPLATE.Perks[perk.Id] = 0
end
for i = 1, #Config.Levels do
	TEMPLATE.BestTimes[i] = 0
end

local sessions: { [Player]: Session } = {}
local lastSessionOf: { [number]: Session } = {} -- userId -&gt; newest session on this server (until Done)
local passesOf: { [Player]: { [string]: boolean } } = {}
local pushQueued: { [Player]: boolean } = {}
local metaBudget: { [Player]: { Tokens: number, At: number } } = {}

local detection: Latch = { Open = false, Threads = {} } -- opens once we know whether we're offline
local offline = false
local shuttingDown = false
local activeJobs = 0 -- loads and saves in flight (BindToClose waits for these)
local initialized = false
local started = false

local store: DataStore? = nil
local rng = Random.new()

local metaRemote: RemoteEvent
local notifyRemote: RemoteEvent

DataService.ProfileLoaded = Util.Signal.new() -- (player, profile), for loaded, temporary and offline profiles
DataService.PassesChanged = Util.Signal.new() -- (player), after a pass (or pass-limited Equipped) changes

----------------------------------------------------------------------------------------------------
-- Small helpers
----------------------------------------------------------------------------------------------------

local function isFinite(n: any): boolean
	return type(n) == "number" and n == n and n ~= math.huge and n ~= -math.huge
end

-- A finite, non-negative whole number, or `default`.
local function toCount(value: any, default: number): number
	if not isFinite(value) then
		return default
	end
	return math.max(0, math.floor(value))
end

local function isPlayer(value: any): boolean
	return typeof(value) == "Instance" and value:IsA("Player")
end

local function isHere(player: Player): boolean
	return player.Parent == Players
end

local function newLatch(): Latch
	return { Open = false, Threads = {} }
end

local function openLatch(latch: Latch)
	if latch.Open then
		return
	end
	latch.Open = true
	local threads = latch.Threads
	latch.Threads = {}
	for _, thread in threads do
		task.spawn(thread)
	end
end

-- Yields until the latch opens or `timeout` seconds pass. Returns true if it opened.
local function waitLatch(latch: Latch, timeout: number): boolean
	if latch.Open then
		return true
	end
	local thread = coroutine.running()
	table.insert(latch.Threads, thread)
	task.delay(timeout, function()
		-- Still waiting? Then the latch never opened for us: wake up empty-handed.
		local index = table.find(latch.Threads, thread)
		if index then
			table.remove(latch.Threads, index)
			task.spawn(thread)
		end
	end)
	coroutine.yield()
	return latch.Open
end

-- Runs fn(...) as a tracked job so BindToClose knows to wait for it. Never throws.
local function track(fn: (...any) -&gt; ...any, ...: any)
	activeJobs += 1
	local ok, err = pcall(fn, ...)
	activeJobs -= 1
	if not ok then
		warn("[DataService] " .. tostring(err))
	end
end

local function getStore(): DataStore?
	if store then
		return store
	end
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = result
	end
	return store
end

local function newProfile(): Profile
	return Util.DeepCopy(TEMPLATE)
end

----------------------------------------------------------------------------------------------------
-- Offline detection
----------------------------------------------------------------------------------------------------

local function setOffline(value: boolean, reason: string?)
	offline = value
	if value then
		warn("[DataService] Offline mode: progress will not be saved (" .. tostring(reason) .. ")")
	end
	openLatch(detection)
end

-- A live server always has DataStores (an outage there is handled by retries and temp profiles, never
-- by turning saving off for the whole server). Only Studio can lack API access, so only Studio probes.
local function detectOffline()
	if game.PlaceId == 0 then
		setOffline(true, "the place isn't published")
		return
	end
	if not RunService:IsStudio() then
		setOffline(false)
		return
	end
	task.spawn(function()
		local ok, err = pcall(function()
			DataStoreService:GetDataStore(STORE_NAME):GetAsync("__probe")
		end)
		if ok then
			setOffline(false)
			return
		end
		local message = tostring(err)
		if
			string.find(message, "StudioAccessToApisNotAllowed", 1, true)
			or string.find(message, "API", 1, true)
			or string.find(string.lower(message), "publish", 1, true)
		then
			setOffline(true, message)
		else
			-- Some other hiccup: stay online. Loads retry and fall back to temp profiles if it persists.
			warn("[DataService] DataStore probe failed: " .. message)
			setOffline(false)
		end
	end)
end

----------------------------------------------------------------------------------------------------
-- Profile repair (runs after every load, outside the UpdateAsync transform)
----------------------------------------------------------------------------------------------------

-- Pet slots used to trim Equipped while loading. Pass ownership isn't known yet at that point, so a
-- slot pass that is on sale counts as owned; SetPass trims again once MarketService knows for sure.
local function loadSlotCap(player: Player, profile: Profile): number
	local passes = table.clone(passesOf[player] or {})
	local pass = Config.GetPass("PetSlots")
	if pass and type(pass.Id) == "number" and pass.Id &gt; 0 and passes.PetSlots == nil then
		passes.PetSlots = true
	end
	return Config.PetSlots(profile.Perks, passes)
end

local function sanitizeProfile(profile: Profile, player: Player)
	local p = profile :: any
	p.Lock = nil
	-- Reconcile only fills missing keys; wrong types from damaged or ancient saves are repaired below.
	Util.Reconcile(p, TEMPLATE :: any)

	p.Version = if isFinite(p.Version) then math.max(p.Version, PROFILE_VERSION) else PROFILE_VERSION
	p.Bubbles = toCount(p.Bubbles, 0)
	p.Gems = toCount(p.Gems, 0)
	local ranks, seenRank = {}, {}
	for _, id in (if type(p.Ranks) == "table" then p.Ranks else {}) do
		if type(id) == "string" and Config.GetRank(id) and not seenRank[id] then
			seenRank[id] = true
			table.insert(ranks, id)
		end
	end
	p.Ranks = ranks
	if type(p.Rank) ~= "string" or not seenRank[p.Rank] then
		p.Rank = ""
	end

	if type(p.Perks) ~= "table" then
		p.Perks = Util.DeepCopy(TEMPLATE.Perks)
	end
	for _, perk in Config.Perks do
		p.Perks[perk.Id] = toCount(p.Perks[perk.Id], 0)
	end

	-- Pets: keep every well-formed entry (extra fields included). Uids become strings, and duplicate
	-- or missing uids get fresh ones so every pet stays addressable.
	local rawPets = if type(p.Pets) == "table" then p.Pets else {}
	local pets, seen, needsUid = {}, {}, {}
	local maxUid = 0
	for _, entry in rawPets do
		if type(entry) == "table" and type(entry.Id) == "string" then
			local uid = entry.Uid
			if isFinite(uid) then
				uid = tostring(math.floor(uid))
			end
			if type(uid) ~= "string" or uid == "" or seen[uid] then
				table.insert(needsUid, entry)
			else
				seen[uid] = true
				entry.Uid = uid
				table.insert(pets, entry)
				local n = tonumber(uid)
				if n and isFinite(n) and n &gt; maxUid and n &lt; 1e12 then
					maxUid = math.floor(n)
				end
			end
		end
	end
	local nextUid = math.max(toCount(p.NextUid, 1), maxUid + 1, 1)
	for _, entry in needsUid do
		entry.Uid = tostring(nextUid)
		nextUid += 1
		table.insert(pets, entry)
	end
	p.Pets = pets
	p.NextUid = nextUid

	-- Equipped: only uids that exist (with a pet id the game knows), no repeats, at most the slots.
	local idOf = {}
	for _, pet in pets do
		idOf[pet.Uid] = pet.Id
	end
	local cap = loadSlotCap(player, p)
	local equipped, used = {}, {}
	for _, uid in (if type(p.Equipped) == "table" then p.Equipped else {}) do
		if isFinite(uid) then
			uid = tostring(math.floor(uid))
		end
		if type(uid) == "string" and not used[uid] and idOf[uid] and Config.Pets[idOf[uid]] and #equipped &lt; cap then
			used[uid] = true
			table.insert(equipped, uid)
		end
	end
	p.Equipped = equipped

	-- BestTimes: exactly one entry per level.
	local rawTimes = if type(p.BestTimes) == "table" then p.BestTimes else {}
	local times = {}
	for i = 1, #Config.Levels do
		local t = rawTimes[i]
		times[i] = if isFinite(t) and t &gt; 0 then t else 0
	end
	p.BestTimes = times

	-- Unlocked: a valid level, and never below "one past every level already cleared".
	local unlocked = math.clamp(toCount(p.Unlocked, 1), 1, #Config.Levels)
	for i, t in times do
		if t &gt; 0 then
			unlocked = math.max(unlocked, math.min(i + 1, #Config.Levels))
		end
	end
	p.Unlocked = unlocked

	if type(p.Stats) ~= "table" then
		p.Stats = Util.DeepCopy(TEMPLATE.Stats)
	end
	for key in TEMPLATE.Stats :: any do
		p.Stats[key] = toCount(p.Stats[key], 0)
	end

	local receipts = {}
	if type(p.Receipts) == "table" then
		for _, id in p.Receipts do
			if type(id) == "string" then
				table.insert(receipts, id)
			end
		end
	end
	while #receipts &gt; MAX_RECEIPTS do
		table.remove(receipts, 1)
	end
	p.Receipts = receipts
end

-- Copy of the profile that is safe to store: no runtime-only keys ("Lock", anything starting with
-- "_"), no Instances or functions, and no NaN/inf (which the DataStore refuses to encode).
local function cleanValue(value: any, depth: number): any
	local kind = type(value)
	if kind == "number" then
		return if isFinite(value) then value else 0
	elseif kind == "string" or kind == "boolean" then
		return value
	elseif kind == "table" and depth &lt; 8 then
		local out = {}
		for k, v in value do
			if type(k) == "string" or type(k) == "number" then
				out[k] = cleanValue(v, depth + 1)
			end
		end
		return out
	end
	return nil
end

local function serialize(profile: Profile): { [string]: any }
	local out = {}
	for key, value in profile :: any do
		if type(key) == "string" and key ~= "Lock" and string.sub(key, 1, 1) ~= "_" then
			out[key] = cleanValue(value, 1)
		end
	end
	return out
end

----------------------------------------------------------------------------------------------------
-- Profile edits shared by the public API and the "arrived while loading" replay
----------------------------------------------------------------------------------------------------

local function applyBubbles(profile: Profile, amount: number)
	profile.Bubbles = math.max(0, profile.Bubbles + amount)
	if amount &gt; 0 then
		profile.Stats.BubblesEarned += amount
	end
end

local function applyStat(profile: Profile, statName: string, amount: number)
	local stats = profile.Stats :: any
	stats[statName] = math.max(0, (stats[statName] or 0) + amount)
end

----------------------------------------------------------------------------------------------------
-- MetaState, leaderstats and toasts
----------------------------------------------------------------------------------------------------

local function buildMeta(player: Player, profile: Profile): Types.MetaState
	local passes = passesOf[player] or {}
	local passCopy = {}
	for _, pass in Config.GamePasses do
		passCopy[pass.Key] = passes[pass.Key] == true
	end
	local perks = {}
	for _, perk in Config.Perks do
		perks[perk.Id] = profile.Perks[perk.Id] or 0
	end
	-- Pets whose id was removed from Config stay in the save but are hidden from the client, which
	-- could not draw them.
	local pets, known = {}, {}
	for _, pet in profile.Pets do
		if type(pet) == "table" and Config.Pets[pet.Id] then
			table.insert(pets, { Uid = pet.Uid, Id = pet.Id })
			known[pet.Uid] = true
		end
	end
	local equipped = {}
	for _, uid in profile.Equipped do
		if known[uid] then
			table.insert(equipped, uid)
		end
	end
	local stats = profile.Stats
	local state: Types.MetaState = {
		Bubbles = profile.Bubbles,
		Gems = profile.Gems,
		Rank = profile.Rank,
		Ranks = table.clone(profile.Ranks),
		Perks = perks,
		Pets = pets,
		Equipped = equipped,
		PetSlots = Config.PetSlots(profile.Perks, passes),
		MaxPets = Config.PetRules.MaxInventory,
		Unlocked = profile.Unlocked,
		BestTimes = table.clone(profile.BestTimes),
		Stats = {
			Runs = stats.Runs,
			DishesCleaned = stats.DishesCleaned,
			GrimeCleaned = stats.GrimeCleaned,
			EggsHatched = stats.EggsHatched,
			BubblesEarned = stats.BubblesEarned,
		},
		Passes = passCopy,
	}
	return state
end

local function setupLeaderstats(player: Player)
	if player:FindFirstChild("leaderstats") then
		return
	end
	local folder = Instance.new("Folder")
	folder.Name = "leaderstats"
	-- Children are created in display order: Bubbles, then Dishes.
	for _, name in { "Bubbles", "Dishes" } do
		local value = Instance.new("IntValue")
		value.Name = name
		value.Value = 0
		value.Parent = folder
	end
	folder.Parent = player
end

local function setLeaderstat(player: Player, name: string, amount: number)
	local folder = player:FindFirstChild("leaderstats")
	local value = folder and folder:FindFirstChild(name)
	if value and value:IsA("IntValue") then
		value.Value = math.floor(amount)
	end
end

local function pushNow(player: Player)
	local session = sessions[player]
	local profile = session and session.Profile
	if not profile or not isHere(player) then
		return
	end
	player:SetAttribute("Bubbles", profile.Bubbles)
	setLeaderstat(player, "Bubbles", profile.Bubbles)
	setLeaderstat(player, "Dishes", profile.Stats.DishesCleaned)
	metaRemote:FireClient(player, buildMeta(player, profile))
end

local function flushNotices(session: Session)
	local player = session.Player
	if #session.Notices == 0 or not isHere(player) then
		return
	end
	local list = session.Notices
	session.Notices = {}
	for _, notice in list do
		notifyRemote:FireClient(player, notice[1], notice[2])
	end
end

-- Toasts sent the instant a player joins can arrive before their UI exists, so they wait until the
-- client has asked for its MetaState (or a fallback delay passes).
local function queueNotice(session: Session, text: string, kind: string)
	table.insert(session.Notices, { text, kind })
	task.delay(if session.ClientReady then NOTICE_AFTER_READY else NOTICE_FALLBACK, flushNotices, session)
end

----------------------------------------------------------------------------------------------------
-- Saving
----------------------------------------------------------------------------------------------------

local function ownsLock(record: { [string]: any }): boolean
	local lock = record.Lock
	return type(lock) == "table" and lock.JobId == game.JobId
end

local function lockedElsewhere(record: { [string]: any }): boolean
	local lock = record.Lock
	if type(lock) ~= "table" or lock.JobId == game.JobId or not isFinite(lock.Time) then
		return false
	end
	return os.time() - lock.Time &lt; LOCK_TTL
end

-- Saves for one session run one at a time (an autosave and the final save must never race).
local function acquireSaveSlot(session: Session)
	while session.Busy do
		table.insert(session.SaveQueue, coroutine.running())
		coroutine.yield()
	end
	session.Busy = true
end

local function releaseSaveSlot(session: Session)
	session.Busy = false
	local nextThread = table.remove(session.SaveQueue, 1)
	if nextThread then
		task.spawn(nextThread)
	end
end

-- One UpdateAsync: writes the profile and refreshes the lock (or clears it when `release`).
-- It only writes while this server still owns the lock; otherwise saving stops for this session.
local function writeProfile(session: Session, release: boolean): boolean
	local profile = session.Profile
	local dataStore = getStore()
	if not profile or not dataStore then
		return false
	end
	-- Everything that could be slow happens before UpdateAsync: the transform itself must not yield.
	local payload = serialize(profile)
	local userIds = { session.UserId }
	local outcome = "Error"
	local ok, err = pcall(function()
		dataStore:UpdateAsync(session.Key, function(old)
			if old == nil then
				outcome = "Missing" -- the save was erased (e.g. a data-removal request); don't resurrect it
				return nil
			end
			if type(old) ~= "table" or not ownsLock(old) then
				outcome = "LockLost"
				return nil
			end
			payload.Lock = if release then nil else { JobId = game.JobId, Time = os.time() }
			outcome = "Ok"
			return payload, userIds
		end)
	end)
	if not ok then
		warn(string.format("[DataService] save failed for %s: %s", session.Key, tostring(err)))
		return false
	end
	if outcome == "Ok" then
		return true
	end
	-- Another server owns this save now (or it's gone). Writing from here would clobber it.
	session.CanSave = false
	warn(string.format("[DataService] stopped saving %s (%s)", session.Key, outcome))
	if outcome == "LockLost" and not session.Left and isHere(session.Player) then
		queueNotice(session, MSG_LOCK_LOST, "Bad")
	end
	return false
end

local function saveSession(session: Session, release: boolean, attempts: number): boolean
	if not session.CanSave or not session.Profile or session.Released then
		return false
	end
	acquireSaveSlot(session)
	local saved = false
	for attempt = 1, attempts do
		if not session.CanSave or session.Released then
			break
		end
		saved = writeProfile(session, release)
		if saved or not session.CanSave then
			break
		end
		if attempt &lt; attempts then
			task.wait(attempt * 2)
		end
	end
	if saved and release then
		session.Released = true
	end
	releaseSaveSlot(session)
	return saved
end

local function autosave(session: Session)
	if not saveSession(session, false, 1) and session.CanSave and not session.Finalizing then
		session.NextAutosave = math.min(session.NextAutosave, os.clock() + AUTOSAVE_RETRY)
	end
end

-- Marks a session completely finished: wakes anyone waiting on it and forgets it.
local function finishSession(session: Session)
	openLatch(session.Loaded)
	openLatch(session.Done)
	if lastSessionOf[session.UserId] == session then
		lastSessionOf[session.UserId] = nil
	end
end

-- The last save of a session: writes the profile and releases the lock. Safe to call more than once.
local function finalize(session: Session)
	if session.Finalizing then
		return
	end
	session.Finalizing = true
	if session.CanSave and session.Profile then
		if not saveSession(session, true, FINAL_SAVE_ATTEMPTS) and session.CanSave then
			warn("[DataService] final save failed for " .. session.Key .. "; its lock expires on its own")
		end
	end
	finishSession(session)
end

----------------------------------------------------------------------------------------------------
-- Loading
----------------------------------------------------------------------------------------------------

-- Loads the record and takes the session lock. Returns:
--   "Ok", record   -&gt; we own the lock and have the data (a brand-new player gets the template)
--   "Abort", nil   -&gt; the player left or the server is closing; nothing was locked
--   "Failed", nil  -&gt; DataStore errors on every attempt, or a record we can't read
local function loadFromStore(session: Session): (string, any)
	local lockedTries, errorTries = 0, 0
	while true do
		if session.Left or shuttingDown or not isHere(session.Player) then
			return "Abort", nil
		end
		local steal = lockedTries &gt;= LOCK_RETRIES
		local status: string? = nil
		local record: any = nil
		local ok, err = false, "DataStoreService unavailable"
		local dataStore = getStore()
		if dataStore then
			local userIds = { session.UserId }
			ok, err = pcall(function()
				dataStore:UpdateAsync(session.Key, function(old)
					-- Must not yield. UpdateAsync may call this more than once; the last call wins.
					status, record = nil, nil
					if old ~= nil and type(old) ~= "table" then
						status = "Corrupt"
						return nil
					end
					if old ~= nil and not steal and lockedElsewhere(old) then
						status = "Locked"
						return nil
					end
					local data = if old ~= nil then old else Util.DeepCopy(TEMPLATE) :: any
					data.Lock = { JobId = game.JobId, Time = os.time() }
					status, record = "Ok", data
					return data, userIds
				end)
			end)
		end

		if ok and status == "Ok" then
			if steal then
				warn("[DataService] took over a stale session lock for " .. session.Key)
			end
			return "Ok", record
		elseif ok and status == "Corrupt" then
			warn("[DataService] unreadable save for " .. session.Key .. "; it will not be touched")
			return "Failed", nil
		elseif ok and status == "Locked" then
			-- Another server is still saving this player (a server hop). Give it a moment.
			lockedTries += 1
			task.wait(rng:NextNumber(LOCK_WAIT_MIN, LOCK_WAIT_MAX))
		else
			errorTries += 1
			warn(string.format("[DataService] load attempt %d for %s failed: %s", errorTries, session.Key, tostring(err)))
			if errorTries &gt;= LOAD_ATTEMPTS then
				return "Failed", nil
			end
			task.wait(math.min(1.5 * errorTries, 6) + rng:NextNumber(0, 1))
		end
	end
end

local function loadSession(session: Session)
	local player = session.Player

	-- A quick rejoin to this same server: let the previous session's final save land first, or we
	-- could read the save from before it.
	local previous = session.Previous
	session.Previous = nil
	if previous then
		waitLatch(previous.Done, SAME_USER_WAIT)
	end
	if not detection.Open then
		waitLatch(detection, PROBE_WAIT * 3)
	end

	local profile: Profile
	local canSave = false
	local notice: string? = nil
	local noticeKind = "Info"
	if offline then
		profile = newProfile()
		notice = MSG_OFFLINE
	else
		local status, record = loadFromStore(session)
		if status == "Abort" then
			finishSession(session)
			return
		end
		if status == "Ok" then
			profile = record
			canSave = true
		else
			-- Never overwrite a save we couldn't read: play on a temporary profile that is never saved.
			profile = newProfile()
			notice, noticeKind = MSG_LOAD_FAILED, "Bad"
			warn("[DataService] using a temporary unsaved profile for " .. session.Key)
		end
	end

	sanitizeProfile(profile, player)
	-- Rewards that arrived while we were loading.
	for _, change in session.Pending do
		if change.Stat then
			applyStat(profile, change.Stat, change.Amount)
		else
			applyBubbles(profile, change.Amount)
		end
	end
	session.Pending = {}

	session.Profile = profile
	session.CanSave = canSave
	session.NextAutosave = os.clock() + AUTOSAVE_INTERVAL + rng:NextNumber(0, AUTOSAVE_JITTER)

	if session.Left or not isHere(player) then
		-- They left while we were loading: hand the lock straight back.
		finalize(session)
		return
	end

	openLatch(session.Loaded)
	if notice then
		queueNotice(session, notice, noticeKind)
	end
	DataService.ProfileLoaded:Fire(player, profile)
	pushNow(player)

	if shuttingDown then
		finalize(session)
	end
end

local function ensureSession(player: Player): Session?
	local existing = sessions[player]
	if existing then
		return existing
	end
	if not isHere(player) then
		return nil
	end
	local userId = player.UserId
	local previous = lastSessionOf[userId]
	local session: Session = {
		Player = player,
		UserId = userId,
		Key = KEY_PREFIX .. tostring(userId),
		Profile = nil,
		CanSave = false,
		Left = false,
		Finalizing = false,
		Released = false,
		Busy = false,
		SaveQueue = {},
		Loaded = newLatch(),
		Done = newLatch(),
		Previous = if previous and not previous.Done.Open then previous else nil,
		NextAutosave = math.huge,
		Pending = {},
		Notices = {},
		ClientReady = false,
	}
	sessions[player] = session
	lastSessionOf[userId] = session
	if not passesOf[player] then
		passesOf[player] = {}
	end
	setupLeaderstats(player)
	task.spawn(track, loadSession, session)
	return session
end

local function onPlayerRemoving(player: Player)
	local session = sessions[player]
	sessions[player] = nil
	passesOf[player] = nil
	pushQueued[player] = nil
	metaBudget[player] = nil
	if not session then
		return
	end
	session.Left = true
	openLatch(session.Loaded) -- WaitFor callers wake up and get nil
	if session.Profile then
		task.spawn(track, finalize, session)
	end
	-- Still loading: loadSession notices Left and releases the lock itself.
end

----------------------------------------------------------------------------------------------------
-- GetMeta
----------------------------------------------------------------------------------------------------

local function allowMetaRequest(player: Player): boolean
	local now = os.clock()
	local budget = metaBudget[player]
	if not budget then
		budget = { Tokens = META_REQUESTS_PER_SECOND, At = now }
		metaBudget[player] = budget
	end
	budget.Tokens = math.min(META_REQUESTS_PER_SECOND, budget.Tokens + (now - budget.At) * META_REQUESTS_PER_SECOND)
	budget.At = now
	if budget.Tokens &lt; 1 then
		return false
	end
	budget.Tokens -= 1
	return true
end

local function onGetMeta(player: Player): Types.MetaState?
	local session = sessions[player]
	if not session or not isHere(player) or not allowMetaRequest(player) then
		return nil
	end
	if not session.ClientReady then
		-- The client's remotes are hooked up now; anything waiting to be said can go out shortly.
		session.ClientReady = true
		task.delay(NOTICE_AFTER_READY, flushNotices, session)
	end
	local profile = session.Profile
	if not profile then
		return nil
	end
	return buildMeta(player, profile)
end

----------------------------------------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------------------------------------

function DataService.Init()
	if initialized then
		return
	end
	initialized = true

	metaRemote = Remotes.Event("MetaState")
	notifyRemote = Remotes.Event("Notify")
	Remotes.Function("GetMeta").OnServerInvoke = onGetMeta

	detectOffline()

	Players.PlayerAdded:Connect(function(player)
		ensureSession(player)
	end)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, player in Players:GetPlayers() do
		ensureSession(player)
	end

	game:BindToClose(function()
		shuttingDown = true
		if not detection.Open then
			waitLatch(detection, 3)
		end
		if offline then
			return
		end
		for _, session in sessions do
			if session.Profile then
				task.spawn(track, finalize, session)
			end
		end
		-- Sessions still loading abort (or release right after loading); PlayerRemoving saves run too.
		local deadline = os.clock() + SHUTDOWN_WAIT
		while activeJobs &gt; 0 and os.clock() &lt; deadline do
			task.wait(0.25)
		end
		if activeJobs &gt; 0 then
			warn(string.format("[DataService] shutdown: %d save(s) still running after %ds", activeJobs, SHUTDOWN_WAIT))
		end
	end)
end

function DataService.Start()
	if started then
		return
	end
	started = true
	task.spawn(function()
		while true do
			task.wait(AUTOSAVE_TICK)
			if not shuttingDown and not offline then
				local now = os.clock()
				for _, session in sessions do
					if
						session.CanSave
						and session.Profile
						and not session.Finalizing
						and not session.Busy
						and now &gt;= session.NextAutosave
					then
						session.NextAutosave = now + AUTOSAVE_INTERVAL
						task.spawn(track, autosave, session)
					end
				end
			end
		end
	end)
end

-- The player's profile, or nil while it's loading (or after they left).
function DataService.Get(player: Player): Profile?
	local session = sessions[player]
	return session and session.Profile
end

-- Yields until the profile is ready (or `timeout` seconds pass, default 60, or the player leaves).
function DataService.WaitFor(player: Player, timeout: number?): Profile?
	if not isPlayer(player) then
		return nil
	end
	local session = ensureSession(player)
	if not session then
		return nil
	end
	if not session.Profile then
		waitLatch(session.Loaded, if isFinite(timeout) then math.max(0, timeout :: number) else 60)
	end
	return DataService.Get(player)
end

-- Coalesces MetaState pushes: any number of calls within PUSH_COALESCE seconds send one snapshot.
function DataService.PushMeta(player: Player)
	if not isPlayer(player) or pushQueued[player] or not sessions[player] then
		return
	end
	pushQueued[player] = true
	task.delay(PUSH_COALESCE, function()
		if not pushQueued[player] then
			return -- the player left in the meantime
		end
		pushQueued[player] = nil
		pushNow(player)
	end)
end

-- Adds (or with a negative amount, removes) Bubbles. Positive amounts also count toward
-- Stats.BubblesEarned. `reason` is only used in warnings. Returns false if nothing was applied.
function DataService.AddBubbles(player: Player, amount: number, reason: string?): boolean
	if not isFinite(amount) then
		warn("[DataService] AddBubbles ignored a bad amount (" .. tostring(reason) .. ")")
		return false
	end
	local rounded = math.floor(amount + 0.5)
	local session = sessions[player]
	if not session then
		return false
	end
	if rounded == 0 then
		return true
	end
	local profile = session.Profile
	if not profile then
		table.insert(session.Pending, { Amount = rounded })
		return true
	end
	applyBubbles(profile, rounded)
	DataService.PushMeta(player)
	return true
end

-- Takes Bubbles if the player has enough. Returns true when paid.
function DataService.SpendBubbles(player: Player, amount: number): boolean
	local profile = DataService.Get(player)
	if not profile or not isFinite(amount) or amount &lt; 0 then
		return false
	end
	local cost = math.ceil(amount)
	if profile.Bubbles &lt; cost then
		return false
	end
	profile.Bubbles -= cost
	DataService.PushMeta(player)
	return true
end

-- Gems (premium currency). Returns true when applied.
function DataService.AddGems(player: Player, amount: number): boolean
	local profile = DataService.Get(player)
	if not profile or not isFinite(amount) or amount &lt;= 0 then
		return false
	end
	profile.Gems += math.floor(amount + 0.5)
	DataService.PushMeta(player)
	return true
end

function DataService.SpendGems(player: Player, amount: number): boolean
	local profile = DataService.Get(player)
	if not profile or not isFinite(amount) or amount &lt; 0 then
		return false
	end
	local cost = math.ceil(amount)
	if profile.Gems &lt; cost then
		return false
	end
	profile.Gems -= cost
	DataService.PushMeta(player)
	return true
end

-- Adds a rank to the collection (no-op if owned). Returns true if it was new.
function DataService.AddRank(player: Player, rankId: string): boolean
	local profile = DataService.Get(player)
	if not profile or not Config.GetRank(rankId) or table.find(profile.Ranks, rankId) then
		return false
	end
	table.insert(profile.Ranks, rankId)
	DataService.PushMeta(player)
	return true
end

function DataService.SetRank(player: Player, rankId: string): boolean
	local profile = DataService.Get(player)
	if not profile or (rankId ~= "" and not table.find(profile.Ranks, rankId)) then
		return false
	end
	profile.Rank = rankId
	DataService.PushMeta(player)
	DataService.PassesChanged:Fire(player) -- same effect as a pass change: run stats recompute
	return true
end

-- Adds to one of profile.Stats (Runs, DishesCleaned, GrimeCleaned, EggsHatched, BubblesEarned).
function DataService.AddStat(player: Player, statName: string, amount: number): boolean
	if type(statName) ~= "string" or (TEMPLATE.Stats :: any)[statName] == nil or not isFinite(amount) then
		return false
	end
	local rounded = math.floor(amount + 0.5)
	local session = sessions[player]
	if not session then
		return false
	end
	if rounded == 0 then
		return true
	end
	local profile = session.Profile
	if not profile then
		table.insert(session.Pending, { Stat = statName, Amount = rounded })
		return true
	end
	applyStat(profile, statName, rounded)
	DataService.PushMeta(player)
	return true
end

-- Runtime pass ownership ({ [Key] = true }). Read-only for callers.
function DataService.GetPasses(player: Player): { [string]: boolean }
	return passesOf[player] or {}
end

-- Records pass ownership for this session. When it changes, Equipped is trimmed to the (possibly
-- smaller) slot count, MetaState is pushed and PassesChanged fires so run stats and pets update.
function DataService.SetPass(player: Player, key: string, owned: boolean)
	if not isPlayer(player) or type(key) ~= "string" then
		return
	end
	local passes = passesOf[player]
	if not passes then
		if not isHere(player) then
			return
		end
		passes = {}
		passesOf[player] = passes
	end
	local value = owned == true
	local changed = (passes[key] == true) ~= value
	passes[key] = value

	-- Loading trims Equipped as if an on-sale slot pass were owned; now that we know, trim for real.
	local trimmed = false
	local profile = DataService.Get(player)
	if profile then
		local slots = Config.PetSlots(profile.Perks, passes)
		while #profile.Equipped &gt; slots do
			table.remove(profile.Equipped)
			trimmed = true
		end
	end

	if changed or trimmed then
		DataService.PushMeta(player)
		DataService.PassesChanged:Fire(player)
	end
end

function DataService.GetPetSlots(player: Player): number
	local profile = DataService.Get(player)
	return Config.PetSlots(profile and profile.Perks, passesOf[player] or {})
end

-- Records a finished run. Returns (firstClear, newBest, unlockedLevel?). A first clear also counts as
-- a new best. The next level unlocks if it exists and wasn't unlocked yet.
function DataService.RecordClear(player: Player, levelIndex: number, seconds: number): (boolean, boolean, number?)
	local session = sessions[player]
	local profile = session and session.Profile
	if
		not session
		or not profile
		or not isFinite(levelIndex)
		or levelIndex ~= math.floor(levelIndex)
		or not Config.Levels[levelIndex]
		or not isFinite(seconds)
		or seconds &lt;= 0
	then
		return false, false, nil
	end

	local time = math.max(0.1, math.floor(seconds * 10 + 0.5) / 10) -- tenths, like the leaderboards
	local previous = profile.BestTimes[levelIndex] or 0
	local firstClear = previous &lt;= 0
	local newBest = firstClear or time &lt; previous
	if newBest then
		profile.BestTimes[levelIndex] = time
	end

	local unlocked: number? = nil
	local nextLevel = levelIndex + 1
	if Config.Levels[nextLevel] and profile.Unlocked &lt; nextLevel then
		profile.Unlocked = nextLevel
		unlocked = nextLevel
	end
	profile.Stats.Runs += 1

	-- Unlocks and best times are the progress players care most about: write them soon.
	session.NextAutosave = math.min(session.NextAutosave, os.clock() + SAVE_SOON_DELAY)
	DataService.PushMeta(player)
	return firstClear, newBest, unlocked
end

function DataService.IsOffline(): boolean
	-- Resolves instantly except in a published place's Studio session, where the probe takes a moment.
	if not detection.Open then
		waitLatch(detection, PROBE_WAIT)
	end
	return offline
end

-- (Addition) Saves the player's profile right now and yields until done. True only if it was
-- written; always false offline and for temporary profiles. MarketService uses it for receipts.
function DataService.Save(player: Player): boolean
	local session = sessions[player]
	if not session or not session.Profile or not session.CanSave or session.Finalizing then
		return false
	end
	activeJobs += 1
	local ok, saved = pcall(saveSession, session, false, RECEIPT_SAVE_ATTEMPTS)
	activeJobs -= 1
	if not ok then
		warn("[DataService] " .. tostring(saved))
		return false
	end
	if saved then
		session.NextAutosave = os.clock() + AUTOSAVE_INTERVAL
	end
	return saved == true
end

-- (Addition) True when this player's progress is being persisted: the profile loaded from the
-- DataStore and this server still owns its lock. False offline and for temporary profiles.
function DataService.CanSave(player: Player): boolean
	local session = sessions[player]
	return session ~= nil and session.Profile ~= nil and session.CanSave and not session.Finalizing
end

return DataService</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000011"><Properties><string name="Name">DishFactory</string><ProtectedString name="Source">-- DishFactory: builds one dish (plate/bowl/cup/glass/fork/knife/spoon/pan/pot) and covers a built
-- dish in dirt spots that sit on its real, raycast-checked surfaces.
--
-- Everything here works in the dish's own "anchor" frame: `cf` (a CFrame passed to BuildDish) whose
-- Position is the contact point where the dish touches the rack/basket, and whose axes we reuse as
-- a local coordinate system for the rest of the geometry:
--   local X = cf.RightVector   (sideways across the dish)
--   local Y = cf.UpVector      (straight up from the contact point, "up" for the dish itself)
--   local Z = cf.LookVector    (the direction a plate's face points; "forward" for everything else)
-- The anchor may be tilted (ArenaBuilder leans bowls and pans toward the aisle like a real rack);
-- every builder and dirt ray only uses the anchor's own axes, so tilted dishes just work.
-- BuildDish stores that CFrame on the model (attribute "Anchor") so ApplyGrime can rebuild the same
-- local geometry later.
--
-- Hollow shapes (bowl, pan, pot, mug) are cut once in Init with GeometryService and cloned per dish.
-- If GeometryService fails, each kind falls back to a primitive-part version.
--
-- The dirt: every spot is ONE queryable disc (the thing RoundService damages) plus a few child
-- decoration parts (splats, drips, crumbs, sprinkles) that make it read as food, not a sticker.

local ServerStorage = game:GetService("ServerStorage")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Util = require(Shared:WaitForChild("Util"))

local DishFactory = {}

----------------------------------------------------------------------------------------------------
-- Sizes, relative to a ~5 stud tall character. The dishwasher is sized so these look like a real
-- load: plates are four characters tall and stand close together in the rack.
----------------------------------------------------------------------------------------------------
local SIZE = {
	Plate = { Diameter = 20, Thickness = 1.2 },
	Bowl = { Diameter = 15, Depth = 7 },
	Cup = { Diameter = 8, Height = 10 },
	Glass = { Diameter = 7, Height = 12 },
	Fork = { Height = 18 },
	Knife = { Height = 18 },
	Spoon = { Height = 18 },
	Pan = { Diameter = 22, Depth = 4 },
	Pot = { Diameter = 18, Height = 14 },
}

local DIRT_SCALE = 1.6 -- Config.GrimeTypes sizes were tuned for the old, smaller dishes
local WALL = 0.8 -- wall thickness of hollow dishes

local SPRINKLE_COLORS = {
	Color3.fromRGB(255, 90, 90),
	Color3.fromRGB(90, 140, 255),
	Color3.fromRGB(90, 220, 120),
	Color3.fromRGB(255, 210, 60),
	Color3.fromRGB(255, 120, 200),
	Color3.fromRGB(255, 160, 60),
	Color3.fromRGB(170, 110, 255),
}

local STEEL = Color3.fromRGB(200, 205, 212)
local DARK_STEEL = Color3.fromRGB(70, 72, 78)
local HANDLE_BLACK = Color3.fromRGB(40, 40, 44)

----------------------------------------------------------------------------------------------------
-- Template state (built once in Init). Each template is a PartOperation plus the CFrame it sits at
-- relative to its build frame, so a clone can be placed without knowing how CSG chose its pivot.
----------------------------------------------------------------------------------------------------
type Template = { Part: BasePart, Rel: CFrame }

local templatesFolder: Folder? = nil
local templates: { [string]: Template } = {}
local BUILD_AT = CFrame.new(0, 4000, 0) -- far from everything while cutting

----------------------------------------------------------------------------------------------------
-- Small geometry helpers, all working in an anchor CFrame's local axes.
----------------------------------------------------------------------------------------------------

-- Local (x = Right, y = Up, z = Look) -&gt; world position.
local function localPos(anchor: CFrame, x: number, y: number, z: number): Vector3
	return anchor.Position + anchor.RightVector * x + anchor.UpVector * y + anchor.LookVector * z
end

-- Local (x, y, z) -&gt; world direction.
local function localDir(anchor: CFrame, x: number, y: number, z: number): Vector3
	return anchor.RightVector * x + anchor.UpVector * y + anchor.LookVector * z
end

-- A part whose local X axis is `axisWorld` (used for Shape = Cylinder, where X is the axis).
local function axisCFrame(pos: Vector3, axisWorld: Vector3, hintWorld: Vector3): CFrame
	local ok, cf = pcall(CFrame.fromMatrix, pos, axisWorld.Unit, hintWorld.Unit)
	if ok and cf == cf then
		return cf
	end
	return CFrame.fromMatrix(pos, axisWorld.Unit, Vector3.new(0, 1, 0))
end

-- The anchor rotated so a Cylinder's axis (X) points along the anchor's Up.
local function upright(anchor: CFrame, y: number): CFrame
	return CFrame.new(localPos(anchor, 0, y, 0)) * anchor.Rotation * CFrame.Angles(0, 0, math.rad(90))
end

local function setFlags(p: BasePart)
	p.Anchored = true
	p.CanCollide = true
	p.CanTouch = false
	p.CanQuery = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
end

local function newPart(shape: Enum.PartType?, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?): BasePart
	local p = Instance.new("Part")
	if shape then
		p.Shape = shape
	end
	p.Size = Vector3.new(math.max(size.X, 0.05), math.max(size.Y, 0.05), math.max(size.Z, 0.05))
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	setFlags(p)
	return p
end

-- Decoration that should never block aim, touch or movement.
local function decor(p: BasePart): BasePart
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	return p
end

-- A rounded capsule-ish bar: a Cylinder along `axisWorld`, used for handles and cutlery.
local function bar(from: Vector3, to: Vector3, thickness: number, hint: Vector3, color: Color3, material: Enum.Material?): BasePart
	local mid = (from + to) / 2
	local len = (to - from).Magnitude
	return newPart(Enum.PartType.Cylinder, Vector3.new(len, thickness, thickness), axisCFrame(mid, to - from, hint), color, material)
end

-- Places a clone of a CSG template so its build frame lands on `frame`. Nil if there's no template.
local function placeTemplate(name: string, frame: CFrame, color: Color3, material: Enum.Material?): BasePart?
	local t = templates[name]
	if not t then
		return nil
	end
	local ok, clone = pcall(function()
		return t.Part:Clone()
	end)
	if not ok or not clone then
		return nil
	end
	local part = clone :: BasePart
	part.CFrame = frame * t.Rel
	part.Color = color
	if material then
		part.Material = material
	end
	setFlags(part)
	-- UsePartColor so the per-level theme colour shows instead of the template's.
	pcall(function()
		(part :: any).UsePartColor = true
	end)
	return part
end

-- Mug/pot style loop handle on the anchor's +X side (sideways from the dish).
local function loopHandle(anchor: CFrame, radius: number, y0: number, y1: number, out: number, thick: number, color: Color3, material: Enum.Material?, side: number): { BasePart }
	local x0 = side * (radius - 0.2)
	local x1 = side * (radius + out)
	local up = anchor.UpVector
	return {
		bar(localPos(anchor, x1, y0, 0), localPos(anchor, x1, y1, 0), thick, anchor.LookVector, color, material),
		bar(localPos(anchor, x0, y0, 0), localPos(anchor, x1 + side * thick * 0.4, y0, 0), thick, up, color, material),
		bar(localPos(anchor, x0, y1, 0), localPos(anchor, x1 + side * thick * 0.4, y1, 0), thick, up, color, material),
	}
end

----------------------------------------------------------------------------------------------------
-- Per-kind builders. Each returns (parts: {BasePart}, primaryIndex: number).
----------------------------------------------------------------------------------------------------

-- Plate standing on its edge, face (the dirty side) toward anchor.LookVector. With CSG: a white body
-- with a recessed well, a coloured stripe ring on the rim and a foot ring on the back. Without CSG:
-- a coloured edge band behind a thicker white face. No two faces share a plane either way.
local function buildPlate(anchor: CFrame, theme, _rng: Random)
	local s = SIZE.Plate
	local frame = CFrame.new(anchor.Position) * anchor.Rotation
	local body = placeTemplate("PlateBody", frame, theme.Plate)
	if body then
		local parts = { body }
		local stripe = placeTemplate("PlateStripe", frame, theme.PlateRim)
		if stripe then
			table.insert(parts, stripe)
		end
		local foot = placeTemplate("PlateFoot", frame, theme.Plate)
		if foot then
			table.insert(parts, foot)
		end
		return parts, 1
	end
	local r = s.Diameter / 2
	local cf = axisCFrame(localPos(anchor, 0, r, 0), anchor.LookVector, anchor.UpVector)
	local t = s.Thickness
	return {
		newPart(Enum.PartType.Cylinder, Vector3.new(t, s.Diameter, s.Diameter), cf, theme.PlateRim), -- edge band
		newPart(Enum.PartType.Cylinder, Vector3.new(t + 0.3, s.Diameter * 0.88, s.Diameter * 0.88), cf, theme.Plate), -- face
	}, 2
end

-- Bowl, opening along anchor Up. CSG shell when available, otherwise a ring of angled slats.
local function buildBowl(anchor: CFrame, theme, _rng: Random)
	local s = SIZE.Bowl
	local shell = placeTemplate("Bowl", CFrame.new(anchor.Position) * anchor.Rotation, theme.Bowl)
	local parts = {}
	if shell then
		table.insert(parts, shell)
	else
		local r = s.Diameter / 2
		table.insert(parts, newPart(Enum.PartType.Cylinder, Vector3.new(0.8, r * 1.1, r * 1.1), upright(anchor, 0.4), theme.Bowl))
		local slats = 20
		for i = 1, slats do
			local theta = (i - 1) / slats * math.pi * 2
			local nx, nz = math.cos(theta), math.sin(theta)
			local pos = localPos(anchor, nx * r * 0.78, s.Depth * 0.5, nz * r * 0.78)
			local out = localDir(anchor, nx, 0, nz)
			local cf = CFrame.lookAt(pos, pos + out, anchor.UpVector) * CFrame.Angles(math.rad(28), 0, 0)
			table.insert(parts, newPart(nil, Vector3.new(r * 0.3, s.Depth * 1.05, WALL), cf, theme.Bowl))
		end
	end
	-- Foot ring, and a coloured band hugging the outside of the rim.
	table.insert(parts, newPart(Enum.PartType.Cylinder, Vector3.new(0.6, s.Diameter * 0.45, s.Diameter * 0.45), upright(anchor, 0.3), theme.Bowl))
	local stripe = placeTemplate("BowlStripe", CFrame.new(anchor.Position) * anchor.Rotation, theme.PlateRim)
	if stripe then
		table.insert(parts, stripe)
	end
	return parts, 1
end

-- Mug upside down on the rack: open end at the contact point, base on top, handle on the side.
local function buildCup(anchor: CFrame, theme, _rng: Random)
	local s = SIZE.Cup
	local r = s.Diameter / 2
	local body = placeTemplate("Cup", CFrame.new(anchor.Position) * anchor.Rotation, theme.Cup)
		or newPart(Enum.PartType.Cylinder, Vector3.new(s.Height, s.Diameter, s.Diameter), upright(anchor, s.Height / 2), theme.Cup)
	local parts = { body }
	-- A white band near the (upturned) base for a little detail.
	table.insert(parts, decor(newPart(Enum.PartType.Cylinder, Vector3.new(0.5, s.Diameter + 0.08, s.Diameter + 0.08), upright(anchor, s.Height - 1.4), Color3.new(1, 1, 1))))
	for _, h in loopHandle(anchor, r, s.Height * 0.25, s.Height * 0.72, 2.2, 0.9, theme.Cup, nil, 1) do
		table.insert(parts, h)
	end
	return parts, 1
end

-- Tumbler upside down: see-through glass with a thick base on top.
local function buildGlass(anchor: CFrame, theme, _rng: Random)
	local s = SIZE.Glass
	local body = newPart(Enum.PartType.Cylinder, Vector3.new(s.Height, s.Diameter, s.Diameter), upright(anchor, s.Height / 2), theme.Glass, Enum.Material.Glass)
	body.Transparency = 0.35
	body.Reflectance = 0.15
	local base = newPart(Enum.PartType.Cylinder, Vector3.new(1.2, s.Diameter * 0.96, s.Diameter * 0.96), upright(anchor, s.Height - 0.6), theme.Glass, Enum.Material.Glass)
	base.Transparency = 0.2
	local lip = decor(newPart(Enum.PartType.Cylinder, Vector3.new(0.3, s.Diameter + 0.1, s.Diameter + 0.1), upright(anchor, 0.15), Color3.new(1, 1, 1), Enum.Material.Glass))
	lip.Transparency = 0.4
	return { body, base, lip }, 1
end

-- Frying pan, cooking surface along anchor Up, long handle along +X.
local function buildPan(anchor: CFrame, theme, _rng: Random)
	local s = SIZE.Pan
	local r = s.Diameter / 2
	local body = placeTemplate("Pan", CFrame.new(anchor.Position) * anchor.Rotation, DARK_STEEL, Enum.Material.Metal)
	local parts = {}
	if body then
		table.insert(parts, body)
	else
		table.insert(parts, newPart(Enum.PartType.Cylinder, Vector3.new(s.Depth, s.Diameter, s.Diameter), upright(anchor, s.Depth / 2), DARK_STEEL, Enum.Material.Metal))
	end
	-- Outside of the pan in the theme metal colour, cooking surface darker.
	table.insert(parts, decor(newPart(Enum.PartType.Cylinder, Vector3.new(0.3, s.Diameter + 0.2, s.Diameter + 0.2), upright(anchor, 0.15), theme.Metal, Enum.Material.Metal)))
	local h0 = localPos(anchor, r - 0.5, s.Depth * 0.8, 0)
	local h1 = localPos(anchor, r + 12, s.Depth * 1.6, 0)
	table.insert(parts, bar(h0, h1, 1.3, anchor.UpVector, HANDLE_BLACK))
	return parts, 1
end

-- Stock pot, open top along anchor Up, two loop handles.
local function buildPot(anchor: CFrame, theme, _rng: Random)
	local s = SIZE.Pot
	local r = s.Diameter / 2
	local body = placeTemplate("Pot", CFrame.new(anchor.Position) * anchor.Rotation, theme.Metal, Enum.Material.Metal)
		or newPart(Enum.PartType.Cylinder, Vector3.new(s.Height, s.Diameter, s.Diameter), upright(anchor, s.Height / 2), theme.Metal, Enum.Material.Metal)
	local parts = { body }
	-- Rolled rim.
	table.insert(parts, decor(newPart(Enum.PartType.Cylinder, Vector3.new(0.6, s.Diameter + 0.5, s.Diameter + 0.5), upright(anchor, s.Height - 0.3), STEEL, Enum.Material.Metal)))
	for _, side in { 1, -1 } do
		for _, h in loopHandle(anchor, r, s.Height * 0.72, s.Height * 0.9, 1.8, 0.8, STEEL, Enum.Material.Metal, side) do
			table.insert(parts, h)
		end
	end
	return parts, 1
end

-- Cutlery stands handle-down in the basket. The flat side faces the anchor's Look.
local function cutleryHandle(anchor: CFrame, height: number, color: Color3, material: Enum.Material?): BasePart
	local handle = newPart(nil, Vector3.new(1.6, height, 0.7), CFrame.new(localPos(anchor, 0, height / 2, 0)) * anchor.Rotation, color, material)
	return handle
end

local function buildFork(anchor: CFrame, theme, _rng: Random)
	local total = SIZE.Fork.Height
	local handleH = total * 0.55
	local neckH = total * 0.12
	local tineH = total - handleH - neckH
	local rot = anchor.Rotation
	local parts = {
		cutleryHandle(anchor, handleH, theme.Metal, Enum.Material.Metal),
		newPart(nil, Vector3.new(2.2, neckH, 0.45), CFrame.new(localPos(anchor, 0, handleH + neckH / 2, 0)) * rot, theme.Metal, Enum.Material.Metal),
		newPart(nil, Vector3.new(3.6, 1.2, 0.45), CFrame.new(localPos(anchor, 0, handleH + neckH + 0.6, 0)) * rot, theme.Metal, Enum.Material.Metal),
	}
	for i = 1, 4 do
		local x = (i - 2.5) * 0.95
		table.insert(parts, newPart(nil, Vector3.new(0.45, tineH, 0.4), CFrame.new(localPos(anchor, x, handleH + neckH + tineH / 2, 0)) * rot, theme.Metal, Enum.Material.Metal))
	end
	return parts, 1
end

local function buildKnife(anchor: CFrame, theme, _rng: Random)
	local total = SIZE.Knife.Height
	local handleH = total * 0.42
	local bladeH = total - handleH
	local rot = anchor.Rotation
	local handle = newPart(nil, Vector3.new(1.4, handleH, 0.9), CFrame.new(localPos(anchor, 0, handleH / 2, 0)) * rot, HANDLE_BLACK)
	local bolster = newPart(nil, Vector3.new(1.6, 0.6, 1.0), CFrame.new(localPos(anchor, 0, handleH + 0.3, 0)) * rot, theme.Metal, Enum.Material.Metal)
	local blade = newPart(nil, Vector3.new(2.2, bladeH - 2.2, 0.3), CFrame.new(localPos(anchor, 0.3, handleH + 0.6 + (bladeH - 2.2) / 2, 0)) * rot, theme.Metal, Enum.Material.Metal)
	-- Tip: a wedge sloping from the spine down to the edge.
	local tip = Instance.new("WedgePart")
	tip.Size = Vector3.new(0.3, 2.2, 2.2)
	tip.CFrame = CFrame.new(localPos(anchor, 0.3, handleH + 0.6 + bladeH - 2.2 + 1.1, 0)) * rot * CFrame.Angles(0, math.rad(90), 0)
	tip.Color = theme.Metal
	tip.Material = Enum.Material.Metal
	setFlags(tip)
	return { handle, bolster, blade, tip }, 1
end

local function buildSpoon(anchor: CFrame, theme, _rng: Random)
	local total = SIZE.Spoon.Height
	local handleH = total * 0.66
	local parts = { cutleryHandle(anchor, handleH, theme.Metal, Enum.Material.Metal) }
	local bowl = newPart(nil, Vector3.new(4, 5.6, 1.4), CFrame.new(localPos(anchor, 0, handleH + 2.8, 0)) * anchor.Rotation, theme.Metal, Enum.Material.Metal)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = bowl
	table.insert(parts, bowl)
	return parts, 1
end

local BUILDERS: { [string]: (CFrame, any, Random) -&gt; ({ BasePart }, number) } = {
	Plate = buildPlate,
	Bowl = buildBowl,
	Cup = buildCup,
	Glass = buildGlass,
	Fork = buildFork,
	Knife = buildKnife,
	Spoon = buildSpoon,
	Pan = buildPan,
	Pot = buildPot,
}

----------------------------------------------------------------------------------------------------
-- Init: cut the hollow templates. Any failure just leaves that kind on its primitive fallback.
----------------------------------------------------------------------------------------------------

local function tempPart(shape: Enum.PartType?, size: Vector3, cf: CFrame): Part
	local p = Instance.new("Part")
	if shape then
		p.Shape = shape
	end
	p.Size = size
	p.CFrame = cf
	p.Anchored = true
	p.Parent = ServerStorage
	return p
end

-- Upright cylinder (axis = world Y) centred at build-frame height y.
local function uprightAt(y: number): CFrame
	return BUILD_AT * CFrame.new(0, y, 0) * CFrame.Angles(0, 0, math.rad(90))
end

local function cut(name: string, outer: Part, cutters: { Part })
	local GeometryService = game:GetService("GeometryService")
	local ok, result = pcall(function()
		return GeometryService:SubtractAsync(outer, cutters, { SplitApart = false })
	end)
	for _, p in cutters do
		p:Destroy()
	end
	outer:Destroy()
	if ok and type(result) == "table" and result[1] then
		local part = result[1] :: BasePart
		part.Name = name .. "Template"
		part.Anchored = true
		part.Parent = templatesFolder
		templates[name] = { Part = part, Rel = BUILD_AT:ToObjectSpace(part.CFrame) }
	else
		warn(string.format("[DishFactory] Couldn't cut the %s template, using the simple version: %s", name, tostring(result)))
	end
end

-- Cylinder whose axis runs along the build frame's Z (the plate's facing), centred at (0, y, z).
local function alongZAt(y: number, z: number): CFrame
	return BUILD_AT * CFrame.new(0, y, z) * CFrame.Angles(0, math.rad(90), 0)
end

-- A flat ring (annulus) cut from two cylinders.
local function ring(name: string, outerD: number, innerD: number, thickness: number, cf: CFrame)
	local outer = tempPart(Enum.PartType.Cylinder, Vector3.new(thickness, outerD, outerD), cf)
	local inner = tempPart(Enum.PartType.Cylinder, Vector3.new(thickness + 1, innerD, innerD), cf)
	cut(name, outer, { inner })
end

local function buildTemplates()
	-- Plate, standing on its edge at y = 0, face toward the build frame's -Z (its LookVector side).
	do
		local s = SIZE.Plate
		local d, t = s.Diameter, s.Thickness
		local r = d / 2
		local front = -t / 2 -- local Z of the front face
		local body = tempPart(Enum.PartType.Cylinder, Vector3.new(t, d, d), alongZAt(r, 0))
		-- A well 0.35 deep with a small bevel step around it.
		local well = tempPart(Enum.PartType.Cylinder, Vector3.new(1.4, d * 0.64, d * 0.64), alongZAt(r, front - 0.7 + 0.35))
		local bevel = tempPart(Enum.PartType.Cylinder, Vector3.new(1.4, d * 0.72, d * 0.72), alongZAt(r, front - 0.7 + 0.15))
		cut("PlateBody", body, { well, bevel })
		ring("PlateStripe", d * 0.93, d * 0.86, 0.1, alongZAt(r, front - 0.05))
		ring("PlateFoot", d * 0.6, d * 0.53, 0.3, alongZAt(r, t / 2 + 0.15))
	end
	-- Bowl rim band.
	do
		local s = SIZE.Bowl
		ring("BowlStripe", s.Diameter + 0.4, s.Diameter - 0.8, 0.4, BUILD_AT * CFrame.new(0, s.Depth - 0.1, 0) * CFrame.Angles(0, 0, math.rad(90)))
	end
	-- Bowl: a ball, hollowed, with everything above the rim cut off. Contact point at y = 0.
	do
		local s = SIZE.Bowl
		local d = s.Diameter
		local outerH = s.Depth * 2
		local outer = tempPart(Enum.PartType.Ball, Vector3.new(d, d, d), BUILD_AT * CFrame.new(0, d / 2, 0))
		outer.Size = Vector3.new(d, d, d)
		local hollow = tempPart(Enum.PartType.Ball, Vector3.new(d - WALL * 2, d - WALL * 2, d - WALL * 2), BUILD_AT * CFrame.new(0, d / 2 + 0.2, 0))
		local lid = tempPart(nil, Vector3.new(d + 4, outerH, d + 4), BUILD_AT * CFrame.new(0, s.Depth + outerH / 2, 0))
		cut("Bowl", outer, { hollow, lid })
	end
	-- Mug (upside down): open at the bottom (y = 0), closed at the top.
	do
		local s = SIZE.Cup
		local outer = tempPart(Enum.PartType.Cylinder, Vector3.new(s.Height, s.Diameter, s.Diameter), uprightAt(s.Height / 2))
		local inner = tempPart(Enum.PartType.Cylinder, Vector3.new(s.Height, s.Diameter - WALL * 2, s.Diameter - WALL * 2), uprightAt(s.Height / 2 - WALL))
		cut("Cup", outer, { inner })
	end
	-- Pan: shallow dish, open on top.
	do
		local s = SIZE.Pan
		local outer = tempPart(Enum.PartType.Cylinder, Vector3.new(s.Depth, s.Diameter, s.Diameter), uprightAt(s.Depth / 2))
		local inner = tempPart(Enum.PartType.Cylinder, Vector3.new(s.Depth, s.Diameter - WALL * 2, s.Diameter - WALL * 2), uprightAt(s.Depth / 2 + WALL))
		cut("Pan", outer, { inner })
	end
	-- Pot: deep, open on top.
	do
		local s = SIZE.Pot
		local outer = tempPart(Enum.PartType.Cylinder, Vector3.new(s.Height, s.Diameter, s.Diameter), uprightAt(s.Height / 2))
		local inner = tempPart(Enum.PartType.Cylinder, Vector3.new(s.Height, s.Diameter - WALL * 2, s.Diameter - WALL * 2), uprightAt(s.Height / 2 + WALL))
		cut("Pot", outer, { inner })
	end
end

function DishFactory.Init()
	local folder = ServerStorage:FindFirstChild("DishTemplates")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "DishTemplates"
		folder.Parent = ServerStorage
	end
	templatesFolder = folder :: Folder
	local ok, err = pcall(buildTemplates)
	if not ok then
		warn("[DishFactory] Template build failed, using simple dishes: " .. tostring(err))
	end
end

-- Footprint size of a kind, for ArenaBuilder's layout: (width across, height, depth).
function DishFactory.Size(kind: string): { [string]: number }
	return SIZE[kind] or {}
end

----------------------------------------------------------------------------------------------------
-- BuildDish
----------------------------------------------------------------------------------------------------
function DishFactory.BuildDish(kind: string, cf: CFrame, theme, rng: Random): Model
	local builder = BUILDERS[kind]
	local model = Instance.new("Model")
	model.Name = kind

	if not builder then
		warn("[DishFactory] Unknown dish kind " .. tostring(kind))
		local stub = newPart(nil, Vector3.new(1, 1, 1), cf, Color3.new(1, 0, 1))
		stub.Parent = model
		model.PrimaryPart = stub
		model:SetAttribute("Anchor", cf)
		model:SetAttribute("Kind", kind)
		return model
	end

	local parts, primaryIndex = builder(cf, theme, rng)
	for _, part in parts do
		part.Parent = model
	end
	model.PrimaryPart = parts[primaryIndex] or parts[1]
	model:SetAttribute("Anchor", cf)
	model:SetAttribute("Kind", kind)
	return model
end

----------------------------------------------------------------------------------------------------
-- Dirt placement: per-kind candidate rays, in the dish's local (Right, Up, Look) axes.
-- Returns (localOrigin, localDirection); both get converted to world space before raycasting.
----------------------------------------------------------------------------------------------------
local function candidatePlate(rng: Random)
	local s = SIZE.Plate
	local side = 1 -- only the front (the side you can see) gets dirty
	local r = math.sqrt(rng:NextNumber()) * s.Diameter * 0.36
	local theta = rng:NextNumber() * math.pi * 2
	local x, y = r * math.cos(theta), s.Diameter / 2 + r * math.sin(theta)
	return Vector3.new(x, y, side * 4), Vector3.new(0, 0, -side)
end

-- Inside of an open-topped round dish (bowl, pan, pot): aim from above the opening at the inner wall
-- or floor.
local function candidateInside(diameter: number, depth: number, rng: Random)
	local theta = rng:NextNumber() * math.pi * 2
	local frac = rng:NextNumber() ^ 0.7
	local r = (diameter / 2 - WALL - 0.4) * frac
	local x, z = r * math.cos(theta), r * math.sin(theta)
	local origin = Vector3.new(-x * 0.3, depth + 6, -z * 0.3)
	local target = Vector3.new(x, WALL, z)
	return origin, (target - origin)
end

local function candidateCylinderSide(diameter: number, height: number, rng: Random)
	local theta = rng:NextNumber() * math.pi * 2
	local y = (0.12 + rng:NextNumber() * 0.8) * height
	local radius = diameter / 2
	local nx, nz = math.cos(theta), math.sin(theta)
	return Vector3.new(nx * (radius + 4), y, nz * (radius + 4)), Vector3.new(-nx, 0, -nz)
end

local function candidateCylinderTop(diameter: number, height: number, rng: Random)
	local r = math.sqrt(rng:NextNumber()) * (diameter / 2 - 0.4)
	local theta = rng:NextNumber() * math.pi * 2
	return Vector3.new(r * math.cos(theta), height + 4, r * math.sin(theta)), Vector3.new(0, -1, 0)
end

local function candidateUpsideDown(diameter: number, height: number, rng: Random)
	if rng:NextNumber() &lt; 0.8 then
		return candidateCylinderSide(diameter, height, rng)
	end
	return candidateCylinderTop(diameter, height, rng)
end

local function candidatePot(rng: Random)
	local s = SIZE.Pot
	if rng:NextNumber() &lt; 0.6 then
		return candidateCylinderSide(s.Diameter, s.Height, rng)
	end
	return candidateInside(s.Diameter, s.Height, rng)
end

-- Cutlery: the head (tines, blade, spoon bowl) on either flat side.
local function candidateCutlery(height: number, lowFrac: number, rng: Random)
	local side = if rng:NextNumber() &lt; 0.5 then 1 else -1
	local y = height * (lowFrac + rng:NextNumber() * (0.95 - lowFrac))
	local x = (rng:NextNumber() - 0.5) * 2.4
	return Vector3.new(x, y, side * 4), Vector3.new(0, 0, -side)
end

local CANDIDATES: { [string]: (Random) -&gt; (Vector3, Vector3) } = {
	Plate = candidatePlate,
	Bowl = function(rng)
		return candidateInside(SIZE.Bowl.Diameter, SIZE.Bowl.Depth, rng)
	end,
	Cup = function(rng)
		return candidateUpsideDown(SIZE.Cup.Diameter, SIZE.Cup.Height, rng)
	end,
	Glass = function(rng)
		return candidateUpsideDown(SIZE.Glass.Diameter, SIZE.Glass.Height, rng)
	end,
	Pan = function(rng)
		return candidateInside(SIZE.Pan.Diameter, SIZE.Pan.Depth, rng)
	end,
	Pot = candidatePot,
	Fork = function(rng)
		return candidateCutlery(SIZE.Fork.Height, 0.5, rng)
	end,
	Knife = function(rng)
		return candidateCutlery(SIZE.Knife.Height, 0.45, rng)
	end,
	Spoon = function(rng)
		return candidateCutlery(SIZE.Spoon.Height, 0.68, rng)
	end,
}

----------------------------------------------------------------------------------------------------
-- Dirt shapes. `cf` has local X = outward surface normal and sits just proud of the surface; local
-- Y/Z span the surface. Each returns (main disc, decoration children).
----------------------------------------------------------------------------------------------------

local function disc(cf: CFrame, diameter: number, thickness: number, color: Color3, material: Enum.Material): BasePart
	local p = newPart(Enum.PartType.Cylinder, Vector3.new(thickness, diameter, diameter), cf, color, material)
	p.CanCollide = false
	p.CastShadow = false
	return p
end

-- Child splats are thinner than the main disc and centred slightly lower, so their top faces sit
-- 0.04+ studs under the main disc's (no two faces share a plane, so nothing flickers).
local function childDisc(cf: CFrame, dy: number, dz: number, diameter: number, thickness: number, color: Color3, material: Enum.Material): BasePart
	return decor(disc(cf * CFrame.new(-0.02, dy, dz), diameter, math.min(thickness, 0.12), color, material))
end

local function darker(c: Color3, f: number): Color3
	return Color3.new(c.R * f, c.G * f, c.B * f)
end

-- Sauce splat: a round blob with smaller splats and droplets around its edge.
local function shapeBlob(cf: CFrame, size: number, color: Color3, material: Enum.Material, rng: Random)
	local main = disc(cf, size, 0.2, color, material)
	main.Reflectance = 0.08
	local kids = {}
	for _ = 1, rng:NextInteger(3, 5) do
		local a = rng:NextNumber() * math.pi * 2
		local d = size * rng:NextNumber(0.3, 0.45)
		table.insert(kids, childDisc(cf, math.cos(a) * d, math.sin(a) * d, size * rng:NextNumber(0.35, 0.6), 0.18, color, material))
	end
	for _ = 1, rng:NextInteger(2, 4) do
		local a = rng:NextNumber() * math.pi * 2
		local d = size * rng:NextNumber(0.65, 0.9)
		table.insert(kids, childDisc(cf, math.cos(a) * d, math.sin(a) * d, size * rng:NextNumber(0.1, 0.18), 0.16, color, material))
	end
	-- A slightly darker centre makes it read as a thick dollop.
	table.insert(kids, decor(disc(cf * CFrame.new(0.08, 0, 0), size * 0.45, 0.2, darker(color, 0.85), material)))
	return main, kids
end

-- Smear: a chain of overlapping blobs that thin out in one direction.
local function shapeStreak(cf: CFrame, size: number, color: Color3, material: Enum.Material, rng: Random)
	local main = disc(cf, size * 0.8, 0.18, color, material)
	local kids = {}
	local a = rng:NextNumber() * math.pi * 2
	local dy, dz = math.cos(a), math.sin(a)
	local n = rng:NextInteger(3, 5)
	for i = 1, n do
		local t = i / n
		local along = size * 0.45 * i
		local wobble = (rng:NextNumber() - 0.5) * size * 0.15
		table.insert(kids, childDisc(cf, dy * along - dz * wobble, dz * along + dy * wobble, size * (0.75 - 0.4 * t), 0.16, color, material))
	end
	return main, kids
end

-- Crumbs: a faint greasy patch covered in little chunky bits.
local function shapeCrumbs(cf: CFrame, size: number, color: Color3, material: Enum.Material, rng: Random)
	local main = disc(cf, size * 0.9, 0.12, darker(color, 0.9), material)
	main.Transparency = 0.25
	local kids = {}
	for _ = 1, rng:NextInteger(5, 8) do
		local a = rng:NextNumber() * math.pi * 2
		local d = size * 0.4 * math.sqrt(rng:NextNumber())
		local s = size * rng:NextNumber(0.12, 0.24)
		local bit = decor(newPart(nil, Vector3.new(s * 0.7, s, s * rng:NextNumber(0.7, 1.2)), cf * CFrame.new(s * 0.3, math.cos(a) * d, math.sin(a) * d) * CFrame.Angles(rng:NextNumber() * 6, rng:NextNumber() * 6, rng:NextNumber() * 6), color, material))
		table.insert(kids, bit)
	end
	return main, kids
end

-- Frosting with sprinkles on top.
local function shapeSprinkles(cf: CFrame, size: number, color: Color3, material: Enum.Material, rng: Random)
	local main, kids = shapeBlob(cf, size, Color3.fromRGB(255, 235, 245), material, rng)
	for _ = 1, rng:NextInteger(7, 11) do
		local a = rng:NextNumber() * math.pi * 2
		local d = size * 0.4 * math.sqrt(rng:NextNumber())
		local stick = decor(newPart(nil, Vector3.new(0.15, size * 0.22, 0.15), cf * CFrame.new(0.2, math.cos(a) * d, math.sin(a) * d) * CFrame.Angles(rng:NextNumber() * math.pi, 0, 0), SPRINKLE_COLORS[rng:NextInteger(1, #SPRINKLE_COLORS)], Enum.Material.SmoothPlastic))
		table.insert(kids, stick)
	end
	return main, kids
end

----------------------------------------------------------------------------------------------------
-- ApplyGrime (dirt)
----------------------------------------------------------------------------------------------------
local GOLDEN_COLOR = Color3.fromRGB(255, 213, 80)
local RAY_ATTEMPTS = 14
local MIN_SPACING = 1.2 -- spots on the same dish don't pile on top of each other
local FIT_TOLERANCE = 0.35 -- how far the dish surface may drift from a spot's plane at its edge

-- The dish surface under `pos` along `normal` (a short ray back down onto the dish), or nil.
local function surfaceAt(params: RaycastParams, pos: Vector3, normal: Vector3): RaycastResult?
	return workspace:Raycast(pos + normal * 1.2, -normal * 2.6, params)
end

-- Does a flat spot of `radius` at `center` sit on the dish all the way round? (No overhang off an
-- edge, and not floating over a curve.)
local function fits(params: RaycastParams, center: Vector3, normal: Vector3, radius: number): boolean
	local cf = axisCFrame(center, normal, if math.abs(normal.Y) &gt; 0.9 then Vector3.new(1, 0, 0) else Vector3.new(0, 1, 0))
	for i = 1, 8 do
		local a = i / 8 * math.pi * 2
		local p = (cf * CFrame.new(0, math.cos(a) * radius, math.sin(a) * radius)).Position
		local hit = surfaceAt(params, p, normal)
		if not hit or math.abs((hit.Position - p):Dot(normal)) &gt; FIT_TOLERANCE then
			return false
		end
	end
	return true
end

-- Glues a decoration part onto the dish surface under it, keeping its height above the surface.
-- Returns false (and the caller drops it) when there's no dish underneath: that's what used to leave
-- splats hanging off plate edges and cutlery.
local function snapToSurface(params: RaycastParams, child: BasePart, basePos: Vector3, baseNormal: Vector3): boolean
	local c = child.CFrame
	local lift = (c.Position - basePos):Dot(baseNormal)
	local hit = surfaceAt(params, c.Position - baseNormal * lift, baseNormal)
	if not hit then
		return false
	end
	local ok, rot = pcall(CFrame.fromRotationBetweenVectors, baseNormal, hit.Normal)
	local turn = if ok and rot then rot else CFrame.identity
	child.CFrame = CFrame.new(hit.Position + hit.Normal * lift) * turn * c.Rotation
	return true
end

function DishFactory.ApplyGrime(dish: Model, dishId: number, count: number, levelIndex: number, rng: Random, goldenChance: number, folder: Folder): { BasePart }
	local kind = dish:GetAttribute("Kind")
	local anchor = dish:GetAttribute("Anchor")
	if typeof(anchor) ~= "CFrame" or typeof(kind) ~= "string" then
		warn("[DishFactory] ApplyGrime: dish is missing its Anchor/Kind attributes")
		return {}
	end
	local candidateFn = CANDIDATES[kind]
	if not candidateFn then
		return {}
	end

	local level = Config.GetLevel(levelIndex)
	local levelMult = level.Mult

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { dish }

	local placed: { BasePart } = {}
	local used: { Vector3 } = {}
	count = math.max(1, count)

	for _ = 1, count do
		local entry = Util.WeightedPick(level.Grime, "Weight", rng)
		local grimeType = Config.GrimeTypes[entry.Type]
		if not grimeType then
			continue
		end
		local size = rng:NextNumber(grimeType.Size[1], grimeType.Size[2]) * DIRT_SCALE

		-- Find a spot where the whole splat sits on the dish; shrink it if it only just misses.
		local hitPos, hitNormal = nil, nil
		for attempt = 1, RAY_ATTEMPTS do
			local lo, ld = candidateFn(rng)
			if ld.Magnitude &gt; 1e-4 then
				local originWorld = localPos(anchor, lo.X, lo.Y, lo.Z)
				local dirWorld = localDir(anchor, ld.X, ld.Y, ld.Z).Unit * 40
				local result = workspace:Raycast(originWorld, dirWorld, params)
				if result then
					local crowded = false
					for _, p in used do
						if (p - result.Position).Magnitude &lt; MIN_SPACING then
							crowded = true
							break
						end
					end
					if not crowded then
						if fits(params, result.Position, result.Normal, size * 0.5) then
							hitPos, hitNormal = result.Position, result.Normal
							break
						elseif attempt &gt; RAY_ATTEMPTS / 2 and fits(params, result.Position, result.Normal, size * 0.32) then
							size *= 0.65
							hitPos, hitNormal = result.Position, result.Normal
							break
						end
					end
				end
			end
		end
		if hitPos and hitNormal then
			table.insert(used, hitPos)
			local golden = rng:NextNumber() &lt; goldenChance
			local hint = if math.abs(hitNormal:Dot(Vector3.new(0, 1, 0))) &gt; 0.9 then anchor.RightVector else Vector3.new(0, 1, 0)
			local cf = axisCFrame(hitPos + hitNormal * 0.08, hitNormal, hint)
			cf = cf * CFrame.Angles(rng:NextNumber() * math.pi * 2, 0, 0)

			local color = if golden then GOLDEN_COLOR else grimeType.Color
			local material = grimeType.Material

			local part: BasePart, children: { BasePart }
			if grimeType.Shape == "Crumbs" then
				part, children = shapeCrumbs(cf, size, color, material, rng)
			elseif grimeType.Shape == "Sprinkles" then
				part, children = shapeSprinkles(cf, size, color, material, rng)
			elseif grimeType.Shape == "Streak" then
				part, children = shapeStreak(cf, size, color, material, rng)
			else
				part, children = shapeBlob(cf, size, color, material, rng)
			end

			part.Name = "Dirt"
			part.CanTouch = false
			part.CanQuery = true
			part.CanCollide = false
			part.CastShadow = false
			-- Stay in the Default collision group: spatial queries (the server's scrub overlap,
			-- raycasts) skip parts whose group can't collide with the query's group, so a
			-- "collides with nothing" group would make dirt impossible to clean.

			local hp = math.max(1, math.floor(grimeType.HP * levelMult + 0.5))
			local units = math.max(1, math.floor(grimeType.Units * levelMult + 0.5))
			local minTool = grimeType.MinTool
			if golden then
				units = math.floor(units * Config.Round.GoldenUnitsMult + 0.5)
				minTool = 1
				part.Material = Enum.Material.Neon
				part.Color = GOLDEN_COLOR
				for _, child in children do
					child.Color = GOLDEN_COLOR
					child.Material = Enum.Material.Foil
				end
				local attach = Instance.new("Attachment")
				attach.Parent = part
				local emitter = Instance.new("ParticleEmitter")
				emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
				emitter.Lifetime = NumberRange.new(0.5, 1.0)
				emitter.Rate = 6
				emitter.Speed = NumberRange.new(0.5, 1.5)
				emitter.Size = NumberSequence.new(0.5, 0)
				emitter.Color = ColorSequence.new(GOLDEN_COLOR)
				emitter.Parent = attach
			end

			part:SetAttribute("HP", hp)
			part:SetAttribute("MaxHP", hp)
			part:SetAttribute("Units", units)
			part:SetAttribute("Type", entry.Type)
			part:SetAttribute("DishId", dishId)
			part:SetAttribute("Golden", golden)
			part:SetAttribute("MinTool", minTool)
			part:SetAttribute("BaseSize", part.Size)
			part:SetAttribute("BaseTransparency", part.Transparency)

			for _, child in children do
				if snapToSurface(params, child, hitPos, hitNormal) then
					child:SetAttribute("BaseSize", child.Size)
					child.Parent = part
				else
					child:Destroy()
				end
			end

			part.Parent = folder
			table.insert(placed, part)
		end
	end

	return placed
end

----------------------------------------------------------------------------------------------------
-- SetGrimeHealth: cheap per-frame-ish update while a spot is being scrubbed. The splat shrinks and
-- fades toward nothing as it's cleaned.
----------------------------------------------------------------------------------------------------
function DishFactory.SetGrimeHealth(part: BasePart, fraction: number)
	fraction = math.clamp(fraction, 0, 1)
	local shrink = 0.45 + 0.55 * fraction
	local baseT = part:GetAttribute("BaseTransparency")
	local fade = (1 - fraction) * 0.8
	local baseSize = part:GetAttribute("BaseSize")
	if typeof(baseSize) == "Vector3" then
		part.Size = Vector3.new(baseSize.X, baseSize.Y * shrink, baseSize.Z * shrink)
	end
	part.Transparency = math.min(1, (if type(baseT) == "number" then baseT else 0) + fade)

	for _, child in part:GetChildren() do
		if child:IsA("BasePart") then
			local childBase = child:GetAttribute("BaseSize")
			if typeof(childBase) == "Vector3" then
				child.Size = childBase * shrink
			end
			child.Transparency = fade
		end
	end
end

----------------------------------------------------------------------------------------------------
-- Sparkle: the finished-dish effect. Server-side so every client sees the same thing.
----------------------------------------------------------------------------------------------------
function DishFactory.Sparkle(dish: Model)
	if not dish or not dish.Parent then
		return
	end
	local root = dish.PrimaryPart or dish:FindFirstChildWhichIsA("BasePart")
	if not root then
		return
	end

	local ok = pcall(function()
		local highlight = Instance.new("Highlight")
		highlight.FillColor = Color3.new(1, 1, 1)
		highlight.FillTransparency = 0.3
		highlight.OutlineTransparency = 1
		highlight.Adornee = dish
		highlight.Parent = dish
		Debris:AddItem(highlight, 0.5)

		local attach = Instance.new("Attachment")
		attach.Parent = root
		local emitter = Instance.new("ParticleEmitter")
		emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		emitter.Lifetime = NumberRange.new(0.4, 0.9)
		emitter.Rate = 0
		emitter.Speed = NumberRange.new(3, 8)
		emitter.SpreadAngle = Vector2.new(180, 180)
		emitter.Size = NumberSequence.new(1, 0)
		emitter.Color = ColorSequence.new(Color3.new(1, 1, 1))
		emitter.Parent = attach
		emitter:Emit(30)
		Debris:AddItem(attach, 1.5)
	end)
	if not ok then
		warn("[DishFactory] Sparkle effect failed")
	end
end

return DishFactory</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000012"><Properties><string name="Name">LeaderboardService</string><ProtectedString name="Source">-- Lobby leaderboards: "Fastest Clean" (one board that cycles through the levels) and
-- "Most Dishes Cleaned".
--
--   * OrderedDataStores: RinseCycle_Fastest_L&lt;n&gt; holds best times in tenths of a second (ascending,
--     lower is better), RinseCycle_Dishes holds lifetime DishesCleaned (descending). Keys are
--     "u_" .. userId, the same as the profile store.
--   * Every REFRESH_INTERVAL seconds: write the online players' values (times only when they
--     improved, and only values that changed since this server last wrote them), read the top 10
--     of every store, and redraw.
--   * Offline (Studio without API access) the boards rank the players in this server instead.
--   * The Times board switches level every CYCLE_INTERVAL seconds, from cached rows.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))

local LobbyBuilder = require(script.Parent:WaitForChild("LobbyBuilder"))
local DataService = require(script.Parent:WaitForChild("DataService"))

local LeaderboardService = {}

----------------------------------------------------------------------------------------------------
-- Tunables
----------------------------------------------------------------------------------------------------

local REFRESH_INTERVAL = 120
local OFFLINE_REFRESH_INTERVAL = 10 -- offline boards are free to rebuild, so keep them fresh
local FIRST_REFRESH_DELAY = 8 -- give the first players' profiles a moment to load
local CYCLE_INTERVAL = 8
local TOP_N = 10
local KEY_PREFIX = "u_"
local ROW_HEIGHT = 34

local MEDALS = { "🥇", "🥈", "🥉" }
local ROW_COLORS = {
	Color3.fromRGB(255, 215, 90),
	Color3.fromRGB(220, 230, 240),
	Color3.fromRGB(240, 170, 110),
}

----------------------------------------------------------------------------------------------------
-- State
----------------------------------------------------------------------------------------------------

type Row = { Name: string, Value: number }

local levelCount = #Config.Levels
local timesTop: { [number]: { Row } } = {}
local dishesTop: { Row } = {}
local shownLevel = 1

local timeStores: { [number]: OrderedDataStore } = {}
local dishesStore: OrderedDataStore? = nil

-- What this server last wrote per user, so unchanged values aren't rewritten every refresh.
local writtenTimes: { [number]: { [number]: number } } = {}
local writtenDishes: { [number]: number } = {}
local nameCache: { [number]: string } = {}

----------------------------------------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------------------------------------

local function toTenths(seconds: number): number
	return math.max(1, math.floor(seconds * 10 + 0.5))
end

-- 753 tenths -&gt; "1:15.3"
local function formatTenths(tenths: number): string
	return string.format("%s.%d", Format.Time(tenths // 10), tenths % 10)
end

local function nameFor(userId: number): string
	local cached = nameCache[userId]
	if cached then
		return cached
	end
	local player = Players:GetPlayerByUserId(userId)
	if player then
		nameCache[userId] = player.Name
		return player.Name
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	if ok and type(name) == "string" then
		nameCache[userId] = name
		return name
	end
	return "Player " .. tostring(userId)
end

local function openStores(): boolean
	if dishesStore then
		return true
	end
	local ok = pcall(function()
		for i = 1, levelCount do
			timeStores[i] = DataStoreService:GetOrderedDataStore("RinseCycle_Fastest_L" .. i)
		end
		dishesStore = DataStoreService:GetOrderedDataStore("RinseCycle_Dishes")
	end)
	return ok and dishesStore ~= nil
end

----------------------------------------------------------------------------------------------------
-- Drawing
----------------------------------------------------------------------------------------------------

local function clearList(list: Frame)
	for _, child in list:GetChildren() do
		if not child:IsA("UIListLayout") then
			child:Destroy()
		end
	end
end

local function label(props: { [string]: any }, parent: Instance): TextLabel
	local lbl = Instance.new("TextLabel")
	lbl.BackgroundTransparency = 1
	lbl.Font = Enum.Font.FredokaOne
	lbl.TextScaled = true
	lbl.TextColor3 = Color3.new(1, 1, 1)
	for k, v in props do
		(lbl :: any)[k] = v
	end
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Color = Color3.fromRGB(10, 30, 60)
	stroke.Parent = lbl
	lbl.Parent = parent
	return lbl
end

local function drawRows(list: Frame, rows: { Row }, valueText: (number) -&gt; string, emptyText: string)
	clearList(list)
	if #rows == 0 then
		label({
			Name = "Empty",
			Size = UDim2.new(1, 0, 0, ROW_HEIGHT * 1.5),
			Text = emptyText,
			TextColor3 = Color3.fromRGB(190, 220, 245),
		}, list)
		return
	end
	for rank, row in rows do
		local frame = Instance.new("Frame")
		frame.Name = "Row" .. rank
		frame.LayoutOrder = rank
		frame.Size = UDim2.new(1, 0, 0, ROW_HEIGHT)
		frame.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
		frame.BackgroundTransparency = rank % 2 == 1 and 0.9 or 0.95
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 8)
		corner.Parent = frame

		local color = ROW_COLORS[rank] or Color3.new(1, 1, 1)
		label({
			Name = "Rank",
			Size = UDim2.new(0, 60, 1, -4),
			Position = UDim2.new(0, 4, 0, 2),
			Text = MEDALS[rank] or ("#" .. rank),
			TextColor3 = color,
		}, frame)
		label({
			Name = "Player",
			Size = UDim2.new(1, -230, 1, -4),
			Position = UDim2.new(0, 72, 0, 2),
			Text = row.Name,
			TextColor3 = color,
			TextXAlignment = Enum.TextXAlignment.Left,
		}, frame)
		label({
			Name = "Value",
			Size = UDim2.new(0, 150, 1, -4),
			Position = UDim2.new(1, -154, 0, 2),
			Text = valueText(row.Value),
			TextColor3 = color,
			TextXAlignment = Enum.TextXAlignment.Right,
		}, frame)
		frame.Parent = list
	end
end

local function drawTimes()
	local lobby = LobbyBuilder.GetLobby()
	if not lobby then
		return
	end
	local board = lobby.Boards.Times
	local level = Config.Levels[shownLevel]
	board.Title.Text = string.format("⏱️ Fastest Clean: %s %s", level.Icon, level.Name)
	drawRows(board.List, timesTop[shownLevel] or {}, formatTenths, "No clears yet!")
end

local function drawDishes()
	local lobby = LobbyBuilder.GetLobby()
	if not lobby then
		return
	end
	local board = lobby.Boards.Dishes
	board.Title.Text = "🍽️ Most Dishes Cleaned"
	drawRows(board.List, dishesTop, Format.Commas, "No dishes cleaned yet!")
end

----------------------------------------------------------------------------------------------------
-- Refresh
----------------------------------------------------------------------------------------------------

-- Offline: rank the players in this server from their in-memory profiles.
local function refreshOffline()
	for i = 1, levelCount do
		local rows: { Row } = {}
		for _, player in Players:GetPlayers() do
			local profile = DataService.Get(player)
			local best = profile and profile.BestTimes[i]
			if best and best &gt; 0 then
				table.insert(rows, { Name = player.Name, Value = toTenths(best) })
			end
		end
		table.sort(rows, function(a, b)
			return a.Value &lt; b.Value
		end)
		timesTop[i] = { table.unpack(rows, 1, math.min(#rows, TOP_N)) }
	end

	local rows: { Row } = {}
	for _, player in Players:GetPlayers() do
		local profile = DataService.Get(player)
		local dishes = profile and profile.Stats.DishesCleaned or 0
		if dishes &gt; 0 then
			table.insert(rows, { Name = player.Name, Value = dishes })
		end
	end
	table.sort(rows, function(a, b)
		return a.Value &gt; b.Value
	end)
	dishesTop = { table.unpack(rows, 1, math.min(#rows, TOP_N)) }
end

local function writeOnline()
	for _, player in Players:GetPlayers() do
		local profile = DataService.Get(player)
		if not profile then
			continue
		end
		local userId = player.UserId
		local key = KEY_PREFIX .. userId

		local written = writtenTimes[userId] or {}
		writtenTimes[userId] = written
		for i = 1, levelCount do
			local best = profile.BestTimes[i]
			local store = timeStores[i]
			if not best or best &lt;= 0 or not store then
				continue
			end
			local tenths = toTenths(best)
			if written[i] and written[i] &lt;= tenths then
				continue
			end
			local ok = pcall(function()
				(store :: any):UpdateAsync(key, function(old: any): number?
					if type(old) == "number" and old &lt;= tenths then
						return nil -- the stored time is already as good or better
					end
					return tenths
				end)
			end)
			if ok then
				written[i] = tenths
			end
		end

		local dishes = math.floor(profile.Stats.DishesCleaned or 0)
		if dishes &gt; 0 and writtenDishes[userId] ~= dishes and dishesStore then
			local store = dishesStore :: OrderedDataStore
			local ok = pcall(function()
				store:SetAsync(key, dishes)
			end)
			if ok then
				writtenDishes[userId] = dishes
			end
		end
	end
end

-- Returns nil if the read failed, so the board keeps its last good rows.
local function readTop(store: OrderedDataStore, ascending: boolean): { Row }?
	local ok, entries = pcall(function()
		local pages = store:GetSortedAsync(ascending, TOP_N)
		return pages:GetCurrentPage()
	end)
	if not ok or type(entries) ~= "table" then
		return nil
	end
	local rows: { Row } = {}
	for _, entry in entries do
		local userId = tonumber((string.match(tostring(entry.key), "^" .. KEY_PREFIX .. "(%d+)$")))
		local value = tonumber(entry.value)
		if userId and value and value &gt; 0 then
			table.insert(rows, { Name = nameFor(userId), Value = value })
		end
	end
	return rows
end

local function refreshOnline()
	writeOnline()
	for i = 1, levelCount do
		local store = timeStores[i]
		local rows = store and readTop(store, true)
		if rows then
			timesTop[i] = rows
		end
	end
	if dishesStore then
		local rows = readTop(dishesStore, false)
		if rows then
			dishesTop = rows
		end
	end
end

----------------------------------------------------------------------------------------------------
-- Lifecycle
----------------------------------------------------------------------------------------------------

function LeaderboardService.Init()
	for i = 1, levelCount do
		timesTop[i] = {}
	end
end

function LeaderboardService.Start()
	if not LobbyBuilder.GetLobby() then
		warn(string.format("[%s] LeaderboardService: no lobby, boards disabled", Config.GameName))
		return
	end
	drawTimes()
	drawDishes()

	task.spawn(function()
		task.wait(FIRST_REFRESH_DELAY)
		while true do
			local offline = DataService.IsOffline() or not openStores()
			local ok, err = pcall(if offline then refreshOffline else refreshOnline)
			if not ok then
				warn(string.format("[%s] LeaderboardService refresh failed: %s", Config.GameName, tostring(err)))
			end
			drawTimes()
			drawDishes()
			task.wait(if offline then OFFLINE_REFRESH_INTERVAL else REFRESH_INTERVAL)
		end
	end)

	task.spawn(function()
		while true do
			task.wait(CYCLE_INTERVAL)
			shownLevel = shownLevel % levelCount + 1
			drawTimes()
		end
	end)
end

return LeaderboardService</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000013"><Properties><string name="Name">LobbyBuilder</string><ProtectedString name="Source">-- LobbyBuilder: builds the entire lobby world at boot. Nothing here is an uploaded asset: every part
-- is a primitive. The layout is deliberately compact (you can cross it in a few seconds):
--
--                         [ giant dishwasher building + title ]
--        [Soap Shop]         [egg]  [egg]  [egg]            [Pet Stand]
--   (pad 1)            [Fastest]  [How to Play]  [Dishes]            (pad 4)
--   (pad 2)                                                          (pad 5)
--   (pad 3)                        ( spawn )                         (pad 6)
--
-- A tiled plaza (floor top at Y = 0.2) sits on a lawn, ringed by a white picket fence with invisible
-- walls behind it. Party pads are flat circles with a world-sized sign ("0/4 / Touch to create a
-- party"), so signs never fill the screen or cover menus.
--
-- Build() is the only entry point that creates anything; GetLobby()/GetSpawnCFrame() just read back
-- what was built. No server-side dependencies (see DESIGN.md's dependency graph).

local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")
local CollectionService = game:GetService("CollectionService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))

local LobbyBuilder = {}

----------------------------------------------------------------------------------------------------
-- Types (mirrors DESIGN.md section 5)
----------------------------------------------------------------------------------------------------
export type PadGui = { Count: TextLabel, Title: TextLabel, Status: TextLabel, Privacy: TextLabel }
export type PadInfo = {
	Id: number,
	Model: Model,
	Zone: BasePart,
	Floor: BasePart,
	Inside: CFrame,
	Exit: CFrame,
	Barriers: { BasePart },
	Gui: PadGui,
}
export type BoardInfo = { Part: BasePart, Title: TextLabel, List: Frame }
export type Lobby = {
	Model: Model,
	Pads: { PadInfo },
	Boards: { Times: BoardInfo, Dishes: BoardInfo },
}

----------------------------------------------------------------------------------------------------
-- Layout constants
----------------------------------------------------------------------------------------------------
local ORIGIN = Config.World.LobbyOrigin

local PLAZA_X = 96 -- plaza spans X -96..96
local PLAZA_Z0, PLAZA_Z1 = -100, 64
local FLOOR_Y = 0.2 -- top of the plaza tiles
local FENCE_MARGIN = 3

local SPAWN = Vector3.new(0, 0, 36)

local PAD_COUNT = Config.Party.PadCount
local PAD_RADIUS = 9
local PAD_X = 60
local PAD_Z = { -34, -6, 22 }
local PAD_WALL_HEIGHT = 8

local HATCHERY_Z = -76 -- front face of the dishwasher building (it faces +Z, toward the spawn)
local EGG_Z = -66
local SHOP_X = -40
local PETSTAND_X = 40

-- Colors
local TILE_A = Color3.fromRGB(226, 218, 204)
local TILE_B = Color3.fromRGB(182, 206, 222)
local GRASS = Color3.fromRGB(116, 170, 86)
local FENCE = Color3.fromRGB(252, 252, 250)
local STEEL = Color3.fromRGB(205, 210, 216)
local NAVY = Color3.fromRGB(18, 55, 100)

----------------------------------------------------------------------------------------------------
-- Build bookkeeping: yield every ~200 parts so the server never hitches.
----------------------------------------------------------------------------------------------------
local lobby: Lobby? = nil
local partsBuilt = 0

local function maybeYield()
	partsBuilt += 1
	if partsBuilt % 200 == 0 then
		task.wait()
	end
end

-- Creates a BasePart (or SpawnLocation), applies props, parents last, and counts toward the budget.
local function mkPart(className: string, props: { [string]: any }, parent: Instance): BasePart
	local inst = Instance.new(className) :: BasePart
	inst.Anchored = true
	if props.CanCollide == nil then
		inst.CanCollide = true
	end
	if props.CanTouch == nil then
		inst.CanTouch = false
	end
	if props.CanQuery == nil then
		inst.CanQuery = false
	end
	inst.TopSurface = Enum.SurfaceType.Smooth
	inst.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in props do
		(inst :: any)[k] = v
	end
	inst.Parent = parent
	maybeYield()
	return inst :: BasePart
end

-- Non-part instances (GUIs, lights, particles, models, folders...).
local function mk(className: string, props: { [string]: any }?, parent: Instance?): Instance
	local inst = Instance.new(className)
	if props then
		for k, v in props do
			(inst :: any)[k] = v
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

local function at(x: number, y: number, z: number): CFrame
	return CFrame.new(ORIGIN.X + x, ORIGIN.Y + y, ORIGIN.Z + z)
end

-- Upright cylinder (axis = Y).
local function upright(x: number, y: number, z: number): CFrame
	return at(x, y, z) * CFrame.Angles(0, 0, math.rad(90))
end

local function decor(props: { [string]: any }): { [string]: any }
	props.CanCollide = false
	props.CastShadow = if props.CastShadow == nil then true else props.CastShadow
	return props
end

-- A world-sized floating sign (scales with distance like a real object; never fills the screen).
-- It hangs off its own unrotated, invisible anchor part placed `offsetY` above `parent`: cylinders
-- are rotated 90 degrees internally, and a BillboardGui's offset follows that rotation, which is
-- what used to push signs sideways into the floor.
local function worldSign(parent: BasePart, text: string, width: number, height: number, offsetY: number, color: Color3?): TextLabel
	local anchor = Instance.new("Part")
	anchor.Name = "SignAnchor"
	anchor.Size = Vector3.new(0.2, 0.2, 0.2)
	anchor.CFrame = CFrame.new(parent.Position + Vector3.new(0, offsetY, 0))
	anchor.Transparency = 1
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.CastShadow = false
	anchor.Parent = parent.Parent
	local gui = mk("BillboardGui", {
		Name = "Sign",
		Size = UDim2.fromScale(width, height),
		LightInfluence = 0,
		MaxDistance = 140,
		AlwaysOnTop = false,
	}, anchor)
	local label = mk("TextLabel", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = text,
		Font = Enum.Font.FredokaOne,
		TextScaled = true,
		TextColor3 = color or Color3.new(1, 1, 1),
	}, gui) :: TextLabel
	mk("UIStroke", { Thickness = 3, Color = Color3.fromRGB(12, 30, 60) }, label)
	return label
end

----------------------------------------------------------------------------------------------------
-- Ground: a lawn, the tiled plaza, a white picket fence and invisible walls.
----------------------------------------------------------------------------------------------------
local function buildGround(parent: Instance)
	-- Safety floor under everything (the real ground is Terrain, see buildTerrain).
	mkPart("Part", {
		Name = "SafetyFloor",
		Size = Vector3.new(700, 2, 700),
		CFrame = at(0, -3, -20),
		Color = GRASS,
		Transparency = 1,
		CastShadow = false,
	}, parent)

	-- Plaza: large two-tone tiles (few parts, still reads as a tiled floor).
	local tile = 16
	for x = -PLAZA_X, PLAZA_X - tile, tile do
		for z = PLAZA_Z0, PLAZA_Z1 - tile, tile do
			local ix, iz = (x + PLAZA_X) // tile, (z - PLAZA_Z0) // tile
			mkPart("Part", {
				Name = "Tile",
				Size = Vector3.new(tile, 0.4, tile),
				CFrame = at(x + tile / 2, FLOOR_Y - 0.2, z + tile / 2),
				Color = if (ix + iz) % 2 == 0 then TILE_A else TILE_B,
				Material = Enum.Material.SmoothPlastic,
			}, parent)
		end
	end

	-- A path from spawn to the dishwasher building.
	mkPart("Part", {
		Name = "Path",
		Size = Vector3.new(14, 0.1, 110),
		CFrame = at(0, FLOOR_Y + 0.05, -30),
		Color = Color3.fromRGB(150, 188, 212),
		Material = Enum.Material.SmoothPlastic,
		CanCollide = false,
		CastShadow = false,
	}, parent)

	-- Picket fence around the plaza.
	local fx0, fx1 = -PLAZA_X - FENCE_MARGIN, PLAZA_X + FENCE_MARGIN
	local fz0, fz1 = PLAZA_Z0 - FENCE_MARGIN, PLAZA_Z1 + FENCE_MARGIN
	local function fenceRun(x0: number, z0: number, x1: number, z1: number)
		local len = math.max(math.abs(x1 - x0), math.abs(z1 - z0))
		local alongX = math.abs(x1 - x0) &gt; math.abs(z1 - z0)
		for _, y in { 1.6, 3.4 } do
			mkPart("Part", {
				Name = "FenceRail",
				Size = if alongX then Vector3.new(len, 0.5, 0.3) else Vector3.new(0.3, 0.5, len),
				CFrame = at((x0 + x1) / 2, y, (z0 + z1) / 2),
				Color = FENCE,
				CanCollide = false,
			}, parent)
		end
		local posts = math.floor(len / 3)
		for i = 0, posts do
			local t = i / posts
			local px, pz = x0 + (x1 - x0) * t, z0 + (z1 - z0) * t
			mkPart("Part", {
				Name = "Picket",
				Size = Vector3.new(0.6, 4.6, 0.6),
				CFrame = at(px, 2.3, pz),
				Color = FENCE,
				CanCollide = false,
			}, parent)
		end
	end
	fenceRun(fx0, fz0, fx1, fz0)
	fenceRun(fx0, fz1, fx1, fz1)
	fenceRun(fx0, fz0, fx0, fz1)
	fenceRun(fx1, fz0, fx1, fz1)

	-- Invisible walls just behind the fence.
	local h = 80
	local w = 4
	for _, spec in {
		{ Vector3.new(fx1 - fx0 + w * 2, h, w), at(0, h / 2, fz0 - w / 2) },
		{ Vector3.new(fx1 - fx0 + w * 2, h, w), at(0, h / 2, fz1 + w / 2) },
		{ Vector3.new(w, h, fz1 - fz0), at(fx0 - w / 2, h / 2, (fz0 + fz1) / 2) },
		{ Vector3.new(w, h, fz1 - fz0), at(fx1 + w / 2, h / 2, (fz0 + fz1) / 2) },
	} do
		mkPart("Part", { Name = "Barrier", Size = spec[1], CFrame = spec[2], Transparency = 1, CastShadow = false }, parent)
	end
end

----------------------------------------------------------------------------------------------------
-- Spawn: built FIRST so a player who spawns mid-build has a floor.
----------------------------------------------------------------------------------------------------
local function buildSpawn(parent: Instance)
	-- A stepped round platform: navy base, marble top, the game's emblem on it, and four bubble
	-- lamps around the edge. No two faces share a plane.
	mkPart("Part", {
		Name = "SpawnBase",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.7, 28, 28),
		CFrame = upright(SPAWN.X, 0.45, SPAWN.Z),
		Color = Color3.fromRGB(38, 78, 128),
		Material = Enum.Material.SmoothPlastic,
	}, parent)
	mkPart("Part", {
		Name = "SpawnTop",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.5, 24, 24),
		CFrame = upright(SPAWN.X, 0.9, SPAWN.Z),
		Color = Color3.fromRGB(236, 240, 244),
		Material = Enum.Material.Marble,
	}, parent)
	local emblem = mkPart("Part", {
		Name = "SpawnEmblem",
		Size = Vector3.new(18, 0.05, 18),
		CFrame = at(SPAWN.X, 1.2, SPAWN.Z),
		Transparency = 1,
		CanCollide = false,
		CastShadow = false,
	}, parent)
	local gui = mk("SurfaceGui", { Face = Enum.NormalId.Top, CanvasSize = Vector2.new(600, 600), LightInfluence = 0.3 }, emblem)
	local circle = mk("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.96, 0.96),
		BackgroundColor3 = Color3.fromRGB(120, 200, 250),
		BackgroundTransparency = 0.35,
	}, gui)
	mk("UICorner", { CornerRadius = UDim.new(0.5, 0) }, circle)
	mk("UIStroke", { Thickness = 10, Color = Color3.fromRGB(255, 255, 255) }, circle)
	local title = mk("TextLabel", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.8, 0.36),
		BackgroundTransparency = 1,
		Text = "🧼\n" .. string.upper(Config.GameName),
		Font = Enum.Font.FredokaOne,
		TextScaled = true,
		TextColor3 = Color3.new(1, 1, 1),
	}, gui)
	mk("UIStroke", { Thickness = 6, Color = Color3.fromRGB(20, 60, 110) }, title)
	for i = 1, 4 do
		local a = (i - 0.5) / 4 * math.pi * 2
		local px, pz = SPAWN.X + math.cos(a) * 12.5, SPAWN.Z + math.sin(a) * 12.5
		mkPart("Part", { Name = "LampPost", Shape = Enum.PartType.Cylinder, Size = Vector3.new(3, 0.8, 0.8), CFrame = upright(px, 2.3, pz), Color = Color3.fromRGB(230, 234, 240), Material = Enum.Material.Metal }, parent)
		local bulb = mkPart("Part", decor({ Name = "Bubble", Shape = Enum.PartType.Ball, Size = Vector3.new(2, 2, 2), CFrame = at(px, 4.6, pz), Color = if i % 2 == 0 then Color3.fromRGB(150, 220, 255) else Color3.fromRGB(255, 170, 215), Material = Enum.Material.Neon, Transparency = 0.2 }), parent)
		mk("PointLight", { Range = 12, Brightness = 0.8, Color = bulb.Color }, bulb)
	end
	for i = 1, 4 do
		local angle = (i - 1) / 4 * math.pi * 2 + math.pi / 4
		local pos = Vector3.new(SPAWN.X + math.cos(angle) * 6, 1.8, SPAWN.Z + math.sin(angle) * 6)
		mkPart("SpawnLocation", {
			Name = "Spawn" .. i,
			Size = Vector3.new(5, 1, 5),
			CFrame = at(pos.X, pos.Y, pos.Z),
			Neutral = true,
			Duration = 0,
			Transparency = 1,
			CanCollide = false,
		}, parent)
	end
end

-- Terrain around the plaza: rolling grass, hills, and a ring of snowy mountains on the horizon.
-- Built in the background after the lobby (it's a lot of voxels), with small yields.
local function buildTerrain()
	local terrain = workspace.Terrain
	pcall(function()
		terrain:Clear()
	end)
	local o = ORIGIN
	-- Grass ground, top at Y = 0 (a voxel boundary).
	terrain:FillBlock(CFrame.new(o.X, o.Y - 8, o.Z - 20), Vector3.new(1600, 16, 1600), Enum.Material.Grass)
	task.wait()
	local rng = Random.new(7)
	-- Rolling hills just outside the fence.
	for i = 1, 22 do
		local a = i / 22 * math.pi * 2 + rng:NextNumber(-0.1, 0.1)
		local dist = rng:NextNumber(180, 290)
		local r = rng:NextNumber(35, 70)
		terrain:FillBall(Vector3.new(o.X + math.cos(a) * dist, o.Y - r * 0.55, o.Z - 20 + math.sin(a) * dist), r, Enum.Material.Grass)
		if i % 4 == 0 then
			task.wait()
		end
	end
	-- Mountains: rock bodies with snow on top, two ranges deep so the horizon has layers.
	for i = 1, 16 do
		local a = i / 16 * math.pi * 2 + rng:NextNumber(-0.08, 0.08)
		local dist = rng:NextNumber(520, 640)
		local r = rng:NextNumber(110, 170)
		local c = Vector3.new(o.X + math.cos(a) * dist, o.Y - r * 0.25, o.Z - 20 + math.sin(a) * dist)
		terrain:FillBall(c, r, Enum.Material.Rock)
		terrain:FillBall(c + Vector3.new(rng:NextNumber(-60, 60), -r * 0.2, rng:NextNumber(-60, 60)), r * 0.8, Enum.Material.Rock)
		terrain:FillBall(c + Vector3.new(0, r * 0.62, 0), r * 0.42, Enum.Material.Snow)
		-- Grassy foothill in front of it.
		terrain:FillBall(c - (c - Vector3.new(o.X, c.Y, o.Z)).Unit * r * 0.8 - Vector3.new(0, r * 0.3, 0), r * 0.6, Enum.Material.Grass)
		task.wait()
	end
	pcall(function()
		(terrain :: any).Decoration = true
	end)
end


----------------------------------------------------------------------------------------------------
-- Party pads: flat circles with a low see-through ring (it only blocks party members, so they stay
-- put while waiting) and a floating world-sized sign.
----------------------------------------------------------------------------------------------------
local function padPosition(id: number): (number, number)
	local side = if id &lt;= 3 then -1 else 1
	local row = ((id - 1) % 3) + 1
	return side * PAD_X, PAD_Z[row]
end

local function buildPad(parent: Instance, id: number): PadInfo
	local cx, cz = padPosition(id)
	local model = mk("Model", { Name = "Pad" .. id }, parent) :: Model

	local floor = mkPart("Part", {
		Name = "Floor",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.4, PAD_RADIUS * 2, PAD_RADIUS * 2),
		CFrame = upright(cx, FLOOR_Y + 0.2, cz),
		Color = Color3.fromRGB(125, 195, 255),
		Material = Enum.Material.SmoothPlastic,
	}, model)
	-- White rim ring: wider than the floor but lower (top at +0.2 vs the floor's +0.4), so no two
	-- faces share a plane.
	mkPart("Part", {
		Name = "Rim",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.3, PAD_RADIUS * 2 + 1.2, PAD_RADIUS * 2 + 1.2),
		CFrame = upright(cx, FLOOR_Y + 0.05, cz),
		Color = Color3.fromRGB(255, 255, 255),
		Material = Enum.Material.SmoothPlastic,
		CanCollide = false,
	}, model)
	-- A dishwasher spray arm lying on the pad: a hub and two arms with nozzle dots, spun by the
	-- client (tag SpinY). It floats a hair above the floor and never touches another face.
	local spinner = mkPart("Part", {
		Name = "SprayArm",
		Size = Vector3.new(PAD_RADIUS * 1.7, 0.2, 1.6),
		CFrame = at(cx, FLOOR_Y + 0.55, cz),
		Color = Color3.fromRGB(255, 255, 255),
		Material = Enum.Material.SmoothPlastic,
		CanCollide = false,
		CastShadow = false,
	}, model)
	spinner:SetAttribute("SpinSpeed", 1.2)
	CollectionService:AddTag(spinner, "SpinY")
	local cross = mkPart("Part", {
		Name = "SprayArm",
		Size = Vector3.new(1.6, 0.18, PAD_RADIUS * 1.7),
		CFrame = at(cx, FLOOR_Y + 0.54, cz),
		Color = Color3.fromRGB(255, 255, 255),
		Material = Enum.Material.SmoothPlastic,
		CanCollide = false,
		CastShadow = false,
	}, model)
	cross:SetAttribute("SpinSpeed", 1.2)
	CollectionService:AddTag(cross, "SpinY")
	mkPart("Part", {
		Name = "SprayHub",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.5, 3, 3),
		CFrame = upright(cx, FLOOR_Y + 0.6, cz),
		Color = Color3.fromRGB(120, 200, 250),
		Material = Enum.Material.SmoothPlastic,
		CanCollide = false,
		CastShadow = false,
	}, model)

	-- A ring of glass panels; CollisionGroup PadBarrier collides only with PartyMember.
	local barriers: { BasePart } = {}
	local panels = 14
	local panelW = 2 * math.pi * (PAD_RADIUS + 0.3) / panels + 0.2
	for i = 1, panels do
		local a = (i - 0.5) / panels * math.pi * 2
		local px, pz = cx + math.cos(a) * (PAD_RADIUS + 0.3), cz + math.sin(a) * (PAD_RADIUS + 0.3)
		local b = mkPart("Part", {
			Name = "Barrier",
			Size = Vector3.new(panelW, PAD_WALL_HEIGHT, 0.4),
			CFrame = CFrame.lookAt(at(px, PAD_WALL_HEIGHT / 2, pz).Position, at(cx, PAD_WALL_HEIGHT / 2, cz).Position),
			Color = Color3.fromRGB(200, 235, 255),
			Material = Enum.Material.Glass,
			Transparency = 0.85,
			CastShadow = false,
			CollisionGroup = "PadBarrier",
		}, model)
		table.insert(barriers, b)
	end
	-- A genuinely invisible, much taller ring behind the glass so party members can't jump out
	-- (PadBarrier only blocks party members; everyone else walks straight through).
	local tallWalls = 18
	for i = 1, tallWalls do
		local a = (i - 0.5) / tallWalls * math.pi * 2
		local px, pz = cx + math.cos(a) * (PAD_RADIUS + 0.9), cz + math.sin(a) * (PAD_RADIUS + 0.9)
		local wallW = 2 * math.pi * (PAD_RADIUS + 0.9) / tallWalls + 0.4
		local b = mkPart("Part", {
			Name = "InvisibleWall",
			Size = Vector3.new(wallW, 60, 0.6),
			CFrame = CFrame.lookAt(at(px, 30, pz).Position, at(cx, 30, cz).Position),
			Transparency = 1,
			CastShadow = false,
			CollisionGroup = "PadBarrier",
		}, model)
		table.insert(barriers, b)
	end
	-- And a lid, so nobody escapes by jumping straight up either.
	table.insert(barriers, mkPart("Part", {
		Name = "InvisibleLid",
		Size = Vector3.new(PAD_RADIUS * 2 + 3, 1, PAD_RADIUS * 2 + 3),
		CFrame = at(cx, 60.5, cz),
		Transparency = 1,
		CastShadow = false,
		CollisionGroup = "PadBarrier",
	}, model))

	-- The box a player's root must be in to count as "on the pad" (inscribed in the circle).
	local zoneHalf = PAD_RADIUS * 0.72
	local zone = mkPart("Part", {
		Name = "Zone",
		Size = Vector3.new(zoneHalf * 2, 12, zoneHalf * 2),
		CFrame = at(cx, 6, cz),
		Transparency = 1,
		CanCollide = false,
		CastShadow = false,
	}, model)

	-- Floating sign: world-sized, not AlwaysOnTop, so it looks the same size as the pad on every
	-- screen and never covers menus.
	local anchor = mkPart("Part", {
		Name = "SignAnchor",
		Size = Vector3.new(1, 1, 1),
		CFrame = at(cx, FLOOR_Y, cz),
		Transparency = 1,
		CanCollide = false,
		CastShadow = false,
	}, model)
	local billboard = mk("BillboardGui", {
		Name = "PadGui",
		Size = UDim2.fromScale(16, 8),
		StudsOffsetWorldSpace = Vector3.new(0, 11, 0),
		LightInfluence = 0,
		MaxDistance = 120,
		AlwaysOnTop = false,
	}, anchor)
	local function line(name: string, y: number, h: number, text: string, color: Color3, font: Enum.Font): TextLabel
		local lbl = mk("TextLabel", {
			Name = name,
			Size = UDim2.fromScale(1, h),
			Position = UDim2.fromScale(0, y),
			BackgroundTransparency = 1,
			Text = text,
			Font = font,
			TextScaled = true,
			TextColor3 = color,
		}, billboard) :: TextLabel
		mk("UIStroke", { Thickness = 2.5, Color = Color3.fromRGB(12, 30, 60) }, lbl)
		return lbl
	end
	local titleLbl = line("Title", 0, 0.2, "", Color3.fromRGB(255, 230, 140), Enum.Font.FredokaOne)
	local countLbl = line("Count", 0.2, 0.42, "0/4", Color3.new(1, 1, 1), Enum.Font.FredokaOne)
	local statusLbl = line("Status", 0.63, 0.2, "Touch to create a party", Color3.new(1, 1, 1), Enum.Font.FredokaOne)
	local privacyLbl = line("Privacy", 0.84, 0.15, "", Color3.fromRGB(215, 230, 250), Enum.Font.GothamBold)

	-- Members stand in the middle facing the plaza centre; leavers are put outside, towards it.
	local toCentre = -math.sign(cx)
	local inside = at(cx, FLOOR_Y + 0.4, cz)
	local exitPos = at(cx + toCentre * (PAD_RADIUS + 6), FLOOR_Y, cz)
	return {
		Id = id,
		Model = model,
		Zone = zone,
		Floor = floor,
		Inside = CFrame.lookAt(inside.Position, inside.Position + Vector3.new(toCentre, 0, 0)),
		Exit = CFrame.lookAt(exitPos.Position, exitPos.Position + Vector3.new(toCentre, 0, 0)),
		Barriers = barriers,
		Gui = { Count = countLbl, Title = titleLbl, Status = statusLbl, Privacy = privacyLbl },
	}
end

----------------------------------------------------------------------------------------------------
-- The giant dishwasher building at the back (the game's "barn"), with the title on its control panel.
----------------------------------------------------------------------------------------------------
local function buildDishwasherBuilding(parent: Instance)
	local w, h, d = 84, 52, 26
	local z = HATCHERY_Z - d / 2
	mkPart("Part", { Name = "Body", Size = Vector3.new(w, h, d), CFrame = at(0, h / 2, z), Color = STEEL, Material = Enum.Material.Metal }, parent)
	-- Door panel with a recessed window and handle.
	mkPart("Part", decor({ Name = "Door", Size = Vector3.new(w - 6, h - 16, 1), CFrame = at(0, (h - 16) / 2 + 3, HATCHERY_Z + 0.5), Color = Color3.fromRGB(225, 229, 234), Material = Enum.Material.Metal }), parent)
	-- The window shows a rack of plates behind the glass, like a real dishwasher.
	local winW, winH, winY = w - 26, h - 30, (h - 16) / 2 + 3
	mkPart("Part", decor({ Name = "WindowBack", Size = Vector3.new(winW, winH, 0.4), CFrame = at(0, winY, HATCHERY_Z + 1.2), Color = Color3.fromRGB(60, 80, 105), Material = Enum.Material.Metal }), parent)
	for i = 0, 4 do
		local px = -winW / 2 + 6 + i * ((winW - 12) / 4)
		mkPart("Part", decor({ Name = "WindowPlate", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.4, 13, 13), CFrame = at(px, winY - 1, HATCHERY_Z + 2.2) * CFrame.Angles(0, math.rad(90), 0), Color = Color3.fromRGB(110, 170, 230), Material = Enum.Material.SmoothPlastic }), parent)
		mkPart("Part", decor({ Name = "WindowPlateFace", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.5, 11, 11), CFrame = at(px, winY - 1, HATCHERY_Z + 2.25) * CFrame.Angles(0, math.rad(90), 0), Color = Color3.fromRGB(250, 250, 248), Material = Enum.Material.SmoothPlastic }), parent)
	end
	mkPart("Part", decor({ Name = "WindowRack", Size = Vector3.new(winW - 2, 0.6, 2), CFrame = at(0, winY - 8, HATCHERY_Z + 2.3), Color = Color3.fromRGB(220, 225, 230), Material = Enum.Material.Metal }), parent)
	local window = mkPart("Part", decor({ Name = "Window", Size = Vector3.new(winW, winH, 0.3), CFrame = at(0, winY, HATCHERY_Z + 3.2), Color = Color3.fromRGB(150, 215, 250), Material = Enum.Material.Glass, Transparency = 0.55 }), parent)
	for _, side in { -1, 1 } do
		mkPart("Part", decor({ Name = "WindowFrame", Size = Vector3.new(1.2, winH + 1.2, 3), CFrame = at(side * (winW / 2 + 0.6), winY, HATCHERY_Z + 2), Color = Color3.fromRGB(200, 205, 212), Material = Enum.Material.Metal }), parent)
	end
	for _, side in { -1, 1 } do
		mkPart("Part", decor({ Name = "WindowFrame", Size = Vector3.new(winW + 2.4, 1.2, 3), CFrame = at(0, winY + side * (winH / 2 + 0.6), HATCHERY_Z + 2), Color = Color3.fromRGB(200, 205, 212), Material = Enum.Material.Metal }), parent)
	end
	-- Suds sloshing behind the window.
	mk("ParticleEmitter", {
		Texture = "rbxasset://textures/particles/forcefield_glow_main.dds",
		Color = ColorSequence.new(Color3.new(1, 1, 1)),
		Size = NumberSequence.new(1.6, 0.6),
		Transparency = NumberSequence.new(0.2, 1),
		Lifetime = NumberRange.new(1.5, 3),
		Rate = 12,
		Speed = NumberRange.new(1, 3),
		SpreadAngle = Vector2.new(60, 60),
		EmissionDirection = Enum.NormalId.Top,
	}, window)
	mkPart("Part", decor({ Name = "Handle", Size = Vector3.new(30, 2, 2), CFrame = at(0, h - 17, HATCHERY_Z + 2), Color = Color3.fromRGB(170, 176, 184), Material = Enum.Material.Metal }), parent)
	-- Control panel strip with the title and a few glowing buttons.
	local panel = mkPart("Part", { Name = "ControlPanel", Size = Vector3.new(w, 12, 2), CFrame = at(0, h - 6, HATCHERY_Z + 1), Color = Color3.fromRGB(40, 46, 58), Material = Enum.Material.SmoothPlastic }, parent)
	-- Back is the +Z face of an unrotated part, which is the side facing the spawn.
	local gui = mk("SurfaceGui", { Face = Enum.NormalId.Back, CanvasSize = Vector2.new(1400, 200), LightInfluence = 0 }, panel)
	local title = mk("TextLabel", {
		Size = UDim2.fromScale(0.7, 0.9),
		Position = UDim2.fromScale(0.03, 0.05),
		BackgroundTransparency = 1,
		Text = "🧼 " .. string.upper(Config.GameName),
		Font = Enum.Font.FredokaOne,
		TextScaled = true,
		TextColor3 = Color3.fromRGB(120, 220, 255),
		TextXAlignment = Enum.TextXAlignment.Left,
	}, gui)
	mk("UIStroke", { Thickness = 4, Color = Color3.fromRGB(10, 30, 70) }, title)
	for i = 0, 3 do
		mkPart("Part", decor({
			Name = "PanelButton",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.6, 4, 4),
			CFrame = at(22 + i * 6, h - 6, HATCHERY_Z + 2.2) * CFrame.Angles(0, math.rad(90), 0),
			Color = if i == 0 then Color3.fromRGB(80, 230, 140) else Color3.fromRGB(120, 200, 255),
			Material = Enum.Material.Neon,
		}), parent)
	end
	-- Roof sign.
	local roofSign = mkPart("Part", { Name = "RoofSign", Size = Vector3.new(44, 9, 1), CFrame = at(0, h + 5.5, HATCHERY_Z - 4) * CFrame.Angles(0, math.pi, 0), Color = Color3.fromRGB(255, 120, 180), Material = Enum.Material.SmoothPlastic }, parent)
	local signGui = mk("SurfaceGui", { Face = Enum.NormalId.Front, CanvasSize = Vector2.new(880, 180), LightInfluence = 0 }, roofSign)
	local signText = mk("TextLabel", { Size = UDim2.fromScale(0.94, 0.86), Position = UDim2.fromScale(0.03, 0.07), BackgroundTransparency = 1, Text = "🐾 PETS &amp; EGGS 🥚", Font = Enum.Font.FredokaOne, TextScaled = true, TextColor3 = Color3.new(1, 1, 1) }, signGui)
	mk("UIStroke", { Thickness = 5, Color = Color3.fromRGB(140, 40, 90) }, signText)
	for _, x in { -18, 18 } do
		mkPart("Part", { Name = "SignPost", Size = Vector3.new(1, 3, 1), CFrame = at(x, h + 0.5, HATCHERY_Z - 4), Color = Color3.fromRGB(200, 205, 212), Material = Enum.Material.Metal }, parent)
	end
	-- Feet.
	for _, x in { -w / 2 + 4, w / 2 - 4 } do
		mkPart("Part", decor({ Name = "Foot", Size = Vector3.new(6, 2, 6), CFrame = at(x, 1, HATCHERY_Z + 2), Color = Color3.fromRGB(60, 60, 66) }), parent)
	end
	-- Steam puffing out of the top.
	local vent = mkPart("Part", decor({ Name = "Vent", Size = Vector3.new(10, 1, 4), CFrame = at(-24, h + 0.5, z), Color = Color3.fromRGB(150, 155, 160), Material = Enum.Material.Metal }), parent)
	mk("ParticleEmitter", {
		Texture = "rbxasset://textures/particles/smoke_main.dds",
		Color = ColorSequence.new(Color3.new(1, 1, 1)),
		Size = NumberSequence.new(3, 9),
		Transparency = NumberSequence.new(0.5, 1),
		Lifetime = NumberRange.new(2, 4),
		Rate = 4,
		Speed = NumberRange.new(4, 7),
		SpreadAngle = Vector2.new(15, 15),
	}, vent)
end

----------------------------------------------------------------------------------------------------
-- Soap Shop stall (perks): striped awning, counter, a giant pump bottle, and the prompt.
----------------------------------------------------------------------------------------------------
local function buildSoapShop(parent: Instance)
	local x, z = SHOP_X, EGG_Z
	local counter = mkPart("Part", { Name = "Counter", Size = Vector3.new(16, 4, 6), CFrame = at(x, 2, z), Color = Color3.fromRGB(165, 112, 70), Material = Enum.Material.Wood }, parent)
	mkPart("Part", decor({ Name = "CounterTop", Size = Vector3.new(17, 0.6, 7), CFrame = at(x, 4.3, z), Color = Color3.fromRGB(120, 78, 48), Material = Enum.Material.Wood }), parent)
	for _, dx in { -7.5, 7.5 } do
		mkPart("Part", decor({ Name = "AwningPost", Size = Vector3.new(0.8, 12, 0.8), CFrame = at(x + dx, 6, z - 2.5), Color = Color3.fromRGB(250, 250, 250) }), parent)
	end
	for i = 0, 7 do
		mkPart("Part", decor({
			Name = "Awning",
			Size = Vector3.new(2.2, 0.6, 9),
			CFrame = at(x - 7.7 + i * 2.2, 12.5, z - 1) * CFrame.Angles(math.rad(-12), 0, 0),
			Color = if i % 2 == 0 then Color3.fromRGB(80, 190, 250) else Color3.new(1, 1, 1),
		}), parent)
	end
	-- Giant pump bottle behind the stall.
	mkPart("Part", { Name = "Bottle", Shape = Enum.PartType.Cylinder, Size = Vector3.new(16, 9, 9), CFrame = upright(x, 8, z - 8), Color = Color3.fromRGB(255, 150, 200), Material = Enum.Material.Glass, Transparency = 0.1 }, parent)
	mkPart("Part", decor({ Name = "BottleCap", Shape = Enum.PartType.Cylinder, Size = Vector3.new(3, 5, 5), CFrame = upright(x, 17.5, z - 8), Color = Color3.new(1, 1, 1) }), parent)
	mkPart("Part", decor({ Name = "PumpNeck", Size = Vector3.new(1.2, 4, 1.2), CFrame = at(x, 20.5, z - 8), Color = Color3.fromRGB(220, 220, 225), Material = Enum.Material.Metal }), parent)
	mkPart("Part", decor({ Name = "PumpHead", Size = Vector3.new(4.5, 1.2, 1.4), CFrame = at(x + 1.6, 22.8, z - 8), Color = Color3.new(1, 1, 1) }), parent)
	worldSign(counter, "🧴 SOAP SHOP", 14, 3, 16.5, Color3.fromRGB(255, 235, 140))
	worldSign(counter, "Perks", 8, 1.8, 14, Color3.fromRGB(220, 235, 255))

	local prompt = mk("ProximityPrompt", {
		ActionText = "Open Shop",
		ObjectText = "Soap Shop",
		RequiresLineOfSight = false,
		HoldDuration = 0,
		MaxActivationDistance = 12,
	}, counter) :: ProximityPrompt
	prompt:SetAttribute("OpenWindow", "Shop")
end

----------------------------------------------------------------------------------------------------
-- Egg Hatchery (one pedestal per Config.Eggs entry, in front of the dishwasher) and the Pet Stand.
----------------------------------------------------------------------------------------------------
local function fallbackEggModel(egg: any): Model
	local m = Instance.new("Model")
	m.Name = "Egg_" .. tostring(egg.Id)
	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.new(6, 8, 6)
	root.Color = egg.Color
	root.Material = Enum.Material.SmoothPlastic
	root.Anchored = true
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = root
	root.Parent = m
	m.PrimaryPart = root
	return m
end

local function buildEggHatchery(parent: Instance)
	local petModelsOk, PetModels = pcall(function()
		return require(Shared:WaitForChild("PetModels"))
	end)

	local eggs = Config.Eggs
	local n = #eggs
	for i, egg in eggs do
		local ex = (i - (n + 1) / 2) * 20
		local pedestal = mkPart("Part", {
			Name = "EggPedestal" .. i,
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(3, 9, 9),
			CFrame = upright(ex, 1.5, EGG_Z),
			Color = Color3.fromRGB(255, 255, 255),
			Material = Enum.Material.SmoothPlastic,
		}, parent)
		mkPart("Part", decor({
			Name = "EggPedestalRing",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.6, 9.6, 9.6),
			CFrame = upright(ex, 3, EGG_Z),
			Color = egg.Color,
			Material = Enum.Material.Neon,
		}), parent)

		local eggModel: Model? = nil
		if petModelsOk then
			local ok2, result = pcall((PetModels :: any).Egg, egg.Id)
			if ok2 and typeof(result) == "Instance" then
				eggModel = result :: Model
			end
		end
		local model = eggModel or fallbackEggModel(egg)
		model.Parent = parent
		pcall(function()
			model:ScaleTo(2)
		end)
		pcall(function()
			model:PivotTo(at(ex, 8.5, EGG_Z))
		end)
		for _, d in model:GetDescendants() do
			if d:IsA("BasePart") then
				d.Anchored = true
				d.CanCollide = false
				d.CanTouch = false
				d.CanQuery = false
				maybeYield()
			end
		end

		local label = worldSign(pedestal, egg.Name, 10, 2.2, 18.5)
		label.Name = "EggName"
		worldSign(pedestal, "🧼 " .. tostring(egg.Cost), 7, 1.8, 16.3, Color3.fromRGB(255, 210, 120))
		if egg.RequiredLevel and egg.RequiredLevel &gt; 1 then
			worldSign(pedestal, "🔒 Level " .. tostring(egg.RequiredLevel), 7, 1.5, 14.4, Color3.fromRGB(255, 160, 160))
		end

		local prompt = mk("ProximityPrompt", {
			ActionText = "Hatch",
			ObjectText = egg.Name,
			RequiresLineOfSight = false,
			HoldDuration = 0,
			MaxActivationDistance = 12,
		}, pedestal) :: ProximityPrompt
		prompt:SetAttribute("OpenWindow", "Eggs")
		prompt:SetAttribute("EggId", egg.Id)
	end
end

local function buildPetStand(parent: Instance)
	local x, z = PETSTAND_X, EGG_Z
	local base = mkPart("Part", { Name = "PetStand", Shape = Enum.PartType.Cylinder, Size = Vector3.new(3, 12, 12), CFrame = upright(x, 1.5, z), Color = Color3.fromRGB(255, 205, 230), Material = Enum.Material.SmoothPlastic }, parent)
	-- A little doghouse.
	mkPart("Part", { Name = "Doghouse", Size = Vector3.new(7, 6, 6), CFrame = at(x, 6, z - 1), Color = Color3.fromRGB(240, 120, 150), Material = Enum.Material.WoodPlanks }, parent)
	for _, side in { -1, 1 } do
		mkPart("Part", decor({ Name = "Roof", Size = Vector3.new(5.2, 0.6, 7), CFrame = at(x + side * 2.1, 10.2, z - 1) * CFrame.Angles(0, 0, math.rad(side * -40)), Color = Color3.fromRGB(120, 60, 50) }), parent)
	end
	mkPart("Part", decor({ Name = "DoghouseDoor", Size = Vector3.new(3, 3.6, 0.3), CFrame = at(x, 4.8, z + 2.05), Color = Color3.fromRGB(40, 30, 30) }), parent)
	worldSign(base, "🐾 PETS", 10, 2.6, 13, Color3.fromRGB(255, 170, 210))
	local prompt = mk("ProximityPrompt", {
		ActionText = "My Pets",
		ObjectText = "Pet Stand",
		RequiresLineOfSight = false,
		HoldDuration = 0,
		MaxActivationDistance = 12,
	}, base) :: ProximityPrompt
	prompt:SetAttribute("OpenWindow", "Pets")
end

----------------------------------------------------------------------------------------------------
-- Boards: two leaderboards and How to Play, facing the spawn (+Z).
----------------------------------------------------------------------------------------------------
-- A board on legs at (x, z), its front (the side with the SurfaceGui, the part's Front face) turned
-- toward (faceX, faceZ). Trim and legs follow the rotation.
local function boardShell(parent: Instance, x: number, z: number, w: number, h: number, name: string, faceX: number, faceZ: number): BasePart
	local centre = at(x, h / 2 + 3, z).Position
	local facing = CFrame.lookAt(centre, Vector3.new(ORIGIN.X + faceX, centre.Y, ORIGIN.Z + faceZ))
	local boardPart = mkPart("Part", {
		Name = name,
		Size = Vector3.new(w, h, 1),
		CFrame = facing,
		Color = NAVY,
		Material = Enum.Material.SmoothPlastic,
	}, parent)
	mkPart("Part", decor({ Name = "Trim", Size = Vector3.new(w + 1.4, h + 1.4, 0.6), CFrame = facing * CFrame.new(0, 0, 0.7), Color = Color3.fromRGB(40, 90, 150) }), parent)
	for _, dx in { -w / 2 + 2, w / 2 - 2 } do
		mkPart("Part", { Name = "Leg", Size = Vector3.new(1.2, 3.2, 1.2), CFrame = facing * CFrame.new(dx, -h / 2 - 1.4, 0.3), Color = Color3.fromRGB(150, 155, 160), Material = Enum.Material.Metal }, parent)
	end
	return boardPart
end

local function buildBoard(parent: Instance, x: number, z: number, titleText: string, faceX: number, faceZ: number): BoardInfo
	local boardPart = boardShell(parent, x, z, 22, 15, "Board", faceX, faceZ)
	local gui = mk("SurfaceGui", { Face = Enum.NormalId.Front, CanvasSize = Vector2.new(700, 480), LightInfluence = 0 }, boardPart)
	mk("UIPadding", {
		PaddingTop = UDim.new(0, 10),
		PaddingBottom = UDim.new(0, 10),
		PaddingLeft = UDim.new(0, 12),
		PaddingRight = UDim.new(0, 12),
	}, gui)
	local titleLbl = mk("TextLabel", {
		Name = "Title",
		Size = UDim2.new(1, 0, 0, 64),
		BackgroundTransparency = 1,
		Text = titleText,
		Font = Enum.Font.FredokaOne,
		TextScaled = true,
		TextColor3 = Color3.new(1, 1, 1),
	}, gui) :: TextLabel
	mk("UIStroke", { Thickness = 3, Color = Color3.fromRGB(10, 30, 60) }, titleLbl)
	local list = mk("Frame", {
		Name = "List",
		Size = UDim2.new(1, 0, 1, -70),
		Position = UDim2.new(0, 0, 0, 70),
		BackgroundTransparency = 1,
	}, gui) :: Frame
	mk("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 4) }, list)
	return { Part = boardPart, Title = titleLbl, List = list }
end

local function buildHowToPlay(parent: Instance, x: number, z: number, faceX: number, faceZ: number)
	local boardPart = boardShell(parent, x, z, 24, 15, "HowToPlayBoard", faceX, faceZ)
	boardPart.Color = Color3.fromRGB(255, 255, 255)
	local gui = mk("SurfaceGui", { Face = Enum.NormalId.Front, CanvasSize = Vector2.new(760, 480), LightInfluence = 0 }, boardPart)
	mk("UIPadding", {
		PaddingTop = UDim.new(0, 12),
		PaddingBottom = UDim.new(0, 12),
		PaddingLeft = UDim.new(0, 18),
		PaddingRight = UDim.new(0, 18),
	}, gui)
	mk("TextLabel", {
		Size = UDim2.new(1, 0, 0, 56),
		BackgroundTransparency = 1,
		Text = "How to Play",
		Font = Enum.Font.FredokaOne,
		TextScaled = true,
		TextColor3 = Color3.fromRGB(20, 110, 190),
	}, gui)
	local list = mk("Frame", {
		Size = UDim2.new(1, 0, 1, -60),
		Position = UDim2.new(0, 0, 0, 60),
		BackgroundTransparency = 1,
	}, gui)
	mk("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6) }, list)
	local steps = {
		"Step on a party pad and pick a dishwasher.",
		"Aim at the dirt and HOLD to scrub it off.",
		"Stand in the drain to sell your tank for coins.",
		"Buy better tools and upgrades on the door.",
		"Clean every dish, earn 🧼 and hatch pets!",
	}
	for i, text in steps do
		mk("TextLabel", {
			Name = "Step" .. i,
			Size = UDim2.new(1, 0, 0, 62),
			BackgroundTransparency = 1,
			Text = tostring(i) .. ". " .. text,
			Font = Enum.Font.GothamBold,
			TextScaled = true,
			TextColor3 = Color3.fromRGB(20, 40, 70),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextWrapped = true,
			LayoutOrder = i,
		}, list)
	end
end

----------------------------------------------------------------------------------------------------
-- Decorations: trees, hedges, soap bars, a giant sponge, floating bubbles.
----------------------------------------------------------------------------------------------------
local function tree(parent: Instance, x: number, z: number, scale: number)
	mkPart("Part", { Name = "Trunk", Shape = Enum.PartType.Cylinder, Size = Vector3.new(10 * scale, 2.4 * scale, 2.4 * scale), CFrame = upright(x, 5 * scale, z), Color = Color3.fromRGB(120, 85, 55), Material = Enum.Material.Wood }, parent)
	for i, off in { Vector3.new(0, 12, 0), Vector3.new(2.5, 10, 1.5), Vector3.new(-2.5, 10.5, -1) } do
		local s = (if i == 1 then 10 else 7) * scale
		mkPart("Part", decor({
			Name = "Leaves",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(s, s, s),
			CFrame = at(x + off.X * scale, off.Y * scale, z + off.Z * scale),
			Color = Color3.fromRGB(90 + i * 12, 170 + i * 6, 80),
			Material = Enum.Material.Grass,
		}), parent)
	end
end

-- Rank Shrine: a floating, spinning crystal over a pedestal. Opens the Ranks window.
local function buildRankShrine(parent: Instance)
	local x, z = -32, 40
	local base = mkPart("Part", { Name = "ShrineBase", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1.6, 12, 12), CFrame = upright(x, 1, z), Color = Color3.fromRGB(60, 40, 110), Material = Enum.Material.SmoothPlastic }, parent)
	mkPart("Part", { Name = "ShrinePillar", Shape = Enum.PartType.Cylinder, Size = Vector3.new(4, 5, 5), CFrame = upright(x, 3.8, z), Color = Color3.fromRGB(235, 225, 250), Material = Enum.Material.Marble }, parent)
	mkPart("Part", decor({ Name = "ShrineRing", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.3, 13, 13), CFrame = upright(x, 1.65, z), Color = Color3.fromRGB(255, 120, 200), Material = Enum.Material.Neon }), parent)
	local crystal = mkPart("Part", decor({
		Name = "Crystal",
		Size = Vector3.new(4, 4, 4),
		CFrame = at(x, 10, z) * CFrame.Angles(math.rad(45), 0, math.rad(45)),
		Color = Color3.fromRGB(190, 120, 255),
		Material = Enum.Material.Glass,
		Transparency = 0.15,
		CastShadow = false,
	}), parent)
	crystal:SetAttribute("SpinSpeed", 0.8)
	CollectionService:AddTag(crystal, "SpinY")
	mk("PointLight", { Range = 16, Brightness = 1, Color = Color3.fromRGB(200, 140, 255) }, crystal)
	mk("ParticleEmitter", {
		Texture = "rbxasset://textures/particles/sparkles_main.dds",
		Color = ColorSequence.new(Color3.fromRGB(230, 190, 255)),
		Size = NumberSequence.new(0.6, 0),
		Lifetime = NumberRange.new(0.8, 1.4),
		Rate = 8,
		Speed = NumberRange.new(1, 3),
		SpreadAngle = Vector2.new(180, 180),
	}, crystal)
	worldSign(base, "💎 RANKS", 10, 2.6, 15.5, Color3.fromRGB(230, 190, 255))
	worldSign(base, string.format("Roll for %d 💎", Config.RankRoll.Cost), 8, 1.6, 13.4, Color3.fromRGB(255, 255, 255))
	local prompt = mk("ProximityPrompt", {
		ActionText = "Roll Ranks",
		ObjectText = "Rank Shrine",
		RequiresLineOfSight = false,
		HoldDuration = 0,
		MaxActivationDistance = 12,
	}, base) :: ProximityPrompt
	prompt:SetAttribute("OpenWindow", "Ranks")
end

-- Bubble lamps and bushy planters along the central path.
local function buildPathDressing(parent: Instance)
	for _, z in { -52, -22, 8 } do
		for _, side in { -1, 1 } do
			local x = side * 11
			mkPart("Part", { Name = "PathLampPost", Shape = Enum.PartType.Cylinder, Size = Vector3.new(7, 0.8, 0.8), CFrame = upright(x, 3.7, z), Color = Color3.fromRGB(230, 234, 240), Material = Enum.Material.Metal }, parent)
			local bulb = mkPart("Part", decor({ Name = "PathLamp", Shape = Enum.PartType.Ball, Size = Vector3.new(2.2, 2.2, 2.2), CFrame = at(x, 8.3, z), Color = if (z / 30) % 2 &lt; 1 then Color3.fromRGB(150, 220, 255) else Color3.fromRGB(255, 180, 220), Material = Enum.Material.Neon, Transparency = 0.15 }), parent)
			mk("PointLight", { Range = 14, Brightness = 0.7, Color = bulb.Color }, bulb)
			mkPart("Part", { Name = "Planter", Size = Vector3.new(4, 2, 8), CFrame = at(x + side * 4, 1.2, z + 7), Color = Color3.fromRGB(230, 234, 240), Material = Enum.Material.SmoothPlastic }, parent)
			for k = -1, 1 do
				local d = 3 + (k + 1) % 2
				local bush = mkPart("Part", decor({ Name = "Bush", Shape = Enum.PartType.Ball, Size = Vector3.new(d, d, d), CFrame = at(x + side * 4, 2.6, z + 7 + k * 2.4), Color = Color3.fromRGB(80 + k * 10, 160, 80), Material = Enum.Material.Grass }), parent)
				bush.CastShadow = true
			end
		end
	end
end

local function buildDecorations(parent: Instance)
	for _, spot in { { -91, -97, 1.2 }, { 91, -97, 1.2 }, { -88, 52, 1 }, { 88, 52, 1 }, { -130, -30, 1.6 }, { 130, -30, 1.6 }, { -120, 70, 1.4 }, { 120, 70, 1.4 }, { 0, -140, 1.8 } } do
		tree(parent, spot[1], spot[2], spot[3])
	end
	-- Hedges along the back fence, either side of the building.
	for _, x in { -70, 70 } do
		mkPart("Part", decor({ Name = "Hedge", Size = Vector3.new(40, 5, 5), CFrame = at(x, 2.5, PLAZA_Z0 + 3), Color = Color3.fromRGB(80, 150, 70), Material = Enum.Material.Grass }), parent)
	end
	-- Giant sponge and soap bars around the spawn.
	mkPart("Part", { Name = "GiantSponge", Size = Vector3.new(12, 5, 8), CFrame = at(-80, 2.7, 46) * CFrame.Angles(0, math.rad(20), 0), Color = Color3.fromRGB(255, 215, 90), Material = Enum.Material.Sand }, parent)
	mkPart("Part", decor({ Name = "SpongeScrub", Size = Vector3.new(12.2, 1.6, 8.2), CFrame = at(-80, 5.9, 46) * CFrame.Angles(0, math.rad(20), 0), Color = Color3.fromRGB(80, 180, 100), Material = Enum.Material.Fabric }), parent)
	mkPart("Part", { Name = "SoapBar", Size = Vector3.new(10, 3.5, 6), CFrame = at(80, 2, 46) * CFrame.Angles(0, math.rad(-15), 0), Color = Color3.fromRGB(190, 230, 255), Material = Enum.Material.SmoothPlastic }, parent)
	mkPart("Part", { Name = "SoapBar", Size = Vector3.new(8, 3, 5), CFrame = at(81, 5.3, 46) * CFrame.Angles(0, math.rad(10), 0), Color = Color3.fromRGB(255, 190, 220), Material = Enum.Material.SmoothPlastic }, parent)

	-- Floating soap bubbles bobbing on cheap tween loops.
	local bubbleFolder = mk("Folder", { Name = "Bubbles" }, parent)
	for i = 1, 12 do
		local pos = at(math.random(-80, 80), 14 + math.random(0, 16), math.random(-80, 50)).Position
		local size = 2 + math.random() * 2
		local bubble = mkPart("Part", {
			Name = "Bubble" .. i,
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(size, size, size),
			CFrame = CFrame.new(pos),
			Color = Color3.fromRGB(255, 255, 255),
			Material = Enum.Material.ForceField,
			Transparency = 0.4,
			CanCollide = false,
			CastShadow = false,
		}, bubbleFolder)
		task.spawn(function()
			local base = bubble.Position
			while bubble.Parent do
				local tw = TweenService:Create(
					bubble,
					TweenInfo.new(3 + math.random() * 2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
					{ Position = base + Vector3.new(math.random(-3, 3), math.random(-2, 5), math.random(-3, 3)) }
				)
				tw:Play()
				tw.Completed:Wait()
			end
		end)
	end
end

----------------------------------------------------------------------------------------------------
-- Lighting: a soft, natural afternoon. Much gentler than before (no blown-out whites).
----------------------------------------------------------------------------------------------------
local function getOrMake(className: string): Instance
	return Lighting:FindFirstChildOfClass(className) or mk(className, nil, Lighting)
end

local function setupLighting()
	Lighting.ClockTime = 15
	Lighting.Brightness = 1.3
	Lighting.ExposureCompensation = -0.35
	Lighting.Ambient = Color3.fromRGB(80, 84, 94)
	Lighting.OutdoorAmbient = Color3.fromRGB(100, 104, 116)
	Lighting.GlobalShadows = true
	Lighting.EnvironmentDiffuseScale = 0.45
	Lighting.EnvironmentSpecularScale = 0.35

	local atmo = getOrMake("Atmosphere") :: Atmosphere
	atmo.Density = 0.3
	atmo.Offset = 0.1
	atmo.Color = Color3.fromRGB(199, 218, 240)
	atmo.Decay = Color3.fromRGB(120, 150, 190)
	atmo.Glare = 0
	atmo.Haze = 1

	local bloom = getOrMake("BloomEffect") :: BloomEffect
	bloom.Intensity = 0.15
	bloom.Size = 20
	bloom.Threshold = 2

	local cc = getOrMake("ColorCorrectionEffect") :: ColorCorrectionEffect
	cc.Saturation = 0.1
	cc.Contrast = 0.08
	cc.Brightness = -0.02

	local rays = getOrMake("SunRaysEffect") :: SunRaysEffect
	rays.Intensity = 0.03
	rays.Spread = 0.4
end

----------------------------------------------------------------------------------------------------
-- Build() / GetLobby() / GetSpawnCFrame()
----------------------------------------------------------------------------------------------------

-- Builds the whole lobby under workspace.Lobby. Safe to call once; a second call just returns the
-- existing Lobby table without building anything again.
function LobbyBuilder.Build(): Lobby
	if lobby then
		return lobby
	end

	local oldBase = Workspace:FindFirstChild("Baseplate")
	if oldBase then
		oldBase:Destroy()
	end
	local oldSpawn = Workspace:FindFirstChild("SpawnLocation")
	if oldSpawn and oldSpawn:IsA("BasePart") then
		oldSpawn:Destroy()
	end

	local model = Instance.new("Model")
	model.Name = "Lobby"
	model.Parent = Workspace

	-- Spawn first, so a player who spawns mid-build has a floor under them.
	buildSpawn(model)
	buildGround(model)

	local pads: { PadInfo } = {}
	for i = 1, PAD_COUNT do
		pads[i] = buildPad(model, i)
	end

	buildDishwasherBuilding(model)
	buildEggHatchery(model)
	buildSoapShop(model)
	buildPetStand(model)

	-- Leaderboards in the back corners, angled at the middle of the plaza; How to Play beside the
	-- spawn, facing it. Nothing stands behind the spawn, so the default camera has a clear view.
	local timesBoard = buildBoard(model, -80, -74, "Fastest Clean", 0, 0)
	local dishesBoard = buildBoard(model, 80, -74, "Most Dishes Cleaned", 0, 0)
	buildHowToPlay(model, 34, 44, SPAWN.X, SPAWN.Z)

	buildRankShrine(model)
	buildPathDressing(model)
	buildDecorations(model)
	setupLighting()

	local built: Lobby = {
		Model = model,
		Pads = pads,
		Boards = { Times = timesBoard, Dishes = dishesBoard },
	}
	lobby = built
	task.spawn(function()
		local ok, err = pcall(buildTerrain)
		if not ok then
			warn("[LobbyBuilder] terrain failed: " .. tostring(err))
		end
	end)
	return built
end

function LobbyBuilder.GetLobby(): Lobby?
	return lobby
end

-- A random spot on the spawn pad, facing north toward the boards and pads.
function LobbyBuilder.GetSpawnCFrame(): CFrame
	local angle = math.random() * math.pi * 2
	local radius = 2 + math.random() * 8
	local pos = Vector3.new(ORIGIN.X + SPAWN.X + math.cos(angle) * radius, ORIGIN.Y + 3, ORIGIN.Z + SPAWN.Z + math.sin(angle) * radius)
	return CFrame.new(pos, pos + Vector3.new(0, 0, -10))
end

return LobbyBuilder</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000014"><Properties><string name="Name">MarketService</string><ProtectedString name="Source">-- MarketService: Robux purchases.
--
-- Game passes (Config.GamePasses, only entries with Id ~= 0):
--   * When a profile loads, ownership is checked with UserOwnsGamePassAsync and recorded with
--     DataService.SetPass. Passes are runtime-only and re-checked every session.
--   * PromptGamePassPurchaseFinished grants a pass the moment it's bought.
--   * DataService.SetPass fires DataService.PassesChanged, which RoundService (run stats) and
--     PetService (slot count) listen to. We can't call RoundService from here: it requires
--     DataService, and MarketService may only require DataService.
--
-- Developer products (Config.DevProducts, entries with Id ~= 0): Bubbles, Gems and in-run Coins packs.
-- MarketService.GrantProduct gives the goods; ShopService also uses it for Studio test purchases.
-- ProcessReceipt implements the idempotent pattern:
--   1. unknown product / player not here / save not writable  -&gt; NotProcessedYet (Roblox retries)
--   2. PurchaseId already in profile.Receipts (and saved)      -&gt; PurchaseGranted, grant nothing
--   3. otherwise grant, append PurchaseId to Receipts, save now; PurchaseGranted only once saved

local Players = game:GetService("Players")
local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local DataService = require(script.Parent:WaitForChild("DataService"))
local RoundService = require(script.Parent:WaitForChild("RoundService"))

local MarketService = {}

local OWNERSHIP_ATTEMPTS = 3
local RECHECK_DELAY = 60 -- a pass check that failed completely is tried once more after this long
local RECEIPT_PROFILE_WAIT = 20
local MAX_RECEIPTS = 50

type Receipt = {
	PlayerId: number,
	ProductId: number,
	PurchaseId: string,
	CurrencySpent: number?,
	PlaceIdWherePurchased: number?,
}

-- ProductId -&gt; grant(player, profile, receipt). The grant edits the profile (or calls DataService
-- helpers) and must not yield; if it throws, nothing is recorded and Roblox retries later.
-- Example shape for a future product (never Bubbles, see DESIGN.md section 7):
--   [1234567890] = function(player, profile, receipt)
--       -- give the item here
--   end,
local PRODUCTS: { [number]: (Player, any, Receipt) -&gt; () } = {}

-- Gives a developer product's goods. Never yields. Coins only make sense inside a run; bought
-- anywhere else (e.g. the run ended while the prompt was open) they turn into Bubbles instead.
function MarketService.GrantProduct(player: Player, product: any): boolean
	if type(product) ~= "table" or type(product.Amount) ~= "number" then
		return false
	end
	if product.Kind == "Bubbles" then
		return DataService.AddBubbles(player, product.Amount, "Product")
	elseif product.Kind == "Gems" then
		return DataService.AddGems(player, product.Amount)
	elseif product.Kind == "Coins" then
		if RoundService.AddCoins(player, product.Amount) then
			return true
		end
		return DataService.AddBubbles(player, math.floor(product.Amount / 2), "ProductCoinsFallback")
	end
	return false
end

for _, product in Config.DevProducts or {} do
	if type(product.Id) == "number" and product.Id ~= 0 then
		PRODUCTS[product.Id] = function(player: Player, _profile: any, _receipt: Receipt)
			if not MarketService.GrantProduct(player, product) then
				error("grant failed")
			end
		end
	end
end

local checked: { [Player]: boolean } = {}
local boughtThisSession: { [Player]: { [string]: boolean } } = {} -- never downgraded by a stale check
local processing: { [string]: boolean } = {} -- PurchaseIds being granted right now
local unsavedReceipts: { [Player]: { [string]: boolean } } = {} -- granted in memory, save not landed yet

local notifyRemote: RemoteEvent
local initialized = false

----------------------------------------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------------------------------------

local function isHere(player: Player): boolean
	return player.Parent == Players
end

local function notify(player: Player, text: string, kind: string)
	if isHere(player) then
		notifyRemote:FireClient(player, text, kind)
	end
end

-- Passes that are actually on sale (a real Id was pasted into Config).
local function livePasses()
	local list = {}
	for _, pass in Config.GamePasses do
		if type(pass.Id) == "number" and pass.Id &gt; 0 then
			table.insert(list, pass)
		end
	end
	return list
end

local function passById(passId: number)
	if type(passId) ~= "number" or passId &lt;= 0 then
		return nil
	end
	for _, pass in Config.GamePasses do
		if pass.Id == passId then
			return pass
		end
	end
	return nil
end

-- true / false when Roblox answered, nil when every attempt failed (or the player left).
local function ownsPass(player: Player, passId: number): boolean?
	for attempt = 1, OWNERSHIP_ATTEMPTS do
		local ok, result = pcall(function()
			return MarketplaceService:UserOwnsGamePassAsync(player.UserId, passId)
		end)
		if ok then
			return result == true
		end
		if not isHere(player) then
			return nil
		end
		if attempt &lt; OWNERSHIP_ATTEMPTS then
			task.wait(attempt)
		else
			warn(string.format("[MarketService] ownership check for pass %d failed: %s", passId, tostring(result)))
		end
	end
	return nil
end

local function checkPasses(player: Player, isRetry: boolean)
	local passes = livePasses()
	if #passes == 0 then
		return
	end
	local failed = false
	for _, pass in passes do
		if not isHere(player) then
			return
		end
		local owned = ownsPass(player, pass.Id)
		if not isHere(player) then
			return
		end
		if owned == nil then
			failed = true
		else
			-- A purchase that landed while this check was in flight wins over a cached "not owned".
			local bought = boughtThisSession[player]
			if owned or not (bought and bought[pass.Key]) then
				DataService.SetPass(player, pass.Key, owned)
			end
		end
	end
	DataService.PushMeta(player)
	if failed and not isRetry then
		task.delay(RECHECK_DELAY, function()
			if isHere(player) and checked[player] then
				checkPasses(player, true)
			end
		end)
	end
end

local function onProfileLoaded(player: Player)
	if checked[player] or not isHere(player) then
		return
	end
	checked[player] = true
	checkPasses(player, false)
end

local function onPassPurchaseFinished(player: Player, passId: number, wasPurchased: boolean)
	if not wasPurchased or not isHere(player) then
		return
	end
	local pass = passById(passId)
	if not pass then
		return
	end
	local bought = boughtThisSession[player]
	if not bought then
		bought = {}
		boughtThisSession[player] = bought
	end
	bought[pass.Key] = true
	DataService.SetPass(player, pass.Key, true)
	DataService.PushMeta(player)
	notify(player, "Thanks! " .. pass.Icon .. " " .. pass.Name .. " unlocked", "Good")
end

----------------------------------------------------------------------------------------------------
-- Developer products
----------------------------------------------------------------------------------------------------

local function markUnsaved(player: Player, purchaseId: string, unsaved: boolean)
	local set = unsavedReceipts[player]
	if unsaved then
		if not set then
			set = {}
			unsavedReceipts[player] = set
		end
		set[purchaseId] = true
	elseif set then
		set[purchaseId] = nil
	end
end

local function grantReceipt(receipt: Receipt, purchaseId: string): Enum.ProductPurchaseDecision
	local grant = PRODUCTS[receipt.ProductId]
	if not grant then
		warn("[MarketService] receipt for unknown product " .. tostring(receipt.ProductId))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet -- granted next time they join
	end
	local profile = DataService.WaitFor(player, RECEIPT_PROFILE_WAIT)
	if not profile or not isHere(player) then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local offline = DataService.IsOffline()
	if not isHere(player) then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if not offline and not DataService.CanSave(player) then
		-- A temporary (unloaded) profile: granting here would vanish. Wait for a session that saves.
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local receipts = profile.Receipts
	local pending = unsavedReceipts[player]
	if table.find(receipts, purchaseId) then
		if not (pending and pending[purchaseId]) then
			return Enum.ProductPurchaseDecision.PurchaseGranted -- granted and saved before
		end
		-- Granted earlier this session but the save didn't land yet: just try saving again below.
	else
		local ok, err = pcall(grant, player, profile, receipt)
		if not ok then
			warn("[MarketService] grant failed for product " .. tostring(receipt.ProductId) .. ": " .. tostring(err))
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		table.insert(receipts, purchaseId)
		while #receipts &gt; MAX_RECEIPTS do
			table.remove(receipts, 1)
		end
		markUnsaved(player, purchaseId, true)
		DataService.PushMeta(player)
	end

	if offline or DataService.Save(player) then
		markUnsaved(player, purchaseId, false)
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	-- The grant and its receipt are in memory; the retry only needs to save. If this server dies
	-- first, both are lost together and the purchase is granted again elsewhere.
	return Enum.ProductPurchaseDecision.NotProcessedYet
end

local function processReceipt(receiptInfo: { [string]: any }): Enum.ProductPurchaseDecision
	local receipt = receiptInfo :: any
	if type(receipt) ~= "table" or receipt.PurchaseId == nil then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local purchaseId = tostring(receipt.PurchaseId)
	-- Roblox can deliver the same receipt twice at once; only one grant may run.
	if processing[purchaseId] then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	processing[purchaseId] = true
	local ok, decision = pcall(grantReceipt, receipt, purchaseId)
	processing[purchaseId] = nil
	if not ok then
		warn("[MarketService] ProcessReceipt error: " .. tostring(decision))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	return decision
end

----------------------------------------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------------------------------------

function MarketService.Init()
	if initialized then
		return
	end
	initialized = true
	notifyRemote = Remotes.Event("Notify")

	DataService.ProfileLoaded:Connect(onProfileLoaded)
	-- Profiles that loaded before we subscribed.
	for _, player in Players:GetPlayers() do
		if DataService.Get(player) then
			task.spawn(onProfileLoaded, player)
		end
	end

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(onPassPurchaseFinished)
	MarketplaceService.ProcessReceipt = processReceipt

	Players.PlayerRemoving:Connect(function(player)
		checked[player] = nil
		boughtThisSession[player] = nil
		unsavedReceipts[player] = nil
	end)
end

function MarketService.Start()
	-- Nothing to loop: everything here is event driven.
end

return MarketService</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000015"><Properties><string name="Name">PartyService</string><ProtectedString name="Source">-- Party pads: walk-in matchmaking in the lobby. One party per pad, fully server-authoritative.
--
--   * A poll loop (Config.Party.PollInterval) tests every free player's HumanoidRootPart against each
--     pad's Zone box, in the Zone's own space so rotated pads work.
--   * Walking into an empty pad makes you host of a new party. Walking into a pad that has a party
--     joins it, unless it is full, about to launch, or Friends Only and you aren't the host's friend.
--     Then you're pushed out the front with a toast and can't re-enter for RejoinCooldown seconds.
--   * Members go into the "PartyMember" collision group (the pad's barrier walls block only that
--     group) and stand on a 2x2 grid inside the pad. A member found outside the pad is put back.
--   * The countdown is one timestamp (EndsAt, server time) set when the party is created. Clients
--     draw the timer from it; the server only rewrites the pad billboard every 0.25 s.
--   * At EndsAt (or Start Now) the party launches: RoundService.StartRound builds a dishwasher and
--     takes the players. If no dishwasher is free the countdown is pushed back and it tries again.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Types = require(Shared:WaitForChild("Types"))
local Util = require(Shared:WaitForChild("Util"))

local Characters = require(script.Parent:WaitForChild("Characters"))
local DataService = require(script.Parent:WaitForChild("DataService"))
local LobbyBuilder = require(script.Parent:WaitForChild("LobbyBuilder"))
local RoundService = require(script.Parent:WaitForChild("RoundService"))

local PartyService = {}

----------------------------------------------------------------------------------------------------
-- Tuning (the gameplay numbers live in Config.Party)
----------------------------------------------------------------------------------------------------
local PARTY = Config.Party
local MAX_PLAYERS = PARTY.MaxPlayers
local LABEL_INTERVAL = 0.25 -- how often pad billboards are rewritten (the countdown text)
local RETRY_DELAY = 10 -- seconds added to the countdown when every dishwasher is busy
local PICK_SECONDS = 60 -- a host who hasn't pressed Create by then is walked out of the pad
local ACTIONS_PER_SECOND = 5 -- PartyAction rate limit per player
local FRIEND_CACHE_TTL = 300 -- seconds a friends answer is trusted
local FRIEND_FAIL_TTL = 5 -- a failed friends lookup counts as "no" for this long, then it retries
local PUT_BACK_COOLDOWN = 0.75 -- min seconds between "you escaped the pad" teleports per member
-- Members are held to a looser box than the entry check, so hugging a wall or jumping never counts
-- as escaping (and a slightly-off LobbyBuilder Zone can't cause a teleport loop).
local HOLD_MARGIN_XZ = 1.5
local HOLD_MARGIN_BELOW = 3
local HOLD_MARGIN_ABOVE = 12

local FLOOR_COLORS = {
	Idle = Color3.fromRGB(125, 195, 255), -- soft blue: walk in to start a party
	Open = Color3.fromRGB(70, 225, 145), -- green: public party with room
	Friends = Color3.fromRGB(180, 125, 255), -- purple: friends only
	Full = Color3.fromRGB(255, 165, 60), -- orange: full, or launching
}
local PRIVACY_TEXT = {
	Public = "🌐 Public",
	Friends = "👥 Friends Only",
}
local IDLE_TITLE = "Party Pad"
local IDLE_STATUS = "Touch to create a party"
local LAUNCH_STATUS = "Launching!"

local FLOOR_TWEEN = TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local PULSE_TWEEN = TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

----------------------------------------------------------------------------------------------------
-- Types
----------------------------------------------------------------------------------------------------
type PadGui = { Count: TextLabel?, Title: TextLabel?, Status: TextLabel?, Privacy: TextLabel? }

-- LobbyBuilder's PadInfo (DESIGN.md §5). Read-only here, except the Floor colour.
type PadInfo = {
	Id: number,
	Model: Model,
	Zone: BasePart,
	Floor: BasePart?,
	Inside: CFrame,
	Exit: CFrame,
	Barriers: { BasePart }?,
	Gui: PadGui?,
}

type Privacy = "Public" | "Friends"
-- Picking: the host is choosing a dishwasher and party size; nobody else can join yet.
-- Waiting: created, counting down, open to joiners. Launching: handed to RoundService.
type Status = "Picking" | "Waiting" | "Launching"

type Party = {
	PadId: number,
	Pad: Pad,
	Host: Player,
	Members: { Player }, -- join order; Members[1] is next in line to be host
	MaxPlayers: number,
	Privacy: Privacy,
	Level: number,
	LevelChosen: boolean, -- the host picked a level, so don't overwrite it when their profile loads
	EndsAt: number, -- server time (Util.Now) when the countdown hits 0 (Picking: when it's cancelled)
	Status: Status,
	Slots: { [Player]: number }, -- standing spot per member (see slotCFrame)
	Dead: boolean, -- dissolved or launched: anything still holding this table must stop using it
	FlushQueued: boolean, -- a PartyState push is already scheduled for this frame
}

type Pad = {
	Info: PadInfo,
	Party: Party?,
	FloorColor: Color3?, -- colour the floor is tweening towards
	Sounds: { [string]: Sound },
}

-- How a member is let go:
--   "Exit" : teleport out the front of the pad and start the rejoin cooldown (left or removed)
--   "Stay" : leave the character where it is (died, launched into a run, or already in a run)
--   "Gone" : they left the game, so touch nothing on the Player
type ReleaseMode = "Exit" | "Stay" | "Gone"

----------------------------------------------------------------------------------------------------
-- State
----------------------------------------------------------------------------------------------------
local pads: { Pad } = {}
local padsLoaded = false
local memberOf: { [Player]: Party } = {}
local memberConns: { [Player]: { RBXScriptConnection } } = {}
local pendingJoin: { [Player]: boolean } = {} -- friends check in flight: the poll skips them
local launching: { [Player]: boolean } = {} -- handed to StartRound, which hasn't returned yet
local cooldownUntil: { [Player]: number } = {} -- os.clock() before which they can't enter a pad
local lastPutBack: { [Player]: number } = {}
local actionWindow: { [Player]: { Start: number, Count: number } } = {}
-- friendCache[candidate][hostUserId] = the answer to candidate:IsFriendsWithAsync(hostUserId)
local friendCache: { [Player]: { [number]: { Value: boolean, Expires: number } } } = {}

local partyStateRemote: RemoteEvent
local notifyRemote: RemoteEvent

local lastWarnAt = -math.huge

----------------------------------------------------------------------------------------------------
-- Small helpers
----------------------------------------------------------------------------------------------------

-- At most one warning every 10 s, so a bug inside the poll loop can't flood the output.
local function warnThrottled(message: string)
	local now = os.clock()
	if now - lastWarnAt &gt;= 10 then
		lastWarnAt = now
		warn("[PartyService] " .. message)
	end
end

local function notify(player: Player, text: string, kind: string?)
	if player.Parent == Players then
		notifyRemote:FireClient(player, text, kind or "Info")
	end
end

local function isInRun(player: Player): boolean
	return RoundService.IsInRun(player) == true
end

-- Highest level this player may pick (1 while their profile is still loading).
local function unlockedOf(player: Player): number
	local ok, profile = pcall(DataService.Get, player)
	local unlocked = ok and profile and (profile :: any).Unlocked
	if type(unlocked) ~= "number" or unlocked ~= unlocked then
		return 1
	end
	return math.clamp(math.floor(unlocked), 1, #Config.Levels)
end

local function isInteger(value: any): boolean
	return type(value) == "number" and value == value and value == math.floor(value)
end

-- True if this request fits in the player's PartyAction budget (ACTIONS_PER_SECOND per 1 s window).
local function allowAction(player: Player): boolean
	local now = os.clock()
	local window = actionWindow[player]
	if not window or now - window.Start &gt;= 1 then
		window = { Start = now, Count = 0 }
		actionWindow[player] = window
	end
	window.Count += 1
	return window.Count &lt;= ACTIONS_PER_SECOND
end

-- Characters.Teleport may yield (streaming requests), so it never runs on the poll loop's thread.
local function teleport(player: Player, cframe: CFrame)
	task.spawn(function()
		pcall(Characters.Teleport, player, cframe)
	end)
end

----------------------------------------------------------------------------------------------------
-- Pad geometry
----------------------------------------------------------------------------------------------------

-- `position` in the Zone's own space (so rotated pads work), and the Zone's half size.
local function toZoneSpace(zone: BasePart, position: Vector3): (Vector3, Vector3)
	return zone.CFrame:PointToObjectSpace(position), zone.Size / 2
end

-- Strict point-in-box: is a free player standing in this pad?
local function isInsideZone(zone: BasePart, position: Vector3): boolean
	local p, half = toZoneSpace(zone, position)
	return math.abs(p.X) &lt;= half.X and math.abs(p.Y) &lt;= half.Y and math.abs(p.Z) &lt;= half.Z
end

-- Loose point-in-box: is a member still (near enough) inside their pad?
local function isHeldInZone(zone: BasePart, position: Vector3): boolean
	local p, half = toZoneSpace(zone, position)
	return math.abs(p.X) &lt;= half.X + HOLD_MARGIN_XZ
		and math.abs(p.Z) &lt;= half.Z + HOLD_MARGIN_XZ
		and p.Y &gt;= -half.Y - HOLD_MARGIN_BELOW
		and p.Y &lt;= half.Y + HOLD_MARGIN_ABOVE
end

-- Where member slot `slot` stands: a 2x2 grid around the pad centre (a bigger MaxPlayers would
-- simply fill more grid cells). Spacing scales with the pad so nobody is placed inside a wall.
local function slotCFrame(pad: Pad, slot: number): CFrame
	local info = pad.Info
	local cols = math.max(2, math.ceil(math.sqrt(MAX_PLAYERS)))
	local rows = math.max(1, math.ceil(MAX_PLAYERS / cols))
	local size = info.Zone.Size
	local spacing = math.clamp(math.min(size.X, size.Z) / (cols + 1.5), 1.5, 3.5)
	local index = math.max(slot, 1) - 1
	local col = index % cols
	local row = (index // cols) % rows
	local dx = (col - (cols - 1) / 2) * spacing
	local dz = (row - (rows - 1) / 2) * spacing
	return info.Inside * CFrame.new(dx, 0, dz)
end

local function freeSlot(party: Party): number
	local used = {}
	for _, slot in party.Slots do
		used[slot] = true
	end
	local slot = 1
	while used[slot] do
		slot += 1
	end
	return slot
end

----------------------------------------------------------------------------------------------------
-- Pad visuals (billboard text, floor colour, sounds)
----------------------------------------------------------------------------------------------------

local function setText(label: TextLabel?, text: string)
	-- Only write real changes: identical writes are free, but this runs 4x a second per pad.
	if label and label.Parent and label.Text ~= text then
		label.Text = text
	end
end

local function floorColorFor(party: Party?): Color3
	if not party then
		return FLOOR_COLORS.Idle
	end
	if party.Status ~= "Waiting" or #party.Members &gt;= party.MaxPlayers then
		return FLOOR_COLORS.Full
	end
	if party.Privacy == "Friends" then
		return FLOOR_COLORS.Friends
	end
	return FLOOR_COLORS.Open
end

local function statusText(party: Party?, now: number): string
	if not party then
		return IDLE_STATUS
	end
	if party.Status == "Launching" then
		return LAUNCH_STATUS
	end
	if party.Status == "Picking" then
		return party.Host.DisplayName .. " is picking a dishwasher..."
	end
	local left = math.ceil(party.EndsAt - now)
	if left &lt;= 0 then
		return LAUNCH_STATUS
	end
	return "Starting in " .. left
end

-- Tweens the floor (and any light parented to it) to `color`. `pulse` flashes it bright first,
-- which reads as "someone just joined".
local function tweenFloor(pad: Pad, color: Color3, pulse: boolean?)
	local floor = pad.Info.Floor
	if not floor or not floor.Parent then
		return
	end
	if not pulse and pad.FloorColor == color then
		return
	end
	pad.FloorColor = color
	local info = FLOOR_TWEEN
	if pulse then
		floor.Color = color:Lerp(Color3.new(1, 1, 1), 0.6)
		info = PULSE_TWEEN
	end
	TweenService:Create(floor, info, { Color = color }):Play()
	for _, child in floor:GetChildren() do
		if child:IsA("Light") then
			TweenService:Create(child, info, { Color = color }):Play()
		end
	end
end

-- A positional sound at the pad (a Sound in the workspace plays for everyone nearby).
local function playPadSound(pad: Pad, key: string)
	local def = (Config.Sounds :: any)[key]
	local floor = pad.Info.Floor
	if not def or not floor or not floor.Parent then
		return
	end
	local sound = pad.Sounds[key]
	if not sound or sound.Parent ~= floor then
		sound = Instance.new("Sound")
		sound.Name = "Party" .. key
		sound.SoundId = def.Id
		sound.Volume = def.Volume
		sound.RollOffMode = Enum.RollOffMode.InverseTapered
		sound.RollOffMinDistance = 10
		sound.RollOffMaxDistance = 90
		sound.Parent = floor
		pad.Sounds[key] = sound
	end
	sound:Play()
end

local function refreshPad(pad: Pad, pulse: boolean?)
	local party = pad.Party
	local gui = pad.Info.Gui
	if gui then
		if party then
			local level = Config.GetLevel(party.Level)
			setText(gui.Count, #party.Members .. "/" .. party.MaxPlayers)
			setText(gui.Title, level.Icon .. " " .. level.Name)
			setText(gui.Privacy, PRIVACY_TEXT[party.Privacy])
		else
			setText(gui.Count, "0/" .. MAX_PLAYERS)
			setText(gui.Title, IDLE_TITLE)
			setText(gui.Privacy, PRIVACY_TEXT.Public)
		end
		setText(gui.Status, statusText(party, Util.Now()))
	end
	tweenFloor(pad, floorColorFor(party), pulse)
end

----------------------------------------------------------------------------------------------------
-- PartyState pushes
----------------------------------------------------------------------------------------------------

local function buildState(party: Party): Types.PartyState
	local members: { Types.PartyMember } = {}
	for _, member in party.Members do
		table.insert(members, { UserId = member.UserId, Name = member.Name, DisplayName = member.DisplayName })
	end
	return {
		PadId = party.PadId,
		HostUserId = party.Host.UserId,
		IsHost = false,
		Members = members,
		MaxPlayers = party.MaxPlayers,
		Privacy = party.Privacy,
		Level = party.Level,
		HostUnlocked = unlockedOf(party.Host),
		EndsAt = party.EndsAt,
		Status = party.Status,
	}
end

-- Sends every member their own copy (IsHost differs per recipient).
local function pushNow(party: Party)
	if party.Dead or #party.Members == 0 then
		return
	end
	local base = buildState(party)
	for _, member in party.Members do
		if member.Parent == Players then
			local state: Types.PartyState = table.clone(base)
			state.IsHost = member == party.Host
			partyStateRemote:FireClient(member, state)
		end
	end
end

-- Coalesces every change made to a party in the same frame into one push per member.
-- (A member who is removed gets PartyState(nil) immediately, not through here.)
local function markDirty(party: Party)
	if party.Dead or party.FlushQueued then
		return
	end
	party.FlushQueued = true
	task.defer(function()
		party.FlushQueued = false
		pushNow(party)
	end)
end

----------------------------------------------------------------------------------------------------
-- Membership
----------------------------------------------------------------------------------------------------

local function unhookMember(player: Player)
	local conns = memberConns[player]
	if conns then
		for _, conn in conns do
			conn:Disconnect()
		end
		memberConns[player] = nil
	end
end

-- Back to the normal "Players" group so the pad walls stop blocking them. RoundService already does
-- this for launched players; it's only redone if the character is still in PartyMember (or has no
-- root right now, e.g. dead, so the next character spawns in the right group).
local function releaseGroup(player: Player)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") and root.CollisionGroup ~= Characters.Groups.PartyMember then
		return
	end
	Characters.SetGroup(player, Characters.Groups.Players)
end

-- Forgets a member's per-player bookkeeping. Does not touch party.Members (callers do).
local function releaseMember(party: Party, player: Player, mode: ReleaseMode)
	memberOf[player] = nil
	party.Slots[player] = nil
	lastPutBack[player] = nil
	unhookMember(player)
	if mode == "Gone" or player.Parent ~= Players then
		return
	end
	player:SetAttribute("InParty", false)
	releaseGroup(player)
	if mode == "Exit" then
		cooldownUntil[player] = os.clock() + PARTY.RejoinCooldown
		if not isInRun(player) then
			teleport(player, party.Pad.Info.Exit)
		end
	end
	partyStateRemote:FireClient(player, nil)
end

local function dissolve(party: Party)
	party.Dead = true
	local pad = party.Pad
	if pad.Party == party then
		pad.Party = nil
	end
	refreshPad(pad)
end

-- The longest-waiting member becomes host. They may not have unlocked the level the old host
-- picked, so the level is clamped to what they can play.
local function promoteHost(party: Party)
	local newHost = party.Members[1]
	if not newHost then
		return
	end
	party.Host = newHost
	party.Level = math.clamp(party.Level, 1, unlockedOf(newHost))
	notify(newHost, "👑 You're the party host now!", "Good")
end

local function removeMember(player: Player, mode: ReleaseMode, message: string?)
	local party = memberOf[player]
	if not party then
		return
	end
	local index = table.find(party.Members, player)
	if index then
		table.remove(party.Members, index)
	end
	releaseMember(party, player, mode)
	if message then
		notify(player, message, "Info")
	end

	if #party.Members == 0 then
		dissolve(party)
		return
	end
	if party.Host == player then
		promoteHost(party)
	end
	markDirty(party)
	refreshPad(party.Pad)
end

-- Death (Humanoid.Died) or losing the character (CharacterRemoving, e.g. a respawn) ends membership.
-- They respawn in the lobby as normal.
local function hookMember(player: Player)
	unhookMember(player)
	local function onLost()
		if memberOf[player] then
			removeMember(player, "Stay", "You left the party.")
		end
	end
	local conns = {}
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		table.insert(conns, humanoid.Died:Connect(onLost))
	end
	table.insert(conns, player.CharacterRemoving:Connect(onLost))
	memberConns[player] = conns
end

local function joinParty(party: Party, player: Player)
	local pad = party.Pad
	table.insert(party.Members, player)
	memberOf[player] = party
	local slot = freeSlot(party)
	party.Slots[player] = slot
	cooldownUntil[player] = nil
	lastPutBack[player] = os.clock()

	Characters.SetGroup(player, Characters.Groups.PartyMember)
	player:SetAttribute("InParty", true)
	hookMember(player)
	teleport(player, slotCFrame(pad, slot))

	markDirty(party)
	refreshPad(pad, true)
	playPadSound(pad, "Pop")
end

local function createParty(pad: Pad, host: Player)
	local party: Party = {
		PadId = pad.Info.Id,
		Pad = pad,
		Host = host,
		Members = {},
		MaxPlayers = MAX_PLAYERS,
		Privacy = "Public",
		Level = unlockedOf(host), -- default to their best dishwasher
		LevelChosen = false,
		EndsAt = Util.Now() + PICK_SECONDS, -- replaced by the real countdown when they press Create
		Status = "Picking",
		Slots = {},
		Dead = false,
		FlushQueued = false,
	}
	pad.Party = party
	joinParty(party, host)
end

----------------------------------------------------------------------------------------------------
-- Walking into a pad
----------------------------------------------------------------------------------------------------

-- Joins and leaves are refused this close to launch (and while launching).
local function inLockWindow(party: Party): boolean
	if party.Status == "Picking" then
		return false
	end
	return party.Status ~= "Waiting" or Util.Now() &gt;= party.EndsAt - PARTY.LockSeconds
end

-- Pushes a free player out the front of a pad they may not join.
local function eject(player: Player, pad: Pad, message: string)
	cooldownUntil[player] = os.clock() + PARTY.RejoinCooldown
	teleport(player, pad.Info.Exit)
	notify(player, message, "Bad")
end

local function cachedFriendship(candidate: Player, host: Player): boolean?
	local byHost = friendCache[candidate]
	local entry = byHost and byHost[host.UserId]
	if entry and os.clock() &lt; entry.Expires then
		return entry.Value
	end
	return nil
end

local function storeFriendship(candidate: Player, hostUserId: number, value: boolean, ttl: number)
	local byHost = friendCache[candidate]
	if not byHost then
		byHost = {}
		friendCache[candidate] = byHost
	end
	byHost[hostUserId] = { Value = value, Expires = os.clock() + ttl }
end

-- A player the poll loop should look at: not busy with a party, run or pending check, and not on
-- the rejoin cooldown.
local function canEnterPads(player: Player, clock: number): boolean
	if player.Parent ~= Players or memberOf[player] or pendingJoin[player] or launching[player] then
		return false
	end
	local cooldown = cooldownUntil[player]
	if cooldown then
		if clock &lt; cooldown then
			return false
		end
		cooldownUntil[player] = nil
	end
	return not isInRun(player)
end

local admit: (player: Player, pad: Pad) -&gt; ()

-- Asks Roblox whether `player` is friends with the host, then runs admit() again. Everything is
-- re-checked after the yield: the party may have filled up, started launching, changed host or
-- privacy, or the player may have walked off or left.
local function startFriendCheck(player: Player, pad: Pad, party: Party)
	local host = party.Host
	pendingJoin[player] = true
	task.spawn(function()
		local ok, result = false, nil
		if player.Parent == Players and host.Parent == Players then
			ok, result = pcall(player.IsFriendsWithAsync, player, host.UserId)
		end
		pendingJoin[player] = nil
		if player.Parent ~= Players then
			return
		end
		if ok then
			storeFriendship(player, host.UserId, result == true, FRIEND_CACHE_TTL)
		else
			-- The web call failed: count it as "no" briefly so they get a clear answer, then retry.
			storeFriendship(player, host.UserId, false, FRIEND_FAIL_TTL)
		end

		-- Same party, same host, player still free and standing in the pad? Otherwise the next poll
		-- simply starts over with whatever is true now.
		if party.Dead or pad.Party ~= party or party.Host ~= host then
			return
		end
		if not canEnterPads(player, os.clock()) then
			return
		end
		local root = Characters.GetRoot(player)
		if not root or not isInsideZone(pad.Info.Zone, root.Position) then
			return
		end
		admit(player, pad) -- the answer is cached now, so this doesn't yield again
	end)
end

-- Decides what happens to a free player standing in `pad`.
function admit(player: Player, pad: Pad)
	local party = pad.Party
	if not party then
		createParty(pad, player)
		return
	end
	if party.Status == "Picking" then
		eject(player, pad, party.Host.DisplayName .. " is picking a dishwasher. Try another pad!")
		return
	end
	if inLockWindow(party) then
		eject(player, pad, "🚀 That party is launching! Try another pad.")
		return
	end
	if #party.Members &gt;= party.MaxPlayers then
		eject(player, pad, "This party is full!")
		return
	end
	if party.Privacy == "Friends" then
		local isFriend = cachedFriendship(player, party.Host)
		if isFriend == nil then
			startFriendCheck(player, pad, party)
			return
		elseif not isFriend then
			eject(player, pad, "👥 Friends only!")
			return
		end
	end
	joinParty(party, player)
end

----------------------------------------------------------------------------------------------------
-- Launch
----------------------------------------------------------------------------------------------------

local function launch(party: Party)
	local pad = party.Pad
	party.Status = "Launching"

	-- Only take members who can actually play right now; drop the rest.
	local roster: { Player } = {}
	for _, member in table.clone(party.Members) do
		if member.Parent ~= Players then
			removeMember(member, "Gone")
		elseif isInRun(member) then
			removeMember(member, "Stay")
		elseif not Characters.IsAlive(member) then
			removeMember(member, "Stay", "You left the party.")
		else
			table.insert(roster, member)
		end
	end
	if party.Dead or #roster == 0 then
		return -- removeMember dissolved it
	end

	for _, member in roster do
		launching[member] = true
	end
	markDirty(party)
	refreshPad(pad)
	playPadSound(pad, "Splash")

	local level = party.Level
	task.spawn(function()
		-- StartRound yields while it builds the dishwasher. Pass a copy: it's RoundService's now.
		local ok, started, err = pcall(RoundService.StartRound, table.clone(roster), level)
		for _, member in roster do
			launching[member] = nil
		end
		if not ok then
			warn("[PartyService] StartRound errored: " .. tostring(started))
		end
		if party.Dead then
			return -- everyone left or died while the dishwasher was being built
		end

		if ok and started == true then
			-- RoundService has already moved everyone into the dishwasher (and sent RunState), so just
			-- let go of them here without teleporting. Anyone it didn't take is walked out of the pad.
			party.Dead = true
			for _, member in party.Members do
				releaseMember(party, member, if isInRun(member) then "Stay" else "Exit")
			end
			table.clear(party.Members)
			if pad.Party == party then
				pad.Party = nil
			end
			refreshPad(pad)
		else
			if ok and err then
				warn("[PartyService] StartRound refused pad " .. party.PadId .. ": " .. tostring(err))
			end
			party.Status = "Waiting"
			party.EndsAt = math.max(party.EndsAt, Util.Now()) + RETRY_DELAY
			for _, member in party.Members do
				notify(member, "All dishwashers are busy, trying again...", "Bad")
			end
			markDirty(party)
			refreshPad(pad)
		end
	end)
end

----------------------------------------------------------------------------------------------------
-- Poll loop
----------------------------------------------------------------------------------------------------

-- Keeps one member honest: still here, not in a run, alive, and inside their pad.
local function validateMember(party: Party, player: Player, clock: number)
	if memberOf[player] ~= party then
		return
	end
	if player.Parent ~= Players then
		removeMember(player, "Gone")
		return
	end
	if isInRun(player) then
		removeMember(player, "Stay")
		return
	end
	local root = Characters.GetRoot(player)
	if not root then
		-- Dead or no character. The Died / CharacterRemoving hooks normally get here first.
		removeMember(player, "Stay", "You left the party.")
		return
	end
	if not isHeldInZone(party.Pad.Info.Zone, root.Position) then
		-- Glitched or exploited out through a wall: put them back on their spot.
		if clock - (lastPutBack[player] or 0) &gt;= PUT_BACK_COOLDOWN then
			lastPutBack[player] = clock
			Characters.SetGroup(player, Characters.Groups.PartyMember)
			teleport(player, slotCFrame(party.Pad, party.Slots[player] or 1))
		end
	end
end

local function loadPads(): boolean
	if padsLoaded then
		return true
	end
	local ok, lobby = pcall(LobbyBuilder.GetLobby)
	local padList = ok and lobby and (lobby :: any).Pads
	if type(padList) ~= "table" then
		return false
	end
	for _, raw in padList do
		local info = raw :: PadInfo
		local zone = (info :: any).Zone
		if typeof(zone) == "Instance" and zone:IsA("BasePart") and typeof(info.Inside) == "CFrame" and typeof(info.Exit) == "CFrame" then
			-- The walls must only block party members (LobbyBuilder sets this; make sure of it).
			local barriers: { BasePart } = info.Barriers or {}
			for _, barrier in barriers do
				if typeof(barrier) == "Instance" and barrier:IsA("BasePart") and barrier.CollisionGroup ~= Characters.Groups.PadBarrier then
					barrier.CollisionGroup = Characters.Groups.PadBarrier
				end
			end
			local pad: Pad = { Info = info, Party = nil, FloorColor = nil, Sounds = {} }
			table.insert(pads, pad)
			refreshPad(pad)
		else
			warn("[PartyService] pad " .. tostring(info.Id) .. " has no Zone/Inside/Exit, skipped")
		end
	end
	padsLoaded = true
	return true
end

local function tick()
	if not padsLoaded and not loadPads() then
		warnThrottled("waiting for LobbyBuilder.GetLobby() to return the pads")
		return
	end
	local now = Util.Now()
	local clock = os.clock()

	-- 1) Existing parties: hold members in, drop invalid ones, launch when the countdown is over.
	--    Members of a launching party are left alone: RoundService is busy moving them.
	for _, pad in pads do
		local party = pad.Party
		if party and (party.Status == "Waiting" or party.Status == "Picking") then
			for _, member in table.clone(party.Members) do
				validateMember(party, member, clock)
			end
			if not party.Dead and party.Status == "Waiting" and now &gt;= party.EndsAt then
				launch(party)
			elseif not party.Dead and party.Status == "Picking" and now &gt;= party.EndsAt then
				removeMember(party.Host, "Exit", "Party cancelled: you didn't pick a dishwasher in time.")
			end
		end
	end

	-- 2) Free players standing in a pad.
	for _, player in Players:GetPlayers() do
		if canEnterPads(player, clock) then
			local root = Characters.GetRoot(player)
			if root then
				local position = root.Position
				for _, pad in pads do
					local zone = pad.Info.Zone
					if zone.Parent and isInsideZone(zone, position) then
						admit(player, pad)
						break
					end
				end
			end
		end
	end
end

----------------------------------------------------------------------------------------------------
-- PartyAction (client requests)
----------------------------------------------------------------------------------------------------

local function onPartyAction(player: Player, action: any, value: any)
	if not allowAction(player) or type(action) ~= "string" then
		return
	end
	local party = memberOf[player]
	if not party or party.Dead then
		return
	end

	if action == "Leave" then
		if inLockWindow(party) then
			notify(player, "Too late to leave, the dishwasher is starting!", "Bad")
			return
		end
		removeMember(player, "Exit")
		return
	end

	-- Everything else is a host setting, and settings freeze once the party is launching.
	if party.Host ~= player then
		notify(player, "Only the host can change that.", "Bad")
		return
	end
	if party.Status == "Launching" then
		return
	end

	if action == "Create" then
		-- The host confirms the Create Party screen: { Level, MaxPlayers, Privacy }.
		if party.Status ~= "Picking" or type(value) ~= "table" then
			return
		end
		local level, max, privacy = value.Level, value.MaxPlayers, value.Privacy
		if not isInteger(level) or level &lt; 1 or level &gt; #Config.Levels then
			return
		end
		if level &gt; unlockedOf(player) then
			notify(player, "🔒 That dishwasher is still locked!", "Bad")
			return
		end
		if not isInteger(max) or max &lt; 1 or max &gt; MAX_PLAYERS then
			return
		end
		if privacy ~= "Public" and privacy ~= "Friends" then
			return
		end
		party.Level = level
		party.LevelChosen = true
		party.MaxPlayers = max
		party.Privacy = privacy
		party.Status = "Waiting"
		party.EndsAt = Util.Now() + PARTY.Countdown
		markDirty(party)
		refreshPad(party.Pad, true)
		playPadSound(party.Pad, "Pop")
		return
	end

	if action == "SetMax" then
		if not isInteger(value) or value &lt; 1 or value &gt; MAX_PLAYERS then
			return
		end
		if value &lt; #party.Members then
			notify(player, "There are already " .. #party.Members .. " players in the party.", "Bad")
			return
		end
		party.MaxPlayers = value
	elseif action == "SetPrivacy" then
		if value ~= "Public" and value ~= "Friends" then
			return
		end
		party.Privacy = value
	elseif action == "SetLevel" then
		if not isInteger(value) or value &lt; 1 or value &gt; #Config.Levels then
			return
		end
		if value &gt; unlockedOf(player) then
			notify(player, "🔒 That dishwasher is still locked!", "Bad")
			return
		end
		party.Level = value
		party.LevelChosen = true
	elseif action == "StartNow" then
		if party.Status ~= "Waiting" then
			return
		end
		party.EndsAt = math.min(party.EndsAt, Util.Now()) -- the poll loop launches it next tick
	else
		return
	end
	markDirty(party)
	refreshPad(party.Pad)
end

----------------------------------------------------------------------------------------------------
-- Players joining and leaving the server
----------------------------------------------------------------------------------------------------

local function onPlayerRemoving(player: Player)
	removeMember(player, "Gone")
	unhookMember(player)
	pendingJoin[player] = nil
	launching[player] = nil
	cooldownUntil[player] = nil
	lastPutBack[player] = nil
	actionWindow[player] = nil
	friendCache[player] = nil
	local userId = player.UserId
	for _, byHost in friendCache do
		byHost[userId] = nil
	end
end

-- A host whose profile finished loading after they made the party: default the level to their best
-- dishwasher (unless they already picked one) and send the new HostUnlocked.
local function onProfileLoaded(player: Player)
	local party = memberOf[player]
	if not party or party.Dead then
		return
	end
	if party.Host == player and not party.LevelChosen and party.Status ~= "Launching" then
		party.Level = unlockedOf(player)
	end
	markDirty(party)
	refreshPad(party.Pad)
end

----------------------------------------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------------------------------------

function PartyService.Init()
	partyStateRemote = Remotes.Event("PartyState")
	notifyRemote = Remotes.Event("Notify")

	if not loadPads() then
		warn("[PartyService] lobby pads not ready at Init; will keep trying")
	end

	Remotes.Event("PartyAction").OnServerEvent:Connect(onPartyAction)

	Players.PlayerAdded:Connect(function(player)
		player:SetAttribute("InParty", false)
	end)
	for _, player in Players:GetPlayers() do
		if player:GetAttribute("InParty") == nil then
			player:SetAttribute("InParty", false)
		end
	end
	Players.PlayerRemoving:Connect(onPlayerRemoving)

	local profileLoaded = DataService.ProfileLoaded
	if profileLoaded then
		profileLoaded:Connect(onProfileLoaded)
	end

	-- Party members are removed the moment they die, so a respawning player is never in a party and
	-- this resolver has no opinion (the lobby spawn or RoundService decides).
	Characters.AddRespawnResolver(function(_player: Player): CFrame?
		return nil
	end)
end

function PartyService.Start()
	task.spawn(function()
		while true do
			local ok, err = xpcall(tick, debug.traceback)
			if not ok then
				warnThrottled("poll error: " .. tostring(err))
			end
			task.wait(PARTY.PollInterval)
		end
	end)

	-- Billboards: the countdown text changes once a second, so 4 checks a second keeps it crisp.
	task.spawn(function()
		while true do
			task.wait(LABEL_INTERVAL)
			for _, pad in pads do
				local ok, err = pcall(refreshPad, pad)
				if not ok then
					warnThrottled("pad refresh error: " .. tostring(err))
				end
			end
		end
	end)
end

function PartyService.IsInParty(player: Player): boolean
	return memberOf[player] ~= nil
end

-- Takes a player out of their party right now (ignores the launch lock), walking them out of the
-- pad unless they're in a run.
function PartyService.RemovePlayer(player: Player)
	removeMember(player, "Exit")
end

return PartyService</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000016"><Properties><string name="Name">PetService</string><ProtectedString name="Source">-- PetService: pet inventory (Hatch / Equip / Unequip / EquipBest / Delete), the EquippedPets
-- folders clients render from, and the pet auto-clean loop inside runs.
--
--   * Every inventory op validates everything first, then writes the profile with no yield in
--     between, then pushes MetaState, rebuilds EquippedPets and refreshes run stats. Ops never
--     throw: any error comes back as { Ok = false, Error = ... }. A per-player lock stops two
--     requests from interleaving if a DataService call ever yields.
--   * Hatch rolls the pets BEFORE taking the Bubbles, so nothing after the payment can fail halfway.
--   * Only the first GetPetSlots(player) valid uids of profile.Equipped are "active" (rendered and
--     cleaning). Equipped is never trimmed on load: game passes are checked asynchronously after
--     the profile loads, so trimming would cost a +2 slot owner their pets on every join. A slow
--     watcher rebuilds whenever the slot count changes (perk bought, pass granted).
--   * Auto-clean (every PetRules.ThinkInterval): each active slot holds one grime target. The pet
--     "flies" for distance / Speed seconds (clients animate it from the Target ObjectValue), then
--     deals GetRunPower(owner) * PowerShare per second through RoundService.DamageGrime(..., true).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Types = require(Shared:WaitForChild("Types"))
local Util = require(Shared:WaitForChild("Util"))

local DataService = require(script.Parent:WaitForChild("DataService"))
local RoundService = require(script.Parent:WaitForChild("RoundService"))

local PetService = {}

----------------------------------------------------------------------------------------------------
-- Tuning (gameplay numbers live in Config.PetRules)
----------------------------------------------------------------------------------------------------

local RULES = Config.PetRules
local FOLDER_NAME = "EquippedPets"
local MAX_HIT_DT = RULES.ThinkInterval * 2 -- a server hitch can't turn into one giant pet hit
local QUERY_MAX_PARTS = 250 -- grime parts considered per owner per think
local SLOT_WATCH_INTERVAL = 1 -- seconds between slot-count checks (perks / passes / late profiles)
local MAX_SLOTS = 20 -- sanity clamp on whatever GetPetSlots returns
local MAX_UID_LENGTH = 16
-- Legendary hatches are announced after the hatcher's reveal animation (egg wobbles, flash,
-- card), so their own toast doesn't spoil it.
local ANNOUNCE_DELAY = 3
local LOADING = "Your data is still loading. Try again in a moment!"

----------------------------------------------------------------------------------------------------
-- Types
----------------------------------------------------------------------------------------------------

-- Profile fields this service reads and writes (DESIGN.md section 5, DataService).
type Profile = {
	Bubbles: number,
	Perks: { [string]: number },
	Pets: { Types.PetEntry },
	Equipped: { string },
	NextUid: number,
	Unlocked: number,
}

type ActiveEntry = { Uid: string, Id: string, Share: number }

-- One active pet slot: the replicated StringValue/ObjectValue pair plus server-only cleaning state.
type Slot = {
	Uid: string,
	PetId: string,
	Share: number, -- def.PowerShare
	Value: StringValue, -- EquippedPets["&lt;index&gt;"], Value = pet id
	TargetValue: ObjectValue, -- its "Target" child
	Target: BasePart?, -- the grime part this pet is cleaning (mirrors TargetValue.Value)
	ArriveAt: number, -- os.clock() when the pet reaches Target
	LastHit: number, -- os.clock() of the last damage tick (the next tick's dt starts here)
	From: Vector3?, -- where the pet just finished a spot (travel starts there); nil = at the owner
}

type OwnerState = {
	Slots: { Slot },
	Cap: number, -- slot count the folder was last built with (-1 = never built)
	Loaded: boolean, -- the profile has been seen and sanitized
	Ignore: { [BasePart]: boolean }, -- weak-keyed: parts DamageGrime refused (not grime of this run)
}

----------------------------------------------------------------------------------------------------
-- State
----------------------------------------------------------------------------------------------------

local owners: { [Player]: OwnerState } = {}
local busy: { [Player]: boolean } = {}
-- Players who have left. Weak keys, so this can't leak; it stops a late rebuild from recreating
-- state for someone who is already gone.
local gone: { [Player]: boolean } = setmetatable({}, { __mode = "k" }) :: any
local rng = Random.new()
local overlap = OverlapParams.new()
overlap.FilterType = Enum.RaycastFilterType.Include
overlap.MaxParts = QUERY_MAX_PARTS

local NotifyRemote: RemoteEvent

----------------------------------------------------------------------------------------------------
-- Small helpers
----------------------------------------------------------------------------------------------------

-- pcall wrapper for calls into other services (DataService / RoundService may be mid-rewrite or
-- fail); errors are logged and swallowed so an inventory op never half-applies because of them.
local function safe(fn: any, ...: any): (boolean, any)
	if type(fn) ~= "function" then
		return false, nil
	end
	local ok, result = pcall(fn, ...)
	if not ok then
		warn("[PetService] " .. tostring(result))
		return false, nil
	end
	return true, result
end

local function fail(message: string): Types.RequestResult
	return { Ok = false, Error = message }
end

local function isHere(player: Player): boolean
	return player.Parent == Players and not gone[player]
end

local function getProfile(player: Player): Profile?
	local ok, profile = safe(DataService.Get, player)
	if ok and type(profile) == "table" then
		return profile :: Profile
	end
	return nil
end

-- Equip slots right now, from DataService (perks + passes). Falls back to perks only.
local function slotCap(player: Player, profile: Profile?): number
	local ok, n = safe(DataService.GetPetSlots, player)
	if not ok or type(n) ~= "number" or n ~= n then
		n = Config.PetSlots(profile and profile.Perks, nil)
	end
	return math.clamp(math.floor(n), 0, MAX_SLOTS)
end

local function inRun(player: Player): boolean
	local ok, result = safe(RoundService.IsInRun, player)
	return ok and result == true
end

-- Living character root, without depending on Characters (not in PetService's dependency list).
local function getRoot(player: Player): BasePart?
	local character = player.Character
	if not character then
		return nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health &lt;= 0 then
		return nil
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root
	end
	return nil
end

-- Client uids arrive as strings; tolerate an integer number, reject anything else.
local function normalizeUid(value: any): string?
	if type(value) == "number" and value == value and value % 1 == 0 and value &gt; 0 and value &lt; 1e12 then
		return string.format("%d", value)
	end
	if type(value) == "string" and #value &gt; 0 and #value &lt;= MAX_UID_LENGTH then
		return value
	end
	return nil
end

-- Numeric uids compare as numbers (so "10" sorts after "9"); anything else as strings.
local function uidLess(a: string, b: string): boolean
	local na, nb = tonumber(a), tonumber(b)
	if na and nb and na ~= nb then
		return na &lt; nb
	end
	return a &lt; b
end

local function findPet(profile: Profile, uid: string): (Types.PetEntry?, number?)
	for i, pet in profile.Pets do
		if pet.Uid == uid then
			return pet, i
		end
	end
	return nil, nil
end

----------------------------------------------------------------------------------------------------
-- Profile hygiene
----------------------------------------------------------------------------------------------------

--[[
	Makes the pet fields safe to work with. Cheap (at most MaxInventory pets), so every op runs it:
	  * Pets: drops malformed entries and duplicate uids. Pets whose id left Config are KEPT (they may
	    come back); they just can't be equipped.
	  * Equipped: drops duplicates, unknown uids and pets without a Config entry. It is NOT trimmed
	    to the slot count (see the header).
	  * NextUid: a positive integer greater than every numeric uid, so a new uid can never collide.
]]
local function sanitize(profile: Profile)
	local p = profile :: any
	if type(p.Pets) ~= "table" then
		p.Pets = {}
	end
	if type(p.Equipped) ~= "table" then
		p.Equipped = {}
	end

	local pets = {}
	local byUid: { [string]: Types.PetEntry } = {}
	local maxUid = 0
	for _, pet in p.Pets do
		if type(pet) == "table" and type(pet.Uid) == "string" and type(pet.Id) == "string" and not byUid[pet.Uid] then
			byUid[pet.Uid] = pet
			table.insert(pets, pet)
			local n = tonumber(pet.Uid)
			if n and n &gt; maxUid then
				maxUid = n
			end
		end
	end
	if #pets ~= #p.Pets then
		p.Pets = pets
	end

	local equipped = {}
	local seen: { [string]: boolean } = {}
	for _, uid in p.Equipped do
		local pet = type(uid) == "string" and byUid[uid] or nil
		if pet and not seen[uid] and Config.Pets[pet.Id] then
			seen[uid] = true
			table.insert(equipped, uid)
		end
	end
	if #equipped ~= #p.Equipped then
		p.Equipped = equipped
	end

	local raw = tonumber(p.NextUid)
	local nextUid: number = 1
	if raw and raw == raw and raw &gt;= 1 and raw &lt; math.huge then
		nextUid = math.floor(raw)
	end
	if nextUid &lt;= maxUid then
		nextUid = math.floor(maxUid) + 1
	end
	p.NextUid = nextUid
end

-- The pets that are actually out: the first `cap` equipped uids that still resolve to a Config pet.
local function activeEntries(profile: Profile, cap: number): { ActiveEntry }
	local byUid: { [string]: Types.PetEntry } = {}
	for _, pet in profile.Pets do
		byUid[pet.Uid] = pet
	end
	local out: { ActiveEntry } = {}
	for _, uid in profile.Equipped do
		if #out &gt;= cap then
			break
		end
		local pet = byUid[uid]
		local def = pet and Config.Pets[pet.Id]
		if pet and def then
			table.insert(out, { Uid = uid, Id = pet.Id, Share = def.PowerShare })
		end
	end
	return out
end

----------------------------------------------------------------------------------------------------
-- EquippedPets folder (DESIGN.md section 4): StringValue "1".."n" (Value = pet id), each with an
-- ObjectValue "Target" (Value = grime part or nil). Clients render from this and nothing else.
----------------------------------------------------------------------------------------------------

local function ensureState(player: Player): OwnerState?
	if not isHere(player) then
		return nil
	end
	local state = owners[player]
	if not state then
		state = {
			Slots = {},
			Cap = -1,
			Loaded = false,
			Ignore = setmetatable({}, { __mode = "k" }) :: any,
		}
		owners[player] = state
	end
	return state
end

local function getFolder(player: Player): Folder?
	if not isHere(player) then
		return nil
	end
	local existing = player:FindFirstChild(FOLDER_NAME)
	if existing and existing:IsA("Folder") then
		return existing
	end
	local folder = Instance.new("Folder")
	folder.Name = FOLDER_NAME
	folder.Parent = player
	return folder
end

local function setTarget(slot: Slot, part: BasePart?)
	slot.Target = part
	if slot.TargetValue.Value ~= part then
		slot.TargetValue.Value = part
	end
end

local function destroySlot(slot: Slot)
	slot.Target = nil
	slot.Value:Destroy()
end

local function newSlot(folder: Folder, index: number, entry: ActiveEntry): Slot
	local value = Instance.new("StringValue")
	value.Name = tostring(index)
	value.Value = entry.Id
	value:SetAttribute("Uid", entry.Uid)

	local target = Instance.new("ObjectValue")
	target.Name = "Target"
	target.Parent = value

	value.Parent = folder
	return {
		Uid = entry.Uid,
		PetId = entry.Id,
		Share = entry.Share,
		Value = value,
		TargetValue = target,
		Target = nil,
		ArriveAt = 0,
		LastHit = 0,
		From = nil,
	}
end

--[[
	Brings the folder in line with the profile. A slot whose pet id is unchanged keeps its
	StringValue (and its target), so the client model doesn't flicker. A slot whose pet changed is
	destroyed and recreated, so a renderer that only listens to ChildAdded/ChildRemoved stays correct.
]]
local function rebuild(player: Player)
	local state = ensureState(player)
	local folder = getFolder(player)
	if not state or not folder then
		return
	end
	local profile = getProfile(player)
	local cap = slotCap(player, profile)
	local active: { ActiveEntry } = {}
	if profile then
		sanitize(profile)
		state.Loaded = true
		active = activeEntries(profile, cap)
	end
	state.Cap = cap

	for i, entry in active do
		local slot = state.Slots[i]
		if slot and slot.PetId == entry.Id and slot.Value.Parent == folder then
			slot.Uid = entry.Uid
			slot.Share = entry.Share
			if slot.Value:GetAttribute("Uid") ~= entry.Uid then
				slot.Value:SetAttribute("Uid", entry.Uid)
			end
		else
			if slot then
				destroySlot(slot)
			end
			state.Slots[i] = newSlot(folder, i, entry)
		end
	end
	for i = #state.Slots, #active + 1, -1 do
		destroySlot(state.Slots[i])
		state.Slots[i] = nil
	end

	-- Anything else in the folder (left over from an old slot layout) goes.
	local keep: { [Instance]: boolean } = {}
	for _, slot in state.Slots do
		keep[slot.Value] = true
	end
	for _, child in folder:GetChildren() do
		if not keep[child] then
			child:Destroy()
		end
	end
end

----------------------------------------------------------------------------------------------------
-- Auto-clean loop (DESIGN.md section 5, "PetService"). Every ThinkInterval, for players in a run:
--   * a slot keeps its target while it's still alive and within Range of the owner
--   * otherwise it claims the nearest unclaimed grime part within Range (parts already targeted by
--     another slot of the same owner this tick don't count)
--   * a freshly-claimed target gets an arrival delay (distance / Speed); only after arriving does it
--     start dealing GetRunPower(owner) * PowerShare per second, applied via RoundService.DamageGrime
--   * a full tank clears every target (pets drift back to the owner formation on the client)
--   * outside a run every Target is nil
----------------------------------------------------------------------------------------------------

local function tankFull(player: Player): boolean
	local ok, full = safe(RoundService.IsTankFull, player)
	return ok and full == true
end

local function runPower(player: Player): number
	local ok, power = safe(RoundService.GetRunPower, player)
	if ok and type(power) == "number" and power == power and power &gt;= 0 then
		return power
	end
	return 0
end

-- true while the part is still alive (see RoundService.DamageGrime).
local function damageGrime(owner: Player, part: BasePart, amount: number): boolean
	local ok, alive = safe(RoundService.DamageGrime, owner, part, amount, true)
	return ok and alive == true
end

local function grimeFolderOf(player: Player): Folder?
	local ok, folder = safe(RoundService.GetGrimeFolder, player)
	if ok and typeof(folder) == "Instance" and folder:IsA("Folder") then
		return folder
	end
	return nil
end

-- Drops every slot's target (used when the owner leaves the run or their tank fills up).
local function clearTargets(state: OwnerState)
	for _, slot in state.Slots do
		if slot.Target then
			setTarget(slot, nil)
		end
		slot.From = nil
	end
end

-- Nearest grime part in `grimeFolder` within Range of `root` that isn't in `claimed` or `ignored`.
local function pickTarget(root: BasePart, grimeFolder: Folder, claimed: { [BasePart]: boolean }, ignored: { [BasePart]: boolean }): BasePart?
	overlap.FilterDescendantsInstances = { grimeFolder }
	local ok, parts = pcall(workspace.GetPartBoundsInRadius, workspace, root.Position, RULES.Range, overlap)
	if not ok or type(parts) ~= "table" then
		return nil
	end
	local best: BasePart? = nil
	local bestDist = math.huge
	for _, part in parts do
		if part:IsA("BasePart") and not claimed[part] and not ignored[part] then
			local dist = (part.Position - root.Position).Magnitude
			if dist &lt;= RULES.Range and dist &lt; bestDist then
				best = part
				bestDist = dist
			end
		end
	end
	return best
end

-- One think tick for a single owner. `now` is os.clock(), shared by every owner this tick.
local function think(player: Player, state: OwnerState, now: number)
	if #state.Slots == 0 then
		return
	end
	if not inRun(player) then
		clearTargets(state)
		return
	end
	local root = getRoot(player)
	local grimeFolder = grimeFolderOf(player)
	if not root or not grimeFolder then
		clearTargets(state)
		return
	end
	if tankFull(player) then
		clearTargets(state)
		return
	end

	-- Parts already spoken for this tick, so two slots of the same owner never chase the same spot.
	local claimed: { [BasePart]: boolean } = {}
	for _, slot in state.Slots do
		if slot.Target then
			claimed[slot.Target] = true
		end
	end

	local power = runPower(player)

	for _, slot in state.Slots do
		local target = slot.Target
		if target then
			local alive = target.Parent == grimeFolder
			if alive and (target.Position - root.Position).Magnitude &gt; RULES.Range then
				alive = false
			end
			if not alive then
				claimed[target] = nil
				slot.From = target.Position
				setTarget(slot, nil)
				target = nil
			end
		end

		if not target then
			local pick = pickTarget(root, grimeFolder, claimed, state.Ignore)
			if pick then
				claimed[pick] = true
				local from = slot.From or root.Position
				local travel = (pick.Position - from).Magnitude / RULES.Speed
				slot.ArriveAt = now + travel
				slot.LastHit = now + travel -- damage starts counting from the moment it arrives
				slot.From = nil
				setTarget(slot, pick)
				target = pick
			end
		end

		if target and now &gt;= slot.ArriveAt then
			local sinceLast = math.min(now - slot.LastHit, MAX_HIT_DT)
			if sinceLast &gt; 0 then
				slot.LastHit = now
				local amount = power * slot.Share * sinceLast
				if amount &gt; 0 then
					local alive = damageGrime(player, target, amount)
					if not alive then
						if target.Parent then
							-- Refused for a reason other than dying (e.g. it stopped belonging to this
							-- run mid-tick). Remember it so this slot doesn't just re-target it.
							state.Ignore[target] = true
						end
						slot.From = target.Position
						setTarget(slot, nil)
					end
				end
			end
		end
	end
end

local function autoCleanTick()
	local now = os.clock()
	for player, state in owners do
		if isHere(player) then
			local ok, err = pcall(think, player, state, now)
			if not ok then
				warn("[PetService] auto-clean tick failed for " .. player.Name .. ": " .. tostring(err))
			end
		end
	end
end

-- Catches slot-count changes that don't go through PetService itself: a Pet Slot perk purchase
-- (ShopService writes profile.Perks directly) or a +2 Pet Slots pass grant that raced ahead of
-- PassesChanged (SetPass already fires it, but this is a cheap, harmless backstop).
local function slotWatchTick()
	for player, state in owners do
		if isHere(player) and state.Loaded then
			local profile = getProfile(player)
			local cap = slotCap(player, profile)
			if cap ~= state.Cap then
				local ok, err = pcall(rebuild, player)
				if not ok then
					warn("[PetService] slot watcher rebuild failed for " .. player.Name .. ": " .. tostring(err))
				end
			end
		end
	end
end

----------------------------------------------------------------------------------------------------
-- Inventory operations
----------------------------------------------------------------------------------------------------

-- Everything that follows a successful change. equipChanged = the active pets may differ, which
-- changes the coin bonus RoundService folds into run stats.
local function afterChange(player: Player, equipChanged: boolean)
	safe(DataService.PushMeta, player)
	rebuild(player)
	if equipChanged and inRun(player) then
		safe(RoundService.RefreshStats, player)
	end
end

-- Runs one op under the player's lock and turns any error into a RequestResult.
local function guarded(player: any, op: (Player, any, any) -&gt; Types.RequestResult, a: any, b: any): Types.RequestResult
	if typeof(player) ~= "Instance" or not player:IsA("Player") then
		return fail("Unknown player.")
	end
	if busy[player] then
		return fail("Hold on, still working on your last request!")
	end
	busy[player] = true
	local ok, result = pcall(op, player, a, b)
	busy[player] = nil
	if not ok then
		warn("[PetService] " .. tostring(result))
		return fail("Something went wrong. Try again!")
	end
	return result
end

-- Puts newly hatched pets into empty slots (never replaces anything). Returns true if it did.
local function autoEquip(player: Player, profile: Profile, hatched: { Types.PetEntry }): boolean
	local cap = slotCap(player, profile)
	local changed = false
	for _, pet in hatched do
		if #profile.Equipped &gt;= cap then
			break
		end
		table.insert(profile.Equipped, pet.Uid)
		changed = true
	end
	return changed
end

local function announceLegendary(player: Player, petName: string)
	local who = player.DisplayName
	task.delay(ANNOUNCE_DELAY, function()
		NotifyRemote:FireAllClients(string.format("%s hatched a Legendary %s!", who, petName), "Good")
	end)
end

local function hatch(player: Player, eggId: any, count: any): Types.RequestResult
	if type(eggId) ~= "string" then
		return fail("That egg doesn't exist.")
	end
	if count ~= 1 and count ~= 3 then
		return fail("You can hatch 1 or 3 eggs at a time.")
	end
	local egg = Config.GetEgg(eggId)
	if not egg then
		return fail("That egg doesn't exist.")
	end
	local profile = getProfile(player)
	if not profile then
		return fail(LOADING)
	end
	sanitize(profile)

	local unlocked = tonumber(profile.Unlocked) or 1
	if unlocked &lt; egg.RequiredLevel then
		local level = Config.Levels[egg.RequiredLevel]
		local where = if level then level.Icon .. " " .. level.Name else "the next dishwasher"
		return fail(string.format("Unlock %s to hatch the %s!", where, egg.Name))
	end
	local room = RULES.MaxInventory - #profile.Pets
	if room &lt; count then
		if room &lt;= 0 then
			return fail("Your pet inventory is full! Delete some pets first.")
		end
		return fail(string.format("Only room for %d more pet%s! Delete some first.", room, if room == 1 then "" else "s"))
	end
	local cost = egg.Cost * count
	if (tonumber(profile.Bubbles) or 0) &lt; cost then
		return fail(string.format("Not enough Bubbles! You need %s 🧼.", Format.Commas(cost)))
	end

	-- Roll first: after the payment below, nothing can fail.
	local rolled: { string } = {}
	for i = 1, count do
		rolled[i] = Util.WeightedPick(egg.Pets, "Chance", rng).Pet
	end
	local paid, spent = safe(DataService.SpendBubbles, player, cost)
	if not paid or spent ~= true then
		return fail("Not enough Bubbles!")
	end

	local used: { [string]: boolean } = {}
	for _, pet in profile.Pets do
		used[pet.Uid] = true
	end
	local nextUid = profile.NextUid
	local hatched: { Types.PetEntry } = {}
	for _, petId in rolled do
		while used[tostring(nextUid)] do
			nextUid += 1
		end
		local uid = tostring(nextUid)
		nextUid += 1
		used[uid] = true
		table.insert(profile.Pets, { Uid = uid, Id = petId })
		table.insert(hatched, { Uid = uid, Id = petId }) -- a separate copy goes over the network
	end
	profile.NextUid = nextUid

	safe(DataService.AddStat, player, "EggsHatched", count)
	afterChange(player, autoEquip(player, profile, hatched))

	for _, pet in hatched do
		local def = Config.Pets[pet.Id]
		if def and def.Rarity == "Legendary" then
			announceLegendary(player, def.Name)
		end
	end
	return { Ok = true, Pets = hatched }
end

local function equip(player: Player, rawUid: any): Types.RequestResult
	local uid = normalizeUid(rawUid)
	local profile = getProfile(player)
	if not profile then
		return fail(LOADING)
	end
	sanitize(profile)
	local pet = uid and findPet(profile, uid)
	if not uid or not pet then
		return fail("That pet doesn't exist.")
	end
	if not Config.Pets[pet.Id] then
		return fail("That pet can't be equipped.")
	end
	if table.find(profile.Equipped, uid) then
		return { Ok = true } -- already out (double click): nothing to do
	end
	local cap = slotCap(player, profile)
	if #profile.Equipped &gt;= cap then
		return fail(string.format("All %d pet slots are full! Unequip a pet first.", cap))
	end
	table.insert(profile.Equipped, uid)
	afterChange(player, true)
	return { Ok = true }
end

local function unequip(player: Player, rawUid: any): Types.RequestResult
	local uid = normalizeUid(rawUid)
	local profile = getProfile(player)
	if not profile then
		return fail(LOADING)
	end
	sanitize(profile)
	if not uid or not findPet(profile, uid) then
		return fail("That pet doesn't exist.")
	end
	local index = table.find(profile.Equipped, uid)
	if not index then
		return { Ok = true } -- already put away
	end
	table.remove(profile.Equipped, index)
	afterChange(player, true)
	return { Ok = true }
end

type Ranked = { Uid: string, Share: number, Coin: number }

local function equipBest(player: Player): Types.RequestResult
	local profile = getProfile(player)
	if not profile then
		return fail(LOADING)
	end
	sanitize(profile)

	local ranked: { Ranked } = {}
	for _, pet in profile.Pets do
		local def = Config.Pets[pet.Id]
		if def then
			table.insert(ranked, { Uid = pet.Uid, Share = def.PowerShare, Coin = def.CoinBonus })
		end
	end
	if #ranked == 0 then
		return fail("You don't have any pets yet. Hatch an egg!")
	end
	-- Best cleaners first; ties go to the bigger coin bonus, then the older pet (stable order).
	table.sort(ranked, function(a, b)
		if a.Share ~= b.Share then
			return a.Share &gt; b.Share
		end
		if a.Coin ~= b.Coin then
			return a.Coin &gt; b.Coin
		end
		return uidLess(a.Uid, b.Uid)
	end)

	local cap = slotCap(player, profile)
	local best: { [string]: boolean } = {}
	for i = 1, math.min(cap, #ranked) do
		best[ranked[i].Uid] = true
	end
	-- Pets that stay keep their slot position (no model shuffle on the client); the rest follow in
	-- rank order.
	local equipped: { string } = {}
	for _, uid in profile.Equipped do
		if best[uid] then
			table.insert(equipped, uid)
			best[uid] = nil
		end
	end
	for i = 1, math.min(cap, #ranked) do
		local uid = ranked[i].Uid
		if best[uid] then
			table.insert(equipped, uid)
		end
	end

	local changed = #equipped ~= #profile.Equipped
	if not changed then
		for i, uid in equipped do
			if profile.Equipped[i] ~= uid then
				changed = true
				break
			end
		end
	end
	if changed then
		profile.Equipped = equipped
		afterChange(player, true)
	end
	return { Ok = true }
end

local function delete(player: Player, rawUid: any): Types.RequestResult
	local uid = normalizeUid(rawUid)
	local profile = getProfile(player)
	if not profile then
		return fail(LOADING)
	end
	sanitize(profile)
	if not uid then
		return fail("That pet doesn't exist.")
	end
	local _, index = findPet(profile, uid)
	if not index then
		return fail("That pet doesn't exist.")
	end
	table.remove(profile.Pets, index)
	local equippedAt = table.find(profile.Equipped, uid)
	if equippedAt then
		table.remove(profile.Equipped, equippedAt)
	end
	afterChange(player, equippedAt ~= nil)
	return { Ok = true }
end

-- Public API: each returns a Types.RequestResult and never throws.

function PetService.Hatch(player: Player, eggId: string, count: number): Types.RequestResult
	return guarded(player, hatch, eggId, count)
end

function PetService.Equip(player: Player, uid: string): Types.RequestResult
	return guarded(player, equip, uid)
end

function PetService.Unequip(player: Player, uid: string): Types.RequestResult
	return guarded(player, unequip, uid)
end

function PetService.EquipBest(player: Player): Types.RequestResult
	return guarded(player, function(p)
		return equipBest(p)
	end)
end

function PetService.Delete(player: Player, uid: string): Types.RequestResult
	return guarded(player, delete, uid)
end

-- Rebuilds a player's EquippedPets now (e.g. right after a Pet Slot perk purchase). Optional: the
-- slot watcher catches slot-count changes within SLOT_WATCH_INTERVAL anyway.
function PetService.Refresh(player: Player)
	if typeof(player) == "Instance" and player:IsA("Player") then
		local ok, err = pcall(rebuild, player)
		if not ok then
			warn("[PetService] Refresh: " .. tostring(err))
		end
	end
end

local initialized = false
local started = false

-- Rebuilds now, swallowing errors (used from signal handlers, where a throw would kill the signal
-- for every other listener too).
local function safeRebuild(player: Player)
	if isHere(player) then
		local ok, err = pcall(rebuild, player)
		if not ok then
			warn("[PetService] rebuild failed for " .. player.Name .. ": " .. tostring(err))
		end
	end
end

function PetService.Init()
	if initialized then
		return
	end
	initialized = true
	NotifyRemote = Remotes.Event("Notify")

	-- The profile may already be loaded for players who joined before this service subscribed
	-- (boot order, or a service restart in Studio).
	DataService.ProfileLoaded:Connect(function(player)
		safeRebuild(player)
	end)
	for _, player in Players:GetPlayers() do
		if getProfile(player) then
			task.spawn(safeRebuild, player)
		end
	end

	-- Pet slots depend on perks and passes; a pass grant (or the trim SetPass already does) can
	-- change the active count without going through any PetService op.
	DataService.PassesChanged:Connect(function(player)
		safeRebuild(player)
	end)

	Players.PlayerRemoving:Connect(function(player)
		gone[player] = true
		owners[player] = nil
		busy[player] = nil
	end)
end

function PetService.Start()
	if started then
		return
	end
	started = true

	task.spawn(function()
		while true do
			task.wait(RULES.ThinkInterval)
			autoCleanTick()
		end
	end)

	task.spawn(function()
		while true do
			task.wait(SLOT_WATCH_INTERVAL)
			slotWatchTick()
		end
	end)
end

return PetService</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000017"><Properties><string name="Name">RoundService</string><ProtectedString name="Source">-- RoundService: owns every run (one party inside one dishwasher).
--
-- A run's life:
--   StartRound  -&gt; claim an arena slot, ArenaBuilder.Build (yields), index the grime, create a
--                  PlayerRun per member, teleport them onto the open door, push RunState.
--   Playing     -&gt; Scrub packets and pets call DamageGrime; cleaned grime fills the tank; standing
--                  in the drain sells the tank for coins; coins buy upgrades and tools (RunRequest).
--   Complete    -&gt; the last spot is gone: Bubbles are paid, per-player Results are pushed, and after
--                  Config.Round.ResultsSeconds everyone still inside is sent back to the lobby.
--   Ended       -&gt; the last member left: the arena is destroyed and its slot is freed.
--
-- The server trusts nothing from the client: every Scrub is checked for run state, a finite aim,
-- reach and rate, and the damage it deals is derived from server-side time, never from the packet.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Types = require(Shared:WaitForChild("Types"))
local Util = require(Shared:WaitForChild("Util"))

local DataService = require(script.Parent:WaitForChild("DataService"))
local ArenaBuilder = require(script.Parent:WaitForChild("ArenaBuilder"))
local DishFactory = require(script.Parent:WaitForChild("DishFactory"))
local LobbyBuilder = require(script.Parent:WaitForChild("LobbyBuilder"))
local Characters = require(script.Parent:WaitForChild("Characters"))
local ToolModels = require(Shared:WaitForChild("ToolModels"))

local RoundService = {}

----------------------------------------------------------------------------------------------------
-- Types (server-side only; network payloads use Types.luau)
----------------------------------------------------------------------------------------------------

-- What ArenaBuilder.Build returns (DESIGN.md section 5, ArenaBuilder).
type Arena = {
	Slot: number,
	Name: string,
	Model: Model,
	Origin: CFrame,
	Spawns: { CFrame },
	DrainPosition: Vector3,
	DrainRadius: number?,
	StationPosition: Vector3?,
	GrimeFolder: Folder,
	Dishes: { [number]: any },
	TotalGrime: number,
	KillY: number?,
}

-- Cached copy of one grime spot's attributes. The table is the authority for HP during a run;
-- the part's "HP" attribute is only a mirror for clients.
type GrimeEntry = {
	HP: number,
	MaxHP: number,
	Units: number,
	DishId: number,
	Golden: boolean,
	MinTool: number,
	Color: Color3,
	Dead: boolean, -- set the instant the spot is retired, so a second hit in the same frame is a no-op
}

type DishState = {
	Id: number,
	Kind: string,
	Model: Model?,
	Center: Vector3,
	Remaining: number, -- grime spots left on this dish
	Units: number, -- total units of every spot it started with (for the dish bonus)
	Done: boolean,
}

type PlayerRun = {
	Coins: number,
	Tank: number,
	Upgrades: Types.RunUpgrades, -- global upgrades (TankSize, Sneakers); per-tool ones live in ToolUpgrades
	ToolIndex: number, -- the tool in hand
	OwnedTools: { boolean },
	ToolUpgrades: { Types.RunUpgrades }, -- [toolIndex] = that tool's HandSize / ScrubPower levels
	Stats: Types.RunStats,
	GrimeCleaned: number,
	LastScrubAt: number, -- os.clock() of the last accepted Scrub packet
	LastFullFX: number, -- os.clock() of the last "TankFull" FX (throttled)
	Results: Types.RunResults?,
}

type Run = {
	Id: number,
	Slot: number,
	Arena: Arena,
	ArenaName: string,
	Level: number,
	Players: { [Player]: PlayerRun },
	Order: { Player }, -- members in join order (spawn assignment, results order)
	MemberIds: { number }, -- cached UserIds for RunState.Members
	StartedAt: number, -- Util.Now() (server time, so client timers agree)
	Phase: "Playing" | "Complete",
	Ended: boolean,
	Total: number,
	Cleaned: number,
	Remaining: number,
	LastDamageAt: number, -- os.clock() (stuck guard)
	Grime: { [BasePart]: GrimeEntry },
	Dishes: { [number]: DishState },
	Overlap: OverlapParams, -- Include filter on this run's GrimeFolder, built once per run
	Connections: { RBXScriptConnection },
	DrainSound: Sound?,
	DrainRadius: number,
	KillY: number,
}

----------------------------------------------------------------------------------------------------
-- Constants
----------------------------------------------------------------------------------------------------

local R = Config.Round
local PUSH_INTERVAL = 0.1 -- RunState: at most one push per player per 0.1 s
local DRAIN_INTERVAL = 0.2
local WATCHDOG_INTERVAL = 0.5 -- fall guard + stuck guard
local DRAIN_MAX_DY = 8 -- vertical tolerance for "standing in the drain"
local TANK_FULL_FX_COOLDOWN = 2
-- Held-scrub packets closer together than this are dropped without touching LastScrubAt, so the
-- time rolls into the next accepted packet: no damage is lost, but a flood can't burn server CPU
-- on spatial queries.
local HOLD_MIN_INTERVAL = R.ScrubSendInterval * 0.4
local HP_EPSILON = 1e-3
local REQUESTS_PER_SECOND = 10
local LEFT_GAME = "PlayerRemoving" -- internal RemoveFromRun reason: skip everything client-facing
local EMPTY: { [string]: any } = table.freeze({})

----------------------------------------------------------------------------------------------------
-- State
----------------------------------------------------------------------------------------------------

local runs: { [number]: Run } = {}
local runOf: { [Player]: Run } = {}
local slotBusy: { [number]: boolean } = {}
local starting: { [Player]: boolean } = {} -- members of a StartRound that is still building
local pushInfo: { [Player]: { Last: number, Scheduled: boolean } } = {}
local requestWindow: { [Player]: { Start: number, Count: number } } = {}
local nextRunId = 0
local rng = Random.new()

local RunStateRemote: RemoteEvent
local RunFXRemote: RemoteEvent
local NotifyRemote: RemoteEvent

-- Forward declarations (these call each other).
local completeRun: (run: Run) -&gt; ()
local endRun: (run: Run) -&gt; ()
local sell: (run: Run, player: Player, pr: PlayerRun) -&gt; ()

----------------------------------------------------------------------------------------------------
-- Small helpers
----------------------------------------------------------------------------------------------------

-- pcall wrapper for calls into other services. A failing DataService call must never break a
-- run's bookkeeping (dish tracking, completion), so errors are logged and swallowed.
local function safe(fn: any, ...: any): (boolean, any, any, any)
	if type(fn) ~= "function" then
		return false, nil, nil, nil
	end
	local ok, a, b, c = pcall(fn, ...)
	if not ok then
		warn("[RoundService] " .. tostring(a))
		return false, nil, nil, nil
	end
	return true, a, b, c
end

local function getProfile(player: Player): any
	local ok, profile = safe(DataService.Get, player)
	if ok and type(profile) == "table" then
		return profile
	end
	return nil
end

local function getPasses(player: Player): { [string]: boolean }
	local ok, passes = safe(DataService.GetPasses, player)
	if ok and type(passes) == "table" then
		return passes
	end
	return EMPTY
end

-- A finite, strictly positive number, or nil.
local function positive(value: any): number?
	if type(value) == "number" and value == value and value &gt; 0 and value &lt; math.huge then
		return value
	end
	return nil
end

local function isHere(player: Player): boolean
	return player.Parent == Players
end

local function notify(player: Player, text: string, kind: string)
	if isHere(player) then
		NotifyRemote:FireClient(player, text, kind)
	end
end

-- RunFX to every member still in the game (never FireAllClients: other parties don't care).
local function fireAll(run: Run, kind: string, data: any)
	for member in run.Players do
		if isHere(member) then
			RunFXRemote:FireClient(member, kind, data)
		end
	end
end

local function fireOne(player: Player, kind: string, data: any)
	if isHere(player) then
		RunFXRemote:FireClient(player, kind, data)
	end
end

local warnedHealth = false
local function setGrimeHealth(part: BasePart, fraction: number)
	local ok, err = pcall(DishFactory.SetGrimeHealth, part, fraction)
	if not ok and not warnedHealth then
		warnedHealth = true
		warn("[RoundService] DishFactory.SetGrimeHealth failed: " .. tostring(err))
	end
end

local function sparkle(model: Model)
	safe(DishFactory.Sparkle, model)
end

local function lobbySpawn(): CFrame
	local ok, cf = safe(LobbyBuilder.GetSpawnCFrame)
	if ok and typeof(cf) == "CFrame" then
		return cf
	end
	return CFrame.new(Config.World.LobbyOrigin + Vector3.new(0, 3, 0))
end

local function randomSpawn(run: Run): CFrame
	local spawns = run.Arena.Spawns
	return spawns[rng:NextInteger(1, #spawns)]
end

local function newUpgrades(): Types.RunUpgrades
	local upgrades: any = { Hold = 0, HandSize = 0, ScrubPower = 0, TankSize = 0, Sneakers = 0 }
	-- Any upgrade added to Config later starts at 0 too.
	for _, def in Config.Upgrades do
		if upgrades[def.Id] == nil then
			upgrades[def.Id] = 0
		end
	end
	return upgrades
end

-- The upgrade levels that apply right now: the global ones plus the tool-in-hand's own.
local function effectiveUpgrades(pr: PlayerRun): Types.RunUpgrades
	local merged = table.clone(pr.Upgrades) :: any
	local own = pr.ToolUpgrades[pr.ToolIndex] :: any
	for _, def in Config.Upgrades do
		if def.PerTool then
			merged[def.Id] = (own and own[def.Id]) or 0
		end
	end
	return merged
end

local function newToolState(): ({ boolean }, { Types.RunUpgrades })
	local owned, ups = {}, {}
	for i in Config.Tools do
		owned[i] = i == 1 -- everyone starts with Bare Hands
		ups[i] = newUpgrades()
	end
	return owned, ups
end

-- Puts a model of the tool in hand into the character's right hand (everyone can see it).
local function attachHeldTool(player: Player, toolIndex: number)
	local character = player.Character
	if not character then
		return
	end
	local old = character:FindFirstChild("HeldTool")
	if old then
		old:Destroy()
	end
	if toolIndex &lt;= 1 then
		character:SetAttribute("HeldToolIndex", toolIndex)
		return
	end
	-- Only mark it attached once it really is, so the watchdog retries while the character loads.
	local hand = character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm")
	if not hand or not hand:IsA("BasePart") then
		return
	end
	local ok, model = pcall(ToolModels.Build, toolIndex, 0.42)
	if not ok or not model then
		return
	end
	character:SetAttribute("HeldToolIndex", toolIndex)
	model.Name = "HeldTool"
	local grip = model.PrimaryPart :: BasePart
	local offset = ToolModels.HoldOffset(toolIndex)
	if hand.Name == "Right Arm" then
		offset = CFrame.new(0, -1, 0) * offset
	end
	model:PivotTo(hand.CFrame * offset)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = false
			d.Massless = true
			if d ~= grip then
				local weld = Instance.new("WeldConstraint")
				weld.Part0 = grip
				weld.Part1 = d
				weld.Parent = d
			end
		end
	end
	local weld = Instance.new("Weld")
	weld.Part0 = hand
	weld.Part1 = grip
	weld.C0 = offset
	weld.Parent = grip
	model.Parent = character
end

local function detachHeldTool(player: Player)
	local character = player.Character
	local old = character and character:FindFirstChild("HeldTool")
	if old then
		old:Destroy()
	end
	if character then
		character:SetAttribute("HeldToolIndex", nil)
	end
end

local function rebuildMemberIds(run: Run)
	table.clear(run.MemberIds)
	for _, member in run.Order do
		table.insert(run.MemberIds, member.UserId)
	end
end

----------------------------------------------------------------------------------------------------
-- RunState pushes (coalesced per player)
----------------------------------------------------------------------------------------------------

local function buildState(run: Run, pr: PlayerRun): Types.RunState
	return {
		Level = run.Level,
		ArenaName = run.ArenaName,
		StartedAt = run.StartedAt,
		Phase = run.Phase,
		Coins = pr.Coins,
		Tank = pr.Tank,
		TankMax = pr.Stats.TankMax,
		ToolIndex = pr.ToolIndex,
		OwnedTools = pr.OwnedTools,
		ToolUpgrades = pr.ToolUpgrades,
		Upgrades = effectiveUpgrades(pr),
		Stats = pr.Stats,
		DrainPosition = run.Arena.DrainPosition,
		StationPosition = run.Arena.StationPosition or run.Arena.DrainPosition,
		Total = run.Total,
		Cleaned = run.Cleaned,
		Members = run.MemberIds,
		Results = pr.Results,
	}
end

local function sendRunState(player: Player)
	local run = runOf[player]
	local pr = run and run.Players[player]
	if not run or not pr or run.Ended or not isHere(player) then
		return
	end
	RunStateRemote:FireClient(player, buildState(run, pr))
end

local function flushPush(player: Player, info: { Last: number, Scheduled: boolean })
	-- A newer info table means RemoveFromRun cancelled this push (and maybe a new run began).
	if pushInfo[player] ~= info then
		return
	end
	info.Scheduled = false
	info.Last = os.clock()
	sendRunState(player)
end

-- Leading-edge throttle: the first change goes out immediately (so RunState reaches the client
-- before PartyService's PartyState(nil)); changes inside the next 0.1 s are merged into one push.
local function queuePush(player: Player)
	local info = pushInfo[player]
	if not info then
		info = { Last = -math.huge, Scheduled = false }
		pushInfo[player] = info
	end
	if info.Scheduled then
		return
	end
	local waitFor = info.Last + PUSH_INTERVAL - os.clock()
	if waitFor &lt;= 0 then
		info.Last = os.clock()
		sendRunState(player)
	else
		info.Scheduled = true
		task.delay(waitFor, flushPush, player, info)
	end
end

local function pushAll(run: Run)
	for member in run.Players do
		queuePush(member)
	end
end

----------------------------------------------------------------------------------------------------
-- Stats
----------------------------------------------------------------------------------------------------

local function computeStats(levelIndex: number, player: Player, pr: PlayerRun): Types.RunStats
	local profile = getProfile(player)
	local perks = profile and profile.Perks
	local petBonus = 0
	if profile then
		local ok, bonus = safe(Config.PetCoinBonus, profile.Pets, profile.Equipped)
		petBonus = (ok and positive(bonus)) or 0
	end
	local rank = profile and profile.Rank or nil
	return Config.GetRunStats(levelIndex, effectiveUpgrades(pr), pr.ToolIndex, perks, getPasses(player), petBonus, rank)
end

-- Recomputes a member's stats from their upgrades, tool, perks, passes and pets, and re-applies
-- walk speed when Sneakers (or anything else) changed it.
local function recomputeStats(run: Run, player: Player, pr: PlayerRun)
	local old = pr.Stats
	local stats = computeStats(run.Level, player, pr)
	pr.Stats = stats
	if not old or old.WalkSpeed ~= stats.WalkSpeed then
		Characters.SetWalkSpeed(player, stats.WalkSpeed)
	end
end

local function sendTankFull(player: Player, pr: PlayerRun)
	local now = os.clock()
	if now - pr.LastFullFX &lt; TANK_FULL_FX_COOLDOWN then
		return
	end
	pr.LastFullFX = now
	fireOne(player, "TankFull", EMPTY)
end

----------------------------------------------------------------------------------------------------
-- Selling at the drain
----------------------------------------------------------------------------------------------------

sell = function(run: Run, player: Player, pr: PlayerRun)
	if pr.Tank &lt;= 0 or run.Phase ~= "Playing" then
		return
	end
	-- Recompute first so a pass or pet granted since the last recompute pays out on this sale.
	recomputeStats(run, player, pr)
	local units = pr.Tank
	local coins = math.floor(units * pr.Stats.CoinMult)
	pr.Tank = 0
	pr.Coins += coins

	local fx: Types.FXSold = { Coins = coins, Units = units, By = player.UserId }
	fireOne(player, "Sold", fx)
	local sound = run.DrainSound
	if sound then
		sound.PlaybackSpeed = 0.9 + rng:NextNumber() * 0.25
		sound:Play()
	end
	queuePush(player)
end

----------------------------------------------------------------------------------------------------
-- Grime
----------------------------------------------------------------------------------------------------

--[[
	Removes one grime spot from the run. Every path that ends a spot goes through here: scrubbing,
	pets, the stuck guard and (defensively) a spot that vanished on its own.
	  cleaner  : the player credited (nil for unrewarded pops)
	  rewarded : false = no tank units, no Bubbles, no dish bonus, no stats
]]
local function retireGrime(run: Run, part: BasePart, entry: GrimeEntry, cleaner: Player?, fromPet: boolean, rewarded: boolean)
	-- Mark first, before anything that could yield or re-enter, so this runs exactly once per spot.
	entry.Dead = true
	entry.HP = 0
	run.Grime[part] = nil
	run.Remaining -= 1
	run.Cleaned += 1

	local pr = if cleaner then run.Players[cleaner] else nil
	local rewardPlayer = if rewarded and pr then cleaner else nil
	local gained = 0
	local bubbles = 0

	if rewardPlayer and pr then
		-- Units go into the tank, capped at TankMax (the overflow is simply lost).
		gained = math.min(entry.Units, math.max(0, pr.Stats.TankMax - pr.Tank))
		pr.Tank += gained
		pr.GrimeCleaned += 1

		local gems = if entry.Golden then Config.Gems.GoldenDrop elseif rng:NextNumber() &lt; Config.Gems.DropChance then 1 else 0
		if gems &gt; 0 then
			safe(DataService.AddGems, rewardPlayer, gems)
			notify(rewardPlayer, string.format("💎 You found %d Gem%s!", gems, if gems == 1 then "" else "s"), "Good")
		end

		if entry.Golden then
			local range = R.GoldenBubbles
			bubbles = rng:NextInteger(range[1], range[2]) * run.Level
			safe(DataService.AddBubbles, rewardPlayer, bubbles, "GoldenGrime")
			local text = if fromPet then "✨ Your pet found golden dirt! +%d 🧼" else "✨ Golden dirt! +%d 🧼"
			notify(rewardPlayer, string.format(text, bubbles), "Good")
		end
	end

	local fx: Types.FXCleaned = {
		Position = part.Position,
		Color = entry.Color,
		Units = gained,
		By = if rewardPlayer then rewardPlayer.UserId else 0,
		Golden = entry.Golden,
		Bubbles = bubbles,
		Pet = fromPet,
	}
	fireAll(run, "Cleaned", fx)

	if part.Parent then
		part:Destroy()
	end

	-- Dish tracking: the spot that finishes a dish makes it sparkle and pays the dish bonus.
	local dish = run.Dishes[entry.DishId]
	if dish and not dish.Done then
		dish.Remaining -= 1
		if dish.Remaining &lt;= 0 then
			dish.Done = true
			if dish.Model then
				task.spawn(sparkle, dish.Model)
			end
			local bonus = 0
			if rewardPlayer and pr then
				bonus = math.floor(dish.Units * R.DishBonusShare)
				pr.Coins += bonus
				for member in run.Players do
					safe(DataService.AddStat, member, "DishesCleaned", 1)
				end
			end
			local doneFx: Types.FXDishDone = {
				Position = dish.Center,
				Kind = dish.Kind,
				By = if rewardPlayer then rewardPlayer.UserId else 0,
				Bonus = bonus,
			}
			fireAll(run, "DishDone", doneFx)
		end
	end

	run.Arena.Model:SetAttribute("Cleaned", run.Cleaned)
	pushAll(run)

	-- The tank just filled: Auto Drain sells it on the spot, everyone else gets the "go sell" cue.
	if rewardPlayer and pr and pr.Tank &gt;= pr.Stats.TankMax then
		if getPasses(rewardPlayer).AutoDrain then
			sell(run, rewardPlayer, pr)
		else
			sendTankFull(rewardPlayer, pr)
		end
	end

	if run.Remaining &lt;= 0 then
		completeRun(run)
	end
end

-- Applies damage to a spot already known to be in `run`. Returns true while the spot is alive.
local function damageEntry(run: Run, player: Player, pr: PlayerRun, part: BasePart, entry: GrimeEntry, amount: number, fromPet: boolean): boolean
	if part.Parent == nil then
		-- Destroyed between the query and now by something else: count it, reward nobody.
		retireGrime(run, part, entry, nil, false, false)
		return false
	end
	if pr.Tank &gt;= pr.Stats.TankMax then
		return true -- tank full: the player (or pet) has to go sell first
	end
	if not fromPet and (pr.Stats.Tier or pr.ToolIndex) &lt; entry.MinTool then
		-- Too tough for this tool: it still works, just slowly (so nobody can get stuck without the
		-- coins for a better tool). Pets ignore MinTool.
		amount *= R.UnderTierMult
	end

	run.LastDamageAt = os.clock()
	local hp = entry.HP - amount
	if hp &gt; HP_EPSILON then
		entry.HP = hp
		setGrimeHealth(part, hp / entry.MaxHP)
		part:SetAttribute("HP", hp)
		return true
	end
	retireGrime(run, part, entry, player, fromPet, true)
	return false
end

-- Reads every grime spot's attributes once, so the hot path never touches attributes.
local function indexGrime(run: Run)
	local arena = run.Arena

	if type(arena.Dishes) == "table" then
		for key, d in arena.Dishes do
			if type(d) == "table" then
				local id = tonumber(d.Id) or tonumber(key)
				if id then
					local model = if typeof(d.Model) == "Instance" and d.Model:IsA("Model") then d.Model else nil
					local center: Vector3 = if typeof(d.Center) == "Vector3"
						then d.Center
						elseif model then model:GetPivot().Position
						else arena.Origin.Position
					run.Dishes[id] = {
						Id = id,
						Kind = tostring(d.Kind or "Dish"),
						Model = model,
						Center = center,
						Remaining = 0,
						Units = 0,
						Done = false,
					}
				end
			end
		end
	end

	local toolCount = #Config.Tools
	for _, child in arena.GrimeFolder:GetChildren() do
		if child:IsA("BasePart") then
			local maxHP = positive(child:GetAttribute("MaxHP")) or positive(child:GetAttribute("HP")) or 1
			local hp = math.min(positive(child:GetAttribute("HP")) or maxHP, maxHP)
			local units = math.max(1, math.floor(positive(child:GetAttribute("Units")) or 1))
			local dishId = tonumber(child:GetAttribute("DishId")) or 0
			local minTool = math.clamp(math.floor(tonumber(child:GetAttribute("MinTool")) or 1), 1, toolCount)
			local entry: GrimeEntry = {
				HP = hp,
				MaxHP = maxHP,
				Units = units,
				DishId = dishId,
				Golden = child:GetAttribute("Golden") == true,
				MinTool = minTool,
				Color = child.Color,
				Dead = false,
			}
			run.Grime[child] = entry
			run.Total += 1
			local dish = run.Dishes[dishId]
			if dish then
				dish.Remaining += 1
				dish.Units += units
			end
		end
	end
	run.Remaining = run.Total
end

-- Stuck guard: nobody has damaged anything for a while and only a few spots are left (probably
-- somewhere unreachable). Pop them with no reward so the party can finish.
local function popRemaining(run: Run)
	-- Snapshot first: retireGrime removes entries from run.Grime.
	local parts: { BasePart } = {}
	local entries: { GrimeEntry } = {}
	for part, entry in run.Grime do
		table.insert(parts, part)
		table.insert(entries, entry)
	end
	for member in run.Players do
		notify(member, "🧼 The last few spots washed away on their own!", "Info")
	end
	for i, entry in entries do
		if not entry.Dead and run.Phase == "Playing" and not run.Ended then
			retireGrime(run, parts[i], entry, nil, false, false)
		end
	end
	-- Counters and the map can only disagree through a bug; never leave a run unfinishable.
	if run.Phase == "Playing" and not run.Ended and next(run.Grime) == nil then
		run.Remaining = 0
		completeRun(run)
	end
end

----------------------------------------------------------------------------------------------------
-- Completion and teardown
----------------------------------------------------------------------------------------------------

-- Pays every member and builds their Results. Runs in its own thread because DataService calls
-- may yield, and DamageGrime (which triggers completion) must never yield for its callers.
local function rewardRun(run: Run, members: { Player }, seconds: number, returnAt: number)
	local level = Config.GetLevel(run.Level)
	local total = math.max(1, run.Total)
	local underPar = seconds &lt; level.ParTime

	local valid = {}
	for _, p in members do
		if run.Players[p] and isHere(p) then
			table.insert(valid, p)
		end
	end
	local n = #valid

	local rows: { Types.ResultRow } = {}
	local personal: { [Player]: { FirstClear: boolean, NewBest: boolean, Unlocked: number?, Bubbles: number } } = {}

	for _, p in valid do
		local pr = run.Players[p]
		if pr then
			local share = pr.GrimeCleaned / total
			local bubbles = level.Bubbles * (0.6 + 0.4 * math.min(1, share * n))

			local ok, first, best, unlocked = safe(DataService.RecordClear, p, run.Level, seconds)
			local firstClear = ok and first == true
			if firstClear then
				bubbles *= R.FirstClearMult
			end
			if underPar then
				bubbles *= 1 + R.UnderParBonus
			end
			if getPasses(p).DoubleBubbles then
				bubbles *= 2
			end
			if getPasses(p).VIP then
				bubbles *= 1.25
			end
			bubbles = math.floor(bubbles)

			safe(DataService.AddBubbles, p, bubbles, "RunClear")
			safe(DataService.AddGems, p, Config.Gems.PerClear * run.Level)
			safe(DataService.AddStat, p, "GrimeCleaned", pr.GrimeCleaned)
			safe(DataService.PushMeta, p)

			table.insert(rows, {
				UserId = p.UserId,
				Name = p.DisplayName,
				Grime = pr.GrimeCleaned,
				Share = pr.GrimeCleaned / total,
				Bubbles = bubbles,
			})
			personal[p] = {
				FirstClear = firstClear,
				NewBest = ok and best == true,
				Unlocked = if ok and type(unlocked) == "number" then unlocked else nil,
				Bubbles = bubbles,
			}
		end
	end

	table.sort(rows, function(a, b)
		if a.Grime ~= b.Grime then
			return a.Grime &gt; b.Grime
		end
		return a.UserId &lt; b.UserId
	end)

	for p, info in personal do
		local pr = run.Players[p]
		if pr and not run.Ended then
			pr.Results = {
				TimeSeconds = seconds,
				ParTime = level.ParTime,
				UnderPar = underPar,
				FirstClear = info.FirstClear,
				NewBest = info.NewBest,
				UnlockedLevel = info.Unlocked,
				Bubbles = info.Bubbles,
				Players = rows,
				ReturnAt = returnAt,
			}
			queuePush(p)
		end
	end
end

local function sendEveryoneHome(run: Run)
	if run.Ended then
		return
	end
	for _, member in table.clone(run.Order) do
		RoundService.RemoveFromRun(member, "Complete")
	end
end

completeRun = function(run: Run)
	-- Phase flips synchronously, so however many callers race here only the first one completes.
	if run.Phase ~= "Playing" or run.Ended then
		return
	end
	run.Phase = "Complete"
	local now = Util.Now()
	local seconds = math.max(0, math.floor((now - run.StartedAt) * 10 + 0.5) / 10)
	local returnAt = now + R.ResultsSeconds
	pushAll(run) -- Phase change first; Results follow as soon as the rewards are written
	task.spawn(rewardRun, run, table.clone(run.Order), seconds, returnAt)
	task.delay(R.ResultsSeconds, sendEveryoneHome, run)
end

endRun = function(run: Run)
	if run.Ended then
		return
	end
	run.Ended = true
	runs[run.Id] = nil
	for _, connection in run.Connections do
		connection:Disconnect()
	end
	table.clear(run.Connections)
	table.clear(run.Grime)
	for member in run.Players do
		if runOf[member] == run then
			runOf[member] = nil
		end
	end
	table.clear(run.Players)

	local arena = run.Arena
	local slot = run.Slot
	task.spawn(function()
		local ok = safe(ArenaBuilder.Destroy, arena)
		if not ok and arena.Model.Parent then
			pcall(function()
				arena.Model:Destroy()
			end)
		end
		slotBusy[slot] = nil
	end)
end

----------------------------------------------------------------------------------------------------
-- Starting a run
----------------------------------------------------------------------------------------------------

local function claimSlot(): number?
	for slot = 1, Config.World.MaxArenas do
		if not slotBusy[slot] then
			slotBusy[slot] = true
			return slot
		end
	end
	return nil
end

local function isValidArena(arena: any): boolean
	return type(arena) == "table"
		and typeof(arena.Model) == "Instance"
		and arena.Model.Parent ~= nil
		and typeof(arena.GrimeFolder) == "Instance"
		and type(arena.Spawns) == "table"
		and #arena.Spawns &gt; 0
		and typeof(arena.DrainPosition) == "Vector3"
		and typeof(arena.Origin) == "CFrame"
end

-- Frees a slot whose build failed or was abandoned, destroying whatever got built.
local function abandonBuild(slot: number, arena: any)
	if type(arena) == "table" then
		safe(ArenaBuilder.Destroy, arena)
	end
	local folder = workspace:FindFirstChild("Arenas")
	local leftover = folder and folder:FindFirstChild("Arena_" .. slot)
	if leftover then
		leftover:Destroy()
	end
	slotBusy[slot] = nil
end

-- A 3D splash at the drain for every sale, so teammates hear it too (the seller also gets the
-- coin sound from the client's "Sold" FX).
local function makeDrainSound(run: Run): Sound?
	local def = Config.Sounds.Splash or Config.Sounds.Fallback
	if not def then
		return nil
	end
	local emitter = Instance.new("Part")
	emitter.Name = "DrainSound"
	emitter.Size = Vector3.new(1, 1, 1)
	emitter.Transparency = 1
	emitter.Anchored = true
	emitter.CanCollide = false
	emitter.CanQuery = false
	emitter.CanTouch = false
	emitter.CastShadow = false
	emitter.CollisionGroup = Characters.Groups.NoCollide
	emitter.CFrame = CFrame.new(run.Arena.DrainPosition)
	local sound = Instance.new("Sound")
	sound.Name = "Sell"
	sound.SoundId = def.Id
	sound.Volume = def.Volume
	sound.RollOffMinDistance = 12
	sound.RollOffMaxDistance = 140
	sound.Parent = emitter
	emitter.Parent = run.Arena.Model
	return sound
end

local function teleportInto(run: Run, player: Player, cf: CFrame)
	if runOf[player] == run and not run.Ended and isHere(player) then
		-- If the character is dead or missing, the respawn resolver brings them here instead.
		Characters.Teleport(player, cf)
	end
end

local function joinRun(run: Run, player: Player, index: number)
	local profile = getProfile(player)
	local pr: PlayerRun = {
		Coins = Config.StartCoins(run.Level, profile and profile.Perks),
		Tank = 0,
		Upgrades = newUpgrades(),
		ToolIndex = 1,
		OwnedTools = {},
		ToolUpgrades = {},
		Stats = nil :: any,
		GrimeCleaned = 0,
		LastScrubAt = 0,
		LastFullFX = 0,
		Results = nil,
	}
	pr.OwnedTools, pr.ToolUpgrades = newToolState()
	pr.Stats = computeStats(run.Level, player, pr)

	run.Players[player] = pr
	table.insert(run.Order, player)
	runOf[player] = run

	Characters.SetGroup(player, Characters.Groups.Players)
	Characters.SetWalkSpeed(player, pr.Stats.WalkSpeed)
	player:SetAttribute("InRun", true)
	player:SetAttribute("RunArena", run.ArenaName)

	local spawns = run.Arena.Spawns
	task.spawn(teleportInto, run, player, spawns[((index - 1) % #spawns) + 1])
end

function RoundService.StartRound(players: { Player }, levelIndex: number): (boolean, string?)
	if type(players) ~= "table" then
		return false, "Nobody is ready to play."
	end
	if type(levelIndex) ~= "number" or levelIndex % 1 ~= 0 or not Config.Levels[levelIndex] then
		return false, "That dishwasher doesn't exist."
	end

	local members: { Player } = {}
	for _, p in players do
		if
			typeof(p) == "Instance"
			and p:IsA("Player")
			and isHere(p)
			and not runOf[p]
			and not starting[p]
			and not table.find(members, p)
		then
			table.insert(members, p)
		end
	end
	if #members == 0 then
		return false, "Nobody is ready to play."
	end

	local slot = claimSlot()
	if not slot then
		return false, "All dishwashers are busy!"
	end

	local level = Config.GetLevel(levelIndex)
	local bestLucky = 0
	local charm = false
	for _, p in members do
		local profile = getProfile(p)
		local lucky = profile and profile.Perks and positive(profile.Perks.LuckySuds) or 0
		bestLucky = math.max(bestLucky, lucky)
		charm = charm or getPasses(p).LuckyCharm == true
		local rank = profile and Config.GetRank(profile.Rank)
		if rank and rank.Effects.Golden then
			charm = true
		end
	end
	local luckyPerk = Config.GetPerk("LuckySuds")
	local goldenChance = level.GoldenChance + bestLucky * (if luckyPerk then luckyPerk.PerLevel else 0.01)
	if charm then
		goldenChance *= 2 -- Lucky Charm pass: anyone in the party having it doubles the whole load's gold
	end
	local options = {
		GrimeScale = 1 + R.PartyGrimeScale * (#members - 1),
		GoldenChance = goldenChance,
	}

	for _, p in members do
		starting[p] = true
	end
	local built, result = pcall(ArenaBuilder.Build, slot, levelIndex, options)
	for _, p in members do
		starting[p] = nil
	end

	-- The build yielded: the arena may have failed and players may have left or been put
	-- into another run meanwhile. Re-check everything.
	local arena: Arena? = if built and isValidArena(result) then result else nil
	if not arena then
		warn("[RoundService] ArenaBuilder.Build failed for slot " .. slot .. ": " .. tostring(result))
		abandonBuild(slot, if built then result else nil)
		return false, "Couldn't fill the dishwasher. Try again!"
	end

	local stillHere: { Player } = {}
	for _, p in members do
		if isHere(p) and not runOf[p] then
			table.insert(stillHere, p)
		end
	end
	if #stillHere == 0 then
		abandonBuild(slot, arena)
		return false, "Everyone left before the wash started."
	end

	local overlap = OverlapParams.new()
	overlap.FilterType = Enum.RaycastFilterType.Include
	overlap.FilterDescendantsInstances = { arena.GrimeFolder }
	overlap.MaxParts = 60

	nextRunId += 1
	local run: Run = {
		Id = nextRunId,
		Slot = slot,
		Arena = arena,
		ArenaName = arena.Model.Name,
		Level = levelIndex,
		Players = {},
		Order = {},
		MemberIds = {},
		StartedAt = Util.Now(),
		Phase = "Playing",
		Ended = false,
		Total = 0,
		Cleaned = 0,
		Remaining = 0,
		LastDamageAt = os.clock(),
		Grime = {},
		Dishes = {},
		Overlap = overlap,
		Connections = {},
		DrainSound = nil,
		DrainRadius = positive(arena.DrainRadius) or R.DrainRadius,
		KillY = if type(arena.KillY) == "number" then arena.KillY else arena.Origin.Position.Y - 60,
	}

	indexGrime(run)
	if run.Total == 0 then
		warn("[RoundService] Arena_" .. slot .. " was built with no grime")
		abandonBuild(slot, arena)
		return false, "Couldn't fill the dishwasher. Try again!"
	end

	arena.Model:SetAttribute("Level", levelIndex)
	arena.Model:SetAttribute("Total", run.Total)
	arena.Model:SetAttribute("Cleaned", 0)
	run.DrainSound = makeDrainSound(run)

	-- Safety net: a spot removed by anything other than retireGrime still counts, so the run can
	-- always finish. retireGrime drops the map entry first, so its own destroys are ignored here.
	table.insert(
		run.Connections,
		arena.GrimeFolder.ChildRemoved:Connect(function(child)
			local entry = run.Grime[child :: BasePart]
			if entry and not entry.Dead and not run.Ended and run.Phase == "Playing" then
				retireGrime(run, child :: BasePart, entry, nil, false, false)
			end
		end)
	)

	runs[run.Id] = run
	for i, p in stillHere do
		joinRun(run, p, i)
	end
	rebuildMemberIds(run)
	pushAll(run)
	return true
end

----------------------------------------------------------------------------------------------------
-- Leaving a run
----------------------------------------------------------------------------------------------------

local function sendToLobby(player: Player)
	-- Skip if they were put into another run in the meantime or left the game.
	if runOf[player] == nil and isHere(player) then
		Characters.Teleport(player, lobbySpawn())
	end
end

function RoundService.RemoveFromRun(player: Player, reason: string?)
	local run = runOf[player]
	if not run then
		return
	end
	runOf[player] = nil
	pushInfo[player] = nil -- cancels any coalesced push still waiting
	run.Players[player] = nil
	local index = table.find(run.Order, player)
	if index then
		table.remove(run.Order, index)
	end
	rebuildMemberIds(run)

	if reason ~= LEFT_GAME and isHere(player) then
		detachHeldTool(player)
		player:SetAttribute("InRun", false)
		player:SetAttribute("RunArena", "")
		Characters.SetWalkSpeed(player, nil)
		Characters.SetGroup(player, Characters.Groups.Players)
		RunStateRemote:FireClient(player, nil)
		task.spawn(sendToLobby, player)
	end

	if next(run.Players) == nil then
		endRun(run)
	else
		pushAll(run)
	end
end

----------------------------------------------------------------------------------------------------
-- Public queries
----------------------------------------------------------------------------------------------------

function RoundService.IsInRun(player: Player): boolean
	return runOf[player] ~= nil
end

function RoundService.GetGrimeFolder(player: Player): Folder?
	local run = runOf[player]
	if run and not run.Ended then
		return run.Arena.GrimeFolder
	end
	return nil
end

function RoundService.GetRunPower(player: Player): number
	local run = runOf[player]
	local pr = run and run.Players[player]
	return if pr then pr.Stats.Power else 0
end

function RoundService.IsTankFull(player: Player): boolean
	local run = runOf[player]
	local pr = run and run.Players[player]
	return pr ~= nil and pr.Tank &gt;= pr.Stats.TankMax
end

-- Damages a grime part if it belongs to the player's run. Returns true while the part is alive.
-- Used by the Scrub handler (fromPet = false) and PetService (fromPet = true).
function RoundService.DamageGrime(player: Player, part: BasePart, amount: number, fromPet: boolean): boolean
	local run = runOf[player]
	if not run or run.Phase ~= "Playing" or run.Ended then
		return false
	end
	local pr = run.Players[player]
	local entry = run.Grime[part]
	if not pr or not entry or entry.Dead then
		return false
	end
	if type(amount) ~= "number" or amount ~= amount or amount &lt;= 0 then
		return part.Parent ~= nil
	end
	return damageEntry(run, player, pr, part, entry, math.min(amount, entry.HP), fromPet == true)
end

-- Recomputes a player's run stats (perks, passes, pets). Called after pet equip changes, perk
-- purchases and pass grants; harmless when the player isn't in a run.
-- Coin packs (MarketService): adds coins to the player's current run. False if not in a run.
function RoundService.AddCoins(player: Player, amount: number): boolean
	local run = runOf[player]
	local pr = run and run.Players[player]
	if not run or not pr or run.Ended or type(amount) ~= "number" or amount ~= amount or amount &lt;= 0 then
		return false
	end
	pr.Coins += math.floor(amount * Config.GetLevel(run.Level).Mult + 0.5)
	queuePush(player)
	return true
end

function RoundService.RefreshStats(player: Player)
	local run = runOf[player]
	local pr = run and run.Players[player]
	if not run or not pr or run.Ended then
		return
	end
	recomputeStats(run, player, pr)
	if run.Phase == "Playing" and pr.Tank &gt; 0 and pr.Tank &gt;= pr.Stats.TankMax and getPasses(player).AutoDrain then
		sell(run, player, pr)
	end
	queuePush(player)
end

----------------------------------------------------------------------------------------------------
-- Remote handlers
----------------------------------------------------------------------------------------------------

local function onScrub(player: Player, aim: any, holding: any)
	-- 1. In a Playing run, finite aim, alive.
	local run = runOf[player]
	if not run or run.Phase ~= "Playing" or run.Ended then
		return
	end
	local pr = run.Players[player]
	if not pr or not Util.IsFiniteVector3(aim) then
		return
	end
	local root = Characters.GetRoot(player)
	if not root then
		return
	end

	-- 2. Reach (plus slack for latency).
	local stats = pr.Stats
	if (aim - root.Position).Magnitude &gt; stats.Reach + stats.Radius + R.ReachSlack then
		return
	end

	-- 3. Rate. Damage comes from server time, never from anything in the packet.
	local now = os.clock()
	local seconds
	if holding == true and stats.Hold then
		local dt = now - pr.LastScrubAt
		if dt &lt; HOLD_MIN_INTERVAL then
			return
		end
		seconds = math.min(dt, R.MaxScrubDt)
	else
		if now - pr.LastScrubAt &lt; R.MinClickInterval then
			return
		end
		seconds = R.ClickPulseSeconds
	end
	pr.LastScrubAt = now

	-- 4. Tank full: nothing to do but remind them.
	if pr.Tank &gt;= stats.TankMax then
		sendTankFull(player, pr)
		return
	end

	-- 5. Every grime spot under the hand takes the full hit (that's what Hand Size buys).
	local amount = stats.Power * seconds
	local parts = workspace:GetPartBoundsInRadius(aim, stats.Radius, run.Overlap)
	for _, part in parts do
		local entry = run.Grime[part]
		if entry and not entry.Dead then
			damageEntry(run, player, pr, part, entry, math.min(amount, entry.HP), false)
			if run.Phase ~= "Playing" or pr.Tank &gt;= pr.Stats.TankMax then
				break
			end
		end
	end
end

local function allowRequest(player: Player): boolean
	local now = os.clock()
	local window = requestWindow[player]
	if not window then
		requestWindow[player] = { Start = now, Count = 1 }
		return true
	end
	if now - window.Start &gt;= 1 then
		window.Start = now
		window.Count = 1
		return true
	end
	window.Count += 1
	return window.Count &lt;= REQUESTS_PER_SECOND
end

local function fail(message: string): Types.RequestResult
	return { Ok = false, Error = message }
end

local OK: Types.RequestResult = { Ok = true }

local function handleRunRequest(player: Player, action: any, value: any): Types.RequestResult
	if type(action) ~= "string" then
		return fail("Unknown action.")
	end
	if not allowRequest(player) then
		return fail("Slow down a little!")
	end
	local run = runOf[player]
	local pr = run and run.Players[player]
	if not run or not pr or run.Ended then
		return fail("You're not in a dishwasher right now.")
	end

	if action == "BuyUpgrade" then
		if run.Phase ~= "Playing" then
			return fail("The dishwasher is already sparkling clean!")
		end
		local def = if type(value) == "string" then Config.GetUpgrade(value) else nil
		if not def then
			return fail("That upgrade doesn't exist.")
		end
		-- Per-tool upgrades belong to the tool in hand; the rest are global.
		local upgrades = (if def.PerTool then pr.ToolUpgrades[pr.ToolIndex] else pr.Upgrades) :: any
		local current = upgrades[def.Id] or 0
		local cost = Config.UpgradeCost(def.Id, current, run.Level, pr.ToolIndex)
		if not cost then
			return fail("Already maxed!")
		end
		if pr.Coins &lt; cost then
			return fail("Not enough coins!")
		end
		pr.Coins -= cost
		upgrades[def.Id] = current + 1
		recomputeStats(run, player, pr)
		queuePush(player)
		return OK
	elseif action == "BuyTool" then
		if run.Phase ~= "Playing" then
			return fail("The dishwasher is already sparkling clean!")
		end
		if type(value) ~= "number" or value % 1 ~= 0 or not Config.Tools[value] then
			return fail("That tool doesn't exist.")
		end
		if pr.OwnedTools[value] then
			return fail("You already have that tool!")
		end
		local cost = Config.ToolCost(value, run.Level)
		if not cost then
			return fail("That tool doesn't exist.")
		end
		if pr.Coins &lt; cost then
			return fail("Not enough coins!")
		end
		pr.Coins -= cost
		pr.OwnedTools[value] = true
		pr.ToolIndex = value -- a new tool goes straight into your hand
		recomputeStats(run, player, pr)
		attachHeldTool(player, value)
		queuePush(player)
		return OK
	elseif action == "EquipTool" then
		if type(value) ~= "number" or value % 1 ~= 0 or not pr.OwnedTools[value] then
			return fail("You don't have that tool yet.")
		end
		if pr.ToolIndex ~= value then
			pr.ToolIndex = value
			recomputeStats(run, player, pr)
			attachHeldTool(player, value)
			queuePush(player)
		end
		return OK
	elseif action == "Leave" then
		RoundService.RemoveFromRun(player, "Leave")
		return OK
	elseif action == "ReturnToLobby" then
		if run.Phase ~= "Complete" then
			return fail("Finish the load first!")
		end
		RoundService.RemoveFromRun(player, "ReturnToLobby")
		return OK
	end
	return fail("Unknown action.")
end

----------------------------------------------------------------------------------------------------
-- Loops
----------------------------------------------------------------------------------------------------

-- Anyone standing in their run's drain with grime in the tank sells it.
local function drainStep()
	for _, run in runs do
		if run.Phase == "Playing" and not run.Ended then
			local drain = run.Arena.DrainPosition
			local r2 = run.DrainRadius * run.DrainRadius
			for player, pr in run.Players do
				if pr.Tank &gt; 0 then
					local root = Characters.GetRoot(player)
					if root then
						local pos = root.Position
						local dx, dz = pos.X - drain.X, pos.Z - drain.Z
						if dx * dx + dz * dz &lt;= r2 and math.abs(pos.Y - drain.Y) &lt; DRAIN_MAX_DY then
							sell(run, player, pr)
						end
					end
				end
			end
		end
	end
end

-- Fall guard (below KillY -&gt; back to a spawn) and stuck guard.
local function watchdogStep()
	local now = os.clock()
	for _, run in runs do
		if not run.Ended then
			for player, pr in run.Players do
				local root = Characters.GetRoot(player)
				if root and root.Position.Y &lt; run.KillY then
					Characters.Teleport(player, randomSpawn(run))
				end
				-- Re-attach the tool in hand after a respawn (a new character has none).
				local character = player.Character
				if root and character and character:GetAttribute("HeldToolIndex") ~= pr.ToolIndex then
					attachHeldTool(player, pr.ToolIndex)
				end
			end
			if
				run.Phase == "Playing"
				and run.Remaining &gt; 0
				and run.Remaining &lt;= R.StuckMaxRemaining
				and now - run.LastDamageAt &gt;= R.StuckSeconds
			then
				popRemaining(run)
			end
		end
	end
end

----------------------------------------------------------------------------------------------------
-- Lifecycle
----------------------------------------------------------------------------------------------------

function RoundService.Init()
	RunStateRemote = Remotes.Event("RunState")
	RunFXRemote = Remotes.Event("RunFX")
	NotifyRemote = Remotes.Event("Notify")

	Remotes.Event("Scrub").OnServerEvent:Connect(onScrub)

	Remotes.Function("RunRequest").OnServerInvoke = function(player: Player, action: any, value: any)
		local ok, result = pcall(handleRunRequest, player, action, value)
		if not ok then
			warn("[RoundService] RunRequest error: " .. tostring(result))
			return fail("Something went wrong. Try again!")
		end
		return result
	end

	-- A player in a run always respawns on their dishwasher's door.
	Characters.AddRespawnResolver(function(player: Player): CFrame?
		local run = runOf[player]
		if run and not run.Ended then
			return randomSpawn(run)
		end
		return nil
	end)

	local function onPlayerAdded(player: Player)
		if player:GetAttribute("InRun") == nil then
			player:SetAttribute("InRun", false)
		end
		if player:GetAttribute("RunArena") == nil then
			player:SetAttribute("RunArena", "")
		end
	end
	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, player in Players:GetPlayers() do
		onPlayerAdded(player)
	end

	Players.PlayerRemoving:Connect(function(player)
		RoundService.RemoveFromRun(player, LEFT_GAME)
		pushInfo[player] = nil
		requestWindow[player] = nil
		starting[player] = nil
	end)

	-- Pass grants (MarketService) and late-loading profiles change run stats.
	local passesChanged = (DataService :: any).PassesChanged
	if type(passesChanged) == "table" and type(passesChanged.Connect) == "function" then
		passesChanged:Connect(function(player: Player)
			RoundService.RefreshStats(player)
		end)
	end
	local profileLoaded = (DataService :: any).ProfileLoaded
	if type(profileLoaded) == "table" and type(profileLoaded.Connect) == "function" then
		profileLoaded:Connect(function(player: Player)
			RoundService.RefreshStats(player)
		end)
	end
end

function RoundService.Start()
	task.spawn(function()
		while true do
			task.wait(DRAIN_INTERVAL)
			local ok, err = pcall(drainStep)
			if not ok then
				warn("[RoundService] drain loop: " .. tostring(err))
			end
		end
	end)
	task.spawn(function()
		while true do
			task.wait(WATCHDOG_INTERVAL)
			local ok, err = pcall(watchdogStep)
			if not ok then
				warn("[RoundService] watchdog loop: " .. tostring(err))
			end
		end
	end)
end

return RoundService</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000018"><Properties><string name="Name">ShopService</string><ProtectedString name="Source">-- ShopService: owns the MetaRequest RemoteFunction (permanent purchases and pet management).
--
--   "BuyPerk"   (perkId)                     handled here: price from Config.PerkCost, pay with
--                                            DataService.SpendBubbles, level up, push MetaState, and
--                                            refresh run stats if the buyer is mid-run.
--   "Hatch"     ({ Egg = id, Count = 1|3 })  shape-checked here, then PetService.Hatch
--   "Equip" / "Unequip" / "Delete" (uid)     shape-checked here, then PetService
--   "EquipBest"                              PetService.EquipBest
--
-- Whatever the client sends, the reply is always a Types.RequestResult and this never throws.
-- Requests are rate limited (REQUESTS_PER_SECOND per player) and handled one at a time per player.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Types = require(Shared:WaitForChild("Types"))

local DataService = require(script.Parent:WaitForChild("DataService"))
local PetService = require(script.Parent:WaitForChild("PetService"))
local RoundService = require(script.Parent:WaitForChild("RoundService"))

local ShopService = {}

local REQUESTS_PER_SECOND = 8 -- sustained rate, and also the burst size
local MAX_ID_LENGTH = 64 -- longer strings can't be a real perk id, egg id or uid

local ERR_GENERIC = "Something went wrong. Try again."
local ERR_SLOW = "Slow down a little!"
local ERR_BUSY = "Still working on your last request..."
local ERR_LOADING = "Your save is still loading. Try again in a moment."
local ERR_UNKNOWN = "Unknown request."

local budgets: { [Player]: { Tokens: number, At: number } } = {}
local busy: { [Player]: boolean } = {}
local initialized = false

----------------------------------------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------------------------------------

local function fail(message: string): Types.RequestResult
	return { Ok = false, Error = message }
end

local function isId(value: any): boolean
	return type(value) == "string" and #value &gt; 0 and #value &lt;= MAX_ID_LENGTH
end

-- Token bucket: REQUESTS_PER_SECOND tokens, refilled continuously.
local function allowRequest(player: Player): boolean
	local now = os.clock()
	local budget = budgets[player]
	if not budget then
		budget = { Tokens = REQUESTS_PER_SECOND, At = now }
		budgets[player] = budget
	end
	budget.Tokens = math.min(REQUESTS_PER_SECOND, budget.Tokens + (now - budget.At) * REQUESTS_PER_SECOND)
	budget.At = now
	if budget.Tokens &lt; 1 then
		return false
	end
	budget.Tokens -= 1
	return true
end

-- Whatever a handler returned, turn it into a well-formed RequestResult.
local function normalize(result: any): Types.RequestResult
	if type(result) ~= "table" then
		return fail(ERR_GENERIC)
	end
	local out: Types.RequestResult = { Ok = result.Ok == true }
	if type(result.Error) == "string" then
		out.Error = result.Error
	elseif not out.Ok then
		out.Error = ERR_GENERIC
	end
	if type(result.Pets) == "table" then
		out.Pets = result.Pets
	end
	if type(result.Rank) == "string" then
		out.Rank = result.Rank
		out.Equipped = result.Equipped == true
	end
	return out
end

local function callPetService(name: string, ...: any): any
	local fn = (PetService :: any)[name]
	if type(fn) ~= "function" then
		warn("[ShopService] PetService." .. name .. " is missing")
		return fail(ERR_GENERIC)
	end
	return fn(...)
end

-- Run stats depend on perks; a failure here must not turn a successful purchase into an error.
local function refreshRunStats(player: Player)
	local ok, err = pcall(function()
		if RoundService.IsInRun(player) then
			RoundService.RefreshStats(player)
		end
	end)
	if not ok then
		warn("[ShopService] RefreshStats failed: " .. tostring(err))
	end
end

----------------------------------------------------------------------------------------------------
-- Actions
----------------------------------------------------------------------------------------------------

local function buyPerk(player: Player, value: any): Types.RequestResult
	if not isId(value) then
		return fail("That perk doesn't exist.")
	end
	local perk = Config.GetPerk(value)
	local profile = DataService.Get(player)
	if not perk then
		return fail("That perk doesn't exist.")
	end
	if not profile then
		return fail(ERR_LOADING)
	end
	local level = profile.Perks[perk.Id] or 0
	local cost = Config.PerkCost(perk.Id, level)
	if not cost then
		return fail(perk.Name .. " is maxed out!")
	end
	if profile.Bubbles &lt; cost then
		return fail("You need " .. Format.Short(cost - profile.Bubbles) .. " more 🧼")
	end
	if not DataService.SpendBubbles(player, cost) then
		return fail("Not enough Bubbles!")
	end
	profile.Perks[perk.Id] = level + 1
	DataService.PushMeta(player)
	refreshRunStats(player)
	return { Ok = true }
end

local function hatch(player: Player, value: any): Types.RequestResult
	if type(value) ~= "table" or not isId(value.Egg) then
		return fail("Pick an egg to hatch.")
	end
	local count = value.Count
	if count ~= 1 and count ~= 3 then
		return fail("You can hatch 1 or 3 eggs at a time.")
	end
	return callPetService("Hatch", player, value.Egg, count)
end

local function petAction(name: string): (Player, any) -&gt; Types.RequestResult
	return function(player: Player, value: any): Types.RequestResult
		if not isId(value) then
			return fail("That pet doesn't exist.")
		end
		return callPetService(name, player, value)
	end
end

-- Free "test purchases" of passes/products without an Id: Studio only, unless Config says otherwise.
local function testAllowed(): boolean
	local rules = Config.TestPasses or {}
	return if RunService:IsStudio() then rules.AllowInStudio == true else rules.AllowInLiveGame == true
end

-- Test mode for game passes that don't have an Id yet (see Config.GamePasses): grants the pass for
-- this session only, and only in Studio unless Config.TestPasses.AllowInLiveGame is on.
local function testPass(player: Player, value: any): Types.RequestResult
	if type(value) ~= "string" then
		return fail(ERR_UNKNOWN)
	end
	local pass = Config.GetPass(value)
	if not pass then
		return fail("That pass doesn't exist.")
	end
	if type(pass.Id) == "number" and pass.Id ~= 0 then
		return fail("This pass is on sale for real. Use the purchase prompt!")
	end
	if not testAllowed() then
		return fail("Coming soon!")
	end
	DataService.SetPass(player, pass.Key, true)
	return { Ok = true }
end

-- Test mode for developer products without an Id: gives the goods for free (Studio only).
local function testProduct(player: Player, value: any): Types.RequestResult
	local product = if type(value) == "string" then Config.GetProduct(value) else nil
	if not product then
		return fail("That item doesn't exist.")
	end
	if type(product.Id) == "number" and product.Id ~= 0 then
		return fail("This is on sale for real. Use the purchase prompt!")
	end
	if not testAllowed() then
		return fail("Coming soon!")
	end
	local MarketService = require(script.Parent:WaitForChild("MarketService")) :: any
	if not MarketService.GrantProduct(player, product) then
		return fail("Couldn't give that right now.")
	end
	return { Ok = true }
end

-- Rank roll: spend gems, pick a weighted random rank (x2 Luck pass boosts Rare+), keep it, and
-- equip it if it's rarer than the one you have on.
local rankRng = Random.new()
local function rollRank(player: Player, _value: any): Types.RequestResult
	local cost = Config.RankRoll.Cost
	local profile = DataService.Get(player)
	if not profile then
		return fail(ERR_LOADING)
	end
	if profile.Gems &lt; cost then
		return fail(string.format("You need %d 💎 to roll!", cost))
	end
	if not DataService.SpendGems(player, cost) then
		return fail(ERR_GENERIC)
	end
	local weights, total = Config.RankWeights(DataService.GetPasses(player).DoubleLuck == true)
	local r = rankRng:NextNumber() * total
	local picked = weights[#weights].Rank
	for _, entry in weights do
		r -= entry.Weight
		if r &lt;= 0 then
			picked = entry.Rank
			break
		end
	end
	DataService.AddRank(player, picked.Id)
	local current = Config.GetRank(profile.Rank)
	local better = not current or Config.RankRarities[picked.Rarity].Order &gt; Config.RankRarities[current.Rarity].Order
	if better then
		DataService.SetRank(player, picked.Id)
	end
	return { Ok = true, Rank = picked.Id, Equipped = better }
end

local function equipRank(player: Player, value: any): Types.RequestResult
	if type(value) ~= "string" then
		return fail(ERR_UNKNOWN)
	end
	if not DataService.SetRank(player, value) then
		return fail("You don't have that rank yet.")
	end
	return { Ok = true }
end

local HANDLERS: { [string]: (Player, any) -&gt; Types.RequestResult } = {
	BuyPerk = buyPerk,
	TestPass = testPass,
	TestProduct = testProduct,
	RollRank = rollRank,
	EquipRank = equipRank,
	Hatch = hatch,
	Equip = petAction("Equip"),
	Unequip = petAction("Unequip"),
	Delete = petAction("Delete"),
	EquipBest = function(player: Player, _value: any): Types.RequestResult
		return callPetService("EquipBest", player)
	end,
}

local function onMetaRequest(player: Player, action: any, value: any): Types.RequestResult
	if player.Parent ~= Players then
		return fail(ERR_GENERIC)
	end
	if not allowRequest(player) then
		return fail(ERR_SLOW)
	end
	local handler = if type(action) == "string" then HANDLERS[action] else nil
	if not handler then
		return fail(ERR_UNKNOWN)
	end
	if not DataService.Get(player) then
		return fail(ERR_LOADING)
	end
	-- Handlers don't yield today, but if one ever does, a second request must not interleave with it
	-- (that is how double-spends happen).
	if busy[player] then
		return fail(ERR_BUSY)
	end
	busy[player] = true
	local ok, result = pcall(handler, player, value)
	busy[player] = nil
	if not ok then
		warn(string.format("[ShopService] %s failed for %s: %s", action, player.Name, tostring(result)))
		return fail(ERR_GENERIC)
	end
	return normalize(result)
end

----------------------------------------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------------------------------------

function ShopService.Init()
	if initialized then
		return
	end
	initialized = true
	Remotes.Function("MetaRequest").OnServerInvoke = onMetaRequest
	Players.PlayerRemoving:Connect(function(player)
		budgets[player] = nil
		busy[player] = nil
	end)
end

function ShopService.Start()
	-- Nothing to loop: every purchase arrives through MetaRequest.
end

return ShopService</ProtectedString></Properties></Item>
</Item>
<Item class="Script" referent="RBX00000019"><Properties><string name="Name">Main</string><bool name="Disabled">false</bool><token name="RunContext">1</token><ProtectedString name="Source">-- Rinse Cycle server entry point. Builds the world, then starts every service in order.
-- Each service module exposes Init() (set up state and remote handlers, no long yields)
-- and Start() (spawn loops). See DESIGN.md for what each one owns.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterPlayer = game:GetService("StarterPlayer")

-- Hold characters back until the lobby floor exists, or new players fall into the void.
Players.CharacterAutoLoads = false
Players.RespawnTime = 3

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared:WaitForChild("Remotes"))
local Config = require(Shared:WaitForChild("Config"))

local ServicesFolder = script.Parent:WaitForChild("Services")
local Characters = require(ServicesFolder:WaitForChild("Characters"))
local DataService = require(ServicesFolder:WaitForChild("DataService"))
local MarketService = require(ServicesFolder:WaitForChild("MarketService"))
local LobbyBuilder = require(ServicesFolder:WaitForChild("LobbyBuilder"))
local DishFactory = require(ServicesFolder:WaitForChild("DishFactory"))
local ArenaBuilder = require(ServicesFolder:WaitForChild("ArenaBuilder"))
local RoundService = require(ServicesFolder:WaitForChild("RoundService"))
local PetService = require(ServicesFolder:WaitForChild("PetService"))
local ShopService = require(ServicesFolder:WaitForChild("ShopService"))
local PartyService = require(ServicesFolder:WaitForChild("PartyService"))
local LeaderboardService = require(ServicesFolder:WaitForChild("LeaderboardService"))

local function step(name: string, fn: () -&gt; ())
	local started = os.clock()
	local ok, err = xpcall(fn, debug.traceback)
	if not ok then
		warn(string.format("[%s] %s FAILED:\n%s", Config.GameName, name, tostring(err)))
	else
		print(string.format("[%s] %s ok (%.2fs)", Config.GameName, name, os.clock() - started))
	end
end

-- Camera and movement defaults (apply to characters spawned after this point).
StarterPlayer.CameraMaxZoomDistance = 60
StarterPlayer.CameraMinZoomDistance = 4
StarterPlayer.CharacterWalkSpeed = Config.World.LobbyWalkSpeed

step("Remotes", Remotes.Setup)
step("Characters", Characters.Setup)
step("DataService.Init", DataService.Init)
step("MarketService.Init", MarketService.Init)
step("LobbyBuilder.Build", function()
	LobbyBuilder.Build()
end)

-- Players can spawn now that the lobby exists.
Players.CharacterAutoLoads = true
for _, player in Players:GetPlayers() do
	if not player.Character then
		task.spawn(function()
			local ok = pcall(function()
				player:LoadCharacterAsync()
			end)
			if not ok then
				pcall(function()
					player:LoadCharacter()
				end)
			end
		end)
	end
end

local services = {
	{ "DishFactory", DishFactory },
	{ "ArenaBuilder", ArenaBuilder },
	{ "RoundService", RoundService },
	{ "PetService", PetService },
	{ "ShopService", ShopService },
	{ "PartyService", PartyService },
	{ "LeaderboardService", LeaderboardService },
}

for _, entry in services do
	local name, service = entry[1], entry[2] :: any
	if type(service.Init) == "function" then
		step(name .. ".Init", service.Init)
	end
end
for _, entry in services do
	local name, service = entry[1], entry[2] :: any
	if type(service.Start) == "function" then
		step(name .. ".Start", service.Start)
	end
end
if type((MarketService :: any).Start) == "function" then
	step("MarketService.Start", (MarketService :: any).Start)
end
if type((DataService :: any).Start) == "function" then
	step("DataService.Start", (DataService :: any).Start)
end

print(string.format("[%s] v%s server ready", Config.GameName, Config.Version))</ProtectedString></Properties></Item>
</Item>
</Item>
<Item class="StarterPlayer" referent="RBX0000001A"><Properties><string name="Name">StarterPlayer</string></Properties>
<Item class="StarterPlayerScripts" referent="RBX0000001B"><Properties><string name="Name">StarterPlayerScripts</string></Properties>
<Item class="Folder" referent="RBX0000001C"><Properties><string name="Name">Client</string></Properties>
<Item class="LocalScript" referent="RBX0000001D"><Properties><string name="Name">ClientMain</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Rinse Cycle client entry point. Starts the shared client state, then every UI / gameplay module.
-- Each module exposes Init(); anything that fails is reported without stopping the others.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local Client = script.Parent
local ClientState = require(Client:WaitForChild("ClientState"))
local UIKit = require(Client:WaitForChild("UIKit"))
local HUD = require(Client:WaitForChild("HUD"))
local PartyUI = require(Client:WaitForChild("PartyUI"))
local UpgradesUI = require(Client:WaitForChild("UpgradesUI"))
local ShopUI = require(Client:WaitForChild("ShopUI"))
local RanksUI = require(Client:WaitForChild("RanksUI"))
local PetsUI = require(Client:WaitForChild("PetsUI"))
local SprayController = require(Client:WaitForChild("SprayController"))
local PetRenderer = require(Client:WaitForChild("PetRenderer"))
local Effects = require(Client:WaitForChild("Effects"))

local function step(name: string, fn: () -&gt; ())
	local ok, err = xpcall(fn, debug.traceback)
	if not ok then
		warn(string.format("[%s] client %s FAILED:\n%s", Config.GameName, name, tostring(err)))
	end
end

step("ClientState", ClientState.Init)
step("UIKit", UIKit.Init)

ClientState.Notified:Connect(function(text, kind)
	UIKit.Toast(text, kind)
end)

step("HUD", HUD.Init)
step("PartyUI", PartyUI.Init)
step("UpgradesUI", UpgradesUI.Init)
step("ShopUI", ShopUI.Init)
step("RanksUI", RanksUI.Init)
step("PetsUI", PetsUI.Init)
step("SprayController", SprayController.Init)
step("PetRenderer", PetRenderer.Init)
step("Effects", Effects.Init)</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000001E"><Properties><string name="Name">ClientState</string><ProtectedString name="Source">-- The client's copy of everything the server tells it: permanent data (Meta), the party it is
-- waiting in (Party) and the run it is playing (Run). UI modules read from here and listen to
-- Changed instead of each hooking the remotes themselves.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared:WaitForChild("Remotes"))
local Util = require(Shared:WaitForChild("Util"))
local Types = require(Shared:WaitForChild("Types"))

local ClientState = {}

ClientState.Meta = nil :: Types.MetaState?
ClientState.Party = nil :: Types.PartyState?
ClientState.Run = nil :: Types.RunState?

-- Fired with "Meta", "Party" or "Run" after that field is replaced.
ClientState.Changed = Util.Signal.new()
-- Fired with (kind: string, data: table) for every RunFX message.
ClientState.FX = Util.Signal.new()
-- Fired with (text: string, kind: string) for every Notify message.
ClientState.Notified = Util.Signal.new()

local initialized = false

function ClientState.Init()
	if initialized then
		return
	end
	initialized = true

	Remotes.Event("MetaState").OnClientEvent:Connect(function(state)
		ClientState.Meta = state
		ClientState.Changed:Fire("Meta")
	end)
	Remotes.Event("PartyState").OnClientEvent:Connect(function(state)
		ClientState.Party = state
		ClientState.Changed:Fire("Party")
	end)
	Remotes.Event("RunState").OnClientEvent:Connect(function(state)
		ClientState.Run = state
		ClientState.Changed:Fire("Run")
	end)
	Remotes.Event("RunFX").OnClientEvent:Connect(function(kind, data)
		ClientState.FX:Fire(kind, data)
	end)
	Remotes.Event("Notify").OnClientEvent:Connect(function(text, kind)
		ClientState.Notified:Fire(text, kind or "Info")
	end)

	-- Ask for the first snapshot in case the server pushed it before we were listening.
	task.spawn(function()
		for _ = 1, 10 do
			local ok, state = pcall(function()
				return Remotes.Function("GetMeta"):InvokeServer()
			end)
			if ok and state then
				if not ClientState.Meta then
					ClientState.Meta = state
					ClientState.Changed:Fire("Meta")
				end
				return
			end
			task.wait(1)
		end
	end)
end

-- Wraps a RemoteFunction call so UI code never errors: always returns a RequestResult.
local function request(remoteName: string, action: string, value: any): Types.RequestResult
	local ok, result = pcall(function()
		return Remotes.Function(remoteName):InvokeServer(action, value)
	end)
	if not ok then
		return { Ok = false, Error = "Couldn't reach the server. Try again." }
	end
	if type(result) ~= "table" then
		return { Ok = false, Error = "Something went wrong." }
	end
	return result
end

-- In-run purchases and leaving: "BuyUpgrade" (id), "BuyTool" (index), "Leave", "ReturnToLobby".
function ClientState.RunRequest(action: string, value: any?): Types.RequestResult
	return request("RunRequest", action, value)
end

-- Permanent actions: "BuyPerk" (id), "Hatch" ({ Egg = id, Count = 1 | 3 }), "Equip" (uid),
-- "Unequip" (uid), "EquipBest", "Delete" (uid).
function ClientState.MetaRequest(action: string, value: any?): Types.RequestResult
	return request("MetaRequest", action, value)
end

function ClientState.InRun(): boolean
	return ClientState.Run ~= nil
end

function ClientState.InParty(): boolean
	return ClientState.Party ~= nil
end

-- The dishwasher model the local player is playing in, if it has replicated.
function ClientState.GetArena(): Model?
	local run = ClientState.Run
	if not run then
		return nil
	end
	local arenas = workspace:FindFirstChild("Arenas")
	local arena = arenas and arenas:FindFirstChild(run.ArenaName)
	if arena and arena:IsA("Model") then
		return arena
	end
	return nil
end

function ClientState.LocalPlayer(): Player
	return Players.LocalPlayer
end

return ClientState</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000001F"><Properties><string name="Name">Effects</string><ProtectedString name="Source">-- Effects: every world FX that isn't owned by another module. RunFX handlers (grime pops, floating
-- numbers, dish/sale celebrations), CollectionService-driven decoration (spinning arms, lift
-- pads), the drain guide beam, remaining-dirt sparkle markers, prompt routing (windows and the
-- in-arena tool shop), and a little lobby ambience.
--
-- Everything here is local: the only server calls are the tool shop's BuyTool requests (validated
-- by the server like any other purchase). Nothing here is authoritative, and every part/emitter this module creates is either pooled (reused) or handed to
-- Debris so a long session never accumulates instances.

local CollectionService = game:GetService("CollectionService")
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Types = require(Shared:WaitForChild("Types"))

local Client = script.Parent
local ClientState = require(Client:WaitForChild("ClientState"))
local UIKit = require(Client:WaitForChild("UIKit"))

local Effects = {}

local LocalPlayer = Players.LocalPlayer
local initialized = false

----------------------------------------------------------------------------------------------------
-- Constants
----------------------------------------------------------------------------------------------------

local MAX_FLOATERS = 24 -- floating +N labels alive at once (local player's own numbers)
local FLOATER_RISE = 3 -- studs
local FLOATER_TIME = 0.7
local MAX_LOBBY_BUBBLES = 10
local DRAIN_FULL_FRACTION = 0.95

-- Floating "+N" labels currently alive, oldest first (capped, so a spam of Cleaned FX can't leak).
local floaters: { Instance } = {}

----------------------------------------------------------------------------------------------------
-- Small shared helpers
----------------------------------------------------------------------------------------------------

local function billboardNumber(position: Vector3, text: string, color: Color3, rise: number?)
	if #floaters &gt;= MAX_FLOATERS then
		local oldest = table.remove(floaters, 1)
		if oldest then
			oldest:Destroy()
		end
	end
	local anchor = Instance.new("Part")
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanTouch = false
	anchor.CanQuery = false
	anchor.CastShadow = false
	anchor.Transparency = 1
	anchor.Size = Vector3.new(0.2, 0.2, 0.2)
	anchor.CFrame = CFrame.new(position)
	anchor.Parent = workspace

	local gui = Instance.new("BillboardGui")
	gui.Name = "Floater"
	gui.Size = UDim2.fromOffset(220, 50)
	gui.StudsOffset = Vector3.new(0, 1, 0)
	gui.AlwaysOnTop = true
	gui.Parent = anchor

	local label = UIKit.Label({
		Text = text,
		Size = UDim2.fromScale(1, 1),
		TextSize = 28,
		TextColor3 = color,
		Parent = gui,
	})

	table.insert(floaters, anchor)
	local goalOffset = gui.StudsOffset + Vector3.new(0, rise or FLOATER_RISE, 0)
	UIKit.Tween(gui, { StudsOffset = goalOffset }, FLOATER_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	UIKit.Tween(label, { TextTransparency = 1 }, FLOATER_TIME * 0.8)
	task.delay(FLOATER_TIME + 0.05, function()
		local i = table.find(floaters, anchor)
		if i then
			table.remove(floaters, i)
		end
		anchor:Destroy()
	end)
end

-- One-shot sparkle/pop burst: an Attachment that emits once and is handed to Debris.
local function burst(position: Vector3, color: Color3, texture: string, count: number, lifetime: number)
	local anchor = Instance.new("Part")
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanTouch = false
	anchor.CanQuery = false
	anchor.CastShadow = false
	anchor.Transparency = 1
	anchor.Size = Vector3.new(0.2, 0.2, 0.2)
	anchor.CFrame = CFrame.new(position)
	anchor.Parent = workspace

	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = texture
	emitter.Color = ColorSequence.new(color)
	emitter.Lifetime = NumberRange.new(lifetime * 0.6, lifetime)
	emitter.Speed = NumberRange.new(3, 8)
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 0) })
	emitter.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.LightEmission = 0.5
	emitter.Rate = 0
	emitter.Parent = anchor
	emitter:Emit(count)

	Debris:AddItem(anchor, lifetime + 1)
end

-- A few tiny transient bubble balls that pop upward and fade (used for "Cleaned" and lobby ambience).
local function popBubbles(position: Vector3, count: number, spread: number)
	for _ = 1, count do
		local ball = Instance.new("Part")
		ball.Shape = Enum.PartType.Ball
		ball.Material = Enum.Material.Glass
		ball.Color = Color3.new(1, 1, 1)
		ball.Transparency = 0.35
		ball.Size = Vector3.new(1, 1, 1) * (0.15 + math.random() * 0.2)
		ball.CanCollide = false
		ball.CanTouch = false
		ball.CanQuery = false
		ball.CastShadow = false
		ball.Anchored = false
		ball.CFrame = CFrame.new(position + Vector3.new((math.random() - 0.5) * spread, 0, (math.random() - 0.5) * spread))
		ball.Parent = workspace
		ball.AssemblyLinearVelocity = Vector3.new((math.random() - 0.5) * 4, 4 + math.random() * 4, (math.random() - 0.5) * 4)
		Debris:AddItem(ball, 1.2)
	end
end

----------------------------------------------------------------------------------------------------
-- RunFX handlers
----------------------------------------------------------------------------------------------------

local comboCount = 0
local lastCleanedAt = 0
local COMBO_RESET_GAP = 0.6
local lastCleanedFXAt = 0
local CLEANED_FX_MIN_GAP = 0.03 -- guards against a burst of simultaneous pet + player cleans

local function onCleaned(data: Types.FXCleaned)
	local now = os.clock()
	if now - lastCleanedFXAt &lt; CLEANED_FX_MIN_GAP then
		-- Still play the sound (cheap, and combo feel matters most), but skip the heavier burst.
	else
		lastCleanedFXAt = now
		burst(data.Position, data.Color, "rbxasset://textures/particles/sparkles_main.dds", 10, 0.5)
		popBubbles(data.Position, 3, 1.2)
	end

	if now - lastCleanedAt &gt; COMBO_RESET_GAP then
		comboCount = 0
	end
	comboCount = math.min(comboCount + 1, 12)
	lastCleanedAt = now
	UIKit.PlaySound("Pop", 0.95 + comboCount * 0.03)

	if data.By == LocalPlayer.UserId then
		billboardNumber(data.Position, "+" .. UIKit.Short(data.Units) .. " 💧", UIKit.Theme.Colors.Primary)
		if data.Golden and data.Bubbles &gt; 0 then
			billboardNumber(data.Position, "+" .. UIKit.Short(data.Bubbles) .. " 🧼", UIKit.Theme.Colors.Bubble, FLOATER_RISE + 1)
		end
	end
end

local function onDishDone(data: Types.FXDishDone)
	burst(data.Position, UIKit.Theme.Colors.Good, "rbxasset://textures/particles/sparkles_main.dds", 24, 0.8)
	popBubbles(data.Position, 6, 2)
	UIKit.PlaySound("Sparkle")
	billboardNumber(data.Position, "✨ Sparkling!", UIKit.Theme.Colors.Text, FLOATER_RISE + 1)
	if data.By == LocalPlayer.UserId and data.Bonus &gt; 0 then
		billboardNumber(data.Position + Vector3.new(0, 1.4, 0), "+" .. UIKit.Short(data.Bonus) .. " 💰", UIKit.Theme.Colors.Coin, FLOATER_RISE + 1.6)
	end
end

local function onSold(data: Types.FXSold)
	UIKit.PlaySound("Coins")
	UIKit.Toast("+" .. UIKit.Commas(data.Coins) .. " 💰", "Good")
end

local function onTankFull()
	UIKit.PlaySound("Error")
end

local function onRunFX(kind: string, data: any)
	if kind == "Cleaned" then
		onCleaned(data)
	elseif kind == "DishDone" then
		onDishDone(data)
	elseif kind == "Sold" then
		onSold(data)
	elseif kind == "TankFull" then
		onTankFull()
	end
end

----------------------------------------------------------------------------------------------------
-- SpinY (CollectionService): drain whirlpool rings, spray arms under each rack. Streaming-safe:
-- parts that stream out simply stop appearing in GetTagged / are skipped if their Parent goes away.
----------------------------------------------------------------------------------------------------

local spinParts: { [BasePart]: boolean } = {}

local function addSpinPart(inst: Instance)
	if inst:IsA("BasePart") then
		spinParts[inst] = true
	end
end

local function removeSpinPart(inst: Instance)
	spinParts[inst :: BasePart] = nil
end

local function stepSpin(dt: number)
	for part in spinParts do
		if not part.Parent or not part:IsDescendantOf(workspace) then
			spinParts[part] = nil
			continue
		end
		local speed = part:GetAttribute("SpinSpeed")
		if type(speed) ~= "number" or speed == 0 then
			continue
		end
		part.CFrame *= CFrame.Angles(0, speed * dt, 0)
	end
end

----------------------------------------------------------------------------------------------------
-- Lift pads (CollectionService tag "LiftPad", attribute LiftTo = world Vector3): step on one and
-- you're carried to LiftTo in a puff of bubbles. The local client owns its character, so moving it
-- here replicates. A short cooldown stops you bouncing straight back.
----------------------------------------------------------------------------------------------------

local LIFT_RADIUS = 4.2
local LIFT_COOLDOWN = 1.2

local liftPads: { [BasePart]: boolean } = {}
local lastLiftAt = 0

local function addLiftPart(inst: Instance)
	if inst:IsA("BasePart") then
		liftPads[inst] = true
	end
end

local function removeLiftPart(inst: Instance)
	liftPads[inst :: BasePart] = nil
end

local function stepLift(_dt: number)
	local now = os.clock()
	if now - lastLiftAt &lt; LIFT_COOLDOWN then
		return
	end
	local character = LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not character or not root or not root:IsA("BasePart") then
		return
	end
	local rootPart = root :: BasePart
	local pos = rootPart.Position

	for pad in liftPads do
		if not pad.Parent then
			liftPads[pad] = nil
			continue
		end
		local target = pad:GetAttribute("LiftTo")
		if typeof(target) ~= "Vector3" then
			continue
		end
		local d = pos - pad.Position
		if Vector3.new(d.X, 0, d.Z).Magnitude &lt;= LIFT_RADIUS and d.Y &gt; -1 and d.Y &lt; 7 then
			lastLiftAt = now
			popBubbles(pad.Position + Vector3.new(0, 2, 0), 8, 3)
			UIKit.PlaySound("Splash", 1.3)
			local facing = rootPart.CFrame.Rotation
			character:PivotTo(CFrame.new(target) * facing)
			rootPart.AssemblyLinearVelocity = Vector3.zero
			popBubbles(target, 8, 3)
			break
		end
	end
end

----------------------------------------------------------------------------------------------------
-- Drain guide beam: shown while the local player's tank is at or above 95% full.
----------------------------------------------------------------------------------------------------

local drainAnchor: BasePart? = nil
local drainAttachment: Attachment? = nil
local drainRootAttachment: Attachment? = nil
local drainBeam: Beam? = nil
local drainRoot: BasePart? = nil

local function ensureDrainGuide()
	if drainAnchor and drainAnchor.Parent then
		return
	end
	local anchor = Instance.new("Part")
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanTouch = false
	anchor.CanQuery = false
	anchor.CastShadow = false
	anchor.Transparency = 1
	anchor.Size = Vector3.new(0.2, 0.2, 0.2)
	anchor.Parent = workspace
	drainAnchor = anchor

	local a1 = Instance.new("Attachment")
	a1.Parent = anchor
	drainAttachment = a1
end

local function updateDrainGuide()
	local run = ClientState.Run :: Types.RunState?
	local character = LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")

	local wantsGuide = run ~= nil and run.Phase == "Playing" and root ~= nil and run.TankMax &gt; 0 and (run.Tank / run.TankMax) &gt;= DRAIN_FULL_FRACTION

	if not wantsGuide then
		if drainBeam then
			drainBeam.Enabled = false
		end
		return
	end

	ensureDrainGuide()
	;(drainAnchor :: BasePart).CFrame = CFrame.new((run :: Types.RunState).DrainPosition)

	if drainRoot ~= root then
		drainRoot = root :: BasePart
		if drainRootAttachment then
			drainRootAttachment:Destroy()
		end
		local a0 = Instance.new("Attachment")
		a0.Parent = drainRoot
		drainRootAttachment = a0
		if drainBeam then
			drainBeam:Destroy()
		end
		local b = Instance.new("Beam")
		b.Name = "DrainGuide"
		b.Attachment0 = drainRootAttachment
		b.Attachment1 = drainAttachment
		b.Width0 = 0.4
		b.Width1 = 0.15
		b.Color = ColorSequence.new(UIKit.Theme.Colors.Primary)
		b.Transparency = NumberSequence.new(0.35)
		b.LightEmission = 0.7
		b.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		b.TextureMode = Enum.TextureMode.Wrap
		b.TextureLength = 2
		b.TextureSpeed = -3 -- flows toward the drain
		b.FaceCamera = true
		b.Parent = drainRootAttachment
		drainBeam = b
	end
	(drainBeam :: Beam).Enabled = true
end

----------------------------------------------------------------------------------------------------
-- Remaining-grime markers: ✨ on every grime part still left once few remain.
----------------------------------------------------------------------------------------------------

local markedParts: { [BasePart]: BillboardGui } = {}
local cachedGrimeFolder: Folder? = nil
local cachedGrimeArena: Model? = nil

-- ArenaBuilder doesn't publish the grime folder's exact path to clients (only the Model
-- replicates), so we look for a child folder holding grime-shaped parts (parts carrying the
-- MinTool attribute every grime spot has). This is deliberately defensive: see needsFromOthers.
local function findGrimeFolder(arena: Model): Folder?
	if cachedGrimeArena == arena and cachedGrimeFolder and cachedGrimeFolder.Parent then
		return cachedGrimeFolder
	end
	local direct = arena:FindFirstChild("Grime")
	if direct and direct:IsA("Folder") then
		cachedGrimeArena, cachedGrimeFolder = arena, direct
		return direct
	end
	for _, child in arena:GetChildren() do
		if child:IsA("Folder") then
			for _, grandchild in child:GetChildren() do
				if grandchild:IsA("BasePart") and grandchild:GetAttribute("MinTool") ~= nil then
					cachedGrimeArena, cachedGrimeFolder = arena, child
					return child
				end
			end
		end
	end
	return nil
end

local function clearMarker(part: BasePart)
	local gui = markedParts[part]
	if gui then
		gui:Destroy()
		markedParts[part] = nil
	end
end

local function clearAllMarkers()
	for part in markedParts do
		clearMarker(part)
	end
end

local function markPart(part: BasePart)
	if markedParts[part] then
		return
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "RemainingMarker"
	gui.Size = UDim2.fromOffset(40, 40)
	gui.StudsOffset = Vector3.new(0, 1, 0)
	gui.AlwaysOnTop = true
	gui.Parent = part
	UIKit.Label({
		Text = "✨",
		Size = UDim2.fromScale(1, 1),
		TextSize = 30,
		Stroke = false,
		Parent = gui,
	})
	markedParts[part] = gui
	part.AncestryChanged:Connect(function(_, parent)
		if not parent then
			clearMarker(part)
		end
	end)
end

local function updateRemainingMarkers()
	local run = ClientState.Run :: Types.RunState?
	local arena = ClientState.GetArena()
	if not run or run.Phase ~= "Playing" or not arena then
		clearAllMarkers()
		return
	end
	local remaining = run.Total - run.Cleaned
	if remaining &gt; Config.Round.MarkerThreshold then
		clearAllMarkers()
		return
	end
	local folder = findGrimeFolder(arena)
	if not folder then
		return
	end
	local seen: { [BasePart]: boolean } = {}
	for _, child in folder:GetChildren() do
		if child:IsA("BasePart") then
			seen[child] = true
			markPart(child)
		end
	end
	for part in markedParts do
		if not seen[part] then
			clearMarker(part)
		end
	end
end

----------------------------------------------------------------------------------------------------
-- Prompts: route to UIKit windows using the attributes LobbyBuilder/ArenaBuilder set.
----------------------------------------------------------------------------------------------------

local buyingTool = false

local function buyTool(index: number)
	if buyingTool then
		return
	end
	buyingTool = true
	local result = ClientState.RunRequest("BuyTool", index)
	buyingTool = false
	local tool = Config.Tools[index]
	if result.Ok then
		UIKit.PlaySound("Coins")
		UIKit.Toast(string.format("%s %s bought!", tool and tool.Icon or "", tool and tool.Name or "Tool"), "Good")
	else
		UIKit.PlaySound("Error")
		UIKit.Toast(result.Error or "Can't buy that yet.", "Bad")
	end
end

local function onPromptTriggered(prompt: ProximityPrompt, player: Player)
	if player ~= LocalPlayer then
		return
	end
	local windowName = prompt:GetAttribute("OpenWindow")
	if type(windowName) == "string" then
		UIKit.OpenWindow(windowName, prompt:GetAttribute("EggId"))
		return
	end
	local toolIndex = prompt:GetAttribute("BuyTool")
	if type(toolIndex) == "number" then
		task.spawn(buyTool, toolIndex)
	end
end

----------------------------------------------------------------------------------------------------
-- Tool shop displays in the arena: owned / next (buyable) / locked, refreshed on every RunState.
----------------------------------------------------------------------------------------------------

local function updateShopDisplays()
	local run = ClientState.Run :: Types.RunState?
	local arena = ClientState.GetArena()
	if not run or not arena then
		return
	end
	for _, inst in arena:GetChildren() do
		if not inst:IsA("BasePart") then
			continue
		end
		local display = string.match(inst.Name, "^ToolDisplay_(%d+)$")
		local tag = string.match(inst.Name, "^PriceTag_(%d+)$")
		local index = tonumber(display or tag)
		local tool = index and Config.Tools[index]
		if not index or not tool then
			continue
		end
		local owned = run.OwnedTools ~= nil and run.OwnedTools[index] == true
		if display then
			local prompt = inst:FindFirstChildOfClass("ProximityPrompt")
			if prompt then
				prompt.Enabled = not owned
			end
		else
			local gui = inst:FindFirstChildOfClass("SurfaceGui")
			local price = gui and gui:FindFirstChild("Price") :: TextLabel?
			if price then
				local cost = Config.ToolCost(index, run.Level) or 0
				if owned then
					price.Text = "✅ Owned"
					price.TextColor3 = UIKit.Theme.Colors.Good
				else
					price.Text = "💰 " .. UIKit.Short(cost)
					price.TextColor3 = if run.Coins &gt;= cost then UIKit.Theme.Colors.Coin else UIKit.Theme.Colors.Bad
				end
			end
		end
	end
end

----------------------------------------------------------------------------------------------------
-- Lobby ambience: a handful of floating bubbles drifting near the camera.
----------------------------------------------------------------------------------------------------

local lobbyBubbles: { BasePart } = {}
local lastLobbyAmbienceAt = 0

local function stepLobbyAmbience()
	local run = ClientState.Run :: Types.RunState?
	if run ~= nil then
		-- In a run: let any leftover lobby bubbles finish naturally (Debris already scheduled).
		return
	end
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local now = os.clock()
	if now - lastLobbyAmbienceAt &lt; 0.9 or #lobbyBubbles &gt;= MAX_LOBBY_BUBBLES then
		return
	end
	lastLobbyAmbienceAt = now

	local offset = Vector3.new((math.random() - 0.5) * 30, math.random() * 6, (math.random() - 0.5) * 30 - 12)
	local position = camera.CFrame.Position + offset
	local ball = Instance.new("Part")
	ball.Shape = Enum.PartType.Ball
	ball.Material = Enum.Material.Glass
	ball.Color = Color3.new(1, 1, 1)
	ball.Transparency = 0.5
	ball.Size = Vector3.new(1, 1, 1) * (0.25 + math.random() * 0.35)
	ball.Anchored = false
	ball.CanCollide = false
	ball.CanTouch = false
	ball.CanQuery = false
	ball.CastShadow = false
	ball.CFrame = CFrame.new(position)
	ball.AssemblyLinearVelocity = Vector3.new((math.random() - 0.5) * 1.5, 2 + math.random() * 1.5, (math.random() - 0.5) * 1.5)
	ball.Parent = workspace
	table.insert(lobbyBubbles, ball)
	Debris:AddItem(ball, 6)
	task.delay(6, function()
		local i = table.find(lobbyBubbles, ball)
		if i then
			table.remove(lobbyBubbles, i)
		end
	end)
end

----------------------------------------------------------------------------------------------------
-- Run lifecycle (the run-start banner itself lives in the HUD).
----------------------------------------------------------------------------------------------------

local function onStateChanged(kind: string)
	if kind ~= "Run" then
		return
	end
	updateRemainingMarkers()
	updateShopDisplays()
end

----------------------------------------------------------------------------------------------------
-- Init
----------------------------------------------------------------------------------------------------

function Effects.Init()
	if initialized then
		return
	end
	initialized = true

	ClientState.FX:Connect(onRunFX)
	ClientState.Changed:Connect(onStateChanged)

	for _, inst in CollectionService:GetTagged("SpinY") do
		addSpinPart(inst)
	end
	CollectionService:GetInstanceAddedSignal("SpinY"):Connect(addSpinPart)
	CollectionService:GetInstanceRemovedSignal("SpinY"):Connect(removeSpinPart)

	for _, inst in CollectionService:GetTagged("LiftPad") do
		addLiftPart(inst)
	end
	CollectionService:GetInstanceAddedSignal("LiftPad"):Connect(addLiftPart)
	CollectionService:GetInstanceRemovedSignal("LiftPad"):Connect(removeLiftPart)

	ProximityPromptService.PromptTriggered:Connect(onPromptTriggered)

	RunService.Heartbeat:Connect(function(dt)
		stepSpin(dt)
		stepLift(dt)
		updateDrainGuide()
		stepLobbyAmbience()
	end)

	-- Grime count changes on every Cleaned/Sold push; the marker set only needs to react to those
	-- and to Run replacing wholesale (onStateChanged already covers both via ClientState.Changed).
end

return Effects</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000020"><Properties><string name="Name">HUD</string><ProtectedString name="Source">-- Always-on heads-up display, laid out like the big round-based simulators:
--   * top centre: the Bubbles pill with a green "+" (opens the Shop)
--   * right side: big square buttons (Shop/Pets in the lobby, Upgrades/Pets/Leave in a run) with
--     key hints for keyboard (Tab/G/P) or gamepad (Y/LB)
--   * in a run: coins + tank bottom-left, the timer bottom-right, dishwasher progress top-centre
--   * the run-start banner, the results screen and the Leave confirmation
-- On touch the corner widgets move clear of the thumbstick and jump button. See DESIGN.md section 6 "HUD". Everything here is built once in Init() and then only
-- shown/hidden/updated, so there's nothing to leak: no per-run instances, no per-run connections
-- besides the ones this module owns for its whole lifetime.

local Players = game:GetService("Players")
local StarterGui = game:GetService("StarterGui")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Types = require(Shared:WaitForChild("Types"))
local Util = require(Shared:WaitForChild("Util"))

local Client = script.Parent
local ClientState = require(Client:WaitForChild("ClientState"))
local UIKit = require(Client:WaitForChild("UIKit"))

local Colors = UIKit.Theme.Colors

local LocalPlayer = Players.LocalPlayer

local HUD = {}
local initialized = false

----------------------------------------------------------------------------------------------------
-- Init
----------------------------------------------------------------------------------------------------

function HUD.Init()
	if initialized then
		return
	end
	initialized = true

	local _gui, root = UIKit.CreateScreen("HUD", 5)

	--------------------------------------------------------------------------------------------------
	-- Top centre: the Bubbles pill with a green "+" (opens the shop), like every simulator's.
	--------------------------------------------------------------------------------------------------
	local topCurrency = Instance.new("Frame")
	topCurrency.Name = "TopCurrency"
	topCurrency.AnchorPoint = Vector2.new(0.5, 0)
	topCurrency.Size = UDim2.fromOffset(250, 54)
	topCurrency.BackgroundColor3 = Color3.new(1, 1, 1)
	topCurrency.BorderSizePixel = 0
	UIKit.Corner(topCurrency, 16)
	UIKit.Gradient(topCurrency, Color3.fromRGB(120, 130, 145), Color3.fromRGB(70, 78, 92))
	UIKit.Stroke(topCurrency, Colors.Ink, 3)
	topCurrency.Parent = root

	UIKit.Label({
		Text = "🧼",
		TextSize = 38,
		Position = UDim2.fromOffset(8, 0),
		Size = UDim2.fromOffset(50, 58),
		Stroke = false,
		Parent = topCurrency,
	})
	local bubblesValue = UIKit.Label({
		Name = "Value",
		Text = "0",
		TextSize = 38,
		Position = UDim2.fromOffset(58, 0),
		Size = UDim2.new(1, -120, 1, 0),
		TextXAlignment = Enum.TextXAlignment.Center,
		Parent = topCurrency,
	})
	local plusButton = UIKit.Button({
		Name = "Plus",
		Text = "+",
		Size = UDim2.fromOffset(46, 46),
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -6, 0.5, 0),
		Color = Colors.Good,
		TextSize = 34,
		CornerRadius = 10,
		Parent = topCurrency,
		OnClick = function()
			UIKit.ToggleWindow("Shop")
		end,
	})

	-- Count-up animation for the Bubbles number.
	local bubblesNV = Instance.new("NumberValue")
	bubblesNV.Parent = topCurrency
	bubblesNV:GetPropertyChangedSignal("Value"):Connect(function()
		bubblesValue.Text = UIKit.Commas(math.floor(bubblesNV.Value + 0.5))
	end)
	local bubblesShown = -1
	local function setBubbles(value: number)
		value = math.max(0, math.floor((tonumber(value) or 0) + 0.5))
		if value == bubblesShown then
			return
		end
		local increased = bubblesShown &gt;= 0 and value &gt; bubblesShown
		if bubblesShown &lt; 0 then
			bubblesNV.Value = value
			bubblesValue.Text = UIKit.Commas(value)
		else
			UIKit.Tween(bubblesNV, { Value = value }, 0.4)
		end
		bubblesShown = value
		if increased then
			UIKit.Bounce(topCurrency)
		end
	end

	-- Gems pill, to the right of the Bubbles pill.
	local gemsPill = Instance.new("Frame")
	gemsPill.Name = "Gems"
	gemsPill.AnchorPoint = Vector2.new(0, 0)
	gemsPill.Size = UDim2.fromOffset(130, 44)
	gemsPill.BackgroundColor3 = Color3.new(1, 1, 1)
	gemsPill.BorderSizePixel = 0
	UIKit.Corner(gemsPill, 14)
	UIKit.Gradient(gemsPill, Color3.fromRGB(150, 100, 200), Color3.fromRGB(90, 55, 140))
	UIKit.Stroke(gemsPill, Colors.Ink, 3)
	gemsPill.Parent = root
	UIKit.Label({ Text = "💎", TextSize = 28, Position = UDim2.fromOffset(6, 0), Size = UDim2.fromOffset(38, 44), Stroke = false, Parent = gemsPill })
	local gemsValue = UIKit.Label({
		Text = "0",
		TextSize = 28,
		Position = UDim2.fromOffset(44, 0),
		Size = UDim2.new(1, -52, 1, 0),
		TextXAlignment = Enum.TextXAlignment.Center,
		Parent = gemsPill,
	})
	local gemsShown = -1
	local function setGems(value: number)
		value = math.max(0, math.floor(tonumber(value) or 0))
		if value ~= gemsShown then
			if gemsShown &gt;= 0 and value &gt; gemsShown then
				UIKit.Bounce(gemsPill)
			end
			gemsShown = value
			gemsValue.Text = UIKit.Commas(value)
		end
	end

	--------------------------------------------------------------------------------------------------
	-- Right column: big square buttons (Shop/Pets in the lobby; Upgrades/Pets/Leave in a run), each
	-- with a small key hint for keyboard or gamepad.
	--------------------------------------------------------------------------------------------------
	local rightColumn = Instance.new("Frame")
	rightColumn.Name = "RightColumn"
	rightColumn.AnchorPoint = Vector2.new(1, 0.5)
	rightColumn.Size = UDim2.fromOffset(104, 0)
	rightColumn.AutomaticSize = Enum.AutomaticSize.Y
	rightColumn.BackgroundTransparency = 1
	rightColumn.Parent = root
	local rightLayout = Instance.new("UIListLayout")
	rightLayout.SortOrder = Enum.SortOrder.LayoutOrder
	rightLayout.HorizontalAlignment = Enum.HorizontalAlignment.Right
	rightLayout.Padding = UDim.new(0, 12)
	rightLayout.Parent = rightColumn

	local hints: { [TextButton]: { Key: string, Pad: string } } = {}
	local function sideButton(icon: string, label: string, color: Color3, keyHint: string, padHint: string, onClick: () -&gt; ()): TextButton
		local b = UIKit.IconButton({
			Icon = icon,
			Label = label,
			Color = color,
			Size = UDim2.fromOffset(100, 100),
			Parent = rightColumn,
			OnClick = onClick,
		})
		local badge = Instance.new("Frame")
		badge.Name = "KeyHint"
		badge.AnchorPoint = Vector2.new(0, 0)
		badge.Position = UDim2.fromOffset(-8, -8)
		badge.Size = UDim2.fromOffset(34, 28)
		badge.BackgroundColor3 = Colors.PanelDark
		badge.ZIndex = 6
		UIKit.Corner(badge, 8)
		UIKit.Stroke(badge, Colors.Ink, 2)
		UIKit.Label({ Name = "Text", Text = keyHint, TextSize = 16, Size = UDim2.fromScale(1, 1), ZIndex = 7, Parent = badge })
		badge.Parent = b
		hints[b] = { Key = keyHint, Pad = padHint }
		return b
	end

	local upgradesButton = sideButton("📖", "Upgrades", Colors.Good, "Tab", "Y", function()
		UIKit.ToggleWindow("Upgrades")
	end)
	local shopButton = sideButton("🛒", "Shop", Colors.Bad, "G", "Y", function()
		UIKit.ToggleWindow("Shop")
	end)
	local petsButton = sideButton("🐾", "Pets", Colors.Warning, "P", "LB", function()
		UIKit.ToggleWindow("Pets")
	end)
	local ranksButton = sideButton("💎", "Ranks", Colors.Accent, "R", "RB", function()
		UIKit.ToggleWindow("Ranks")
	end)
	local leaveButton = sideButton("🚪", "Leave", Colors.PanelLight, "", "", function()
		UIKit.OpenWindow("LeaveConfirm")
	end)

	--------------------------------------------------------------------------------------------------
	-- Hotbar (in a run): one slot per tool. Owned tools can be put in your hand (click / tap, keys
	-- 1-6, gamepad D-pad left/right); locked ones show a lock and open the Upgrade Book.
	--------------------------------------------------------------------------------------------------
	local SLOT = 68
	local hotbar = Instance.new("Frame")
	hotbar.Name = "Hotbar"
	hotbar.AnchorPoint = Vector2.new(0.5, 1)
	hotbar.Size = UDim2.fromOffset(#Config.Tools * (SLOT + 8), SLOT + 18)
	hotbar.BackgroundTransparency = 1
	hotbar.Visible = false
	hotbar.Parent = root
	local hotbarLayout = Instance.new("UIListLayout")
	hotbarLayout.FillDirection = Enum.FillDirection.Horizontal
	hotbarLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	hotbarLayout.VerticalAlignment = Enum.VerticalAlignment.Bottom
	hotbarLayout.SortOrder = Enum.SortOrder.LayoutOrder
	hotbarLayout.Padding = UDim.new(0, 8)
	hotbarLayout.Parent = hotbar

	local equipping = false
	local function equipTool(index: number)
		local run = ClientState.Run :: Types.RunState?
		if not run or equipping then
			return
		end
		if not (run.OwnedTools and run.OwnedTools[index]) then
			UIKit.OpenWindow("Upgrades")
			return
		end
		if run.ToolIndex == index then
			return
		end
		equipping = true
		local result = ClientState.RunRequest("EquipTool", index)
		equipping = false
		if not result.Ok then
			UIKit.Toast(result.Error or "Can't use that yet.", "Bad")
		end
	end

	local slots: { TextButton } = {}
	for i, tool in Config.Tools do
		local slot = UIKit.IconButton({
			Name = "Slot" .. i,
			Icon = tool.Icon,
			Label = "",
			Color = Colors.PanelLight,
			Size = UDim2.fromOffset(SLOT, SLOT),
			LayoutOrder = i,
			Parent = hotbar,
			OnClick = function()
				task.spawn(equipTool, i)
			end,
		})
		local num = UIKit.Label({ Name = "Key", Text = tostring(i), TextSize = 16, Position = UDim2.fromOffset(6, 2), Size = UDim2.fromOffset(16, 18), ZIndex = 8, Parent = slot })
		num.TextXAlignment = Enum.TextXAlignment.Left
		slots[i] = slot
	end

	local function refreshHotbar()
		local run = ClientState.Run :: Types.RunState?
		for i, slot in slots do
			local owned = run ~= nil and run.OwnedTools ~= nil and run.OwnedTools[i] == true
			local inHand = run ~= nil and run.ToolIndex == i
			slot.BackgroundColor3 = if inHand then Colors.Good elseif owned then Colors.Primary else Colors.PanelDark
			slot:SetAttribute("Icon", if owned then Config.Tools[i].Icon else "🔒")
			UIKit.Bounce(slot)
		end
	end
	local lastHotbarKey = ""
	local function hotbarKey(): string
		local run = ClientState.Run :: Types.RunState?
		if not run then
			return ""
		end
		local parts = { tostring(run.ToolIndex) }
		for i in Config.Tools do
			table.insert(parts, if run.OwnedTools and run.OwnedTools[i] then "1" else "0")
		end
		return table.concat(parts)
	end

	local function refreshHints()
		local touch = UIKit.IsTouch()
		local pad = UIKit.IsGamepad()
		for button, hint in hints do
			local badge = button:FindFirstChild("KeyHint") :: Frame?
			if badge then
				local text = if pad then hint.Pad else hint.Key
				badge.Visible = not touch and text ~= ""
				local lbl = badge:FindFirstChild("Text") :: TextLabel?
				if lbl then
					lbl.Text = text
				end
				badge.Size = UDim2.fromOffset(math.max(28, 12 + #text * 10), 28)
			end
		end
	end

	--------------------------------------------------------------------------------------------------
	-- In-run corner widgets: money + tank bottom-left, timer bottom-right.
	--------------------------------------------------------------------------------------------------
	local moneyBlock = Instance.new("Frame")
	moneyBlock.Name = "Money"
	moneyBlock.AnchorPoint = Vector2.new(0, 1)
	moneyBlock.Size = UDim2.fromOffset(300, 130)
	moneyBlock.BackgroundTransparency = 1
	moneyBlock.Visible = false
	moneyBlock.Parent = root

	local coinsLabel = UIKit.Label({
		Name = "Coins",
		Text = "💰 0",
		TextSize = 54,
		Size = UDim2.new(1, 0, 0, 62),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Color3.fromRGB(90, 235, 110),
		StrokeThickness = 3,
		Parent = moneyBlock,
	})
	local coinsNV = Instance.new("NumberValue")
	coinsNV.Parent = moneyBlock
	coinsNV:GetPropertyChangedSignal("Value"):Connect(function()
		coinsLabel.Text = "💰 " .. UIKit.Commas(math.floor(coinsNV.Value + 0.5))
	end)
	local coinsShown = -1
	local function setCoins(value: number)
		value = math.max(0, math.floor((tonumber(value) or 0) + 0.5))
		if value == coinsShown then
			return
		end
		local increased = coinsShown &gt;= 0 and value &gt; coinsShown
		if coinsShown &lt; 0 then
			coinsNV.Value = value
		else
			UIKit.Tween(coinsNV, { Value = value }, 0.4)
		end
		coinsShown = value
		if increased then
			UIKit.Bounce(coinsLabel)
		end
	end

	local tankBar = UIKit.ProgressBar({
		Size = UDim2.new(0, 280, 0, 44),
		Position = UDim2.fromOffset(0, 70),
		Color = Colors.Primary,
		Text = "💧 0/0",
		TextSize = 24,
		Parent = moneyBlock,
	})
	tankBar.Frame.Name = "Tank"

	local tankFlash: Tween? = nil
	local function setTankFull(isFull: boolean)
		if isFull and not tankFlash then
			tankBar.SetColor(Colors.Bad)
			local info = TweenInfo.new(0.4, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)
			local tw = TweenService:Create(tankBar.Fill, info, { BackgroundTransparency = 0.55 })
			tankFlash = tw
			tw:Play()
		elseif not isFull and tankFlash then
			tankFlash:Cancel()
			tankFlash = nil
			tankBar.Fill.BackgroundTransparency = 0
			tankBar.SetColor(Colors.Primary)
		end
	end

	local timerLabel = UIKit.Label({
		Name = "Timer",
		Text = "00:00:00",
		TextSize = 48,
		AnchorPoint = Vector2.new(1, 1),
		Size = UDim2.fromOffset(260, 56),
		TextXAlignment = Enum.TextXAlignment.Right,
		Visible = false,
		Parent = root,
	})

	--------------------------------------------------------------------------------------------------
	-- Top centre, in-run: dishwasher name and cleaning progress (under the currency pill).
	--------------------------------------------------------------------------------------------------
	local topBar = Instance.new("Frame")
	topBar.Name = "TopBar"
	topBar.AnchorPoint = Vector2.new(0.5, 0)
	topBar.Size = UDim2.new(0, 460, 0, 70)
	topBar.BackgroundTransparency = 1
	topBar.Visible = false
	topBar.Parent = root

	local levelLabel = UIKit.Label({
		Text = "",
		Size = UDim2.new(1, 0, 0, 28),
		TextSize = 22,
		TextXAlignment = Enum.TextXAlignment.Center,
		Parent = topBar,
	})
	local progressBar = UIKit.ProgressBar({
		Size = UDim2.new(0, 400, 0, 32),
		Position = UDim2.new(0.5, 0, 0, 32),
		AnchorPoint = Vector2.new(0.5, 0),
		Color = Colors.Good,
		Parent = topBar,
	})

	--------------------------------------------------------------------------------------------------
	-- Layout: keeps everything inside the safe area and clear of the touch thumbstick/jump zones.
	--------------------------------------------------------------------------------------------------
	local function relayoutHud()
		local canvas = UIKit.CanvasSize()
		local inset = UIKit.TopInset()
		local safe = UIKit.SafeInsets()
		local touch = UIKit.IsTouch()

		-- The pill sits in the topbar row itself (the middle of Roblox's topbar is empty), like the
		-- big simulators do; the run's progress bar goes right under it.
		topCurrency.Position = UDim2.new(0.5, 0, 0, 2)
		gemsPill.Position = UDim2.new(0.5, 133, 0, 7)
		hotbar.Position = UDim2.new(0.5, 0, 1, -(if touch then 24 else 12) - safe.Bottom)
		topBar.Position = UDim2.new(0.5, 0, 0, 66)

		-- Right column: vertically centred, but on touch kept above the jump button.
		local colH = rightColumn.AbsoluteSize.Y / UIKit.GetScale()
		local centerY = canvas.Y / 2
		if touch then
			centerY = math.min(centerY, canvas.Y - 300 - colH / 2)
		end
		centerY = math.max(centerY, inset + 80 + colH / 2)
		rightColumn.Position = UDim2.new(1, -(16 + safe.Right), 0, math.floor(centerY))

		-- Money block: bottom-left on desktop/console; above the thumbstick on touch.
		local bottom = if touch then canvas.Y - 330 else canvas.Y - 16 - safe.Bottom
		moneyBlock.Position = UDim2.new(0, 20 + safe.Left, 0, math.floor(bottom))

		-- Timer: bottom-right on desktop/console; top-right under the topbar on touch.
		if touch then
			timerLabel.AnchorPoint = Vector2.new(1, 0)
			timerLabel.TextSize = 34
			timerLabel.Position = UDim2.new(1, -(16 + safe.Right), 0, math.floor(inset + 10))
		else
			timerLabel.AnchorPoint = Vector2.new(1, 1)
			timerLabel.TextSize = 48
			timerLabel.Position = UDim2.new(1, -(20 + safe.Right), 1, -(12 + safe.Bottom))
		end
		refreshHints()
	end
	rightColumn:GetPropertyChangedSignal("AbsoluteSize"):Connect(relayoutHud)

	local function relayoutTopBar()
		relayoutHud()
	end

	--------------------------------------------------------------------------------------------------
	-- Run-start banner.
	--------------------------------------------------------------------------------------------------
	local banner = Instance.new("Frame")
	banner.Name = "RunStartBanner"
	banner.AnchorPoint = Vector2.new(0.5, 0)
	banner.Size = UDim2.new(0, 640, 0, 96)
	banner.BackgroundTransparency = 1
	banner.Visible = false
	banner.ZIndex = 25
	banner.Parent = root

	local bannerTitle = UIKit.Label({
		Text = "🧽 Clean every dish! 🧽",
		Size = UDim2.new(1, 0, 0, 52),
		TextSize = 40,
		TextXAlignment = Enum.TextXAlignment.Center,
		Parent = banner,
	})
	local bannerSubtitle = UIKit.Label({
		Text = "",
		Size = UDim2.new(1, 0, 0, 34),
		Position = UDim2.new(0, 0, 0, 54),
		TextSize = 26,
		TextColor3 = Colors.TextDim,
		TextXAlignment = Enum.TextXAlignment.Center,
		Parent = banner,
	})

	-- The banner shows in the middle of the screen (a quarter of the way down), well below the
	-- Bubbles pill and the progress bar, so nothing ever overlaps.
	local function relayoutBanner()
		local canvas = UIKit.CanvasSize()
		banner.Position = UDim2.new(0.5, 0, 0, math.floor(math.max(170, canvas.Y * 0.26)))
	end

	local bannerToken = 0
	local function showRunStartBanner(levelIndex: number)
		local level = Config.GetLevel(levelIndex)
		bannerSubtitle.Text = tostring(level.Name)
		bannerToken += 1
		local token = bannerToken
		relayoutBanner()
		banner.Visible = true
		bannerTitle.TextTransparency = 0
		bannerSubtitle.TextTransparency = 0
		UIKit.Bounce(banner)
		task.delay(2.5, function()
			if token ~= bannerToken then
				return
			end
			UIKit.Tween(bannerTitle, { TextTransparency = 1 }, 0.4)
			UIKit.Tween(bannerSubtitle, { TextTransparency = 1 }, 0.4)
			task.delay(0.45, function()
				if token == bannerToken then
					banner.Visible = false
				end
			end)
		end)
	end

	--------------------------------------------------------------------------------------------------
	-- Results screen (Phase == "Complete").
	--------------------------------------------------------------------------------------------------
	local RESULTS_BASE = Vector2.new(860, 560)
	local resultsFrame = Instance.new("Frame")
	resultsFrame.Name = "Results"
	resultsFrame.AnchorPoint = Vector2.new(0.5, 0.5)
	resultsFrame.Size = UDim2.fromOffset(RESULTS_BASE.X, RESULTS_BASE.Y)
	resultsFrame.BorderSizePixel = 0
	resultsFrame.Visible = false
	resultsFrame.ZIndex = 15
	UIKit.Corner(resultsFrame, 20)
	UIKit.Gradient(resultsFrame, Colors.Panel, Colors.PanelDark)
	UIKit.Stroke(resultsFrame, Colors.Ink, 3)
	resultsFrame.Parent = root

	local resultsScale = Instance.new("UIScale")
	resultsScale.Parent = resultsFrame

	local _titleLabel = UIKit.Label({
		Text = "✨ SPARKLING CLEAN! ✨",
		Size = UDim2.new(1, -40, 0, 56),
		Position = UDim2.new(0, 20, 0, 18),
		TextSize = 40,
		TextXAlignment = Enum.TextXAlignment.Center,
		Parent = resultsFrame,
	})
	local timeLabel = UIKit.Label({
		Text = "",
		Size = UDim2.new(1, -40, 0, 28),
		Position = UDim2.new(0, 20, 0, 78),
		TextSize = 22,
		TextColor3 = Colors.TextDim,
		TextXAlignment = Enum.TextXAlignment.Center,
		Parent = resultsFrame,
	})
	local bestLabel = UIKit.Label({
		Text = "⭐ NEW BEST!",
		Size = UDim2.new(1, -40, 0, 26),
		Position = UDim2.new(0, 20, 0, 108),
		TextSize = 22,
		TextColor3 = Colors.Good,
		TextXAlignment = Enum.TextXAlignment.Center,
		Visible = false,
		Parent = resultsFrame,
	})

	local bubblesRow = Instance.new("Frame")
	bubblesRow.BackgroundTransparency = 1
	bubblesRow.Size = UDim2.new(1, -40, 0, 46)
	bubblesRow.Position = UDim2.new(0, 20, 0, 138)
	bubblesRow.Parent = resultsFrame
	local bubblesRowLayout = Instance.new("UIListLayout")
	bubblesRowLayout.FillDirection = Enum.FillDirection.Horizontal
	bubblesRowLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	bubblesRowLayout.VerticalAlignment = Enum.VerticalAlignment.Center
	bubblesRowLayout.Padding = UDim.new(0, 8)
	bubblesRowLayout.Parent = bubblesRow
	UIKit.Label({ Text = "🧼", TextSize = 34, Size = UDim2.fromOffset(40, 40), Parent = bubblesRow })
	local resultsBubblesLabel = UIKit.Label({
		Text = "+0",
		TextSize = 34,
		TextColor3 = Colors.Bubble,
		Size = UDim2.fromOffset(200, 40),
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = bubblesRow,
	})
	local resultsBubblesNV = Instance.new("NumberValue")
	resultsBubblesNV.Parent = resultsFrame
	resultsBubblesNV:GetPropertyChangedSignal("Value"):Connect(function()
		resultsBubblesLabel.Text = "+" .. UIKit.Commas(math.floor(resultsBubblesNV.Value + 0.5))
	end)
	local resultsBubblesShown = -1

	local unlockedLabel = UIKit.Label({
		Text = "",
		Size = UDim2.new(1, -40, 0, 26),
		Position = UDim2.new(0, 20, 0, 188),
		TextSize = 20,
		TextColor3 = Colors.Accent,
		TextXAlignment = Enum.TextXAlignment.Center,
		Visible = false,
		Parent = resultsFrame,
	})

	local headerRow = Instance.new("Frame")
	headerRow.BackgroundTransparency = 1
	headerRow.Size = UDim2.new(1, -40, 0, 24)
	headerRow.Position = UDim2.new(0, 20, 0, 222)
	headerRow.Parent = resultsFrame
	UIKit.Label({
		Text = "PLAYER",
		Size = UDim2.new(0.5, 0, 1, 0),
		TextSize = 16,
		TextColor3 = Colors.TextDim,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = headerRow,
	})
	UIKit.Label({
		Text = "CLEANED",
		Size = UDim2.new(0.25, 0, 1, 0),
		Position = UDim2.new(0.5, 0, 0, 0),
		TextSize = 16,
		TextColor3 = Colors.TextDim,
		TextXAlignment = Enum.TextXAlignment.Center,
		Parent = headerRow,
	})
	UIKit.Label({
		Text = "SHARE",
		Size = UDim2.new(0.25, 0, 1, 0),
		Position = UDim2.new(0.75, 0, 0, 0),
		TextSize = 16,
		TextColor3 = Colors.TextDim,
		TextXAlignment = Enum.TextXAlignment.Center,
		Parent = headerRow,
	})

	local scrollFrame = Instance.new("ScrollingFrame")
	scrollFrame.Name = "PlayerTable"
	scrollFrame.Size = UDim2.new(1, -40, 0, 190)
	scrollFrame.Position = UDim2.new(0, 20, 0, 250)
	scrollFrame.BackgroundTransparency = 1
	scrollFrame.BorderSizePixel = 0
	scrollFrame.ScrollBarThickness = 6
	scrollFrame.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scrollFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
	scrollFrame.Parent = resultsFrame
	local scrollLayout = Instance.new("UIListLayout")
	scrollLayout.SortOrder = Enum.SortOrder.LayoutOrder
	scrollLayout.Padding = UDim.new(0, 4)
	scrollLayout.Parent = scrollFrame

	local countdownLabel = UIKit.Label({
		Text = "",
		Size = UDim2.new(1, -40, 0, 24),
		Position = UDim2.new(0, 20, 1, -84),
		TextSize = 18,
		TextColor3 = Colors.TextDim,
		TextXAlignment = Enum.TextXAlignment.Center,
		Parent = resultsFrame,
	})

	UIKit.Button({
		Text = "Back to Lobby",
		Icon = "🚪",
		Size = UDim2.fromOffset(240, 54),
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -16),
		Color = Colors.Good,
		Parent = resultsFrame,
		OnClick = function()
			local result = ClientState.RunRequest("ReturnToLobby")
			if not result.Ok then
				UIKit.Toast(result.Error or "Couldn't return to the lobby.", "Bad")
			end
		end,
	})

	local function layoutResults()
		local canvas = UIKit.CanvasSize()
		local inset = UIKit.TopInset()
		local availW = canvas.X - 32
		local availH = canvas.Y - inset - 32
		local fit = math.clamp(math.min(availW / RESULTS_BASE.X, availH / RESULTS_BASE.Y), 0.4, 1)
		resultsScale.Scale = fit
		resultsFrame.Position = UDim2.new(0.5, 0, 0.5, math.floor(inset / 2))
	end

	local function refreshResults(run: Types.RunState)
		local results = run.Results
		if not results then
			return
		end
		local underParText = if results.UnderPar then "  🔥 Under par!" else ""
		timeLabel.Text = string.format(
			"⏱ %s   (Par %s)%s",
			UIKit.Time(results.TimeSeconds),
			UIKit.Time(results.ParTime),
			underParText
		)
		bestLabel.Visible = results.NewBest == true
		if results.NewBest then
			UIKit.Bounce(bestLabel)
		end
		if resultsBubblesShown ~= results.Bubbles then
			resultsBubblesShown = results.Bubbles
			resultsBubblesNV.Value = 0
			UIKit.Tween(resultsBubblesNV, { Value = results.Bubbles }, 0.8)
		end
		if results.UnlockedLevel then
			local unlocked = Config.GetLevel(results.UnlockedLevel)
			unlockedLabel.Text = string.format("🔓 %s unlocked!", tostring(unlocked.Name))
			unlockedLabel.Visible = true
		else
			unlockedLabel.Visible = false
		end

		for _, child in scrollFrame:GetChildren() do
			if child:IsA("Frame") then
				child:Destroy()
			end
		end
		for order, row in results.Players do
			local r = Instance.new("Frame")
			r.Name = "Row"
			r.BackgroundTransparency = 1
			r.Size = UDim2.new(1, 0, 0, 28)
			r.LayoutOrder = order
			UIKit.Label({
				Text = row.Name,
				Size = UDim2.new(0.5, 0, 1, 0),
				TextSize = 18,
				TextXAlignment = Enum.TextXAlignment.Left,
				Parent = r,
			})
			UIKit.Label({
				Text = tostring(row.Grime),
				Size = UDim2.new(0.25, 0, 1, 0),
				Position = UDim2.new(0.5, 0, 0, 0),
				TextSize = 18,
				TextXAlignment = Enum.TextXAlignment.Center,
				Parent = r,
			})
			UIKit.Label({
				Text = string.format("%d%%", math.floor(row.Share * 100 + 0.5)),
				Size = UDim2.new(0.25, 0, 1, 0),
				Position = UDim2.new(0.75, 0, 0, 0),
				TextSize = 18,
				TextXAlignment = Enum.TextXAlignment.Center,
				Parent = r,
			})
			r.Parent = scrollFrame
		end
	end

	--------------------------------------------------------------------------------------------------
	-- Leave confirmation.
	--------------------------------------------------------------------------------------------------
	local _leaveWindow, leaveContent = UIKit.Window({
		Name = "LeaveConfirm",
		Title = "Leave the Run?",
		Icon = "🚪",
		Size = Vector2.new(420, 220),
		Parent = root,
	})
	UIKit.RegisterWindow("LeaveConfirm", { Open = function() end, Close = function() end })

	UIKit.Label({
		Text = "Leave the run? You'll get no Bubbles.",
		Size = UDim2.new(1, 0, 0, 70),
		Position = UDim2.new(0, 0, 0, 6),
		TextSize = 20,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Center,
		Parent = leaveContent,
	})
	local leaveButtonsRow = Instance.new("Frame")
	leaveButtonsRow.BackgroundTransparency = 1
	leaveButtonsRow.Size = UDim2.new(1, 0, 0, 54)
	leaveButtonsRow.Position = UDim2.new(0, 0, 1, -70)
	leaveButtonsRow.Parent = leaveContent
	local leaveButtonsLayout = Instance.new("UIListLayout")
	leaveButtonsLayout.FillDirection = Enum.FillDirection.Horizontal
	leaveButtonsLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	leaveButtonsLayout.Padding = UDim.new(0, 16)
	leaveButtonsLayout.Parent = leaveButtonsRow
	UIKit.Button({
		Text = "Cancel",
		Color = Colors.Primary,
		Size = UDim2.fromOffset(150, 50),
		Parent = leaveButtonsRow,
		OnClick = function()
			UIKit.CloseWindow("LeaveConfirm")
		end,
	})
	UIKit.Button({
		Text = "Leave",
		Color = Colors.Bad,
		Size = UDim2.fromOffset(150, 50),
		Parent = leaveButtonsRow,
		OnClick = function()
			UIKit.CloseWindow("LeaveConfirm")
			local result = ClientState.RunRequest("Leave")
			if not result.Ok then
				UIKit.Toast(result.Error or "Couldn't leave the run.", "Bad")
			end
		end,
	})

	--------------------------------------------------------------------------------------------------
	-- Arena progress (Cleaned/Total), read live off the arena Model with a RunState fallback.
	--------------------------------------------------------------------------------------------------
	local arenaConnections: { RBXScriptConnection } = {}
	local watchedArena: Model? = nil
	local arenaWatchToken = 0

	local function updateProgress()
		local run = ClientState.Run :: Types.RunState?
		if not run then
			return
		end
		local cleaned, total = nil, nil
		local arena = watchedArena
		if arena and arena.Parent then
			local c, t = arena:GetAttribute("Cleaned"), arena:GetAttribute("Total")
			if typeof(c) == "number" and typeof(t) == "number" then
				cleaned, total = c, t
			end
		end
		if not (cleaned and total and total &gt; 0) then
			cleaned, total = run.Cleaned, run.Total
		end
		total = math.max(total or 0, 1)
		cleaned = math.clamp(cleaned or 0, 0, total)
		local pct = math.floor(cleaned / total * 100 + 0.5)
		progressBar.Set(cleaned / total, string.format("Dishwasher %d%% clean", pct))
	end

	local function clearArenaWatch()
		for _, c in arenaConnections do
			c:Disconnect()
		end
		table.clear(arenaConnections)
		watchedArena = nil
	end

	-- The arena may not have replicated to the client yet when RunState arrives, so this retries
	-- for a few seconds instead of giving up after one failed ClientState.GetArena() call.
	local function refreshArenaWatch()
		arenaWatchToken += 1
		local token = arenaWatchToken
		clearArenaWatch()
		if not ClientState.Run then
			return
		end
		task.spawn(function()
			for _ = 1, 30 do
				if token ~= arenaWatchToken then
					return
				end
				local arena = ClientState.GetArena()
				if arena then
					watchedArena = arena
					table.insert(arenaConnections, arena:GetAttributeChangedSignal("Cleaned"):Connect(updateProgress))
					table.insert(arenaConnections, arena:GetAttributeChangedSignal("Total"):Connect(updateProgress))
					updateProgress()
					return
				end
				task.wait(0.5)
			end
		end)
	end

	--------------------------------------------------------------------------------------------------
	-- Mode switching + value refresh.
	--------------------------------------------------------------------------------------------------
	local lastBannerStartedAt: number? = nil

	local function updateCurrencyValues()
		local run = ClientState.Run :: Types.RunState?
		if run then
			setCoins(run.Coins)
		end
		local meta = ClientState.Meta :: Types.MetaState?
		local bubbles = if meta then meta.Bubbles else (LocalPlayer:GetAttribute("Bubbles") :: number?) or 0
		setBubbles(bubbles)
		setGems(if meta then meta.Gems or 0 else 0)
	end

	local function refreshMode()
		local run = ClientState.Run :: Types.RunState?
		local inRun = run ~= nil
		local playing = run ~= nil and run.Phase == "Playing"
		local complete = run ~= nil and run.Phase == "Complete"

		moneyBlock.Visible = playing
		timerLabel.Visible = playing
		topBar.Visible = playing

		-- The Shop is always there (Robux items work in a run too); Ranks only in the lobby.
		shopButton.Visible = true
		upgradesButton.Visible = inRun
		leaveButton.Visible = inRun
		ranksButton.Visible = not inRun
		upgradesButton.LayoutOrder = 1
		shopButton.LayoutOrder = 2
		petsButton.LayoutOrder = 3
		ranksButton.LayoutOrder = 4
		leaveButton.LayoutOrder = 5
		plusButton.Visible = true
		hotbar.Visible = playing
		local key = hotbarKey()
		if key ~= lastHotbarKey then
			lastHotbarKey = key
			refreshHotbar()
		end
		-- In a run Tab opens the Upgrade Book, so the player list (also on Tab) steps aside.
		pcall(function()
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, not inRun)
		end)

		if playing and run then
			local level = Config.GetLevel(run.Level)
			levelLabel.Text = string.format("%s %s", tostring(level.Icon), tostring(level.Name))
			local full = run.Tank &gt;= run.TankMax and run.TankMax &gt; 0
			setTankFull(full)
			tankBar.Set(
				if run.TankMax &gt; 0 then run.Tank / run.TankMax else 0,
				if full then "💧 FULL! Sell at the drain" else string.format("💧 %s / %s", UIKit.Short(run.Tank), UIKit.Short(run.TankMax))
			)
			updateProgress()
		else
			setTankFull(false)
		end

		if complete and run and run.Results then
			layoutResults()
			resultsFrame.Visible = true
			refreshResults(run)
		else
			resultsFrame.Visible = false
		end

		if not run then
			lastBannerStartedAt = nil
			resultsBubblesShown = -1
			coinsShown = -1
		end
	end

	local function checkRunStartBanner()
		local run = ClientState.Run :: Types.RunState?
		if run and run.Phase == "Playing" then
			if lastBannerStartedAt ~= run.StartedAt then
				lastBannerStartedAt = run.StartedAt
				showRunStartBanner(run.Level)
			end
		end
	end

	--------------------------------------------------------------------------------------------------
	-- Wiring: ClientState, UIKit.LayoutChanged, a slow tick for the timer/countdown, and shortcuts.
	--------------------------------------------------------------------------------------------------
	ClientState.Changed:Connect(function(kind: string)
		if kind == "Run" then
			refreshMode()
			updateCurrencyValues()
			refreshArenaWatch()
			checkRunStartBanner()
		elseif kind == "Meta" then
			updateCurrencyValues()
		end
	end)

	LocalPlayer:GetAttributeChangedSignal("Bubbles"):Connect(function()
		if not ClientState.Meta then
			updateCurrencyValues()
		end
	end)

	UIKit.LayoutChanged:Connect(function()
		relayoutTopBar()
		relayoutBanner()
		if resultsFrame.Visible then
			layoutResults()
		end
	end)

	-- One slow loop drives the run timer and the results countdown; both are cheap 2Hz text updates.
	task.spawn(function()
		while true do
			local run = ClientState.Run :: Types.RunState?
			if run then
				if run.Phase == "Playing" then
					local t = math.max(0, math.floor(Util.Now() - run.StartedAt))
					timerLabel.Text = string.format("%02d:%02d:%02d", t // 3600, (t % 3600) // 60, t % 60)
				elseif run.Phase == "Complete" and run.Results then
					local remaining = math.max(0, run.Results.ReturnAt - Util.Now())
					countdownLabel.Text = string.format("Returning to lobby in %ds", math.ceil(remaining))
				end
			end
			task.wait(0.5)
		end
	end)

	UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
		if UserInputService:GetFocusedTextBox() ~= nil then
			return
		end
		local key = input.KeyCode
		local inRun = ClientState.Run ~= nil
		-- Roblox's player list marks Tab as processed, so Tab (and gamepad Y) skip that check.
		if processed and not (inRun and key == Enum.KeyCode.Tab) and key ~= Enum.KeyCode.ButtonY then
			return
		end
		if (key == Enum.KeyCode.Q or key == Enum.KeyCode.Tab) and inRun then
			UIKit.ToggleWindow("Upgrades")
		elseif key == Enum.KeyCode.P or key == Enum.KeyCode.ButtonL1 then
			UIKit.ToggleWindow("Pets")
		elseif key == Enum.KeyCode.G and not inRun then
			UIKit.ToggleWindow("Shop")
		elseif key == Enum.KeyCode.ButtonY then
			UIKit.ToggleWindow(if inRun then "Upgrades" else "Shop")
		elseif (key == Enum.KeyCode.R or key == Enum.KeyCode.ButtonR1) and not inRun then
			UIKit.ToggleWindow("Ranks")
		elseif inRun and (key == Enum.KeyCode.DPadLeft or key == Enum.KeyCode.DPadRight) then
			local run = ClientState.Run :: Types.RunState?
			if run and run.OwnedTools then
				local step = if key == Enum.KeyCode.DPadRight then 1 else -1
				local n = #Config.Tools
				local i = run.ToolIndex
				for _ = 1, n do
					i = ((i - 1 + step) % n) + 1
					if run.OwnedTools[i] then
						task.spawn(equipTool, i)
						break
					end
				end
			end
		elseif inRun then
			local numbers = { Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three, Enum.KeyCode.Four, Enum.KeyCode.Five, Enum.KeyCode.Six }
			local index = table.find(numbers, key)
			if index and Config.Tools[index] then
				task.spawn(equipTool, index)
			end
		end
	end)

	relayoutTopBar()
	relayoutBanner()
	refreshMode()
	updateCurrencyValues()
	refreshArenaWatch()
	checkRunStartBanner()
end

return HUD</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000021"><Properties><string name="Name">PartyUI</string><ProtectedString name="Source">--[[
	PartyUI - everything shown while ClientState.Party ~= nil (standing in a lobby pad).

	Two screens, Search-for-the-Needle style:
	  * Create Party (host, Status == "Picking"): a big card for the chosen dishwasher with
	    Public/Friends, Party Size -/+ and CREATE, a list of every dishwasher on the right, and BACK
	    underneath. Nothing is sent until CREATE (PartyAction "Create" { Level, MaxPlayers, Privacy });
	    BACK sends "Leave".
	  * Waiting card (everyone, Status == "Waiting"/"Launching"): a compact card at the top right with
	    the dishwasher, "2/4", "Teleporting in 12", member avatars, and [Start] (host) / [Leave].

	Works with mouse, touch and gamepad: the Create screen selects CREATE for gamepads, and B backs out.
	The server validates and rate-limits every PartyAction.
]]

local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Types = require(Shared:WaitForChild("Types"))

local Client = script.Parent
local ClientState = require(Client:WaitForChild("ClientState"))
local UIKit = require(Client:WaitForChild("UIKit"))

local Colors = UIKit.Theme.Colors

local PartyUI = {}

local CREATE_SIZE = Vector2.new(940, 600)
local WAIT_WIDTH = 300
local RIGHT_COLUMN_CLEARANCE = 132 -- the HUD's right-hand button column

local initialized = false

local root: Frame
local createScreen: Frame
local createScale: UIScale
local leftCard: Frame
local levelList: ScrollingFrame
local waitCard: Frame
local waitContent: Frame
local waitStatus: TextLabel? = nil
local createButton: TextButton? = nil

-- Create-screen selections (local until CREATE is pressed).
local selLevel = 1
local selMax = Config.Party.MaxPlayers
local selPrivacy = "Public"
local wasPicking = false

----------------------------------------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------------------------------------

local thumbCache: { [number]: string } = {}
local thumbPending: { [number]: boolean } = {}

local function fetchThumbnail(userId: number, onReady: (content: string) -&gt; ())
	local cached = thumbCache[userId]
	if cached then
		onReady(cached)
		return
	end
	if thumbPending[userId] then
		return
	end
	thumbPending[userId] = true
	task.spawn(function()
		local ok, content = pcall(function()
			return Players:GetUserThumbnailAsync(userId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
		end)
		thumbPending[userId] = nil
		if ok and type(content) == "string" and content ~= "" then
			thumbCache[userId] = content
			onReady(content)
		end
	end)
end

local function sendPartyAction(action: string, value: any?)
	local ok, err = pcall(function()
		Remotes.Event("PartyAction"):FireServer(action, value)
	end)
	if not ok then
		warn("[PartyUI] PartyAction failed: " .. tostring(err))
	end
end

local function unlocked(): number
	local party = ClientState.Party :: Types.PartyState?
	if party then
		return math.max(1, party.HostUnlocked)
	end
	local meta = ClientState.Meta :: Types.MetaState?
	return if meta then meta.Unlocked else 1
end

local function bestTime(levelIndex: number): number?
	local meta = ClientState.Meta :: Types.MetaState?
	local t = meta and meta.BestTimes[levelIndex]
	return if t and t &gt; 0 then t else nil
end

-- "Map thumbnail" art for a dishwasher: a gradient in its theme colours, a big food icon, and a few
-- bubbles. Built from UI only (no uploaded images).
local function levelArt(parent: Instance, levelIndex: number, size: UDim2, iconSize: number, locked: boolean): Frame
	local level = Config.GetLevel(levelIndex)
	local art = Instance.new("Frame")
	art.Name = "Art"
	art.Size = size
	art.BackgroundColor3 = Color3.new(1, 1, 1)
	art.BorderSizePixel = 0
	art.ClipsDescendants = true
	UIKit.Corner(art, 14)
	UIKit.Gradient(art, UIKit.Lighten(level.Theme.Accent, 0.25), UIKit.Darken(level.Theme.Accent, 0.35))
	for i = 1, 6 do
		local b = Instance.new("Frame")
		local d = 14 + (i * 37) % 30
		b.Size = UDim2.fromOffset(d, d)
		b.Position = UDim2.new((i * 0.173) % 1, 0, (i * 0.311) % 1, 0)
		b.BackgroundColor3 = Color3.new(1, 1, 1)
		b.BackgroundTransparency = 0.75
		UIKit.Corner(b, 999)
		b.Parent = art
	end
	UIKit.Label({
		Text = if locked then "🔒" else level.Icon,
		TextSize = iconSize,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		Stroke = false,
		Parent = art,
	})
	if locked then
		art.BackgroundColor3 = Color3.fromRGB(120, 125, 135)
	end
	art.Parent = parent
	return art
end

local function listLayout(parent: Instance, dir: Enum.FillDirection, pad: number, hAlign: Enum.HorizontalAlignment?): UIListLayout
	local l = Instance.new("UIListLayout")
	l.SortOrder = Enum.SortOrder.LayoutOrder
	l.FillDirection = dir
	l.Padding = UDim.new(0, pad)
	l.HorizontalAlignment = hAlign or Enum.HorizontalAlignment.Center
	-- Scrolling lists must be top-aligned: a centred list taller than its frame spills above the
	-- top, where it can't be scrolled to (that's what cut off the first dishwasher card).
	l.VerticalAlignment = if parent:IsA("ScrollingFrame") then Enum.VerticalAlignment.Top else Enum.VerticalAlignment.Center
	l.Parent = parent
	return l
end

local function panel(parent: Instance, size: UDim2): Frame
	local f = Instance.new("Frame")
	f.Size = size
	f.BackgroundColor3 = Color3.new(1, 1, 1)
	f.BorderSizePixel = 0
	UIKit.Corner(f, 18)
	UIKit.Gradient(f, Colors.Panel, Colors.PanelDark)
	UIKit.Stroke(f, Colors.Ink, 3)
	f.Parent = parent
	return f
end

----------------------------------------------------------------------------------------------------
-- Create Party screen
----------------------------------------------------------------------------------------------------

local renderCreate: () -&gt; ()

local function renderLevelList()
	for _, child in levelList:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	local maxUnlocked = unlocked()
	for i, level in Config.Levels do
		local locked = i &gt; maxUnlocked
		local selected = i == selLevel
		local card = Instance.new("TextButton")
		card.Name = "Level" .. i
		card.LayoutOrder = i
		card.Size = UDim2.new(1, -8, 0, 112)
		card.AutoButtonColor = false
		card.Text = ""
		card.BackgroundTransparency = 1
		card.SelectionImageObject = nil
		card.Parent = levelList
		local art = levelArt(card, i, UDim2.fromScale(1, 1), 54, locked)
		local stroke = UIKit.Stroke(art, if selected then Color3.new(1, 1, 1) else Colors.Ink, if selected then 4 else 2)
		stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		UIKit.Label({
			Text = string.upper(level.Name),
			TextSize = 24,
			AnchorPoint = Vector2.new(1, 1),
			Position = UDim2.new(1, -10, 1, -6),
			Size = UDim2.new(1, -20, 0, 30),
			TextXAlignment = Enum.TextXAlignment.Right,
			TextScaled = true,
			Parent = art,
		})
		local best = bestTime(i)
		UIKit.Label({
			Text = if locked then string.format("Clear %s to unlock", Config.GetLevel(i - 1).Name) elseif best then "⏱️ Best " .. UIKit.Time(best) else "Not cleared yet",
			TextSize = 15,
			Position = UDim2.fromOffset(10, 6),
			Size = UDim2.new(1, -20, 0, 20),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = Color3.fromRGB(235, 240, 250),
			Parent = art,
		})
		card.Activated:Connect(function()
			if locked then
				UIKit.PlaySound("Error")
				UIKit.Toast("🔒 Clear " .. Config.GetLevel(i - 1).Name .. " first!", "Bad")
				return
			end
			UIKit.PlaySound("Click")
			selLevel = i
			renderCreate()
		end)
	end
end

function renderCreate()
	for _, child in leftCard:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	local level = Config.GetLevel(selLevel)

	local art = levelArt(leftCard, selLevel, UDim2.new(1, -24, 0, 190), 110, false)
	art.Position = UDim2.fromOffset(12, 12)
	UIKit.Label({
		Text = string.upper(level.Name),
		TextSize = 44,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 208),
		Size = UDim2.new(1, -24, 0, 50),
		TextScaled = true,
		Parent = leftCard,
	})
	UIKit.Label({
		Text = "CREATE PARTY",
		TextSize = 26,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 254),
		Size = UDim2.new(1, -24, 0, 32),
		Parent = leftCard,
	})
	local divider = Instance.new("Frame")
	divider.Size = UDim2.new(0.8, 0, 0, 3)
	divider.AnchorPoint = Vector2.new(0.5, 0)
	divider.Position = UDim2.new(0.5, 0, 0, 288)
	divider.BackgroundColor3 = Color3.new(1, 1, 1)
	divider.BorderSizePixel = 0
	divider.Parent = leftCard

	-- Public / Friends.
	local privacyRow = Instance.new("Frame")
	privacyRow.BackgroundTransparency = 1
	privacyRow.AnchorPoint = Vector2.new(0.5, 0)
	privacyRow.Position = UDim2.new(0.5, 0, 0, 298)
	privacyRow.Size = UDim2.new(1, -24, 0, 50)
	privacyRow.Parent = leftCard
	listLayout(privacyRow, Enum.FillDirection.Horizontal, 10)
	for _, option in { { "Public", "🌐 PUBLIC", Colors.Primary }, { "Friends", "👥 FRIENDS", Colors.Accent } } do
		local key = option[1]
		UIKit.Button({
			Text = option[2],
			Size = UDim2.fromOffset(180, 46),
			Color = if selPrivacy == key then option[3] else Colors.Disabled,
			TextSize = 22,
			Parent = privacyRow,
			OnClick = function()
				selPrivacy = key
				renderCreate()
			end,
		})
	end

	-- Party size.
	UIKit.Label({
		Text = "Party Size:",
		TextSize = 28,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 350),
		Size = UDim2.new(1, -24, 0, 32),
		Parent = leftCard,
	})
	local sizeRow = Instance.new("Frame")
	sizeRow.BackgroundTransparency = 1
	sizeRow.AnchorPoint = Vector2.new(0.5, 0)
	sizeRow.Position = UDim2.new(0.5, 0, 0, 382)
	sizeRow.Size = UDim2.new(1, -24, 0, 52)
	sizeRow.Parent = leftCard
	listLayout(sizeRow, Enum.FillDirection.Horizontal, 16)
	UIKit.Button({
		Text = "−",
		Size = UDim2.fromOffset(60, 50),
		Color = Colors.PanelLight,
		Disabled = selMax &lt;= 1,
		LayoutOrder = 1,
		Parent = sizeRow,
		OnClick = function()
			selMax = math.max(1, selMax - 1)
			renderCreate()
		end,
	})
	local count = UIKit.Card({ Size = UDim2.fromOffset(70, 50), LayoutOrder = 2, Parent = sizeRow })
	UIKit.Label({ Text = tostring(selMax), TextSize = 36, Size = UDim2.fromScale(1, 1), Parent = count })
	UIKit.Button({
		Text = "+",
		Size = UDim2.fromOffset(60, 50),
		Color = Colors.PanelLight,
		Disabled = selMax &gt;= Config.Party.MaxPlayers,
		LayoutOrder = 3,
		Parent = sizeRow,
		OnClick = function()
			selMax = math.min(Config.Party.MaxPlayers, selMax + 1)
			renderCreate()
		end,
	})

	createButton = UIKit.Button({
		Name = "Create",
		Text = "CREATE",
		Size = UDim2.fromOffset(300, 60),
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -14),
		Color = Colors.Good,
		TextSize = 32,
		Parent = leftCard,
		OnClick = function()
			sendPartyAction("Create", { Level = selLevel, MaxPlayers = selMax, Privacy = selPrivacy })
		end,
	})

	renderLevelList()
	if UIKit.IsGamepad() and createButton then
		GuiService.SelectedObject = createButton
	end
end

local function layoutCreate()
	local canvas = UIKit.CanvasSize()
	local inset = UIKit.TopInset()
	local fit = math.clamp(math.min((canvas.X - 24) / CREATE_SIZE.X, (canvas.Y - inset - 24) / CREATE_SIZE.Y), 0.4, 1)
	createScale.Scale = fit
	createScreen.Position = UDim2.new(0.5, 0, 0.5, math.floor(inset / 2))
end

local function buildCreateScreen()
	createScreen = Instance.new("Frame")
	createScreen.Name = "CreateParty"
	createScreen.AnchorPoint = Vector2.new(0.5, 0.5)
	createScreen.Size = UDim2.fromOffset(CREATE_SIZE.X, CREATE_SIZE.Y)
	createScreen.BackgroundTransparency = 1
	createScreen.Visible = false
	createScreen.ZIndex = 20
	createScreen.Parent = root
	createScale = Instance.new("UIScale")
	createScale.Parent = createScreen

	leftCard = panel(createScreen, UDim2.fromOffset(540, 520))
	leftCard.Name = "Selected"

	local right = panel(createScreen, UDim2.fromOffset(380, 520))
	right.Name = "Dishwashers"
	right.Position = UDim2.fromOffset(560, 0)
	UIKit.Label({
		Text = "DISHWASHERS",
		TextSize = 26,
		Position = UDim2.fromOffset(0, 10),
		Size = UDim2.new(1, 0, 0, 30),
		Parent = right,
	})
	levelList = Instance.new("ScrollingFrame")
	levelList.Name = "List"
	levelList.Position = UDim2.fromOffset(12, 48)
	levelList.Size = UDim2.new(1, -18, 1, -60)
	levelList.BackgroundTransparency = 1
	levelList.BorderSizePixel = 0
	levelList.ScrollBarThickness = 6
	levelList.AutomaticCanvasSize = Enum.AutomaticSize.Y
	levelList.CanvasSize = UDim2.new()
	levelList.Parent = right
	listLayout(levelList, Enum.FillDirection.Vertical, 10, Enum.HorizontalAlignment.Left)
	local listPad = Instance.new("UIPadding")
	listPad.PaddingTop = UDim.new(0, 8)
	listPad.PaddingBottom = UDim.new(0, 8)
	listPad.PaddingLeft = UDim.new(0, 6)
	listPad.PaddingRight = UDim.new(0, 6)
	listPad.Parent = levelList

	UIKit.Button({
		Text = "BACK",
		Size = UDim2.fromOffset(200, 56),
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0, 270, 1, 0),
		Color = Colors.Bad,
		TextSize = 30,
		Parent = createScreen,
		OnClick = function()
			sendPartyAction("Leave", nil)
		end,
	})
end

----------------------------------------------------------------------------------------------------
-- Waiting card
----------------------------------------------------------------------------------------------------

local function renderWait(party: Types.PartyState)
	for _, child in waitContent:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	local level = Config.GetLevel(party.Level)
	local launching = party.Status == "Launching"

	local art = levelArt(waitContent, party.Level, UDim2.new(1, 0, 0, 110), 64, false)
	art.LayoutOrder = 1
	UIKit.Label({
		Text = string.upper(level.Name),
		TextSize = 22,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -4),
		Size = UDim2.new(1, -12, 0, 26),
		TextScaled = true,
		Parent = art,
	})
	UIKit.Label({
		Text = if party.Privacy == "Public" then "🌐" else "👥",
		TextSize = 20,
		Position = UDim2.fromOffset(6, 4),
		Size = UDim2.fromOffset(26, 26),
		Parent = art,
	})

	UIKit.Label({
		Text = string.format("%d/%d", #party.Members, party.MaxPlayers),
		TextSize = 54,
		Size = UDim2.new(1, 0, 0, 58),
		LayoutOrder = 2,
		Parent = waitContent,
	})
	local status = UIKit.Label({
		Text = if launching then "Teleporting... 🧼" else "",
		TextSize = 24,
		Size = UDim2.new(1, 0, 0, 30),
		TextColor3 = if launching then Colors.Good else Colors.Text,
		LayoutOrder = 3,
		Parent = waitContent,
	})
	waitStatus = if launching then nil else status

	local avatars = Instance.new("Frame")
	avatars.BackgroundTransparency = 1
	avatars.Size = UDim2.new(1, 0, 0, 46)
	avatars.LayoutOrder = 4
	avatars.Parent = waitContent
	listLayout(avatars, Enum.FillDirection.Horizontal, 6)
	for _, member in party.Members do
		local isHost = member.UserId == party.HostUserId
		local img = UIKit.New("ImageLabel", {
			Size = UDim2.fromOffset(42, 42),
			BackgroundColor3 = Colors.PanelLight,
			ScaleType = Enum.ScaleType.Crop,
			Parent = avatars,
		}) :: ImageLabel
		UIKit.Corner(img, 999)
		UIKit.Stroke(img, if isHost then Colors.Coin else Colors.Ink, if isHost then 3 else 2)
		fetchThumbnail(member.UserId, function(image)
			if img.Parent then
				img.Image = image
			end
		end)
	end

	local buttons = Instance.new("Frame")
	buttons.BackgroundTransparency = 1
	buttons.Size = UDim2.new(1, 0, 0, 48)
	buttons.LayoutOrder = 5
	buttons.Parent = waitContent
	listLayout(buttons, Enum.FillDirection.Horizontal, 10)
	if party.IsHost then
		UIKit.Button({
			Text = "START",
			Size = UDim2.fromOffset(130, 44),
			Color = Colors.Good,
			Disabled = launching,
			Parent = buttons,
			OnClick = function()
				sendPartyAction("StartNow", nil)
			end,
		})
	end
	UIKit.Button({
		Text = "LEAVE",
		Size = UDim2.fromOffset(130, 44),
		Color = Colors.Bad,
		Disabled = launching,
		Parent = buttons,
		OnClick = function()
			sendPartyAction("Leave", nil)
		end,
	})
	if waitStatus then
		local remaining = math.max(0, math.ceil(party.EndsAt - workspace:GetServerTimeNow()))
		waitStatus.Text = string.format("Teleporting in %d", remaining)
	end
end

local function buildWaitCard()
	waitCard = panel(root, UDim2.fromOffset(WAIT_WIDTH, 0))
	waitCard.Name = "PartyWaiting"
	waitCard.AnchorPoint = Vector2.new(1, 0)
	waitCard.AutomaticSize = Enum.AutomaticSize.Y
	waitCard.Visible = false
	waitCard.ZIndex = 10
	waitContent = Instance.new("Frame")
	waitContent.BackgroundTransparency = 1
	waitContent.Size = UDim2.new(1, 0, 0, 0)
	waitContent.AutomaticSize = Enum.AutomaticSize.Y
	waitContent.Parent = waitCard
	UIKit.Padding(waitContent, 12)
	listLayout(waitContent, Enum.FillDirection.Vertical, 6)
end

local function layoutWait()
	local safe = UIKit.SafeInsets()
	waitCard.Position = UDim2.new(1, -(RIGHT_COLUMN_CLEARANCE + safe.Right), 0, UIKit.TopInset() + 90)
end

----------------------------------------------------------------------------------------------------
-- Render
----------------------------------------------------------------------------------------------------

local function render()
	local party = ClientState.Party :: Types.PartyState?
	local picking = party ~= nil and party.Status == "Picking" and party.IsHost
	if picking and not wasPicking and party then
		-- Fresh Create screen: start from the server's defaults (their best dishwasher).
		selLevel = math.clamp(party.Level, 1, unlocked())
		selMax = party.MaxPlayers
		selPrivacy = party.Privacy
		UIKit.CloseWindow()
	end
	wasPicking = picking

	createScreen.Visible = picking
	if picking then
		layoutCreate()
		renderCreate()
	elseif GuiService.SelectedObject and GuiService.SelectedObject:IsDescendantOf(createScreen) then
		GuiService.SelectedObject = nil
	end

	local waiting = party ~= nil and not picking
	waitCard.Visible = waiting
	if waiting and party then
		layoutWait()
		renderWait(party)
	else
		waitStatus = nil
	end
end

local function countdownLoop()
	while true do
		local party = ClientState.Party
		if party and party.Status == "Waiting" and waitStatus and waitStatus.Parent then
			local remaining = math.max(0, math.ceil(party.EndsAt - workspace:GetServerTimeNow()))
			waitStatus.Text = string.format("Teleporting in %d", remaining)
			task.wait(0.1)
		else
			task.wait(0.5)
		end
	end
end

function PartyUI.Init()
	if initialized then
		return
	end
	initialized = true

	local _gui, r = UIKit.CreateScreen("PartyUI", 8)
	root = r
	buildCreateScreen()
	buildWaitCard()

	UIKit.LayoutChanged:Connect(function()
		if createScreen.Visible then
			layoutCreate()
		end
		if waitCard.Visible then
			layoutWait()
		end
	end)

	ClientState.Changed:Connect(function(kind)
		if kind == "Party" or (kind == "Meta" and createScreen.Visible) then
			render()
		end
	end)

	-- B on a gamepad (or Backspace) backs out of the Create screen, like the BACK button.
	UserInputService.InputBegan:Connect(function(input, processed)
		if not createScreen.Visible then
			return
		end
		if input.KeyCode == Enum.KeyCode.ButtonB or (not processed and input.KeyCode == Enum.KeyCode.Backspace) then
			sendPartyAction("Leave", nil)
		end
	end)

	render()
	task.spawn(countdownLoop)
end

return PartyUI</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000022"><Properties><string name="Name">PetRenderer</string><ProtectedString name="Source">-- PetRenderer: client-side visuals for every player's equipped pets. The server only replicates
-- state (EquippedPets/&lt;slot&gt; StringValue = pet id, its Target ObjectValue = the grime part being
-- cleaned); this module is the only thing that actually builds and moves pet models. See
-- DESIGN.md section 6 ("PetRenderer") and section 4 ("Equipped pets for rendering").
--
--   * One local Folder, workspace.ClientPets, holds every model this client has built (for every
--     player, including the local one).
--   * A single RunService.RenderStepped connection drives every pet every frame; per-player /
--     per-slot state lives in `owners`, cleaned up on PlayerRemoving, folder/slot removal, or the
--     model failing to exist.
--   * Hovering over a live grime part takes priority; otherwise the pet holds a formation slot
--     behind its owner. Both cases are just a target CFrame that GetPivot() lerps toward.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local PetModels = require(Shared:WaitForChild("PetModels"))

local PetRenderer = {}

----------------------------------------------------------------------------------------------------
-- Tuning
----------------------------------------------------------------------------------------------------

local HOVER_OFFSET = 2.5 -- studs off the grime part along its surface normal (XVector, per DESIGN)
local FORMATION_MIN_DIST = 5
local FORMATION_MAX_DIST = 7
local FORMATION_ARC = math.rad(70) -- total angular spread of the formation, centred behind the owner
local BOB_SPEED = 3
local BOB_HEIGHT = 0.4
local LERP_RATE = 10 -- pivot:Lerp(target, 1 - exp(-LERP_RATE * dt))
local HIDE_DISTANCE = 400
local TILT_STRENGTH = 0.05
local MAX_TILT = math.rad(20)

----------------------------------------------------------------------------------------------------
-- State
----------------------------------------------------------------------------------------------------

type Slot = {
	Value: StringValue,
	Number: number, -- tonumber(Value.Name); used only to order the formation consistently
	Model: Model?,
	Target: BasePart?,
	Hidden: boolean?,
	LastPos: Vector3?,
	Conns: { RBXScriptConnection },
}

type OwnerState = {
	Player: Player,
	Folder: Folder,
	Slots: { [StringValue]: Slot },
	Conns: { RBXScriptConnection },
}

local initialized = false
local clientPetsFolder: Folder? = nil
local owners: { [Player]: OwnerState } = {}
-- Connections on the Player instance itself (waiting for EquippedPets to appear/disappear), kept
-- separate from OwnerState so they survive the folder coming and going.
local playerConns: { [Player]: { RBXScriptConnection } } = {}
local elapsed = 0

----------------------------------------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------------------------------------

local function ensureClientPetsFolder(): Folder
	if clientPetsFolder and clientPetsFolder.Parent then
		return clientPetsFolder
	end
	local existing = workspace:FindFirstChild("ClientPets")
	if existing and existing:IsA("Folder") then
		clientPetsFolder = existing
	else
		local folder = Instance.new("Folder")
		folder.Name = "ClientPets"
		folder.Parent = workspace
		clientPetsFolder = folder
	end
	return clientPetsFolder :: Folder
end

-- Local-only visibility toggle: cheap to call every frame, so instead we only touch parts when the
-- hidden state actually flips (LocalTransparencyModifier never replicates, so this doesn't affect
-- anyone else's view).
local function setHidden(slot: Slot, hidden: boolean)
	if slot.Hidden == hidden or not slot.Model then
		return
	end
	slot.Hidden = hidden
	for _, part in slot.Model:GetDescendants() do
		if part:IsA("BasePart") then
			part.LocalTransparencyModifier = if hidden then 1 else 0
		end
	end
end

-- A little pitch/roll based on how the pet is currently moving, so it doesn't glide like a robot.
local function applyTilt(pivot: CFrame, velocity: Vector3): CFrame
	local localVel = pivot:VectorToObjectSpace(velocity)
	local pitch = math.clamp(localVel.Z * TILT_STRENGTH, -MAX_TILT, MAX_TILT) -- moving forward (-Z) noses down
	local roll = math.clamp(-localVel.X * TILT_STRENGTH, -MAX_TILT, MAX_TILT)
	return pivot * CFrame.Angles(pitch, 0, roll)
end

----------------------------------------------------------------------------------------------------
-- Slot lifecycle
----------------------------------------------------------------------------------------------------

local function destroySlot(slot: Slot)
	for _, conn in slot.Conns do
		conn:Disconnect()
	end
	table.clear(slot.Conns)
	if slot.Model then
		slot.Model:Destroy()
		slot.Model = nil
	end
end

local function buildModel(slot: Slot, petId: string)
	if slot.Model then
		slot.Model:Destroy()
		slot.Model = nil
	end
	local ok, model = pcall(PetModels.Build, petId)
	if not ok or not model then
		return
	end
	-- Defensive: PetModels already builds with these off, but a client-only render model must never
	-- interact with anything physically, whatever the shared builder does.
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.Anchored = true
			part.CanCollide = false
			part.CanQuery = false
			part.CanTouch = false
		end
	end
	model.Parent = ensureClientPetsFolder()
	slot.Model = model
	slot.Hidden = nil -- force the next setHidden call to actually apply
	slot.LastPos = nil
end

local function hookTargetValue(slot: Slot, stringValue: StringValue)
	local targetValue = stringValue:FindFirstChild("Target")
	if not targetValue or not targetValue:IsA("ObjectValue") then
		-- The server may parent Target a moment after the slot itself; keep watching for it.
		local conn
		conn = stringValue.ChildAdded:Connect(function(child)
			if child.Name == "Target" and child:IsA("ObjectValue") then
				conn:Disconnect()
				local i = table.find(slot.Conns, conn)
				if i then
					table.remove(slot.Conns, i)
				end
				hookTargetValue(slot, stringValue)
			end
		end)
		table.insert(slot.Conns, conn)
		return
	end
	local target = targetValue.Value
	slot.Target = if typeof(target) == "Instance" and target:IsA("BasePart") then target else nil
	table.insert(
		slot.Conns,
		targetValue.Changed:Connect(function(value)
			slot.Target = if typeof(value) == "Instance" and value:IsA("BasePart") then value else nil
		end)
	)
end

local function addSlot(ownerState: OwnerState, stringValue: StringValue)
	if ownerState.Slots[stringValue] then
		return
	end
	local slot: Slot = {
		Value = stringValue,
		Number = tonumber(stringValue.Name) or 0,
		Model = nil,
		Target = nil,
		Hidden = nil,
		LastPos = nil,
		Conns = {},
	}
	ownerState.Slots[stringValue] = slot
	buildModel(slot, stringValue.Value)
	hookTargetValue(slot, stringValue)
	table.insert(
		slot.Conns,
		stringValue.Changed:Connect(function(newId)
			-- The pet in this slot was swapped in place (unequip + equip without the slot itself
			-- being removed). Rebuild the model; the Target watcher stays valid (same StringValue).
			buildModel(slot, newId)
		end)
	)
end

local function removeSlot(ownerState: OwnerState, stringValue: StringValue)
	local slot = ownerState.Slots[stringValue]
	if not slot then
		return
	end
	ownerState.Slots[stringValue] = nil
	destroySlot(slot)
end

----------------------------------------------------------------------------------------------------
-- Owner (player) lifecycle
----------------------------------------------------------------------------------------------------

local function cleanupOwner(player: Player)
	local ownerState = owners[player]
	if not ownerState then
		return
	end
	owners[player] = nil
	for _, conn in ownerState.Conns do
		conn:Disconnect()
	end
	for stringValue, slot in ownerState.Slots do
		destroySlot(slot)
	end
	table.clear(ownerState.Slots)
end

local function trackFolder(player: Player, folder: Folder)
	if owners[player] then
		return
	end
	local ownerState: OwnerState = {
		Player = player,
		Folder = folder,
		Slots = {},
		Conns = {},
	}
	owners[player] = ownerState

	for _, child in folder:GetChildren() do
		if child:IsA("StringValue") then
			addSlot(ownerState, child)
		end
	end
	table.insert(
		ownerState.Conns,
		folder.ChildAdded:Connect(function(child)
			if child:IsA("StringValue") then
				addSlot(ownerState, child)
			end
		end)
	)
	table.insert(
		ownerState.Conns,
		folder.ChildRemoved:Connect(function(child)
			if child:IsA("StringValue") then
				removeSlot(ownerState, child)
			end
		end)
	)
	table.insert(
		ownerState.Conns,
		folder.Destroying:Connect(function()
			cleanupOwner(player)
		end)
	)
end

local function trackPlayer(player: Player)
	if playerConns[player] then
		return
	end
	local conns: { RBXScriptConnection } = {}
	playerConns[player] = conns

	local existing = player:FindFirstChild("EquippedPets")
	if existing and existing:IsA("Folder") then
		trackFolder(player, existing)
	end
	table.insert(
		conns,
		player.ChildAdded:Connect(function(child)
			if child.Name == "EquippedPets" and child:IsA("Folder") then
				trackFolder(player, child)
			end
		end)
	)
	table.insert(
		conns,
		player.ChildRemoved:Connect(function(child)
			if child.Name == "EquippedPets" then
				cleanupOwner(player)
			end
		end)
	)
end

local function untrackPlayer(player: Player)
	cleanupOwner(player)
	local conns = playerConns[player]
	if conns then
		playerConns[player] = nil
		for _, conn in conns do
			conn:Disconnect()
		end
	end
end

----------------------------------------------------------------------------------------------------
-- Per-frame movement
----------------------------------------------------------------------------------------------------

-- Slots ordered by their StringValue name ("1", "2", ...) so the formation is stable frame to frame
-- even though `Slots` itself is a dictionary. Reused per owner per frame; small (&lt;= a handful).
local orderScratch: { Slot } = {}

local function updateOwner(ownerState: OwnerState, dt: number, camPos: Vector3)
	local player = ownerState.Player
	local character = player.Character
	local ownerRoot = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local ownerAlive = ownerRoot ~= nil and ownerRoot:IsA("BasePart") and humanoid ~= nil and humanoid.Health &gt; 0

	local farAway = false
	if ownerAlive then
		farAway = (camPos - (ownerRoot :: BasePart).Position).Magnitude &gt; HIDE_DISTANCE
	end
	local hideAll = (not ownerAlive) or farAway

	table.clear(orderScratch)
	for _, slot in ownerState.Slots do
		table.insert(orderScratch, slot)
	end
	table.sort(orderScratch, function(a, b)
		return a.Number &lt; b.Number
	end)
	local count = #orderScratch

	for i, slot in orderScratch do
		local model = slot.Model
		if not model or not model.Parent or not model.PrimaryPart then
			continue
		end
		setHidden(slot, hideAll)
		if hideAll then
			continue
		end

		local targetCFrame: CFrame? = nil
		local grime = slot.Target
		if grime and grime.Parent and grime:IsA("BasePart") then
			local ok, pos, cf = pcall(function()
				return grime.Position, grime.CFrame
			end)
			if ok then
				local hoverPos = pos + cf.XVector * HOVER_OFFSET
				targetCFrame = CFrame.lookAt(hoverPos, pos)
			end
		end

		if not targetCFrame then
			local root = ownerRoot :: BasePart
			local frac = if count &gt; 1 then (i - 1) / (count - 1) else 0.5
			local dist = FORMATION_MIN_DIST + (FORMATION_MAX_DIST - FORMATION_MIN_DIST) * frac
			local angle = (frac - 0.5) * FORMATION_ARC
			local bob = math.sin(elapsed * BOB_SPEED + i) * BOB_HEIGHT
			local localOffset = CFrame.Angles(0, angle, 0) * CFrame.new(0, 0, dist)
			local worldPos = (root.CFrame * localOffset).Position + Vector3.new(0, bob, 0)
			-- Face the same way as the owner (a sidekick formation), not rotated by the arc angle.
			targetCFrame = CFrame.new(worldPos) * (root.CFrame - root.CFrame.Position)
		end

		local current = model:GetPivot()
		local alpha = 1 - math.exp(-LERP_RATE * dt)
		local newPivot = current:Lerp(targetCFrame :: CFrame, alpha)

		if slot.LastPos and dt &gt; 1e-4 then
			local velocity = (newPivot.Position - slot.LastPos) / dt
			newPivot = applyTilt(newPivot, velocity)
		end
		slot.LastPos = newPivot.Position

		model:PivotTo(newPivot)
	end
end

local function onRenderStepped(dt: number)
	elapsed += dt
	local camera = workspace.CurrentCamera
	local camPos = if camera then camera.CFrame.Position else Vector3.zero
	for _, ownerState in owners do
		local ok, err = pcall(updateOwner, ownerState, dt, camPos)
		if not ok then
			warn("[PetRenderer] update failed: " .. tostring(err))
		end
	end
end

----------------------------------------------------------------------------------------------------
-- Init
----------------------------------------------------------------------------------------------------

function PetRenderer.Init()
	if initialized then
		return
	end
	initialized = true

	ensureClientPetsFolder()

	for _, player in Players:GetPlayers() do
		trackPlayer(player)
	end
	Players.PlayerAdded:Connect(trackPlayer)
	Players.PlayerRemoving:Connect(untrackPlayer)

	RunService.RenderStepped:Connect(onRenderStepped)
end

return PetRenderer</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000023"><Properties><string name="Name">PetsUI</string><ProtectedString name="Source">-- PetsUI: the "Pets" inventory window and the "Eggs" hatchery window, plus the full-screen hatch
-- reveal animation. Everything here is built with UIKit; see DESIGN.md section 6 ("PetsUI") for
-- the contract. Both windows rebuild their contents from ClientState.Meta whenever it changes and
-- the relevant window is open, so a purchase/hatch/equip anywhere refreshes what's on screen.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local PetModels = require(Shared:WaitForChild("PetModels"))
local Types = require(Shared:WaitForChild("Types"))

local Client = script.Parent
local ClientState = require(Client:WaitForChild("ClientState"))
local UIKit = require(Client:WaitForChild("UIKit"))

local PetsUI = {}

local C = UIKit.Theme.Colors

----------------------------------------------------------------------------------------------------
-- Small shared helpers
----------------------------------------------------------------------------------------------------

-- A safe pet definition even for an id that has left Config (kept in the profile, per DESIGN /
-- PetService "profile hygiene"), so the inventory never errors on a stale entry.
local PLACEHOLDER_DEF = { Name = "???", Rarity = "Common", PowerShare = 0, CoinBonus = 0 }
local function petDef(id: string)
	return Config.Pets[id] or PLACEHOLDER_DEF
end

local function rarityOrder(rarity: string): number
	local def = Config.Rarities[rarity]
	return (def and def.Order) or 0
end

-- meta.Pets sorted best-first: rarity, then PowerShare, then Uid (stable for equal stats).
local function sortedPetList(meta: Types.MetaState)
	local list = {}
	for _, entry in meta.Pets do
		table.insert(list, { Uid = entry.Uid, Id = entry.Id, Def = petDef(entry.Id) })
	end
	table.sort(list, function(a, b)
		local ra, rb = rarityOrder(a.Def.Rarity), rarityOrder(b.Def.Rarity)
		if ra ~= rb then
			return ra &gt; rb
		end
		if a.Def.PowerShare ~= b.Def.PowerShare then
			return a.Def.PowerShare &gt; b.Def.PowerShare
		end
		return a.Uid &lt; b.Uid
	end)
	return list
end

local function isEquipped(meta: Types.MetaState, uid: string): boolean
	return table.find(meta.Equipped, uid) ~= nil
end

-- "Cleans at 45% of your power" / "+12% coins" (DESIGN.md wording, exact).
local function powerShareText(share: number): string
	local pct = (Format.Percent(share):gsub("^%+", ""))
	return string.format("Cleans at %s of your power", pct)
end
local function coinBonusText(bonus: number): string
	return Format.Percent(bonus) .. " coins"
end

----------------------------------------------------------------------------------------------------
-- Module state
----------------------------------------------------------------------------------------------------

local initialized = false
local root: Frame

local petsContent: Frame
local eggsContent: Frame

-- Pets window
local gridScroll: ScrollingFrame
local equippedLabel: TextLabel
local countLabel: TextLabel
local detailEmpty: Frame
local detailFilled: Frame
local detailViewport: ViewportFrame
local detailName: TextLabel
local detailRarity: TextLabel
local detailPower: TextLabel
local detailCoin: TextLabel
local equipButton: TextButton
local deleteConfirmFrame: Frame
local selectedUid: string? = nil
local deleteToken = 0

-- Eggs window
local eggTabsHolder: Frame
local eggViewport: ViewportFrame
local eggNameLabel: TextLabel
local eggCostLabel: TextLabel
local eggLockedLabel: TextLabel
local oddsScroll: ScrollingFrame
local hatch1Button: TextButton
local hatch3Button: TextButton
local currentEggId: string? = nil

----------------------------------------------------------------------------------------------------
-- Pets window: grid + details panel
----------------------------------------------------------------------------------------------------

local GRID_CELL = Vector2.new(122, 156)
local GRID_GAP = 10

local function buildPetCard(parent: Instance, entry, equipped: boolean, onClick: (uid: string) -&gt; ())
	local card = UIKit.Card({
		Size = UDim2.fromOffset(GRID_CELL.X, GRID_CELL.Y),
		Color = C.PanelLight,
		StrokeColor = UIKit.RarityColor(entry.Def.Rarity),
		Parent = parent,
	})
	local stroke = card:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Thickness = 3
		stroke.Transparency = 0
	end

	-- Invisible hit surface. Not a UIKit.Button: we want the plain card look, not the chunky style.
	local hit = Instance.new("TextButton")
	hit.Name = "Hit"
	hit.BackgroundTransparency = 1
	hit.Text = ""
	hit.Size = UDim2.fromScale(1, 1)
	hit.ZIndex = 5
	hit.AutoButtonColor = false
	hit.Parent = card

	local viewport = UIKit.Viewport({
		Model = PetModels.Build(entry.Id),
		Size = UDim2.fromOffset(GRID_CELL.X - 16, 86),
		Position = UDim2.new(0.5, 0, 0, 6),
		AnchorPoint = Vector2.new(0.5, 0),
		Parent = card,
	})
	viewport.ZIndex = 1

	UIKit.Label({
		Text = entry.Def.Name,
		Size = UDim2.new(1, -10, 0, 20),
		Position = UDim2.new(0.5, 0, 0, 96),
		AnchorPoint = Vector2.new(0.5, 0),
		TextSize = 16,
		TextScaled = true,
		Parent = card,
		ZIndex = 2,
	})
	UIKit.Label({
		Text = entry.Def.Rarity,
		Size = UDim2.new(1, -10, 0, 16),
		Position = UDim2.new(0.5, 0, 0, 118),
		AnchorPoint = Vector2.new(0.5, 0),
		TextSize = 13,
		TextColor3 = UIKit.RarityColor(entry.Def.Rarity),
		Parent = card,
		ZIndex = 2,
	})

	if equipped then
		local check = UIKit.Label({
			Text = "✔",
			Size = UDim2.fromOffset(26, 26),
			Position = UDim2.new(1, -4, 0, 4),
			AnchorPoint = Vector2.new(1, 0),
			TextSize = 20,
			TextColor3 = C.Good,
			Parent = card,
			ZIndex = 3,
		})
		check.Name = "EquippedCheck"
	end

	if selectedUid == entry.Uid then
		local ring = UIKit.Stroke(card, C.Text, 3, 0.35)
		ring.Name = "SelectRing"
	end

	hit.Activated:Connect(function()
		onClick(entry.Uid)
	end)
	return card
end

local function refreshDetailPanel(meta: Types.MetaState?)
	local entry = nil
	if meta and selectedUid then
		for _, pet in meta.Pets do
			if pet.Uid == selectedUid then
				entry = { Uid = pet.Uid, Id = pet.Id, Def = petDef(pet.Id) }
				break
			end
		end
	end
	if not entry then
		selectedUid = nil
		detailEmpty.Visible = true
		detailFilled.Visible = false
		return
	end

	detailEmpty.Visible = false
	detailFilled.Visible = true
	deleteConfirmFrame.Visible = false

	UIKit.SetViewportModel(detailViewport, PetModels.Build(entry.Id), true)
	detailName.Text = entry.Def.Name
	detailRarity.Text = entry.Def.Rarity
	detailRarity.TextColor3 = UIKit.RarityColor(entry.Def.Rarity)
	detailPower.Text = powerShareText(entry.Def.PowerShare)
	detailCoin.Text = coinBonusText(entry.Def.CoinBonus)

	local equipped = isEquipped(meta :: Types.MetaState, entry.Uid)
	equipButton.Text = if equipped then "Unequip" else "Equip"
	equipButton.BackgroundColor3 = if equipped then C.Warning else C.Good
end

local function selectPet(uid: string?)
	selectedUid = uid
	deleteConfirmFrame.Visible = false
	refreshDetailPanel(ClientState.Meta)
	-- The grid highlights the selection: cheapest is a full rebuild, and this list is at most
	-- Config.PetRules.MaxInventory (60) cards, so it's not worth a more surgical update.
	PetsUI._refreshGrid()
end

local function doEquipToggle()
	local uid = selectedUid
	local meta = ClientState.Meta
	if not uid or not meta then
		return
	end
	local equipped = isEquipped(meta, uid)
	local result = ClientState.MetaRequest(if equipped then "Unequip" else "Equip", uid)
	if not result.Ok then
		UIKit.Toast(result.Error or "Couldn't do that.", "Bad")
	end
end

local function armDeleteConfirm()
	deleteToken += 1
	local token = deleteToken
	deleteConfirmFrame.Visible = true
	task.delay(4, function()
		if deleteToken == token then
			deleteConfirmFrame.Visible = false
		end
	end)
end

local function doDelete()
	deleteToken += 1
	deleteConfirmFrame.Visible = false
	local uid = selectedUid
	if not uid then
		return
	end
	local result = ClientState.MetaRequest("Delete", uid)
	if not result.Ok then
		UIKit.Toast(result.Error or "Couldn't delete that.", "Bad")
	else
		selectedUid = nil
	end
end

function PetsUI._refreshGrid()
	local meta = ClientState.Meta
	for _, child in gridScroll:GetChildren() do
		if child:IsA("Frame") or child:IsA("TextButton") then
			child:Destroy()
		end
	end
	if not meta then
		return
	end
	local list = sortedPetList(meta)
	for _, entry in list do
		buildPetCard(gridScroll, entry, isEquipped(meta, entry.Uid), selectPet)
	end
	local equippedCount = math.min(#meta.Equipped, meta.PetSlots)
	equippedLabel.Text = string.format("Equipped %d/%d", equippedCount, meta.PetSlots)
	countLabel.Text = string.format("%d/%d", #meta.Pets, meta.MaxPets)
	refreshDetailPanel(meta)
end

local function buildPetsWindow()
	local _window
	_window, petsContent = UIKit.Window({
		Name = "Pets",
		Title = "Pets",
		Icon = "🐾",
		Size = Vector2.new(880, 560),
		Parent = root,
	})

	local header = Instance.new("Frame")
	header.Name = "Header"
	header.BackgroundTransparency = 1
	header.Size = UDim2.new(1, 0, 0, 40)
	header.Parent = petsContent

	equippedLabel = UIKit.Label({
		Text = "Equipped 0/0",
		Size = UDim2.new(0.4, 0, 1, 0),
		TextSize = 22,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = header,
	})
	countLabel = UIKit.Label({
		Text = "0/0",
		Size = UDim2.new(0.2, 0, 1, 0),
		Position = UDim2.new(0.4, 0, 0, 0),
		TextSize = 22,
		TextColor3 = C.TextDim,
		Parent = header,
	})
	UIKit.Button({
		Text = "Equip Best",
		Icon = "⭐",
		Size = UDim2.fromOffset(180, 40),
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Color = C.Accent,
		Parent = header,
		OnClick = function()
			local result = ClientState.MetaRequest("EquipBest")
			if not result.Ok then
				UIKit.Toast(result.Error or "Couldn't equip pets.", "Bad")
			else
				UIKit.Toast("Equipped your best pets!", "Good")
			end
		end,
	})

	local body = Instance.new("Frame")
	body.Name = "Body"
	body.BackgroundTransparency = 1
	body.Position = UDim2.new(0, 0, 0, 48)
	body.Size = UDim2.new(1, 0, 1, -48)
	body.Parent = petsContent

	gridScroll = Instance.new("ScrollingFrame")
	gridScroll.Name = "Grid"
	gridScroll.BackgroundColor3 = C.PanelDark
	gridScroll.BackgroundTransparency = 0.35
	gridScroll.BorderSizePixel = 0
	gridScroll.Size = UDim2.new(0, 546, 1, 0)
	gridScroll.CanvasSize = UDim2.new(0, 0, 0, 0)
	gridScroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	gridScroll.ScrollBarThickness = 8
	gridScroll.ScrollBarImageColor3 = C.Primary
	UIKit.Corner(gridScroll, 12)
	gridScroll.Parent = body

	local gridLayout = Instance.new("UIGridLayout")
	gridLayout.CellSize = UDim2.fromOffset(GRID_CELL.X, GRID_CELL.Y)
	gridLayout.CellPadding = UDim2.fromOffset(GRID_GAP, GRID_GAP)
	gridLayout.SortOrder = Enum.SortOrder.LayoutOrder
	gridLayout.Parent = gridScroll
	local gridPad = UIKit.Padding(gridScroll, 10)
	gridPad.Parent = gridScroll

	-- Details panel
	local details = UIKit.Card({
		Size = UDim2.new(0, 300, 1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		AnchorPoint = Vector2.new(1, 0),
		Color = C.PanelDark,
		Parent = body,
	})

	detailEmpty = Instance.new("Frame")
	detailEmpty.Name = "Empty"
	detailEmpty.BackgroundTransparency = 1
	detailEmpty.Size = UDim2.fromScale(1, 1)
	detailEmpty.Parent = details
	UIKit.Label({
		Text = "Select a pet to see its details.",
		Size = UDim2.new(1, -20, 0, 60),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		TextSize = 18,
		TextColor3 = C.TextDim,
		TextWrapped = true,
		Parent = detailEmpty,
	})

	detailFilled = Instance.new("Frame")
	detailFilled.Name = "Filled"
	detailFilled.BackgroundTransparency = 1
	detailFilled.Size = UDim2.fromScale(1, 1)
	detailFilled.Visible = false
	detailFilled.Parent = details

	detailViewport = UIKit.Viewport({
		Size = UDim2.fromOffset(180, 140),
		Position = UDim2.new(0.5, 0, 0, 12),
		AnchorPoint = Vector2.new(0.5, 0),
		Spin = true,
		Parent = detailFilled,
	})
	detailName = UIKit.Label({
		Text = "",
		Size = UDim2.new(1, -16, 0, 28),
		Position = UDim2.new(0.5, 0, 0, 156),
		AnchorPoint = Vector2.new(0.5, 0),
		TextSize = 24,
		TextScaled = true,
		Parent = detailFilled,
	})
	detailRarity = UIKit.Label({
		Text = "",
		Size = UDim2.new(1, -16, 0, 20),
		Position = UDim2.new(0.5, 0, 0, 184),
		AnchorPoint = Vector2.new(0.5, 0),
		TextSize = 16,
		Parent = detailFilled,
	})
	detailPower = UIKit.Label({
		Text = "",
		Size = UDim2.new(1, -24, 0, 40),
		Position = UDim2.new(0.5, 0, 0, 212),
		AnchorPoint = Vector2.new(0.5, 0),
		TextSize = 16,
		TextWrapped = true,
		TextColor3 = C.TextDim,
		Parent = detailFilled,
	})
	detailCoin = UIKit.Label({
		Text = "",
		Size = UDim2.new(1, -24, 0, 24),
		Position = UDim2.new(0.5, 0, 0, 252),
		AnchorPoint = Vector2.new(0.5, 0),
		TextSize = 16,
		TextColor3 = C.Coin,
		Parent = detailFilled,
	})

	equipButton = UIKit.Button({
		Text = "Equip",
		Size = UDim2.new(1, -24, 0, 46),
		Position = UDim2.new(0.5, 0, 0, 296),
		AnchorPoint = Vector2.new(0.5, 0),
		Color = C.Good,
		Parent = detailFilled,
		OnClick = doEquipToggle,
	})
	local _deleteButton = UIKit.Button({
		Text = "Delete",
		Size = UDim2.new(1, -24, 0, 40),
		Position = UDim2.new(0.5, 0, 0, 352),
		AnchorPoint = Vector2.new(0.5, 0),
		Color = C.Bad,
		Parent = detailFilled,
		OnClick = armDeleteConfirm,
	})

	deleteConfirmFrame = Instance.new("Frame")
	deleteConfirmFrame.Name = "DeleteConfirm"
	deleteConfirmFrame.BackgroundTransparency = 1
	deleteConfirmFrame.Size = UDim2.new(1, -24, 0, 70)
	deleteConfirmFrame.Position = UDim2.new(0.5, 0, 0, 400)
	deleteConfirmFrame.AnchorPoint = Vector2.new(0.5, 0)
	deleteConfirmFrame.Visible = false
	deleteConfirmFrame.Parent = detailFilled
	UIKit.Label({
		Text = "Delete this pet forever?",
		Size = UDim2.new(1, 0, 0, 20),
		TextSize = 15,
		TextColor3 = C.Bad,
		Parent = deleteConfirmFrame,
	})
	UIKit.Button({
		Text = "Yes, delete",
		Size = UDim2.new(0.48, -4, 0, 38),
		Position = UDim2.new(0, 0, 0, 26),
		Color = C.Bad,
		TextSize = 16,
		Parent = deleteConfirmFrame,
		OnClick = doDelete,
	})
	UIKit.Button({
		Text = "Cancel",
		Size = UDim2.new(0.48, -4, 0, 38),
		Position = UDim2.new(0.52, 4, 0, 26),
		Color = C.Disabled,
		TextSize = 16,
		Parent = deleteConfirmFrame,
		OnClick = function()
			deleteToken += 1
			deleteConfirmFrame.Visible = false
		end,
	})

	UIKit.RegisterWindow("Pets", {
		Open = function()
			PetsUI._refreshGrid()
		end,
		Close = function() end,
	})
end

----------------------------------------------------------------------------------------------------
-- Eggs window
----------------------------------------------------------------------------------------------------

local function eggAffordable(egg, count: number, meta: Types.MetaState?): boolean
	if not meta then
		return false
	end
	local cost = egg.Cost * count
	local room = meta.MaxPets - #meta.Pets
	return meta.Bubbles &gt;= cost and room &gt;= count
end

local function buildOddsRow(parent: Instance, entry, layoutOrder: number)
	local row = UIKit.Card({
		Size = UDim2.new(1, 0, 0, 60),
		Color = C.PanelLight,
		LayoutOrder = layoutOrder,
		Parent = parent,
	})
	local def = petDef(entry.Pet)
	UIKit.Viewport({
		Model = PetModels.Build(entry.Pet),
		Size = UDim2.fromOffset(52, 52),
		Position = UDim2.new(0, 6, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		Parent = row,
	})
	UIKit.Label({
		Text = def.Name,
		Size = UDim2.new(1, -180, 0, 22),
		Position = UDim2.new(0, 66, 0, 8),
		TextSize = 17,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = row,
	})
	UIKit.Label({
		Text = def.Rarity,
		Size = UDim2.new(1, -180, 0, 18),
		Position = UDim2.new(0, 66, 0, 32),
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = UIKit.RarityColor(def.Rarity),
		Parent = row,
	})
	UIKit.Label({
		Text = Format.Chance(entry.Chance),
		Size = UDim2.new(0, 90, 1, 0),
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -8, 0, 0),
		TextSize = 20,
		TextColor3 = C.Text,
		Parent = row,
	})
end

local function selectEgg(eggId: string)
	local egg = Config.GetEgg(eggId)
	if not egg then
		return
	end
	currentEggId = eggId

	for _, child in eggTabsHolder:GetChildren() do
		if child:IsA("TextButton") then
			local active = child:GetAttribute("EggId") == eggId
			child.BackgroundColor3 = if active then C.Primary else C.PanelLight
		end
	end

	UIKit.SetViewportModel(eggViewport, PetModels.Egg(eggId), true)
	eggNameLabel.Text = egg.Name
	eggCostLabel.Text = "🧼 " .. Format.Commas(egg.Cost)

	for _, child in oddsScroll:GetChildren() do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
	local order = 0
	for _, entry in egg.Pets do
		order += 1
		buildOddsRow(oddsScroll, entry, order)
	end

	PetsUI._refreshEggButtons()
end

function PetsUI._refreshEggButtons()
	local eggId = currentEggId
	if not eggId then
		return
	end
	local egg = Config.GetEgg(eggId)
	local meta = ClientState.Meta
	local unlocked = meta and meta.Unlocked or 0
	local locked = unlocked &lt; egg.RequiredLevel

	eggLockedLabel.Visible = locked
	if locked then
		local level = Config.Levels[egg.RequiredLevel]
		local where = if level then (level.Icon or "") .. " " .. level.Name else ("Level " .. egg.RequiredLevel)
		eggLockedLabel.Text = "🔒 Unlock " .. where .. " to hatch this egg!"
	end

	hatch1Button:SetAttribute("Disabled", locked or not eggAffordable(egg, 1, meta))
	hatch3Button:SetAttribute("Disabled", locked or not eggAffordable(egg, 3, meta))
	hatch1Button.Text = "Hatch 1 (🧼 " .. Format.Commas(egg.Cost) .. ")"
	hatch3Button.Text = "Hatch 3 (🧼 " .. Format.Commas(egg.Cost * 3) .. ")"
end

local function doHatch(count: number)
	local eggId = currentEggId
	if not eggId then
		return
	end
	local result = ClientState.MetaRequest("Hatch", { Egg = eggId, Count = count })
	if not result.Ok then
		UIKit.Toast(result.Error or "Couldn't hatch that egg.", "Bad")
		return
	end
	PetsUI.PlayHatchAnimation(eggId, result.Pets or {})
end

local function buildEggsWindow()
	local _window
	_window, eggsContent = UIKit.Window({
		Name = "Eggs",
		Title = "Egg Hatchery",
		Icon = "🥚",
		Size = Vector2.new(860, 560),
		Parent = root,
	})

	eggTabsHolder = Instance.new("Frame")
	eggTabsHolder.Name = "Tabs"
	eggTabsHolder.BackgroundTransparency = 1
	eggTabsHolder.Size = UDim2.new(1, 0, 0, 40)
	eggTabsHolder.Parent = eggsContent
	local tabsLayout = Instance.new("UIListLayout")
	tabsLayout.FillDirection = Enum.FillDirection.Horizontal
	tabsLayout.Padding = UDim.new(0, 8)
	tabsLayout.Parent = eggTabsHolder

	for _, egg in Config.Eggs do
		local tab = UIKit.Button({
			Text = egg.Name,
			Size = UDim2.fromOffset(160, 40),
			TextSize = 16,
			Color = C.PanelLight,
			Parent = eggTabsHolder,
			OnClick = function()
				selectEgg(egg.Id)
			end,
		})
		tab:SetAttribute("EggId", egg.Id)
	end

	local body = Instance.new("Frame")
	body.Name = "Body"
	body.BackgroundTransparency = 1
	body.Position = UDim2.new(0, 0, 0, 48)
	body.Size = UDim2.new(1, 0, 1, -48)
	body.Parent = eggsContent

	local left = UIKit.Card({
		Size = UDim2.new(0, 260, 1, 0),
		Color = C.PanelDark,
		Parent = body,
	})
	eggViewport = UIKit.Viewport({
		Size = UDim2.fromOffset(190, 160),
		Position = UDim2.new(0.5, 0, 0, 14),
		AnchorPoint = Vector2.new(0.5, 0),
		Spin = true,
		Parent = left,
	})
	eggNameLabel = UIKit.Label({
		Text = "",
		Size = UDim2.new(1, -16, 0, 30),
		Position = UDim2.new(0.5, 0, 0, 182),
		AnchorPoint = Vector2.new(0.5, 0),
		TextSize = 24,
		TextScaled = true,
		Parent = left,
	})
	eggCostLabel = UIKit.Label({
		Text = "",
		Size = UDim2.new(1, -16, 0, 24),
		Position = UDim2.new(0.5, 0, 0, 214),
		AnchorPoint = Vector2.new(0.5, 0),
		TextSize = 20,
		TextColor3 = C.Bubble,
		Parent = left,
	})
	eggLockedLabel = UIKit.Label({
		Text = "",
		Size = UDim2.new(1, -20, 0, 60),
		Position = UDim2.new(0.5, 0, 0, 250),
		AnchorPoint = Vector2.new(0.5, 0),
		TextSize = 14,
		TextColor3 = C.Bad,
		TextWrapped = true,
		Visible = false,
		Parent = left,
	})

	hatch1Button = UIKit.Button({
		Text = "Hatch 1",
		Size = UDim2.new(1, -20, 0, 46),
		Position = UDim2.new(0.5, 0, 1, -110),
		AnchorPoint = Vector2.new(0.5, 0),
		Color = C.Good,
		TextSize = 16,
		Parent = left,
		OnClick = function()
			doHatch(1)
		end,
	})
	hatch3Button = UIKit.Button({
		Text = "Hatch 3",
		Size = UDim2.new(1, -20, 0, 46),
		Position = UDim2.new(0.5, 0, 1, -56),
		AnchorPoint = Vector2.new(0.5, 0),
		Color = C.Accent,
		TextSize = 16,
		Parent = left,
		OnClick = function()
			doHatch(3)
		end,
	})

	local right = Instance.new("Frame")
	right.Name = "Odds"
	right.BackgroundTransparency = 1
	right.Position = UDim2.new(0, 274, 0, 0)
	right.Size = UDim2.new(1, -274, 1, 0)
