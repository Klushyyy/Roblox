<Item class="ModuleScript" referent="RBX00000009"><Properties><string name="Name">ToolModels</string><ProtectedString name="Source">-- ToolModels: builds a model of each cleaning tool out of primitive parts. Used for the arena's tool
-- shelf (anchored, big) and for the tool in a player's hand (welded, small).
--
-- ToolModels.Build(toolIndex, scale) -&gt; Model
--   * built around CFrame.identity: the model's base sits on Y = 0 and its business end points at -Z
--   * PrimaryPart is "Grip", an invisible 0.2 stud part at the origin
--   * every part is Anchored, CanCollide/CanQuery/CanTouch false, Massless, CastShadow false
--   * Bare Hands (index 1) is just the Grip
-- ToolModels.HoldOffset(toolIndex) -&gt; CFrame: where the Grip sits relative to a RightHand (R15) so
-- the tool looks held.
--
-- Detail comes from a few helpers: rounded boxes (a core plus cylinders on the edges), rings and
-- curved runs of short bars (hoses, trigger guards, handles), ribbed knobs, and small trims and
-- fittings. No two coplanar faces overlap, so nothing flickers.

local Config = require(script.Parent:WaitForChild("Config"))

local ToolModels = {}

local DARK = Color3.fromRGB(40, 42, 50)
local RUBBER = Color3.fromRGB(58, 60, 68)
local WHITE = Color3.fromRGB(245, 247, 250)
local CHROME = Color3.fromRGB(210, 215, 224)
local BRASS = Color3.fromRGB(214, 170, 80)
local WOOD = Color3.fromRGB(170, 116, 72)
local WOOD_DARK = Color3.fromRGB(130, 86, 52)

local UPRIGHT = CFrame.Angles(0, 0, math.rad(90)) -- cylinder axis -&gt; up (Y)
local ALONG_Z = CFrame.Angles(0, math.rad(90), 0) -- cylinder axis -&gt; front/back (Z)


type Ctx = { Model: Model, Scale: number }

local function shade(c: Color3, f: number): Color3
	return Color3.new(math.clamp(c.R * f, 0, 1), math.clamp(c.G * f, 0, 1), math.clamp(c.B * f, 0, 1))
end

-- A part at `cf` (model-local, unscaled studs).
local function partCF(ctx: Ctx, name: string, shape: Enum.PartType?, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?, transparency: number?): Part
	local p = Instance.new("Part")
	p.Name = name
	if shape then
		p.Shape = shape
	end
	local s = size * ctx.Scale
	p.Size = Vector3.new(math.max(s.X, 0.05), math.max(s.Y, 0.05), math.max(s.Z, 0.05))
	p.CFrame = CFrame.new(cf.Position * ctx.Scale) * cf.Rotation
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.Transparency = transparency or 0
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Massless = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = ctx.Model
	return p
end

local function part(ctx: Ctx, name: string, shape: Enum.PartType?, size: Vector3, offset: Vector3, rot: CFrame?, color: Color3, material: Enum.Material?, transparency: number?): Part
	return partCF(ctx, name, shape, size, CFrame.new(offset) * (rot or CFrame.identity), color, material, transparency)
end

-- A cylinder running from a to b.
local function bar(ctx: Ctx, name: string, a: Vector3, b: Vector3, thickness: number, color: Color3, material: Enum.Material?): Part
	local dir = (b - a)
	local mid = (a + b) / 2
	local hint = if math.abs(dir.Unit.Y) &gt; 0.95 then Vector3.new(1, 0, 0) else Vector3.new(0, 1, 0)
	local rot = CFrame.fromMatrix(Vector3.zero, dir.Unit, hint:Cross(dir.Unit).Unit:Cross(dir.Unit) * -1)
	return part(ctx, name, Enum.PartType.Cylinder, Vector3.new(dir.Magnitude, thickness, thickness), mid, rot, color, material)
end

-- A smooth run of bars through the given points, with a ball at every joint (hoses, curved handles).
local function tube(ctx: Ctx, name: string, points: { Vector3 }, thickness: number, color: Color3, material: Enum.Material?)
	for i = 1, #points - 1 do
		bar(ctx, name, points[i], points[i + 1], thickness, color, material)
		if i &gt; 1 then
			part(ctx, name .. "Joint", Enum.PartType.Ball, Vector3.one * thickness, points[i], nil, color, material)
		end
	end
end

-- Box with rounded edges along its local Y axis (a stadium/rounded-rectangle prism), placed at
-- `cf`. Two crossing cores plus four corner cylinders.
local function roundedBox(ctx: Ctx, name: string, size: Vector3, cf: CFrame, r: number, color: Color3, material: Enum.Material?, transparency: number?)
	r = math.min(r, size.X / 2, size.Z / 2)
	-- (A core with no width left is skipped: two zero-width slabs would share faces and flicker.)
	if size.X - 2 * r &gt; 0.06 then
		partCF(ctx, name, nil, Vector3.new(size.X - 2 * r, size.Y, size.Z), cf, color, material, transparency)
	end
	if size.Z - 2 * r &gt; 0.06 then
		partCF(ctx, name, nil, Vector3.new(size.X, size.Y, size.Z - 2 * r), cf, color, material, transparency)
	end
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			partCF(ctx, name .. "Edge", Enum.PartType.Cylinder, Vector3.new(size.Y, 2 * r, 2 * r), cf * CFrame.new(sx * (size.X / 2 - r), 0, sz * (size.Z / 2 - r)) * UPRIGHT, color, material, transparency)
		end
	end
end

-- A ring of `n` short bars in the XY plane of `cf` (so its axis is cf's Z).
local function ring(ctx: Ctx, name: string, cf: CFrame, radius: number, thickness: number, color: Color3, material: Enum.Material?, n: number?, fromAngle: number?, toAngle: number?)
	local count = n or 14
	local a0, a1 = fromAngle or 0, toAngle or math.pi * 2
	local pts = {}
	for i = 0, count do
		local a = a0 + (a1 - a0) * i / count
		table.insert(pts, (cf * CFrame.new(math.cos(a) * radius, math.sin(a) * radius, 0)).Position)
	end
	tube(ctx, name, pts, thickness, color, material)
end

-- A ribbed knob: a cylinder with small ridges around it. Axis along cf's X.
local function knob(ctx: Ctx, name: string, cf: CFrame, length: number, diameter: number, color: Color3, ridgeColor: Color3)
	partCF(ctx, name, Enum.PartType.Cylinder, Vector3.new(length, diameter, diameter), cf, color)
	for i = 0, 9 do
		local a = i / 10 * math.pi * 2
		partCF(ctx, name .. "Ridge", nil, Vector3.new(length * 0.9, diameter * 0.12, diameter * 0.12), cf * CFrame.Angles(a, 0, 0) * CFrame.new(0, diameter / 2, 0), ridgeColor)
	end
end

local BUILDERS: { [string]: (Ctx, Color3) -&gt; () } = {}

-- An invisible marker at a tool's business end: sprays, jets and foam come out of it.
local function muzzle(ctx: Ctx, pos: Vector3)
	local m = part(ctx, "Muzzle", nil, Vector3.new(0.1, 0.1, 0.1) / ctx.Scale, pos, nil, WHITE)
	m.Transparency = 1
end
local HELD_BUILDERS: { [string]: (Ctx, Color3) -&gt; () } = {}

-- Sponge: a rounded block of yellow foam with dimpled pores, a glue line, and a green scouring pad
-- on top with a lighter fleck pattern. A bead of soap suds rides on the pad.
BUILDERS.Sponge = function(ctx, _color)
	local yellow = Color3.fromRGB(255, 212, 76)
	local foamCF = CFrame.new(0, 0.85, 0)
	roundedBox(ctx, "Foam", Vector3.new(3.4, 1.7, 2.3), foamCF, 0.55, yellow, Enum.Material.SmoothPlastic)
	-- Slightly darker lower lip, so the block reads rounded.
	roundedBox(ctx, "FoamBase", Vector3.new(3.6, 0.3, 2.5), CFrame.new(0, 0.12, 0), 0.6, shade(yellow, 0.85))
	partCF(ctx, "Glue", nil, Vector3.new(3.36, 0.08, 2.26), CFrame.new(0, 1.74, 0), Color3.fromRGB(255, 240, 190))
	roundedBox(ctx, "Pad", Vector3.new(3.4, 0.5, 2.3), CFrame.new(0, 2.03, 0), 0.55, Color3.fromRGB(64, 160, 80), Enum.Material.Fabric)
	-- Flecks on top of the pad.
	local rng = Random.new(3)
	for _ = 1, 10 do
		part(ctx, "Fleck", nil, Vector3.new(0.35, 0.05, 0.12), Vector3.new(rng:NextNumber(-1.3, 1.3), 2.3, rng:NextNumber(-0.8, 0.8)), CFrame.Angles(0, rng:NextNumber(0, math.pi), 0), Color3.fromRGB(110, 200, 120))
	end
	-- Pores: little dimples on the front, back and sides.
	for _ = 1, 9 do
		local x, y = rng:NextNumber(-1.3, 1.3), rng:NextNumber(0.35, 1.45)
		part(ctx, "Pore", Enum.PartType.Ball, Vector3.one * rng:NextNumber(0.22, 0.36), Vector3.new(x, y, -1.13), nil, Color3.fromRGB(214, 168, 46))
		part(ctx, "Pore", Enum.PartType.Ball, Vector3.one * rng:NextNumber(0.22, 0.36), Vector3.new(-x, y, 1.13), nil, Color3.fromRGB(214, 168, 46))
	end
	for _ = 1, 3 do
		part(ctx, "Pore", Enum.PartType.Ball, Vector3.one * 0.28, Vector3.new(1.68, rng:NextNumber(0.4, 1.4), rng:NextNumber(-0.5, 0.5)), nil, Color3.fromRGB(214, 168, 46))
		part(ctx, "Pore", Enum.PartType.Ball, Vector3.one * 0.28, Vector3.new(-1.68, rng:NextNumber(0.4, 1.4), rng:NextNumber(-0.5, 0.5)), nil, Color3.fromRGB(214, 168, 46))
	end
	-- Suds.
	for _, b in { { Vector3.new(0.7, 2.45, -0.3), 0.55 }, { Vector3.new(1.1, 2.4, 0.2), 0.4 }, { Vector3.new(0.35, 2.4, 0.3), 0.35 } } do
		part(ctx, "Suds", Enum.PartType.Ball, Vector3.one * b[2], b[1], nil, WHITE, nil, 0.1)
	end
end

-- Scrub brush: an oval coloured block with a lighter top rim, tufts of bristles in rows underneath,
-- and a curved wooden handle with a rubber grip, a chrome ferrule and a hanging ring.
BUILDERS.Brush = function(ctx, color)
	roundedBox(ctx, "Head", Vector3.new(3.2, 0.8, 1.6), CFrame.new(0, 1.15, 0), 0.8, color)
	roundedBox(ctx, "HeadTop", Vector3.new(3.0, 0.25, 1.4), CFrame.new(0, 1.68, 0), 0.7, shade(color, 1.18))
	roundedBox(ctx, "HeadBase", Vector3.new(3.0, 0.15, 1.5), CFrame.new(0, 0.7, 0), 0.75, shade(color, 0.75))
	-- Bristle tufts: 7 x 3 grid, alternating lengths, white with pale tips.
	for i = -3, 3 do
		for j = -1, 1 do
			if math.abs(i) == 3 and j ~= 0 then
				continue -- rounded ends of the head
			end
			local len = if (i + j) % 2 == 0 then 0.65 else 0.55
			local pos = Vector3.new(i * 0.42, 0.65 - len / 2, j * 0.42)
			part(ctx, "Tuft", Enum.PartType.Cylinder, Vector3.new(len, 0.3, 0.3), pos, UPRIGHT, Color3.fromRGB(240, 238, 228), Enum.Material.Fabric)
			part(ctx, "TuftTip", Enum.PartType.Cylinder, Vector3.new(0.06, 0.32, 0.32), pos - Vector3.new(0, len / 2, 0), UPRIGHT, Color3.fromRGB(255, 250, 235), Enum.Material.Fabric)
		end
	end
	-- Handle: rises from the back of the head and curves over it.
	part(ctx, "Ferrule", Enum.PartType.Cylinder, Vector3.new(0.45, 0.72, 0.72), Vector3.new(0, 1.85, 0.55), CFrame.Angles(math.rad(-35), 0, 0) * UPRIGHT, CHROME, Enum.Material.Metal)
	local pts = { Vector3.new(0, 1.8, 0.45), Vector3.new(0, 2.35, 1.05), Vector3.new(0, 2.8, 1.9), Vector3.new(0, 3.05, 2.8), Vector3.new(0, 3.15, 3.5) }
	tube(ctx, "Handle", pts, 0.55, WOOD, Enum.Material.Wood)
	-- Rubber grip wrap near the end, and the end cap with a hanging ring.
	bar(ctx, "GripWrap", Vector3.new(0, 2.95, 2.35), Vector3.new(0, 3.12, 3.25), 0.66, RUBBER)
	for _, t in { 0.25, 0.5, 0.75 } do
		local p = Vector3.new(0, 2.95, 2.35):Lerp(Vector3.new(0, 3.12, 3.25), t)
		part(ctx, "GripRib", Enum.PartType.Cylinder, Vector3.new(0.1, 0.72, 0.72), p, CFrame.Angles(math.rad(-80), 0, 0) * UPRIGHT, shade(RUBBER, 1.3))
	end
	part(ctx, "EndCap", Enum.PartType.Ball, Vector3.one * 0.66, Vector3.new(0, 3.15, 3.5), nil, WOOD_DARK, Enum.Material.Wood)
	ring(ctx, "HangRing", CFrame.new(0, 3.2, 3.95) * CFrame.Angles(0, math.rad(90), 0), 0.3, 0.1, CHROME, Enum.Material.Metal, 10)
end

-- Spray nozzle: a pistol spray gun. Coloured body with a chrome barrel that steps down to the tip,
-- an adjustable spray-pattern dial, a rubber pistol grip with finger ridges, a curved trigger inside
-- a guard, a brass hose fitting, and a coil of hose.
BUILDERS.Nozzle = function(ctx, color)
	local y = 2.3
	-- Body.
	roundedBox(ctx, "Body", Vector3.new(0.9, 1.1, 2.2), CFrame.new(0, y, 0.2) * CFrame.Angles(0, 0, math.rad(90)), 0.45, color)
	partCF(ctx, "BodyStripe", nil, Vector3.new(0.95, 0.18, 1.6), CFrame.new(0, y + 0.3, 0.2), shade(color, 0.7))
	-- Barrel stepping down to the tip.
	part(ctx, "Barrel", Enum.PartType.Cylinder, Vector3.new(1.2, 0.72, 0.72), Vector3.new(0, y, -1.4), ALONG_Z, CHROME, Enum.Material.Metal)
	part(ctx, "BarrelCollar", Enum.PartType.Cylinder, Vector3.new(0.25, 0.9, 0.9), Vector3.new(0, y, -0.9), ALONG_Z, shade(color, 0.8))
	-- Spray-pattern dial at the front.
	local dialCF = CFrame.new(0, y, -2.15) * ALONG_Z
	knob(ctx, "Dial", dialCF, 0.45, 1.05, color, shade(color, 0.7))
	part(ctx, "Tip", Enum.PartType.Cylinder, Vector3.new(0.2, 0.45, 0.45), Vector3.new(0, y, -2.45), ALONG_Z, CHROME, Enum.Material.Metal)
	part(ctx, "TipHole", Enum.PartType.Cylinder, Vector3.new(0.05, 0.18, 0.18), Vector3.new(0, y, -2.56), ALONG_Z, DARK)
	muzzle(ctx, Vector3.new(0, y, -2.7))
	-- Pistol grip with finger ridges.
	local gripCF = CFrame.new(0, 1.2, 0.85) * CFrame.Angles(math.rad(-14), 0, 0)
	roundedBox(ctx, "Grip", Vector3.new(0.8, 2.0, 0.95), gripCF, 0.38, RUBBER)
	for i = 0, 2 do
		partCF(ctx, "FingerRidge", Enum.PartType.Cylinder, Vector3.new(0.82, 0.26, 0.26), gripCF * CFrame.new(0, 0.55 - i * 0.45, -0.47), shade(RUBBER, 1.35))
	end
	partCF(ctx, "GripCap", nil, Vector3.new(0.9, 0.2, 1.05), gripCF * CFrame.new(0, -1.02, 0), color)
	-- Trigger and guard.
	tube(ctx, "Trigger", { Vector3.new(0, 1.75, -0.2), Vector3.new(0, 1.35, -0.3), Vector3.new(0, 1.0, -0.2) }, 0.26, color)
	tube(ctx, "Guard", { Vector3.new(0, 1.75, -0.65), Vector3.new(0, 1.15, -0.7), Vector3.new(0, 0.75, -0.4), Vector3.new(0, 0.62, 0.25) }, 0.14, DARK)
	-- Hose fitting and a coil of green hose trailing back.
	part(ctx, "Fitting", Enum.PartType.Cylinder, Vector3.new(0.5, 0.55, 0.55), Vector3.new(0, 0.1, 1.05), UPRIGHT, BRASS, Enum.Material.Metal)
	local hose = Color3.fromRGB(70, 160, 80)
	tube(ctx, "Hose", { Vector3.new(0, 0.05, 1.1), Vector3.new(0, 0.2, 1.8), Vector3.new(0.6, 0.25, 2.2), Vector3.new(1.2, 0.25, 1.9) }, 0.4, hose)
	ring(ctx, "HoseCoil", CFrame.new(1.35, 0.2, 1.2) * CFrame.Angles(math.rad(90), 0, 0), 0.75, 0.4, hose, nil, 12)
end

-- Pressure washer: a two-tone rounded body on a dark chassis, big wheels with chrome hubs, a hose
-- reel with coils on the side, a gauge, vents, a telescopic handle with foam grips, and the spray
-- gun with its long chrome lance clipped to the side.
BUILDERS.Washer = function(ctx, color)
	local bodyCF = CFrame.new(0, 1.9, 0.3)
	roundedBox(ctx, "Body", Vector3.new(2.6, 2.1, 3.0), bodyCF, 0.7, color)
	roundedBox(ctx, "BodyTop", Vector3.new(2.3, 0.4, 2.7), CFrame.new(0, 3.1, 0.3), 0.6, shade(color, 1.2))
	roundedBox(ctx, "Chassis", Vector3.new(2.8, 0.5, 3.2), CFrame.new(0, 0.75, 0.3), 0.5, DARK)
	-- Front face: vents and a badge.
	for i = 0, 3 do
		part(ctx, "Vent", nil, Vector3.new(1.4, 0.12, 0.08), Vector3.new(0, 1.35 + i * 0.25, -1.23), nil, shade(color, 0.55))
	end
	part(ctx, "Badge", nil, Vector3.new(1.1, 0.4, 0.06), Vector3.new(0, 2.55, -1.22), nil, WHITE)
	part(ctx, "BadgeStripe", nil, Vector3.new(0.9, 0.1, 0.05), Vector3.new(0, 2.55, -1.26), nil, Color3.fromRGB(255, 200, 60))
	-- Gauge on top.
	part(ctx, "Gauge", Enum.PartType.Cylinder, Vector3.new(0.2, 0.8, 0.8), Vector3.new(0.6, 3.4, -0.5), UPRIGHT, CHROME, Enum.Material.Metal)
	part(ctx, "GaugeFace", Enum.PartType.Cylinder, Vector3.new(0.06, 0.65, 0.65), Vector3.new(0.6, 3.52, -0.5), UPRIGHT, WHITE)
	part(ctx, "GaugeNeedle", nil, Vector3.new(0.05, 0.04, 0.3), Vector3.new(0.6, 3.56, -0.58), CFrame.Angles(0, math.rad(30), 0), Color3.fromRGB(220, 40, 40))
	-- Power switch.
	part(ctx, "Switch", nil, Vector3.new(0.35, 0.2, 0.5), Vector3.new(-0.6, 3.38, -0.6), nil, Color3.fromRGB(230, 50, 50))
	-- Wheels with hubcaps.
	for _, x in { -1.5, 1.5 } do
		part(ctx, "Wheel", Enum.PartType.Cylinder, Vector3.new(0.55, 1.5, 1.5), Vector3.new(x, 0.75, 1.2), nil, DARK)
		part(ctx, "Tread", Enum.PartType.Cylinder, Vector3.new(0.45, 1.56, 1.56), Vector3.new(x, 0.75, 1.2), nil, RUBBER)
		part(ctx, "Hub", Enum.PartType.Cylinder, Vector3.new(0.6, 0.7, 0.7), Vector3.new(x, 0.75, 1.2), nil, CHROME, Enum.Material.Metal)
		part(ctx, "HubCap", Enum.PartType.Cylinder, Vector3.new(0.72, 0.3, 0.3), Vector3.new(x, 0.75, 1.2), nil, shade(color, 0.8))
	end
	-- Front foot.
	part(ctx, "Foot", nil, Vector3.new(1.8, 0.35, 0.4), Vector3.new(0, 0.18, -0.9), nil, RUBBER)
	-- Telescopic handle.
	for _, x in { -0.95, 0.95 } do
		bar(ctx, "HandleTube", Vector3.new(x, 2.6, 1.65), Vector3.new(x, 5.0, 1.95), 0.28, CHROME, Enum.Material.Metal)
		bar(ctx, "HandleSleeve", Vector3.new(x, 2.5, 1.63), Vector3.new(x, 3.4, 1.73), 0.36, DARK)
	end
	bar(ctx, "HandleBar", Vector3.new(-1.1, 5.0, 1.95), Vector3.new(1.1, 5.0, 1.95), 0.3, CHROME, Enum.Material.Metal)
	bar(ctx, "HandleFoam", Vector3.new(-0.75, 5.0, 1.95), Vector3.new(0.75, 5.0, 1.95), 0.45, RUBBER)
	-- Hose reel on the right side.
	part(ctx, "Reel", Enum.PartType.Cylinder, Vector3.new(0.5, 1.5, 1.5), Vector3.new(1.55, 2.0, 0.6), nil, shade(color, 0.8))
	for i = 0, 2 do
		part(ctx, "ReelCoil", Enum.PartType.Cylinder, Vector3.new(0.12, 1.25 - i * 0.12, 1.25 - i * 0.12), Vector3.new(1.84 + i * 0.035, 2.0, 0.6), nil, if i % 2 == 0 then DARK else RUBBER)
	end
	part(ctx, "ReelCrank", nil, Vector3.new(0.12, 0.7, 0.14), Vector3.new(2.04, 2.3, 0.6), nil, CHROME, Enum.Material.Metal)
	-- Spray gun clipped on the left side, lance pointing forward.
	local gx = -1.6
	roundedBox(ctx, "GunBody", Vector3.new(0.45, 0.6, 1.1), CFrame.new(gx, 2.35, 0.5), 0.22, DARK)
	part(ctx, "GunTrigger", nil, Vector3.new(0.14, 0.45, 0.14), Vector3.new(gx, 1.95, 0.35), nil, Color3.fromRGB(255, 200, 60))
	bar(ctx, "GunGrip", Vector3.new(gx, 2.1, 0.8), Vector3.new(gx, 1.5, 1.0), 0.4, DARK)
	bar(ctx, "Lance", Vector3.new(gx, 2.35, -0.05), Vector3.new(gx, 2.35, -2.9), 0.22, CHROME, Enum.Material.Metal)
	part(ctx, "LanceTip", Enum.PartType.Cylinder, Vector3.new(0.35, 0.36, 0.36), Vector3.new(gx, 2.35, -3.0), ALONG_Z, Color3.fromRGB(255, 200, 60))
	part(ctx, "Clip", nil, Vector3.new(0.4, 0.3, 0.3), Vector3.new(-1.4, 2.35, -0.3), nil, DARK)
	-- Hose from the reel round the back to the gun.
	tube(ctx, "Hose", { Vector3.new(1.55, 1.3, 1.1), Vector3.new(1.0, 0.9, 1.9), Vector3.new(-0.6, 0.9, 2.0), Vector3.new(-1.5, 1.2, 1.4), Vector3.new(gx, 1.5, 1.0) }, 0.2, Color3.fromRGB(30, 32, 38))
end

-- The pressure washer as it's held: just the spray gun and its long lance (the cart stays on the
-- shelf). The pistol grip is at the origin so the hand closes round it; the gun body sits above
-- it and the lance runs forward (-Z) with a rubber fore-grip, ending in a yellow nozzle. A short
-- run of hose hangs from the bottom of the grip.
HELD_BUILDERS.Washer = function(ctx, color)
	local y = 0.8
	bar(ctx, "GunGrip", Vector3.new(0, -0.55, 0.2), Vector3.new(0, 0.55, -0.05), 0.42, DARK)
	for i = 0, 2 do
		part(ctx, "GripRidge", Enum.PartType.Cylinder, Vector3.new(0.44, 0.12, 0.12), Vector3.new(0, 0.3 - i * 0.3, -0.12 + i * 0.07), nil, RUBBER)
	end
	roundedBox(ctx, "GunBody", Vector3.new(0.5, 0.6, 1.5), CFrame.new(0, y, -0.25), 0.22, DARK)
	partCF(ctx, "GunStripe", nil, Vector3.new(0.54, 0.16, 1.1), CFrame.new(0, y + 0.12, -0.25), color)
	part(ctx, "Trigger", nil, Vector3.new(0.14, 0.42, 0.16), Vector3.new(0, 0.3, -0.5), CFrame.Angles(math.rad(-12), 0, 0), Color3.fromRGB(255, 200, 60))
	tube(ctx, "TriggerGuard", { Vector3.new(0, 0.5, -0.9), Vector3.new(0, 0.05, -0.85), Vector3.new(0, -0.05, -0.35) }, 0.1, DARK)
	part(ctx, "Coupler", Enum.PartType.Cylinder, Vector3.new(0.35, 0.36, 0.36), Vector3.new(0, y, -1.1), ALONG_Z, BRASS, Enum.Material.Metal)
	bar(ctx, "Lance", Vector3.new(0, y, -1.25), Vector3.new(0, y, -7.6), 0.2, CHROME, Enum.Material.Metal)
	bar(ctx, "ForeGrip", Vector3.new(0, y, -2.4), Vector3.new(0, y, -3.4), 0.38, RUBBER)
	part(ctx, "NozzleCollar", Enum.PartType.Cylinder, Vector3.new(0.2, 0.32, 0.32), Vector3.new(0, y, -7.62), ALONG_Z, CHROME, Enum.Material.Metal)
	part(ctx, "LanceTip", Enum.PartType.Cylinder, Vector3.new(0.4, 0.34, 0.34), Vector3.new(0, y, -7.9), ALONG_Z, Color3.fromRGB(255, 200, 60))
	muzzle(ctx, Vector3.new(0, y, -8.15))
	tube(ctx, "Hose", { Vector3.new(0, -0.55, 0.2), Vector3.new(0, -1.0, 0.45), Vector3.new(0, -1.7, 0.5), Vector3.new(0, -2.3, 0.3) }, 0.2, Color3.fromRGB(30, 32, 38))
end

-- Foam cannon: a sleek blaster. White rounded body with colour stripes, a see-through soap tank on
-- top (pink soap, a cap), a brass adjuster knob, a stepped chrome-and-white bell, a rubber pistol
-- grip and trigger, and a burst of foam from the front.
BUILDERS.Cannon = function(ctx, color)
	local y = 2.6
	roundedBox(ctx, "Body", Vector3.new(1.1, 1.3, 3.2), CFrame.new(0, y, 0.6) * CFrame.Angles(0, 0, math.rad(90)), 0.55, WHITE)
	for _, dz in { -0.4, 0.2 } do
		partCF(ctx, "Stripe", nil, Vector3.new(1.16, 1.36, 0.18), CFrame.new(0, y, 0.6 + dz), color)
	end
	partCF(ctx, "TopRail", nil, Vector3.new(0.4, 0.2, 2.6), CFrame.new(0, y + 0.72, 0.8), shade(color, 0.75))
	-- Bell: stepped cylinders widening toward the front, with a coloured rim.
	part(ctx, "Neck", Enum.PartType.Cylinder, Vector3.new(0.8, 0.95, 0.95), Vector3.new(0, y, -1.3), ALONG_Z, CHROME, Enum.Material.Metal)
	part(ctx, "Bell1", Enum.PartType.Cylinder, Vector3.new(0.5, 1.4, 1.4), Vector3.new(0, y, -1.9), ALONG_Z, WHITE)
	part(ctx, "Bell2", Enum.PartType.Cylinder, Vector3.new(0.5, 1.9, 1.9), Vector3.new(0, y, -2.35), ALONG_Z, WHITE)
	part(ctx, "Bell3", Enum.PartType.Cylinder, Vector3.new(0.4, 2.35, 2.35), Vector3.new(0, y, -2.75), ALONG_Z, WHITE)
	ring(ctx, "BellRim", CFrame.new(0, y, -2.97), 1.2, 0.2, color, nil, 16)
	part(ctx, "BellMouth", Enum.PartType.Cylinder, Vector3.new(0.05, 2.1, 2.1), Vector3.new(0, y, -2.96), ALONG_Z, Color3.fromRGB(230, 235, 245))
	muzzle(ctx, Vector3.new(0, y, -3.1))
	-- Soap tank on top: glass with soap inside, a cap and a brass adjuster.
	part(ctx, "TankSeat", Enum.PartType.Cylinder, Vector3.new(0.25, 1.35, 1.35), Vector3.new(0, y + 0.78, 0.5), UPRIGHT, shade(color, 0.75))
	part(ctx, "Tank", Enum.PartType.Cylinder, Vector3.new(1.7, 1.25, 1.25), Vector3.new(0, y + 1.75, 0.5), UPRIGHT, Color3.fromRGB(230, 245, 255), Enum.Material.Glass, 0.45)
	part(ctx, "Soap", Enum.PartType.Cylinder, Vector3.new(1.05, 1.05, 1.05), Vector3.new(0, y + 1.45, 0.5), UPRIGHT, Color3.fromRGB(255, 140, 210), nil, 0.1)
	part(ctx, "SoapBubble", Enum.PartType.Ball, Vector3.one * 0.3, Vector3.new(0.2, y + 2.05, 0.4), nil, WHITE, nil, 0.3)
	part(ctx, "TankCap", Enum.PartType.Cylinder, Vector3.new(0.3, 1.35, 1.35), Vector3.new(0, y + 2.73, 0.5), UPRIGHT, color)
	knob(ctx, "Adjuster", CFrame.new(0.72, y, -0.5), 0.5, 0.6, BRASS, shade(BRASS, 0.8))
	-- Pistol grip, trigger and guard.
	local gripCF = CFrame.new(0, 1.35, 1.55) * CFrame.Angles(math.rad(-14), 0, 0)
	roundedBox(ctx, "Grip", Vector3.new(0.85, 2.1, 1.0), gripCF, 0.4, RUBBER)
	for i = 0, 2 do
		partCF(ctx, "FingerRidge", Enum.PartType.Cylinder, Vector3.new(0.87, 0.26, 0.26), gripCF * CFrame.new(0, 0.55 - i * 0.45, -0.5), shade(RUBBER, 1.35))
	end
	tube(ctx, "Trigger", { Vector3.new(0, 1.95, 0.75), Vector3.new(0, 1.55, 0.65), Vector3.new(0, 1.2, 0.75) }, 0.26, color)
	tube(ctx, "Guard", { Vector3.new(0, 1.95, 0.2), Vector3.new(0, 1.3, 0.2), Vector3.new(0, 0.85, 0.55), Vector3.new(0, 0.75, 1.15) }, 0.14, DARK)
	-- Foam burst.
	for _, f in { { Vector3.new(0, y, -3.3), 1.3 }, { Vector3.new(0.6, y + 0.5, -3.6), 0.9 }, { Vector3.new(-0.55, y + 0.45, -3.55), 0.85 }, { Vector3.new(0.3, y - 0.55, -3.5), 0.75 }, { Vector3.new(-0.3, y + 1.0, -3.9), 0.55 }, { Vector3.new(0.15, y + 0.2, -4.1), 0.6 } } do
		part(ctx, "Foam", Enum.PartType.Ball, Vector3.one * f[2], f[1], nil, WHITE, nil, 0.05)
	end
end

-- `held` picks the in-hand version of a tool when it has one (the washer's gun and lance).
function ToolModels.Build(toolIndex: number, scale: number?, held: boolean?): Model
	local model = Instance.new("Model")
	model.Name = "Tool_" .. tostring(toolIndex)
	local ctx: Ctx = { Model = model, Scale = scale or 1 }
	local grip = part(ctx, "Grip", nil, Vector3.new(0.2, 0.2, 0.2) / ctx.Scale, Vector3.zero, nil, WHITE)
	grip.Transparency = 1
	model.PrimaryPart = grip
	-- Builders are keyed by tool Id, so reordering or removing tools in Config never mixes models up.
	local tool = Config.Tools[toolIndex]
	local builder = tool and ((held and HELD_BUILDERS[tool.Id]) or BUILDERS[tool.Id])
	if builder then
		builder(ctx, tool.Color or WHITE)
	end
	return model
end

-- Grip placement relative to an R15 RightHand (R6 Right Arm is handled by the caller's offset).
-- The tool sits just in front of the hand, business end pointing forward.
function ToolModels.HoldOffset(toolIndex: number): CFrame
	local tool = Config.Tools[toolIndex]
	if tool and tool.Id == "Washer" then
		-- The held washer is built round its pistol grip: the hand closes on the grip itself.
		return CFrame.new(0, -0.15, -0.1)
	end
	return CFrame.new(0, -0.9, -0.6)
end

return ToolModels</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000000A"><Properties><string name="Name">Types</string><ProtectedString name="Source">-- Shapes of every table that crosses the network. Annotate with these on both sides, e.g.
--   local state: Types.RunState = { ... }            (server, when building a payload)
--   local run = ClientState.Run :: Types.RunState?   (client, when reading one)
-- so the type checker catches a misspelt field on either end.
--
-- Remote rules to remember: tables sent over remotes lose metatables and Instances outside the
-- receiver's view become nil; mixed or sparse numeric keys break. Only use arrays or string keys.

export type PartyMember = {
	UserId: number,
	Name: string,
	DisplayName: string,
}

-- PartyState (S-&gt;C) - nil when the player is not in a party.
export type PartyState = {
	PadId: number,
	HostUserId: number,
	IsHost: boolean,
	Members: { PartyMember }, -- in join order; Members[1] is the longest-waiting member
	MaxPlayers: number, -- 1..4
	Privacy: "Public" | "Friends",
	Level: number, -- index into Config.Levels
	HostUnlocked: number, -- highest level the host may pick
	EndsAt: number, -- workspace:GetServerTimeNow() when the countdown hits 0
	Status: "Picking" | "Waiting" | "Launching", -- Picking = the host is on the Create Party screen
}

-- Upgrade levels bought inside a run (keys = Config.Upgrades[i].Id).
export type RunUpgrades = {
	Hold: number,
	HandSize: number,
	ScrubPower: number,
	TankSize: number,
	Sneakers: number,
}

-- Output of Config.GetRunStats.
export type RunStats = {
	Radius: number,
	Power: number,
	TankMax: number,
	Reach: number,
	WalkSpeed: number,
	Hold: boolean,
	CoinMult: number,
	ToolIndex: number,
	Tier: number, -- the tool's Tier (dirt with MinTool above this cleans slowly)
	Mode: string, -- "Scrub" | "Spray" | "Line" | "Foam" (see Config.Tools)
	PetPower: number, -- what pets' PowerShare multiplies (tool-independent)
	LineLength: number?, -- Line only
	LineWidth: number?,
	FoamInterval: number?, -- Foam only
	FoamSeconds: number?,
	FoamShare: number?,
}

export type ResultRow = {
	UserId: number,
	Name: string,
	Grime: number, -- spots this player (and their pets) cleaned
	Share: number, -- 0..1 of all spots in the run
	Bubbles: number, -- Bubbles this player earned
}

export type RunResults = {
	TimeSeconds: number,
	ParTime: number,
	UnderPar: boolean,
	FirstClear: boolean, -- true for the receiving player only if this was their first clear of the level
	NewBest: boolean, -- receiving player's personal best
	UnlockedLevel: number?, -- level index newly unlocked for the receiving player
	Bubbles: number, -- Bubbles the receiving player earned
	Players: { ResultRow },
	ReturnAt: number, -- server time when everyone is sent back to the lobby
}

-- RunState (S-&gt;C) - nil when the player is not in a run.
export type RunState = {
	Level: number,
	ArenaName: string, -- child of workspace.Arenas
	StartedAt: number, -- server time
	ClockAt: number, -- server time the run clock started (0 = still waiting on the intro cutscene)
	Phase: "Playing" | "Complete",
	Coins: number,
	Tank: number,
	TankMax: number,
	ToolIndex: number, -- the tool in your hand
	OwnedTools: { boolean }, -- [toolIndex] = owned (every index present)
	ToolUpgrades: { RunUpgrades }, -- [toolIndex] = that tool's own HandSize / ScrubPower levels
	Upgrades: RunUpgrades, -- effective levels for the tool in hand (its per-tool + global ones)
	Stats: RunStats,
	DrainPosition: Vector3,
	StationPosition: Vector3,
	Total: number, -- grime spots in the run
	Cleaned: number, -- grime spots cleaned so far
	Members: { number }, -- UserIds still in the run
	Results: RunResults?, -- set when Phase == "Complete"
}

export type PetEntry = {
	Uid: string,
	Id: string, -- key into Config.Pets
	Tier: number?, -- 1 normal (nil = 1), 2 Golden, 3 Rainbow (Config.PetTiers)
}

-- MetaState (S-&gt;C) - the player's permanent data.
export type MetaState = {
	Bubbles: number,
	Gems: number, -- premium currency (rank rolls)
	Rank: string, -- equipped rank id, "" = none
	Ranks: { string }, -- every rank id owned
	Perks: { [string]: number }, -- Config.Perks[i].Id -&gt; level
	Pets: { PetEntry },
	Equipped: { string }, -- Uids
	PetSlots: number,
	MaxPets: number,
	Unlocked: number, -- highest level index unlocked
	BestTimes: { number }, -- per level index, seconds; 0 = never cleared
	Rebirths: number,
	RebirthReady: boolean, -- the last level was cleared since the last rebirth
	DailyStreak: number, -- day of the daily-reward streak last claimed (1..7)
	DailyClaimedToday: boolean, -- true while the next daily reward is still on its timer
	DailyReadyAt: number, -- os.time() when the next daily reward unlocks (0 = never claimed)
	DailyBroken: boolean, -- a day was missed: the next claim restarts at day 1 unless restored
	GroupReward: boolean, -- the community reward has been claimed
	FollowState: string, -- "" / "Pending" (checked when you rejoin) / "Claimed"
	LikeState: string, -- "" / "Pending" (paid when you rejoin) / "Claimed"
	BoostUntil: number?, -- os.time() until which cleaning is x2 (the stay boost)
	StayBoostReady: boolean?, -- today's free stay boost can still be claimed
	PetsResting: boolean?, -- pets switched off: they follow you but don't clean
	PetIndex: { [string]: number }?, -- every pet species/tier ever owned (bits 1/2/4)
	PetIndexPaid: { [string]: boolean }?, -- tier sets whose Gems were paid
	Referrals: number?, -- friends who joined through your invites (paid out)
	AdLuckStacks: number?, -- rewarded ads stacked for rank luck (0..MaxAds), while AdLuckUntil lasts
	AdLuckUntil: number?,
	ChestFreeLeft: number?, -- free Treasure Chests left in the current event
	ChestsOpened: number?,
	ClubId: string?, -- "" = not in a club
	LevelsBeaten: number?, -- highest level ever cleared (club requirements)
	Stats: {
		Runs: number,
		DishesCleaned: number,
		GrimeCleaned: number,
		EggsHatched: number,
		BubblesEarned: number,
	},
	Passes: { [string]: boolean }, -- Config.GamePasses[i].Key -&gt; owned
	Episodes: { number }?, -- per level: cutscene chapters seen (the next run plays the next chapter)
}

-- Results of RemoteFunction calls.
export type RequestResult = {
	Ok: boolean,
	Error: string?,
	Pets: { PetEntry }?, -- MetaRequest "Hatch"
	Rank: string?, -- MetaRequest "RollRank": the rank rolled
	Equipped: boolean?, -- MetaRequest "RollRank": always true now (a roll replaces your rank)
	Previous: string?, -- MetaRequest "RollRank": the rank you had before
	Message: string?, -- ClaimDaily / RedeemCode / ClaimGroup: what you got ("🧼 300 + 💎 10")
	Day: number?, -- ClaimDaily: the streak day claimed
}

-- RunFX payloads (S-&gt;C), by kind.
export type FXCleaned = {
	Position: Vector3,
	Color: Color3,
	Units: number,
	By: number, -- UserId (0 if unknown)
	Golden: boolean,
	Bubbles: number, -- golden spots only, else 0
	Pet: boolean, -- cleaned by a pet
}

export type FXDishDone = {
	Position: Vector3,
	Kind: string,
	By: number,
	Bonus: number, -- coins paid to By
}

export type FXSold = {
	Coins: number,
	Units: number,
	By: number,
}

return {}</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000000B"><Properties><string name="Name">Util</string><ProtectedString name="Source">-- Small helpers shared by server and client.

local Util = {}

----------------------------------------------------------------------------------------------------
-- Signal: a tiny event object (no BindableEvent, so tables pass through untouched).
--   local s = Util.Signal.new(); local c = s:Connect(fn); s:Fire(...); c:Disconnect()
-- Handlers run in their own thread (task.spawn), so a yielding handler never blocks Fire.
----------------------------------------------------------------------------------------------------
export type Connection = { Connected: boolean, Disconnect: (self: Connection) -&gt; () }
export type Signal = {
	Connect: (self: Signal, fn: (...any) -&gt; ()) -&gt; Connection,
	Once: (self: Signal, fn: (...any) -&gt; ()) -&gt; Connection,
	Fire: (self: Signal, ...any) -&gt; (),
	Wait: (self: Signal) -&gt; ...any,
	DisconnectAll: (self: Signal) -&gt; (),
}

local Signal = {}
Signal.__index = Signal

function Signal.new(): Signal
	return (setmetatable({ _handlers = {} }, Signal) :: any) :: Signal
end

function Signal:Connect(fn)
	local handlers = self._handlers
	local connection
	connection = {
		Connected = true,
		Disconnect = function(c)
			if not c.Connected then
				return
			end
			c.Connected = false
			local i = table.find(handlers, connection)
			if i then
				table.remove(handlers, i)
			end
		end,
		_fn = fn,
	}
	table.insert(handlers, connection)
	return connection
end

function Signal:Once(fn)
	local connection
	connection = self:Connect(function(...)
		connection:Disconnect()
		fn(...)
	end)
	return connection
end

function Signal:Fire(...)
	-- Copy first so handlers can disconnect themselves while we iterate.
	for _, c in table.clone(self._handlers) do
		if c.Connected then
			task.spawn(c._fn, ...)
		end
	end
end

function Signal:Wait()
	local thread = coroutine.running()
	self:Once(function(...)
		task.spawn(thread, ...)
	end)
	return coroutine.yield()
end

function Signal:DisconnectAll()
	for _, c in table.clone(self._handlers) do
		c:Disconnect()
	end
end

Util.Signal = Signal

----------------------------------------------------------------------------------------------------
-- Tables and randomness
----------------------------------------------------------------------------------------------------

function Util.DeepCopy&lt;T&gt;(value: T): T
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for k, v in value :: any do
		copy[Util.DeepCopy(k)] = Util.DeepCopy(v)
	end
	return copy :: any
end

-- Fills missing keys in `target` from `template` (recursively). Used to migrate old save data.
function Util.Reconcile(target: { [any]: any }, template: { [any]: any })
	for k, v in template do
		if target[k] == nil then
			target[k] = Util.DeepCopy(v)
		elseif type(v) == "table" and type(target[k]) == "table" then
			Util.Reconcile(target[k], v)
		end
	end
	return target
end

-- Picks one entry from a list of { ..., [weightKey] = number }. rng is an optional Random.
function Util.WeightedPick&lt;T&gt;(entries: { T }, weightKey: string, rng: Random?): T
	local total = 0
	for _, e in entries do
		total += (e :: any)[weightKey]
	end
	local roll = (if rng then rng:NextNumber() else math.random()) * total
	for _, e in entries do
		roll -= (e :: any)[weightKey]
		if roll &lt;= 0 then
			return e
		end
	end
	return entries[#entries]
end

function Util.Shuffle&lt;T&gt;(list: { T }, rng: Random?): { T }
	for i = #list, 2, -1 do
		local j = if rng then rng:NextInteger(1, i) else math.random(1, i)
		list[i], list[j] = list[j], list[i]
	end
	return list
end

-- Server time that is identical on every client (use for countdowns).
function Util.Now(): number
	return workspace:GetServerTimeNow()
end

-- True if the value is a finite Vector3 (no NaN / inf). Use on anything a client sends.
function Util.IsFiniteVector3(v: any): boolean
	if typeof(v) ~= "Vector3" then
		return false
	end
	for _, n in { v.X, v.Y, v.Z } do
		if n ~= n or n == math.huge or n == -math.huge then
			return false
		end
	end
	return true
end

return Util</ProtectedString></Properties></Item>
</Item>
</Item>
<Item class="ServerScriptService" referent="RBX0000000C"><Properties><string name="Name">ServerScriptService</string></Properties>
<Item class="Folder" referent="RBX0000000D"><Properties><string name="Name">Admin</string></Properties>
<Item class="Script" referent="RBX0000000E"><Properties><string name="Name">AdminServer</string><bool name="Disabled">false</bool><token name="RunContext">1</token><ProtectedString name="Source">--!nocheck
-- AdminServer (Script, ServerScriptService.Admin) - Rinse Cycle's admin commands.
--
-- Ported from the owner's admin system for another game: the moderation commands (kick/mute/
-- tempmute/warn/msg/goto/ban/tempban/freeze/unfreeze/bring/warnlist/banlist/mutelist/announce/
-- cmdlogs/playerlogs/kill/jail/god/respawn/spectate/controlplayer/invis/viewinv/clearinv/fly/give)
-- are kept as they were. The game-specific ones were swapped for Rinse Cycle's:
--   :setrank/:promote/:demote   -&gt; our rolled Ranks (Config.Ranks)
--   :setpoints                  -&gt; :setbubbles / :setgems
--   :givegamepass/:removegamepass -&gt; our game passes (Config.GamePasses), honoured by DataService
--   :daily                      -&gt; our 24-hour daily reward streak
--   :dirtycinema/:cleancinema   -&gt; :finishrun (cleans a player's whole dishwasher)
--   :training/:resettraining    -&gt; :givecoins, :givepet, :unlockall, :setrebirths
--
-- ONLY THE OWNER can use any of it: in a live server the one account allowed is
-- Config.Social.CreatorUserId (by UserId, which Roblox guarantees is unique). Nobody else gets a
-- panel, a command list, or even an "unknown command" hint that anything exists. In Studio every
-- tester counts as the owner (your own machine, your own place file).
--
-- Permission checks are always re-verified here - never trusted from the client.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local DataStoreService = game:GetService("DataStoreService")
local MarketplaceService = game:GetService("MarketplaceService")
local TextChatService = game:GetService("TextChatService")
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")
local TweenService = game:GetService("TweenService") -- swings the jail cell door
local ServerScriptService = game:GetService("ServerScriptService")

-- Rinse Cycle's own services (shared module instances with the rest of the server).
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))
local GameServices = ServerScriptService:WaitForChild("Server"):WaitForChild("Services")
local DataService = require(GameServices:WaitForChild("DataService"))
local RoundService = require(GameServices:WaitForChild("RoundService"))
local PetService = require(GameServices:WaitForChild("PetService"))
local LeaderboardService = require(GameServices:WaitForChild("LeaderboardService"))
local RunServers = require(GameServices:WaitForChild("RunServers"))
local DailyNotify = require(GameServices:WaitForChild("DailyNotify"))
local MessagingService = game:GetService("MessagingService")
local TeleportService = game:GetService("TeleportService")

-- The big "congrats" popup with confetti (Celebrate on the client).
local function celebrate(player, title, text, icon)
	pcall(function()
		Remotes.Event("Celebrate"):FireClient(player, title, text, icon)
	end)
end

-- Quiet by default: the Output window only gets one "ready" line and real problems. Set VERBOSE
-- to true to see every step and every command in the Output window again.
local VERBOSE = false
local function log(...)
	if VERBOSE then
		print(...)
	end
end
-- True when DataStores can't be used at all (Studio without a published place / API access): every
-- save and load then fails the same way, so those failures stay silent instead of filling Output.
local storesOffline = false
local function dsWarn(message)
	local text = tostring(message)
	if text:find("StudioAccessToApisNotAllowed", 1, true) or text:find("publish", 1, true) or text:find("API Services", 1, true) then
		storesOffline = true
	end
	if not storesOffline then
		warn(text)
	end
end

-- :give (hand out Tools from a ServerStorage folder) isn't used in Rinse Cycle and was removed;
-- this empty stand-in keeps the leftover inventory helpers below working.
local giveableItemsFolder = Instance.new("Folder")

-- The one account allowed to use the admin system in a live server: EnderBuilda (display name
-- Klushy). Matched by UserId, with the username as a backup in case the id in Config changes.
local OWNER_USER_ID = Config.Social.CreatorUserId
local OWNER_USERNAME = "enderbuilda"

local function isOwnerAccount(player)
	return player.UserId == OWNER_USER_ID or string.lower(player.Name) == OWNER_USERNAME
end

-- GetDataStore throws in Studio when the place isn't published or "Enable Studio Access to API
-- Services" is off. A throw here used to stop this whole script before its remotes existed, so the
-- panel never appeared. A failed lookup now hands back a stand-in whose calls fail like a DataStore
-- outage; every caller already pcalls and carries on without saving.
local function getStore(name)
	local ok, store = pcall(function()
		return DataStoreService:GetDataStore(name)
	end)
	if ok and store then
		return store
	end
	storesOffline = true
	local function unavailable()
		error("DataStore unavailable", 2)
	end
	return {
		GetAsync = unavailable,
		SetAsync = unavailable,
		UpdateAsync = unavailable,
		RemoveAsync = unavailable,
		ListKeysAsync = unavailable,
	}
end

local ALL_COMMANDS = {
	"kick", "mute", "tempmute", "warn", "msg", "goto", "ban", "tempban",
	"freeze", "unfreeze", "bring", "warnlist", "banlist", "mutelist",
	"setrank", "promote", "demote", "announce", "cmdlogs", "playerlogs",
	"kill", "jail", "god", "respawn",
	"spectate", "controlplayer", "invis",
	"viewpets", "givepet",
	"fly", "noclip", "giant",
	"leaderboards", "globalannounce", "joinserver", "bringserver", "serverlist",
	"globalpoll",
}

-- =====================================================================
-- Studio-only testing commands
-- =====================================================================
-- These are NOT in ALL_COMMANDS, on purpose. Outside Studio they are not
-- registered as commands at all, so the server answers "Unknown command"
-- exactly as it would for a typo - it never admits they exist. They're
-- also never included in the command list sent to anyone who isn't the
-- owner, so their panel has no category to draw and nothing to
-- autocomplete. There is nothing for them to find in a live game.
--
-- Every one of them either manufactures currency, rewrites your own
-- permissions, or erases an audit trail. Any of those reaching an
-- ordinary player would be worse than a bug, which is why the gate is
-- "Studio, or you are the owner account" rather than "you are senior
-- enough" - a Developer or a Founder still gets nothing.
-- Nothing is hidden behind Studio any more: every command belongs to a staff tier (below), and
-- the owner-only ones (staff ranks, gifted passes, wiping the log) are only on the owner's list.
local STUDIO_ONLY_COMMANDS = { "abuseshow", "abusefx", "abusedebug", "notifytest" }

-- Commands FOUNDER alone gets, on top of everything Developer has.
--
-- Founder and Developer otherwise share one list (both are ALL_COMMANDS
-- below), so a genuinely Founder-only command needs its own. :setbubbles and
-- :setgems hand out the game's currencies - that's not
-- a Studio tool, it's a live one, but it's also not something a
-- Developer should be able to do on a whim.
-- Developer: everything on ALL_COMMANDS plus these game tools.
local FOUNDER_ONLY_COMMANDS = { "setbubbles", "setgems", "daily", "finishrun", "givecoins", "unlockall", "setrebirths" }

local STUDIO_ONLY_SET = {}
for _, name in ipairs(STUDIO_ONLY_COMMANDS) do
	STUDIO_ONLY_SET[name] = true
end

-- Gated on Studio ALONE, deliberately - not on tier as well.
--
-- Tier-gating these was a trap: :setadminrank is one of them, so setting
-- yourself to Moderator with it immediately dropped you below the bar
-- and every Studio command - including the one that would put you back -
-- became "unknown". The tool locked you out the first time you used it.
--
-- Studio is your own machine running your own place file, where anyone
-- present can edit the scripts outright, so tier adds no protection here
-- worth that failure mode. In a live server none of these exist at all,
-- which is the check that actually matters.
-- Forward-declared, assigned just below isOwner further down this file.
--
-- A bare declaration then an assignment, NOT a second `local function`
-- down there: re-declaring would create a new local, and the closure
-- below would keep the nil it captured here. Same trap that has bitten
-- this file before.
local ownerCheck

-- Studio, OR the owner account in a live server.
--
-- Not tier-gated, deliberately. :setadminrank is one of these, so setting
-- yourself to Moderator with it immediately dropped you below any tier
-- bar and every command here - including the one that would put you back
-- - became "unknown". The tool locked you out the first time you used it.
--
-- Studio is your own machine running your own place file, where anyone
-- present can edit the scripts outright, so tier adds no protection there
-- worth that failure mode. In a live server the username is the check
-- that matters, and it is the one thing Roblox guarantees is unique - a
-- display name isn't, and a tier is something an exploited remote could
-- try to talk its way into.
--
-- Anyone who is not the owner still gets no trace of these at all: they
-- are absent from the command list the panel is built from, so there is
-- nothing to render, nothing to autocomplete, and running one by hand
-- reports "Unknown command" rather than a refusal.
local function canUseStudioCommands(player)
	if RunService:IsStudio() then return true end
	return ownerCheck ~= nil and ownerCheck(player) == true
end

-- The staff ranks the owner can hand out with :setadminrank ("Founder" is the owner alone).
local STUDIO_TIER_VALUES = { "Moderator", "Admin", "Developer" }
-- Admin: every Punish command, plus the Move ones except pulling people (Bring, Bring any server)
-- and Control Player.
local ADMIN_TIER_COMMANDS = {
	"kick", "mute", "tempmute", "warn", "ban", "tempban", "warnlist", "banlist", "mutelist",
	"goto", "joinserver", "spectate", "serverlist",
}
local TIER_COMMANDS = {
	-- Moderator: the Punish commands except banning.
	Moderator = { "kick", "mute", "tempmute", "warn", "warnlist", "mutelist" },
	Admin = ADMIN_TIER_COMMANDS,
	-- Developer: every command, except the owner's own (staff ranks, gifted passes, wiping logs).
	Developer = (function()
		local list = table.clone(ALL_COMMANDS)
		for _, name in ipairs(FOUNDER_ONLY_COMMANDS) do
			table.insert(list, name)
		end
		return list
	end)(),
	-- The owner: everything.
	Founder = (function()
		local list = table.clone(ALL_COMMANDS)
		for _, name in ipairs(FOUNDER_ONLY_COMMANDS) do
			table.insert(list, name)
		end
		for _, name in ipairs({ "setadminrank", "stafflist", "wipelogs", "givegamepass", "removegamepass", "globalgive", "globalpassdrop", "globalboost", "globalcountdown", "cancelcountdown" }) do
			table.insert(list, name)
		end
		return list
	end)(),
}

-- Built from Founder's list, which is the superset - this set only
-- answers "is this a real command at all", and a Founder-only command
-- still has to be real for everyone, or the permission check below never
-- gets a chance to give a lower tier the proper refusal.
local ALL_COMMANDS_SET = {}
for _, name in ipairs(TIER_COMMANDS.Founder) do
	ALL_COMMANDS_SET[name] = true
end

-- =====================================================================
-- Staff ranks (Moderator / Admin / Developer), given by the owner with :setadminrank.
-- Saved in one DataStore record (userId -&gt; { Tier, Name }), so they last, apply in every server,
-- and can be taken away while the person is offline (:stafflist). A change is broadcast to every
-- server (MessagingService), which applies it on the spot: no rejoin needed.
-- =====================================================================
local Staff = {
	Map = {} :: { [string]: { Tier: string, Name: string } },
	Store = getStore("RinseCycleStaffTiers"),
	Key = "staff",
	Topic = "RinseCycle_StaffChanged",
	-- Tag shown before the name (chat and overhead): text and colour per tier.
	Tags = { Moderator = "MOD", Admin = "ADMIN", Developer = "DEV", Founder = "OWNER" },
}

function Staff.Load()
	local ok, value = pcall(function()
		return Staff.Store:GetAsync(Staff.Key)
	end)
	if ok then
		Staff.Map = if type(value) == "table" then value else {}
	end
	return ok
end

-- Sets (tier) or clears (nil) a user's staff rank in the saved record. Returns true once saved.
function Staff.Save(userId, tier, name)
	local newMap
	local ok, err = pcall(function()
		Staff.Store:UpdateAsync(Staff.Key, function(old)
			local map = if type(old) == "table" then old else {}
			map[tostring(userId)] = if tier then { Tier = tier, Name = name } else nil
			newMap = map
			return map
		end)
	end)
	if ok and newMap then
		Staff.Map = newMap
	elseif not ok then
		-- DataStores unavailable (Studio without API access): keep it for this session at least.
		dsWarn("[AdminServer] couldn't save staff rank: " .. tostring(err))
		Staff.Map[tostring(userId)] = if tier then { Tier = tier, Name = name } else nil
	end
	return ok
end

function Staff.TierOf(userId)
	local entry = Staff.Map[tostring(userId)]
	return if type(entry) == "table" and type(entry.Tier) == "string" then entry.Tier else nil
end

-- Every server of the game, for the admin's "All servers" list (filled in at the bottom).
local ServerList = {}
local GlobalEvents = { Commands = {} } -- the panel's Global tab (filled in near the bottom)

local function getPlayerTier(player)
	-- Studio-only testing override, set via Studio's Command Bar (View &gt;
	-- Command Bar) while Play testing:
	--   game.Players.YourName:SetAttribute("AdminTierOverride", "Founder")
	-- Valid values are "Moderator", "Admin", "Developer", "Founder" - any
	-- other value (including a typo) is ignored and falls through to the
	-- real group-rank check below. RunService:IsStudio() is false in the
	-- published/live game, so this can never grant admin there no matter
	-- what an attribute is set to - it only exists inside Studio.
	if RunService:IsStudio() then
		local override = player:GetAttribute("AdminTierOverride")
		if override and TIER_COMMANDS[override] then
			return override
		end
	end

	-- The owner, by UserId; then anyone the owner made staff.
	if isOwnerAccount(player) then return "Founder" end
	local staffTier = Staff.TierOf(player.UserId)
	if staffTier and TIER_COMMANDS[staffTier] then return staffTier end
	-- In Studio every tester is treated as the owner - it's your own machine and place file.
	if RunService:IsStudio() then return "Founder" end
	return nil
end

local function tierHasCommand(tier, commandName)
	if not tier then return false end
	local commands = TIER_COMMANDS[tier]
	if not commands then return false end
	for _, name in ipairs(commands) do
		if name == commandName then return true end
	end
	return false
end

-- =====================================================================
-- Remotes
-- =====================================================================
-- Every RemoteEvent / RemoteFunction this script makes, in one table (Luau allows at most 200
-- top-level locals in a script, and this one is big).
local Remote = {}

Remote.GetAdminInfo = Instance.new("RemoteFunction")
Remote.GetAdminInfo.Name = "GetAdminInfo"
Remote.GetAdminInfo.Parent = ReplicatedStorage

-- Turns a technical Tool name (lowercase, no spaces - "glock17", "btools")
-- into a nicer autocomplete label ("Glock 17", "Btools") by inserting a
-- space before a trailing run of digits and before an internal capital
-- letter, then capitalizing the first letter of each resulting word. An
-- explicit DisplayName attribute on the Tool (set it directly in Studio)
-- always wins over the guess, for the rare name this can't get right on
-- its own (e.g. "noclip" guesses "Noclip", not "No Clip").
local function prettifyItemName(rawName)
	local spaced = rawName:gsub("(%a)(%d)", "%1 %2"):gsub("(%l)(%u)", "%1 %2")
	local words = {}
	for word in spaced:gmatch("%S+") do
		table.insert(words, word:sub(1, 1):upper() .. word:sub(2))
	end
	return table.concat(words, " ")
end

local function getItemDisplayName(item)
	local override = item:GetAttribute("DisplayName")
	if typeof(override) == "string" and override ~= "" then
		return override
	end
	return prettifyItemName(item.Name)
end

local function currentGiveableItemNames()
	local names = {}
	for _, item in ipairs(giveableItemsFolder:GetChildren()) do
		table.insert(names, getItemDisplayName(item))
	end
	table.sort(names)
	return names
end

-- Deleting an entry from the command log isn't a rank power - it's an
-- owner power. Every tier above Moderator can READ the log; exactly one
-- account can remove anything from it, because the whole point of an
-- audit trail is that the people it records can't edit it. Matched
-- case-insensitively against the username, which is what Roblox
-- guarantees is unique (a display name isn't).
local function isOwner(player)
	if player == nil then return false end
	if isOwnerAccount(player) then return true end

	-- Studio fallback. A Studio test client is very often NOT signed in
	-- under the owner's username - multi-client testing names its players
	-- "Player1", "Player2", and even a solo playtest can come up as
	-- something else depending on how the session was started - so the
	-- username check alone made this impossible to actually test. Studio
	-- is also not a place where the check is protecting anything: it's
	-- your own machine, running your own place file, and anyone there can
	-- already edit the scripts outright.
	--
	-- Gated on Founder rather than just "in Studio" so it still tracks
	-- who you've deliberately granted the top tier to via the
	-- AdminTierOverride attribute, instead of handing it to every test
	-- dummy in the session. Never applies in a live server, where the
	-- username is the only thing that counts.
	if RunService:IsStudio() and getPlayerTier(player) == "Founder" then
		return true
	end
	return false
end

-- Hands the real implementation to the forward declaration above, which
-- canUseStudioCommands closed over before isOwner existed.
ownerCheck = isOwner

-- =====================================================================
-- Gifted gamepasses
-- =====================================================================
-- :givegamepass and :removegamepass let the owner hand somebody a pass
-- without them paying for it, and take it back. Testing tool first and
-- foremost - checking what the shop, the passes and the x2 payouts
-- actually do for an owner is otherwise a real Robux purchase every time
-- - but it works in a live server too, so it doubles as a way to make
-- good on a failed purchase.
--
-- A grant never touches Roblox's own record - it cannot: the real entitlement lives on Roblox's
-- side and only a purchase changes it. This is the game choosing to treat someone as an owner.
local GamepassGrantStore = getStore("RinseCycleGamepassGrants")

-- Rinse Cycle's passes come straight from Config.GamePasses, matched by Key ("doublecoins"), by
-- name ("2x Coins") or by Id once one is pasted in. A grant is stored by Key (passes can still
-- have Id 0 while they're being set up) as a GP_&lt;Key&gt; attribute on the player, and handed to
-- DataService.SetPass so every system that reads passes honours it. MarketService keeps a gifted
-- pass on when Roblox says the player hasn't bought it.
local GAMEPASS_NAMES = {}
for _, pass in ipairs(Config.GamePasses) do
	table.insert(GAMEPASS_NAMES, string.lower(pass.Key))
end

local function gamepassAttribute(key)
	return "GP_" .. tostring(key)
end

-- Accepts a Key, a name or a raw Id. Returns the Config.GamePasses entry, or nil.
local function resolveGamepass(text)
	if typeof(text) ~= "string" then return nil end
	local cleaned = text:lower():gsub("[^%w]", "")
	local asNumber = tonumber(text)
	for _, pass in ipairs(Config.GamePasses) do
		if string.lower(pass.Key) == cleaned or (pass.Name:lower():gsub("[^%w]", "")) == cleaned
			or (asNumber and pass.Id ~= 0 and pass.Id == asNumber) then
			return pass
		end
	end
	return nil
end

local function grantKey(userId)
	return "grants_" .. tostring(userId)
end

-- Applies every gifted pass to the game's own pass table once the profile exists.
local function applyGrantsToGame(player)
	task.spawn(function()
		if not DataService.WaitFor(player, 30) then return end
		for name, value in pairs(player:GetAttributes()) do
			local key = name:match("^GP_(.+)$")
			if key and value == true then
				DataService.SetPass(player, key, true)
			end
		end
	end)
end

local function loadGamepassGrants(player)
	local ok, value = pcall(function()
		return GamepassGrantStore:GetAsync(grantKey(player.UserId))
	end)
	if not ok then
		dsWarn("[AdminServer] Failed to load gamepass grants for " .. player.Name .. ": " .. tostring(value))
		return
	end
	if type(value) ~= "table" then return end

	for _, key in ipairs(value) do
		if type(key) == "string" then
			player:SetAttribute(gamepassAttribute(key), true)
		end
	end
	applyGrantsToGame(player)
end

-- Rebuilt from the attributes rather than tracked separately, so the
-- saved record and what the game is actually honouring cannot drift.
local function saveGamepassGrants(player)
	local granted = {}
	for name, value in pairs(player:GetAttributes()) do
		local key = name:match("^GP_(.+)$")
		if key and value == true then
			table.insert(granted, key)
		end
	end

	task.spawn(function()
		local ok, err = pcall(function()
			GamepassGrantStore:SetAsync(grantKey(player.UserId), granted)
		end)
		if not ok then
			dsWarn("[AdminServer] Failed to save gamepass grants for " .. player.Name .. ": " .. tostring(err))
		end
	end)
end

local function setGamepassGrant(player, pass, granted, bought)
	player:SetAttribute(gamepassAttribute(pass.Key), granted or nil)
	saveGamepassGrants(player)
	DataService.SetPass(player, pass.Key, granted or bought == true)
end

Players.PlayerAdded:Connect(loadGamepassGrants)
for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(loadGamepassGrants, player)
end

-- CanRemoveLogs is sent to the client so the panel knows whether to draw
-- the Remove button at all. It's a display hint only - the server checks
-- isOwner again on the actual removal, since anything a client is told
-- is something a client can lie about.
local function tierInfo(tier, player)
	if not tier then return {Tier = nil, Commands = {}, GiveableItems = {}, CanRemoveLogs = false} end
	-- The Studio testing commands are appended to what the client is told
	-- exists, and ONLY in Studio. Outside it the client never receives
	-- these names, so it cannot render the category, cannot autocomplete
	-- them, and has no record that they exist - the panel is built
	-- entirely from this list.
	local commands = TIER_COMMANDS[tier]
	if canUseStudioCommands(player) then
		commands = table.clone(commands)
		for _, name in ipairs(STUDIO_ONLY_COMMANDS) do
			table.insert(commands, name)
		end
	end

	return {
		Tier = tier,
		Commands = commands,
		GiveableItems = currentGiveableItemNames(),
		CanRemoveLogs = isOwner(player),
	}
end

Remote.GetAdminInfo.OnServerInvoke = function(player)
	local info = tierInfo(getPlayerTier(player), player)
	-- Prints the name the server actually sees alongside the verdict, so
	-- a missing Remove button can be diagnosed from the Output window
	-- rather than guessed at - the usual cause is the test client not
	-- being signed in under the owner's username at all.
	log(string.format(
		"[AdminServer] Remote.GetAdminInfo for '%s' -&gt; tier %s, canRemoveLogs %s",
		player.Name, tostring(info.Tier), tostring(info.CanRemoveLogs)
	))
	return info
end

