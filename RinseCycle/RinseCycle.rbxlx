	{ "rect", x = 0.31, y = 0.76, w = 0.3, h = 0.22, r = 0.5, fill = { rgb(190, 150, 255), rgb(130, 80, 240) }, o = true },
	{ "rect", x = 0.71, y = 0.68, w = 0.3, h = 0.22, r = 0.5, fill = { rgb(190, 150, 255), rgb(130, 80, 240) }, o = true },
