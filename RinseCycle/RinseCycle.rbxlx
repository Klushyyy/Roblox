-- Fired whenever a player's tier might have changed after their client
-- already checked once - :setadminrank, in Studio or by the owner in a
-- live game. Without
-- this, setting the override attribute from the Command Bar after a
-- client's one-time Remote.GetAdminInfo check already ran (which is nearly
-- always the case in practice - it takes real time just to reach the
-- Command Bar and type the line) had no visible effect until rejoining,
-- which loses the attribute anyway since Play sessions don't persist it.
Remote.AdminInfoChanged = Instance.new("RemoteEvent")
Remote.AdminInfoChanged.Name = "AdminInfoChanged"
Remote.AdminInfoChanged.Parent = ReplicatedStorage

-- NOT Studio-only.
--
-- It used to be, on the reasoning that only the Studio testing override
-- ever changed a tier mid-session. That was wrong: :setadminrank is
-- gated on "Studio, OR you are the owner", so the owner can run it in a
-- live game - and there the attribute was set, the rank label changed,
-- and the client was never told, so the person was given a staff rank
-- with no admin panel to go with it.
-- Puts a player's current tier into effect right now: their panel (built, changed or taken away)
-- and the [MOD] / [ADMIN] / [DEV] / [OWNER] tag (player attribute StaffTag, read by NameTags and
-- ChatNames).
function Staff.Apply(player)
	local tier = getPlayerTier(player)
	-- In Studio every tester counts as the owner for testing, but only the real owner wears [OWNER].
	local tag = if tier == "Founder" and not isOwnerAccount(player) then nil else Staff.Tags[tier or ""]
	player:SetAttribute("StaffTag", tag)
	Remote.AdminInfoChanged:FireClient(player, tierInfo(tier, player))
end

local function watchOverride(player)
	player:GetAttributeChangedSignal("AdminTierOverride"):Connect(function()
		Staff.Apply(player)
	end)
	Staff.Apply(player)
end
for _, player in ipairs(Players:GetPlayers()) do
	watchOverride(player)
end
Players.PlayerAdded:Connect(watchOverride)

-- The saved staff ranks: read at start and every 2 minutes; another server's change is heard at once.
task.spawn(function()
	while true do
		if Staff.Load() then
			for _, player in ipairs(Players:GetPlayers()) do
				Staff.Apply(player)
			end
		end
		task.wait(120)
	end
end)
task.spawn(function()
	pcall(function()
		MessagingService:SubscribeAsync(Staff.Topic, function(message)
			local data = message.Data
			local userId = type(data) == "table" and tonumber(data.UserId)
			if not userId then
				return
			end
			if type(data.Tier) == "string" then
				Staff.Map[tostring(userId)] = { Tier = data.Tier, Name = tostring(data.Name or "") }
			else
				Staff.Map[tostring(userId)] = nil
			end
			local player = Players:GetPlayerByUserId(userId)
			if player then
				Staff.Apply(player)
			end
		end)
	end)
end)

-- Gives (tier) or takes away (nil) a staff rank: saved, applied here now, and told to every server.
function Staff.Set(userId, tier, name)
	Staff.Save(userId, tier, name)
	local player = Players:GetPlayerByUserId(userId)
	if player then
		Staff.Apply(player)
	end
	task.spawn(function()
		pcall(function()
			MessagingService:PublishAsync(Staff.Topic, { UserId = userId, Tier = tier, Name = name })
		end)
	end)
end

log("[AdminServer] Remotes ready")

-- =====================================================================
-- Shared helpers
-- =====================================================================
-- Days included once a duration reaches 24h - "167h 59m" for a 7-day mute
-- is technically correct but unreadable at a glance compared to "6d 23h".
-- Minutes are dropped once days are shown (matching the existing
-- hours-drops-minutes-only-below-1h convention one step further) since a
-- day-scale duration doesn't need minute precision.
local function formatDuration(seconds)
	if seconds &lt;= 0 then return "less than a minute" end
	local days = math.floor(seconds / 86400)
	local hours = math.floor((seconds % 86400) / 3600)
	local minutes = math.floor((seconds % 3600) / 60)
	if days &gt; 0 then
		return days .. "d " .. hours .. "h"
	end
	if hours &gt; 0 then
		return hours .. "h " .. minutes .. "m"
	end
	return minutes .. "m"
end

-- Enumerates every key ever written to a DataStore via
-- DataStoreService:ListKeysAsync, rather than maintaining a hand-rolled
-- index table alongside it. An index is one more piece of state that
-- can silently drift out of sync with the real records - which is
-- exactly what happened here: two bans written before an index existed
-- at all never appeared on :banlist, because nothing had ever added
-- them to it. Listing the store's actual keys can't ever miss a record
-- like that, no matter when it was written.
local function listAllKeys(store)
	local keys = {}
	local success, pages = pcall(function()
		return store:ListKeysAsync()
	end)
	if not success then
		dsWarn("[AdminServer] ListKeysAsync failed: " .. tostring(pages))
		return keys
	end
	while true do
		local ok, currentPage = pcall(function() return pages:GetCurrentPage() end)
		if not ok then break end
		for _, keyInfo in ipairs(currentPage) do
			table.insert(keys, keyInfo.KeyName)
		end
		if pages.IsFinished then break end
		local advanced = pcall(function() pages:AdvanceToNextPageAsync() end)
		if not advanced then break end
	end
	return keys
end

-- Memoizes Players:GetNameFromUserIdAsync - a network call - across every
-- list render in this server session, rather than re-resolving the same
-- offline user's name every single time :banlist/:mutelist/:warnlist is
-- opened. Names essentially never change mid-session for this purpose.
local usernameCache = {}
local function resolveUsername(userId)
	if usernameCache[userId] then return usernameCache[userId] end
	local success, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	local resolved = (success and name) or ("UserId " .. tostring(userId))
	usernameCache[userId] = resolved
	return resolved
end

local DURATION_UNIT_SECONDS = {
	h = 3600, hr = 3600, hrs = 3600, hour = 3600, hours = 3600,
	d = 86400, day = 86400, days = 86400,
	w = 604800, wk = 604800, wks = 604800, week = 604800, weeks = 604800,
}

-- Parses a duration off the front of :tempban/:tempmute's free-text
-- argument, accepting both a compact suffix ("24h", "3D", "1w") and a
-- spelled-out unit with a space ("24 hours", "20 days", "2 weeks") -
-- case-insensitive either way. Returns (seconds, remainingText) on a
-- match, or (nil, originalText) if the text doesn't start with a
-- recognizable duration at all.
local function parseDurationAndReason(text)
	text = text or ""
	local compactNum, compactUnit, compactRest = text:match("^(%d+%.?%d*)(%a+)%s*(.*)$")
	if compactNum and DURATION_UNIT_SECONDS[string.lower(compactUnit)] then
		return math.floor(tonumber(compactNum) * DURATION_UNIT_SECONDS[string.lower(compactUnit)]), compactRest
	end

	local spacedNum, spacedUnit, spacedRest = text:match("^(%d+%.?%d*)%s+(%a+)%s*(.*)$")
	if spacedNum and DURATION_UNIT_SECONDS[string.lower(spacedUnit)] then
		return math.floor(tonumber(spacedNum) * DURATION_UNIT_SECONDS[string.lower(spacedUnit)]), spacedRest
	end

	return nil, text
end

-- =====================================================================
-- Ban persistence - supports an optional expiry (ExpiresAt, a unix
-- timestamp) for temporary bans; nil/absent means permanent.
-- =====================================================================
local BanStore = getStore("RinseCycleBans")

-- Authoritative in-memory mirror of BanStore - [userIdStr] = banData, or
-- false for "checked, not banned". Seeded once at startup below and kept
-- in sync by every write this script makes (banUser/unbanUser are the
-- only things that ever write to BanStore), which is what turns
-- :banlist from "ListKeysAsync + one GetAsync per banned user, every
-- single time the list is opened" (slow enough to feel laggy, and the
-- exact thing that made modifying a reason/duration feel delayed too,
-- since that also re-renders the list the same way) into a purely
-- in-memory read after the one-time startup cost.
local banRecordsCache = {}

local function isBanned(userId)
	local userIdStr = tostring(userId)
	local cached = banRecordsCache[userIdStr]
	if cached ~= nil then
		return cached or nil
	end
	local success, data = pcall(function()
		return BanStore:GetAsync(userIdStr)
	end)
	if success then
		banRecordsCache[userIdStr] = data or false
		return data
	end
	dsWarn("[AdminServer] Failed to check ban status for " .. userIdStr .. ": " .. tostring(data))
	return nil
end

-- Cache updated FIRST, synchronously, with the actual SetAsync/RemoveAsync
-- call kicked off in the background afterward - this is what actually
-- fixed "modifying a ban/mute/warning feels delayed" (the DataStore-read
-- caching earlier in this file only sped up OPENING a list; every WRITE
-- path here still did a blocking network call to Roblox's DataStore
-- service BEFORE sending the refreshed list back to the client, which is
-- exactly the "second or so" lag - SetAsync/RemoveAsync latency is real
-- network time, not something server-side caching alone can remove). The
-- in-memory cache is already the sole source of truth for every read in
-- this file, so the client-visible result (list refresh, popup closing)
-- can safely reflect the change immediately; the persisted copy just
-- catches up a moment later. On the rare failure of that background
-- write, this only warns - the change still holds for the rest of this
-- server session via the cache, which is an acceptable trade for admin
-- tooling responsiveness.
-- waitForPersist forces the actual DataStore write to complete before
-- this returns, instead of firing it in the background. Every caller
-- that immediately Kicks the target after this (:ban, :tempban, the
-- warning-threshold auto-ban) MUST pass true: the background-write
-- version returns before the save has actually reached the DataStore,
-- and if the server stops shortly after (a live server cycling, or -
-- guaranteed - stopping Play in Studio to test rejoining) that ban was
-- never actually persisted, so a fresh server never sees it and the ban
-- silently does nothing. This is exactly what "temp ban doesn't work
-- when I rejoin" traced back to. Editing an existing ban's reason/
-- duration from the Modify popup doesn't Kick anyone, so it can keep
-- using the background-write path for speed - see the comment above
-- this whole section for why that matters for admin-tool
-- responsiveness.
local function banUser(userId, reason, bannedBy, durationSeconds, waitForPersist)
	local data = {
		Reason = reason,
		BannedBy = bannedBy,
		Timestamp = os.time(),
		ExpiresAt = durationSeconds and (os.time() + durationSeconds) or nil,
	}
	banRecordsCache[tostring(userId)] = data
	local function persist()
		local success, err = pcall(function()
			BanStore:SetAsync(tostring(userId), data)
		end)
		if not success then
			dsWarn("[AdminServer] Failed to save ban for " .. tostring(userId) .. ": " .. tostring(err))
		end
	end
	if waitForPersist then
		persist()
	else
		task.spawn(persist)
	end
	return true
end

local function unbanUser(userId)
	banRecordsCache[tostring(userId)] = false
	task.spawn(function()
		local success, err = pcall(function()
			BanStore:RemoveAsync(tostring(userId))
		end)
		if not success then
			dsWarn("[AdminServer] Failed to remove ban for " .. tostring(userId) .. ": " .. tostring(err))
		end
	end)
	return true
end

do
	local keys = listAllKeys(BanStore)
	for _, userIdStr in ipairs(keys) do
		local success, data = pcall(function()
			return BanStore:GetAsync(userIdStr)
		end)
		banRecordsCache[userIdStr] = (success and data) or false
	end
	log("[AdminServer] Ban cache seeded: " .. #keys .. " record(s)")
end

local function buildBanListEntries()
	local entries = {}
	for userIdStr, banData in pairs(banRecordsCache) do
		if banData then
			local userId = tonumber(userIdStr)
			if banData.ExpiresAt and os.time() &gt;= banData.ExpiresAt then
				-- Expired temp ban - clean it up instead of listing it.
				-- Safe to call mid-iteration: this only overwrites an
				-- existing key's value (to false), never adds/removes one.
				unbanUser(userId)
			else
				local displayName = resolveUsername(userId)
				local durationText = banData.ExpiresAt
					and ("Expires in " .. formatDuration(math.max(0, banData.ExpiresAt - os.time())))
					or "Permanent"
				table.insert(entries, {
					Id = userIdStr,
					Name = displayName,
					Reason = banData.Reason,
					DurationText = durationText,
					Line1 = displayName .. ((banData.Reason and banData.Reason ~= "") and (" - " .. banData.Reason) or ""),
					Line2 = "banned by " .. tostring(banData.BannedBy) .. " - " .. durationText,
				})
			end
		end
	end
	table.sort(entries, function(a, b) return a.Line1 &lt; b.Line1 end)
	return entries
end

Players.PlayerAdded:Connect(function(player)
	local banData = isBanned(player.UserId)
	if not banData then return end

	if banData.ExpiresAt and os.time() &gt;= banData.ExpiresAt then
		-- Temp ban has expired - clean up the record and let them in.
		unbanUser(player.UserId)
		return
	end

	-- Delayed rather than instant - kicking the moment the Player object
	-- exists (the previous behavior) landed mid-way through the client's
	-- own loading-screen -&gt; main menu sequence, which is why a banned
	-- player who didn't immediately dismiss the kick dialog saw a broken
	-- half-loaded menu behind it: the topbar/menu buttons (built almost
	-- instantly by their own scripts) were up, but the loading screen's
	-- asset-loading step (which is what actually gates the transition
	-- into the game world/camera settling into its normal framed view)
	-- hadn't finished yet. Waiting here gives that sequence time to fully
	-- complete first, so a banned player sees the exact same properly-
	-- rendered main menu as anyone else for the few seconds before the
	-- kick lands - they still can't do anything with it, this is purely
	-- so what's behind the kick dialog isn't broken.
	task.wait(8)
	if not player.Parent then return end -- already left on their own during the wait

	local message = "You are banned from this game.\nReason: " .. tostring(banData.Reason or "No reason given")
	if banData.ExpiresAt then
		message = message .. "\nTime remaining: " .. formatDuration(banData.ExpiresAt - os.time())
	end
	player:Kick(message)
end)

-- =====================================================================
-- Warnings - persisted per UserId (works for offline players too, e.g.
-- :warnlist covers someone who has since left) so nothing is lost when
-- a player leaves. Reaching certain totals auto-escalates: 3rd warning
-- kicks, 5th bans for 24 hours, 7th bans permanently.
-- =====================================================================
local WarningStore = getStore("RinseCycleWarnings")

-- Authoritative in-memory mirror of WarningStore - [userIdStr] = the
-- warnings array (possibly empty). getWarnings/saveWarnings are the only
-- things that ever touch WarningStore, so this stays in sync without
-- needing to re-list/re-fetch from the DataStore on every :warnlist open
-- - same reasoning as banRecordsCache above.
local warningRecordsCache = {}

local function getWarnings(userId)
	local userIdStr = tostring(userId)
	if warningRecordsCache[userIdStr] then
		return warningRecordsCache[userIdStr]
	end
	local success, data = pcall(function()
		return WarningStore:GetAsync(userIdStr)
	end)
	local warnings = (success and data) or {}
	warningRecordsCache[userIdStr] = warnings
	return warnings
end

-- Cache-first, background-persisted - see the comment above banUser for
-- why (this is exactly what made "remove a warning takes a second to
-- actually go away" happen: the old blocking SetAsync ran before
-- Remote.AdminWarningsList:FireClient below ever fired).
local function saveWarnings(userId, warnings)
	warningRecordsCache[tostring(userId)] = warnings
	task.spawn(function()
		local success, err = pcall(function()
			WarningStore:SetAsync(tostring(userId), warnings)
		end)
		if not success then
			dsWarn("[AdminServer] Failed to save warnings for " .. tostring(userId) .. ": " .. tostring(err))
		end
	end)
	return true
end

do
	local keys = listAllKeys(WarningStore)
	for _, userIdStr in ipairs(keys) do
		local success, data = pcall(function()
			return WarningStore:GetAsync(userIdStr)
		end)
		warningRecordsCache[userIdStr] = (success and data) or {}
	end
	log("[AdminServer] Warning cache seeded: " .. #keys .. " record(s)")
end

local function buildWarnListEntries()
	local entries = {}
	for userIdStr, warnings in pairs(warningRecordsCache) do
		if warnings and #warnings &gt; 0 then
			local userId = tonumber(userIdStr)
			local displayName = resolveUsername(userId)
			table.insert(entries, {
				Id = userIdStr,
				Name = displayName,
				Line1 = displayName .. " - " .. #warnings .. " warning(s)",
				Line2 = "latest: " .. tostring(warnings[#warnings].Reason) .. " (by " .. tostring(warnings[#warnings].By) .. ")",
			})
		end
	end
	table.sort(entries, function(a, b) return a.Line1 &lt; b.Line1 end)
	return entries
end

-- =====================================================================
-- Mute - filters chat delivery via TextChatService rather than blocking
-- the message client-side, so a muted player can't just ignore a local
-- flag. Persisted per UserId (like bans/warnings) so :mutelist can show
-- everyone ever muted, online or not, and a mute survives the muted
-- player leaving and rejoining. mutedUserIds is kept as a plain
-- in-memory cache of the persisted data for whichever muted users are
-- currently online, since the chat filter below runs on every single
-- message and can't afford an async DataStore call per message.
-- =====================================================================
local MuteStore = getStore("RinseCycleMutes")
local mutedUserIds = {} -- [userId] = {Reason=, By=, Timestamp=, ExpiresAt=} - online users only, mirrors MuteStore

-- Authoritative in-memory mirror of MuteStore covering EVERYONE ever
-- muted, online or not - [userIdStr] = muteData, or false for "checked,
-- not muted". This is separate from mutedUserIds above (which only ever
-- tracks currently-online muted players, for the chat filter's per-
-- message hot path) - getMuteData/saveMuteData/removeMuteData are the
-- only things that ever touch MuteStore, so keeping this in sync there
-- means :mutelist never needs to re-list/re-fetch from the DataStore.
local muteRecordsCache = {}

local function getMuteData(userId)
	local userIdStr = tostring(userId)
	local cached = muteRecordsCache[userIdStr]
	if cached ~= nil then
		return cached or nil
	end
	local success, data = pcall(function()
		return MuteStore:GetAsync(userIdStr)
	end)
	if success then
		muteRecordsCache[userIdStr] = data or false
		return data
	end
	return nil
end

-- Cache-first, background-persisted - see the comment above banUser.
-- waitForPersist - same reasoning as banUser: an edit that only reached
-- the in-memory cache before the server happened to stop would silently
-- revert once a fresh server reseeds from the DataStore.
local function saveMuteData(userId, data, waitForPersist)
	muteRecordsCache[tostring(userId)] = data
	local function persist()
		local success, err = pcall(function()
			MuteStore:SetAsync(tostring(userId), data)
		end)
		if not success then
			dsWarn("[AdminServer] Failed to save mute for " .. tostring(userId) .. ": " .. tostring(err))
		end
	end
	if waitForPersist then
		persist()
	else
		task.spawn(persist)
	end
	return true
end

local function removeMuteData(userId)
	muteRecordsCache[tostring(userId)] = false
	task.spawn(function()
		pcall(function()
			MuteStore:RemoveAsync(tostring(userId))
		end)
	end)
end

do
	local keys = listAllKeys(MuteStore)
	for _, userIdStr in ipairs(keys) do
		local success, data = pcall(function()
			return MuteStore:GetAsync(userIdStr)
		end)
		muteRecordsCache[userIdStr] = (success and data) or false
	end
	log("[AdminServer] Mute cache seeded: " .. #keys .. " record(s)")
end

-- Dedups the "you are muted" reminder so a single blocked chat message
-- only pops the notice once, not once per other player subscribed to
-- the channel (ShouldDeliverCallback runs once per potential
-- recipient). Cleared periodically so it can't grow unbounded over a
-- long session.
local notifiedMuteMessageIds = {}
local notifiedMuteCount = 0
local function markMuteNotified(messageId)
	if notifiedMuteMessageIds[messageId] then return false end
	notifiedMuteMessageIds[messageId] = true
	notifiedMuteCount += 1
	if notifiedMuteCount &gt; 300 then
		notifiedMuteMessageIds = {}
		notifiedMuteCount = 0
	end
	return true
end

local function muteNoticeBody(muteData)
	local body
	if muteData.Reason and muteData.Reason ~= "" then
		body = muteData.Reason
	else
		body = muteData.ExpiresAt and "No reason given." or "You are permanently muted."
	end
	if muteData.ExpiresAt then
		body = body .. "\nExpires in: " .. formatDuration(math.max(0, muteData.ExpiresAt - os.time()))
	end
	return body
end

-- Shown every time a muted player's message gets blocked (not the
-- richer reason/duration notice above, which is only for the moment
-- they're actually muted) - a plain, consistent explanation of why
-- nothing happened when they tried to type.
local MUTE_TYPING_REMINDER = "You are currently muted. No one else can see your messages."

local function attachMuteFilter(channel)
	channel.ShouldDeliverCallback = function(message)
		-- Fails open (delivers the message) if anything here errors, so a
		-- bug in this filter can never silently break chat for everyone -
		-- worst case a mute doesn't take effect, instead of chat breaking.
		local ok, blocked = pcall(function()
			local source = message.TextSource
			if not source then return false end
			local muteData = mutedUserIds[source.UserId]
			if not muteData then return false end

			if muteData.ExpiresAt and os.time() &gt;= muteData.ExpiresAt then
				mutedUserIds[source.UserId] = nil
				removeMuteData(source.UserId)
				return false
			end

			if markMuteNotified(message.MessageId) then
				local mutedPlayerObj = Players:GetPlayerByUserId(source.UserId)
				if mutedPlayerObj then
					Remote.AdminNotice:FireClient(mutedPlayerObj, "You are muted", MUTE_TYPING_REMINDER)
				end
			end
			return true
		end)
		if not ok then return true end
		return not blocked
	end
	log("[AdminServer] Mute filter attached to " .. channel.Name)
end

-- The real mute: Roblox's own TextSource.CanSend. Every player has one TextSource per chat
-- channel; turning CanSend off stops the message at the source, so nobody (the sender included)
-- ever sees it. The delivery filter above stays on as a second line. Kept in sync by
-- syncChatMutes, run right after any mute change and every second (which also ends tempmutes on
-- time and tells the player).
local function isMutedNow(userId)
	local data = mutedUserIds[userId]
	if not data then return false end
	if data.ExpiresAt and os.time() &gt;= data.ExpiresAt then
		mutedUserIds[userId] = nil
		removeMuteData(userId)
		local plr = Players:GetPlayerByUserId(userId)
		if plr then
			Remote.AdminMuteStatus:FireClient(plr, false, nil)
			Remote.AdminNotice:FireClient(plr, "You are no longer muted", "Your mute has ended. You can chat again.")
		end
		return false
	end
	return true
end

local function applyTextSource(source)
	if not source:IsA("TextSource") then return end
	local canSend = not isMutedNow(source.UserId)
	if source.CanSend ~= canSend then
		source.CanSend = canSend
	end
end

local function syncChatMutes()
	local textChannels = TextChatService:FindFirstChild("TextChannels")
	if not textChannels then return end
	for _, channel in ipairs(textChannels:GetChildren()) do
		if channel:IsA("TextChannel") then
			for _, source in ipairs(channel:GetChildren()) do
				pcall(applyTextSource, source)
			end
		end
	end
end

task.spawn(function()
	while true do
		task.wait(1)
		pcall(syncChatMutes)
	end
end)

-- Attached to every current AND future text channel rather than a
-- single channel hardcoded by name ("RBXGeneral") - if this game's
-- channel is actually named something else, or there's more than one
-- (e.g. a team channel), hardcoding one name would silently mean
-- :mute never actually blocked anything even though the command itself
-- reported success.
task.spawn(function()
	-- Made by Roblox shortly after start (the place file turns on the modern chat). Waits quietly.
	local textChannels = TextChatService:FindFirstChild("TextChannels")
	local waited = 0
	while not textChannels do
		task.wait(1)
		waited += 1
		textChannels = TextChatService:FindFirstChild("TextChannels")
		if waited == 60 and not textChannels then
			warn("[AdminServer] Chat channels still missing after a minute: is Chat &gt; ChatVersion set to TextChatService? :mute needs it")
		end
	end
	local function watchChannel(channel)
		attachMuteFilter(channel)
		channel.ChildAdded:Connect(function(source)
			pcall(applyTextSource, source)
		end)
	end
	for _, channel in ipairs(textChannels:GetChildren()) do
		if channel:IsA("TextChannel") then
			watchChannel(channel)
		end
	end
	textChannels.ChildAdded:Connect(function(child)
		if child:IsA("TextChannel") then
			watchChannel(child)
		end
	end)
end)

Players.PlayerAdded:Connect(function(player)
	local muteData = getMuteData(player.UserId)
	if not muteData then return end
	if muteData.ExpiresAt and os.time() &gt;= muteData.ExpiresAt then
		removeMuteData(player.UserId)
		return
	end
	mutedUserIds[player.UserId] = muteData
	-- Restores the persistent "muted for/permanently muted" indicator on
	-- rejoin - without this, a still-muted player who leaves and comes
	-- back would only ever see it again the next time an admin touches
	-- their mute record.
	Remote.AdminMuteStatus:FireClient(player, true, muteData.ExpiresAt)
end)

-- Returns (nowMuted, muteData) - muteData is the new record when nowMuted
-- is true, nil when unmuting - so callers can fire Remote.AdminMuteStatus with
-- the right ExpiresAt without a second lookup.
local function toggleMute(target, admin, reason)
	if mutedUserIds[target.UserId] then
		mutedUserIds[target.UserId] = nil
		removeMuteData(target.UserId)
		return false, nil
	end
	local data = {Reason = reason, By = admin.Name, Timestamp = os.time(), ExpiresAt = nil}
	mutedUserIds[target.UserId] = data
	saveMuteData(target.UserId, data)
	return true, data
end

local function buildMuteListEntries()
	local entries = {}
	for userIdStr, data in pairs(muteRecordsCache) do
		if data then
			local userId = tonumber(userIdStr)
			if data.ExpiresAt and os.time() &gt;= data.ExpiresAt then
				-- Safe to call mid-iteration - see buildBanListEntries above.
				removeMuteData(userId)
				mutedUserIds[userId] = nil
			else
				local displayName = resolveUsername(userId)
				local durationText = data.ExpiresAt
					and ("Expires in " .. formatDuration(math.max(0, data.ExpiresAt - os.time())))
					or "Permanent"
				table.insert(entries, {
					Id = userIdStr,
					Name = displayName,
					Reason = data.Reason,
					DurationText = durationText,
					Line1 = displayName .. ((data.Reason and data.Reason ~= "") and (" - " .. data.Reason) or ""),
					Line2 = "muted by " .. tostring(data.By) .. " - " .. durationText,
				})
			end
		end
	end
	table.sort(entries, function(a, b) return a.Line1 &lt; b.Line1 end)
	return entries
end

-- =====================================================================
-- In-game rank management (:setrank/:promote/:demote): the rank shown under a player's name,
-- normally rolled with gems in the lobby. These bypass rolling entirely (that's the point of an
-- admin override) and write straight through to the saved profile.
-- =====================================================================
-- Rinse Cycle's ranks (Config.Ranks), ordered from the most common to the rarest, so :promote
-- and :demote step one rarity at a time. A rank set here is the player's equipped rank, the same
-- one a roll gives - it shows on their name tag straight away.
local IN_GAME_RANKS = {}
do
	for index, rank in ipairs(Config.Ranks) do
		local rarity = Config.RankRarities[rank.Rarity]
		table.insert(IN_GAME_RANKS, {Id = rank.Id, Label = rank.Name, Order = (rarity and rarity.Order or 0) * 1000 + index})
	end
	table.sort(IN_GAME_RANKS, function(a, b) return a.Order &lt; b.Order end)
end
local IN_GAME_RANK_INDEX = {}
for i, rank in ipairs(IN_GAME_RANKS) do
	IN_GAME_RANK_INDEX[rank.Id] = i
end

local function applyRank(target, rank)
	DataService.AddRank(target, rank.Id)
	DataService.SetRank(target, rank.Id)
	DataService.PassesChanged:Fire(target) -- name tag and run stats pick it up
end

local function getCurrentRankIndex(target)
	local profile = DataService.Get(target)
	local currentId = profile and profile.Rank
	return (currentId and IN_GAME_RANK_INDEX[currentId]) or 0
end

-- Matches by exact label/id first ("Dish Wizard" or its id), then falls back to an unambiguous prefix match
-- ("dish") - same case-insensitive partial-match convention as
-- findTargetPlayer below, just over the rank list instead of the
-- player list.
local function findRank(query)
	if typeof(query) ~= "string" then return nil, nil end
	-- Trimmed defensively - a stray leading/trailing space (e.g. from a
	-- client-side autocomplete quirk) would otherwise fail both the
	-- exact-match and prefix-match checks below even though the typed
	-- name is really a perfect match, reporting "no rank found" for a
	-- name that's actually correct.
	query = query:gsub("^%s+", ""):gsub("%s+$", "")
	if query == "" then return nil, nil end
	local lowerQuery = string.lower(query)

	for _, rank in ipairs(IN_GAME_RANKS) do
		if string.lower(rank.Label) == lowerQuery or string.lower(rank.Id) == lowerQuery then
			return rank, nil
		end
	end

	local matches = {}
	for _, rank in ipairs(IN_GAME_RANKS) do
		if string.sub(string.lower(rank.Label), 1, #lowerQuery) == lowerQuery then
			table.insert(matches, rank)
		end
	end
	if #matches == 1 then
		return matches[1], nil
	elseif #matches &gt; 1 then
		local names = {}
		for _, r in ipairs(matches) do table.insert(names, r.Label) end
		return nil, "Multiple ranks match \"" .. query .. "\": " .. table.concat(names, ", ")
	end
	return nil, nil
end

-- =====================================================================
-- Freeze / unfreeze - two explicit one-way commands rather than a
-- single toggle, so the sidebar/typed command always does exactly what
-- it says instead of depending on hidden state the admin has to
-- remember.
-- =====================================================================
local frozenUserIds = {}

local function setFrozen(target, frozen)
	local character = target.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	if not hrp then return false end
	hrp.Anchored = frozen
	frozenUserIds[target.UserId] = frozen or nil
	return true
end

-- =====================================================================
-- God mode - keeps a player's Humanoid topped up at full health for as
-- long as it's on, by re-asserting Health the instant it actually drops
-- (via HealthChanged) rather than polling. Like :freeze, this only ever
-- covers the CURRENT character - dying and respawning ends it, the same
-- way freezing doesn't carry over to a new life either; :god has to be
-- run again after a respawn if it's still wanted.
-- =====================================================================
local godModeUserIds = {}
local godModeConnections = {} -- [userId] = the HealthChanged connection while on

local function setGodMode(target, enabled)
	local userId = target.UserId
	local existingConn = godModeConnections[userId]
	if existingConn then
		existingConn:Disconnect()
		godModeConnections[userId] = nil
	end
	godModeUserIds[userId] = enabled or nil
	if not enabled then return true end

	local character = target.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		godModeUserIds[userId] = nil
		return false
	end
	humanoid.Health = humanoid.MaxHealth
	godModeConnections[userId] = humanoid.HealthChanged:Connect(function()
		if humanoid.Health &lt; humanoid.MaxHealth then
			humanoid.Health = humanoid.MaxHealth
		end
	end)
	return true
end

-- =====================================================================
-- Jail - a three-cell block with a corridor.
--
-- Earlier versions worth recording so they aren't retried: a plain
-- sealed cube (read as a storage cupboard), then bars added to the
-- INSIDE of one wall (bars with a solid wall behind them aren't bars,
-- they're wallpaper). The constraint behind both is that a genuine
-- barred opening 300 studs underground looks out into empty void, which
-- is worse again. The fix is a block big enough to contain the view:
-- cells facing a lit corridor, so there is somewhere real to look.
--
-- Everything here is built to read well at a GLANCE rather than to be
-- densely detailed. Procedural geometry gets worse, not better, the more
-- small props are thrown at it - a few well-proportioned, properly
-- grounded shapes look deliberate, while lots of little floating ones
-- look like an accident. Anything decorative is sized off the block's
-- own constants so nothing drifts if those change.
--
-- Placed BELOW the map rather than above it, but only moderately so:
-- Roblox destroys anything falling past workspace.FallenPartsDestroyHeight
-- (default -500, not set anywhere in these scripts). -300 keeps the
-- whole block clear of that with room to spare.
-- =====================================================================
local JAIL_CFRAME = CFrame.new(0, -300, 0)

-- Roomier than it first looks on paper: a 12-stud ceiling felt like a
-- crawlspace once a character was stood under it, and 14-deep cells left
-- no floor once a bunk was in.
-- The jail's sizes and colours, in one table (Luau allows at most 200 top-level locals, see Remote).
local Jail = {}
Jail.CELL_W, Jail.CELL_D, Jail.CELL_H = 18, 16, 16
Jail.CORRIDOR_D = 15
Jail.DIVIDER = 1
Jail.JAIL_WALL = 1
Jail.DOOR_WIDTH = 5

Jail.BLOCK_W = Jail.CELL_W * 3 + Jail.DIVIDER * 2
Jail.CELL_Z0, Jail.CELL_Z1 = -Jail.CELL_D - 1, -1
Jail.CORR_Z1 = Jail.CELL_Z1 + Jail.CORRIDOR_D
Jail.FLOOR_Y, Jail.CEIL_Y = -Jail.CELL_H / 2, Jail.CELL_H / 2
Jail.CELL_MID_Z = (Jail.CELL_Z0 + Jail.CELL_Z1) / 2
Jail.CORR_MID_Z = Jail.CELL_Z1 + Jail.CORRIDOR_D / 2
Jail.CELL_X = { -(Jail.CELL_W + Jail.DIVIDER), 0, Jail.CELL_W + Jail.DIVIDER }

local JAIL_SPAWN_CFRAME = JAIL_CFRAME * CFrame.new(0, Jail.FLOOR_Y + 4, Jail.CELL_MID_Z)

-- A narrow palette, and floor/walls deliberately different values so the
-- room has some contrast instead of being one flat grey.
Jail.C_WALL = Color3.fromRGB(104, 104, 108)
Jail.C_WALL_LOW = Color3.fromRGB(74, 74, 79)
Jail.C_FLOOR = Color3.fromRGB(58, 58, 62)
Jail.C_STEEL = Color3.fromRGB(78, 82, 90)
Jail.C_ACCENT = Color3.fromRGB(196, 158, 46)
Jail.C_MATTRESS = Color3.fromRGB(72, 86, 108)
Jail.C_PORCELAIN = Color3.fromRGB(198, 201, 206)
Jail.C_WOOD = Color3.fromRGB(96, 72, 52)

local jailFolder = Instance.new("Folder")
jailFolder.Name = "AdminJailCell"
jailFolder.Parent = workspace

-- Positions are LOCAL to the block, converted here, so every measurement
-- below reads as an offset from the block's own origin rather than an
-- absolute world coordinate. `rot` is applied after the offset, which is
-- what lets bars be cylinders (a cylinder Part runs along its X axis, so
-- standing one upright means rotating it 90 degrees about Z).
local function jailPart(props)
	local part = Instance.new("Part")
	part.Name = props.Name or "JailPart"
	part.Anchored = true
	part.CanCollide = props.CanCollide ~= false
	part.Material = props.Material or Enum.Material.Concrete
	part.Color = props.Color or Jail.C_WALL
	part.Size = props.Size
	part.CFrame = JAIL_CFRAME * CFrame.new(props.X or 0, props.Y or 0, props.Z or 0) * (props.Rot or CFrame.new())
	if props.Shape then part.Shape = props.Shape end
	part.Parent = props.Parent or jailFolder
	return part
end

local setCellDoorOpen

do
	local overlap = Jail.JAIL_WALL
	local blockCentreZ = (Jail.CELL_Z0 + Jail.CORR_Z1) / 2
	local blockDepth = Jail.CORR_Z1 - Jail.CELL_Z0
	local halfW = Jail.BLOCK_W / 2

	-- Shell. Every piece OVERLAPS its neighbours at the seams rather than
	-- butting edge-to-edge: parts that merely touch along a shared
	-- boundary can flicker straight through when the camera clips into
	-- the geometry, and overlapping solid material leaves no exact
	-- coincident edge to slip through.
	local shellW, shellD, shellH = Jail.BLOCK_W + overlap * 2, blockDepth + overlap * 2, Jail.CELL_H + overlap * 2
	jailPart({Name = "Floor", Size = Vector3.new(shellW, Jail.JAIL_WALL, shellD), Y = Jail.FLOOR_Y - Jail.JAIL_WALL / 2, Z = blockCentreZ, Color = Jail.C_FLOOR})
	-- Not as dark as the wall band: at the first pass the ceiling read as
	-- an open black void above the lights rather than as a surface.
	jailPart({Name = "Ceiling", Size = Vector3.new(shellW, Jail.JAIL_WALL, shellD), Y = Jail.CEIL_Y + Jail.JAIL_WALL / 2, Z = blockCentreZ, Color = Color3.fromRGB(88, 88, 93)})
	jailPart({Name = "WallBack", Size = Vector3.new(shellW, shellH, Jail.JAIL_WALL), Z = Jail.CELL_Z0 - Jail.JAIL_WALL / 2})
	jailPart({Name = "WallFront", Size = Vector3.new(shellW, shellH, Jail.JAIL_WALL), Z = Jail.CORR_Z1 + Jail.JAIL_WALL / 2})
	jailPart({Name = "WallLeft", Size = Vector3.new(Jail.JAIL_WALL, shellH, shellD), X = -halfW - Jail.JAIL_WALL / 2, Z = blockCentreZ})
	jailPart({Name = "WallRight", Size = Vector3.new(Jail.JAIL_WALL, shellH, shellD), X = halfW + Jail.JAIL_WALL / 2, Z = blockCentreZ})

	-- A darker band around the lower third of the walls. One horizontal
	-- line does more to stop a room reading as a flat grey box than any
	-- number of small props, because it gives the eye a height reference.
	local BAND_H = Jail.CELL_H * 0.34
	jailPart({Name = "BandFront", Size = Vector3.new(shellW, BAND_H, 0.12), Y = Jail.FLOOR_Y + BAND_H / 2, Z = Jail.CORR_Z1 - 0.06, Material = Enum.Material.SmoothPlastic, Color = Jail.C_WALL_LOW, CanCollide = false})
	for _, dir in ipairs({-1, 1}) do
		jailPart({Name = "BandSide", Size = Vector3.new(0.12, BAND_H, shellD), X = dir * (halfW - 0.06), Y = Jail.FLOOR_Y + BAND_H / 2, Z = blockCentreZ, Material = Enum.Material.SmoothPlastic, Color = Jail.C_WALL_LOW, CanCollide = false})
	end
	jailPart({Name = "BandStripe", Size = Vector3.new(shellW, 0.18, 0.14), Y = Jail.FLOOR_Y + BAND_H, Z = Jail.CORR_Z1 - 0.07, Material = Enum.Material.SmoothPlastic, Color = Jail.C_ACCENT, CanCollide = false})
	jailPart({Name = "FloorLine", Size = Vector3.new(Jail.BLOCK_W - 3, 0.06, 0.7), Y = Jail.FLOOR_Y + 0.04, Z = Jail.CORR_MID_Z, Material = Enum.Material.SmoothPlastic, Color = Jail.C_ACCENT, CanCollide = false})

	for i = 1, 2 do
		jailPart({Name = "CellDivider" .. i, Size = Vector3.new(Jail.DIVIDER, Jail.CELL_H, Jail.CELL_D + overlap), X = Jail.CELL_X[i] + Jail.CELL_W / 2 + Jail.DIVIDER / 2, Z = Jail.CELL_MID_Z})
	end

	local barTop, barBottom = Jail.CEIL_Y - 0.5, Jail.FLOOR_Y + 0.5
	local barHeight = barTop - barBottom
	local barMidY = (barTop + barBottom) / 2
	local doorHalf = Jail.DOOR_WIDTH / 2
	local UPRIGHT = CFrame.Angles(0, 0, math.rad(90))

	-- ROUND bars, not square ones. Square uprights were the single
	-- biggest reason the last version looked cheap - real cell bars are
	-- round, and a cylinder catches the light along its length instead of
	-- presenting one flat grey face.
	local function bar(name, x, y, z, length, thickness, parent)
		return jailPart({Name = name, Size = Vector3.new(length, thickness, thickness),
			X = x, Y = y, Z = z, Rot = UPRIGHT, Shape = Enum.PartType.Cylinder,
			Material = Enum.Material.Metal, Color = Jail.C_STEEL, Parent = parent})
	end

	local function buildCellFront(cellIndex)
		local cx = Jail.CELL_X[cellIndex]
		local function barsBetween(x0, x1, tag)
			local span = x1 - x0
			local count = math.max(2, math.floor(span / 1.45))
			for i = 0, count do
				bar("Bar" .. cellIndex .. tag .. i, x0 + span * (i / count), barMidY, Jail.CELL_Z1, barHeight, 0.34)
			end
		end
		barsBetween(cx - Jail.CELL_W / 2 + 0.5, cx - doorHalf - 0.5, "L")
		barsBetween(cx + doorHalf + 0.5, cx + Jail.CELL_W / 2 - 0.5, "R")

		-- Rails stop short of the doorway on both sides so the opening is
		-- genuinely open rather than crossed by a bar.
		local sideSpan = Jail.CELL_W / 2 - doorHalf
		for _, y in ipairs({barBottom + 0.2, barMidY, barTop - 0.2}) do
			for _, dir in ipairs({-1, 1}) do
				jailPart({Name = "BarRail", Size = Vector3.new(sideSpan, 0.26, 0.26),
					X = cx + dir * (doorHalf + sideSpan / 2), Y = y, Z = Jail.CELL_Z1,
					Material = Enum.Material.Metal, Color = Jail.C_STEEL, CanCollide = false})
			end
		end
		for _, dir in ipairs({-1, 1}) do
			jailPart({Name = "DoorPost", Size = Vector3.new(0.6, barHeight + 0.8, 0.6),
				X = cx + dir * doorHalf, Y = barMidY, Z = Jail.CELL_Z1,
				Material = Enum.Material.Metal, Color = Jail.C_STEEL})
		end
		jailPart({Name = "DoorLintel", Size = Vector3.new(Jail.DOOR_WIDTH + 1.2, 0.6, 0.55),
			X = cx, Y = barTop + 0.55, Z = Jail.CELL_Z1, Material = Enum.Material.Metal, Color = Jail.C_STEEL})

		local plate = jailPart({Name = "CellPlate", Size = Vector3.new(3, 1.3, 0.16),
			X = cx, Y = barTop + 1.6, Z = Jail.CELL_Z1, Material = Enum.Material.SmoothPlastic,
			Color = Jail.C_WALL_LOW, CanCollide = false})
		local sign = Instance.new("SurfaceGui")
		sign.Face = Enum.NormalId.Front
		sign.CanvasSize = Vector2.new(300, 130)
		sign.Parent = plate
		local label = Instance.new("TextLabel")
		label.Size = UDim2.new(1, 0, 1, 0)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.SourceSansBold
		label.TextColor3 = Jail.C_ACCENT
		label.TextScaled = true
		label.Text = "CELL " .. cellIndex
		label.Parent = sign
	end

	local function buildCellDoor(cellIndex)
		local cx = Jail.CELL_X[cellIndex]
		local door = Instance.new("Model")
		door.Name = "CellDoor" .. cellIndex
		door.Parent = jailFolder

		local frame = jailPart({Name = "DoorFrame", Size = Vector3.new(Jail.DOOR_WIDTH - 0.4, barHeight - 0.3, 0.3),
			X = cx, Y = barMidY, Z = Jail.CELL_Z1, Material = Enum.Material.Metal, Color = Jail.C_STEEL, Parent = door})
		frame.Transparency = 1
		door.PrimaryPart = frame

		for i = 1, 4 do
			bar("DoorBar" .. i, cx - Jail.DOOR_WIDTH / 2 + Jail.DOOR_WIDTH * (i / 5), barMidY, Jail.CELL_Z1, barHeight - 0.5, 0.3, door)
		end
		for _, y in ipairs({barMidY - barHeight / 2 + 0.5, barMidY, barMidY + barHeight / 2 - 0.5}) do
			jailPart({Name = "DoorRail", Size = Vector3.new(Jail.DOOR_WIDTH - 0.4, 0.24, 0.24),
				X = cx, Y = y, Z = Jail.CELL_Z1, Material = Enum.Material.Metal, Color = Jail.C_STEEL, Parent = door})
		end
		-- Slim and steel, kept close to the door plane. A chunky gold
		-- block standing proud of the bars just read as a stray part.
		jailPart({Name = "DoorHandle", Size = Vector3.new(0.18, 0.18, 0.95), X = cx + doorHalf - 0.75,
			Y = barMidY, Z = Jail.CELL_Z1 + 0.28, Material = Enum.Material.Metal, Color = Jail.C_STEEL, Parent = door})

		local hinge = JAIL_CFRAME * CFrame.new(cx - doorHalf, barMidY, Jail.CELL_Z1)
		local closedPivot = JAIL_CFRAME * CFrame.new(cx, barMidY, Jail.CELL_Z1)
		local openPivot = hinge * CFrame.Angles(0, math.rad(100), 0) * hinge:Inverse() * closedPivot

		local isOpen, activeTween = false, nil
		local function setOpen(open)
			if isOpen == open then return end
			isOpen = open
			-- Tweening a CFrameValue and mirroring it onto the model each
			-- frame: TweenService cannot animate a Model directly, and
			-- moving each bar on its own would let them drift apart.
			local driver = Instance.new("CFrameValue")
			driver.Value = door:GetPivot()
			local conn = driver.Changed:Connect(function(value) door:PivotTo(value) end)
			if activeTween then activeTween:Cancel() end
			activeTween = TweenService:Create(driver,
				TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
				{Value = open and openPivot or closedPivot})
			activeTween:Play()
			activeTween.Completed:Once(function()
				conn:Disconnect()
				driver:Destroy()
			end)
		end

		-- Staff-only, checked on the SERVER at click time. A ClickDetector
		-- fires for anyone who clicks it, so this tier check is the entire
		-- lock - there is no client-side gate to bypass because there
		-- isn't one. Attached to every part of the door so any bar works;
		-- only one part is hit per click, so it cannot double-toggle.
		for _, piece in ipairs(door:GetDescendants()) do
			if piece:IsA("BasePart") then
				local click = Instance.new("ClickDetector")
				click.MaxActivationDistance = 26
				click.Parent = piece
				click.MouseClick:Connect(function(clicker)
					if not getPlayerTier(clicker) then return end
					setOpen(not isOpen)
				end)
			end
		end
		return setOpen
	end

	-- Furniture is deliberately sparse, and everything either sits on the
	-- floor or is visibly braced to a wall. The previous pass had a basin
	-- and a desktop hanging in mid-air, which is the fastest way to make
	-- a build look broken.
	local function furnishCell(cellIndex)
		local cx = Jail.CELL_X[cellIndex]
		local bunkX = cx - Jail.CELL_W / 2 + 2.6
		local bunkY = Jail.FLOOR_Y + 2.1

		jailPart({Name = "BunkFrame", Size = Vector3.new(3.8, 0.35, 8), X = bunkX, Y = bunkY, Z = Jail.CELL_MID_Z, Material = Enum.Material.Metal, Color = Jail.C_STEEL})
		jailPart({Name = "Mattress", Size = Vector3.new(3.5, 0.5, 7.6), X = bunkX, Y = bunkY + 0.42, Z = Jail.CELL_MID_Z, Material = Enum.Material.Fabric, Color = Jail.C_MATTRESS})
		jailPart({Name = "Pillow", Size = Vector3.new(3.1, 0.35, 1.6), X = bunkX, Y = bunkY + 0.8, Z = Jail.CELL_MID_Z - 2.9, Material = Enum.Material.Fabric, Color = Color3.fromRGB(166, 170, 178)})
		-- Braced into the wall rather than standing on legs, so there is
		-- nothing to float: the slab runs into the divider behind it.
		jailPart({Name = "BunkBrace", Size = Vector3.new(0.5, bunkY - Jail.FLOOR_Y, 8), X = bunkX - 1.9, Y = Jail.FLOOR_Y + (bunkY - Jail.FLOOR_Y) / 2, Z = Jail.CELL_MID_Z, Material = Enum.Material.Metal, Color = Jail.C_STEEL})

		-- Sanitary fixtures, pushed FLUSH to the walls. Sitting them a
		-- stud or two clear of the wall is what made the previous pass
		-- read as white crates dumped in a corner rather than plumbing -
		-- real fixtures touch something.
		local wallX = cx + Jail.CELL_W / 2
		local backZ = Jail.CELL_Z0

		-- Bowl and seat as upright cylinders. A cube reads as a box no
		-- matter what colour it is; the round profile is most of what
		-- makes this legible as a toilet at a glance.
		jailPart({Name = "ToiletBowl", Size = Vector3.new(1.7, 1.8, 1.8), X = wallX - 1.7, Y = Jail.FLOOR_Y + 0.85, Z = backZ + 1.6, Rot = UPRIGHT, Shape = Enum.PartType.Cylinder, Material = Enum.Material.SmoothPlastic, Color = Jail.C_PORCELAIN})
		jailPart({Name = "ToiletSeat", Size = Vector3.new(0.22, 2.1, 2.1), X = wallX - 1.7, Y = Jail.FLOOR_Y + 1.81, Z = backZ + 1.6, Rot = UPRIGHT, Shape = Enum.PartType.Cylinder, Material = Enum.Material.SmoothPlastic, Color = Jail.C_WALL_LOW})
		jailPart({Name = "Cistern", Size = Vector3.new(2.2, 2.6, 0.7), X = wallX - 1.7, Y = Jail.FLOOR_Y + 3.1, Z = backZ + 0.45, Material = Enum.Material.SmoothPlastic, Color = Jail.C_PORCELAIN})

		-- Basin against the side wall, on a bracket that visibly reaches
		-- the floor so nothing appears to hang in mid-air.
		jailPart({Name = "Basin", Size = Vector3.new(1.3, 0.8, 2.4), X = wallX - 0.7, Y = Jail.FLOOR_Y + 3.3, Z = backZ + 5.4, Material = Enum.Material.SmoothPlastic, Color = Jail.C_PORCELAIN})
		jailPart({Name = "BasinStand", Size = Vector3.new(0.7, 2.9, 0.8), X = wallX - 0.45, Y = Jail.FLOOR_Y + 1.45, Z = backZ + 5.4, Material = Enum.Material.Metal, Color = Jail.C_STEEL})
	end

	for i = 1, 3 do
		buildCellFront(i)
		furnishCell(i)
	end

	local doorSetters = {}
	for i = 1, 3 do doorSetters[i] = buildCellDoor(i) end
	-- jail/unjail only ever use the centre cell, which is where
	-- JAIL_SPAWN_CFRAME puts people.
	setCellDoorOpen = doorSetters[2]

	-- Guard desk, built as a solid block with a top rather than a
	-- floating slab and a disconnected front panel.
	local deskX, deskZ = -halfW + 5, Jail.CORR_Z1 - 3.5
	jailPart({Name = "DeskBody", Size = Vector3.new(8, 3.2, 3), X = deskX, Y = Jail.FLOOR_Y + 1.6, Z = deskZ, Material = Enum.Material.WoodPlanks, Color = Jail.C_WOOD})
	jailPart({Name = "DeskTop", Size = Vector3.new(9, 0.35, 3.8), X = deskX, Y = Jail.FLOOR_Y + 3.38, Z = deskZ, Material = Enum.Material.WoodPlanks, Color = Jail.C_WOOD})
	jailPart({Name = "DeskChairSeat", Size = Vector3.new(2, 0.35, 2), X = deskX, Y = Jail.FLOOR_Y + 1.9, Z = deskZ + 3.4, Material = Enum.Material.SmoothPlastic, Color = Jail.C_WALL_LOW})
	jailPart({Name = "DeskChairBack", Size = Vector3.new(2, 2.2, 0.35), X = deskX, Y = Jail.FLOOR_Y + 3, Z = deskZ + 4.3, Material = Enum.Material.SmoothPlastic, Color = Jail.C_WALL_LOW})
	jailPart({Name = "DeskChairStem", Size = Vector3.new(0.5, 1.75, 0.5), X = deskX, Y = Jail.FLOOR_Y + 0.88, Z = deskZ + 3.4, Material = Enum.Material.Metal, Color = Jail.C_STEEL})

	-- Long recessed strip lights rather than bare points: a visible
	-- fixture reads as a light, while an invisible source just makes the
	-- room glow from nowhere. Dimmer and more numerous than before, which
	-- is what stops the harsh single-source look.
	local function stripLight(name, x, z, length)
		jailPart({Name = name .. "Housing", Size = Vector3.new(length, 0.35, 1.1), X = x, Y = Jail.CEIL_Y - 0.5, Z = z, Material = Enum.Material.Metal, Color = Jail.C_STEEL, CanCollide = false})
		local lens = jailPart({Name = name .. "Lens", Size = Vector3.new(length - 0.6, 0.12, 0.8), X = x, Y = Jail.CEIL_Y - 0.72, Z = z, Material = Enum.Material.Neon, Color = Color3.fromRGB(236, 242, 250), CanCollide = false})
		local light = Instance.new("PointLight")
		light.Brightness = 1.35
		light.Range = 26
		light.Color = Color3.fromRGB(226, 234, 245)
		light.Shadows = false
		light.Parent = lens
	end
	for i = 1, 3 do
		stripLight("CellLight" .. i, Jail.CELL_X[i], Jail.CELL_MID_Z, Jail.CELL_W * 0.45)
		stripLight("CorridorLightA" .. i, Jail.CELL_X[i], Jail.CORR_MID_Z - 3.5, Jail.CELL_W * 0.5)
		stripLight("CorridorLightB" .. i, Jail.CELL_X[i], Jail.CORR_MID_Z + 3.5, Jail.CELL_W * 0.5)
	end

	log("[AdminServer] Jail block built (3 cells)")
end

local jailedUserIds = {}

-- How long the server holds a teleport back after telling the client to
-- cover the screen. Must be at least the client's TRANSITION_SLIDE_TIME
-- (AdminClient.lua), because the cover is a wipe that slides in rather
-- than a cut: fire and teleport in the same breath and the panel slides
-- down over a jail the player has already been looking at, which makes
-- the reveal afterwards pointless. A small margin on top absorbs the
-- round trip to the client.
local JAIL_COVER_TIME = 0.75

local function jailPlayer(target)
	local character = target.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	if not hrp then return false end
	jailedUserIds[target.UserId] = true

	-- Cover first, move second - see JAIL_COVER_TIME. Backgrounded so the
	-- admin who ran :jail still gets their confirmation immediately
	-- instead of waiting out the transition playing on someone else's
	-- screen.
	Remote.AdminScreenFade:FireClient(target)
	task.spawn(function()
		task.wait(JAIL_COVER_TIME)
		-- Re-checked after the wait: they may have been released, or
		-- respawned into a different character, while the cover was
		-- sliding down. Teleporting a stale HumanoidRootPart would drop
		-- a freed player back into the cell.
		if not jailedUserIds[target.UserId] then return end
		if target.Character ~= character or hrp.Parent == nil then return end
		hrp.CFrame = JAIL_SPAWN_CFRAME
		-- Shut behind them. Only ever called from server code, so a
		-- jailed player has no way to open it themselves.
		setCellDoorOpen(false)
	end)
	return true
end

-- Sends them back to the game's normal spawn rather than trying to
-- remember exactly where they were before being jailed - simpler, and
-- always safe for what's meant to be a temporary punishment anyway.
local function unjailPlayer(target)
	if not jailedUserIds[target.UserId] then return false end
	jailedUserIds[target.UserId] = nil
	-- Swung open the moment an admin releases them - the visible half of
	-- "only an admin can open this". It closes again once nobody is left
	-- inside, at the end of this function.
	setCellDoorOpen(true)
	local character = target.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	if not hrp then return true end
	-- FindFirstChildOfClass only checks DIRECT children of workspace - a
	-- SpawnLocation nested inside a model/folder (as it is here, e.g.
	-- under the Lobby model) was never found that way, which is
	-- exactly why this warned "no SpawnLocation found" every time even
	-- though one genuinely exists. FindFirstChildWhichIsA's second
	-- argument makes it search every descendant instead of just direct
	-- children.
	local spawnLocation = workspace:FindFirstChildWhichIsA("SpawnLocation", true)
	if spawnLocation then
		-- The trip OUT is the one that most needed covering: sealed cell
		-- to open sky is the biggest lighting jump in the game, and it
		-- used to land as "every shadow is far too dark" for a second or
		-- two before snapping right. Same cover-then-move ordering as
		-- jailPlayer above.
		Remote.AdminScreenFade:FireClient(target)
		task.spawn(function()
			task.wait(JAIL_COVER_TIME)
			if target.Character ~= character or hrp.Parent == nil then return end
			hrp.CFrame = spawnLocation.CFrame + Vector3.new(0, 5, 0)

			-- Shut once the cell is actually empty. Checked rather than
			-- assumed: releasing one of two jailed players should not
			-- leave the door standing open for the one still in there.
			task.wait(1)
			if next(jailedUserIds) == nil then
				setCellDoorOpen(false)
			end
		end)
	else
		warn("[AdminServer] No SpawnLocation found anywhere in Workspace - unjailed player left in the jail cell")
	end
	return true
end

-- =====================================================================
-- Invis / uninvis - stores each part's ORIGINAL Transparency before
-- hiding it, so :uninvis restores exactly what it was rather than
-- assuming everything started at 0 (not true for accessories/clothing
-- that are already partially transparent by design). Like :freeze and
-- :god, this only covers the CURRENT character.
-- =====================================================================
local invisibleUserIds = {} -- [userId] = {[part] = {Transparency=, CanCollide=, CanTouch=}, ...}

-- Also drops CanCollide/CanTouch alongside Transparency (restoring all
-- three on uninvis) - Transparency alone only hides a part visually, it
-- doesn't stop anyone from walking into/standing on top of it, or from
-- physically-invisible-but-still-solid parts blocking movement or
-- tripping .Touched-based triggers. This matters most for :spectate
-- (below), which makes the spectating admin invisible for the duration -
-- without this, their own frozen body was still a solid, climbable
-- obstacle sitting right where they started spectating from.
local function setInvisible(target, invisible)
	local userId = target.UserId
	local character = target.Character
	if not character then return false end

	if invisible then
		if invisibleUserIds[userId] then return true end
		local originals = {}
		for _, part in ipairs(character:GetDescendants()) do
			if part:IsA("BasePart") then
				originals[part] = {Transparency = part.Transparency, CanCollide = part.CanCollide, CanTouch = part.CanTouch}
				part.Transparency = 1
				part.CanCollide = false
				part.CanTouch = false
			elseif part:IsA("Decal") then
				originals[part] = {Transparency = part.Transparency}
				part.Transparency = 1
			end
		end
		invisibleUserIds[userId] = originals
		-- The overhead name tag is a BillboardGui, which the sweep above can't hide.
		character:SetAttribute("AdminHidden", true)
		local tag = character:FindFirstChild("NameTag", true)
		if tag and tag:IsA("BillboardGui") then tag.Enabled = false end
	else
		local originals = invisibleUserIds[userId]
		if not originals then return true end
		for part, original in pairs(originals) do
			if part.Parent then
				part.Transparency = original.Transparency
				if original.CanCollide ~= nil then part.CanCollide = original.CanCollide end
				if original.CanTouch ~= nil then part.CanTouch = original.CanTouch end
			end
		end
		invisibleUserIds[userId] = nil
		character:SetAttribute("AdminHidden", nil)
		local tag = character:FindFirstChild("NameTag", true)
		if tag and tag:IsA("BillboardGui") then tag.Enabled = true end
	end
	-- Everyone currently connected (including the target's own client)
	-- needs to know, so PlayerInfo.lua can hide/restore just this one
	-- player's overhead tag - see the comment above Remote.AdminInvisStatus's
	-- own declaration for why that can't just ride along with the
	-- Transparency sweep above.
	for _, plr in ipairs(Players:GetPlayers()) do
		Remote.AdminInvisStatus:FireClient(plr, target, invisible)
	end
	return true
end

-- =====================================================================
-- Fly - the actual flight control lives client-side, in AdminClient.lua
-- (a real Tool+LocalScript can't be built from a running server script -
-- Source isn't scriptable at runtime). This just tracks who currently
-- has flight PERMISSION and tells their client to turn it on/off - the
-- client also lets a flying player pause/resume the actual flight
-- mechanic on their own via a "Disable Fly"/"Enable Fly" button without
-- that touching this permission at all, so :fly toggling it back off
-- later still works exactly the same regardless of whichever state the
-- button last left the actual flying in.
-- =====================================================================
local flyingUserIds = {}

local function setFlying(target, enabled)
	flyingUserIds[target.UserId] = enabled or nil
	Remote.AdminSetFlying:FireClient(target, enabled)
	return true
end


-- =====================================================================
-- :noclip (a tool that walks through walls), and :giant
-- =====================================================================
-- The No Clip tool is made here (nothing to place in ServerStorage). AdminClient sees it in the
-- character: while it's held the player flies through walls, and clicking teleports to the mouse.
local NO_CLIP_TOOL = "No Clip"
local function toggleNoClipTool(target: Player): boolean
	local found = false
	for _, holder in { target:FindFirstChildOfClass("Backpack"), target.Character } do
		if holder then
			for _, child in holder:GetChildren() do
				if child:IsA("Tool") and child:GetAttribute("NoClipTool") then
					child:Destroy()
					found = true
				end
			end
		end
	end
	if found then
		return false
	end
	local tool = Instance.new("Tool")
	tool.Name = NO_CLIP_TOOL
	tool.ToolTip = "Hold to fly through walls. Click to teleport."
	tool.RequiresHandle = false
	tool.CanBeDropped = false
	tool:SetAttribute("NoClipTool", true)
	tool:SetAttribute("DisplayName", NO_CLIP_TOOL)
	tool.Parent = target:FindFirstChildOfClass("Backpack") or target
	return true
end

-- Scales the whole character (1 = normal). Respawning resets it.
local function setGiantScale(target: Player, size: number): boolean
	local character = target.Character
	if not character then
		return false
	end
	local ok = pcall(function()
		character:ScaleTo(size)
	end)
	return ok
end
local function isGiant(target: Player): boolean
	local character = target.Character
	if not character then
		return false
	end
	local ok, scale = pcall(function()
		return character:GetScale()
	end)
	return ok and scale &gt; 1.5
end

-- =====================================================================
-- Spectate - the spectating admin is made invisible and frozen for the
-- duration (so they can't be seen, and can't move/interact with anyone
-- while just watching), restored to their exact previous position AND
-- previous invis/frozen state the moment they stop. Ending only ever
-- happens via the admin's own "Stop Spectating" button (Remote.AdminStopSpectating)
-- now, not a separate typed :unspectate command.
--
-- On top of invis (which also drops CanCollide/CanTouch - see
-- setInvisible), the admin's HumanoidRootPart is ALSO teleported way up
-- into empty space for the duration - belt-and-suspenders on top of the
-- collision fix, so there's genuinely nothing solid left sitting at
-- their old spot even in some edge case CanCollide/CanTouch doesn't
-- cover. A different height (and sign) than JAIL_CFRAME (-300) so this
-- never lands inside the jail cell itself. PreCFrame (captured below, from BEFORE
-- this teleport) is what makes restoring to the exact original spot on
-- stop work regardless.
-- =====================================================================
local SPECTATE_LIMBO_CFRAME = CFrame.new(0, 5000, 0)
local spectatingState = {} -- [adminUserId] = {Target=, PreCFrame=, PreInvis=, PreFrozen=}

-- Bare-forward-declared (see the comment further down, above
-- Remote.AdminStopSpectating's own listener, for why this pattern is needed at
-- all) - startSpectating below needs both to enforce "can't spectate and
-- control at the same time", but neither is assigned/populated until
-- further down in the file.
local stopControlling
local controllingUserIds

local function stopSpectatingServer(admin)
	local state = spectatingState[admin.UserId]
	if not state then return end
	spectatingState[admin.UserId] = nil

	-- Only undoes what spectating itself applied - if the admin was
	-- already invis/frozen (by their own or another admin's earlier
	-- command) before this ever started, that state is left exactly as
	-- it was rather than being switched off underneath them.
	if not state.PreFrozen then
		setFrozen(admin, false)
	end
	if not state.PreInvis then
		setInvisible(admin, false)
	end
	local character = admin.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	if hrp and state.PreCFrame then
		hrp.CFrame = state.PreCFrame
	end

	Remote.AdminSpectate:FireClient(admin, nil)
end

local function startSpectating(admin, target)
	-- Can't spectate and control at the same time - restores the admin to
	-- their normal pre-control state FIRST (position, invis, frozen) so
	-- the snapshot taken below reflects their real state, not the
	-- parked-in-limbo one control left them in.
	if controllingUserIds[admin.UserId] then
		stopControlling(admin)
	end

	local character = admin.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	if not hrp then return false end

	-- Already spectating someone - swap targets in place rather than
	-- stacking a second "previous state" snapshot on top of the first,
	-- which would restore to the wrong place/state once they finally
	-- stop.
	if spectatingState[admin.UserId] then
		spectatingState[admin.UserId].Target = target
		Remote.AdminSpectate:FireClient(admin, target)
		return true
	end

	spectatingState[admin.UserId] = {
		Target = target,
		PreCFrame = hrp.CFrame,
		PreInvis = invisibleUserIds[admin.UserId] ~= nil,
		PreFrozen = frozenUserIds[admin.UserId] ~= nil,
	}
	hrp.CFrame = SPECTATE_LIMBO_CFRAME
	setInvisible(admin, true)
	setFrozen(admin, true)
	Remote.AdminSpectate:FireClient(admin, target)
	return true
end

-- Remote.AdminStopSpectating's own .OnServerEvent listener is registered much
-- further down (right alongside Remote.AdminStopControlling's), after
-- logCommand/sendFeedback are actually declared as locals - a reference
-- to either from here, this early in the file, would resolve to a
-- nonexistent GLOBAL of the same name instead of those locals (Lua only
-- treats a name as referring to a local declared LATER in the same
-- chunk if it's been forward-declared bare, like `local x` with no
-- value yet - a plain `local function f()` doesn't create the name
-- until that exact line runs), and calling that nil global is exactly
-- what made the Stop Spectating/Stop Controlling buttons silently crash
-- before ever reaching stopSpectatingServer/stopControlling - which is
-- also why the admin's invis/frozen state and the target's "being
-- controlled" indicator were never actually getting restored/cleared.

-- =====================================================================
-- Control player - :controlplayer puppets a target's movement by
-- calling Humanoid:Move directly (the SAME call the engine itself makes
-- from a player's own input), driven by the admin's own WASD forwarded
-- over AdminControlMove every Heartbeat, rather than fighting the
-- Humanoid with an external BodyVelocity+PlatformStand - that combination
-- was what caused the stiff, un-animated pose and the target sinking
-- halfway into the floor (PlatformStand disables the Humanoid's own
-- ground-following entirely, and a zero-Y-force BodyVelocity doesn't
-- replace that). Driving the real Humanoid instead keeps normal ground
-- physics, animations, and jump all working exactly like the target
-- walking themselves. The controlling admin's OWN character is made
-- invisible/uncollidable/frozen for the duration (same as :spectate) so
-- they can't be seen, walked into, or seen still wandering around while
-- puppeting someone else - restored to their exact previous invis/frozen
-- state when they stop. Ends only via the admin's own "Stop Controlling"
-- button (Remote.AdminStopControlling), matching :spectate's own design above.
-- =====================================================================
-- controllingUserIds itself was already bare-forward-declared above (see
-- that comment) so startSpectating could reference it - this just
-- assigns the real table now, rather than shadowing it with a second
-- local of the same name.
controllingUserIds = {} -- [adminUserId] = target Player
local controlledByAdmin = {} -- [targetUserId] = admin Player
local controllingAdminPreState = {} -- [adminUserId] = {PreCFrame=, PreInvis=, PreFrozen=}
local controlledTargetPreGod = {} -- [targetUserId] = true if they were ALREADY in god mode before control started (so stopControlling doesn't strip a god mode they had for some other reason)
-- [targetUserId] = true if they were frozen (Anchored) right before this
-- control session started - :controlplayer needs them unanchored so
-- Humanoid:Move can actually move them at all (Anchored blocks ALL
-- movement, admin-driven or not), and this is what lets stopControlling
-- put them back exactly how it found them.
local controlledTargetPreFrozen = {}

stopControlling = function(admin)
	local target = controllingUserIds[admin.UserId]
	if not target then return end
	controllingUserIds[admin.UserId] = nil
	controlledByAdmin[target.UserId] = nil

	local targetHrp = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
	if targetHrp then
		-- Hands physics simulation back to the target's own client (the
		-- normal default) now that the server's done driving it - see the
		-- comment in startControlling for why this needed touching at all.
		local ok = pcall(function() targetHrp:SetNetworkOwnershipAuto() end)
		if not ok then
			pcall(function() targetHrp:SetNetworkOwner(target) end)
		end
	end
	local humanoid = target.Character and target.Character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid:Move(Vector3.new(0, 0, 0), false)
	end

	if not controlledTargetPreGod[target.UserId] then
		setGodMode(target, false)
	end
	controlledTargetPreGod[target.UserId] = nil

	-- Puts the freeze back exactly the way startControlling found it - if
	-- they weren't frozen to begin with, this is a no-op (setFrozen would
	-- just unfreeze an already-unfrozen target).
	if controlledTargetPreFrozen[target.UserId] then
		setFrozen(target, true)
	end
	controlledTargetPreFrozen[target.UserId] = nil

	local preState = controllingAdminPreState[admin.UserId]
	controllingAdminPreState[admin.UserId] = nil
	if preState then
		if not preState.PreFrozen then setFrozen(admin, false) end
		if not preState.PreInvis then setInvisible(admin, false) end
		local adminCharacter = admin.Character
		local adminHrp = adminCharacter and adminCharacter:FindFirstChild("HumanoidRootPart")
		if adminHrp and preState.PreCFrame then
			adminHrp.CFrame = preState.PreCFrame
		end
	end

	Remote.AdminControlTargetStatus:FireClient(target, false)
	Remote.AdminControlPlayer:FireClient(admin, nil)
end

local function startControlling(admin, target)
	-- Can't spectate and control at the same time - restores the admin to
	-- their normal pre-spectate state FIRST (position, invis, frozen) so
	-- the snapshot taken below reflects their real state, not the
	-- parked-in-limbo one spectating left them in.
	if spectatingState[admin.UserId] then
		stopSpectatingServer(admin)
	end

	local character = target.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local targetHrp = character and character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not targetHrp then return false end
	local adminHrp = admin.Character and admin.Character:FindFirstChild("HumanoidRootPart")
	if not adminHrp then return false end

	-- By default a character's physics are simulated on ITS OWN owning
	-- client, for responsiveness - which is exactly what made the
	-- server's own Humanoid:Move calls below feel laggy/delayed and
	-- "fight" the target's own client (Roblox hands ownership back to a
	-- character's associated player within a frame or two of anything
	-- else trying to claim it, unless the server explicitly takes and
	-- keeps it). Taking ownership here makes the server fully
	-- authoritative for movement while controlling, so its Move calls
	-- apply immediately with no competing client-side prediction.
	pcall(function() targetHrp:SetNetworkOwner(nil) end)

	-- Already controlled by someone else - hand control over cleanly
	-- rather than ending up with two admins fighting over the same
	-- target's movement.
	local previousAdmin = controlledByAdmin[target.UserId]
	if previousAdmin and previousAdmin ~= admin then
		stopControlling(previousAdmin)
	end
	-- Re-running against a target this same admin already controls is a
	-- no-op.
	if controllingUserIds[admin.UserId] == target then
		return true
	end

	-- Anchored (frozen) blocks ALL movement of the HumanoidRootPart, not
	-- just the target's own input - including the server's own
	-- Humanoid:Move calls below, which would otherwise silently do
	-- nothing for the whole session. Unfreezing here (and remembering to
	-- put it back in stopControlling) is what lets an admin control a
	-- target who happened to already be frozen at all. Computed only
	-- here, after both early-outs above - doing it any earlier would
	-- either leak an unfrozen target with no session left to re-freeze
	-- them (if this function bails out first) or clobber the real
	-- pre-frozen flag with "false" on a harmless re-run against a target
	-- already being controlled (who's already unfrozen for that reason).
	controlledTargetPreFrozen[target.UserId] = frozenUserIds[target.UserId] == true
	if controlledTargetPreFrozen[target.UserId] then
		setFrozen(target, false)
	end

	controllingAdminPreState[admin.UserId] = {
		PreCFrame = adminHrp.CFrame,
		PreInvis = invisibleUserIds[admin.UserId] ~= nil,
		PreFrozen = frozenUserIds[admin.UserId] ~= nil,
	}
	-- Same belt-and-suspenders limbo teleport as :spectate above, on top
	-- of invis's own CanCollide/CanTouch drop - reused rather than a
	-- second constant, since any number of admins can safely share the
	-- exact same out-of-the-way spot (none of them can see or collide
	-- with anything there anyway, and none of them are looking at their
	-- own camera while spectating/controlling).
	adminHrp.CFrame = SPECTATE_LIMBO_CFRAME
	setInvisible(admin, true)
	setFrozen(admin, true)

	-- Keeps the target from dying (and respawning, which would leave the
	-- admin controlling a now-destroyed character - the source of the
	-- reported "camera stuck, glitchy movement" once that happened) for
	-- as long as control lasts. Combined with the client-side Reset
	-- Character button being disabled below, there's no way for the
	-- target to end up respawning out from under an active control
	-- session.
	controlledTargetPreGod[target.UserId] = godModeUserIds[target.UserId] ~= nil
	setGodMode(target, true)

	controllingUserIds[admin.UserId] = target
	controlledByAdmin[target.UserId] = admin

	Remote.AdminControlTargetStatus:FireClient(target, true)
	Remote.AdminNotice:FireClient(target, "You are being controlled by staff", "Leaving the game is punishable.")
	Remote.AdminControlPlayer:FireClient(admin, target)
	return true
end

AdminControlMove.OnServerEvent:Connect(function(admin, moveDirection, jumpRequested)
	local target = controllingUserIds[admin.UserId]
	if not target then return end
	if typeof(moveDirection) ~= "Vector3" then return end
	local humanoid = target.Character and target.Character:FindFirstChildOfClass("Humanoid")
	if not humanoid then return end
	-- Clamped server-side rather than trusting the magnitude a client
	-- reports - a modified client sending an oversized vector shouldn't
	-- be able to move the controlled player faster than a normal walk.
	local horizontal = Vector3.new(moveDirection.X, 0, moveDirection.Z)
	if horizontal.Magnitude &gt; 1 then
		horizontal = horizontal.Unit
	end
	humanoid:Move(horizontal, false)
	if jumpRequested == true then
		humanoid.Jump = true
	end
end)

-- Keeps the controlling admin's own body on top of the person they're
-- controlling.
--
-- Nothing about the camera needed this - but ClickDetector and
-- ProximityPrompt both measure MaxActivationDistance from the LOCAL
-- PLAYER'S CHARACTER, not from the camera. The admin's real body is
-- parked, invisible and anchored, wherever they were standing when
-- control started, so every door and prompt the controlled character
-- walked up to was still tens of studs away as far as Roblox was
-- concerned, and simply would not fire. That is why you could drive
-- someone up to a door and not open it.
--
-- Moving the parked body along fixes both at once and costs nothing:
-- it is already invisible and non-collidable, so it cannot be seen,
-- bumped into, or stood on while it rides along.
--
-- Anchored parts still accept a CFrame write - being anchored stops the
-- physics solver moving them, not the script.
--
-- stopControlling restores PreCFrame, so the admin is still returned to
-- exactly where they started.
RunService.Heartbeat:Connect(function()
	for adminUserId, target in pairs(controllingUserIds) do
		local admin = Players:GetPlayerByUserId(adminUserId)
		local adminHrp = admin and admin.Character
			and admin.Character:FindFirstChild("HumanoidRootPart")
		local targetHrp = target and target.Parent and target.Character
			and target.Character:FindFirstChild("HumanoidRootPart")
		if adminHrp and targetHrp then
			adminHrp.CFrame = targetHrp.CFrame
		end
	end
end)

-- Remote.AdminStopControlling's own .OnServerEvent listener is registered
-- further down too, alongside Remote.AdminStopSpectating's - see the comment
-- above that one for why it can't live up here.

-- Resetting/respawning mid-spectate or mid-control leaves nothing
-- meaningful to restore to (the admin's old character - the one that was
-- actually made invisible/frozen - is already gone), and trying to
-- re-apply that to a brand new character on the fly is exactly the kind
-- of state that used to "glitch out". Simplest and most robust: treat the
-- admin's own respawn as an implicit stop, cleanly ending whichever of
-- the two was active so the fresh character starts from a normal,
-- interactable state instead of an inconsistent one.
local function watchAdminRespawnForSpectateAndControl(adminPlayer)
	adminPlayer.CharacterAdded:Connect(function(newCharacter)
		-- Invisibility the admin chose carries over to the new body (going into a run or back to
		-- the lobby respawns you), so the next toggle really does bring you - and your name tag -
		-- back. Invisibility that only spectate/control applied ends with them.
		local userId = adminPlayer.UserId
		local wasInvisible = invisibleUserIds[userId] ~= nil
		local spectate = spectatingState[userId]
		local control = controllingAdminPreState[userId]
		local chosen = wasInvisible and ((spectate == nil and control == nil)
			or (spectate ~= nil and spectate.PreInvis) or (control ~= nil and control.PreInvis))
		invisibleUserIds[userId] = nil
		if chosen then
			task.spawn(function()
				newCharacter:WaitForChild("Head", 10)
				task.wait(0.5) -- after the name tag, accessories and body parts arrive
				if adminPlayer.Character == newCharacter and not invisibleUserIds[userId] then
					setInvisible(adminPlayer, true)
				end
			end)
		elseif wasInvisible then
			for _, plr in ipairs(Players:GetPlayers()) do
				Remote.AdminInvisStatus:FireClient(plr, adminPlayer, false)
			end
		end
		if spectatingState[adminPlayer.UserId] then
			spectatingState[adminPlayer.UserId] = nil
			Remote.AdminSpectate:FireClient(adminPlayer, nil)
		end
		if controllingUserIds[adminPlayer.UserId] then
			local target = controllingUserIds[adminPlayer.UserId]
			controllingUserIds[adminPlayer.UserId] = nil
			controlledByAdmin[target.UserId] = nil
			controllingAdminPreState[adminPlayer.UserId] = nil
			if not controlledTargetPreGod[target.UserId] then
				setGodMode(target, false)
			end
			controlledTargetPreGod[target.UserId] = nil
			if controlledTargetPreFrozen[target.UserId] then
				setFrozen(target, true)
			end
			controlledTargetPreFrozen[target.UserId] = nil
			local humanoid = target.Character and target.Character:FindFirstChildOfClass("Humanoid")
			if humanoid then humanoid:Move(Vector3.new(0, 0, 0), false) end
			Remote.AdminControlTargetStatus:FireClient(target, false)
			Remote.AdminControlPlayer:FireClient(adminPlayer, nil)
		end
	end)
end
for _, existingPlayer in ipairs(Players:GetPlayers()) do
	watchAdminRespawnForSpectateAndControl(existingPlayer)
end
Players.PlayerAdded:Connect(watchAdminRespawnForSpectateAndControl)

-- Handles the TARGET side respawning, rather than the admin's own -
-- :spectate is meant to keep following whoever it's pointed at even
-- through a death/respawn (they can still fully control their own
-- character - spectating never restricts them - so this just re-locks
-- the camera onto their fresh character once it exists). :controlplayer
-- is the opposite: the god mode + disabled Reset button above should
-- make this unreachable while controlling, but if a respawn ever
-- slipped through anyway, cleanly ending control instead of leaving the
-- admin stuck looking at/driving a now-destroyed character is far
-- better than leaving that glitched.
local function watchTargetRespawnForSpectateAndControl(targetPlayer)
	targetPlayer.CharacterAdded:Connect(function(newCharacter)
		for adminUserId, state in pairs(spectatingState) do
			if state.Target == targetPlayer then
				local adminPlayer = Players:GetPlayerByUserId(adminUserId)
				if adminPlayer then
					task.spawn(function()
						local humanoid = newCharacter:WaitForChild("Humanoid", 5)
						-- Re-checked after the wait - the admin could have
						-- stopped spectating (or switched targets) while
						-- this was waiting for the new Humanoid to exist.
						local currentState = spectatingState[adminUserId]
						if humanoid and currentState and currentState.Target == targetPlayer then
							Remote.AdminSpectate:FireClient(adminPlayer, targetPlayer)
						end
					end)
				end
			end
		end

		local controllingAdmin = controlledByAdmin[targetPlayer.UserId]
		if controllingAdmin then
			stopControlling(controllingAdmin)
		end
	end)
end
for _, existingPlayer in ipairs(Players:GetPlayers()) do
	watchTargetRespawnForSpectateAndControl(existingPlayer)
end
Players.PlayerAdded:Connect(watchTargetRespawnForSpectateAndControl)

-- None of god mode/jail/invis/fly persist to a DataStore - they're
-- session-only toggles - so a stale true left behind after someone
-- disconnects (mid-flight, mid-jail, etc.) would otherwise silently
-- flip the WRONG way the next time the same command runs against them
-- after they rejoin (e.g. :fly reading a leftover "already flying" and
-- turning it off instead of on, with no client actually flying to
-- match). Clearing all of it on disconnect keeps a rejoin starting from
-- a clean slate.
Players.PlayerRemoving:Connect(function(player)
	local userId = player.UserId
	local godConn = godModeConnections[userId]
	if godConn then
		godConn:Disconnect()
		godModeConnections[userId] = nil
	end
	godModeUserIds[userId] = nil
	jailedUserIds[userId] = nil
	invisibleUserIds[userId] = nil
	flyingUserIds[userId] = nil
	-- Which log view they had open is meaningless once they're gone, and
	-- leaving it behind would keep a row per departed player forever.
	lastLogFilter[userId] = nil

	-- If the leaving player was mid-spectate, there's nothing left to
	-- restore them to - just drop the record. If they were the one being
	-- WATCHED, whichever admin was spectating them gets snapped back
	-- (restored position/invis/frozen state) rather than left staring at
	-- a spot where a now-gone player used to be.
	spectatingState[userId] = nil
	for adminUserId, state in pairs(spectatingState) do
		if state.Target == player then
			local adminPlayer = Players:GetPlayerByUserId(adminUserId)
			if adminPlayer then stopSpectatingServer(adminPlayer) end
		end
	end

	-- Same idea for :controlplayer - if the leaving player was
	-- controlling someone, that target gets their own input back; if the
	-- leaving player was the one being controlled, the constraints they
	-- were carrying would otherwise be destroyed with their character
	-- anyway, but the controlling admin's own indicator/camera lock still
	-- needs to be cleared.
	if controllingUserIds[userId] then
		stopControlling(player)
	end
	local controllingAdmin = controlledByAdmin[userId]
	if controllingAdmin then
		stopControlling(controllingAdmin)
	end
end)

-- =====================================================================
-- Inventory - :viewinv/:checkinv reads a target's current Backpack plus
-- whatever Tool is currently equipped in their Character (which isn't
-- inside Backpack while held), with nothing needed from the target's
-- own client; :clearinv/:strip removes all of it the same way.
-- =====================================================================
local function getTargetTools(target)
	local tools = {}
	local backpack = target:FindFirstChildOfClass("Backpack")
	if backpack then
		for _, tool in ipairs(backpack:GetChildren()) do
			if tool:IsA("Tool") then
				table.insert(tools, tool)
			end
		end
	end
	if target.Character then
		for _, tool in ipairs(target.Character:GetChildren()) do
			if tool:IsA("Tool") then
				table.insert(tools, tool)
			end
		end
	end
	return tools
end

local function buildInventoryEntries(target)
	local entries = {}
	for _, tool in ipairs(getTargetTools(target)) do
		table.insert(entries, {
			-- Id carries the actual Tool instance, not just a name/index -
			-- Instances pass through RemoteEvents fine, and this is what
			-- lets each row's own Remove button (wired up client-side)
			-- unambiguously identify exactly which Tool to destroy, even
			-- if the target is holding two of the same-named item.
			Id = tool,
			Line1 = tool.Name,
			Line2 = (tool.Parent == target.Character) and "currently equipped" or "in backpack",
		})
	end
	return entries
end

local function clearTargetInventory(target)
	local count = 0
	for _, tool in ipairs(getTargetTools(target)) do
		tool:Destroy()
		count += 1
	end
	return count
end

-- Shared by :viewinv and the per-row Remove button below (which re-sends
-- the list after removing one item, the same refresh-in-place pattern
-- the ban/mute Modify popups already use).
local function sendInventoryList(admin, target)
	local entries = buildInventoryEntries(target)
	Remote.AdminInventoryList:FireClient(admin, "Inventory - " .. target.Name .. " (" .. #entries .. ")", entries)
end

-- Resolves which Player a given Tool currently belongs to, whether it's
-- sitting in their Backpack (parented directly to the Player itself) or
-- actively equipped in their Character - needed by the Remove-button
-- handler below to know whose list to re-send after removing one item.
local function findToolOwner(tool)
	if not tool or not tool.Parent then return nil end
	if tool.Parent:IsA("Backpack") then
		local owner = tool.Parent.Parent
		return (owner and owner:IsA("Player")) and owner or nil
	end
	return Players:GetPlayerFromCharacter(tool.Parent)
end

-- =====================================================================
-- Give - clones a named Tool from a ServerStorage folder (looked up near
-- the top of this file, before tierInfo, since Remote.GetAdminInfo's response
-- needs its contents too) into the target's Backpack. Populate
-- ServerStorage.AdminGiveableItems with whatever Tools should be handed
-- out this way - :give matches by name, case-insensitively, same
-- partial-match convention as :setrank's rank lookup.
-- =====================================================================
-- Matches against BOTH the raw Tool name ("glock17") and its display
-- name ("Glock 17") - the client's autocomplete now suggests display
-- names, but an admin who types the raw technical name straight in
-- (skipping the dropdown) should still find it.
local function findGiveableItem(query)
	if typeof(query) ~= "string" or query == "" then return nil, nil end
	local lowerQuery = string.lower(query)
	local items = giveableItemsFolder:GetChildren()

	for _, item in ipairs(items) do
		if string.lower(item.Name) == lowerQuery or string.lower(getItemDisplayName(item)) == lowerQuery then
			return item, nil
		end
	end

	local matches = {}
	for _, item in ipairs(items) do
		local displayName = getItemDisplayName(item)
		if string.sub(string.lower(item.Name), 1, #lowerQuery) == lowerQuery
			or string.sub(string.lower(displayName), 1, #lowerQuery) == lowerQuery then
			table.insert(matches, item)
		end
	end
	if #matches == 1 then
		return matches[1], nil
	elseif #matches &gt; 1 then
		local names = {}
		for _, item in ipairs(matches) do table.insert(names, getItemDisplayName(item)) end
		return nil, "Multiple items match \"" .. query .. "\": " .. table.concat(names, ", ")
	end
	return nil, nil
end

local function giveItem(target, query)
	local item, err = findGiveableItem(query)
	if err then return false, err end
	if not item then
		return false, "No giveable item found matching \"" .. query .. "\" - add it to ServerStorage.AdminGiveableItems first"
	end
	local clone = item:Clone()
	-- Some free-model Tool assets are packaged inside an outer wrapper
	-- (a Model/Folder holding the real Tool alongside other supporting
	-- parts) rather than being the Tool itself. Handing out that wrapper
	-- as-is isn't a real, equippable item at all - Roblox's own Backpack
	-- (and every inventory list this admin system builds) only ever
	-- recognizes actual Tool instances - which is exactly what made
	-- :give report success while the item never showed up anywhere,
	-- for any item placed in ServerStorage.AdminGiveableItems this way.
	-- Unwrap automatically by handing out the first real Tool found
	-- nested inside instead, if the clone itself isn't already one.
	if not clone:IsA("Tool") then
		local innerTool = clone:FindFirstChildWhichIsA("Tool", true)
		if innerTool then
			innerTool.Parent = nil
			clone:Destroy()
			clone = innerTool
		end
	end
	-- Carries the same polished name :give's own autocomplete already
	-- shows ("Glock 17", "Btools") onto the actual Tool instance, as a
	-- plain Attribute - PlayerInfo.lua's own inventory display reads this
	-- first (falling back to its own prettify guess for tools that were
	-- never given this way) so the hotbar/full list show the same nice
	-- name instead of the raw lowercase Tool.Name.
	clone:SetAttribute("DisplayName", getItemDisplayName(item))
	local destination = target:FindFirstChildOfClass("Backpack")
	clone.Parent = destination or target
	return true, getItemDisplayName(item)
end

-- =====================================================================
-- Goto / bring - CFrame is set directly on the mover's own
-- HumanoidRootPart, so this never trusts a client-reported position for
-- either the admin or the target.
-- =====================================================================
local function gotoPlayer(admin, target)
	local adminHrp = admin.Character and admin.Character:FindFirstChild("HumanoidRootPart")
	local targetHrp = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
	if not adminHrp or not targetHrp then return false end
	adminHrp.CFrame = CFrame.new(targetHrp.Position + Vector3.new(3, 0, 0))
	return true
end

local function bringPlayer(admin, target)
	local adminHrp = admin.Character and admin.Character:FindFirstChild("HumanoidRootPart")
	local targetHrp = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
	if not adminHrp or not targetHrp then return false end
	targetHrp.CFrame = adminHrp.CFrame * CFrame.new(0, 0, -3)
	return true
end

-- =====================================================================
-- Warn - the popup itself is drawn client-side (AdminClient.lua),
-- listening on every player's client since the target of a warn is
-- often not staff at all.
-- =====================================================================
local function warnPlayer(target, reason, count)
	Remote.AdminNotice:FireClient(
		target,
		"You have been warned (#" .. count .. ")",
		reason,
		"3 warnings results in a kick, 5 in a 24 hour ban, 7 in a permanent ban."
	)
end

-- =====================================================================
-- Command log - captures who ran what on whom, persisted to a
-- DataStore so it survives a server restart (stopping/restarting Play
-- in Studio, or a live server shutting down) instead of resetting to
-- empty every session. Kept as one array under a single fixed key
-- (matching the whole log's own MAX_LOG_ENTRIES cap, so it never grows
-- large enough to threaten DataStore's per-key size limit) rather than
-- one key per entry, since the whole log is always read/shown as one
-- list anyway. Viewable in-panel via :cmdlogs (everything) and
-- :playerlogs [admin] (filtered to one admin, so abuse of a specific
-- staff member's commands can be reviewed on its own).
-- =====================================================================
local CommandLogStore = getStore("RinseCycleCommandLog")
local COMMAND_LOG_KEY = "Log"
-- Raised from 200 alongside the date filter and paging below. Browsing
-- the log by day is only worth having if the log actually reaches back
-- more than a day or two, and 200 entries is a single busy session.
-- 1000 entries is roughly 200KB serialised, comfortably inside
-- DataStore's 4MB per-key limit, and paging means the size never has to
-- reach the client's UI all at once.
local MAX_LOG_ENTRIES = 1000

-- Every entry carries a stable Id, handed out from here. Removal needs
-- to name ONE specific entry, and a position in the array can't do that
-- safely: between the client receiving a list and clicking Remove on it,
-- another command can be logged, or the MAX_LOG_ENTRIES cap can drop the
-- oldest entry and shift everything down by one - either of which would
-- turn "delete row 12" into deleting the wrong row. An Id can't drift.
local nextLogId = 1

local commandLog = {}
do
	local success, savedLog = pcall(function()
		return CommandLogStore:GetAsync(COMMAND_LOG_KEY)
	end)
	if success and typeof(savedLog) == "table" then
		commandLog = savedLog
		-- Entries saved before Ids existed get one now, and the counter
		-- resumes past the highest already in use so a restart can't
		-- reissue an Id that's still on an older entry.
		for _, entry in ipairs(commandLog) do
			if type(entry.Id) == "number" then
				nextLogId = math.max(nextLogId, entry.Id + 1)
			end
		end
		for _, entry in ipairs(commandLog) do
			if type(entry.Id) ~= "number" then
				entry.Id = nextLogId
				nextLogId += 1
			end
		end
		log("[AdminServer] Loaded " .. #commandLog .. " persisted command log entries")
	elseif success then
		-- [DEBUG] savedLog was nil, not a load failure - either nothing
		-- has ever been saved under this key yet, or this build of the
		-- script (with persistence at all) hasn't run in this place
		-- before. Printed either way so it's obvious from the Output
		-- whether persistence is even active, instead of silently
		-- starting fresh with no visible signal.
		log("[AdminServer] No persisted command log found (savedLog=" .. tostring(savedLog) .. ") - starting empty")
	else
		dsWarn("[AdminServer] Failed to load persisted command log: " .. tostring(savedLog))
	end
end

-- Backgrounded like every other DataStore write above - logCommand calls
-- this synchronously on essentially every admin action, so a blocking
-- SetAsync here was adding real lag to every single command, not just
-- list opens/edits. commandLog itself (the in-memory table) is already
-- updated before this runs, so :cmdlogs/:playerlogs and the client
-- response never waited on this in the first place once it's async - only
-- the persisted copy lags a moment behind now.
local function saveCommandLog()
	task.spawn(function()
		local success, err = pcall(function()
			CommandLogStore:SetAsync(COMMAND_LOG_KEY, commandLog)
		end)
		if success then
			-- [DEBUG] Confirms the write actually completed, since
			-- logCommand's own print below always fires regardless of
			-- whether this save succeeded - without this there was no way
			-- to tell "persistence is silently failing" apart from
			-- "persistence is working but the paste in Studio is stale"
			-- just from the Output log.
			log("[AdminServer] Command log saved (" .. #commandLog .. " entries)")
		else
			dsWarn("[AdminServer] Failed to persist command log: " .. tostring(err))
		end
	end)
end

-- Wipes the whole log, in memory and in the DataStore. Deliberately NOT
-- an admin command and not in the panel: erasing an audit trail isn't a
-- moderation action, and there's no rank that should be able to do it
-- from inside a running game. It exists purely so a place full of
-- testing noise can be cleared before real moderation starts.
--
-- Reached the same way as the AdminTierOverride testing hook above - the
-- Studio Command Bar with the context dropdown set to Server:
--   game.ServerStorage.WipeCommandLog:Invoke()
--
-- A BindableFunction in ServerStorage is what keeps it out of reach:
-- ServerStorage never replicates, so no client can see this object at
-- all, let alone invoke it. That's a stronger guarantee than a tier
-- check, which would still be a code path a client could try to reach.
do
	local wipeLogs = Instance.new("BindableFunction")
	wipeLogs.Name = "WipeCommandLog"
	wipeLogs.OnInvoke = function()
		local wiped = #commandLog
		-- Reassigns rather than table.clear so any list already sent to a
		-- client keeps whatever it was holding; the next :cmdlogs reads
		-- this new empty one.
		commandLog = {}
		saveCommandLog()
		local message = "[AdminServer] Command log wiped (" .. wiped .. " entries removed)"
		print(message)
		return message
	end
	wipeLogs.Parent = ServerStorage
	log("[AdminServer] Log wipe ready - run game.ServerStorage.WipeCommandLog:Invoke() in the Studio Command Bar (context: Server)")
end

-- description is a full, grammatical sentence ("EnderBuilda muted
-- PlayerOne for spamming") built by the caller, since only the caller
-- knows enough about what actually happened to phrase it naturally -
-- Extra is kept separately as a short tag for the compact list row
-- (Line2's "(...)" suffix) and search/autocomplete, while Description is
-- what the detail popup shows. Every call site below supplies one, since
-- not every logged action is a real typed command (:unban, :unmute, a
-- reason/duration edit) and reconstructing ":command target extra" for
-- those read badly.
-- Shared by logCommand (a real admin ran a typed command) and
-- logSystemAction below (the server itself acted - e.g. the auto-kick/ban
-- from reaching a warning threshold - with no admin Player behind it at
-- all, so there's nothing to call getPlayerTier on).
local function logEntry(adminName, adminTier, commandName, targetName, extra, description)
	table.insert(commandLog, {
		Id = nextLogId,
		Admin = adminName,
		Tier = adminTier,
		Command = commandName,
		Target = targetName,
		Extra = extra,
		Description = description,
		Timestamp = os.time(),
	})
	nextLogId += 1
	if #commandLog &gt; MAX_LOG_ENTRIES then
		table.remove(commandLog, 1)
	end
	saveCommandLog()
	log(string.format(
		"[AdminServer][LOG] %s used :%s on %s%s",
		adminName, commandName, targetName or "-",
		(extra and extra ~= "") and (" (" .. extra .. ")") or ""
	))
end

local function logCommand(admin, commandName, targetName, extra, description)
	if typeof(admin) ~= "Instance" then
		return
	end
	-- Captured at execution time, not looked up later - an admin's tier
	-- (in particular the Studio testing override) can change over a
	-- session, and a log entry should reflect what they were when they
	-- actually ran the command, not whatever they are now.
	logEntry(admin.Name, getPlayerTier(admin) or "?", commandName, targetName, extra, description)
end

-- For actions the SERVER takes on its own - the auto-escalation kick/ban
-- when a player reaches a warning threshold - rather than something an
-- admin typed. Attributed to "Server"/"System" instead of whichever admin
-- happened to run the :warn that triggered it, since they didn't actually
-- choose to kick or ban anyone - the system did, automatically.
local function logSystemAction(commandName, targetName, extra, description)
	logEntry("Server", "System", commandName, targetName, extra, description)
end

-- Newest first. filterAdmin, if given, only includes entries by that
-- exact admin (case-insensitive) - matched against the plain name
-- string logCommand stored, so this works even for an admin who has
-- since left (no live Player object needed).
--
-- Returns EVERY match, with no cap. There used to be a hard 100-entry
-- limit here, which silently hid the rest of the log - so :playerlogs on
-- a busy admin showed their 100 most recent actions and gave no hint
-- that there were more. The client pages through the result instead, so
-- nothing is lost and the UI still only draws a screenful at a time.
local function buildLogEntries(filterAdmin)
	local lowerFilter = filterAdmin and string.lower(filterAdmin) or nil
	local entries = {}
	for i = #commandLog, 1, -1 do
		local entry = commandLog[i]
		if not lowerFilter or string.lower(entry.Admin) == lowerFilter then
			table.insert(entries, {
				-- Carried through so the owner-only Remove button in the
				-- detail popup can name exactly which entry to delete.
				Id = entry.Id,
				Line1 = ":" .. entry.Command .. (entry.Target and (" - " .. entry.Target) or ""),
				Line2 = "by " .. entry.Admin .. " - " .. os.date("%Y-%m-%d %H:%M", entry.Timestamp)
					.. ((entry.Extra and entry.Extra ~= "") and (" (" .. entry.Extra .. ")") or ""),
				-- Full fields carried alongside Line1/Line2 so clicking a
				-- row can show the complete breakdown purely client-side
				-- (AdminClient.lua's showLogDetailPopup) - no second
				-- round trip to the server needed just to view one entry.
				Admin = entry.Admin,
				Tier = entry.Tier,
				Command = entry.Command,
				Target = entry.Target,
				Extra = entry.Extra,
				Description = entry.Description,
				Timestamp = entry.Timestamp,
			})
		end
	end
	return entries
end


-- =====================================================================
-- Dispatcher
-- =====================================================================
local function sendFeedback(player, text, isError)
	if typeof(player) ~= "Instance" then
		return -- the Admin Abuse show runs commands without a player
	end
	Remote.AdminFeedback:FireClient(player, text, isError == true)
end

-- Owner-only, re-checked here rather than trusting the CanRemoveLogs
-- flag the client was handed - a RemoteEvent is callable by any client
-- that knows its name, whatever their panel chose to draw. A refusal is
-- silent for everyone except the owner: someone probing this doesn't
-- need to be told it exists and that they're not allowed.
Remote.AdminRemoveLogEntry.OnServerEvent:Connect(function(player, entryId)
	if not isOwner(player) then
		warn("[AdminServer] Rejected log-entry removal from " .. player.Name .. " - not the owner")
		return
	end
	if type(entryId) ~= "number" then return end

	local removed = nil
	for i, entry in ipairs(commandLog) do
		if entry.Id == entryId then
			removed = table.remove(commandLog, i)
			break
		end
	end
	if not removed then
		sendFeedback(player, "That log entry is already gone", true)
		return
	end
	saveCommandLog()

	-- Refreshes whichever view they had open (see lastLogFilter) rather
	-- than always sending the full log back - removing an entry from a
	-- :playerlogs list shouldn't dump them into :cmdlogs.
	local filter = lastLogFilter[player.UserId]
	local entries = buildLogEntries(filter or nil)
	local title = filter and ("Logs - " .. filter .. " (" .. #entries .. ")")
		or ("Command Log (" .. #entries .. ")")
	Remote.AdminLogsList:FireClient(player, title, entries)

	sendFeedback(player, "Removed log entry: :" .. tostring(removed.Command)
		.. (removed.Target and (" - " .. removed.Target) or ""), false)
	print("[AdminServer] " .. player.Name .. " removed log entry #" .. entryId
		.. " (:" .. tostring(removed.Command) .. " by " .. tostring(removed.Admin) .. ")")
end)

-- Case-insensitive, matching the client's autocomplete dropdown - and
-- also resolves an unambiguous partial name even if the admin typed it
-- and hit Enter directly instead of using the dropdown/Tab. Returns
-- (player, nil) on a clean resolution, (nil, message) when the partial
-- matches more than one online player (so the admin can be told exactly
-- who it's ambiguous between), or (nil, nil) for no match at all.
local function findTargetPlayer(partial)
	if typeof(partial) ~= "string" or partial == "" then return nil, nil end
	local lowerPartial = string.lower(partial)

	for _, plr in ipairs(Players:GetPlayers()) do
		if string.lower(plr.Name) == lowerPartial then
			return plr, nil
		end
	end

	local matches = {}
	for _, plr in ipairs(Players:GetPlayers()) do
		if string.sub(string.lower(plr.Name), 1, #lowerPartial) == lowerPartial then
			table.insert(matches, plr)
		end
	end

	if #matches == 1 then
		return matches[1], nil
	elseif #matches &gt; 1 then
		local names = {}
		for _, plr in ipairs(matches) do
			table.insert(names, plr.Name)
		end
		return nil, "Multiple players match \"" .. partial .. "\": " .. table.concat(names, ", ") .. " - be more specific"
	end

	return nil, nil
end

Remote.AdminCommand.OnServerEvent:Connect(function(admin, commandName, targetName, extraText)
	if typeof(commandName) ~= "string" then return end
	commandName = string.lower(commandName)

	-- Checked before the permission check, and worded differently, so a
	-- typo'd/nonexistent command doesn't get told "you do not have
	-- permission" - that phrasing should only ever mean "this is a real
	-- command your tier can't use", not "this isn't a command at all".
	local tier = getPlayerTier(admin)
	local isStudioCommand = STUDIO_ONLY_SET[commandName] == true

	-- A Studio command outside Studio is reported as UNKNOWN, not as
	-- forbidden. "You do not have permission" would confirm the command
	-- exists, which is exactly the trace these are supposed to leave
	-- none of. As far as a live server is concerned, :tier is a typo.
	if isStudioCommand then
		if not canUseStudioCommands(admin) then
			sendFeedback(admin, "Unknown command: :" .. commandName, true)
			return
		end
	elseif not ALL_COMMANDS_SET[commandName] then
		sendFeedback(admin, "Unknown command: :" .. commandName, true)
		return
	elseif not tierHasCommand(tier, commandName) then
		sendFeedback(admin, "You do not have permission to use :" .. commandName, true)
		return
	end

	extraText = typeof(extraText) == "string" and extraText or ""
	if #extraText &gt; 200 then
		extraText = string.sub(extraText, 1, 200)
	end

	-- The Global tab's events (polls, giveaways, pass drops, boosts): the whole input is free text.
	local globalCommand = GlobalEvents.Commands[commandName]
	if globalCommand then
		local text = ((if typeof(targetName) == "string" then targetName else "") .. " " .. extraText):match("^%s*(.-)%s*$")
		globalCommand(admin, text)
		return
	end

	-- Handled before target resolution: the three list commands don't
	-- target anyone at all. Unbanning is no longer a standalone typed
	-- command - it's done from :banlist's per-row "Modify" popup, which
	-- already has the exact UserId on hand and doesn't need a username
	-- lookup at all.
	if commandName == "banlist" then
		local entries = buildBanListEntries()
		Remote.AdminBanList:FireClient(admin, "Banned Players (" .. #entries .. ")", entries)
		sendFeedback(admin, #entries .. " active ban(s)", false)
		return
	end

	if commandName == "mutelist" then
		local entries = buildMuteListEntries()
		Remote.AdminMuteList:FireClient(admin, "Muted Players (" .. #entries .. ")", entries)
		sendFeedback(admin, #entries .. " player(s) currently muted", false)
		return
	end

	if commandName == "warnlist" then
		local entries = buildWarnListEntries()
		Remote.AdminWarnList:FireClient(admin, "Warned Players (" .. #entries .. ")", entries)
		sendFeedback(admin, #entries .. " player(s) with warnings", false)
		return
	end

	-- Takes no arguments - the whole log goes to the client and the panel
	-- pages through it 100 at a time, so there's nothing to narrow down
	-- here.
	-- =================================================================
	-- Studio-only testing commands
	-- =================================================================
	-- Reaching this point already means canUseStudioCommands passed, so
	-- these don't re-check Studio individually. The game ones call
	-- Rinse Cycle's own services (DataService, RoundService, PetService).
	-- :setadminrank [player] [rank] - makes someone a staff rank for this
	-- Studio session only.
	--
	-- Sets the AdminTierOverride attribute the admin system checks for permission.
	--   AdminTierOverride - what the admin system checks for permission
	--   Rank / RankLabel  - what the overhead tag and the Tab list read
	--
	-- Deliberately NOT written to the rank DataStore, unlike :setrank.
	-- This is a testing tool: stop the playtest and you are whatever you
	-- really are again, with nothing left behind on the account.
	if commandName == "setadminrank" then
		if not isOwner(admin) then
			sendFeedback(admin, "Unknown command: :" .. commandName, true)
			return
		end
		local wanted = string.lower(extraText:match("^%s*(%S*)") or "")
		local usage = "Usage: :setadminrank [player] [Moderator/Admin/Developer, or clear]"
		if targetName == "" or wanted == "" then
			sendFeedback(admin, usage, true)
			return
		end
		local target, matchError = findTargetPlayer(targetName)
		if matchError then
			sendFeedback(admin, matchError, true)
			return
		end
		if not target then
			sendFeedback(admin, "Player not found: " .. targetName .. " (to remove someone who's offline, use Staff list)", true)
			return
		end
		if isOwnerAccount(target) then
			sendFeedback(admin, "That's the owner account", true)
			return
		end
		local newTier = nil
		if wanted ~= "clear" and wanted ~= "none" then
			for _, value in ipairs(STUDIO_TIER_VALUES) do
				if string.lower(value) == wanted or string.lower(value):sub(1, 3) == wanted:sub(1, 3) then
					newTier = value
				end
			end
			if not newTier then
				sendFeedback(admin, usage, true)
				return
			end
		end
		task.spawn(function()
			Staff.Set(target.UserId, newTier, target.Name)
			if newTier then
				celebrate(target, "You're staff!", "You've been made " .. newTier .. " by the owner. Your admin panel is on the left.", "🛡️")
			end
		end)
		logCommand(admin, "setadminrank", target.Name, newTier or "cleared",
			admin.Name .. (if newTier then " made " .. target.Name .. " " .. newTier else " removed " .. target.Name .. "'s staff rank"))
		sendFeedback(admin, if newTier then (target.Name .. " is now " .. newTier) else (target.Name .. " is no longer staff"), false)
		return
	end

	-- :stafflist - every staff member (online or not), with Remove.
	if commandName == "stafflist" then
		if not isOwner(admin) then
			sendFeedback(admin, "Unknown command: :" .. commandName, true)
			return
		end
		Staff.SendList(admin)
		return
	end

	-- Clears the command log in memory and in the DataStore. The
	-- ServerStorage.WipeCommandLog hook still exists alongside this and
	-- is still the better option for clearing test noise BEFORE a
	-- session, since it works in edit mode with no playtest running.
	if commandName == "wipelogs" then
		local wiped = #commandLog
		commandLog = {}
		saveCommandLog()
		sendFeedback(admin, "Wiped " .. wiped .. " log entries", false)
		log("[AdminServer] Command log wiped by " .. admin.Name .. " (" .. wiped .. " entries)")
		return
	end

	-- Finds the player named as the first argument, reporting a mistake to the admin itself.
	local function requireTarget(usage)
		if targetName == "" then
			sendFeedback(admin, "Usage: " .. usage, true)
			return nil
		end
		local target, matchError = findTargetPlayer(targetName)
		if matchError then
			sendFeedback(admin, matchError, true)
			return nil
		end
		if not target then
			sendFeedback(admin, "Player not found: " .. targetName, true)
			return nil
		end
		return target
	end

	-- =================================================================
	-- Founder-only, and NOT Studio-only - these work in a live game.
	-- =================================================================
	-- :setbubbles / :setgems [player] [amount] set someone's Bubbles or Gems outright (fixing a
	-- lost purchase, seeding a tester). They're the premium/progression currencies, so Founder only.
	if commandName == "setbubbles" or commandName == "setgems" then
		local field = if commandName == "setbubbles" then "Bubbles" else "Gems"
		local amount = tonumber(extraText:match("^%s*(%S*)") or "")
		local target = requireTarget(":" .. commandName .. " [player] [amount]")
		if not target then return end
		if not amount or amount &lt; 0 then
			sendFeedback(admin, "Usage: :" .. commandName .. " [player] [amount]", true)
			return
		end
		local profile = DataService.Get(target)
		if not profile then
			sendFeedback(admin, target.Name .. "'s data isn't loaded yet", true)
			return
		end
		profile[field] = math.floor(amount)
		DataService.PushMeta(target)
		logCommand(admin, commandName, target.Name, tostring(math.floor(amount)),
			admin.Name .. " set " .. target.Name .. "'s " .. field .. " to " .. math.floor(amount))
		sendFeedback(admin, "Set " .. target.Name .. "'s " .. field .. " to " .. math.floor(amount), false)
		return
	end

	-- =================================================================
	-- Owner tools (Studio, or the owner in a live game) - testing and fixing things.
	-- =================================================================
	-- :daily [player] [skip|break|day N|reset|show] - fast-forwards the 24-hour daily reward.
	--   skip   the 24 hours have passed - the next reward is claimable now, streak intact
	--   break  a day was missed - the streak will restart unless restored
	--   day N  jump to having day N waiting (claimable now)
	--   reset  wipe back to a fresh start
	--   show   report the current state and change nothing
	if commandName == "daily" then
		local target = requireTarget(":daily [player] [skip|break|day N|reset|show]")
		if not target then return end
		local profile = DataService.Get(target)
		if not profile then
			sendFeedback(admin, target.Name .. "'s data isn't loaded yet", true)
			return
		end
		local mode, value = extraText:match("^%s*(%S*)%s*(%S*)")
		mode = string.lower(mode or "")
		local now = os.time()
		local cooldown, grace = Config.Daily.Cooldown, Config.Daily.Grace
		if mode == "skip" then
			profile.DailyLast = now - cooldown
		elseif mode == "break" then
			profile.DailyLast = now - cooldown - grace - 60
		elseif mode == "day" then
			local day = math.clamp(math.floor(tonumber(value) or 1), 1, #Config.DailyRewards)
			profile.DailyStreak = day - 1
			profile.DailyLast = if day == 1 then 0 else now - cooldown
		elseif mode == "reset" then
			profile.DailyStreak = 0
			profile.DailyLast = 0
		elseif mode ~= "" and mode ~= "show" then
			sendFeedback(admin, "Usage: :daily [player] [skip|break|day N|reset|show]", true)
			return
		end
		DataService.PushMeta(target)
		local wait = math.max(0, profile.DailyLast + cooldown - now)
		sendFeedback(admin, string.format("%s: streak day %d, %s", target.Name, profile.DailyStreak,
			if profile.DailyLast == 0 or wait == 0 then "next reward ready" else ("next reward in " .. formatDuration(wait))), false)
		if mode ~= "" and mode ~= "show" then
			logCommand(admin, "daily", target.Name, mode, admin.Name .. " used :daily " .. mode .. " on " .. target.Name)
		end
		return
	end

	-- :finishrun [player] - cleans every bit of dirt in that player's dishwasher at once.
	if commandName == "finishrun" then
		local target = requireTarget(":finishrun [player]")
		if not target then return end
		local cleaned = RoundService.DebugFinish(target)
		if not cleaned then
			sendFeedback(admin, target.Name .. " isn't in a run", true)
			return
		end
		logCommand(admin, "finishrun", target.Name, nil, admin.Name .. " finished " .. target.Name .. "'s run")
		sendFeedback(admin, "Finished " .. target.Name .. "'s run (" .. cleaned .. " spots)", false)
		return
	end

	-- :givecoins [player] [amount] - in-run coins (only while they're in a dishwasher).
	if commandName == "givecoins" then
		local target = requireTarget(":givecoins [player] [amount]")
		if not target then return end
		local amount = tonumber(extraText:match("^%s*(%S*)") or "")
		if not amount or amount &lt;= 0 then
			sendFeedback(admin, "Usage: :givecoins [player] [amount]", true)
			return
		end
		if not RoundService.AddCoins(target, math.floor(amount)) then
			sendFeedback(admin, target.Name .. " isn't in a run", true)
			return
		end
		logCommand(admin, "givecoins", target.Name, tostring(math.floor(amount)), admin.Name .. " gave " .. target.Name .. " " .. math.floor(amount) .. " coins")
		sendFeedback(admin, "Gave " .. target.Name .. " " .. math.floor(amount) .. " coins", false)
		return
	end

	-- :givepet [player] [pet name] - adds a pet (end the name with "golden" or "rainbow" for a tier).
	if commandName == "givepet" then
		local target = requireTarget(":givepet [player] [pet name]")
		if not target then return end
		local text = extraText:gsub("^%s+", ""):gsub("%s+$", "")
		local petTier = 1
		local lowerText = string.lower(text)
		if lowerText:match("%s+golden$") then
			petTier, text = 2, text:gsub("%s+[Gg]olden$", "")
		elseif lowerText:match("%s+rainbow$") then
			petTier, text = 3, text:gsub("%s+[Rr]ainbow$", "")
		end
		local wanted = string.lower((text:gsub("[^%w]", "")))
		local petId = nil
		for id, def in pairs(Config.Pets) do
			if string.lower(id) == wanted or (string.lower(def.Name):gsub("[^%w]", "")) == wanted then
				petId = id
				break
			end
		end
		if not petId then
			sendFeedback(admin, "No pet found matching \"" .. text .. "\"", true)
			return
		end
		local ok, err = PetService.GivePet(target, petId, petTier)
		if not ok then
			sendFeedback(admin, err or "Couldn't give that pet", true)
			return
		end
		local label = Config.Pets[petId].Name .. (petTier == 2 and " (Golden)" or petTier == 3 and " (Rainbow)" or "")
		logCommand(admin, "givepet", target.Name, label, admin.Name .. " gave " .. target.Name .. " a " .. label)
		sendFeedback(admin, "Gave " .. target.Name .. " a " .. label, false)
		return
	end

	-- :unlockall [player] - unlocks every dishwasher.
	if commandName == "unlockall" then
		local target = requireTarget(":unlockall [player]")
		if not target then return end
		local profile = DataService.Get(target)
		if not profile then
			sendFeedback(admin, target.Name .. "'s data isn't loaded yet", true)
			return
		end
		profile.Unlocked = #Config.Levels
		DataService.PushMeta(target)
		logCommand(admin, "unlockall", target.Name, nil, admin.Name .. " unlocked every level for " .. target.Name)
		sendFeedback(admin, "Unlocked every level for " .. target.Name, false)
		return
	end

	-- :setrebirths [player] [count]
	if commandName == "setrebirths" then
		local target = requireTarget(":setrebirths [player] [count]")
		if not target then return end
		local count = tonumber(extraText:match("^%s*(%S*)") or "")
		local profile = DataService.Get(target)
		if not count or count &lt; 0 or not profile then
			sendFeedback(admin, if profile then "Usage: :setrebirths [player] [count]" else (target.Name .. "'s data isn't loaded yet"), true)
			return
		end
		profile.Rebirths = math.floor(count)
		DataService.PushMeta(target)
		DataService.PassesChanged:Fire(target) -- rebirth bonuses and the name tag
		logCommand(admin, "setrebirths", target.Name, tostring(math.floor(count)), admin.Name .. " set " .. target.Name .. "'s rebirths to " .. math.floor(count))
		sendFeedback(admin, "Set " .. target.Name .. "'s rebirths to " .. math.floor(count), false)
		return
	end

	-- =================================================================
	-- Gifted gamepasses. Owner only, and NOT Studio-only - these work in
	-- a live server, which is half the point of them.
	-- =================================================================
	-- The extra isOwner check on top of the Studio/owner gate above is
	-- deliberate. In Studio that gate passes for any Founder-tier tester,
	-- which is right for :finishrun and wrong for a command that hands
	-- out paid entitlements - so these two ask the narrower question.
	if commandName == "givegamepass" or commandName == "removegamepass" then
		local giving = commandName == "givegamepass"

		if not isOwner(admin) then
			sendFeedback(admin, "Unknown command: :" .. commandName, true)
			return
		end

		local passText = extraText:gsub("^%s+", ""):gsub("%s+$", "")
		local pass = resolveGamepass(passText)
		if targetName == "" or not pass then
			sendFeedback(admin, "Usage: :" .. commandName .. " [player] [pass]", true)
			return
		end

		local target, matchError = findTargetPlayer(targetName)
		if matchError then
			sendFeedback(admin, matchError, true)
			return
		end
		if not target then
			sendFeedback(admin, "Player not found: " .. targetName, true)
			return
		end

		-- Two different kinds of "has it": bought from Roblox, or given
		-- by this command. They need telling apart, because only one of
		-- them can be taken away again.
		local granted = target:GetAttribute(gamepassAttribute(pass.Key)) == true
		local bought = false
		if type(pass.Id) == "number" and pass.Id &gt; 0 then
			local ok, result = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(target.UserId, pass.Id)
			end)
			if not ok then
				sendFeedback(admin, "Couldn't check " .. target.Name .. "'s passes", true)
				return
			end
			bought = result == true
		end

		if giving then
			if bought then
				sendFeedback(admin, target.Name .. " already bought that pass", true)
				return
			end
			if granted then
				sendFeedback(admin, target.Name .. " was already gifted that pass", true)
				return
			end
		else
			if not granted then
				sendFeedback(admin, bought
					and (target.Name .. " bought that pass - can't remove")
					or (target.Name .. " wasn't gifted that pass"), true)
				return
			end
		end

		setGamepassGrant(target, pass, giving, bought)

		-- The recipient gets told, with the game's usual celebration toast - only on the way IN.
		if giving then
			celebrate(target, "You got a gift!", "You've been gifted " .. pass.Name .. " by an admin!", pass.Icon)
		end

		sendFeedback(admin, (giving and "Gave " or "Removed ") .. pass.Name
			.. (giving and " to " or " from ") .. target.Name, false)
		logCommand(admin, commandName, target.Name, pass.Name,
			admin.Name .. (giving and " gave " or " removed ") .. pass.Name
			.. (giving and " to " or " from ") .. target.Name)
		return
	end

	if commandName == "cmdlogs" then
		local entries = buildLogEntries(nil)
		lastLogFilter[admin.UserId] = false
		Remote.AdminLogsList:FireClient(admin, "Command Log (" .. #entries .. ")", entries)
		sendFeedback(admin, #entries .. " log entries", false)
		return
	end

	-- Matched against the plain name string each log entry was recorded
	-- under, not a live Player - works for an admin who has since left,
	-- unlike findTargetPlayer below.
	if commandName == "playerlogs" then
		if targetName == "" then
			sendFeedback(admin, "Usage: :playerlogs [admin username]", true)
			return
		end
		local entries = buildLogEntries(targetName)
		lastLogFilter[admin.UserId] = targetName
		Remote.AdminLogsList:FireClient(admin, "Logs - " .. targetName .. " (" .. #entries .. ")", entries)
		sendFeedback(admin, #entries .. " log entries for " .. targetName, false)
		return
	end

	-- No player target at all - the whole rest of the input (targetName
	-- + extraText, which the client only split apart because every other
	-- command has a target as its first word) is the announcement text.
	-- :joinserver [username] - go to that player's server, wherever it is (runs included).
	-- :bringserver [username] - pull that player from their server into yours.
	if commandName == "joinserver" or commandName == "bringserver" then
		local joining = commandName == "joinserver"
		local name = targetName:gsub("^%s+", ""):gsub("%s+$", "")
		if name == "" then
			sendFeedback(admin, "Usage: :" .. commandName .. " [username]", true)
			return
		end
		-- Already here: the normal goto / bring.
		local here = findTargetPlayer(name)
		if here and here ~= admin then
			if joining then
				gotoPlayer(admin, here)
				sendFeedback(admin, here.Name .. " is in this server - teleported to them", false)
			else
				bringPlayer(admin, here)
				sendFeedback(admin, here.Name .. " is in this server - brought them", false)
			end
			return
		end
		task.spawn(function()
			local okId, userId = pcall(function()
				return Players:GetUserIdFromNameAsync(name)
			end)
			if not okId or type(userId) ~= "number" then
				sendFeedback(admin, "No Roblox user called " .. name, true)
				return
			end
			if not joining then
				local ok = pcall(function()
					MessagingService:PublishAsync("RinseCycle_AdminBring", {
						UserId = userId,
						JobId = game.JobId,
						Code = RunServers.AccessCodeForJob(game.JobId),
						AdminId = admin.UserId,
					})
				end)
				sendFeedback(admin, if ok then ("Asked " .. name .. "'s server to send them here...") else "Couldn't reach other servers", not ok)
				if ok then
					logCommand(admin, "bringserver", name, nil, admin.Name .. " brought " .. name .. " from another server")
				end
				return
			end
			local ok, _current, _err, _placeId, jobId = pcall(function()
				return TeleportService:GetPlayerPlaceInstanceAsync(userId)
			end)
			if not ok or type(jobId) ~= "string" or jobId == "" then
				sendFeedback(admin, "Couldn't find " .. name .. " in any server (offline, or their joins are turned off)", true)
				return
			end
			local code = RunServers.AccessCodeForJob(jobId)
			local sent = pcall(function()
				local options = Instance.new("TeleportOptions")
				if code then
					options.ReservedServerAccessCode = code
				else
					options.ServerInstanceId = jobId
				end
				-- Always arrive invisible (and off the player list): nobody sees you join.
				options:SetTeleportData({ Mode = "AdminJoin", FollowUserId = userId, AdminInvis = { admin.UserId } })
				TeleportService:TeleportAsync(game.PlaceId, { admin }, options)
			end)
			sendFeedback(admin, if sent then ("Teleporting to " .. name .. "'s server...") else "That teleport couldn't start", not sent)
			if sent then
				logCommand(admin, "joinserver", name, nil, admin.Name .. " joined " .. name .. "'s server")
			end
		end)
		return
	end

	-- :serverlist - every player in every server of the game, with Join / Bring on each.
	if commandName == "serverlist" then
		task.spawn(ServerList.Send, admin)
		sendFeedback(admin, "Loading every server...", false)
		return
	end

	if commandName == "leaderboards" then
		task.spawn(function()
			local rows = LeaderboardService.ListBoard(1, 100)
			Remote.AdminLeaderboard:FireClient(admin, 1, LeaderboardService.BoardCount(), LeaderboardService.BoardTitle(1), rows)
		end)
		sendFeedback(admin, "Loading leaderboards...", false)
		return
	end

	-- Like :announce, but on every server of the game (MessagingService).
	if commandName == "globalannounce" then
		local fullMessage = (targetName ~= "" and (targetName .. " " .. extraText) or extraText)
		fullMessage = fullMessage:gsub("%s+$", "")
		if fullMessage == "" then
			sendFeedback(admin, "Usage: :globalannounce [message]", true)
			return
		end
		local ok = pcall(function()
			MessagingService:PublishAsync("RinseCycle_GlobalAnnounce", { Text = fullMessage })
		end)
		if not ok then
			-- MessagingService isn't available (Studio): at least tell this server.
			for _, plr in ipairs(Players:GetPlayers()) do
				Remote.AdminAnnouncement:FireClient(plr, fullMessage)
			end
		end
		logCommand(admin, "globalannounce", nil, fullMessage, admin.Name .. " announced to every server: " .. fullMessage)
		sendFeedback(admin, if ok then "Announcement sent to every server" else "Couldn't reach other servers - announced here only", not ok)
		return
	end

	if commandName == "announce" then
		local fullMessage = (targetName ~= "" and (targetName .. " " .. extraText) or extraText)
		fullMessage = fullMessage:gsub("%s+$", "")
		if fullMessage == "" then
			sendFeedback(admin, "Usage: :announce [message]", true)
			return
		end
		local players = Players:GetPlayers()
		for _, plr in ipairs(players) do
			Remote.AdminAnnouncement:FireClient(plr, fullMessage)
		end
		logCommand(admin, "announce", nil, fullMessage, admin.Name .. " announced: " .. fullMessage)
		sendFeedback(admin, "Announcement sent to " .. #players .. " player(s)", false)
		return
	end

	-- :fly with no name typed targets the issuing admin themselves,
	-- rather than requiring ":fly MyOwnUsername" every time - :fly [name]
	-- still works normally for flying someone else.
	if (commandName == "fly" or commandName == "noclip" or commandName == "giant") and targetName == "" then
		targetName = admin.Name
	end

	-- Nothing typed where the player name goes. Every command that reaches
	-- this point takes a player as its first argument (the ones that don't
	-- have all returned above), so this is always the same mistake:
	-- pressing enter half way through writing the command. It used to fall
	-- through to findTargetPlayer and come back as "Player not found: "
	-- with an empty name, which reads like the player is missing rather
	-- than the command being. The commands that need a SECOND argument
	-- (:give an item, :setrank a rank, :tempban a duration...) already
	-- report their own "Usage:" line further down, so this only has to
	-- cover the first one.
	if targetName == "" then
		sendFeedback(admin, "Incomplete command - :" .. commandName .. " needs a player name", true)
		return
	end

	local target, matchError = findTargetPlayer(targetName)
	if matchError then
		sendFeedback(admin, matchError, true)
		return
	end
	if not target then
		sendFeedback(admin, "Player not found: " .. tostring(targetName), true)
		return
	end
	-- Staff can't use commands on staff at or above their own rank (a Moderator can't kick an Admin
	-- or the owner). The owner can use anything on anyone.
	if target ~= admin and tier ~= "Founder" then
		local order = { Moderator = 1, Admin = 2, Developer = 3, Founder = 4 }
		local targetTier = getPlayerTier(target)
		if targetTier and (order[targetTier] or 0) &gt;= (order[tier] or 0) then
			sendFeedback(admin, "You can't use that on " .. target.Name .. " (staff at or above your rank)", true)
			return
		end
	end
	-- Self-targeting rules. :kick/:ban are locked out for the obvious
	-- reason. :spectate/:controlplayer are locked out because both park
	-- the admin's own character in limbo and hand their camera to the
	-- target - aimed at yourself that means being puppeted by, and
	-- watching, a character that's been teleported away and frozen, which
	-- is just a broken state to be in rather than anything useful.
	-- :freeze is deliberately NOT in this list: freezing yourself is a
	-- genuinely handy way to test the frozen state without needing a
	-- second player.
	if target == admin and (commandName == "kick" or commandName == "ban"
		or commandName == "spectate" or commandName == "controlplayer") then
		sendFeedback(admin, "You can't :" .. commandName .. " yourself.", true)
		return
	end

	if commandName == "kick" then
		target:Kick("Kicked by an admin.\nReason: " .. (extraText ~= "" and extraText or "No reason given"))
		logCommand(admin, "kick", target.Name, extraText,
			admin.Name .. " kicked " .. target.Name .. (extraText ~= "" and (" - reason: " .. extraText) or " (no reason given)"))
		sendFeedback(admin, "Kicked " .. target.Name, false)

	elseif commandName == "mute" then
		local nowMuted, muteData = toggleMute(target, admin, extraText)
		local muteDescription
		if nowMuted then
			muteDescription = admin.Name .. " muted " .. target.Name .. (extraText ~= "" and (" - reason: " .. extraText) or " (no reason given, permanent)")
		else
			muteDescription = admin.Name .. " unmuted " .. target.Name
		end
		logCommand(admin, "mute", target.Name, nowMuted and ("muted: " .. extraText) or "unmuted", muteDescription)
		if nowMuted then
			Remote.AdminNotice:FireClient(target, "You have been muted", muteNoticeBody(muteData))
		end
		Remote.AdminMuteStatus:FireClient(target, nowMuted, nowMuted and muteData.ExpiresAt or nil)
		syncChatMutes()
		sendFeedback(admin, (nowMuted and "Muted " or "Unmuted ") .. target.Name, false)

	elseif commandName == "tempmute" then
		local durationSeconds, reasonText = parseDurationAndReason(extraText)
		if not durationSeconds then
			sendFeedback(admin, "Usage: :tempmute [player] [duration e.g. 24h, 3d, 1w] [reason]", true)
			return
		end
		local data = {Reason = reasonText, By = admin.Name, Timestamp = os.time(), ExpiresAt = os.time() + durationSeconds}
		mutedUserIds[target.UserId] = data
		saveMuteData(target.UserId, data)
		logCommand(admin, "tempmute", target.Name, formatDuration(durationSeconds) .. " - " .. reasonText,
			admin.Name .. " muted " .. target.Name .. " for " .. formatDuration(durationSeconds) .. (reasonText ~= "" and (" - reason: " .. reasonText) or ""))
		Remote.AdminNotice:FireClient(target, "You have been muted", muteNoticeBody(data))
		Remote.AdminMuteStatus:FireClient(target, true, data.ExpiresAt)
		syncChatMutes()
		sendFeedback(admin, "Muted " .. target.Name .. " for " .. formatDuration(durationSeconds), false)

	elseif commandName == "warn" then
		if extraText == "" then
			sendFeedback(admin, "Usage: :warn [player] [reason]", true)
			return
		end

		local warnings = getWarnings(target.UserId)
		table.insert(warnings, {Reason = extraText, By = admin.Name, Timestamp = os.time()})
		saveWarnings(target.UserId, warnings)
		local count = #warnings

		warnPlayer(target, extraText, count)
		logCommand(admin, "warn", target.Name, extraText .. " (warning #" .. count .. ")",
			admin.Name .. " warned " .. target.Name .. " (warning #" .. count .. ") - reason: " .. extraText)

		if count == 7 then
			banUser(target.UserId, "Reached 7 warnings (auto-escalation)", "System", nil, true)
			logSystemAction("ban", target.Name, "reached 7 warnings", "Server permanently banned " .. target.Name .. " for reaching 7 warnings")
			sendFeedback(admin, "Warned " .. target.Name .. " - 7 warnings, perm ban", false)
			target:Kick("You have been permanently banned - you reached 7 warnings.")
		elseif count == 5 then
			banUser(target.UserId, "Reached 5 warnings (auto-escalation)", "System", 24 * 3600, true)
			logSystemAction("tempban", target.Name, "reached 5 warnings", "Server banned " .. target.Name .. " for 24 hours for reaching 5 warnings")
			sendFeedback(admin, "Warned " .. target.Name .. " - 5 warnings, 24h ban", false)
			target:Kick("You have been banned for 24 hours - you reached 5 warnings.")
		elseif count == 3 then
			logSystemAction("kick", target.Name, "reached 3 warnings", "Server kicked " .. target.Name .. " for reaching 3 warnings")
			sendFeedback(admin, "Warned " .. target.Name .. " - 3 warnings, kicked", false)
			target:Kick("You have been kicked - you reached 3 warnings.\nLatest reason: " .. extraText)
		else
			sendFeedback(admin, "Warned " .. target.Name .. " (warning #" .. count .. ")", false)
		end

	elseif commandName == "msg" then
		if extraText == "" then
			sendFeedback(admin, "Usage: :msg [player] [message]", true)
			return
		end
		Remote.AdminNotice:FireClient(target, "Message from staff", extraText, nil, "OKAY")
		logCommand(admin, "msg", target.Name, extraText, admin.Name .. " sent a message to " .. target.Name .. ": " .. extraText)
		sendFeedback(admin, "Sent message to " .. target.Name, false)

	elseif commandName == "setrank" then
		if extraText == "" then
			sendFeedback(admin, "Usage: :setrank [player] [rank name]", true)
			return
		end
		local rank, rankErr = findRank(extraText)
		if rankErr then
			sendFeedback(admin, rankErr, true)
			return
		end
		if not rank then
			sendFeedback(admin, "No rank found matching \"" .. extraText .. "\"", true)
			return
		end
		applyRank(target, rank)
		celebrate(target, "Congrats!", "You've been gifted the " .. rank.Label .. " rank by an admin!", "🎖️")
		logCommand(admin, "setrank", target.Name, rank.Label, admin.Name .. " set " .. target.Name .. "'s rank to " .. rank.Label)
		sendFeedback(admin, "Set " .. target.Name .. "'s rank to " .. rank.Label, false)

	elseif commandName == "promote" then
		local index = getCurrentRankIndex(target)
		if index &gt;= #IN_GAME_RANKS then
			sendFeedback(admin, target.Name .. " is already at the highest rank", true)
			return
		end
		local rank = IN_GAME_RANKS[index + 1]
		applyRank(target, rank)
		celebrate(target, "Congrats!", "An admin promoted you to the " .. rank.Label .. " rank!", "🎖️")
		logCommand(admin, "promote", target.Name, rank.Label, admin.Name .. " promoted " .. target.Name .. " to " .. rank.Label)
		sendFeedback(admin, "Promoted " .. target.Name .. " to " .. rank.Label, false)

	elseif commandName == "demote" then
		local index = getCurrentRankIndex(target)
		if index &lt;= 1 then
			sendFeedback(admin, target.Name .. " is already at the lowest rank", true)
			return
		end
		local rank = IN_GAME_RANKS[index - 1]
		applyRank(target, rank)
		logCommand(admin, "demote", target.Name, rank.Label, admin.Name .. " demoted " .. target.Name .. " to " .. rank.Label)
		sendFeedback(admin, "Demoted " .. target.Name .. " to " .. rank.Label, false)

	elseif commandName == "goto" then
		if gotoPlayer(admin, target) then
			logCommand(admin, "goto", target.Name, nil, admin.Name .. " teleported to " .. target.Name)
			sendFeedback(admin, "Teleported to " .. target.Name, false)
		else
			sendFeedback(admin, "Could not teleport - character not found", true)
		end

	elseif commandName == "bring" then
		if bringPlayer(admin, target) then
			logCommand(admin, "bring", target.Name, nil, admin.Name .. " brought " .. target.Name .. " to them")
			sendFeedback(admin, "Brought " .. target.Name, false)
		else
			sendFeedback(admin, "Could not bring - character not found", true)
		end

	elseif commandName == "freeze" then
		-- Toggles: running it against someone already frozen unfreezes
		-- them, rather than refusing with "already frozen". :unfreeze is
		-- kept as its own command for when you specifically want the
		-- one-way version (and it's what the sidebar/autocomplete still
		-- offers), but this way a single command covers the common
		-- freeze-check-unfreeze loop without switching commands halfway.
		local nowFrozen = not frozenUserIds[target.UserId]
		if setFrozen(target, nowFrozen) then
			logCommand(admin, "freeze", target.Name, nowFrozen and "frozen" or "unfrozen",
				admin.Name .. (nowFrozen and " froze " or " unfroze ") .. target.Name)
			if nowFrozen then
				Remote.AdminNotice:FireClient(target, "You are frozen", "Leaving the game is punishable.")
			end
			Remote.AdminFreezeStatus:FireClient(target, nowFrozen)
			sendFeedback(admin, (nowFrozen and "Froze " or "Unfroze ") .. target.Name, false)
		else
			sendFeedback(admin, "Could not " .. (nowFrozen and "freeze" or "unfreeze") .. " - character not found", true)
		end

	elseif commandName == "unfreeze" then
		if not frozenUserIds[target.UserId] then
			sendFeedback(admin, target.Name .. " is not frozen", true)
			return
		end
		if setFrozen(target, false) then
			logCommand(admin, "unfreeze", target.Name, nil, admin.Name .. " unfroze " .. target.Name)
			Remote.AdminFreezeStatus:FireClient(target, false)
			sendFeedback(admin, "Unfroze " .. target.Name, false)
		else
			sendFeedback(admin, "Could not unfreeze - character not found", true)
		end

	elseif commandName == "ban" then
		if banUser(target.UserId, extraText, admin.Name, nil, true) then
			logCommand(admin, "ban", target.Name, extraText,
				admin.Name .. " banned " .. target.Name .. (extraText ~= "" and (" - reason: " .. extraText) or " (no reason given, permanent)"))
			sendFeedback(admin, "Banned " .. target.Name, false)
			target:Kick("You have been banned.\nReason: " .. (extraText ~= "" and extraText or "No reason given"))
		else
			sendFeedback(admin, "Failed to save ban - try again", true)
		end

	elseif commandName == "tempban" then
		local durationSeconds, reasonText = parseDurationAndReason(extraText)
		if not durationSeconds then
			sendFeedback(admin, "Usage: :tempban [player] [duration e.g. 24h, 3d, 1w] [reason]", true)
			return
		end
		if banUser(target.UserId, reasonText, admin.Name, durationSeconds, true) then
			logCommand(admin, "tempban", target.Name, formatDuration(durationSeconds) .. " - " .. reasonText,
				admin.Name .. " banned " .. target.Name .. " for " .. formatDuration(durationSeconds) .. (reasonText ~= "" and (" - reason: " .. reasonText) or ""))
			sendFeedback(admin, "Banned " .. target.Name .. " for " .. formatDuration(durationSeconds), false)
			target:Kick("You have been banned for " .. formatDuration(durationSeconds) .. ".\nReason: " .. (reasonText ~= "" and reasonText or "No reason given"))
		else
			sendFeedback(admin, "Failed to save ban - try again", true)
		end

	elseif commandName == "kill" then
		local character = target.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			humanoid.Health = 0
			logCommand(admin, "kill", target.Name, nil, admin.Name .. " killed " .. target.Name)
			sendFeedback(admin, "Killed " .. target.Name, false)
		else
			sendFeedback(admin, "Could not kill - character not found", true)
		end

	elseif commandName == "jail" then
		local nowJailed = not jailedUserIds[target.UserId]
		local success = nowJailed and jailPlayer(target) or (not nowJailed and unjailPlayer(target))
		if success then
			logCommand(admin, "jail", target.Name, nowJailed and "jailed" or "unjailed",
				admin.Name .. " " .. (nowJailed and "jailed " or "unjailed ") .. target.Name)
			sendFeedback(admin, (nowJailed and "Jailed " or "Unjailed ") .. target.Name, false)
		else
			sendFeedback(admin, "Could not " .. (nowJailed and "jail" or "unjail") .. " - character not found", true)
		end

	elseif commandName == "god" then
		local nowGod = not godModeUserIds[target.UserId]
		if setGodMode(target, nowGod) then
			logCommand(admin, "god", target.Name, nowGod and "enabled" or "disabled",
				admin.Name .. " " .. (nowGod and "enabled" or "disabled") .. " god mode for " .. target.Name)
			sendFeedback(admin, (nowGod and "Enabled" or "Disabled") .. " god mode for " .. target.Name, false)
		else
			sendFeedback(admin, "Could not toggle god mode - character not found", true)
		end

	elseif commandName == "respawn" then
		target:LoadCharacter()
		logCommand(admin, "respawn", target.Name, nil, admin.Name .. " respawned " .. target.Name)
		sendFeedback(admin, "Respawned " .. target.Name, false)

	elseif commandName == "spectate" then
		if startSpectating(admin, target) then
			logCommand(admin, "spectate", target.Name, nil, admin.Name .. " started spectating " .. target.Name)
			sendFeedback(admin, "Spectating " .. target.Name, false)
		else
			sendFeedback(admin, "Could not spectate - character not found", true)
		end

	elseif commandName == "controlplayer" then
		if startControlling(admin, target) then
			logCommand(admin, "controlplayer", target.Name, nil, admin.Name .. " started controlling " .. target.Name)
			sendFeedback(admin, "Now controlling " .. target.Name, false)
		else
			sendFeedback(admin, "Could not control - character not found", true)
		end

	elseif commandName == "invis" then
		local nowInvisible = not invisibleUserIds[target.UserId]
		if setInvisible(target, nowInvisible) then
			-- Kept on the player: a respawn or a server hop (runs, :joinserver) keeps them invisible.
			target:SetAttribute("AdminInvis", if nowInvisible then true else nil)
			logCommand(admin, "invis", target.Name, nowInvisible and "hidden" or "shown",
				admin.Name .. " made " .. target.Name .. (nowInvisible and " invisible" or " visible again"))
			sendFeedback(admin, "Made " .. target.Name .. (nowInvisible and " invisible" or " visible again"), false)
		else
			sendFeedback(admin, "Could not toggle invisibility - character not found", true)
		end

	elseif commandName == "viewpets" then
		sendPetList(admin, target)
		sendFeedback(admin, "Showing " .. target.Name .. "'s pets", false)

	elseif commandName == "viewinv" then
		sendInventoryList(admin, target)
		sendFeedback(admin, "Showing " .. target.Name .. "'s inventory", false)

	elseif commandName == "clearinv" then
		local count = clearTargetInventory(target)
		logCommand(admin, "clearinv", target.Name, count .. " item(s)", admin.Name .. " cleared " .. target.Name .. "'s inventory (" .. count .. " item(s))")
		sendFeedback(admin, "Cleared " .. count .. " item(s) from " .. target.Name .. "'s inventory", false)

	elseif commandName == "fly" then
		local nowFlying = not flyingUserIds[target.UserId]
		setFlying(target, nowFlying)
		logCommand(admin, "fly", target.Name, nowFlying and "enabled" or "disabled",
			admin.Name .. " " .. (nowFlying and "enabled" or "disabled") .. " flight for " .. target.Name)
		sendFeedback(admin, (nowFlying and "Enabled" or "Disabled") .. " flight for " .. target.Name, false)

	elseif commandName == "noclip" then
		local given = toggleNoClipTool(target)
		logCommand(admin, "noclip", target.Name, given and "given" or "removed",
			admin.Name .. (given and " gave " or " took ") .. "the No Clip tool " .. (given and "to " or "from ") .. target.Name)
		sendFeedback(admin, if given then "Gave " .. target.Name .. " the No Clip tool (hold it: fly through walls, click to teleport)" else "Took the No Clip tool from " .. target.Name, false)

	elseif commandName == "giant" then
		local size = math.clamp(tonumber(extraText:match("^%s*(%S*)") or "") or 8, 2, 30)
		local makeGiant = not isGiant(target)
		if not setGiantScale(target, if makeGiant then size else 1) then
			sendFeedback(admin, target.Name .. " has no character right now", true)
			return
		end
		logCommand(admin, "giant", target.Name, makeGiant and ("x" .. size) or "normal",
			admin.Name .. " made " .. target.Name .. (makeGiant and (" giant (x" .. size .. ")") or " normal size"))
		sendFeedback(admin, target.Name .. (makeGiant and (" is now x" .. size .. " size") or " is back to normal size"), false)

	elseif commandName == "give" then
		if extraText == "" then
			sendFeedback(admin, "Usage: :give [player] [item name]", true)
			return
		end
		local success, itemNameOrErr = giveItem(target, extraText)
		if success then
			logCommand(admin, "give", target.Name, itemNameOrErr, admin.Name .. " gave " .. target.Name .. " a " .. itemNameOrErr)
			sendFeedback(admin, "Gave " .. target.Name .. " a " .. itemNameOrErr, false)
		else
			sendFeedback(admin, itemNameOrErr, true)
		end
	end
end)

Remote.AdminRemoveWarning.OnServerEvent:Connect(function(admin, targetUserId, warningIndex)
	local tier = getPlayerTier(admin)
	if not tierHasCommand(tier, "warnlist") then return end
	if typeof(targetUserId) ~= "number" or typeof(warningIndex) ~= "number" then return end

	local warnings = getWarnings(targetUserId)
	if warningIndex &lt; 1 or warningIndex &gt; #warnings then
		sendFeedback(admin, "That warning no longer exists.", true)
		return
	end

	-- Captured before removal - buildLogEntries below only has the
	-- removed warning's own Reason to show once it's gone from the
	-- live list, and this is the only point where that text still exists.
	local removedWarning = warnings[warningIndex]
	table.remove(warnings, warningIndex)
	saveWarnings(targetUserId, warnings)
	sendFeedback(admin, "Removed warning #" .. warningIndex, false)
	Remote.AdminWarningsList:FireClient(admin, nil, targetUserId, warnings)

	-- Logged the same way every other command is - previously this
	-- action wasn't logged at all, so removing a warning left no trace
	-- in :cmdlogs/:playerlogs even though every other admin action did.
	local success, targetName = pcall(function()
		return Players:GetNameFromUserIdAsync(targetUserId)
	end)
	local unwarnTargetName = success and targetName or ("UserId " .. tostring(targetUserId))
	logCommand(
		admin,
		"unwarn",
		unwarnTargetName,
		"removed warning #" .. warningIndex .. " (" .. tostring(removedWarning.Reason) .. ")",
		admin.Name .. " removed " .. unwarnTargetName .. "'s warning #" .. warningIndex .. " (" .. tostring(removedWarning.Reason) .. ")"
	)
end)

Remote.AdminViewWarnings.OnServerEvent:Connect(function(admin, userIdStr)
	local tier = getPlayerTier(admin)
	if not tierHasCommand(tier, "warnlist") then return end
	local userId = tonumber(userIdStr)
	if not userId then return end

	local warnings = getWarnings(userId)
	local success, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	Remote.AdminWarningsList:FireClient(admin, success and name or ("UserId " .. userIdStr), userId, warnings)
end)

Remote.AdminModifyPunishment.OnServerEvent:Connect(function(admin, kind, userIdStr, action, value)
	if kind ~= "ban" and kind ~= "mute" then return end
	-- Gated on whoever can see the list this came from, rather than a
	-- dedicated command - :unban no longer exists as its own typed
	-- command (unbanning is only ever done from :banlist's "Modify"
	-- popup now), so there's no other command left to gate this on.
	local requiredCommand = (kind == "ban") and "banlist" or "mutelist"
	local tier = getPlayerTier(admin)
	if not tierHasCommand(tier, requiredCommand) then return end
	local userId = tonumber(userIdStr)
	if not userId then return end

	if kind == "ban" then
		if action == "remove" then
			-- Captured before removal, same reasoning as the warning
			-- removal above - once unbanUser runs, the reason that was on
			-- this ban is gone for good, and previously this action wasn't
			-- logged with any detail at all (just the raw UserId, not even
			-- a resolved username).
			local banData = isBanned(userId)
			unbanUser(userId)
			local success, targetName = pcall(function()
				return Players:GetNameFromUserIdAsync(userId)
			end)
			local unbanTargetName = success and targetName or ("UserId " .. userIdStr)
			logCommand(
				admin,
				"unban",
				unbanTargetName,
				banData and ("removed ban: " .. tostring(banData.Reason)) or "removed ban",
				admin.Name .. " unbanned " .. unbanTargetName .. (banData and (" (was: " .. tostring(banData.Reason) .. ")") or "")
			)
			sendFeedback(admin, "Unbanned", false)
		elseif action == "reason" and typeof(value) == "string" then
			local banData = isBanned(userId)
			if banData then
				-- Captured before mutation - banData is the SAME table
				-- reference cached in banRecordsCache, so assigning
				-- banData.Reason below overwrites it in place before
				-- there's a chance to log what it used to say.
				local oldReason = banData.Reason
				local newReason = string.sub(value, 1, 200)
				-- waitForPersist=true - same reasoning as :ban/:tempban: an
			-- edit that only reached the in-memory cache before the
			-- server happened to stop (a live server cycling, or -
			-- guaranteed - Studio's Stop button) would silently revert
			-- to whatever the DataStore last actually had once a fresh
			-- server reseeds from it, undoing this edit with no trace.
			banUser(userId, newReason, banData.BannedBy, banData.ExpiresAt and (banData.ExpiresAt - os.time()) or nil, true)
				local success, targetName = pcall(function()
					return Players:GetNameFromUserIdAsync(userId)
				end)
				local reasonTargetName = success and targetName or ("UserId " .. userIdStr)
				-- Logged under the same "ban" command name (not a made-up
				-- "banreason") so :cmdlogs' own search-by-command picks
				-- this up alongside the original :ban/:tempban entries for
				-- the same user - the Extra text is what actually says
				-- this was an edit, not a fresh ban.
				logCommand(admin, "ban", reasonTargetName, "reason updated: " .. newReason,
					admin.Name .. " changed " .. reasonTargetName .. "'s ban reason from \"" .. (oldReason ~= "" and oldReason or "no reason") .. "\" to \"" .. newReason .. "\"")
				sendFeedback(admin, "Updated ban reason", false)
			end
		elseif action == "duration" then
			local banData = isBanned(userId)
			if banData then
				local oldDurationText = banData.ExpiresAt and formatDuration(math.max(0, banData.ExpiresAt - os.time())) or "Permanent"
				local durationSeconds = (typeof(value) == "number") and value or nil
				local newDurationText = durationSeconds and formatDuration(durationSeconds) or "Permanent"
				-- waitForPersist=true - see the comment on the reason
				-- branch above.
				banUser(userId, banData.Reason, banData.BannedBy, durationSeconds, true)
				local success, targetName = pcall(function()
					return Players:GetNameFromUserIdAsync(userId)
				end)
				local durationTargetName = success and targetName or ("UserId " .. userIdStr)
				logCommand(admin, "ban", durationTargetName, "duration updated: " .. newDurationText,
					admin.Name .. " changed " .. durationTargetName .. "'s ban duration from " .. oldDurationText .. " to " .. newDurationText)
				sendFeedback(admin, "Updated ban duration", false)
			end
		end
		local entries = buildBanListEntries()
		Remote.AdminBanList:FireClient(admin, "Banned Players (" .. #entries .. ")", entries)

	elseif kind == "mute" then
		if action == "remove" then
			-- Captured before removal - same reasoning as unban/unwarn
			-- above, and this previously logged under the "mute" command
			-- name with no detail, which made an unmute in :cmdlogs
			-- indistinguishable from a fresh :mute at a glance.
			local muteData = getMuteData(userId)
			mutedUserIds[userId] = nil
			removeMuteData(userId)
			local success, targetName = pcall(function()
				return Players:GetNameFromUserIdAsync(userId)
			end)
			local unmuteTargetName = success and targetName or ("UserId " .. userIdStr)
			logCommand(
				admin,
				"unmute",
				unmuteTargetName,
				muteData and ("removed mute: " .. tostring(muteData.Reason)) or "removed mute",
				admin.Name .. " unmuted " .. unmuteTargetName .. (muteData and (" (was: " .. tostring(muteData.Reason) .. ")") or "")
			)
			local targetPlayerObj = Players:GetPlayerByUserId(userId)
			if targetPlayerObj then
				Remote.AdminMuteStatus:FireClient(targetPlayerObj, false, nil)
			end
			sendFeedback(admin, "Unmuted", false)
		elseif action == "reason" and typeof(value) == "string" then
			local data = getMuteData(userId)
			if data then
				-- Captured before mutation - same reasoning as the ban
				-- reason branch above (data is the same table reference
				-- cached in muteRecordsCache).
				local oldReason = data.Reason
				local newReason = string.sub(value, 1, 200)
				data.Reason = newReason
				saveMuteData(userId, data, true)
				if mutedUserIds[userId] then mutedUserIds[userId] = data end
				local success, targetName = pcall(function()
					return Players:GetNameFromUserIdAsync(userId)
				end)
				local reasonTargetName = success and targetName or ("UserId " .. userIdStr)
				logCommand(admin, "mute", reasonTargetName, "reason updated: " .. newReason,
					admin.Name .. " changed " .. reasonTargetName .. "'s mute reason from \"" .. (oldReason ~= "" and oldReason or "no reason") .. "\" to \"" .. newReason .. "\"")
				sendFeedback(admin, "Updated mute reason", false)
			end
		elseif action == "duration" then
			local data = getMuteData(userId)
			if data then
				local oldDurationText = data.ExpiresAt and formatDuration(math.max(0, data.ExpiresAt - os.time())) or "Permanent"
				data.ExpiresAt = (typeof(value) == "number") and (os.time() + value) or nil
				local newDurationText = data.ExpiresAt and formatDuration(data.ExpiresAt - os.time()) or "Permanent"
				saveMuteData(userId, data, true)
				if mutedUserIds[userId] then mutedUserIds[userId] = data end
				local success, targetName = pcall(function()
					return Players:GetNameFromUserIdAsync(userId)
				end)
				local durationTargetName = success and targetName or ("UserId " .. userIdStr)
				logCommand(admin, "mute", durationTargetName, "duration updated: " .. newDurationText,
					admin.Name .. " changed " .. durationTargetName .. "'s mute duration from " .. oldDurationText .. " to " .. newDurationText)
				local targetPlayerObj = Players:GetPlayerByUserId(userId)
				if targetPlayerObj then
					Remote.AdminMuteStatus:FireClient(targetPlayerObj, true, data.ExpiresAt)
				end
				sendFeedback(admin, "Updated mute duration", false)
			end
		end
		syncChatMutes()
		local entries = buildMuteListEntries()
		Remote.AdminMuteList:FireClient(admin, "Muted Players (" .. #entries .. ")", entries)
	end
end)

Remote.AdminInventoryRemoveItem.OnServerEvent:Connect(function(admin, tool)
	local tier = getPlayerTier(admin)
	if not tierHasCommand(tier, "viewinv") and not tierHasCommand(tier, "clearinv") then return end
	if typeof(tool) ~= "Instance" or not tool:IsA("Tool") then return end

	-- Resolved BEFORE destroying it - once it's gone, there's no more
	-- Parent chain left to trace back to whoever it belonged to.
	local owner = findToolOwner(tool)
	local toolName = tool.Name
	tool:Destroy()

	if owner then
		logCommand(admin, "clearinv", owner.Name, "removed " .. toolName,
			admin.Name .. " removed " .. owner.Name .. "'s " .. toolName)
		sendInventoryList(admin, owner)
	end
	sendFeedback(admin, "Removed " .. toolName, false)
end)

-- Registered here (rather than up alongside startSpectating/
-- startControlling, where the rest of the spectate/controlplayer logic
-- lives) specifically because this needs logCommand/sendFeedback, both
-- declared as locals well after this point in the file - see the
-- comment left in their place, right after startSpectating, for the
-- full explanation.
Remote.AdminStopSpectating.OnServerEvent:Connect(function(admin)
	local state = spectatingState[admin.UserId]
	if not state then return end
	logCommand(admin, "spectate", state.Target.Name, "stopped", admin.Name .. " stopped spectating " .. state.Target.Name)
	stopSpectatingServer(admin)
	sendFeedback(admin, "Stopped spectating", false)
end)

Remote.AdminStopControlling.OnServerEvent:Connect(function(admin)
	local target = controllingUserIds[admin.UserId]
	if not target then return end
	logCommand(admin, "controlplayer", target.Name, "stopped", admin.Name .. " stopped controlling " .. target.Name)
	stopControlling(admin)
	sendFeedback(admin, "Stopped controlling " .. target.Name, false)
end)

print("[AdminServer] ready" .. (if storesOffline then " (Studio: bans, mutes, warnings and logs are kept for this session only; they save once the place is published with API access on)" else ""))

-- =====================================================================
-- Leaderboards view (admin panel): every board, reset a player on one
-- =====================================================================
do
local leaderboardBusy = {}
Remote.AdminLeaderboard.OnServerEvent:Connect(function(admin, action, index, userId)
	if not tierHasCommand(getPlayerTier(admin), "leaderboards") then
		return
	end
	-- Only a reset waits its turn; viewing reads the boards' cache, so every click is answered.
	if action == "Reset" and leaderboardBusy[admin] then
		return
	end
	local count = LeaderboardService.BoardCount()
	if type(index) ~= "number" or index ~= index then
		return
	end
	index = ((math.floor(index) - 1) % count) + 1
	if action == "Reset" then
		leaderboardBusy[admin] = true
	end
	local ok, err = pcall(function()
		if action == "Reset" then
			if type(userId) ~= "number" then
				return
			end
			local done, message = LeaderboardService.ResetEntry(index, userId)
			sendFeedback(admin, message, not done)
			if done then
				logCommand(admin, "leaderboards", tostring(userId), LeaderboardService.BoardTitle(index), admin.Name .. " " .. message)
			end
		end
		local rows = LeaderboardService.ListBoard(index, 100)
		-- A reset player can still be in the list for a moment (DataStore caching): hide them here.
		if action == "Reset" and type(userId) == "number" then
			for i = #rows, 1, -1 do
				if rows[i].UserId == userId then
					table.remove(rows, i)
				end
			end
		end
		Remote.AdminLeaderboard:FireClient(admin, index, count, LeaderboardService.BoardTitle(index), rows)
	end)
	if action == "Reset" then
		leaderboardBusy[admin] = nil
	end
	if not ok then
		dsWarn("[AdminServer] leaderboards: " .. tostring(err))
		sendFeedback(admin, "Couldn't load that leaderboard", true)
	end
end)
Players.PlayerRemoving:Connect(function(p)
	leaderboardBusy[p] = nil
end)
end

-- :globalannounce from any server shows here too.
task.spawn(function()
	pcall(function()
		MessagingService:SubscribeAsync("RinseCycle_GlobalAnnounce", function(message)
			local data = message.Data
			local text = type(data) == "table" and data.Text
			if type(text) == "string" and text ~= "" then
				for _, plr in ipairs(Players:GetPlayers()) do
					Remote.AdminAnnouncement:FireClient(plr, string.sub(text, 1, 200))
				end
			end
		end)
	end)
end)

-- =====================================================================
-- Pets view (:viewpets): see a player's pets, remove one, or add one
-- =====================================================================
do
local PET_TIER_NAMES = { "", "Golden ", "Rainbow " }
sendPetList = function(admin, target)
	local profile = DataService.Get(target)
	local rows = {}
	if profile then
		local equipped = {}
		for _, uid in ipairs(profile.Equipped or {}) do
			equipped[uid] = true
		end
		for _, pet in ipairs(profile.Pets or {}) do
			local def = Config.Pets[pet.Id]
			if def then
				local tier = math.clamp(tonumber(pet.Tier) or 1, 1, 3)
				table.insert(rows, {
					Id = pet.Uid,
					Line1 = PET_TIER_NAMES[tier] .. def.Name .. (if equipped[pet.Uid] then "  (equipped)" else ""),
					Line2 = def.Rarity .. "  ·  Speed " .. tostring(Config.PetSpeedRating(pet.Id, tier)) .. "/100",
				})
			end
		end
	end
	Remote.AdminPetList:FireClient(admin, target.UserId, "🐾 " .. target.Name .. "'s pets (" .. #rows .. ")", rows)
end

Remote.AdminPetAction.OnServerEvent:Connect(function(admin, action, targetUserId, a, b)
	if not tierHasCommand(getPlayerTier(admin), "viewpets") then
		return
	end
	local target = type(targetUserId) == "number" and Players:GetPlayerByUserId(targetUserId) or nil
	if not target then
		sendFeedback(admin, "They're not in this server any more", true)
		return
	end
	if action == "Remove" and type(a) == "string" then
		local result = PetService.Delete(target, a)
		if result and result.Ok then
			logCommand(admin, "viewpets", target.Name, "removed pet " .. a, admin.Name .. " removed a pet from " .. target.Name)
			sendFeedback(admin, "Removed that pet from " .. target.Name, false)
		else
			sendFeedback(admin, (result and result.Error) or "Couldn't remove that pet", true)
		end
	elseif action == "Add" and type(a) == "string" and Config.Pets[a] then
		local tier = math.clamp(math.floor(tonumber(b) or 1), 1, 3)
		local ok, err = PetService.GivePet(target, a, tier)
		if ok then
			local label = PET_TIER_NAMES[tier] .. Config.Pets[a].Name
			logCommand(admin, "givepet", target.Name, label, admin.Name .. " gave " .. target.Name .. " a " .. label)
			sendFeedback(admin, "Gave " .. target.Name .. " a " .. label, false)
		else
			sendFeedback(admin, err or "Couldn't add that pet", true)
		end
	else
		return
	end
	sendPetList(admin, target)
end)
end

-- =====================================================================
-- Server hops: invisibility carries over, and :joinserver / :bringserver land you next to them
-- =====================================================================
do
local function afterArrival(player)
	local data
	pcall(function()
		data = player:GetJoinData().TeleportData
	end)
	if type(data) ~= "table" then
		return
	end
	if type(data.AdminInvis) == "table" and table.find(data.AdminInvis, player.UserId) then
		player:SetAttribute("AdminInvis", true)
	end
	local followId = tonumber(data.FollowUserId)
	if followId and (data.Mode == "AdminJoin" or data.Mode == "AdminBring") then
		task.spawn(function()
			local character = player.Character or player.CharacterAdded:Wait()
			local root = character:WaitForChild("HumanoidRootPart", 10)
			task.wait(1)
			local other = Players:GetPlayerByUserId(followId)
			local otherRoot = other and other.Character and other.Character:FindFirstChild("HumanoidRootPart")
			if root and otherRoot then
				root.CFrame = otherRoot.CFrame * CFrame.new(0, 0, 4)
			end
		end)
	end
end

-- Keeps an :invis'd player invisible on every new character (respawns, and after a server hop).
local function watchInvis(player)
	player.CharacterAdded:Connect(function(character)
		if player:GetAttribute("AdminInvis") ~= true then
			return
		end
		invisibleUserIds[player.UserId] = nil -- the old character's saved looks don't apply any more
		character:WaitForChild("HumanoidRootPart", 10)
		task.wait(0.5)
		if player:GetAttribute("AdminInvis") == true and player.Character == character then
			setInvisible(player, true)
		end
	end)
	if player:GetAttribute("AdminInvis") == true and player.Character then
		invisibleUserIds[player.UserId] = nil
		setInvisible(player, true)
	end
end

Players.PlayerAdded:Connect(function(player)
	afterArrival(player)
	watchInvis(player)
end)
for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(function()
		afterArrival(player)
		watchInvis(player)
	end)
end
end

-- :bringserver from another server: if they're here, send them over.
task.spawn(function()
	pcall(function()
		MessagingService:SubscribeAsync("RinseCycle_AdminBring", function(message)
			local data = message.Data
			if type(data) ~= "table" or type(data.UserId) ~= "number" or type(data.JobId) ~= "string" then
				return
			end
			local player = Players:GetPlayerByUserId(data.UserId)
			if not player or data.JobId == game.JobId then
				return
			end
			pcall(function()
				local options = Instance.new("TeleportOptions")
				if type(data.Code) == "string" and data.Code ~= "" then
					options.ReservedServerAccessCode = data.Code
				else
					options.ServerInstanceId = data.JobId
				end
				options:SetTeleportData({ Mode = "AdminBring", FollowUserId = data.AdminId, AdminInvis = RunServers.InvisList({ player }) })
				TeleportService:TeleportAsync(game.PlaceId, { player }, options)
			end)
		end)
	end)
end)

-- =====================================================================
-- Staff list (:stafflist): everyone with a staff rank, Remove works even when they're offline
-- =====================================================================
Remote.AdminStaffList = Instance.new("RemoteEvent")
Remote.AdminStaffList.Name = "AdminStaffList"
Remote.AdminStaffList.Parent = ReplicatedStorage
Remote.AdminStaffAction = Instance.new("RemoteEvent")
Remote.AdminStaffAction.Name = "AdminStaffAction"
Remote.AdminStaffAction.Parent = ReplicatedStorage

function Staff.SendList(admin)
	local rows = {}
	for id, entry in pairs(Staff.Map) do
		if type(entry) == "table" then
			local online = Players:GetPlayerByUserId(tonumber(id) or 0) ~= nil
			table.insert(rows, {
				Id = tonumber(id),
				Line1 = tostring(entry.Name or id) .. "  [" .. tostring(Staff.Tags[entry.Tier] or entry.Tier) .. "]",
				Line2 = tostring(entry.Tier) .. "  ·  UserId " .. id .. (if online then "  ·  online" else ""),
			})
		end
	end
	table.sort(rows, function(a, b)
		return a.Line1 &lt; b.Line1
	end)
	Remote.AdminStaffList:FireClient(admin, "🛡️ Staff (" .. #rows .. ")", rows)
end

Remote.AdminStaffAction.OnServerEvent:Connect(function(admin, action, userId)
	if not isOwner(admin) or action ~= "Remove" or type(userId) ~= "number" then
		return
	end
	local entry = Staff.Map[tostring(userId)]
	local name = if type(entry) == "table" then tostring(entry.Name) else tostring(userId)
	task.spawn(function()
		Staff.Set(userId, nil, nil)
		logCommand(admin, "setadminrank", name, "cleared", admin.Name .. " removed " .. name .. "'s staff rank")
		sendFeedback(admin, name .. " is no longer staff", false)
		Staff.SendList(admin)
	end)
end)

-- =====================================================================
-- All servers (:serverlist): each server lists its players in a shared MemoryStore map every
-- 30 s; the admin sees everyone everywhere and can join (arriving invisible) or bring anyone.
-- =====================================================================
Remote.AdminServerList = Instance.new("RemoteEvent")
Remote.AdminServerList.Name = "AdminServerList"
Remote.AdminServerList.Parent = ReplicatedStorage
Remote.AdminServerAction = Instance.new("RemoteEvent")
Remote.AdminServerAction.Name = "AdminServerAction"
Remote.AdminServerAction.Parent = ReplicatedStorage

ServerList.TTL = 90
ServerList.Map = nil
pcall(function()
	ServerList.Map = game:GetService("MemoryStoreService"):GetSortedMap("RinseCycle_ServerList")
end)

function ServerList.Snapshot()
	local list = {}
	for _, plr in ipairs(Players:GetPlayers()) do
		table.insert(list, { UserId = plr.UserId, Name = plr.Name, Display = plr.DisplayName, Hidden = plr:GetAttribute("AdminInvis") == true })
	end
	return { Players = list, Run = RunServers.IsRunServer, Updated = os.time() }
end

function ServerList.Publish()
	local map = ServerList.Map
	if not map then
		return
	end
	pcall(function()
		if #Players:GetPlayers() == 0 then
			map:RemoveAsync(game.JobId)
		else
			map:SetAsync(game.JobId, ServerList.Snapshot(), ServerList.TTL)
		end
	end)
end

-- Every server (this one included), as { JobId, Run, Players }.
function ServerList.Read()
	local servers = {}
	local map = ServerList.Map
	if map then
		pcall(function()
			for _, item in ipairs(map:GetRangeAsync(Enum.SortDirection.Ascending, 200)) do
				if type(item.value) == "table" and item.key ~= game.JobId then
					table.insert(servers, { JobId = item.key, Run = item.value.Run == true, Players = item.value.Players or {} })
				end
			end
		end)
	end
	local here = ServerList.Snapshot()
	table.insert(servers, 1, { JobId = game.JobId, Run = here.Run, Players = here.Players, Here = true })
	return servers
end

function ServerList.Send(admin)
	local rows = {}
	local busiest, busiestCount = nil, 0
	for i, server in ipairs(ServerList.Read()) do
		local names, follow = {}, nil
		for _, p in ipairs(server.Players) do
			if p.UserId ~= admin.UserId and not p.Hidden then
				table.insert(names, tostring(p.Name))
				follow = follow or p.UserId
			end
		end
		local count = #names
		if not server.Here and not server.Run and count &gt; busiestCount then
			busiest, busiestCount = server.JobId, count
		end
		-- One row (and one Join) per server; your own server isn't listed.
		if not server.Here and count &gt; 0 then
			local shown = table.concat(names, ", ", 1, math.min(#names, 6)) .. (if #names &gt; 6 then ", +" .. (#names - 6) .. " more" else "")
			table.insert(rows, {
				Id = follow,
				JobId = server.JobId,
				Line1 = (if server.Run then "Run" else "Lobby") .. " server " .. i .. " - " .. count .. " player" .. (if count == 1 then "" else "s"),
				Line2 = shown,
			})
		end
	end
	Remote.AdminServerList:FireClient(admin, "Every server (" .. #rows .. ")", rows, busiest)
end

-- Teleports the admin into a server, invisible (they arrive hidden: nobody sees them join).
function ServerList.Join(admin, jobId, followUserId)
	if jobId == game.JobId then
		local target = followUserId and Players:GetPlayerByUserId(followUserId)
		if target then
			gotoPlayer(admin, target)
		end
		return true
	end
	local code = RunServers.AccessCodeForJob(jobId)
	return pcall(function()
		local options = Instance.new("TeleportOptions")
		if code then
			options.ReservedServerAccessCode = code
		else
			options.ServerInstanceId = jobId
		end
		options:SetTeleportData({ Mode = "AdminJoin", FollowUserId = followUserId, AdminInvis = { admin.UserId } })
		TeleportService:TeleportAsync(game.PlaceId, { admin }, options)
	end)
end

Remote.AdminServerAction.OnServerEvent:Connect(function(admin, action, jobId, userId)
	local tier = getPlayerTier(admin)
	if type(jobId) ~= "string" or jobId == "" then
		return
	end
	if action == "Join" and tierHasCommand(tier, "joinserver") then
		local ok = ServerList.Join(admin, jobId, tonumber(userId))
		sendFeedback(admin, if ok then "Joining that server (you'll arrive invisible)..." else "That teleport couldn't start", not ok)
		if ok then
			logCommand(admin, "joinserver", tostring(userId or jobId), nil, admin.Name .. " joined another server from the server list")
		end
	elseif action == "Bring" and tierHasCommand(tier, "bringserver") and type(userId) == "number" then
		local here = Players:GetPlayerByUserId(userId)
		if here then
			bringPlayer(admin, here)
			sendFeedback(admin, "Brought " .. here.Name, false)
			return
		end
		local ok = pcall(function()
			MessagingService:PublishAsync("RinseCycle_AdminBring", {
				UserId = userId,
				JobId = game.JobId,
				Code = RunServers.AccessCodeForJob(game.JobId),
				AdminId = admin.UserId,
			})
		end)
		sendFeedback(admin, if ok then "Asked their server to send them here..." else "Couldn't reach other servers", not ok)
	end
end)

task.spawn(function()
	while true do
		ServerList.Publish()
		task.wait(30)
	end
end)
Players.PlayerAdded:Connect(function()
	task.delay(2, ServerList.Publish)
end)
Players.PlayerRemoving:Connect(function()
	task.delay(1, ServerList.Publish)
end)
game:BindToClose(function()
	if ServerList.Map then
		pcall(function()
			ServerList.Map:RemoveAsync(game.JobId)
		end)
	end
end)

-- =====================================================================
-- Global events (the panel's Global tab): polls, giveaways, pass drops and x2 boosts in EVERY
-- server. One MessagingService topic carries them all; each server runs its own players' part.
-- Without MessagingService (Studio) everything just runs in this server.
-- =====================================================================
Remote.GlobalPoll = Instance.new("RemoteEvent")
Remote.GlobalPoll.Name = "GlobalPoll"
Remote.GlobalPoll.Parent = ReplicatedStorage
Remote.GlobalPollVote = Instance.new("RemoteEvent")
Remote.GlobalPollVote.Name = "GlobalPollVote"
Remote.GlobalPollVote.Parent = ReplicatedStorage
Remote.GlobalCountdown = Instance.new("RemoteEvent") -- S-&gt;C ("Set", name, endsAt, liveMinutes) / ("Clear")
Remote.GlobalCountdown.Name = "GlobalCountdown"
Remote.GlobalCountdown.Parent = ReplicatedStorage
do
	local TextService = game:GetService("TextService")
	local Format = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Format"))
	local TOPIC = "RinseCycle_GlobalEvent"
	local handlers = {}
	local Commands = GlobalEvents.Commands

	local function publish(data)
		local ok = pcall(function()
			MessagingService:PublishAsync(TOPIC, data)
		end)
		if not ok then
			local handler = handlers[data.Kind]
			if handler then
				task.spawn(handler, data)
			end
		end
		return ok
	end
	task.spawn(function()
		pcall(function()
			MessagingService:SubscribeAsync(TOPIC, function(message)
				local data = message.Data
				local handler = type(data) == "table" and handlers[data.Kind]
				if handler then
					handler(data)
				end
			end)
		end)
	end)

	local function bannerAll(text)
		for _, plr in ipairs(Players:GetPlayers()) do
			Remote.AdminAnnouncement:FireClient(plr, string.sub(text, 1, 200))
		end
	end
	handlers.Banner = function(d)
		if type(d.Text) == "string" then
			bannerAll(d.Text)
		end
	end

	----------------------------------------------------------------- polls
	-- :globalpoll [30|60|120] Question | answer | answer ... Everyone gets a popup with buttons;
	-- each server counts its own votes and sends the counts back to the admin's server, which sends
	-- the final results to every server: each player's poll card turns into the results (once, no
	-- banner), and stays until they close it.
	local polls = {} -- [id] = { Id, Question, Options, EndsAt, Votes = { [userId] = index } }
	local collecting = {} -- on the admin's server: [id] = { Counts, Question, Options, Admin }

	local function sendPoll(plr, poll)
		Remote.GlobalPoll:FireClient(plr, "Start", poll.Id, poll.Question, poll.Options, poll.EndsAt)
	end
	handlers.PollStart = function(d)
		if type(d.Id) ~= "string" or type(d.Options) ~= "table" or polls[d.Id] then
			return
		end
		local poll = { Id = d.Id, Question = tostring(d.Question), Options = d.Options, EndsAt = tonumber(d.EndsAt) or Config.Now(), Origin = d.Origin, Votes = {}, Silent = d.Silent == true }
		polls[d.Id] = poll
		for _, plr in ipairs(Players:GetPlayers()) do
			sendPoll(plr, poll)
		end
		task.delay(math.max(0, poll.EndsAt - Config.Now()) + 0.5, function()
			local counts = {}
			for i = 1, #poll.Options do
				counts[i] = 0
			end
			for _, index in pairs(poll.Votes) do
				counts[index] += 1
			end
			polls[poll.Id] = nil
			for _, plr in ipairs(Players:GetPlayers()) do
				-- A show poll's card goes away the second it ends (no results card).
				Remote.GlobalPoll:FireClient(plr, if poll.Silent then "Close" else "End", poll.Id)
			end
			publish({ Kind = "PollTally", Id = poll.Id, Origin = poll.Origin, Counts = counts })
		end)
	end
	handlers.PollTally = function(d)
		local c = collecting[d.Id]
		if not c or d.Origin ~= game.JobId or type(d.Counts) ~= "table" then
			return
		end
		for i = 1, #c.Options do
			c.Counts[i] += math.max(0, math.floor(tonumber(d.Counts[i]) or 0))
		end
	end
	handlers.PollResult = function(d)
		if type(d.Id) ~= "string" or type(d.Options) ~= "table" or type(d.Counts) ~= "table" then
			return
		end
		for _, plr in ipairs(Players:GetPlayers()) do
			Remote.GlobalPoll:FireClient(plr, "Result", d.Id, tostring(d.Question), d.Options, d.Counts)
		end
	end
	Players.PlayerAdded:Connect(function(plr)
		for _, poll in pairs(polls) do
			if poll.EndsAt &gt; Config.Now() then
				sendPoll(plr, poll)
			end
		end
	end)
	Remote.GlobalPollVote.OnServerEvent:Connect(function(plr, id, index)
		local poll = type(id) == "string" and polls[id]
		if poll and type(index) == "number" and index == math.floor(index) and index &gt;= 1 and index &lt;= #poll.Options and Config.Now() &lt;= poll.EndsAt then
			poll.Votes[plr.UserId] = index -- you can change your mind until it ends
		end
	end)

	Commands.globalpoll = function(admin, text)
		local seconds, rest = text:match("^(%d+)%s+(.+)$")
		seconds = math.clamp(tonumber(seconds) or 60, 15, 300)
		local parts = {}
		for piece in string.gmatch(rest or text, "[^|]+") do
			piece = piece:match("^%s*(.-)%s*$")
			if piece ~= "" then
				table.insert(parts, string.sub(piece, 1, 60))
			end
		end
		if #parts &lt; 3 then
			sendFeedback(admin, "Usage: :globalpoll 60 Question | answer | answer (2 to 4 answers)", true)
			return
		end
		local question = table.remove(parts, 1)
		local options = { table.unpack(parts, 1, math.min(#parts, 4)) }
		-- Chat filter: the question and answers are shown to everyone.
		local okFilter, filtered = pcall(function()
			local all = question .. "\n" .. table.concat(options, "\n")
			return TextService:FilterStringAsync(all, admin.UserId):GetNonChatStringForBroadcastAsync()
		end)
		if okFilter and type(filtered) == "string" then
			local lines = string.split(filtered, "\n")
			question = lines[1] or question
			for i = 1, #options do
				options[i] = lines[i + 1] or options[i]
			end
		end
		local id = game.JobId .. ":" .. tostring(os.clock())
		local counts = {}
		for i = 1, #options do
			counts[i] = 0
		end
		collecting[id] = { Counts = counts, Question = question, Options = options }
		publish({ Kind = "PollStart", Id = id, Question = question, Options = options, EndsAt = os.time() + seconds, Origin = game.JobId })
		sendFeedback(admin, string.format("Poll sent to every server: results in %d s", seconds), false)
		logCommand(admin, "globalpoll", nil, question, admin.Name .. " started a global poll: " .. question)
		-- Every server's counts come back a few seconds after it closes.
		task.delay(seconds + 7, function()
			local c = collecting[id]
			collecting[id] = nil
			if not c then
				return
			end
			publish({ Kind = "PollResult", Id = id, Question = c.Question, Options = c.Options, Counts = c.Counts })
		end)
	end

	----------------------------------------------------------------- giveaways
	-- :globalgive [Bubbles|Gems|Coins] [amount]: everyone online, in every server. Coins only exist
	-- inside a dishwasher, so they go to whoever is cleaning right now.
	local CURRENCIES = { bubbles = "Bubbles", gems = "Gems", coins = "Coins" }
	handlers.GiveAll = function(d)
		local currency = CURRENCIES[string.lower(tostring(d.Currency))]
		local amount = math.floor(tonumber(d.Amount) or 0)
		if not currency or amount &lt;= 0 then
			return
		end
		for _, plr in ipairs(Players:GetPlayers()) do
			local given = false
			if currency == "Bubbles" then
				given = DataService.AddBubbles(plr, amount, "admin event")
			elseif currency == "Gems" then
				given = DataService.AddGems(plr, amount)
			else
				given = RoundService.AddCoins(plr, amount)
			end
			if given then
				celebrate(plr, "Admin event!", string.format("Everyone got %s %s!", Format.Commas(amount), currency), "@Gift")
			end
		end
	end
	Commands.globalgive = function(admin, text)
		local currencyText, amountText = text:match("^(%a+)%s+(%d+)")
		local currency = currencyText and CURRENCIES[string.lower(currencyText)]
		local amount = math.clamp(math.floor(tonumber(amountText) or 0), 0, 1000000)
		if not currency or amount &lt;= 0 then
			sendFeedback(admin, "Usage: :globalgive [Bubbles|Gems|Coins] [amount]", true)
			return
		end
		local ok = publish({ Kind = "GiveAll", Currency = currency, Amount = amount })
		sendFeedback(admin, string.format("Gave everyone %s %s%s", Format.Commas(amount), currency, if ok then " in every server" else " (this server only)"), false)
		logCommand(admin, "globalgive", nil, currency .. " " .. amount, string.format("%s gave everyone %d %s", admin.Name, amount, currency))
	end

	----------------------------------------------------------------- pass drops
	-- :globalpassdrop [winners] [pass key | random]: that many random players (across every
	-- server) win a game pass
	-- (or 100 Gems instead if they already own it).
	handlers.PassDrop = function(d)
		if type(d.W) ~= "table" then
			return
		end
		for _, w in ipairs(d.W) do
			local plr = Players:GetPlayerByUserId(tonumber(w.u) or 0)
			if plr then
				local passes = DataService.GetPasses and DataService.GetPasses(plr) or {}
				local function has(key)
					return passes[key] == true or plr:GetAttribute(gamepassAttribute(key)) == true
				end
				local pass = Config.GetPass(tostring(w.p))
				if pass and has(pass.Key) then
					pass = nil -- they already own it: Gems instead (below)
				end
				if pass then
					setGamepassGrant(plr, pass, true, false)
					celebrate(plr, "You won a game pass!", "Lucky draw: you got " .. pass.Name .. "!", pass.Icon)
				else
					DataService.AddGems(plr, 100)
					celebrate(plr, "You won!", "You already own that pass, so here are 100 Gems instead!", "@Gift")
				end
			end
		end
		if type(d.Text) == "string" then
			bannerAll(d.Text)
		end
	end
	Commands.globalpassdrop = function(admin, text)
		local countText, passText = text:match("^(%d+)%s*(.*)$")
		local count = math.clamp(math.floor(tonumber(countText) or 0), 0, 25)
		if count &lt;= 0 then
			sendFeedback(admin, "Usage: :globalpassdrop [winners 1-25] [pass or random]", true)
			return
		end
		local chosen = nil
		if passText ~= "" and string.lower(passText) ~= "random" then
			chosen = resolveGamepass(passText)
			if not chosen then
				sendFeedback(admin, "Unknown pass: " .. passText, true)
				return
			end
		end
		-- Everyone online in every server (from the server list), hidden staff left out.
		local pool = {}
		local seen = {}
		for _, server in ipairs(ServerList.Read()) do
			for _, p in ipairs(server.Players or {}) do
				local id = tonumber(p.UserId)
				if id and not p.Hidden and not seen[id] then
					seen[id] = true
					table.insert(pool, { UserId = id, Name = tostring(p.Name) })
				end
			end
		end
		if #pool == 0 then
			sendFeedback(admin, "Nobody online to win.", true)
			return
		end
		local winners, names = {}, {}
		for _ = 1, math.min(count, #pool) do
			local pick = table.remove(pool, math.random(1, #pool))
			local key = if chosen then chosen.Key else Config.GamePasses[math.random(1, #Config.GamePasses)].Key
			table.insert(winners, { u = pick.UserId, p = key })
			table.insert(names, pick.Name)
		end
		local shown = table.concat(names, ", ", 1, math.min(#names, 3)) .. (if #names &gt; 3 then string.format(" and %d more", #names - 3) else "")
		local banner = string.format("Pass drop! %s won %s!", shown, if chosen then chosen.Name else "a game pass")
		local ok = publish({ Kind = "PassDrop", W = winners, Text = banner })
		sendFeedback(admin, string.format("%d winner(s): %s%s", #winners, shown, if ok then "" else " (this server only)"), false)
		logCommand(admin, "globalpassdrop", nil, if chosen then chosen.Name else "random", admin.Name .. " ran a pass drop: " .. shown)
	end

	----------------------------------------------------------------- event countdown
	-- :globalcountdown &lt;time&gt; [name]: a countdown banner on everyone's screen, in every server, and
	-- for anyone who joins later (it lives in a MemoryStore hash map, every server re-reads it each
	-- minute). At zero it turns into "&lt;NAME&gt; IS LIVE NOW!" for LIVE_MINUTES, then goes. :cancelcountdown
	-- removes it. Time: 90m, 24h, 2d (plain numbers are minutes), from 1 minute to 14 days.
	local LIVE_MINUTES = 60
	local countdown = nil -- { Name, EndsAt, LiveMinutes }
	local countdownMap = nil
	pcall(function()
		countdownMap = game:GetService("MemoryStoreService"):GetHashMap("RinseCycle_Countdown")
	end)
	local function sendCountdown(plr)
		if countdown and os.time() &lt; countdown.EndsAt + countdown.LiveMinutes * 60 then
			Remote.GlobalCountdown:FireClient(plr, "Set", countdown.Name, countdown.EndsAt, countdown.LiveMinutes)
		else
			Remote.GlobalCountdown:FireClient(plr, "Clear")
		end
	end
	handlers.CountdownSet = function(d)
		if type(d.Name) ~= "string" or type(d.EndsAt) ~= "number" then
			return
		end
		countdown = { Name = string.sub(d.Name, 1, 40), EndsAt = d.EndsAt, LiveMinutes = tonumber(d.LiveMinutes) or LIVE_MINUTES }
		for _, plr in ipairs(Players:GetPlayers()) do
			sendCountdown(plr)
		end
	end
	handlers.CountdownClear = function()
		countdown = nil
		for _, plr in ipairs(Players:GetPlayers()) do
			sendCountdown(plr)
		end
	end
	Players.PlayerAdded:Connect(function(plr)
		task.defer(sendCountdown, plr)
	end)
	-- Servers that started after the command (or missed the message) catch up from the store.
	local function syncCountdown()
		if not countdownMap then
			return
		end
		local ok, value = pcall(function()
			return countdownMap:GetAsync("current")
		end)
		if not ok then
			return
		end
		if type(value) == "table" and type(value.EndsAt) == "number" then
			if not countdown or countdown.EndsAt ~= value.EndsAt or countdown.Name ~= value.Name then
				handlers.CountdownSet(value)
			end
		elseif countdown then
			handlers.CountdownClear()
		end
	end
	task.spawn(function()
		while true do
			syncCountdown()
			task.wait(60)
		end
	end)
	Commands.globalcountdown = function(admin, text)
		local num, unit, rest = string.match(text, "^%s*(%d+%.?%d*)%s*([smhdSMHD]?)%s*(.*)$")
		local mult = ({ s = 1, m = 60, h = 3600, d = 86400 })[string.lower(unit or "")] or 60
		local seconds = (tonumber(num) or 0) * mult
		if seconds &lt; 60 or seconds &gt; 14 * 86400 then
			sendFeedback(admin, "Usage: :globalcountdown &lt;time 1m-14d, like 24h&gt; [event name]", true)
			return
		end
		local name = string.match(rest or "", "^%s*(.-)%s*$")
		if not name or name == "" then
			name = "Admin Abuse"
		end
		local okFilter, filtered = pcall(function()
			return TextService:FilterStringAsync(name, admin.UserId):GetNonChatStringForBroadcastAsync()
		end)
		if okFilter and type(filtered) == "string" then
			name = filtered
		end
		name = string.sub(name, 1, 40)
		local data = { Kind = "CountdownSet", Name = name, EndsAt = os.time() + math.floor(seconds), LiveMinutes = LIVE_MINUTES }
		if countdownMap then
			pcall(function()
				countdownMap:SetAsync("current", data, math.min(math.floor(seconds) + LIVE_MINUTES * 60 + 600, 3888000))
			end)
		end
		local ok = publish(data)
		sendFeedback(admin, string.format("Countdown for %s set (%s)%s", name, Format.Time and Format.Time(seconds) or tostring(math.floor(seconds / 60)) .. " min", if ok then " in every server" else " (this server only)"), false)
		logCommand(admin, "globalcountdown", nil, name, string.format("%s started a countdown for %s (%d min)", admin.Name, name, math.floor(seconds / 60)))
	end
	Commands.cancelcountdown = function(admin, _text)
		if countdownMap then
			pcall(function()
				countdownMap:RemoveAsync("current")
			end)
		end
		local ok = publish({ Kind = "CountdownClear" })
		sendFeedback(admin, "Event countdown cancelled" .. (if ok then " in every server" else " (this server only)"), false)
		logCommand(admin, "cancelcountdown", nil, "", admin.Name .. " cancelled the event countdown")
	end

	----------------------------------------------------------------- x2 boost
	-- :globalboost [minutes]: everyone online gets x2 cleaning for that long (on top of any boost).
	handlers.Boost = function(d)
		local minutes = math.floor(tonumber(d.Minutes) or 0)
		if minutes &lt;= 0 then
			return
		end
		for _, plr in ipairs(Players:GetPlayers()) do
			if DataService.AddBoost(plr, minutes * 60) then
				celebrate(plr, "Admin event!", string.format("x2 Cleaning for everyone: %d minutes!", minutes), "@Gift")
			end
		end
	end
	Commands.globalboost = function(admin, text)
		local minutes = math.clamp(math.floor(tonumber(text:match("^(%d+)")) or 0), 0, 180)
		if minutes &lt;= 0 then
			sendFeedback(admin, "Usage: :globalboost [minutes 1-180]", true)
			return
		end
		local ok = publish({ Kind = "Boost", Minutes = minutes })
		sendFeedback(admin, string.format("x2 Cleaning for everyone for %d minutes%s", minutes, if ok then " in every server" else " (this server only)"), false)
		logCommand(admin, "globalboost", nil, tostring(minutes), string.format("%s gave everyone %d min of x2 cleaning", admin.Name, minutes))
	end
	----------------------------------------------------------------- Admin Abuse show
	-- (Everything below lives in its own function, so its locals have their own budget of 200 registers.)
	;(function()
	-- Runs by itself in EVERY server from the event's Starts time (Config.UpcomingEvents, key
	-- AdminAbuse), so no one has to press anything: every server reads the same clock. Banners and the
	-- warning countdown, the lobby giant and the chat lines are per server; the votes and the prizes
	-- are done once for the whole game: a server "claims" a step in a MemoryStore hash map first, so
	-- only one server runs it, and the existing global poll / give / pass drop do the rest.
	-- :abuseshow [minutes] starts the whole thing that many minutes from now, to try it; ":abuseshow
	-- reset" puts the real time back.
	local Show = Config.AbuseShow
	local LobbyBuilder = require(GameServices:WaitForChild("LobbyBuilder"))
	local function abuseEvent(): any
		for _, e in Config.UpcomingEvents do
			if e.Key == Show.EventKey then
				return e
			end
		end
		return nil
	end
	local realStarts, realEnds = nil, nil
	do
		local e = abuseEvent()
		if e then
			realStarts, realEnds = e.Starts, e.Ends
		end
	end
	-- The schedule is also an attribute on ReplicatedStorage, so every client's countdown follows it
	-- (including a test start).
	local function publishSchedule()
		local e = abuseEvent()
		if e then
			ReplicatedStorage:SetAttribute("AbuseStarts", e.Starts)
			ReplicatedStorage:SetAttribute("AbuseEnds", e.Ends)
		end
	end
	publishSchedule()
	handlers.AbuseSchedule = function(d)
		local e = abuseEvent()
		if e and tonumber(d.Starts) and tonumber(d.Ends) then
			e.Starts, e.Ends = d.Starts, d.Ends
			publishSchedule()
		end
	end

	local STUB = { Name = Show.OwnerName .. " (event)", UserId = 0 } -- stands in for an admin in the commands
	local function say(text: string)
		for _, plr in ipairs(Players:GetPlayers()) do
			Remote.AbuseSay:FireClient(plr, Show.OwnerName, text)
		end
	end
	local claimMap = nil
	pcall(function()
		claimMap = game:GetService("MemoryStoreService"):GetHashMap("RinseCycle_AbuseSteps")
	end)
	-- True on exactly one server per step (and on this one when MemoryStore isn't there: Studio).
	local function claim(step: string): boolean
		if not claimMap then
			return true
		end
		local ok, result = pcall(function()
			return claimMap:UpdateAsync(step, function(old)
				if old ~= nil then
					return nil
				end
				return game.JobId
			end, 7200)
		end)
		return ok and result == game.JobId
	end
	local function everyoneOnline(): number
		local seen, n = {}, 0
		for _, server in ipairs(ServerList.Read()) do
			for _, p in ipairs(server.Players or {}) do
				local id = tonumber(p.UserId)
				if id and not p.Hidden and not seen[id] then
					seen[id] = true
					n += 1
				end
			end
		end
		return math.max(n, #Players:GetPlayers(), 1)
	end

	-- n random online players (every server, hidden staff left out).
	local function pickWinners(count: number): { number }
		local pool, seen = {}, {}
		for _, server in ipairs(ServerList.Read()) do
			for _, p in ipairs(server.Players or {}) do
				local id = tonumber(p.UserId)
				if id and not p.Hidden and not seen[id] then
					seen[id] = true
					table.insert(pool, id)
				end
			end
		end
		local out = {}
		for _ = 1, math.min(count, #pool) do
			table.insert(out, table.remove(pool, math.random(1, #pool)))
		end
		return out
	end
	handlers.PetDrop = function(d)
		if type(d.W) ~= "table" then
			return
		end
		local def = Config.Pets[Show.Pet]
		for _, id in ipairs(d.W) do
			local plr = Players:GetPlayerByUserId(tonumber(id) or 0)
			if plr and def then
				if PetService.GivePet(plr, Show.Pet) then
					celebrate(plr, "You won a limited pet!", "Admin Abuse: you got the limited " .. def.Name .. "!", "@Gift")
				else
					DataService.AddGems(plr, 150)
					celebrate(plr, "You won!", "Your pet bag is full, so here are 150 Gems instead of the " .. def.Name .. "!", "@Gift")
				end
			end
		end
		if type(d.Text) == "string" then
			bannerAll(d.Text)
		end
	end

	local heat = false -- set by the clock once he turns up the heat
	local chosenEffect = "meteors" -- what the chat voted for ("winner" in the Script)
	local playEffect: (string) -&gt; () = function() end -- set once the effects exist

	-- Gives the prize (an option from Config.AbuseOption) to everyone / the winners, in every server.
	local function applyOutcome(option: any)
		if option.Kind == "Bubbles" or option.Kind == "Gems" then
			publish({ Kind = "GiveAll", Currency = option.Kind, Amount = option.PerPlayer })
			publish({ Kind = "Banner", Text = string.format("Admin Abuse: everyone gets %s %s!", Format.Commas(option.PerPlayer), option.Kind) })
		elseif option.Kind == "Passes" then
			Commands.globalpassdrop(STUB, tostring(option.Count) .. " random")
		elseif option.Kind == "Pet" then
			local winners = pickWinners(option.Count)
			publish({ Kind = "PetDrop", W = winners, Text = string.format("Admin Abuse: %d player%s won the limited %s pet!", #winners, if #winners == 1 then "" else "s", Config.Pets[Show.Pet].Name) })
		elseif option.Kind == "Effect" then
			publish({ Kind = "AbuseEffect", Name = option.Effect, Winner = true })
		end
	end
	-- One round. A poll goes to every server (the existing global poll, "silent": its card closes the
	-- second the vote ends), the counts come back here, and the winner is applied. An announced round
	-- just happens. The winner is the most votes (the first on a tie; nobody voted = the first).
	local function runRound(round: any)
		local n = everyoneOnline()
		local function fill(text: string, option: any): string
			local out = string.gsub(text, "{players}", string.format("%d lucky player%s", option.Count, if option.Count == 1 then "" else "s"))
			out = string.gsub(out, "{n}", tostring(option.Count))
			out = string.gsub(out, "{pet}", Config.Pets[Show.Pet].Name)
			out = string.gsub(out, "{text}", option.Text)
			return out
		end
		if round.Kind == "Announce" then
			local option = Config.AbuseOption(round.Option, n)
			publish({ Kind = "AbuseSay", Text = fill(round.Intro, option) })
			task.delay(8, function()
				applyOutcome(option)
				task.delay(5, function()
					publish({ Kind = "AbuseSay", Text = round.Done })
				end)
			end)
			return
		end
		local options, picked = {}, {}
		for _, o in round.Options do
			local option = Config.AbuseOption(o, n)
			table.insert(picked, option)
			table.insert(options, option.Text)
		end
		local id = game.JobId .. ":abuse:" .. tostring(os.clock())
		local counts = {}
		for i = 1, #options do
			counts[i] = 0
		end
		collecting[id] = { Counts = counts, Question = round.Question, Options = options }
		publish({ Kind = "PollStart", Id = id, Silent = true, Question = round.Question, Options = options, EndsAt = Config.Now() + round.Seconds, Origin = game.JobId })
		task.delay(round.Seconds + 7, function()
			local c = collecting[id]
			collecting[id] = nil
			if not c then
				return
			end
			local best, bestVotes = 1, -1
			for i, count in ipairs(c.Counts) do
				if count &gt; bestVotes then
					best, bestVotes = i, count
				end
			end
			local winner = picked[best]
			publish({ Kind = "AbuseSay", Text = fill(round.Chosen, winner) })
			task.delay(3, applyOutcome, winner)
		end)
	end
	handlers.AbuseSay = function(d)
		if type(d.Text) == "string" then
			say(string.sub(d.Text, 1, 200))
		end
	end
	handlers.AbuseEffect = function(d)
		if type(d.Name) == "string" then
			if d.Winner then
				chosenEffect = d.Name
			end
			playEffect(d.Name)
		end
	end

	----------------------------------------------------------------- the giant and his toys
	-- The giant: the owner's real avatar (hair and clothes from their HumanoidDescription), scaled up,
	-- walking a circle round the lobby room with Roblox's default R15 animations (only the root part is
	-- anchored, so the animations really move his limbs). The root's height is locked to his lowest
	-- foot sole every frame, so he never sinks into or hovers over the floor, and every footfall
	-- booms. Between stops he does what the show's Script says (effects below; all harmless).
	local Debris = game:GetService("Debris")
	local KeyframeSequenceProvider = game:GetService("KeyframeSequenceProvider")
	local giantDebug = false
	local Lighting = game:GetService("Lighting")
	local ROOM_FLOOR = -130 -- LobbyBuilder's room floor
	local ROOF_Y = 330 -- LobbyBuilder's ceiling
	local TABLE_CENTER = Vector3.new(0, ROOM_FLOOR, -18)
	local giant: Model? = nil
	local giantConn: RBXScriptConnection? = nil
	local giantHead: BasePart? = nil
	local giantLeave: (() -&gt; ())? = nil
	local leaving = false -- set once he starts the exit: nothing respawns him afterwards
	local giantRescale: ((number, number) -&gt; ())? = nil
	local boom: (number, Vector3) -&gt; () = function() end
	local function removeGiant()
		if giantConn then
			giantConn:Disconnect()
			giantConn = nil
		end
		if giant then
			giant:Destroy()
			giant = nil
		end
		for _, c in workspace:GetChildren() do
			if c.Name == "AbuseGiant" then
				c:Destroy()
			end
		end
		giantHead, giantLeave, giantRescale = nil, nil, nil
	end
	local function ringAt(pos: Vector3, size: number, seconds: number, color: Color3)
		local ring = Instance.new("Part")
		ring.Shape = Enum.PartType.Cylinder
		ring.Size = Vector3.new(1, 10, 10)
		ring.CFrame = CFrame.new(pos.X, pos.Y + 1, pos.Z) * CFrame.Angles(0, 0, math.pi / 2)
		ring.Anchored = true
		ring.CanCollide = false
		ring.CanTouch = false
		ring.CanQuery = false
		ring.CastShadow = false
		ring.Material = Enum.Material.Neon
		ring.Color = color
		ring.Transparency = 0.2
		ring.Parent = workspace
		TweenService:Create(ring, TweenInfo.new(seconds, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = Vector3.new(1, size, size), Transparency = 1 }):Play()
		Debris:AddItem(ring, seconds + 0.2)
	end
	local function dustAt(pos: Vector3)
		local anchor = Instance.new("Part")
		anchor.Transparency = 1
		anchor.Anchored = true
		anchor.CanCollide = false
		anchor.CanTouch = false
		anchor.CanQuery = false
		anchor.Size = Vector3.new(4, 1, 4)
		anchor.Position = pos + Vector3.new(0, 4, 0)
		local dust = Instance.new("ParticleEmitter")
		dust.Texture = "rbxasset://textures/particles/smoke_main.dds"
		dust.Color = ColorSequence.new(Color3.fromRGB(200, 190, 175))
		dust.Lifetime = NumberRange.new(1.2, 2)
		dust.Speed = NumberRange.new(40, 90)
		dust.SpreadAngle = Vector2.new(180, 20)
		dust.Size = NumberSequence.new(25, 70)
		dust.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 1) })
		dust.Rate = 0
		dust.EmissionDirection = Enum.NormalId.Top
		dust.Parent = anchor
		anchor.Parent = workspace
		dust:Emit(28)
		Debris:AddItem(anchor, 3)
	end
	boom = function(strength: number, pos: Vector3)
		ringAt(pos, 120 + 160 * strength, 0.8, if heat then Color3.fromRGB(255, 90, 60) else Color3.fromRGB(255, 205, 110))
		dustAt(pos)
		Remote.AbuseBoom:FireAllClients(strength, pos)
	end
	local function plazaSpot(): Vector3
		return Vector3.new(math.random(-80, 80), 0.2, math.random(-90, 55))
	end
	-- A burst of light (no Explosion object at all: those can hurt Humanoids, and this show never should).
	local function harmlessBlast(pos: Vector3, radius: number)
		local flash = Instance.new("Part")
		flash.Shape = Enum.PartType.Ball
		flash.Anchored = true
		flash.CanCollide = false
		flash.CanTouch = false
		flash.CanQuery = false
		flash.CastShadow = false
		flash.Material = Enum.Material.Neon
		flash.Color = Color3.fromRGB(255, 170, 80)
		flash.Size = Vector3.new(2, 2, 2)
		flash.Position = pos
		flash.Parent = workspace
		TweenService:Create(flash, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = Vector3.new(radius * 2.2, radius * 2.2, radius * 2.2), Transparency = 1 }):Play()
		Debris:AddItem(flash, 0.6)
	end
	local function neonPart(size: Vector3, color: Color3, shape: Enum.PartType?): Part
		local part = Instance.new("Part")
		part.Anchored = true
		part.CanCollide = false
		part.CanTouch = false
		part.CanQuery = false
		part.CastShadow = false
		part.Material = Enum.Material.Neon
		part.Color = color
		part.Size = size
		if shape then
			part.Shape = shape
		end
		return part
	end
	local function upright(part: BasePart, pos: Vector3)
		part.CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.pi / 2)
	end
	local PALETTE = {
		Color3.fromRGB(255, 90, 90),
		Color3.fromRGB(255, 190, 60),
		Color3.fromRGB(110, 255, 150),
		Color3.fromRGB(90, 190, 255),
		Color3.fromRGB(200, 120, 255),
		Color3.fromRGB(255, 120, 200),
	}
	-- Floating admin command above his head (typed out, then it floats up and fades).
	local FAKE_COMMANDS = { ":give all everything", ":global speed 999", ":kill dishes", ":fly all", ":globalgive * 999999", ":smite table", ":size me 99", ":unban fun", ":setadminrank me 99", ":clean all", ":spawn meteor", ":gravity 0", ":rain gems", ":time 0" }
	local commandIndex = 0
	local function commandText(text: string?)
		local head = giantHead
		if not head then
			return
		end
		commandIndex += 1
		local tag = Instance.new("BillboardGui")
		tag.Size = UDim2.fromOffset(520, 60)
		tag.StudsOffsetWorldSpace = Vector3.new(0, head.Size.Y * 2.4, 0)
		tag.AlwaysOnTop = true
		tag.MaxDistance = 6000
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.Code
		label.TextScaled = true
		label.TextColor3 = Color3.fromRGB(255, 80, 70)
		label.TextStrokeTransparency = 0
		label.Text = text or FAKE_COMMANDS[(commandIndex - 1) % #FAKE_COMMANDS + 1]
		label.Parent = tag
		tag.Parent = head
		TweenService:Create(tag, TweenInfo.new(2.4), { StudsOffsetWorldSpace = Vector3.new(0, head.Size.Y * 4, 0) }):Play()
		TweenService:Create(label, TweenInfo.new(2.4), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
		Debris:AddItem(tag, 2.6)
	end

	-- The effects. Each is one thing he does to the plaza; the clock's Script says which and when.
	local FX = (function()
		local fx: { [string]: () -&gt; () } = {}
		local function headPoint(): Vector3
			return if giantHead then giantHead.Position else Vector3.new(0, 140, 280)
		end
		fx.beam = function()
			local from = headPoint()
			for i = 1, if heat then 3 else 1 do
				task.delay((i - 1) * 0.5, function()
					local target = plazaSpot()
					local len = (target - from).Magnitude
					local beam = neonPart(Vector3.new(8, 8, len), Color3.fromRGB(255, 120, 60))
					beam.CFrame = CFrame.lookAt(from, target) * CFrame.new(0, 0, -len / 2)
					beam.Parent = workspace
					TweenService:Create(beam, TweenInfo.new(1.4), { Transparency = 1, Size = Vector3.new(2, 2, len) }):Play()
					Debris:AddItem(beam, 1.6)
					harmlessBlast(target, 14)
					boom(2, target)
				end)
			end
		end
		fx.meteors = function()
			for i = 1, if heat then 12 else 7 do
				task.delay(i * 0.3, function()
					local target = plazaSpot()
					local rock = neonPart(Vector3.new(18, 18, 18), Color3.fromRGB(255, 140, 50), Enum.PartType.Ball)
					rock.Position = target + Vector3.new(math.random(-140, 140), 280, math.random(-140, 140))
					rock.Parent = workspace
					local fall = TweenService:Create(rock, TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Position = target + Vector3.new(0, 8, 0) })
					fall.Completed:Connect(function()
						rock:Destroy()
						harmlessBlast(target, 12)
						boom(1.6, target)
					end)
					fall:Play()
				end)
			end
		end
		fx.lightning = function()
			for i = 1, if heat then 8 else 4 do
				task.delay(i * 0.28, function()
					local target = plazaSpot()
					local from = target + Vector3.new(math.random(-40, 40), 340, math.random(-40, 40))
					local previous = from
					for step = 1, 5 do
						local nextPoint = from:Lerp(target, step / 5) + (if step &lt; 5 then Vector3.new(math.random(-25, 25), 0, math.random(-25, 25)) else Vector3.zero)
						local len = (nextPoint - previous).Magnitude
						local bolt = neonPart(Vector3.new(3, 3, len), Color3.fromRGB(190, 220, 255))
						bolt.CFrame = CFrame.lookAt(previous, nextPoint) * CFrame.new(0, 0, -len / 2)
						bolt.Parent = workspace
						TweenService:Create(bolt, TweenInfo.new(0.5), { Transparency = 1 }):Play()
						Debris:AddItem(bolt, 0.6)
						previous = nextPoint
					end
					harmlessBlast(target, 10)
					boom(1.4, target)
				end)
			end
		end
		fx.shockwave = function()
			local feet = if giantHead then Vector3.new(giantHead.Position.X, ROOM_FLOOR, giantHead.Position.Z) else TABLE_CENTER
			for i = 0, 2 do
				task.delay(i * 0.25, function()
					ringAt(feet, 1400 + i * 400, 1.6, Color3.fromRGB(255, 80 + i * 50, 60))
				end)
			end
			boom(3, feet)
		end
		fx.barrage = function()
			for i = 1, if heat then 10 else 6 do
				task.delay(i * 0.28, function()
					boom(1.8, plazaSpot())
				end)
			end
		end
		fx.fireworks = function()
			-- Minecraft style: a rocket (red, gold, blue...) streaks up from the table or the obby with a
			-- spark trail, bursts big, then crackles in a few more booms. Everything is particle bursts,
			-- so it stays smooth, and big enough to see from the obby.
			local SHELLS = {
				{ Color3.fromRGB(255, 70, 60), Color3.fromRGB(255, 200, 90) },
				{ Color3.fromRGB(80, 170, 255), Color3.fromRGB(255, 255, 255) },
				{ Color3.fromRGB(90, 255, 140), Color3.fromRGB(255, 255, 160) },
				{ Color3.fromRGB(200, 110, 255), Color3.fromRGB(255, 150, 220) },
				{ Color3.fromRGB(255, 190, 60), Color3.fromRGB(255, 90, 50) },
			}
			local function burst(at: Vector3, colors: { Color3 }, count: number, speed: number, size: number, life: number)
				local anchor = Instance.new("Part")
				anchor.Transparency = 1
				anchor.Anchored = true
				anchor.CanCollide = false
				anchor.CanTouch = false
				anchor.CanQuery = false
				anchor.Size = Vector3.new(1, 1, 1)
				anchor.Position = at
				local e = Instance.new("ParticleEmitter")
				e.Texture = "rbxasset://textures/particles/sparkles_main.dds"
				e.Color = ColorSequence.new(colors[1], colors[2])
				e.Lifetime = NumberRange.new(life * 0.7, life)
				e.Speed = NumberRange.new(speed * 0.55, speed)
				e.SpreadAngle = Vector2.new(180, 180)
				e.Acceleration = Vector3.new(0, -26, 0)
				e.Drag = 1.6
				e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size), NumberSequenceKeypoint.new(0.7, size * 0.7), NumberSequenceKeypoint.new(1, 0) })
				e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.8, 0.2), NumberSequenceKeypoint.new(1, 1) })
				e.LightEmission = 1
				e.Rate = 0
				e.Parent = anchor
				anchor.Parent = workspace
				e:Emit(count)
				-- the flash at the middle
				local core = neonPart(Vector3.new(6, 6, 6), Color3.new(1, 1, 1), Enum.PartType.Ball)
				core.Position = at
				core.Parent = workspace
				TweenService:Create(core, TweenInfo.new(0.45), { Size = Vector3.new(size * 9, size * 9, size * 9), Transparency = 1 }):Play()
				Debris:AddItem(core, 0.5)
				Debris:AddItem(anchor, life + 0.6)
			end
			local count = 70 -- about 28 seconds of them
			for i = 1, count do
				task.delay((i - 1) * 0.4, function()
					local base = if i % 2 == 1 then plazaSpot() else Vector3.new(math.random(-20, 320), 2, math.random(90, 340))
					local shell = SHELLS[(i - 1) % #SHELLS + 1]
					-- the rocket: a bright head with a long spark tail
					local rocket = neonPart(Vector3.new(3, 3, 3), Color3.new(1, 0.9, 0.7), Enum.PartType.Ball)
					rocket.Position = base
					rocket.Parent = workspace
					local trail = Instance.new("ParticleEmitter")
					trail.Texture = "rbxasset://textures/particles/sparkles_main.dds"
					trail.Color = ColorSequence.new(shell[2], shell[1])
					trail.Lifetime = NumberRange.new(0.7, 1.2)
					trail.Speed = NumberRange.new(2, 8)
					trail.SpreadAngle = Vector2.new(25, 25)
					trail.Rate = 140
					trail.Size = NumberSequence.new(4, 0)
					trail.LightEmission = 1
					trail.Parent = rocket
					Remote.AbuseBoom:FireAllClients(0.3, base) -- the launch: shoom
					local height = math.random(60, 340) -- all heights, low pops to high shells
					local top = base + Vector3.new(math.random(-40, 40), height, math.random(-40, 40))
					local rise = TweenService:Create(rocket, TweenInfo.new(0.5 + height / 260, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = top })
					rise.Completed:Connect(function()
						rocket:Destroy()
						burst(top, shell, 120, 40 + height * 0.35, 12 + height * 0.01, 2.2)
						Remote.AbuseBoom:FireAllClients(1.1, top) -- boom
						-- boom, boom, boom: it crackles
						for k = 1, 3 do
							task.delay(0.45 + k * 0.28, function()
								local p = top + Vector3.new(math.random(-80, 80), math.random(-60, 30), math.random(-80, 80))
								burst(p, { shell[2], shell[1] }, 36, 60, 8, 1.5)
								Remote.AbuseBoom:FireAllClients(0.6, p)
							end)
						end
					end)
					rise:Play()
				end)
			end
		end
		fx.laser = function()
			local from = headPoint()
			local z = math.random(-60, 20)
			local a = math.random() &lt; 0.5
			task.spawn(function()
				local t0 = os.clock()
				local lastBlast = 0
				local beams = {}
				for i = 1, 2 do
					local b = neonPart(Vector3.new(5, 5, 10), if i == 1 then Color3.fromRGB(255, 70, 90) else Color3.fromRGB(90, 200, 255))
					b.Parent = workspace
					beams[i] = b
				end
				while os.clock() - t0 &lt; 4.5 do
					local f = (os.clock() - t0) / 4.5
					for i, b in beams do
						local x = (if (i == 1) == a then -1 else 1) * (90 - 180 * f)
						local target = Vector3.new(x, 0.5, z + (if i == 1 then -22 else 22))
						local len = (target - from).Magnitude
						b.Size = Vector3.new(5, 5, len)
						b.CFrame = CFrame.lookAt(from, target) * CFrame.new(0, 0, -len / 2)
						if os.clock() - lastBlast &gt; 0.35 then
							lastBlast = os.clock()
							boom(0.9, target)
						end
					end
					RunService.Heartbeat:Wait()
				end
				for _, b in beams do
					b:Destroy()
				end
			end)
		end
		fx.blackhole = function()
			local center = Vector3.new(math.random(-30, 30), 95, math.random(-50, 10))
			local core = neonPart(Vector3.new(2, 2, 2), Color3.fromRGB(5, 0, 12), Enum.PartType.Ball)
			core.Material = Enum.Material.SmoothPlastic
			core.Position = center
			core.Parent = workspace
			TweenService:Create(core, TweenInfo.new(1.2, Enum.EasingStyle.Back), { Size = Vector3.new(34, 34, 34) }):Play()
			local rings = {}
			for i = 1, 3 do
				local ring = neonPart(Vector3.new(1, 60 + i * 24, 60 + i * 24), Color3.fromRGB(150 + i * 30, 70, 255), Enum.PartType.Cylinder)
				ring.Transparency = 0.45
				ring.Parent = workspace
				rings[i] = ring
			end
			local debris = {}
			for i = 1, 16 do
				local d = neonPart(Vector3.new(4, 4, 4), PALETTE[i % #PALETTE + 1])
				d.Parent = workspace
				debris[i] = d
			end
			task.spawn(function()
				local t0 = os.clock()
				local length = if heat then 8 else 6
				while os.clock() - t0 &lt; length do
					local t = os.clock() - t0
					for i, ring in rings do
						ring.CFrame = CFrame.new(center) * CFrame.Angles(t * (0.8 + i * 0.4), t * 0.6 * i, math.pi / 2)
					end
					for i, d in debris do
						local r = 70 - (t / length) * 40 + (i % 4) * 8
						local a = t * (1.6 + (i % 3) * 0.5) + i
						d.CFrame = CFrame.new(center + Vector3.new(math.cos(a) * r, math.sin(a * 0.7) * 20, math.sin(a) * r)) * CFrame.Angles(a, a, 0)
					end
					RunService.Heartbeat:Wait()
				end
				for _, d in debris do
					d:Destroy()
				end
				for _, ring in rings do
					ring:Destroy()
				end
				TweenService:Create(core, TweenInfo.new(0.4), { Size = Vector3.new(2, 2, 2) }):Play()
				task.wait(0.4)
				core:Destroy()
				boom(3, Vector3.new(center.X, 0.2, center.Z))
				harmlessBlast(center, 20)
			end)
		end
		fx.tornado = function()
			local discs = {}
			for i = 1, 9 do
				local disc = neonPart(Vector3.new(6, 12 + i * 4, 12 + i * 4), Color3.fromRGB(190, 200, 215), Enum.PartType.Cylinder)
				disc.Material = Enum.Material.SmoothPlastic
				disc.Transparency = 0.35
				disc.Parent = workspace
				discs[i] = disc
			end
			task.spawn(function()
				local t0 = os.clock()
				local length = if heat then 9 else 7
				while os.clock() - t0 &lt; length do
					local t = os.clock() - t0
					local cx = math.sin(t * 0.9) * 70
					local cz = -20 + math.cos(t * 0.6) * 50
					for i, disc in discs do
						local wob = math.sin(t * 3 + i) * 3
						disc.CFrame = CFrame.new(cx + wob, i * 11, cz + wob) * CFrame.Angles(0, t * (3 + i * 0.2), math.pi / 2)
					end
					if math.floor(t * 2) ~= math.floor((t - 0.03) * 2) then
						Remote.AbuseBoom:FireAllClients(0.6, Vector3.new(cx, 0.2, cz))
					end
					RunService.Heartbeat:Wait()
				end
				for _, disc in discs do
					TweenService:Create(disc, TweenInfo.new(0.5), { Transparency = 1 }):Play()
					Debris:AddItem(disc, 0.6)
				end
			end)
		end
		fx.ufo = function()
			local ship = Instance.new("Model")
			local body = neonPart(Vector3.new(6, 46, 46), Color3.fromRGB(170, 180, 200), Enum.PartType.Cylinder)
			body.Material = Enum.Material.Metal
			upright(body, Vector3.new(0, 0, 0))
			local dome = neonPart(Vector3.new(22, 22, 22), Color3.fromRGB(120, 255, 200), Enum.PartType.Ball)
			dome.Transparency = 0.3
			local beamPart = neonPart(Vector3.new(120, 26, 26), Color3.fromRGB(150, 255, 190), Enum.PartType.Cylinder)
			beamPart.Transparency = 0.6
			body.Parent, dome.Parent, beamPart.Parent = ship, ship, ship
			ship.Parent = workspace
			local start = Vector3.new(-170, 130, math.random(-60, 10))
			local finish = Vector3.new(170, 130, math.random(-60, 10))
			task.spawn(function()
				local t0 = os.clock()
				local length = 7
				while os.clock() - t0 &lt; length do
					local f = (os.clock() - t0) / length
					local p = start:Lerp(finish, f) + Vector3.new(0, math.sin(f * 14) * 4, 0)
					upright(body, p)
					dome.Position = p + Vector3.new(0, 8, 0)
					beamPart.CFrame = CFrame.new(p - Vector3.new(0, 60, 0)) * CFrame.Angles(0, 0, math.pi / 2)
					beamPart.Transparency = 0.55 + math.sin(os.clock() * 12) * 0.12
					if math.floor(f * 12) ~= math.floor((f - 0.012) * 12) then
						boom(0.8, Vector3.new(p.X, 0.2, p.Z))
					end
					RunService.Heartbeat:Wait()
				end
				ship:Destroy()
			end)
		end
		-- Two lasers out of his eyes that sweep the table and leave a glowing trail on it.
		local eyesBusy = false
		fx.eyes = function()
			if eyesBusy or not giantHead then
				return
			end
			eyesBusy = true
			local headPart = giantHead :: BasePart
			local DURATION = if heat then 4.5 else 5.5
			local beams = {
				neonPart(Vector3.new(4, 4, 10), Color3.fromRGB(255, 60, 60)),
				neonPart(Vector3.new(4, 4, 10), Color3.fromRGB(255, 60, 60)),
			}
			local sparks = {}
			for i, b in beams do
				b.Parent = workspace
				local anchor = Instance.new("Part")
				anchor.Transparency = 1
				anchor.Anchored = true
				anchor.CanCollide = false
				anchor.CanQuery = false
				anchor.Size = Vector3.one
				local e = Instance.new("ParticleEmitter")
				e.Texture = "rbxasset://textures/particles/sparkles_main.dds"
				e.Color = ColorSequence.new(Color3.fromRGB(255, 240, 140), Color3.fromRGB(255, 80, 40))
				e.Lifetime = NumberRange.new(0.5, 1)
				e.Speed = NumberRange.new(10, 30)
				e.SpreadAngle = Vector2.new(70, 70)
				e.Rate = 60
				e.Size = NumberSequence.new(3, 0)
				e.LightEmission = 1
				e.Parent = anchor
				anchor.Parent = workspace
				sparks[i] = anchor
			end
			local t0 = os.clock()
			local lastDot = 0
			local conn: RBXScriptConnection? = nil
			local function finish()
				if conn then
					conn:Disconnect()
				end
				for _, b in beams do
					b:Destroy()
				end
				for _, a in sparks do
					Debris:AddItem(a, 1)
					local e = a:FindFirstChildOfClass("ParticleEmitter")
					if e then
						e.Enabled = false
					end
				end
				eyesBusy = false
			end
			conn = RunService.Heartbeat:Connect(function()
				local t = os.clock() - t0
				if t &gt; DURATION or not headPart.Parent then
					finish()
					return
				end
				local fade = math.max(0.05, math.min(1, t / 0.3, (DURATION - t) / 0.4))
				local dotNow = os.clock() - lastDot &gt; 0.06
				for i, b in beams do
					-- the eyes: either side of his face, at the front
					local from = (headPart.CFrame * CFrame.new((if i == 1 then -0.22 else 0.22) * headPart.Size.X, 0.08 * headPart.Size.Y, -0.5 * headPart.Size.Z)).Position
					-- each eye draws a sweeping curve over the table (opposite ways round)
					local a = t * 1.5 * (if i == 1 then 1 else -1) + (if i == 1 then 0 else math.pi)
					local r = 35 + 25 * math.sin(t * 2.2 + i)
					local target = Vector3.new(math.cos(a) * r, 0.5, 15 + math.sin(a) * r * 1.1)
					local len = (target - from).Magnitude
					b.Size = Vector3.new(4 * fade, 4 * fade, len)
					b.CFrame = CFrame.lookAt(from, target) * CFrame.new(0, 0, -len / 2)
					sparks[i].Position = target + Vector3.new(0, 1, 0)
					if dotNow then
						local dot = neonPart(Vector3.new(0.3, 4, 4), Color3.fromRGB(255, 150, 50), Enum.PartType.Cylinder)
						dot.CFrame = CFrame.new(target.X, 0.35, target.Z) * CFrame.Angles(0, 0, math.rad(90))
						dot.Parent = workspace
						TweenService:Create(dot, TweenInfo.new(2.5), { Transparency = 1, Color = Color3.fromRGB(120, 30, 20) }):Play()
						Debris:AddItem(dot, 2.6)
					end
				end
				if dotNow then
					lastDot = os.clock()
				end
			end)
			Remote.AbuseBoom:FireAllClients(1.4, Vector3.new(0, 0, 15))
		end
		local discoBusy = false
		fx.disco = function()
			if discoBusy then
				return
			end
			discoBusy = true
			local original = { Lighting.ColorShift_Top, Lighting.OutdoorAmbient }
			task.spawn(function()
				for i = 1, 16 do
					local c = Color3.fromHSV((i / 16 * 2) % 1, 0.8, 1)
					Lighting.ColorShift_Top = c
					Lighting.OutdoorAmbient = c:Lerp(Color3.new(1, 1, 1), 0.4)
					if i % 2 == 0 then
						Remote.AbuseBoom:FireAllClients(0.7, Vector3.new(0, 0, 0))
					end
					task.wait(0.4)
				end
				Lighting.ColorShift_Top = original[1]
				Lighting.OutdoorAmbient = original[2]
				discoBusy = false
			end)
		end
		fx.fountains = function()
			for i = 1, if heat then 8 else 5 do
				task.delay(i * 0.25, function()
					local spot = plazaSpot()
					local jet = neonPart(Vector3.new(2, 8, 8), PALETTE[i % #PALETTE + 1], Enum.PartType.Cylinder)
					jet.Transparency = 0.25
					upright(jet, spot + Vector3.new(0, 1, 0))
					jet.Parent = workspace
					TweenService:Create(jet, TweenInfo.new(1.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = Vector3.new(120, 12, 12), Transparency = 1 }):Play()
					local lift = Instance.new("NumberValue")
					lift.Value = 1
					TweenService:Create(lift, TweenInfo.new(1.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Value = 120 }):Play()
					lift.Changed:Connect(function(h)
						upright(jet, spot + Vector3.new(0, h / 2, 0))
					end)
					Debris:AddItem(jet, 1.8)
					Debris:AddItem(lift, 1.8)
					boom(1.2, spot)
				end)
			end
		end
		return fx
	end)()
	playEffect = function(name: string)
		if name == "winner" then
			name = chosenEffect
		end
		local effect = FX[name]
		if effect and giant then
			commandText(nil)
			effect()
			if name == "meteors" or name == "blackhole" or name == "tornado" then
				Remote.AbuseBoom:FireAllClients(2.5, Vector3.new(0, 0, 0))
			end
		end
	end

	-- Holes in the table (LobbyBuilder cuts and repairs the table itself).
	local function openHole(index: number)
		local def = Show.Holes[index]
		if not def then
			return
		end
		local pos = Vector3.new(def[1], 0.2, def[2])
		LobbyBuilder.OpenHole(index)
		boom(3, pos)
		for i = 1, 3 do
			task.delay(i * 0.3, function()
				harmlessBlast(pos + Vector3.new(math.random(-12, 12), 0, math.random(-12, 12)), 18)
				ringAt(pos, 200 + i * 160, 1.2, Color3.fromRGB(255, 150, 60))
				Remote.AbuseBoom:FireAllClients(2.4, pos)
			end)
		end
	end
	local function closeHoles()
		LobbyBuilder.HealHoles(10)
	end

	local spawning, spawnFailures, nextSpawnTry = false, 0, 0
	local spawnGiantNow: () -&gt; ()
	-- Builds him once at a time, and gives up after three failures (each 20 s apart).
	local function spawnGiant()
		if giant or spawning or spawnFailures &gt;= 3 or os.clock() &lt; nextSpawnTry then
			return
		end
		spawning = true
		spawnGiantNow()
		spawning = false
	end
	-- The lowest point of a part (its rotated box), so a foot's sole is found whatever the pose.
	local function lowestPoint(part: BasePart?): number
		if not part then
			return math.huge
		end
		local cf, size = part.CFrame, part.Size
		local reach = (math.abs(cf.RightVector.Y) * size.X + math.abs(cf.UpVector.Y) * size.Y + math.abs(cf.LookVector.Y) * size.Z) / 2
		return cf.Position.Y - reach
	end
	local function softenParts(model: Model)
		for _, part in model:GetDescendants() do
			if part:IsA("BasePart") then
				part.CanCollide = false
				part.CanTouch = false
				part.CanQuery = false
				part.Massless = true
			end
		end
	end
	spawnGiantNow = function()
		local ok, model, desc = pcall(function()
			local d = Players:GetHumanoidDescriptionFromUserId(Show.OwnerUserId)
			return Players:CreateHumanoidModelFromDescription(d, Enum.HumanoidRigType.R15), d
		end)
		if not ok or not model then
			spawnFailures += 1
			nextSpawnTry = os.clock() + 20
			warn("[AdminServer] couldn't build the Admin Abuse giant: " .. tostring(model))
			return
		end
		model.Name = "AbuseGiant"
		local root = model:FindFirstChild("HumanoidRootPart") :: BasePart?
		local humanoid = model:FindFirstChildOfClass("Humanoid")
		if not root or not humanoid then
			model:Destroy()
			return
		end
		root.Anchored = true
		model.PrimaryPart = root
		model:PivotTo(CFrame.new(0, ROOM_FLOOR + 6000, 0)) -- built far away, out of sight, until it appears with a bang
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		-- No state machine: it moves the hips up and down (the "sinking into the floor"), but the
		-- Humanoid stays so the clothes and hair (layered or not) render and animate.
		pcall(function()
			humanoid.EvaluateStateMachine = false
		end)
		-- Nothing can kill or break him: no death, no joints breaking, a (hidden) force field.
		humanoid.BreakJointsOnDeath = false
		pcall(function()
			humanoid.MaxHealth = 1e9
			humanoid.Health = 1e9
			humanoid:ChangeState(Enum.HumanoidStateType.Physics)
		end)
		local shield = Instance.new("ForceField")
		shield.Visible = false
		shield.Parent = model
		model.Parent = workspace
		-- Applying the description once the model is in the world makes sure the hair and clothes load.
		pcall(function()
			humanoid:ApplyDescription(desc)
		end)
		model.DescendantAdded:Connect(function(d)
			if d:IsA("BasePart") then
				d.CanCollide = false
				d.CanTouch = false
				d.CanQuery = false
				d.Massless = true
			end
		end)
		softenParts(model)
		if giant then
			model:Destroy() -- (another build finished first: never two giants)
			return
		end
		local baseScale = if heat then Show.HeatScale else Show.GiantScale
		pcall(function()
			model:ScaleTo(baseScale)
		end)
		task.wait(0.3)
		softenParts(model)
		if giant then
			model:Destroy()
			return
		end
		giant = model
		local scaleNow = baseScale

		-- Animations (Roblox's default R15 walk and idle). The emotes (wave, point, cheer) are NOT used: they
		-- move the hips, which on a giant is tens of studs (that was the "teleporting into the floor").
		local animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator", humanoid)
		local function load(id: string, priority: Enum.AnimationPriority, looped: boolean): AnimationTrack?
			local track: AnimationTrack? = nil
			pcall(function()
				local anim = Instance.new("Animation")
				anim.AnimationId = "rbxassetid://" .. id
				track = animator:LoadAnimation(anim)
				if track then
					track.Priority = priority
					track.Looped = looped
				end
			end)
			return track
		end
		local walkTrack = load("507777826", Enum.AnimationPriority.Movement, true)
		local idleTrack = load("507766388", Enum.AnimationPriority.Idle, true)
		-- The idle animation puts the feet ~2x further below the hips than the walk does (his logs: feet 113
		-- studs under the floor each time he stopped), so he never uses it: standing still is the walk cycle
		-- frozen (speed 0), which is known to stand on the floor.
		if walkTrack then
			walkTrack:Play(0)
			walkTrack:AdjustSpeed(0)
		elseif idleTrack then
			idleTrack:Play()
		end
		task.wait(0.8) -- (still far away and out of sight) let the pose settle before measuring it

		local footL = model:FindFirstChild("LeftFoot") :: BasePart?
		local footR = model:FindFirstChild("RightFoot") :: BasePart?
		local low = math.min(lowestPoint(footL), lowestPoint(footR))
		local rootAbove = if low == math.huge then humanoid.HipHeight + root.Size.Y / 2 else root.Position.Y - low
		-- (a sane range: the hips' own height is the other way to know it)
		local hipAbove = humanoid.HipHeight + root.Size.Y / 2
		if hipAbove &gt; 0 and (rootAbove &lt; hipAbove * 0.6 or rootAbove &gt; hipAbove * 1.6) then
			rootAbove = hipAbove
		end
		local rootAboveBase = rootAbove / baseScale
		local rootY = ROOM_FLOOR + rootAbove

		-- Name tag.
		local head = model:FindFirstChild("Head") :: BasePart?
		giantHead = head
		if head then
			local tag = Instance.new("BillboardGui")
			tag.Size = UDim2.fromOffset(360, 70)
			tag.StudsOffsetWorldSpace = Vector3.new(0, head.Size.Y * 1.2, 0)
			tag.AlwaysOnTop = true
			tag.MaxDistance = 6000
			local label = Instance.new("TextLabel")
			label.Size = UDim2.fromScale(1, 1)
			label.BackgroundTransparency = 1
			label.Font = Enum.Font.LuckiestGuy
			label.TextScaled = true
			label.TextColor3 = Color3.fromRGB(255, 213, 74)
			label.TextStrokeTransparency = 0
			label.Text = Show.OwnerName
			label.Parent = tag
			tag.Parent = head
		end

		-- Arm gestures: small runtime animations that pose only the upper arms (Motor6D properties can't be
		-- written from a script; animations can). If one can't be made the giant simply doesn't gesture.
		local gestureTracks: { [string]: AnimationTrack } = {}
		local function makeGesture(name: string, right: CFrame?, left: CFrame?)
			local ok, err = pcall(function()
				local seq = Instance.new("KeyframeSequence")
				seq.Name = "Gesture" .. name
				seq.Priority = Enum.AnimationPriority.Action
				seq.Loop = true
				for i = 0, 1 do
					local kf = Instance.new("Keyframe")
					kf.Time = i * 0.5
					local rootPose = Instance.new("Pose")
					rootPose.Name = "HumanoidRootPose"
					rootPose.Weight = 0
					rootPose.Name = "HumanoidRootPart"
					local lower = Instance.new("Pose")
					lower.Name = "LowerTorso"
					lower.Weight = 0
					local upper = Instance.new("Pose")
					upper.Name = "UpperTorso"
					upper.Weight = 0
					upper.Parent = lower
					lower.Parent = rootPose
					local wiggle = if name == "wave" and i == 1 then CFrame.Angles(0, 0, 0.35) else CFrame.identity
					if right then
						local r = Instance.new("Pose")
						r.Name = "RightUpperArm"
						r.CFrame = right * wiggle
						r.Weight = 1
						r.Parent = upper
					end
					if left then
						local l = Instance.new("Pose")
						l.Name = "LeftUpperArm"
						l.CFrame = left
						l.Weight = 1
						l.Parent = upper
					end
					rootPose.Parent = kf
					kf.Parent = seq
				end
				local hash = KeyframeSequenceProvider:RegisterKeyframeSequence(seq)
				local anim = Instance.new("Animation")
				anim.AnimationId = hash
				local track = animator:LoadAnimation(anim)
				track.Priority = Enum.AnimationPriority.Action
				track.Looped = true
				gestureTracks[name] = track
			end)
			if not ok then
				warn("[AbuseGiant] gesture '" .. name .. "' unavailable: " .. tostring(err))
			end
		end
		local gestureNow: string? = nil
		local function setGesture(name: string?)
			if name == gestureNow then
				return
			end
			gestureNow = name
			for key, track in gestureTracks do
				pcall(function()
					if key == name then
						if not track.IsPlaying then
							track:Play(0.3)
						end
					elseif track.IsPlaying then
						track:Stop(0.3)
					end
				end)
			end
		end

		-- Debugging: ":abusedebug" turns on a floating readout and prints. DEBUG is checked every frame.
		local lastDebugPrint = 0
		local lastErr = 0
		local debugLabel: TextLabel? = nil
		local function debugStep(info: { [string]: any })
			if not giantDebug then
				if debugLabel then
					debugLabel.Parent:Destroy()
					debugLabel = nil
				end
				return
			end
			if head and not debugLabel then
				local gui = Instance.new("BillboardGui")
				gui.Size = UDim2.fromOffset(520, 150)
				gui.StudsOffsetWorldSpace = Vector3.new(0, head.Size.Y * 2.6, 0)
				gui.AlwaysOnTop = true
				gui.MaxDistance = 6000
				local l = Instance.new("TextLabel")
				l.Size = UDim2.fromScale(1, 1)
				l.BackgroundColor3 = Color3.new(0, 0, 0)
				l.BackgroundTransparency = 0.35
				l.TextColor3 = Color3.new(1, 1, 1)
				l.Font = Enum.Font.Code
				l.TextSize = 18
				l.Parent = gui
				gui.Parent = head
				debugLabel = l
			end
			local text = string.format(
				"state=%s walking=%s gesture=%s\nrootY=%.1f rootAbove=%.1f scale=%.1f\nlow=%.2f floor=%.1f leap=%.1f\nangle=%.0f",
				info.state, tostring(info.walking), tostring(gestureNow), info.rootY, info.rootAbove, info.scale, info.low, ROOM_FLOOR, info.leap, math.deg(info.angle) % 360
			)
			if debugLabel then
				debugLabel.Text = text
			end
			if os.clock() - lastDebugPrint &gt; 1 then
				lastDebugPrint = os.clock()
				print("[AbuseGiant] " .. string.gsub(text, "\n", " | "))
			end
		end

		-- A circle round the table. Behind the dishwasher building (the north side) nobody in the lobby can see
		-- him, so he does nothing there: effects and the exit wait until he is back round on the visible side.
		local RADIUS = 300
		local angle = math.pi / 2
		local function hiddenNow(): boolean
			local deg = math.deg(angle) % 360
			return deg &gt; 205 and deg &lt; 335
		end
		local walkSpeed = 100
		local state, stateUntil = "arrive", os.clock() + 2.5
		local facing = Vector3.new(-1, 0, 0)
		local pos = Vector3.new(0, ROOM_FLOOR, TABLE_CENTER.Z + RADIUS)
		local acts = 0
		local flyHeight, flySpeed = 0, 60
		local leapHeight = 0 -- how far he is above the floor while jumping over the obby
		local function face(dir: Vector3, dt: number)
			local flat = Vector3.new(dir.X, 0, dir.Z)
			if flat.Magnitude &gt; 1e-3 then
				facing = facing:Lerp(flat.Unit, math.clamp(dt * 3, 0, 1))
			end
		end
		local function setWalking(on: boolean)
			if walkTrack then
				if not walkTrack.IsPlaying then
					walkTrack:Play(0.1)
				end
				-- A stride on a giant is huge: slow the cycle so his feet don't skate (0 = standing still).
				walkTrack:AdjustSpeed(if on then walkSpeed / (16 * scaleNow) * 1.5 else 0)
			end
		end
		-- Bigger (or smaller) over a few seconds; the floor lock follows by itself.
		giantRescale = function(target: number, seconds: number)
			task.spawn(function()
				local from, t0 = scaleNow, os.clock()
				while giant == model do
					local f = math.min(1, (os.clock() - t0) / seconds)
					scaleNow = from + (target - from) * f
					rootAbove = rootAboveBase * scaleNow
					pcall(function()
						model:ScaleTo(scaleNow)
					end)
					if f &gt;= 1 then
						break
					end
					task.wait(0.1)
				end
			end)
		end
		-- The exit: he types a command, cuts a round hole in the ceiling with a laser, flies up through it,
		-- and the ceiling mends itself. (Nothing respawns him afterwards: `leaving` stays set.)
		giantLeave = function()
			if state == "leave" or state == "fly" then
				return
			end
			if hiddenNow() then
				-- not while he is behind the dishwasher: nobody could see it
				task.spawn(function()
					for _ = 1, 40 do
						task.wait(0.5)
						if giant ~= model or not hiddenNow() then
							break
						end
					end
					if giant == model and giantLeave then
						giantLeave()
					end
				end)
				return
			end
			leaving = true
			state = "leave"
			setWalking(false)
			setGesture("point")
			commandText(":noclip")
			local hx, hz = pos.X, pos.Z
			task.delay(2, function()
				if giant ~= model then
					return
				end
				setGesture("cheer")
				local from = if head then head.Position else pos + Vector3.new(0, 100, 0)
				local target = Vector3.new(hx, ROOF_Y, hz)
				local len = (target - from).Magnitude
				local laser = neonPart(Vector3.new(10, 10, len), Color3.fromRGB(255, 70, 60))
				laser.CFrame = CFrame.lookAt(from, target) * CFrame.new(0, 0, -len / 2)
				laser.Parent = workspace
				Debris:AddItem(laser, 2.5)
				TweenService:Create(laser, TweenInfo.new(2.5), { Transparency = 0.7 }):Play()
				LobbyBuilder.OpenRoofHole(hx, hz, 64) -- a real round hole in the ceiling
				for i = 0, 5 do
					task.delay(i * 0.45, function()
						Remote.AbuseBoom:FireAllClients(2.4, Vector3.new(hx, ROOF_Y, hz))
						harmlessBlast(Vector3.new(hx + math.random(-50, 50), ROOF_Y - 8, hz + math.random(-50, 50)), 20)
					end)
				end
				task.delay(3, function()
					if giant ~= model then
						return
					end
					state = "fly"
					flyHeight = 0
				end)
				-- Once he is through, the ceiling mends itself.
				task.delay(10, function()
					LobbyBuilder.HealRoof(4)
					boom(3, Vector3.new(hx, ROOF_Y - 200, hz))
				end)
			end)
		end

		local feetUp = { L = false, R = false }
		local lastStep = os.clock()
		local function footfall(foot: BasePart)
			lastStep = os.clock()
			boom(if heat then 1.8 else 1.4, Vector3.new(foot.Position.X, ROOM_FLOOR, foot.Position.Z))
		end
		local function smooth(x: number): number
			x = math.clamp(x, 0, 1)
			return x * x * (3 - 2 * x)
		end

		-- The arrival: a flash and a blast where he stands, and only then is he there.
		local arrival = Vector3.new(pos.X, ROOM_FLOOR + 110, pos.Z)
		local flash = neonPart(Vector3.new(30, 30, 30), Color3.new(1, 1, 1), Enum.PartType.Ball)
		flash.Position = arrival
		flash.Parent = workspace
		TweenService:Create(flash, TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = Vector3.new(520, 520, 520), Transparency = 1 }):Play()
		Debris:AddItem(flash, 0.8)
		boom(3, Vector3.new(pos.X, ROOM_FLOOR, pos.Z))
		for i = 1, 3 do
			task.delay(i * 0.12, function()
				ringAt(Vector3.new(pos.X, ROOM_FLOOR, pos.Z), 500 + i * 300, 1.1, Color3.fromRGB(255, 220, 140))
				Remote.AbuseBoom:FireAllClients(3, arrival)
			end)
		end
		root.CFrame = CFrame.lookAt(Vector3.new(pos.X, rootY, pos.Z), Vector3.new(pos.X + facing.X, rootY, pos.Z + facing.Z))
		task.wait(0.05)
		stateUntil = os.clock() + 2.5

		local function step(dt: number)
			local now = os.clock()
			walkSpeed = (if heat then 150 else 100) * scaleNow / Show.GiantScale
			if state == "arrive" and now &gt;= stateUntil then
				state = "walk"
				setWalking(true)
			end
			if state == "walk" then
				angle += walkSpeed / RADIUS * dt
				pos = Vector3.new(math.cos(angle) * RADIUS, ROOM_FLOOR, TABLE_CENTER.Z + math.sin(angle) * RADIUS)
				face(Vector3.new(-math.sin(angle), 0, math.cos(angle)), dt)
				-- Where the circle runs through the obby (the south side) he leaps over ALL of it: up over a
				-- few degrees, flat above it, down again. A pure function of the angle (no easing to fight).
				local deg = math.deg(angle) % 360
				local wasLeap = leapHeight
				if LobbyBuilder.ObbyExists() and deg &gt; 8 and deg &lt; 120 then
					leapHeight = 215 * math.min(smooth((deg - 8) / 14), smooth((120 - deg) / 14))
				else
					leapHeight = 0
				end
				if wasLeap &gt; 30 and leapHeight &lt;= 30 and deg &gt; 100 then
					boom(3, Vector3.new(pos.X, ROOM_FLOOR, pos.Z)) -- lands
				end
			elseif state == "act" then
				face(TABLE_CENTER - pos, dt)
				if now &gt;= stateUntil then
					state = "walk"
					setWalking(true)
					setGesture(nil)
				end
			elseif state == "leave" then
				face(TABLE_CENTER - pos, dt)
			elseif state == "fly" then
				flySpeed = math.min(520, flySpeed + 180 * dt)
				flyHeight += flySpeed * dt
				if flyHeight &gt; ROOF_Y - ROOM_FLOOR + 330 then
					removeGiant()
					return
				end
			end
			if state ~= "fly" then
				-- Floor lock: the lowest sole sits on the floor, whatever the animation does. Gently (a low
				-- gain can't oscillate even if the feet lag a frame), with a dead zone and a speed limit.
				local low2 = math.min(lowestPoint(footL), lowestPoint(footR))
				if low2 ~= math.huge and leapHeight &lt; 0.5 then
					local above = math.clamp(rootY - low2, rootAbove * 0.3, rootAbove * 4)
					local error = ROOM_FLOOR + above - rootY
					if math.abs(error) &gt; scaleNow * 2 then
						rootY += error -- a pose change moved the feet a long way: snap, never slide through the floor
					elseif math.abs(error) &gt; scaleNow * 0.02 then
						rootY += math.clamp(error * math.min(1, dt * 12), -scaleNow * dt * 8, scaleNow * dt * 8)
					end
				end
			end
			local y = if state == "fly" then rootY + flyHeight else rootY + leapHeight
			debugStep({ state = state, walking = walkTrack ~= nil and walkTrack.IsPlaying, rootY = rootY, rootAbove = rootAbove, scale = scaleNow, low = math.min(lowestPoint(footL), lowestPoint(footR)) - ROOM_FLOOR, leap = leapHeight, angle = angle })
			root.CFrame = CFrame.lookAt(Vector3.new(pos.X, y, pos.Z), Vector3.new(pos.X + facing.X, y, pos.Z + facing.Z))
			-- Footfalls: a foot that was lifted and is back on the floor is a step: boom.
			if state == "walk" and leapHeight &lt; 6 then
				for side, foot in { L = footL, R = footR } do
					if foot then
						local h = lowestPoint(foot) - ROOM_FLOOR
						if h &gt; scaleNow * 0.1 then
							feetUp[side] = true
						elseif feetUp[side] and h &lt; scaleNow * 0.04 then
							feetUp[side] = false
							footfall(foot)
						end
					end
				end
				if now - lastStep &gt; 1.6 then
					-- the animation isn't giving steps (not loaded?): keep the beat anyway
					footfall(root)
				end
			end
		end
		giantConn = RunService.Heartbeat:Connect(function(dt)
			local ok, err = pcall(step, dt)
			if not ok then
				-- (one bad frame must never freeze him: place him anyway, and say what happened)
				if os.clock() - lastErr &gt; 2 then
					lastErr = os.clock()
					warn("[AbuseGiant] step failed: " .. tostring(err))
				end
				pcall(function()
					local y = rootY + leapHeight
					root.CFrame = CFrame.lookAt(Vector3.new(pos.X, y, pos.Z), Vector3.new(pos.X + facing.X, y, pos.Z + facing.Z))
				end)
			end
		end)
		-- The script stops him and raises an arm when he does something.
		playEffect = function(name: string)
			if name == "winner" then
				name = chosenEffect
			end
			local effect = FX[name]
			if not effect or giant ~= model or state == "leave" or state == "fly" then
				return
			end
			if hiddenNow() then
				task.spawn(function()
					for _ = 1, 40 do
						task.wait(0.4)
						if giant ~= model or state == "leave" or state == "fly" or not hiddenNow() then
							break
						end
					end
					if giant == model and not hiddenNow() then
						playEffect(name)
					end
				end)
				return
			end
			acts += 1
			if state == "walk" then
				state, stateUntil = "act", os.clock() + (if heat then 2.6 else 3.4)
				setWalking(false)
			end
			commandText(nil)
			task.delay(0.8, effect)
			if name ~= "eyes" and state == "act" and FX.eyes then
				task.delay(0.4, FX.eyes)
			end
			if name == "meteors" or name == "blackhole" or name == "tornado" then
				Remote.AbuseBoom:FireAllClients(2.5, Vector3.new(0, 0, 0))
			end
		end
	end

	----------------------------------------------------------------- the clock
	-- Each step happens once per server, a second or so after its time comes (a server that joins late
	-- skips what is already over).
	local fired: { [string]: boolean } = {}
	local function once(key: string): boolean
		if fired[key] then
			return false
		end
		fired[key] = true
		return true
	end
	local obbyOpen = false
	local function setObby(open: boolean)
		if open ~= obbyOpen then
			obbyOpen = open
			ReplicatedStorage:SetAttribute("AbuseObbyOpen", open)
			if open then
				ReplicatedStorage:SetAttribute("AbuseObbyWinner", nil)
			end
		end
	end
	-- The room reacts to the heat: it goes dark and red (and comes back).
	local roomOriginal: { [string]: any }? = nil
	local function roomHeat(on: boolean)
		local goal
		if on then
			if not roomOriginal then
				roomOriginal = { ClockTime = Lighting.ClockTime, Brightness = Lighting.Brightness, Ambient = Lighting.Ambient, OutdoorAmbient = Lighting.OutdoorAmbient }
			end
			goal = { ClockTime = 0.2, Brightness = 0.6, Ambient = Color3.fromRGB(70, 22, 26), OutdoorAmbient = Color3.fromRGB(96, 30, 30) }
		elseif roomOriginal then
			goal = roomOriginal
			roomOriginal = nil
		else
			return
		end
		TweenService:Create(Lighting, TweenInfo.new(4), goal):Play()
	end
	local function setMusic(which: string?)
		ReplicatedStorage:SetAttribute("AbuseMusic", which)
	end
	local function resetShow()
		leaving = false
		removeGiant()
		LobbyBuilder.SetBarriers(false)
		closeHoles()
		heat = false
		ReplicatedStorage:SetAttribute("AbuseHeat", false)
		ReplicatedStorage:SetAttribute("AbuseLive", false)
		setMusic(nil)
		roomHeat(false)
		setObby(false)
		LobbyBuilder.BreakObby()
		LobbyBuilder.SetRescue(false)
	end
	-- The first player to finish the obby (in any server) wins a game pass, announced to everyone.
	ReplicatedStorage:GetAttributeChangedSignal("AbuseObbyFinish"):Connect(function()
		local info = tostring(ReplicatedStorage:GetAttribute("AbuseObbyFinish") or "")
		local name = string.match(info, "^(.-):")
		local e = abuseEvent()
		if not name or not e or not obbyOpen then
			return
		end
		task.spawn(function()
			-- ONE popup per finisher (the gems were already added): the first finisher in any server also
			-- wins a game pass, announced once in the speech box (no banner on top of everything).
			local plr = Players:FindFirstChild(name)
			local gems = Config.Obby.ShowGems
			local first = claim("obbyfirst:" .. tostring(e.Starts))
			if not (plr and plr:IsA("Player")) then
				if first then
					publish({ Kind = "AbuseSay", Text = name .. " finished the obby first and wins a game pass. well done." })
				end
				return
			end
			if first then
				local passes = DataService.GetPasses and DataService.GetPasses(plr) or {}
				local free = {}
				for _, pass in ipairs(Config.GamePasses) do
					if passes[pass.Key] ~= true and plr:GetAttribute(gamepassAttribute(pass.Key)) ~= true then
						table.insert(free, pass)
					end
				end
				if #free &gt; 0 then
					local pass = free[math.random(1, #free)]
					setGamepassGrant(plr, pass, true, false)
					celebrate(plr, "First to finish!", string.format("You won %s and %d Gems for finishing the obby first!", pass.Name, gems), pass.Icon)
				else
					DataService.AddGems(plr, 100)
					celebrate(plr, "First to finish!", string.format("You finished first! %d Gems, plus 100 more because you own every pass.", gems), "@Gem")
				end
				publish({ Kind = "AbuseSay", Text = name .. " finished the obby first and wins a game pass. well done." })
			else
				celebrate(plr, "You beat the obby!", string.format("You got %d Gems!", gems), "@Gem")
			end
		end)
	end)
	task.spawn(function()
		while true do
			task.wait(1)
			local e = abuseEvent()
			if not e then
				continue
			end
			local t = Config.Now() - e.Starts -- negative before the start
			local tag = tostring(e.Starts)
			-- Countdown warnings (only if we're still within a minute of them: late servers stay quiet).
			for _, w in ipairs(Show.Warnings) do
				if t &gt;= -w and t &lt; -w + 60 and once("warn" .. w .. tag) then
					local mins = math.floor(w / 60)
					bannerAll(string.format("Admin Abuse starts in %d minute%s! You can't start a round right now. Stay tuned for free game passes, Bubbles and surprises!", mins, if mins == 1 then "" else "s"))
				end
			end
			if t &gt;= 0 and t &lt; Show.ShowSeconds then
				local wasHeat = heat
				heat = t &gt;= Show.HeatAt
				if once("live" .. tag) then
					ReplicatedStorage:SetAttribute("AbuseLive", true)
					LobbyBuilder.SetBarriers(true) -- no invisible walls for the whole show
					LobbyBuilder.SetRescue(true)
					setMusic("Warm")
				end
				if heat ~= wasHeat then
					ReplicatedStorage:SetAttribute("AbuseHeat", heat)
					roomHeat(heat)
					setMusic(if heat then "Heat" else "Warm")
					if giantRescale then
						giantRescale(if heat then Show.HeatScale else Show.GiantScale, 3)
					end
				end
				if once("start" .. tag) then
					bannerAll("ADMIN ABUSE IS LIVE!")
				end
				-- Anyone still in a run goes back to the lobby.
				for _, plr in ipairs(Players:GetPlayers()) do
					if RoundService.IsInRun(plr) then
						RoundService.RemoveFromRun(plr)
					end
				end
				if once("intro" .. tag) then
					-- boom, boom, boom: the lobby shakes before he arrives
					for i = 0, 2 do
						task.delay(i * 0.9, function()
							Remote.AbuseBoom:FireAllClients(3, Vector3.new(0, ROOM_FLOOR, 330))
						end)
					end
				end
				if not RunServers.IsRunServer and t &gt;= 3 and not leaving then
					task.spawn(spawnGiant)
				end
				-- The script, in order.
				for i, step in ipairs(Show.Script) do
					if t &gt;= step[1] and t &lt; step[1] + 20 and once("s" .. i .. tag) then
						local kind = step[2]
						if kind == "say" then
							say(step[3])
						elseif kind == "attack" then
							playEffect(step[3])
						elseif kind == "round" then
							if claim("round" .. step[3] .. ":" .. tag) then
								runRound(Show.Rounds[step[3]])
							end
						elseif kind == "hole" then
							openHole(step[3])
						elseif kind == "heal" then
							closeHoles()
						elseif kind == "thanks" then
							-- everyone online gets something for staying (this server's players; every server runs this)
							for _, plr in ipairs(Players:GetPlayers()) do
								if DataService.AddGems(plr, Show.ThanksGems) then
									celebrate(plr, "Thanks for coming!", string.format("Everyone who stayed got %d Gems. See you in Chapter 4!", Show.ThanksGems), "@Gem")
								end
							end
						elseif kind == "obby" then
							if step[3] then
								LobbyBuilder.OpenObby()
								bannerAll("THE OBBY IS OPEN! It's behind the spawn. Everyone who finishes wins Gems, and the first to finish wins a game pass!")
								task.delay(10, function()
									setObby(true)
								end)
							else
								setObby(false)
								LobbyBuilder.BreakObby()
							end
						elseif kind == "leave" then
							if giantLeave then
								giantLeave()
							end
							-- failsafe: whatever happens, he is gone a little later
							task.delay(16, function()
								removeGiant()
							end)
						end
					end
				end
			elseif t &gt;= Show.ShowSeconds then
				-- The show is over: everything is put away, and rounds can start again.
				if once("end" .. tag) then
					resetShow()
					if t &lt; Show.ShowSeconds + 120 then
						bannerAll("ADMIN ABUSE IS OVER! You can start rounds again. Stay tuned for Chapter 4!")
					end
				end
			end
		end
	end)

	-- :notifytest (Studio tab): sends the "daily reward ready" notification to you right now and tells you how
	-- it went (secret found? HTTP on? are you opted in to notifications for this experience?).
	Commands.notifytest = function(admin, _text)
		task.spawn(function()
			local result = DailyNotify.TestNow(admin)
			sendFeedback(admin, "Notification test: " .. result, not string.find(result, "^Sent"))
		end)
	end

	Commands.abuseshow = function(admin, text)
		local e = abuseEvent()
		if not e then
			sendFeedback(admin, "No Admin Abuse event is set up.", true)
			return
		end
		local arg = string.lower(text:match("^%s*(%S*)") or "")
		local starts, ends
		if arg == "reset" then
			if not realStarts then
				return
			end
			starts, ends = realStarts, realEnds
		else
			local minutes = math.clamp(tonumber(arg) or 1, 0.25, 600)
			starts = Config.Now() + math.floor(minutes * 60)
			ends = starts + 3600
		end
		if claimMap then
			-- steps from an earlier try would otherwise count as already done
			pcall(function()
				for key in Show.Rounds do
					claimMap:RemoveAsync("round" .. key .. ":" .. tostring(starts))
				end
			end)
		end
		resetShow() -- (this server) put away anything from an earlier try
		local ok = publish({ Kind = "AbuseSchedule", Starts = starts, Ends = ends })
		if arg ~= "reset" then
			local mins = math.ceil((starts - Config.Now()) / 60)
			publish({ Kind = "Banner", Text = string.format("Admin Abuse starts in %d minute%s! You can't start a round right now. Stay tuned for free game passes, Bubbles and surprises!", mins, if mins == 1 then "" else "s") })
		end
		sendFeedback(admin, if arg == "reset" then "Admin Abuse is back on its real time." else string.format("Admin Abuse show starts in %s%s. Rounds are paused from now.", Format.Time and Format.Time(starts - Config.Now()) or tostring(math.floor((starts - Config.Now()) / 60)) .. " min", if ok then " (every server)" else " (this server only)"), false)
		logCommand(admin, "abuseshow", nil, arg, admin.Name .. " set the Admin Abuse show: " .. tostring(arg))
	end

	Commands.abusedebug = function(admin, _text)
		giantDebug = not giantDebug
		sendFeedback(admin, if giantDebug then "Giant debug is ON (readout above him, prints in Output)." else "Giant debug is off.", false)
	end

	-- :abusefx &lt;name&gt; (Studio tab): try one piece of the show on its own (it spawns the giant if needed).
	local FX_NAMES = { "beam", "meteors", "lightning", "shockwave", "barrage", "fireworks", "laser", "blackhole", "tornado", "ufo", "disco", "fountains", "eyes" }
	Commands.abusefx = function(admin, text)
		local arg = string.lower(text:match("^%s*(%S*)") or "")
		local function needGiant(): boolean
			if giant then
				return true
			end
			spawnFailures = 0
			task.spawn(spawnGiant)
			for _ = 1, 40 do
				if giant then
					return true
				end
				task.wait(0.5)
			end
			return giant ~= nil
		end
		task.spawn(function()
			if arg == "all" then
				if not needGiant() then
					sendFeedback(admin, "Couldn't build the giant (see the output).", true)
					return
				end
				sendFeedback(admin, "Playing every effect, 9 seconds apart: " .. table.concat(FX_NAMES, ", "), false)
				for _, name in ipairs(FX_NAMES) do
					say("[test] " .. name)
					playEffect(name)
					task.wait(9)
				end
			elseif table.find(FX_NAMES, arg) then
				if needGiant() then
					playEffect(arg)
					sendFeedback(admin, "Playing: " .. arg, false)
				end
			elseif arg == "hole1" or arg == "hole2" then
				openHole(tonumber(string.sub(arg, 5)) :: number)
				sendFeedback(admin, "Opened " .. arg .. ". (:abusefx heal puts it back.)", false)
			elseif arg == "heal" then
				closeHoles()
				sendFeedback(admin, "The holes are closing.", false)
			elseif arg == "obby" then
				LobbyBuilder.OpenObby()
				task.delay(10, function()
					setObby(true)
					LobbyBuilder.SetRescue(true)
				end)
				sendFeedback(admin, "Building the obby (about 10 seconds).", false)
			elseif arg == "obbybreak" then
				setObby(false)
				LobbyBuilder.BreakObby()
				sendFeedback(admin, "Smashing the obby.", false)
			elseif arg == "heat" or arg == "calm" then
				heat = arg == "heat"
				ReplicatedStorage:SetAttribute("AbuseHeat", heat)
				roomHeat(heat)
				if giantRescale then
					giantRescale(if heat then Show.HeatScale else Show.GiantScale, 3)
				end
				sendFeedback(admin, if heat then "Heat is up (:abusefx calm to cool it)." else "Back to calm.", false)
			elseif arg == "leave" then
				if needGiant() and giantLeave then
					giantLeave()
					sendFeedback(admin, "He is leaving through the roof.", false)
				end
			elseif arg == "off" then
				resetShow()
				sendFeedback(admin, "Everything put away.", false)
			else
				sendFeedback(admin, "Usage: :abusefx [all | " .. table.concat(FX_NAMES, " | ") .. " | hole1 | hole2 | heal | obby | obbybreak | heat | calm | leave | off]", true)
			end
		end)
	end
	end)()
end</ProtectedString></Properties></Item>
</Item>
<Item class="Folder" referent="RBX0000000F"><Properties><string name="Name">Server</string></Properties>
<Item class="Folder" referent="RBX00000010"><Properties><string name="Name">Services</string></Properties>
<Item class="ModuleScript" referent="RBX00000011"><Properties><string name="Name">ArenaBuilder</string><ProtectedString name="Source">-- ArenaBuilder: builds one dishwasher ("arena") for a run, sitting in a family kitchen, and lays out
-- the load of dirty dishes inside it. RoundService calls Build(slot, levelIndex, options) once per
-- run and Destroy(arena) when the run ends; nothing else touches workspace.Arenas directly.
--
-- Coordinate convention ("arena space"): every builder helper below works in local offsets
-- (x = sideways, y = up, z = depth) measured from `origin` (the tub floor centre, see SlotOrigin).
-- `origin.LookVector` points from the door toward the back wall, so +z is "into the tub" and the
-- open door and the rest of the kitchen are at -z.
--
-- The dishwasher is sized so a ~5 stud character is a tiny person inside a real machine:
--   * tub interior X +-56, Z -50..62, 100 tall; the open door lies flat in front (Z -50..-121)
--   * bottom rack floor at Y 4: three rows of standing plates, pans/pots and a cutlery basket
--   * top rack floor at Y 50: tilted bowls, upturned mugs and glasses
--   * bubble-lift pads (tag "LiftPad", attribute LiftTo) carry you up; the client does the
--     teleport (Effects). Hold jump in the air to fly on bubble jets (BubbleJets, client).
--   * the kitchen floor is 24 studs below the tub; falling off the door teleports you back.
--
-- Everything the spray can hit lives in two folders on the arena Model: "Dishes" and "Grime" (dirt).
-- Nothing else is aimable (SprayController only raycasts those), so walls never block a scrub.
--
-- Performance: the build yields with task.wait() every ~200 parts.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))

local DishFactory = require(script.Parent:WaitForChild("DishFactory"))
local ToolModels = require(Shared:WaitForChild("ToolModels"))

local ArenaBuilder = {}

----------------------------------------------------------------------------------------------------
-- Layout numbers (arena space).
----------------------------------------------------------------------------------------------------
local TUB_HALF_X = 56
local TUB_Z_MIN, TUB_Z_MAX = -50, 62
local TUB_HEIGHT = 100 -- (the Backyard sink is shallower: set per build)

local DOOR_Z_NEAR, DOOR_Z_FAR = -50, -121 -- the open door lies flat over this Z range, top at Y = 0
local DOOR_THICK = 4
local SPAWN_Z = -100

local KITCHEN_FLOOR_Y = -24
local COUNTER_TOP_Y = 112 -- (lower outdoors: set per build)
local ROOM_HALF_X = 420 -- (the castle hall is much wider: set per build)
local ROOM_Z_FRONT, ROOM_Z_BACK = -520, 76 -- (the castle hall is much deeper: set per build)
local ROOM_HEIGHT = 520 -- (and much taller)

local DRAIN_POS = Vector3.new(0, 0, -49) -- clear of the rack ramp (Z -41..-36)

local BOTTOM_RACK_Y = 4
local TOP_RACK_Y = 50
local RACK_HALF_X = 54
local BOTTOM_RACK_Z = { -36, 60 }
local TOP_RACK_Z = { -40, 60 }

-- Bottom rack: three rows of plates facing the door, spaced so a character fits between them.
local PLATE_ROW_X = { -34, 0, 34 }
local PLATE_Z = { -28, -21, -14, -7, 0, 7, 14, 21, 28 }
local PAN_SLOTS = { { x = -43, z = 47 }, { x = 43, z = 47 } }
local POT_SLOTS = { { x = -22, z = 47 }, { x = 22, z = 47 } }
local BASKET_CENTER = Vector3.new(0, 0, 47)
local BASKET_HALF = Vector3.new(10, 8, 9)
local BASKET_X = { -7.5, -2.5, 2.5, 7.5 }
local BASKET_Z = { 40.5, 44, 47.5, 51, 54.5 }

-- Top rack.
local BOWL_X = { -30, -15, 0, 15, 30 }
local BOWL_Z = { -24, -6 }
local CUP_X = { -40, -24, -8, 8, 24, 40 }
local CUP_Z = { 10, 24 }
local GLASS_X = { -42, -30, -18, -6, 6, 18, 30, 42 }
local GLASS_Z = { 38, 52 }

local BOWL_TILT = math.rad(50)
local PAN_TILT = math.rad(55)

-- Lifts (tub floor front corners -&gt; top rack). Coming down, you just jump off (or fly with bubble jets).
local LIFTS = {
	{ from = Vector3.new(-47, 0, -45), to = Vector3.new(-47, TOP_RACK_Y, -34) },
	{ from = Vector3.new(47, 0, -45), to = Vector3.new(47, TOP_RACK_Y, -34) },
}

-- Tool shop counter on the left of the open door.
local SHOP_X = -49
local SHOP_Z = { -112, -60 }

-- In a party's own run server nobody else is playing (and the party is behind a loading screen),
-- so build in far bigger steps there: the dishwasher is ready sooner.
local YIELD_EVERY = if game.PrivateServerId ~= "" and game.PrivateServerOwnerId == 0 then 3000 else 200

-- Kitchen palette (theme-independent: every level is the same family kitchen).
local K = {
	Floor = Color3.fromRGB(196, 158, 116),
	Wall = Color3.fromRGB(214, 230, 238),
	Cabinet = Color3.fromRGB(244, 241, 234),
	CabinetDoor = Color3.fromRGB(236, 232, 224),
	Counter = Color3.fromRGB(235, 235, 238),
	Tile = Color3.fromRGB(250, 250, 250),
	Handle = Color3.fromRGB(170, 175, 182),
	Kick = Color3.fromRGB(70, 66, 62),
	Wood = Color3.fromRGB(150, 105, 70),
	Steel = Color3.fromRGB(200, 205, 212),
	Frame = Color3.fromRGB(230, 232, 235),
}

----------------------------------------------------------------------------------------------------
-- Small helpers
----------------------------------------------------------------------------------------------------

local function getArenasFolder(): Folder
	local folder = workspace:FindFirstChild("Arenas")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Arenas"
		folder.Parent = workspace
	end
	return folder :: Folder
end

-- Local (x, y, z) -&gt; world position, in the arena's own space (see file header).
local function worldPoint(origin: CFrame, x: number, y: number, z: number): Vector3
	return origin.Position + origin.RightVector * x + Vector3.new(0, y, 0) + origin.LookVector * z
end

-- A CFrame at local (x, y, z), axis-aligned with the arena (LookVector = into the tub), optionally
-- facing `lookDir` instead. Used both for plain parts and as DishFactory's footprint.
local function footprint(origin: CFrame, x: number, y: number, z: number, lookDir: Vector3?): CFrame
	local pos = worldPoint(origin, x, y, z)
	local look = (lookDir or origin.LookVector)
	if look.Magnitude &lt; 1e-4 then
		look = origin.LookVector
	end
	return CFrame.lookAt(pos, pos + look, Vector3.new(0, 1, 0))
end

type Builder = {
	model: Model,
	origin: CFrame,
	count: number,
}

-- A decoration/structure part in arena space. Static, no touch, not aimable. Box centred at (x,y,z).
local function box(b: Builder, name: string, size: Vector3, x: number, y: number, z: number, color: Color3, material: Enum.Material?, props: { [string]: any }?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = footprint(b.origin, x, y, z)
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.Anchored = true
	p.CanTouch = false
	p.CanQuery = false
	p.CanCollide = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if props then
		for k, v in props do
			(p :: any)[k] = v
		end
	end
	-- Solid, visible scenery is queryable so the camera bumps into it instead of sliding through
	-- walls and ovens (every gameplay query uses an Include filter, so this changes nothing else).
	if not (props and props.CanQuery ~= nil) then
		p.CanQuery = p.CanCollide and p.Transparency &lt; 0.25
	end
	p.Parent = b.model
	b.count += 1
	return p
end

-- Box from min/max corners (arena space). Handy for walls and cabinets.
local function span(b: Builder, name: string, x0: number, x1: number, y0: number, y1: number, z0: number, z1: number, color: Color3, material: Enum.Material?, props: { [string]: any }?): Part
	return box(b, name, Vector3.new(math.abs(x1 - x0), math.abs(y1 - y0), math.abs(z1 - z0)), (x0 + x1) / 2, (y0 + y1) / 2, (z0 + z1) / 2, color, material, props)
end

-- Upright cylinder (axis = world Y) centred at (x, y, z).
local function cyl(b: Builder, name: string, height: number, diameter: number, x: number, y: number, z: number, color: Color3, material: Enum.Material?, props: { [string]: any }?): Part
	local p = box(b, name, Vector3.new(height, diameter, diameter), x, y, z, color, material, props)
	p.Shape = Enum.PartType.Cylinder
	p.CFrame = footprint(b.origin, x, y, z) * CFrame.Angles(0, 0, math.rad(90))
	return p
end

local function noCollide(): { [string]: any }
	return { CanCollide = false, CastShadow = false }
end

-- A world-sized sign (it scales with distance like a real object, so it never fills the screen).
-- It hangs off its own unrotated, invisible anchor `offsetY` above `parent`: cylinders are rotated
-- 90 degrees internally and a BillboardGui's offset follows that rotation, which is what used to
-- bury signs in the floor.
local function sign(parent: BasePart, text: string, widthStuds: number, heightStuds: number, offsetY: number, color: Color3?): TextLabel
	local anchor = Instance.new("Part")
	anchor.Name = "SignAnchor"
	anchor.Size = Vector3.new(0.2, 0.2, 0.2)
	anchor.CFrame = CFrame.new(parent.Position + Vector3.new(0, offsetY, 0))
	anchor.Transparency = 1
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.CastShadow = false
	anchor.Parent = parent.Parent
	local gui = Instance.new("BillboardGui")
	gui.Name = "Sign"
	gui.Size = UDim2.fromScale(widthStuds, heightStuds)
	gui.LightInfluence = 0
	gui.MaxDistance = 160
	gui.AlwaysOnTop = false
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.LuckiestGuy
	label.TextScaled = true
	label.TextColor3 = color or Color3.new(1, 1, 1)
	label.Text = text
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 3
	stroke.Color = Color3.fromRGB(12, 30, 60)
	stroke.Parent = label
	label.Parent = gui
	gui.Parent = anchor
	return label
end

----------------------------------------------------------------------------------------------------
-- The kitchen around the dishwasher
----------------------------------------------------------------------------------------------------

-- Room styles: every level uses the same dishwasher, set in a different room.
type RoomStyle = { [string]: any }
local ROOM_STYLES: { RoomStyle } = {
	-- 1: Family kitchen.
	{
		Floor = K.Floor, FloorMat = Enum.Material.WoodPlanks,
		Wall = K.Wall, WallMat = Enum.Material.SmoothPlastic,
		Ceiling = Color3.fromRGB(248, 248, 246),
		Cabinet = K.Cabinet, CabinetDoor = K.CabinetDoor, CabMat = Enum.Material.SmoothPlastic,
		Counter = K.Counter, CounterMat = Enum.Material.Marble,
		Tile = K.Tile, TileMat = Enum.Material.CeramicTiles,
		Handle = K.Handle, HandleMat = Enum.Material.Metal,
		Kick = K.Kick,
		Lamp = Color3.fromRGB(255, 248, 225),
		Bench = "Home",
	},
	-- 2: Backyard pizza party: an outdoor kitchen counter of whitewashed wood under open sky.
	{
		Outdoor = true,
		Floor = Color3.fromRGB(176, 170, 160), FloorMat = Enum.Material.Slate,
		Wall = Color3.fromRGB(120, 112, 100), WallMat = Enum.Material.Cobblestone,
		Ceiling = Color3.fromRGB(190, 225, 255),
		Cabinet = Color3.fromRGB(150, 108, 72), CabinetDoor = Color3.fromRGB(176, 130, 90), CabMat = Enum.Material.WoodPlanks,
		Counter = Color3.fromRGB(190, 186, 178), CounterMat = Enum.Material.Slate,
		Tile = Color3.fromRGB(150, 142, 130), TileMat = Enum.Material.Cobblestone,
		Handle = Color3.fromRGB(60, 60, 66), HandleMat = Enum.Material.Metal,
		Kick = Color3.fromRGB(70, 56, 44),
		Lamp = Color3.fromRGB(255, 214, 150),
		Bench = "Garden",
	},
	-- (level 2 is the Backyard: see buildYard; this entry only supplies the outdoor kitchen counter)
	-- 3: Castle banquet hall: stone, dark wood, gold, a red carpet.
	{
		Floor = Color3.fromRGB(128, 122, 116), FloorMat = Enum.Material.Slate,
		Wall = Color3.fromRGB(150, 144, 136), WallMat = Enum.Material.Cobblestone,
		Ceiling = Color3.fromRGB(70, 52, 40),
		Cabinet = Color3.fromRGB(150, 144, 136), CabinetDoor = Color3.fromRGB(112, 72, 46), CabMat = Enum.Material.Cobblestone,
		Counter = Color3.fromRGB(104, 66, 40), CounterMat = Enum.Material.WoodPlanks,
		Tile = Color3.fromRGB(120, 112, 104), TileMat = Enum.Material.Slate,
		Handle = Color3.fromRGB(230, 190, 90), HandleMat = Enum.Material.Metal,
		Kick = Color3.fromRGB(50, 34, 24),
		Lamp = Color3.fromRGB(255, 205, 140),
		Bench = "Stone",
	},
}

-- A flat SurfaceGui text sign on a box. `face` is the side the text is on.
local function roomSign(b: Builder, text: string, size: Vector3, x: number, y: number, z: number, bg: Color3, fg: Color3, face: Enum.NormalId, material: Enum.Material?)
	local p = box(b, "RoomSign", size, x, y, z, bg, material, noCollide())
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.LightInfluence = 0
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 8
	gui.Parent = p
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(0.9, 0.8)
	label.Position = UDim2.fromScale(0.05, 0.1)
	label.Font = Enum.Font.LuckiestGuy
	label.TextScaled = true
	label.TextColor3 = fg
	label.Text = text
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 4
	stroke.Color = Color3.fromRGB(20, 16, 14)
	stroke.Parent = label
	label.Parent = gui
	return p
end

-- Floor, walls, ceiling, base and upper cabinets and the counter over the dishwasher.
local function buildKitchen(b: Builder, k: RoomStyle)
	local fy = KITCHEN_FLOOR_Y
	local shadowless = { CastShadow = false }

	-- Floor: one slab, or a big checkerboard when the style has a second colour.
	if k.Floor2 then
		span(b, "KitchenFloor", -ROOM_HALF_X, ROOM_HALF_X, fy - 4, fy - 0.2, ROOM_Z_FRONT, ROOM_Z_BACK, k.Floor2, k.FloorMat)
		local tile = 60
		local ix = 0
		for x = -ROOM_HALF_X, ROOM_HALF_X - 1, tile do
			local iz = 0
			for z = ROOM_Z_FRONT, ROOM_Z_BACK - 1, tile do
				if (ix + iz) % 2 == 0 then
					span(b, "FloorTile", x, math.min(x + tile, ROOM_HALF_X), fy - 0.2, fy, z, math.min(z + tile, ROOM_Z_BACK), k.Floor, k.FloorMat)
				end
				iz += 1
			end
			ix += 1
		end
	else
		span(b, "KitchenFloor", -ROOM_HALF_X, ROOM_HALF_X, fy - 4, fy, ROOM_Z_FRONT, ROOM_Z_BACK, k.Floor, k.FloorMat)
	end
	if k.Outdoor then
		-- Open sky: no walls or ceiling, just invisible barriers (so nobody wanders or flies off
		-- the patio) at the old room's edges.
		local inv = { Transparency = 1, CastShadow = false }
		span(b, "BarrierBack", -ROOM_HALF_X - 4, ROOM_HALF_X + 4, fy, fy + ROOM_HEIGHT, 110, 114, k.Wall, nil, inv)
		span(b, "BarrierFront", -ROOM_HALF_X - 4, ROOM_HALF_X + 4, fy, fy + ROOM_HEIGHT, ROOM_Z_FRONT - 4, ROOM_Z_FRONT, k.Wall, nil, inv)
		for _, side in { -1, 1 } do
			span(b, "BarrierSide", side * ROOM_HALF_X, side * (ROOM_HALF_X + 4), fy, fy + ROOM_HEIGHT, ROOM_Z_FRONT, 114, k.Wall, nil, inv)
		end
		span(b, "BarrierTop", -ROOM_HALF_X, ROOM_HALF_X, fy + ROOM_HEIGHT, fy + ROOM_HEIGHT + 4, ROOM_Z_FRONT, 114, k.Wall, nil, inv)
	else
		span(b, "BackWall", -ROOM_HALF_X, ROOM_HALF_X, fy, fy + ROOM_HEIGHT, ROOM_Z_BACK, ROOM_Z_BACK + 4, k.Wall, k.WallMat, shadowless)
		span(b, "FrontWall", -ROOM_HALF_X, ROOM_HALF_X, fy, fy + ROOM_HEIGHT, ROOM_Z_FRONT - 4, ROOM_Z_FRONT, k.Wall, k.WallMat, shadowless)
		for _, side in { -1, 1 } do
			span(b, "SideWall", side * ROOM_HALF_X, side * (ROOM_HALF_X + 4), fy, fy + ROOM_HEIGHT, ROOM_Z_FRONT, ROOM_Z_BACK, k.Wall, k.WallMat, shadowless)
			span(b, "Skirting", side * (ROOM_HALF_X - 2), side * ROOM_HALF_X, fy, fy + 10, ROOM_Z_FRONT, ROOM_Z_BACK, k.Kick, nil, noCollide())
		end
		span(b, "Ceiling", -ROOM_HALF_X, ROOM_HALF_X, fy + ROOM_HEIGHT, fy + ROOM_HEIGHT + 4, ROOM_Z_FRONT, ROOM_Z_BACK, k.Ceiling, nil, shadowless)
	end

	-- The bench either side of the dishwasher. Same solid body and counter height in every level
	-- (players run along the top); what it's dressed as depends on the room.
	local cabFront = -54
	local bench = k.Bench or "Home"
	local backZ = if k.Outdoor then 110 else ROOM_Z_BACK -- outdoors the counter runs a little deeper (the tap stands there)
	for _, side in { -1, 1 } do
		local x0, x1 = side * 62, side * ROOM_HALF_X
		span(b, "Cabinets", x0, x1, fy + 12, COUNTER_TOP_Y - 6, cabFront, backZ, k.Cabinet, k.CabMat)
		span(b, "ToeKick", x0, x1, fy, fy + 12, cabFront + 8, backZ, k.Kick)
		local width = math.abs(x1 - x0)
		local doors = math.floor(width / 80)
		local doorW = width / doors
		for i = 0, doors - 1 do
			local cx = side * (62 + doorW * (i + 0.5))
			if bench == "Steel" then
				-- A commercial line: reach-in fridges with glass fronts and long bar handles.
				local steel = Color3.fromRGB(205, 210, 216)
				local y0, y1 = fy + 18, COUNTER_TOP_Y - 12
				box(b, "FridgeDoor", Vector3.new(doorW - 6, y1 - y0, 1.5), cx, (y0 + y1) / 2, cabFront - 0.75, steel, Enum.Material.Metal)
				local gy0, gy1 = y0 + 30, y1 - 14
				box(b, "FridgeInside", Vector3.new(doorW - 22, gy1 - gy0, 0.4), cx, (gy0 + gy1) / 2, cabFront - 1.6, Color3.fromRGB(40, 48, 58), nil, noCollide())
				for shelf = 0, 1 do
					local sy = gy0 + 6 + shelf * (gy1 - gy0) / 2
					box(b, "FridgeShelf", Vector3.new(doorW - 24, 1, 0.6), cx, sy - 4, cabFront - 1.9, Color3.fromRGB(180, 190, 200), Enum.Material.Metal, noCollide())
					local tubs = { Color3.fromRGB(210, 60, 45), Color3.fromRGB(250, 235, 200), Color3.fromRGB(90, 160, 80), Color3.fromRGB(245, 200, 80) }
					for t = 0, 3 do
						local tx = cx - (doorW - 30) / 2 + (doorW - 30) * (t + 0.5) / 4
						box(b, "FridgeTub", Vector3.new(10, 12, 0.6), tx, sy + 3, cabFront - 1.9, tubs[(t + shelf + i) % #tubs + 1], nil, noCollide())
					end
				end
				local glass = box(b, "FridgeGlass", Vector3.new(doorW - 20, gy1 - gy0, 0.4), cx, (gy0 + gy1) / 2, cabFront - 2.3, Color3.fromRGB(200, 230, 245), Enum.Material.Glass, noCollide())
				glass.Transparency = 0.55
				box(b, "BarHandle", Vector3.new(2.5, gy1 - gy0, 2.5), cx + side * -(doorW / 2 - 9), (gy0 + gy1) / 2, cabFront - 4, Color3.fromRGB(150, 155, 162), Enum.Material.Metal, noCollide())
				box(b, "Vent", Vector3.new(doorW - 20, 8, 0.6), cx, y0 + 12, cabFront - 1.8, Color3.fromRGB(70, 74, 80), Enum.Material.DiamondPlate, noCollide())
				cyl(b, "Foot", 12, 6, cx - doorW / 2 + 8, fy + 6, cabFront + 4, Color3.fromRGB(150, 155, 162), Enum.Material.Metal, noCollide())
			elseif bench == "Stone" then
				-- Carved stone arches with oak barrels resting in them.
				local ay0, ay1 = fy + 18, COUNTER_TOP_Y - 30
				local aw = doorW - 22
				box(b, "Alcove", Vector3.new(aw, ay1 - ay0 - aw / 2, 1.2), cx, ay0 + (ay1 - ay0 - aw / 2) / 2, cabFront - 0.6, Color3.fromRGB(34, 28, 24), Enum.Material.Slate, noCollide())
				local arch = cyl(b, "AlcoveArch", 1.2, aw, cx, ay1 - aw / 2, cabFront - 0.6, Color3.fromRGB(34, 28, 24), Enum.Material.Slate, noCollide())
				arch.CFrame = footprint(b.origin, cx, ay1 - aw / 2, cabFront - 0.6) * CFrame.Angles(0, math.rad(90), 0)
				-- A lighter stone ring just behind the dark alcove face (shows as a border round the arch).
				local rim = cyl(b, "ArchRim", 1.6, aw + 8, cx, ay1 - aw / 2, cabFront - 0.1, Color3.fromRGB(122, 116, 108), Enum.Material.Slate, noCollide())
				rim.CFrame = footprint(b.origin, cx, ay1 - aw / 2, cabFront - 0.1) * CFrame.Angles(0, math.rad(90), 0)
				local barrelD = math.min(aw - 8, 52)
				local by = ay0 + barrelD / 2
				local barrel = cyl(b, "Barrel", 30, barrelD, cx, by, cabFront - 14, Color3.fromRGB(128, 84, 48), Enum.Material.Wood, noCollide())
				barrel.CFrame = footprint(b.origin, cx, by, cabFront - 14) * CFrame.Angles(0, math.rad(90), 0)
				for _, dz in { -9, 9 } do
					local band = cyl(b, "BarrelBand", 3, barrelD + 1.2, cx, by, cabFront - 14 + dz, Color3.fromRGB(60, 56, 54), Enum.Material.Metal, noCollide())
					band.CFrame = footprint(b.origin, cx, by, cabFront - 14 + dz) * CFrame.Angles(0, math.rad(90), 0)
				end
				local lid = cyl(b, "BarrelLid", 0.6, barrelD - 6, cx, by, cabFront - 29.4, Color3.fromRGB(150, 104, 62), Enum.Material.Wood, noCollide())
				lid.CFrame = footprint(b.origin, cx, by, cabFront - 29.4) * CFrame.Angles(0, math.rad(90), 0)
			elseif bench == "Garden" then
				-- Outdoor kitchen: plain wooden cupboard doors with a recessed panel and a handle.
				local y0, y1 = fy + 16, COUNTER_TOP_Y - 10
				box(b, "GardenDoor", Vector3.new(doorW - 8, y1 - y0, 1.5), cx, (y0 + y1) / 2, cabFront - 0.75, k.CabinetDoor, k.CabMat)
				box(b, "GardenPanel", Vector3.new(doorW - 28, y1 - y0 - 14, 0.5), cx, (y0 + y1) / 2, cabFront - 1.7, k.Cabinet, k.CabMat, noCollide())
				box(b, "DoorHandle", Vector3.new(2.5, 14, 2.5), cx + side * -(doorW / 2 - 12), (y0 + y1) / 2, cabFront - 3.2, k.Handle, k.HandleMat, noCollide())
			else
				box(b, "Drawer", Vector3.new(doorW - 6, 26, 1.5), cx, COUNTER_TOP_Y - 24, cabFront - 0.75, k.CabinetDoor, k.CabMat)
				box(b, "DrawerHandle", Vector3.new(24, 2.5, 2.5), cx, COUNTER_TOP_Y - 24, cabFront - 2.5, k.Handle, k.HandleMat, noCollide())
				box(b, "Door", Vector3.new(doorW - 6, 66, 1.5), cx, fy + 12 + 38, cabFront - 0.75, k.CabinetDoor, k.CabMat)
				box(b, "DoorHandle", Vector3.new(2.5, 20, 2.5), cx + side * -(doorW / 2 - 12), fy + 12 + 55, cabFront - 2.5, k.Handle, k.HandleMat, noCollide())
			end
		end
	end

	-- Countertop across the whole run (including over the dishwasher) with a backsplash.
	if k.Outdoor or k.TroughHole then
		-- The basin is open at the top: the counter has a hole over it (butting against its rim).
		local hx, hz1 = TUB_HALF_X + 4, TUB_Z_MAX + 4
		span(b, "Countertop", -ROOM_HALF_X, -hx, COUNTER_TOP_Y - 6, COUNTER_TOP_Y, cabFront - 6, backZ, k.Counter, k.CounterMat, shadowless)
		span(b, "Countertop", hx, ROOM_HALF_X, COUNTER_TOP_Y - 6, COUNTER_TOP_Y, cabFront - 6, backZ, k.Counter, k.CounterMat, shadowless)
		span(b, "Countertop", -hx, hx, COUNTER_TOP_Y - 6, COUNTER_TOP_Y, hz1, backZ, k.Counter, k.CounterMat, shadowless)
		if k.Outdoor then
			return
		end
	else
		span(b, "Countertop", -ROOM_HALF_X, ROOM_HALF_X, COUNTER_TOP_Y - 6, COUNTER_TOP_Y, cabFront - 6, ROOM_Z_BACK, k.Counter, k.CounterMat, shadowless)
	end
	span(b, "Backsplash", -ROOM_HALF_X, ROOM_HALF_X, COUNTER_TOP_Y, COUNTER_TOP_Y + 70, ROOM_Z_BACK - 1, ROOM_Z_BACK, k.Tile, k.TileMat, noCollide())

	-- Up the wall, leaving a gap over the sink area for each room's centrepiece.
	local upperY0, upperY1 = COUNTER_TOP_Y + 120, COUNTER_TOP_Y + 270
	for _, seg in { { -ROOM_HALF_X, -220 }, { -40, ROOM_HALF_X } } do
		local w = seg[2] - seg[1]
		if bench == "Steel" then
			-- Open steel shelving (pizza pans, tins, oil) under a stainless extractor hood.
			local steel = Color3.fromRGB(196, 200, 206)
			for level, y in { upperY0 + 10, upperY0 + 90 } do
				span(b, "WallShelf", seg[1], seg[2], y - 3, y, ROOM_Z_BACK - 28, ROOM_Z_BACK, steel, Enum.Material.Metal, shadowless)
				for x = seg[1] + 30, seg[2] - 30, 60 do
					span(b, "ShelfBracket", x - 1.5, x + 1.5, y - 16, y - 3, ROOM_Z_BACK - 24, ROOM_Z_BACK, Color3.fromRGB(150, 155, 162), Enum.Material.Metal, noCollide())
				end
				local n = math.floor(w / 34)
				for i = 0, n - 1 do
					local x = seg[1] + w * (i + 0.5) / n
					local kind = (i + level) % 4
					if kind == 0 then
						local pan = cyl(b, "PizzaPan", 2, 30, x, y + 15, ROOM_Z_BACK - 8, Color3.fromRGB(150, 155, 162), Enum.Material.Metal, noCollide())
						pan.CFrame = footprint(b.origin, x, y + 15, ROOM_Z_BACK - 8) * CFrame.Angles(0, math.rad(90), 0)
					elseif kind == 1 then
						cyl(b, "TomatoTin", 18, 14, x, y + 9, ROOM_Z_BACK - 14, Color3.fromRGB(210, 50, 40), Enum.Material.Metal, noCollide())
					elseif kind == 2 then
						cyl(b, "OilBottle", 26, 9, x, y + 13, ROOM_Z_BACK - 14, Color3.fromRGB(215, 190, 70), Enum.Material.Glass, { CanCollide = false, CastShadow = false, Transparency = 0.2 })
					else
						cyl(b, "DoughTub", 14, 20, x, y + 7, ROOM_Z_BACK - 14, Color3.fromRGB(245, 245, 240), nil, noCollide())
					end
				end
			end
			span(b, "Hood", seg[1], seg[2], upperY1 - 20, upperY1 + 20, ROOM_Z_BACK - 70, ROOM_Z_BACK, steel, Enum.Material.Metal, shadowless)
			span(b, "HoodLip", seg[1], seg[2], upperY1 - 26, upperY1 - 20, ROOM_Z_BACK - 70, ROOM_Z_BACK - 64, Color3.fromRGB(150, 155, 162), Enum.Material.Metal, noCollide())
			span(b, "HoodDuct", seg[1] + w / 2 - 30, seg[1] + w / 2 + 30, upperY1 + 20, KITCHEN_FLOOR_Y + ROOM_HEIGHT, ROOM_Z_BACK - 50, ROOM_Z_BACK, steel, Enum.Material.Metal, shadowless)
		elseif bench == "Stone" then
			-- Oak plate racks holding pewter plates and tankards.
			local oak = Color3.fromRGB(92, 58, 38)
			span(b, "RackBack", seg[1] + 10, seg[2] - 10, upperY0, upperY1, ROOM_Z_BACK - 3, ROOM_Z_BACK, oak, Enum.Material.WoodPlanks, shadowless)
			for level, y in { upperY0 + 8, upperY0 + 82 } do
				span(b, "RackShelf", seg[1] + 11, seg[2] - 11, y - 5, y, ROOM_Z_BACK - 22, ROOM_Z_BACK, oak, Enum.Material.Wood, shadowless)
				span(b, "RackRail", seg[1] + 11, seg[2] - 11, y + 20, y + 23, ROOM_Z_BACK - 22, ROOM_Z_BACK - 19, oak, Enum.Material.Wood, noCollide())
				local n = math.floor(w / 36)
				for i = 0, n - 1 do
					local x = seg[1] + 20 + (w - 40) * (i + 0.5) / n
					if (i + level) % 3 == 0 then
						cyl(b, "Tankard", 20, 14, x, y + 10, ROOM_Z_BACK - 12, Color3.fromRGB(150, 152, 158), Enum.Material.Metal, noCollide())
					else
						local plate = cyl(b, "PewterPlate", 2, 30, x, y + 16, ROOM_Z_BACK - 8, Color3.fromRGB(165, 168, 174), Enum.Material.Metal, noCollide())
						plate.CFrame = footprint(b.origin, x, y + 16, ROOM_Z_BACK - 8) * CFrame.Angles(math.rad(8), math.rad(90), 0)
					end
				end
			end
			span(b, "RackTop", seg[1] + 6, seg[2] - 6, upperY1, upperY1 + 8, ROOM_Z_BACK - 26, ROOM_Z_BACK, oak, Enum.Material.Wood, shadowless)
		else
			span(b, "UpperCabinets", seg[1], seg[2], upperY0, upperY1, ROOM_Z_BACK - 40, ROOM_Z_BACK, k.Cabinet, k.CabMat, shadowless)
			local n = math.floor(w / 70)
			for i = 0, n - 1 do
				local cx = seg[1] + w / n * (i + 0.5)
				box(b, "UpperDoor", Vector3.new(w / n - 5, upperY1 - upperY0 - 8, 1.2), cx, (upperY0 + upperY1) / 2, ROOM_Z_BACK - 40.6, k.CabinetDoor, k.CabMat, noCollide())
				box(b, "UpperHandle", Vector3.new(2.5, 16, 2.5), cx + (w / n / 2 - 10), upperY0 + 16, ROOM_Z_BACK - 42, k.Handle, k.HandleMat, noCollide())
			end
		end
	end
end

-- A table (top + 4 legs) with chairs either side, in room space.
local function diningSet(b: Builder, tz: number, halfW: number, color: Color3, material: Enum.Material, chairsPerSide: number, chairColor: Color3?)
	local fy = KITCHEN_FLOOR_Y
	local tyTop = fy + 150
	span(b, "TableTop", -halfW, halfW, tyTop - 8, tyTop, tz - 90, tz + 90, color, material)
	for _, lx in { -halfW + 15, halfW - 15 } do
		for _, lz in { tz - 75, tz + 75 } do
			span(b, "TableLeg", lx - 6, lx + 6, fy, tyTop - 8, lz - 6, lz + 6, color, material)
		end
	end
	local cc = chairColor or color
	for i = 1, chairsPerSide do
		local cx = -halfW + (2 * halfW) * (i - 0.5) / chairsPerSide
		for _, dir in { -1, 1 } do
			local cz = tz + dir * 125
			span(b, "ChairSeat", cx - 40, cx + 40, fy + 90, fy + 98, cz - 35, cz + 35, cc, material)
			span(b, "ChairBack", cx - 40, cx + 40, fy + 98, fy + 200, cz + dir * 30, cz + dir * 36, cc, material)
			for _, lx in { cx - 34, cx + 34 } do
				for _, lz in { cz - 29, cz + 29 } do
					span(b, "ChairLeg", lx - 4, lx + 4, fy, fy + 90, lz - 4, lz + 4, cc, material)
				end
			end
		end
	end
	return tyTop
end

-- Level 1: window over the sink, kettle, fruit, fridge, family table.
local function familyProps(b: Builder, k: RoomStyle)
	local fy = KITCHEN_FLOOR_Y
	local lamp = cyl(b, "CeilingLamp", 4, 70, 0, fy + ROOM_HEIGHT - 4, -200, k.Lamp, Enum.Material.Neon, noCollide())
	lamp.CastShadow = false

	local wx0, wx1 = -210, -50
	local wy0, wy1 = COUNTER_TOP_Y + 90, COUNTER_TOP_Y + 260
	local sky = span(b, "WindowSky", wx0, wx1, wy0, wy1, ROOM_Z_BACK - 0.5, ROOM_Z_BACK + 0.5, Color3.fromRGB(190, 225, 255), Enum.Material.Neon, noCollide())
	sky.CastShadow = false
	span(b, "WindowSill", wx0 - 8, wx1 + 8, wy0 - 6, wy0, ROOM_Z_BACK - 10, ROOM_Z_BACK, Color3.new(1, 1, 1), nil, noCollide())
	for _, x in { wx0, (wx0 + wx1) / 2, wx1 } do
		span(b, "WindowBar", x - 3, x + 3, wy0 + 0.5, wy1 - 0.5, ROOM_Z_BACK - 3, ROOM_Z_BACK, Color3.new(1, 1, 1), nil, noCollide())
	end
	for _, y in { wy0, (wy0 + wy1) / 2, wy1 } do
		span(b, "WindowBar", wx0 + 0.5, wx1 - 0.5, y - 3, y + 3, ROOM_Z_BACK - 3, ROOM_Z_BACK, Color3.new(1, 1, 1), nil, noCollide())
	end

	local sinkX = (wx0 + wx1) / 2
	span(b, "Sink", sinkX - 60, sinkX + 60, COUNTER_TOP_Y - 0.4, COUNTER_TOP_Y + 0.2, -10, 50, K.Steel, Enum.Material.Metal, noCollide())
	span(b, "SinkBasin", sinkX - 54, sinkX + 54, COUNTER_TOP_Y - 0.2, COUNTER_TOP_Y + 0.4, -4, 44, Color3.fromRGB(120, 125, 132), Enum.Material.Metal, noCollide())
	cyl(b, "FaucetBase", 6, 10, sinkX, COUNTER_TOP_Y + 3, 60, K.Steel, Enum.Material.Metal, noCollide())
	cyl(b, "FaucetPipe", 60, 5, sinkX, COUNTER_TOP_Y + 33, 60, K.Steel, Enum.Material.Metal, noCollide())
	box(b, "FaucetSpout", Vector3.new(5, 5, 40), sinkX, COUNTER_TOP_Y + 62, 42, K.Steel, Enum.Material.Metal, noCollide())
	cyl(b, "SoapBottle", 40, 16, sinkX + 90, COUNTER_TOP_Y + 20, 40, Color3.fromRGB(80, 200, 120), Enum.Material.Glass, { CanCollide = false, Transparency = 0.15 })
	cyl(b, "SoapCap", 8, 9, sinkX + 90, COUNTER_TOP_Y + 44, 40, Color3.new(1, 1, 1), nil, noCollide())

	cyl(b, "Kettle", 40, 34, 230, COUNTER_TOP_Y + 20, 30, K.Steel, Enum.Material.Metal, noCollide())
	box(b, "KettleHandle", Vector3.new(26, 5, 5), 230, COUNTER_TOP_Y + 44, 30, Color3.fromRGB(40, 40, 44), nil, noCollide())
	cyl(b, "FruitBowl", 14, 60, 330, COUNTER_TOP_Y + 7, 20, Color3.fromRGB(230, 120, 80), nil, noCollide())
	for i, c in { Color3.fromRGB(230, 50, 50), Color3.fromRGB(255, 200, 40), Color3.fromRGB(120, 200, 60) } do
		local ball = box(b, "Fruit", Vector3.new(18, 18, 18), 318 + i * 7, COUNTER_TOP_Y + 20, 14 + (i % 2) * 10, c, nil, noCollide())
		ball.Shape = Enum.PartType.Ball
	end

	span(b, "Fridge", 300, ROOM_HALF_X, fy, fy + 380, -260, -120, Color3.fromRGB(235, 238, 242), Enum.Material.SmoothPlastic)
	box(b, "FridgeHandle", Vector3.new(3, 90, 3), 297, fy + 230, -150, K.Handle, Enum.Material.Metal, noCollide())
	box(b, "FridgeHandle", Vector3.new(3, 60, 3), 297, fy + 110, -150, K.Handle, Enum.Material.Metal, noCollide())
	box(b, "FridgeSeam", Vector3.new(1, 2, 139.6), 299.8, fy + 170, -190, Color3.fromRGB(180, 185, 190), nil, noCollide())

	local tz = -330
	local tyTop = diningSet(b, tz, 150, K.Wood, Enum.Material.Wood, 2)
	for i = 0, 2 do
		cyl(b, "TablePlate", 2, 60, -80 + i * 80, tyTop + 1, tz, Color3.new(1, 1, 1), nil, noCollide())
	end
end

-- Level 2: a pizzeria. Brick pizza oven with a glowing mouth, a neon PIZZA sign over the counter,
-- stacks of pizza boxes, red-and-white checked tables and hanging lamps.
local function pizzeriaProps(b: Builder, k: RoomStyle)
	local fy = KITCHEN_FLOOR_Y
	local brick = Color3.fromRGB(150, 70, 52)
	local red = Color3.fromRGB(205, 45, 40)
	local cream = Color3.fromRGB(250, 244, 230)

	if not k.Outdoor then
		-- Neon sign in the gap over the counter.
		span(b, "SignBack", -214, -46, COUNTER_TOP_Y + 110, COUNTER_TOP_Y + 240, ROOM_Z_BACK - 3, ROOM_Z_BACK, Color3.fromRGB(30, 26, 26), nil, noCollide())
		roomSign(b, "PIZZA", Vector3.new(150, 70, 2), -130, COUNTER_TOP_Y + 175, ROOM_Z_BACK - 4, Color3.fromRGB(30, 26, 26), Color3.fromRGB(255, 120, 70), Enum.NormalId.Back)
		for _, y in { COUNTER_TOP_Y + 132, COUNTER_TOP_Y + 218 } do
			span(b, "NeonStrip", -200, -60, y - 1.5, y + 1.5, ROOM_Z_BACK - 6, ROOM_Z_BACK - 4, Color3.fromRGB(255, 90, 60), Enum.Material.Neon, noCollide())
		end
	end

	-- Brick pizza oven on the right: a stone plinth and brick base, a barrel-vaulted chamber (a
	-- cylinder along Z), a flat front with an arched glowing mouth that lines up with it, a firewood
	-- alcove below, and a chimney. The mouth faces -Z, toward the picnic tables where the chef works.
	local ox, oz = 250, -170
	local stone = Color3.fromRGB(196, 186, 172)
	span(b, "OvenPlinth", ox - 97, ox + 97, fy, fy + 8, oz - 87, oz + 87, Color3.fromRGB(150, 144, 136), Enum.Material.Cobblestone)
	span(b, "OvenBase", ox - 92, ox + 92, fy + 8, fy + 100, oz - 82, oz + 82, brick, Enum.Material.Brick)
	span(b, "OvenLedge", ox - 62, ox + 62, fy + 100, fy + 106, oz - 98, oz - 82, stone, Enum.Material.Concrete)
	local vault = box(b, "OvenVault", Vector3.new(160, 170, 170), ox, fy + 100, oz, brick, Enum.Material.Brick)
	vault.Shape = Enum.PartType.Cylinder
	vault.CFrame = footprint(b.origin, ox, fy + 100, oz) * CFrame.Angles(0, math.rad(90), 0)
	for _, dz in { -55, -5, 45 } do
		local band = box(b, "OvenBand", Vector3.new(6, 176, 176), ox, fy + 100, oz + dz, stone, Enum.Material.Concrete, noCollide())
		band.Shape = Enum.PartType.Cylinder
		band.CFrame = footprint(b.origin, ox, fy + 100, oz + dz) * CFrame.Angles(0, math.rad(90), 0)
	end
	-- Chimney rising out of the back of the vault.
	span(b, "OvenChimney", ox - 15, ox + 15, fy + 175, fy + 300, oz + 20, oz + 50, Color3.fromRGB(120, 58, 44), Enum.Material.Brick)
	span(b, "ChimneyCollar", ox - 20, ox + 20, fy + 290, fy + 300, oz + 15, oz + 55, stone, Enum.Material.Concrete)
	-- The mouth, drawn on the vault's flat front (z = oz - 80): a dark stone frame, then the glowing
	-- opening: a rectangle with a half-round top.
	local mouthZ = oz - 80
	span(b, "MouthFrame", ox - 44, ox + 44, fy + 100, fy + 142, mouthZ - 0.6, mouthZ - 0.3, Color3.fromRGB(70, 60, 54), Enum.Material.Slate, noCollide())
	local frameArch = box(b, "MouthFrameArch", Vector3.new(0.3, 88, 88), ox, fy + 142, mouthZ - 0.45, Color3.fromRGB(70, 60, 54), Enum.Material.Slate, noCollide())
	frameArch.Shape = Enum.PartType.Cylinder
	frameArch.CFrame = footprint(b.origin, ox, fy + 142, mouthZ - 0.45) * CFrame.Angles(0, math.rad(90), 0)
	span(b, "OvenMouth", ox - 36, ox + 36, fy + 104, fy + 142, mouthZ - 1.2, mouthZ - 0.9, Color3.fromRGB(255, 130, 40), Enum.Material.Neon, noCollide())
	local arch = box(b, "OvenArch", Vector3.new(0.3, 72, 72), ox, fy + 142, mouthZ - 1.05, Color3.fromRGB(255, 150, 60), Enum.Material.Neon, noCollide())
	arch.Shape = Enum.PartType.Cylinder
	arch.CFrame = footprint(b.origin, ox, fy + 142, mouthZ - 1.05) * CFrame.Angles(0, math.rad(90), 0)
	-- Below the ledge, the firewood alcove with a stack of logs.
	span(b, "WoodAlcove", ox - 36, ox + 36, fy + 16, fy + 78, oz - 82.6, oz - 82.2, Color3.fromRGB(40, 32, 28), Enum.Material.Slate, noCollide())
	for row = 0, 2 do
		for i = 0, 3 - row do
			local lx = ox - 27 + row * 9 + i * 18
			local log = box(b, "Log", Vector3.new(14, 15, 15), lx, fy + 26 + row * 14, oz - 90, Color3.fromRGB(150, 104, 62), Enum.Material.Wood, noCollide())
			log.Shape = Enum.PartType.Cylinder
			log.CFrame = footprint(b.origin, lx, fy + 26 + row * 14, oz - 90) * CFrame.Angles(0, math.rad(90), 0)
		end
	end
	local glow = Instance.new("PointLight")
	glow.Color = Color3.fromRGB(255, 140, 60)
	glow.Brightness = 2
	glow.Range = 60
	glow.Parent = b.model:FindFirstChild("OvenMouth") or b.model
	-- A pizza peel leaning on the side of the oven: the round blade rests on the floor, flat against
	-- the brick, and the handle's tip touches the lip. Built along a tilted axis so nothing pokes
	-- into the oven.
	local lean = math.rad(17)
	local peelZ = oz - 30
	local peelX0 = ox - 92 - 2.6 - 120 * math.sin(lean)
	local function onPeel(sAlong: number): CFrame
		return footprint(b.origin, peelX0 + sAlong * math.sin(lean), fy + sAlong * math.cos(lean), peelZ) * CFrame.Angles(0, 0, -lean)
	end
	local peelWood = Color3.fromRGB(185, 135, 85)
	local blade = cyl(b, "PeelHead", 2.4, 44, 0, 0, 0, peelWood, Enum.Material.Wood, noCollide())
	blade.CFrame = onPeel(24)
	box(b, "PeelNeck", Vector3.new(2.4, 26, 22), 0, 0, 0, peelWood, Enum.Material.Wood, noCollide()).CFrame = onPeel(44)
	box(b, "PeelHandle", Vector3.new(5, 66, 5), 0, 0, 0, Color3.fromRGB(165, 115, 70), Enum.Material.Wood, noCollide()).CFrame = onPeel(86)
	box(b, "PeelGrip", Vector3.new(5.6, 10, 5.6), 0, 0, 0, Color3.fromRGB(120, 60, 40), Enum.Material.Wood, noCollide()).CFrame = onPeel(113)

	-- Two square tables with red-and-white checked cloths and a pizza on each, plus stools.
	for _, tx in { -150, 150 } do
		local tz = -400
		local top = fy + 150
		span(b, "TableLeg", tx - 5, tx + 5, fy, top - 6, tz - 5, tz + 5, Color3.fromRGB(40, 40, 44), Enum.Material.Metal)
		cyl(b, "TableFoot", 4, 60, tx, fy + 2, tz, Color3.fromRGB(40, 40, 44), Enum.Material.Metal)
		span(b, "TableTop", tx - 66, tx + 66, top - 6, top, tz - 66, tz + 66, Color3.fromRGB(120, 80, 50), Enum.Material.Wood)
		local n, cell = 5, 26
		for i = 0, n - 1 do
			for j = 0, n - 1 do
				local cx = tx - cell * n / 2 + cell * (i + 0.5)
				local cz = tz - cell * n / 2 + cell * (j + 0.5)
				box(b, "Cloth", Vector3.new(cell, 0.4, cell), cx, top + 0.2, cz, if (i + j) % 2 == 0 then red else cream, Enum.Material.Fabric, noCollide())
			end
		end
		cyl(b, "Pizza", 3, 70, tx, top + 1.9, tz, Color3.fromRGB(230, 170, 80), Enum.Material.Sand, noCollide())
		cyl(b, "PizzaSauce", 3.2, 60, tx, top + 2, tz, Color3.fromRGB(200, 60, 35), nil, noCollide())
		for i = 0, 6 do
			local a = i / 7 * math.pi * 2
			cyl(b, "Pepperoni", 3.4, 11, tx + math.cos(a) * 18, top + 2.1, tz + math.sin(a) * 18, Color3.fromRGB(160, 30, 30), nil, noCollide())
		end
		for _, dz in { -95, 95 } do
			cyl(b, "StoolSeat", 8, 44, tx, fy + 90, tz + dz, red)
			span(b, "StoolPost", tx - 3, tx + 3, fy, fy + 86, tz + dz - 3, tz + dz + 3, Color3.fromRGB(40, 40, 44), Enum.Material.Metal)
		end
	end

	-- Wooden ceiling beams and strings of warm party lights across the room.
	for z = ROOM_Z_FRONT + 60, ROOM_Z_BACK - 40, 110 do
		if k.Outdoor then
			break
		end
		span(b, "Beam", -ROOM_HALF_X, ROOM_HALF_X, fy + ROOM_HEIGHT - 16, fy + ROOM_HEIGHT, z - 8, z + 8, Color3.fromRGB(110, 72, 44), Enum.Material.Wood, noCollide())
	end
	local bulbColors = { Color3.fromRGB(255, 200, 90), Color3.fromRGB(255, 120, 90), Color3.fromRGB(120, 220, 140), Color3.fromRGB(255, 240, 200) }
	for li, z in { -440, -300, -160 } do
		local n = 18
		for i = 0, n do
			local u = i / n
			local x = -ROOM_HALF_X + 20 + u * (ROOM_HALF_X * 2 - 40)
			local y = fy + 420 - math.sin(u * math.pi) * 60
			local bulb = box(b, "PartyBulb", Vector3.new(7, 9, 7), x, y, z, bulbColors[(i + li) % #bulbColors + 1], Enum.Material.Neon, noCollide())
			bulb.Shape = Enum.PartType.Ball
			if i &lt; n then
				local nx = -ROOM_HALF_X + 20 + (i + 1) / n * (ROOM_HALF_X * 2 - 40)
				local ny = fy + 420 - math.sin((i + 1) / n * math.pi) * 60
				local len = math.sqrt((nx - x) ^ 2 + (ny - y) ^ 2)
				local wire = box(b, "LightWire", Vector3.new(len, 0.8, 0.8), (x + nx) / 2, (y + ny) / 2 + 5, z, Color3.fromRGB(40, 40, 40), nil, noCollide())
				wire.CFrame = footprint(b.origin, (x + nx) / 2, (y + ny) / 2 + 5, z) * CFrame.Angles(0, 0, math.atan2(ny - y, nx - x))
			end
		end
	end
	if not k.Outdoor then
		-- The front wall: a chalkboard menu, a neon OPEN sign and a glass door.
		local frontZ = ROOM_Z_FRONT + 3
		span(b, "MenuFrame", -150, 150, fy + 220, fy + 400, ROOM_Z_FRONT, ROOM_Z_FRONT + 2, Color3.fromRGB(120, 80, 50), Enum.Material.Wood, noCollide())
		roomSign(b, "MENU\nMargherita  •  Pepperoni\nFour Cheese  •  Hawaiian", Vector3.new(284, 164, 2), 0, fy + 310, frontZ, Color3.fromRGB(35, 40, 38), Color3.fromRGB(245, 240, 225), Enum.NormalId.Front, Enum.Material.Slate)
		roomSign(b, "OPEN", Vector3.new(110, 44, 2), 260, fy + 330, frontZ, Color3.fromRGB(30, 26, 26), Color3.fromRGB(255, 80, 120), Enum.NormalId.Front)
		span(b, "DoorFrame", -320, -200, fy, fy + 240, ROOM_Z_FRONT, ROOM_Z_FRONT + 3, Color3.fromRGB(120, 80, 50), Enum.Material.Wood, noCollide())
		local glass = span(b, "DoorGlass", -310, -210, fy + 10, fy + 230, ROOM_Z_FRONT + 3, ROOM_Z_FRONT + 4, Color3.fromRGB(190, 225, 255), Enum.Material.Neon, noCollide())
		glass.Transparency = 0.3
		-- Shelves of ingredients on the left wall: flour sacks, tomato tins, jars of basil.
		local sx = -ROOM_HALF_X + 3
		for level, y in { fy + 170, fy + 250 } do
			span(b, "Shelf", sx, sx + 40, y - 4, y, -460, -300, Color3.fromRGB(140, 95, 60), Enum.Material.Wood)
			for k = 0, 5 do
				local z = -450 + k * 26
				if (k + level) % 3 == 0 then
					local sack = box(b, "FlourSack", Vector3.new(26, 34, 20), sx + 20, y + 17, z, Color3.fromRGB(240, 232, 215), Enum.Material.Fabric, noCollide())
					sack.Shape = Enum.PartType.Ball
				elseif (k + level) % 3 == 1 then
					cyl(b, "TomatoTin", 22, 16, sx + 20, y + 11, z, Color3.fromRGB(210, 50, 40), Enum.Material.Metal, noCollide())
				else
					cyl(b, "BasilJar", 20, 14, sx + 20, y + 10, z, Color3.fromRGB(90, 170, 80), Enum.Material.Glass, noCollide())
				end
			end
		end
		-- Potted basil by the tables.
		for _, px in { -250, 250 } do
			cyl(b, "Pot", 30, 36, px, fy + 15, -470, Color3.fromRGB(190, 100, 60))
			for k = 0, 4 do
				local leaf = box(b, "Basil", Vector3.new(22, 22, 22), px + math.cos(k * 1.3) * 10, fy + 38 + (k % 2) * 8, -470 + math.sin(k * 1.3) * 10, Color3.fromRGB(80, 160, 70), nil, noCollide())
				leaf.Shape = Enum.PartType.Ball
			end
		end

		-- Hanging pendant lamps.
		for _, lx in { -200, 0, 200 } do
			span(b, "LampCord", lx - 0.8, lx + 0.8, fy + 330, fy + ROOM_HEIGHT, -260 - 0.8, -260 + 0.8, Color3.fromRGB(30, 30, 30), nil, noCollide())
			cyl(b, "LampShade", 26, 60, lx, fy + 330, -260, Color3.fromRGB(40, 40, 44), Enum.Material.Metal, noCollide())
			local bulb = cyl(b, "LampBulb", 2, 40, lx, fy + 316, -260, k.Lamp, Enum.Material.Neon, noCollide())
			bulb.CastShadow = false
		end
	else
		-- String lights hang from tall wooden poles at both ends of the lines.
		for _, z in { -440, -300, -160 } do
			for _, sx in { -1, 1 } do
				cyl(b, "LightPole", 440, 8, sx * (ROOM_HALF_X - 20), fy + 220, z, Color3.fromRGB(110, 72, 44), Enum.Material.Wood, noCollide())
			end
		end
	end
end

-- Level 3: a castle banquet hall. Stone pillars, red banners with gold trim, a red carpet, a long
-- banquet table with candelabras and goblets, a fireplace, a stained-glass window and chandeliers.
local function castleProps(b: Builder, k: RoomStyle)
	local fy = KITCHEN_FLOOR_Y
	local gold = Color3.fromRGB(230, 190, 90)
	local red = Color3.fromRGB(150, 25, 35)
	local stone = Color3.fromRGB(170, 164, 156)

	-- Red carpet from the door to the far wall.
	span(b, "Carpet", -70, 70, fy, fy + 0.4, ROOM_Z_FRONT, -125, red, Enum.Material.Fabric, noCollide())
	for _, x in { -72, 72 } do
		span(b, "CarpetTrim", x - 3, x + 3, fy, fy + 0.5, ROOM_Z_FRONT, -125, gold, Enum.Material.Fabric, noCollide())
	end

	-- Stained-glass window in the gap over the counter.
	local wx0, wx1 = -210, -50
	local wy0, wy1 = COUNTER_TOP_Y + 90, COUNTER_TOP_Y + 260
	local colors = { Color3.fromRGB(80, 120, 230), Color3.fromRGB(220, 60, 70), Color3.fromRGB(250, 200, 70), Color3.fromRGB(80, 190, 120) }
	local cols, rows = 4, 5
	for i = 0, cols - 1 do
		for j = 0, rows - 1 do
			local x0 = wx0 + (wx1 - wx0) * i / cols
			local y0 = wy0 + (wy1 - wy0) * j / rows
			local pane = span(b, "StainedGlass", x0, x0 + (wx1 - wx0) / cols, y0, y0 + (wy1 - wy0) / rows, ROOM_Z_BACK - 0.5, ROOM_Z_BACK + 0.5, colors[(i + j) % #colors + 1], Enum.Material.Neon, noCollide())
			pane.Transparency = 0.25
			pane.CastShadow = false
		end
	end
	for _, x in { wx0, wx0 + 40, wx0 + 80, wx0 + 120, wx1 } do
		span(b, "Leading", x - 2, x + 2, wy0, wy1, ROOM_Z_BACK - 2.5, ROOM_Z_BACK - 0.5, Color3.fromRGB(40, 36, 34), nil, noCollide())
	end
	span(b, "WindowArch", wx0 - 10, wx1 + 10, wy1, wy1 + 16, ROOM_Z_BACK - 6, ROOM_Z_BACK, stone, Enum.Material.Cobblestone, noCollide())

	-- Pillars along both side walls, each with a banner between. The hall is long, so there are many;
	-- the fireplace takes the right wall around z -240.
	local pillarZs = {}
	for z = ROOM_Z_FRONT + 90, -100, 150 do
		table.insert(pillarZs, z)
	end
	local function atFireplace(z: number): boolean
		return z &gt; -350 and z &lt; -130
	end
	for _, side in { -1, 1 } do
		for _, z in pillarZs do
			if side == 1 and atFireplace(z) then
				continue
			end
			local x = side * (ROOM_HALF_X - 30)
			span(b, "Pillar", x - 24, x + 24, fy, fy + ROOM_HEIGHT, z - 24, z + 24, stone, Enum.Material.Cobblestone)
			span(b, "PillarBase", x - 32, x + 32, fy, fy + 22, z - 32, z + 32, Color3.fromRGB(130, 124, 116), Enum.Material.Slate)
			span(b, "PillarCap", x - 32, x + 32, fy + ROOM_HEIGHT - 30, fy + ROOM_HEIGHT, z - 32, z + 32, Color3.fromRGB(130, 124, 116), Enum.Material.Slate)
			local bz = z + 75
			local bx = side * (ROOM_HALF_X - 3)
			if bz &lt; ROOM_Z_BACK - 40 and not (side == 1 and atFireplace(bz)) then
				span(b, "Banner", bx - 1, bx + 1, fy + 420, fy + 720, bz - 36, bz + 36, red, Enum.Material.Fabric, noCollide())
				span(b, "BannerTrim", bx - 1.4, bx + 1.4, fy + 414, fy + 422, bz - 38, bz + 38, gold, Enum.Material.Metal, noCollide())
				span(b, "BannerRod", bx - 3, bx + 3, fy + 720, fy + 728, bz - 44, bz + 44, gold, Enum.Material.Metal, noCollide())
				span(b, "BannerCrest", bx - 1.6, bx + 1.6, fy + 540, fy + 590, bz - 16, bz + 16, gold, Enum.Material.Metal, noCollide())
			end
		end
	end

	-- Ribbed vault: a stone arch across the hall above every pillar pair, springing from the wall tops
	-- and meeting the ceiling in the middle.
	do
		local rise = 190
		local springY = fy + ROOM_HEIGHT - rise
		local n = 16
		for _, z in pillarZs do
			local px, py = ROOM_HALF_X - 30, springY
			for i = 1, n do
				local th = i / n * math.pi
				local nx, ny = math.cos(th) * (ROOM_HALF_X - 30), springY + math.sin(th) * rise
				local len = math.sqrt((nx - px) ^ 2 + (ny - py) ^ 2) + 2
				local seg = box(b, "VaultRib", Vector3.new(len, 20, 26), (px + nx) / 2, (py + ny) / 2, z, Color3.fromRGB(150, 144, 136), Enum.Material.Cobblestone, noCollide())
				seg.CFrame = footprint(b.origin, (px + nx) / 2, (py + ny) / 2, z) * CFrame.Angles(0, 0, math.atan2(ny - py, nx - px))
				px, py = nx, ny
			end
		end
	end

	-- Tall stained-glass windows in the wall bays between the pillars, with a stone frame and a pointed top.
	do
		local glass = { Color3.fromRGB(80, 120, 230), Color3.fromRGB(220, 60, 70), Color3.fromRGB(250, 200, 70), Color3.fromRGB(80, 190, 120) }
		for _, side in { -1, 1 } do
			for zi, z in pillarZs do
				local wz = z + 75
				if wz &gt; ROOM_Z_BACK - 70 or (side == 1 and atFireplace(wz)) then
					continue
				end
				local wx = side * (ROOM_HALF_X - 2)
				local w, y0, y1 = 70, fy + 250, fy + 600
				span(b, "WindowFrame", wx - 3, wx + 1, y0 - 10, y1 + 10, wz - w / 2 - 8, wz + w / 2 + 8, Color3.fromRGB(120, 114, 106), Enum.Material.Slate, noCollide())
				for gi = 0, 2 do
					for gj = 0, 6 do
						local zz0 = wz - w / 2 + gi * w / 3
						local yy0 = y0 + gj * (y1 - y0) / 7
						local pane = span(b, "StainedGlass", wx - 1, wx + 1.5, yy0 + 1, yy0 + (y1 - y0) / 7 - 1, zz0 + 1, zz0 + w / 3 - 1, glass[(gi + gj + zi) % 4 + 1], Enum.Material.Neon, noCollide())
						pane.Transparency = 0.25
						pane.CastShadow = false
					end
				end
				-- pointed top: two slanted bars meeting above the window
				for _, s2 in { -1, 1 } do
					local bar = box(b, "WindowPoint", Vector3.new(4, 4, w / 2 + 14), wx, y1 + 22, wz + s2 * (w / 4 + 4), Color3.fromRGB(120, 114, 106), Enum.Material.Slate, noCollide())
					bar.CFrame = footprint(b.origin, wx, y1 + 22, wz + s2 * (w / 4 + 4)) * CFrame.Angles(s2 * math.rad(24), 0, 0)
				end
			end
		end
	end

	-- A gallery along each side wall: a stone walkway on corbels with a balustrade.
	for _, side in { -1, 1 } do
		local gx0, gx1 = side * (ROOM_HALF_X - 70), side * ROOM_HALF_X
		span(b, "GalleryFloor", gx0, gx1, fy + 330, fy + 346, ROOM_Z_FRONT + 40, ROOM_Z_BACK - 40, Color3.fromRGB(128, 122, 116), Enum.Material.Slate, noCollide())
		span(b, "GalleryRail", gx0 - side * 2, gx0 + side * 2, fy + 346, fy + 366, ROOM_Z_FRONT + 40, ROOM_Z_BACK - 40, Color3.fromRGB(150, 144, 136), Enum.Material.Cobblestone, noCollide())
		for z = ROOM_Z_FRONT + 60, ROOM_Z_BACK - 60, 40 do
			span(b, "Baluster", gx0 - side * 3, gx0 + side * 3, fy + 346, fy + 398, z - 4, z + 4, Color3.fromRGB(176, 170, 162), Enum.Material.Marble, noCollide())
		end
		span(b, "GalleryHandrail", gx0 - side * 4, gx0 + side * 4, fy + 398, fy + 408, ROOM_Z_FRONT + 40, ROOM_Z_BACK - 40, Color3.fromRGB(92, 58, 38), Enum.Material.Wood, noCollide())
		for z = ROOM_Z_FRONT + 90, ROOM_Z_BACK - 60, 150 do
			span(b, "Corbel", gx0 + side * 10, gx1, fy + 290, fy + 332, z - 14, z + 14, Color3.fromRGB(150, 144, 136), Enum.Material.Cobblestone, noCollide())
		end
	end

	-- Fireplace on the right, with a glowing fire.
	local fx = ROOM_HALF_X - 30
	span(b, "Hearth", fx - 30, ROOM_HALF_X, fy, fy + 200, -300, -180, stone, Enum.Material.Cobblestone)
	span(b, "FireBox", fx - 31, fx - 6, fy, fy + 110, -275, -205, Color3.fromRGB(30, 22, 18), Enum.Material.Slate)
	local fire = span(b, "Fire", fx - 26, fx - 16, fy, fy + 50, -262, -218, Color3.fromRGB(255, 140, 40), Enum.Material.Neon, noCollide())
	local fireLight = Instance.new("PointLight")
	fireLight.Color = Color3.fromRGB(255, 150, 70)
	fireLight.Brightness = 2
	fireLight.Range = 60
	fireLight.Parent = fire
	span(b, "Mantel", fx - 40, ROOM_HALF_X, fy + 200, fy + 212, -310, -170, Color3.fromRGB(92, 58, 38), Enum.Material.Wood)

	-- Long banquet table down the carpet (lengthwise, so the chairs never block the view from the
	-- door), with a gold runner, candelabras, platters and goblets. Chairs with tall red backs.
	local wood = Color3.fromRGB(92, 58, 38)
	local tz0, tz1, thx = -490, -230, 55
	local tyTop = fy + 150
	span(b, "TableTop", -thx, thx, tyTop - 8, tyTop, tz0, tz1, wood, Enum.Material.Wood)
	for _, lx in { -thx + 10, thx - 10 } do
		for _, lz in { tz0 + 12, (tz0 + tz1) / 2, tz1 - 12 } do
			span(b, "TableLeg", lx - 6, lx + 6, fy, tyTop - 8, lz - 6, lz + 6, wood, Enum.Material.Wood)
		end
	end
	span(b, "Runner", -16, 16, tyTop, tyTop + 0.3, tz0 + 8, tz1 - 8, gold, Enum.Material.Fabric, noCollide())
	for i = 0, 4 do
		local cz = tz0 + 26 + i * 52
		for _, side in { -1, 1 } do
			local cx = side * (thx + 45)
			span(b, "ChairSeat", cx - 32, cx + 32, fy + 90, fy + 98, cz - 20, cz + 20, red, Enum.Material.Fabric)
			span(b, "ChairBack", cx + side * 28, cx + side * 34, fy + 98, fy + 210, cz - 20, cz + 20, wood, Enum.Material.Wood)
			span(b, "ChairCrest", cx + side * 27.6, cx + side * 28, fy + 170, fy + 200, cz - 10, cz + 10, gold, Enum.Material.Metal, noCollide())
			for _, lx in { cx - 27, cx + 27 } do
				for _, lz in { cz - 15, cz + 15 } do
					span(b, "ChairLeg", lx - 3, lx + 3, fy, fy + 90, lz - 3, lz + 3, wood, Enum.Material.Wood)
				end
			end
			cyl(b, "PlatterOnTable", 2, 34, side * 32, tyTop + 1, cz, gold, Enum.Material.Metal, noCollide())
			cyl(b, "GobletStem", 12, 3, side * 32, tyTop + 6, cz + 22, gold, Enum.Material.Metal, noCollide())
			cyl(b, "GobletCup", 10, 11, side * 32, tyTop + 17, cz + 22, gold, Enum.Material.Metal, noCollide())
		end
	end
	for _, cz in { tz0 + 50, (tz0 + tz1) / 2, tz1 - 50 } do
		cyl(b, "CandelabraBase", 4, 20, 0, tyTop + 2, cz, gold, Enum.Material.Metal, noCollide())
		span(b, "CandelabraStem", -2, 2, tyTop, tyTop + 40, cz - 2, cz + 2, gold, Enum.Material.Metal, noCollide())
		span(b, "CandelabraArm", -2, 2, tyTop + 38, tyTop + 42, cz - 22, cz + 22, gold, Enum.Material.Metal, noCollide())
		for _, dz in { -20, 0, 20 } do
			cyl(b, "Candle", 18, 5, 0, tyTop + 51, cz + dz, Color3.fromRGB(250, 245, 230), nil, noCollide())
			local flame = box(b, "Flame", Vector3.new(3, 5, 3), 0, tyTop + 63, cz + dz, Color3.fromRGB(255, 190, 70), Enum.Material.Neon, noCollide())
			flame.Shape = Enum.PartType.Ball
		end
	end
	-- A throne at the head of the table.
	span(b, "ThroneSeat", -40, 40, fy, fy + 100, tz0 - 28, tz0 - 4, red, Enum.Material.Fabric)
	span(b, "ThroneBack", -44, 44, fy, fy + 260, tz0 - 30, tz0 - 22, gold, Enum.Material.Metal)
	for _, x in { -30, 0, 30 } do
		local spike = box(b, "ThroneSpike", Vector3.new(14, 14, 8), x, fy + 268, tz0 - 26, gold, Enum.Material.Metal, noCollide())
		spike.Shape = Enum.PartType.Ball
	end

	-- Wall torches on the pillars' room-facing sides, lighting the hall warmly.
	for _, side in { -1, 1 } do
		for _, z in pillarZs do
			if side == 1 and atFireplace(z) then
				continue
			end
			local x = side * (ROOM_HALF_X - 58)
			span(b, "TorchBracket", x - 3, x + 3, fy + 220, fy + 250, z - 3, z + 3, Color3.fromRGB(60, 50, 45), Enum.Material.Metal, noCollide())
			cyl(b, "TorchCup", 10, 14, x, fy + 254, z, Color3.fromRGB(60, 50, 45), Enum.Material.Metal, noCollide())
			local flame = box(b, "TorchFlame", Vector3.new(10, 18, 10), x, fy + 268, z, Color3.fromRGB(255, 160, 60), Enum.Material.Neon, noCollide())
			flame.Shape = Enum.PartType.Ball
			local light = Instance.new("PointLight")
			light.Color = Color3.fromRGB(255, 170, 90)
			light.Brightness = 1.2
			light.Range = 55
			light.Parent = flame
		end
	end
	-- Suits of armour guarding the front wall, and shields with crests.
	for _, ax in { -200, 200 } do
		local steel = Color3.fromRGB(175, 180, 188)
		span(b, "ArmourPlinth", ax - 30, ax + 30, fy, fy + 12, ROOM_Z_FRONT + 10, ROOM_Z_FRONT + 70, Color3.fromRGB(110, 104, 98), Enum.Material.Slate)
		for _, lx in { -9, 9 } do
			span(b, "ArmourLeg", ax + lx - 7, ax + lx + 7, fy + 12, fy + 92, ROOM_Z_FRONT + 33, ROOM_Z_FRONT + 47, steel, Enum.Material.Metal)
		end
		span(b, "ArmourBody", ax - 22, ax + 22, fy + 92, fy + 160, ROOM_Z_FRONT + 30, ROOM_Z_FRONT + 50, steel, Enum.Material.Metal)
		for _, lx in { -30, 30 } do
			span(b, "ArmourArm", ax + lx - 6, ax + lx + 6, fy + 100, fy + 158, ROOM_Z_FRONT + 34, ROOM_Z_FRONT + 46, steel, Enum.Material.Metal)
		end
		local helm = box(b, "ArmourHelm", Vector3.new(30, 34, 30), ax, fy + 178, ROOM_Z_FRONT + 40, steel, Enum.Material.Metal)
		helm.Shape = Enum.PartType.Ball
		span(b, "Visor", ax - 12, ax + 12, fy + 176, fy + 180, ROOM_Z_FRONT + 55, ROOM_Z_FRONT + 56, Color3.fromRGB(30, 30, 34), nil, noCollide())
		span(b, "Plume", ax - 3, ax + 3, fy + 194, fy + 222, ROOM_Z_FRONT + 36, ROOM_Z_FRONT + 44, red, Enum.Material.Fabric, noCollide())
		span(b, "Spear", ax + 40, ax + 44, fy + 12, fy + 250, ROOM_Z_FRONT + 38, ROOM_Z_FRONT + 42, Color3.fromRGB(120, 85, 55), Enum.Material.Wood, noCollide())
		cyl(b, "Shield", 4, 70, ax, fy + 300, ROOM_Z_FRONT + 3, red, Enum.Material.Metal, noCollide()).CFrame = footprint(b.origin, ax, fy + 300, ROOM_Z_FRONT + 3) * CFrame.Angles(0, math.rad(90), 0)
		cyl(b, "ShieldBoss", 5, 30, ax, fy + 300, ROOM_Z_FRONT + 4, gold, Enum.Material.Metal, noCollide()).CFrame = footprint(b.origin, ax, fy + 300, ROOM_Z_FRONT + 4) * CFrame.Angles(0, math.rad(90), 0)
	end
	-- A great tapestry on the front wall, and dark ceiling beams.
	span(b, "Tapestry", -110, 110, fy + 170, fy + 440, ROOM_Z_FRONT, ROOM_Z_FRONT + 2, Color3.fromRGB(40, 60, 130), Enum.Material.Fabric, noCollide())
	span(b, "TapestryTrim", -116, 116, fy + 164, fy + 172, ROOM_Z_FRONT, ROOM_Z_FRONT + 2.5, gold, Enum.Material.Metal, noCollide())
	span(b, "TapestryRod", -124, 124, fy + 440, fy + 448, ROOM_Z_FRONT, ROOM_Z_FRONT + 6, gold, Enum.Material.Metal, noCollide())
	span(b, "TapestryCrest", -40, 40, fy + 260, fy + 350, ROOM_Z_FRONT + 2, ROOM_Z_FRONT + 2.6, gold, Enum.Material.Metal, noCollide())
	for z = ROOM_Z_FRONT + 60, ROOM_Z_BACK - 40, 120 do
		span(b, "Beam", -ROOM_HALF_X, ROOM_HALF_X, fy + ROOM_HEIGHT - 20, fy + ROOM_HEIGHT, z - 10, z + 10, Color3.fromRGB(60, 40, 28), Enum.Material.Wood, noCollide())
	end

	-- Chandeliers down the length of the hall: a gold ring with glowing candles on a long chain.
	for cz = ROOM_Z_FRONT + 170, -120, 230 do
		local ringY = fy + ROOM_HEIGHT - 300
		span(b, "Chain", -1.2, 1.2, ringY, fy + ROOM_HEIGHT, cz - 1.2, cz + 1.2, gold, Enum.Material.Metal, noCollide())
		cyl(b, "ChandelierRing", 6, 150, 0, ringY, cz, gold, Enum.Material.Metal, noCollide())
		cyl(b, "ChandelierInner", 5, 80, 0, ringY - 8, cz, gold, Enum.Material.Metal, noCollide())
		for i = 0, 11 do
			local a = i / 12 * math.pi * 2
			local x, z = math.cos(a) * 71, cz + math.sin(a) * 71
			cyl(b, "ChCandle", 14, 5, x, ringY + 10, z, Color3.fromRGB(250, 245, 230), nil, noCollide())
			local flame = box(b, "ChFlame", Vector3.new(4, 6, 4), x, ringY + 20, z, Color3.fromRGB(255, 190, 70), Enum.Material.Neon, noCollide())
			flame.Shape = Enum.PartType.Ball
		end
		local glow = Instance.new("PointLight")
		glow.Color = Color3.fromRGB(255, 200, 130)
		glow.Brightness = 1.5
		glow.Range = 60
		glow.Parent = b.model:FindFirstChild("ChandelierRing") or b.model
	end
end

-- Level 2 scenery: the backyard around the patio. Lawn, a ring of hills and mountains that closes
-- the horizon all round, proper trees, the house, a picket fence, a BBQ, parasols and flower beds.
-- Everything here is out of reach (the patio is walled by invisible barriers) so it's non-colliding.
-- Arena slots are 2400 studs apart, so it all stays within +-1200 of the slot.
local function buildYard(b: Builder)
	local fy = KITCHEN_FLOOR_Y
	local scenery = noCollide()
	local function ball(name: string, sx: number, sy: number, sz: number, x: number, y: number, z: number, color: Color3, material: Enum.Material?)
		local p = box(b, name, Vector3.new(sx, sy, sz), x, y, z, color, material, scenery)
		p.Shape = Enum.PartType.Ball
		return p
	end
	local grass = Color3.fromRGB(104, 168, 76)
	local grassDark = Color3.fromRGB(84, 146, 64)
	local rng = Random.new(7)

	-- Lawn all round the patio, a step lower than it.
	span(b, "Lawn", -1000, 1000, fy - 10, fy - 0.6, -1000, 1000, grass, Enum.Material.Grass, scenery)
	span(b, "PatioEdgeFront", -424, 424, fy - 4, fy + 1.2, ROOM_Z_FRONT - 6, ROOM_Z_FRONT, Color3.fromRGB(150, 144, 136), Enum.Material.Cobblestone, scenery)
	for x = -ROOM_HALF_X + 60, ROOM_HALF_X - 1, 120 do
		span(b, "PaverJoint", x - 0.5, x + 0.5, fy, fy + 0.15, ROOM_Z_FRONT, -64, Color3.fromRGB(120, 114, 106), nil, scenery)
	end
	for z = ROOM_Z_FRONT + 60, -64, 120 do
		span(b, "PaverJoint", -ROOM_HALF_X, ROOM_HALF_X, fy, fy + 0.15, z - 0.5, z + 0.5, Color3.fromRGB(120, 114, 106), nil, scenery)
	end

	-- Mountains: a low-poly heightmap mesh in polar form around the yard (rolling green hills, then
	-- rock, then snow), drawn as triangles. Each triangle is two WedgeParts (the standard trick: split
	-- at the altitude from the vertex opposite the longest side). The ridge rises to 900-1500 studs,
	-- then falls away behind, so the view out is always mountain and sky, never a blank horizon.
	local MT_IN, MT_RIDGE, MT_OUT = 640, 1950, 2500
	local function smooth(a: number, b2: number, x: number): number
		local t = math.clamp((x - a) / (b2 - a), 0, 1)
		return t * t * (3 - 2 * t)
	end
	local function terrainH(x: number, z: number): number
		local r = math.sqrt(x * x + z * z)
		if r &lt; MT_IN then
			return 0
		end
		local th = math.atan2(z, x)
		local t = math.clamp((r - MT_IN) / (MT_RIDGE - MT_IN), 0, 1)
		local rolling = (math.noise(x * 0.0032, z * 0.0032, 1.3) * 0.5 + 0.5) * 150 * smooth(MT_IN, 900, r)
		local ridge = 1 - math.abs(math.noise(th * 2.3, r * 0.0016, 4.1)) * 1.6
		local amp = 900 + 600 * (math.noise(th * 1.4, 7.7, 2.2) * 0.5 + 0.5)
		local peaks = (t ^ 1.7) * amp * math.clamp(0.5 + 0.75 * ridge, 0.15, 1.3)
		local fall = 1 - smooth(MT_RIDGE, MT_OUT, r)
		return (rolling + peaks) * fall
	end
	local function addTriangle(p1: Vector3, p2: Vector3, p3: Vector3, color: Color3)
		local a, bb, c = worldPoint(b.origin, p1.X, p1.Y, p1.Z), worldPoint(b.origin, p2.X, p2.Y, p2.Z), worldPoint(b.origin, p3.X, p3.Y, p3.Z)
		local ab, ac, bc = bb - a, c - a, c - bb
		local abd, acd, bcd = ab:Dot(ab), ac:Dot(ac), bc:Dot(bc)
		if abd &gt; acd and abd &gt; bcd then
			c, a = a, c
		elseif acd &gt; bcd and acd &gt; abd then
			a, bb = bb, a
		end
		ab, ac, bc = bb - a, c - a, c - bb
		local rightV = ac:Cross(ab)
		if rightV.Magnitude &lt; 1e-3 or bc.Magnitude &lt; 1e-3 then
			return
		end
		rightV = rightV.Unit
		local upV = bc:Cross(rightV).Unit
		local back = bc.Unit
		local height = math.abs(ab:Dot(upV))
		local function wedge(size: Vector3, cf: CFrame)
			local w = Instance.new("WedgePart")
			w.Size = size
			w.CFrame = cf
			w.Color = color
			w.Material = Enum.Material.SmoothPlastic
			w.Anchored = true
			w.CanCollide = false
			w.CanTouch = false
			w.CanQuery = false
			w.CastShadow = false
			w.Parent = b.model
			b.count += 1
		end
		wedge(Vector3.new(0.05, height, math.abs(ab:Dot(back))), CFrame.fromMatrix((a + bb) / 2, rightV, upV, back))
		wedge(Vector3.new(0.05, height, math.abs(ac:Dot(back))), CFrame.fromMatrix((a + c) / 2, -rightV, upV, -back))
	end
	do
		local radii = { 640, 760, 900, 1060, 1250, 1460, 1700, 1950, 2200, 2500 }
		local steps = 36
		local baseY = fy - 0.3
		local grid = {}
		for i, r in radii do
			grid[i] = {}
			for j = 0, steps - 1 do
				-- jitter every vertex a little so the facets aren't a regular grid
				local th = (j + math.noise(i * 1.7, j * 2.3, 0.5) * 0.35) / steps * math.pi * 2
				local rr = r * (1 + (if i == 1 then 0 else math.noise(i * 3.1, j * 1.9, 9.2) * 0.07))
				local x, z = math.cos(th) * rr, math.sin(th) * rr
				grid[i][j] = Vector3.new(x, baseY + terrainH(x, z) + (if i == 1 then 0 else 0.3), z)
			end
		end
		local function shade(p: Vector3, q: Vector3, s: Vector3, jitterKey: number): Color3
			local top = (p.Y + q.Y + s.Y) / 3 - baseY
			local normal = (q - p):Cross(s - p)
			normal = if normal.Y &lt; 0 then -normal else normal
			local steepness = 1 - math.clamp(normal.Unit.Y, 0, 1) -- 0 flat, 1 vertical
			local light = 0.82 + math.noise(jitterKey * 0.37, 1.1, 3.3) * 0.25
			local base: Color3
			if top &lt; 130 then
				base = grassDark:Lerp(grass, math.clamp(top / 130, 0, 1))
			elseif top &gt; 700 and steepness &lt; 0.62 then
				base = Color3.fromRGB(240, 244, 250)
			elseif top &gt; 330 then
				base = Color3.fromRGB(128, 122, 116):Lerp(Color3.fromRGB(104, 112, 128), steepness)
			else
				base = grassDark:Lerp(Color3.fromRGB(128, 122, 116), math.clamp((top - 130) / 200 + steepness * 0.5, 0, 1))
			end
			return Color3.new(math.min(base.R * light, 1), math.min(base.G * light, 1), math.min(base.B * light, 1))
		end
		for i = 1, #radii - 1 do
			for j = 0, steps - 1 do
				local j2 = (j + 1) % steps
				local p00, p01, p10, p11 = grid[i][j], grid[i][j2], grid[i + 1][j], grid[i + 1][j2]
				local key = i * 97 + j
				if (i + j) % 2 == 0 then
					addTriangle(p00, p01, p11, shade(p00, p01, p11, key))
					addTriangle(p00, p11, p10, shade(p00, p11, p10, key + 1))
				else
					addTriangle(p00, p01, p10, shade(p00, p01, p10, key))
					addTriangle(p01, p11, p10, shade(p01, p11, p10, key + 1))
				end
			end
		end
	end

	-- Trees, in the same low-poly style as the lobby's: a hexagonal trunk (three crossed boxes) and a
	-- stack of turned, faceted canopy blocks that overlap the trunk top, so nothing floats. Pines are
	-- tiers of turned blocks that narrow to a tip.
	local trunkColor = Color3.fromRGB(120, 84, 56)
	local greens = { Color3.fromRGB(86, 150, 78), Color3.fromRGB(104, 168, 86), Color3.fromRGB(74, 136, 70) }
	local function rotBox(name: string, size: Vector3, x: number, y: number, z: number, color: Color3, rx: number, ry: number, rz: number)
		local p = box(b, name, size, x, y, z, color, Enum.Material.SmoothPlastic, scenery)
		p.CFrame = footprint(b.origin, x, y, z) * CFrame.Angles(rx, ry, rz)
		return p
	end
	local function oak(x: number, z: number, scale: number)
		local gy = fy + math.max(terrainH(x, z) - 6, 0)
		local trunkH = 70 * scale
		local tr = 9 * scale
		local side = tr / math.sqrt(3)
		for k = 0, 2 do
			rotBox("TreeTrunk", Vector3.new(side, trunkH, tr), x, gy + trunkH / 2, z, trunkColor, 0, k * math.pi / 3, 0)
		end
		for i = 0, 2 do
			local size = (64 - i * 14) * scale
			rotBox("TreeCanopy", Vector3.new(size, size * 0.8, size), x, gy + trunkH + (i * 26 - 12) * scale, z, greens[i + 1], math.rad(12 * (if i % 2 == 0 then 1 else -1)), math.rad(rng:NextNumber(0, 90)), math.rad(8))
		end
	end
	local function pine(x: number, z: number, scale: number)
		local gy = fy + math.max(terrainH(x, z) - 6, 0)
		local trunkH = 40 * scale
		local tr = 6 * scale
		local side = tr / math.sqrt(3)
		for k = 0, 2 do
			rotBox("TreeTrunk", Vector3.new(side, trunkH, tr), x, gy + trunkH / 2, z, trunkColor, 0, k * math.pi / 3, 0)
		end
		for i = 0, 4 do
			local size = (56 - i * 10) * scale
			rotBox("PineTier", Vector3.new(size, 22 * scale, size), x, gy + trunkH * 0.7 + i * 17 * scale, z, if i % 2 == 0 then Color3.fromRGB(58, 120, 64) else Color3.fromRGB(46, 104, 58), 0, math.rad(45 * i + 10), 0)
		end
	end
	-- Slim pines line the patio fence (clear of the oven and the BBQ); oaks stand further out.
	for _, side in { -1, 1 } do
		for z = -480, 40, 130 do
			pine(side * 470, z, 3.2 + (z % 3) * 0.2)
		end
	end
	for _, t in { { -700, -300, 5.2 }, { 720, -260, 5.6 }, { -760, 100, 5.8 }, { 700, 160, 5.2 }, { -640, 420, 5.6 }, { 660, 460, 5.4 }, { -330, 760, 6 }, { 380, 800, 6 }, { -560, -720, 5.4 }, { 540, -700, 5.6 }, { -200, -820, 5.2 }, { 220, -860, 5.6 } } do
		oak(t[1], t[2], t[3])
	end
	for _, t in { { -820, -80, 4.4 }, { 820, 40, 4.2 }, { -420, 640, 4.2 }, { 470, 620, 4.4 } } do
		pine(t[1], t[2], t[3])
	end

	-- Picket fence round the patio (front and both sides; the counter closes the back).
	local fenceColor = Color3.fromRGB(246, 244, 238)
	local function fenceRun(x0: number, z0: number, x1: number, z1: number)
		local len = math.sqrt((x1 - x0) ^ 2 + (z1 - z0) ^ 2)
		local n = math.floor(len / 14)
		local along = Vector3.new(x1 - x0, 0, z1 - z0).Unit
		local horizontal = math.abs(x1 - x0) &gt; math.abs(z1 - z0)
		for i = 0, n do
			local x, z = x0 + along.X * len * i / n, z0 + along.Z * len * i / n
			local sx, sz = if horizontal then 6 else 2.5, if horizontal then 2.5 else 6
			local pk = box(b, "Picket", Vector3.new(sx, 56, sz), x, fy + 28, z, fenceColor, Enum.Material.SmoothPlastic, scenery)
			if i % 6 == 0 then
				pk.Size = Vector3.new(sx + 2, 66, sz + 2)
			end
		end
		for _, y in { 16, 40 } do
			local cx, cz = (x0 + x1) / 2, (z0 + z1) / 2
			box(b, "FenceRail", Vector3.new(if horizontal then len else 3, 5, if horizontal then 3 else len), cx, fy + y, cz, fenceColor, Enum.Material.SmoothPlastic, scenery)
		end
	end
	fenceRun(-ROOM_HALF_X + 4, ROOM_Z_FRONT + 4, ROOM_HALF_X - 4, ROOM_Z_FRONT + 4)
	fenceRun(-ROOM_HALF_X + 4, ROOM_Z_FRONT + 4, -ROOM_HALF_X + 4, -70)
	fenceRun(ROOM_HALF_X - 4, ROOM_Z_FRONT + 4, ROOM_HALF_X - 4, -70)

	-- The BBQ on the left, a barrel grill on a cart, well clear of where the waiter walks.
	local gx, gz = -300, -130
	local steel = Color3.fromRGB(46, 48, 54)
	local chrome = Color3.fromRGB(190, 196, 204)
	for _, lx in { -62, 62 } do
		for _, lz in { -30, 30 } do
			cyl(b, "BbqLeg", 74, 6, gx + lx, fy + 37, gz + lz, steel, Enum.Material.Metal, scenery)
		end
	end
	span(b, "BbqShelf", gx - 70, gx + 70, fy + 36, fy + 40, gz - 36, gz + 36, chrome, Enum.Material.Metal, scenery)
	cyl(b, "PropaneTank", 52, 28, gx - 34, fy + 66, gz, Color3.fromRGB(235, 232, 226), Enum.Material.Metal, scenery)
	span(b, "BbqBase", gx - 78, gx + 78, fy + 74, fy + 124, gz - 40, gz + 40, steel, Enum.Material.Metal, scenery)
	local lid = box(b, "BbqLid", Vector3.new(148, 84, 84), gx, fy + 124, gz, Color3.fromRGB(34, 36, 42), Enum.Material.Metal, scenery)
	lid.Shape = Enum.PartType.Cylinder
	-- Handle: a bar held off the lid's front by two brackets (the lid's front is at gz - 42).
	span(b, "BbqHandle", gx - 50, gx + 50, fy + 150, fy + 154, gz - 56, gz - 52, chrome, Enum.Material.Metal, scenery)
	for _, hx in { -44, 44 } do
		span(b, "BbqHandleBracket", gx + hx - 1.5, gx + hx + 1.5, fy + 150, fy + 154, gz - 54, gz - 40, chrome, Enum.Material.Metal, scenery)
	end
	span(b, "BbqGlow", gx - 60, gx + 60, fy + 116, fy + 120, gz - 40.8, gz - 40.2, Color3.fromRGB(255, 120, 40), Enum.Material.Neon, scenery)
	cyl(b, "BbqStack", 40, 14, gx + 54, fy + 176, gz + 24, steel, Enum.Material.Metal, scenery)
	local smokeAnchor = box(b, "BbqSmoke", Vector3.new(2, 2, 2), gx + 54, fy + 200, gz + 24, chrome, nil, { Transparency = 1, CanCollide = false, CastShadow = false })
	local smoke = Instance.new("ParticleEmitter")
	smoke.Texture = "rbxasset://textures/particles/smoke_main.dds"
	smoke.Color = ColorSequence.new(Color3.fromRGB(210, 210, 214))
	smoke.Lifetime = NumberRange.new(4, 6)
	smoke.Speed = NumberRange.new(10, 18)
	smoke.Rate = 5
	smoke.Size = NumberSequence.new(10, 34)
	smoke.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 1) })
	smoke.EmissionDirection = Enum.NormalId.Top
	smoke.SpreadAngle = Vector2.new(12, 12)
	smoke.Parent = smokeAnchor

	-- Beach parasols on the patio (clear of the chef's and the waiter's routes).
	for _, ux in { -370, 370 } do
		local uz = -330
		cyl(b, "ParasolPole", 280, 6, ux, fy + 140, uz, Color3.fromRGB(235, 232, 226), Enum.Material.Metal, scenery)
		ball("ParasolTop", 230, 80, 230, ux, fy + 280, uz, Color3.fromRGB(215, 60, 55), Enum.Material.Fabric)
		ball("ParasolStripe", 232, 40, 232, ux, fy + 296, uz, Color3.fromRGB(250, 246, 238), Enum.Material.Fabric)
		cyl(b, "ParasolBase", 10, 60, ux, fy + 5, uz, Color3.fromRGB(120, 114, 106), Enum.Material.Concrete, scenery)
	end

	-- Pizzas and pizza boxes on the benches: a wooden board, a crust, sauce, cheese, pepperoni, basil
	-- and cut lines. (Each layer is a little thicker than the one under it, so no faces share a plane.)
	local benchY = COUNTER_TOP_Y
	local function pizza(x: number, z: number, sliced: boolean)
		cyl(b, "PizzaBoard", 3, 88, x, benchY + 1.5, z, Color3.fromRGB(176, 128, 82), Enum.Material.Wood, scenery)
		cyl(b, "PizzaCrust", 4, 76, x, benchY + 5, z, Color3.fromRGB(226, 172, 92), Enum.Material.Sand, scenery)
		cyl(b, "PizzaSauce", 4.4, 66, x, benchY + 5.2, z, Color3.fromRGB(200, 60, 35), Enum.Material.SmoothPlastic, scenery)
		cyl(b, "PizzaCheese", 4.8, 60, x, benchY + 5.4, z, Color3.fromRGB(246, 214, 112), Enum.Material.SmoothPlastic, scenery)
		for k = 0, 7 do
			local a = k / 8 * math.pi * 2 + 0.3
			local r = if k % 2 == 0 then 20 else 10
			cyl(b, "Pepperoni", 5.2, 11, x + math.cos(a) * r, benchY + 5.6, z + math.sin(a) * r, Color3.fromRGB(160, 34, 34), Enum.Material.SmoothPlastic, scenery)
		end
		for k = 0, 4 do
			local a = k * 1.9 + 0.7
			local lf = box(b, "Basil", Vector3.new(7, 0.8, 4), x + math.cos(a) * 14, benchY + 8.4, z + math.sin(a) * 14, Color3.fromRGB(70, 150, 66), Enum.Material.SmoothPlastic, scenery)
			lf.CFrame = footprint(b.origin, x + math.cos(a) * 14, benchY + 8.4, z + math.sin(a) * 14) * CFrame.Angles(0, a, 0)
		end
		if sliced then
			for k = 0, 2 do
				local ln = box(b, "PizzaCut", Vector3.new(66, 0.5, 0.8), x, benchY + 8.2, z, Color3.fromRGB(150, 100, 50), Enum.Material.SmoothPlastic, scenery)
				ln.CFrame = footprint(b.origin, x, benchY + 8.2, z) * CFrame.Angles(0, k * math.pi / 3, 0)
			end
		end
	end
	local function boxStack(x: number, z: number, n: number)
		for j = 0, n - 1 do
			local y = benchY + 2.6 + j * 5.2
			local bx = box(b, "PizzaBox", Vector3.new(66, 5, 66), x + (j % 2) * 1.5, y, z - (j % 2) * 1.2, Color3.fromRGB(246, 238, 220), Enum.Material.Cardboard, scenery)
			bx.CFrame = footprint(b.origin, x + (j % 2) * 1.5, y, z - (j % 2) * 1.2) * CFrame.Angles(0, j * 0.12, 0)
		end
		cyl(b, "PizzaBoxLogo", 0.4, 26, x, benchY + 5.2 * n + 2.7, z, Color3.fromRGB(205, 45, 40), Enum.Material.SmoothPlastic, scenery)
	end
	pizza(-150, 24, true)
	pizza(-270, 62, false)
	boxStack(-355, 14, 5)
	pizza(160, 46, false)
	pizza(285, 16, true)
	boxStack(350, 70, 4)
	boxStack(-100, 80, 3)

	-- The house behind the yard: two storeys, a gabled roof, a porch and flower beds.
	local hz0, hz1 = 520, 740
	local siding = Color3.fromRGB(246, 232, 196)
	local trim = Color3.fromRGB(252, 250, 246)
	span(b, "HouseWalls", -280, 280, fy - 4, fy + 400, hz0, hz1, siding, Enum.Material.WoodPlanks, scenery)
	span(b, "HouseBase", -284, 284, fy - 4, fy + 30, hz0 - 3, hz1 + 3, Color3.fromRGB(150, 144, 136), Enum.Material.Cobblestone, scenery)
	span(b, "HouseBelt", -284, 284, fy + 196, fy + 204, hz0 - 3, hz1 + 3, trim, nil, scenery)
	for floor = 0, 1 do
		local wy0, wy1 = fy + 70 + floor * 200, fy + 160 + floor * 200
		for _, wx in { -200, -100, 100, 200 } do
			span(b, "WindowFrame", wx - 30, wx + 30, wy0 - 6, wy1 + 6, hz0 - 3, hz0, trim, nil, scenery)
			local glass = span(b, "WindowGlass", wx - 24, wx + 24, wy0, wy1, hz0 - 3.4, hz0 - 3, Color3.fromRGB(150, 205, 240), Enum.Material.Glass, scenery)
			glass.Transparency = 0.25
			span(b, "WindowBar", wx - 2, wx + 2, wy0, wy1, hz0 - 3.8, hz0 - 3.4, trim, nil, scenery)
			span(b, "WindowBar", wx - 24, wx + 24, (wy0 + wy1) / 2 - 2, (wy0 + wy1) / 2 + 2, hz0 - 3.8, hz0 - 3.4, trim, nil, scenery)
			for _, sx in { -1, 1 } do
				span(b, "Shutter", wx + sx * 34 - 6, wx + sx * 34 + 6, wy0 - 6, wy1 + 6, hz0 - 3.4, hz0 - 3, Color3.fromRGB(70, 120, 150), nil, scenery)
			end
		end
	end
	span(b, "DoorFrame", -42, 42, fy + 30, fy + 180, hz0 - 3, hz0, trim, nil, scenery)
	span(b, "FrontDoor", -34, 34, fy + 30, fy + 174, hz0 - 3.6, hz0 - 3, Color3.fromRGB(190, 52, 48), Enum.Material.Wood, scenery)
	cyl(b, "DoorKnob", 8, 8, 22, fy + 100, hz0 - 6, Color3.fromRGB(230, 190, 90), Enum.Material.Metal, scenery)
	span(b, "PorchSlab", -90, 90, fy - 2, fy + 10, hz0 - 70, hz0 - 3, Color3.fromRGB(176, 170, 160), Enum.Material.Slate, scenery)
	span(b, "PorchStep", -60, 60, fy - 2, fy + 4, hz0 - 100, hz0 - 70, Color3.fromRGB(176, 170, 160), Enum.Material.Slate, scenery)
	span(b, "PorchRoof", -100, 100, fy + 196, fy + 204, hz0 - 80, hz0, Color3.fromRGB(150, 70, 56), Enum.Material.Slate, scenery)
	for _, px in { -90, 90 } do
		cyl(b, "PorchPost", 176, 10, px, fy + 103, hz0 - 76, trim, Enum.Material.SmoothPlastic, scenery)
	end
	local roofRed = Color3.fromRGB(150, 70, 56)
	local slope = math.rad(34)
	local roofCZ = (hz0 + hz1) / 2
	for _, side in { -1, 1 } do
		local half = (hz1 - hz0) / 2 + 28
		local rise = math.sin(slope) * half / 2
		local run = math.cos(slope) * half / 2
		local slab = box(b, "Roof", Vector3.new(600, 10, half), 0, fy + 400 + rise, roofCZ + side * run, roofRed, Enum.Material.Slate, scenery)
		slab.CFrame = footprint(b.origin, 0, fy + 400 + rise, roofCZ + side * run) * CFrame.Angles(-side * slope, 0, 0)
	end
	for step = 0, 5 do
		local halfZ = (hz1 - hz0) / 2 * (1 - step / 6)
		for _, sx in { -1, 1 } do
			span(b, "Gable", sx * 278, sx * 282, fy + 400 + step * 18, fy + 418 + step * 18, roofCZ - halfZ, roofCZ + halfZ, siding, Enum.Material.WoodPlanks, scenery)
		end
	end
	span(b, "Chimney", 170, 220, fy + 380, fy + 600, roofCZ + 20, roofCZ + 70, Color3.fromRGB(150, 70, 52), Enum.Material.Brick, scenery)
	span(b, "ChimneyCap", 164, 226, fy + 600, fy + 610, roofCZ + 14, roofCZ + 76, Color3.fromRGB(190, 180, 170), Enum.Material.Concrete, scenery)
	local blooms = { Color3.fromRGB(235, 80, 110), Color3.fromRGB(250, 200, 60), Color3.fromRGB(180, 110, 230), Color3.fromRGB(250, 250, 250) }
	for bi, bx in { -200, -130, 130, 200 } do
		span(b, "FlowerBed", bx - 40, bx + 40, fy - 0.6, fy + 12, hz0 - 40, hz0 - 10, Color3.fromRGB(96, 66, 46), Enum.Material.Ground, scenery)
		for i = 0, 3 do
			ball("Flower", 14, 14, 14, bx - 28 + i * 19, fy + 20, hz0 - 25, blooms[(i + bi) % 4 + 1], Enum.Material.SmoothPlastic)
			cyl(b, "Stem", 10, 2, bx - 28 + i * 19, fy + 12, hz0 - 25, Color3.fromRGB(70, 140, 60), nil, scenery)
		end
	end
	for z = 130, hz0 - 110, 56 do
		span(b, "StepStone", -26, 26, fy - 0.6, fy + 1, z, z + 40, Color3.fromRGB(176, 170, 160), Enum.Material.Slate, scenery)
	end
end

-- Level 2's tap over the sink: a chrome gooseneck on the back of the counter with hot and cold
-- handles; the water is a thin falling particle stream (no solid parts to look odd).
local function buildFaucet(b: Builder)
	local chrome = Color3.fromRGB(205, 210, 218)
	local base = COUNTER_TOP_Y
	local tz = 88
	cyl(b, "FaucetBase", 6, 22, 0, base + 3, tz, chrome, Enum.Material.Metal, noCollide())
	cyl(b, "FaucetPipe", 56, 8, 0, base + 34, tz, chrome, Enum.Material.Metal, noCollide())
	local elbow = box(b, "FaucetElbow", Vector3.new(11, 11, 11), 0, base + 62, tz, chrome, Enum.Material.Metal, noCollide())
	elbow.Shape = Enum.PartType.Ball
	span(b, "FaucetSpout", -3.5, 3.5, base + 56.5, base + 67.5, 28, tz, chrome, Enum.Material.Metal, noCollide())
	cyl(b, "FaucetNozzle", 9, 9, 0, base + 53, 28, chrome, Enum.Material.Metal, noCollide())
	local handles: { { any } } = { { -22, Color3.fromRGB(70, 130, 220) }, { 22, Color3.fromRGB(220, 70, 60) } }
	for _, h in handles do
		cyl(b, "TapStem", 9, 5, h[1], base + 4.5, tz - 2, chrome, Enum.Material.Metal, noCollide())
		span(b, "TapLever", h[1] - 8, h[1] + 8, base + 9, base + 11.5, tz - 3.2, tz - 0.8, chrome, Enum.Material.Metal, noCollide())
		for _, side in { -1, 1 } do
			cyl(b, "TapCap", 3, 5, h[1] + side * 8, base + 11.5, tz - 2, chrome, Enum.Material.Metal, noCollide())
		end
		cyl(b, "TapDot", 0.6, 3, h[1], base + 12, tz - 2, h[2], Enum.Material.SmoothPlastic, noCollide())
	end
	-- Water: a thin particle stream from the nozzle down into the basin.
	local anchor = box(b, "FaucetWater", Vector3.new(2, 2, 2), 0, base + 48, 28, chrome, nil, { Transparency = 1, CanCollide = false, CastShadow = false })
	local drops = Instance.new("ParticleEmitter")
	drops.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	drops.Color = ColorSequence.new(Color3.fromRGB(170, 215, 255))
	drops.LightEmission = 0.3
	drops.Lifetime = NumberRange.new(1.5, 1.7)
	drops.Speed = NumberRange.new(50, 56)
	drops.Rate = 40
	drops.Size = NumberSequence.new(2.4, 1.8)
	drops.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 0.7) })
	drops.SpreadAngle = Vector2.new(2, 2)
	drops.EmissionDirection = Enum.NormalId.Bottom
	drops.Parent = anchor
end

-- The whole room for a level: shell + that room's props.
local function buildRoom(b: Builder, levelIndex: number)
	local style = ROOM_STYLES[levelIndex] or ROOM_STYLES[1]
	buildKitchen(b, style)
	if levelIndex == 2 then
		pizzeriaProps(b, style)
		buildYard(b)
		buildFaucet(b)
	elseif levelIndex == 3 then
		castleProps(b, style)
	else
		familyProps(b, style)
	end
end

----------------------------------------------------------------------------------------------------
-- The dishwasher body, tub and door
----------------------------------------------------------------------------------------------------

local function buildTub(b: Builder, theme)
	local steel = theme.Tub
	local zMid = (TUB_Z_MIN + TUB_Z_MAX) / 2
	-- Level 2's basin is a white porcelain sink, open to the sky (no ceiling), with a rolled rim.
	local sink = theme.Sink == true
	-- Level 3's basin is an olden-day oak wash trough bound with iron hoops, also open at the top.
	local trough = theme.Trough == true
	local open = sink
	local tubMat = if sink then Enum.Material.SmoothPlastic elseif trough then Enum.Material.WoodPlanks else Enum.Material.Metal

	-- Tub floor and walls. They don't cast shadows, so the room's daylight still reaches inside.
	span(b, "TubFloor", -TUB_HALF_X - 2, TUB_HALF_X + 2, -2, 0, TUB_Z_MIN, TUB_Z_MAX, steel, tubMat)
	for _, side in { -1, 1 } do
		span(b, "TubWall", side * TUB_HALF_X, side * (TUB_HALF_X + 2), 0, TUB_HEIGHT, TUB_Z_MIN, TUB_Z_MAX, steel, tubMat)
		-- Pressed ribs and rack rails on the side walls.
		for i = 1, (if open then 0 else 6) do
			local y = i * (TUB_HEIGHT / 7)
			span(b, "Rib", side * (TUB_HALF_X - 0.3), side * TUB_HALF_X, y - 0.4, y + 0.4, TUB_Z_MIN + 4, TUB_Z_MAX - 4, theme.Metal, Enum.Material.Metal, noCollide())
		end
		local railYs: { number } = if sink then { BOTTOM_RACK_Y - 1 } else { BOTTOM_RACK_Y - 1, TOP_RACK_Y - 1 }
		for _, y in railYs do
			span(b, "RackRail", side * (TUB_HALF_X - 1.6), side * TUB_HALF_X, y - 0.8, y + 0.8, TUB_Z_MIN + 2, TUB_Z_MAX - 2, theme.Rack, Enum.Material.Metal, noCollide())
		end
	end
	-- The tub casts shadows (it's a closed box, like a real machine): the inside is lit by the
	-- interior lights below rather than blasted by daylight.
	span(b, "TubBack", -TUB_HALF_X - 2, TUB_HALF_X + 2, 0, TUB_HEIGHT, TUB_Z_MAX, TUB_Z_MAX + 2, steel, tubMat)
	if open then
		if sink then
			-- The top rack is a dish drainer standing over the sink on four chrome posts, one under each
			-- corner of its frame (the frame's bars are centred on x = +-RACK_HALF_X and z = TOP_RACK_Z).
			for _, px in { -RACK_HALF_X, RACK_HALF_X } do
				for _, pz in { TOP_RACK_Z[1], TOP_RACK_Z[2] } do
					cyl(b, "DrainerPost", TOP_RACK_Y + 1.8, 2.4, px, (TOP_RACK_Y + 1.8) / 2, pz, Color3.fromRGB(205, 210, 218), Enum.Material.Metal)
				end
			end
		end
		-- Invisible fence round the whole basin area, up to a lid high overhead: nobody can climb onto the
		-- counter or anything above it, however they jump or fly.
		local fenceTop = if sink then 420 else 800
		local inv = { Transparency = 1, CastShadow = false }
		for _, side in { -1, 1 } do
			span(b, "SinkFence", side * (TUB_HALF_X + 0.5), side * (TUB_HALF_X + 10), TUB_HEIGHT, fenceTop, DOOR_Z_FAR - 14, TUB_Z_MAX + 10, Color3.new(1, 1, 1), nil, inv)
		end
		span(b, "SinkFence", -TUB_HALF_X, TUB_HALF_X, TUB_HEIGHT, fenceTop, TUB_Z_MAX + 0.5, TUB_Z_MAX + 10, Color3.new(1, 1, 1), nil, inv)
		-- Rim round the opening, level with the counter top: rolled porcelain, or a thick dark oak cap.
		local rim = if sink then Color3.fromRGB(250, 250, 248) else Color3.fromRGB(70, 50, 34)
		local rimMat = if sink then tubMat else Enum.Material.Wood
		span(b, "SinkRim", -TUB_HALF_X - 4, -TUB_HALF_X + 3, TUB_HEIGHT, COUNTER_TOP_Y, TUB_Z_MIN - 3, TUB_Z_MAX + 4, rim, rimMat)
		span(b, "SinkRim", TUB_HALF_X - 3, TUB_HALF_X + 4, TUB_HEIGHT, COUNTER_TOP_Y, TUB_Z_MIN - 3, TUB_Z_MAX + 4, rim, rimMat)
		span(b, "SinkRim", -TUB_HALF_X - 4, TUB_HALF_X + 4, TUB_HEIGHT, COUNTER_TOP_Y, TUB_Z_MAX - 3, TUB_Z_MAX + 4, rim, rimMat)
		if sink then
			span(b, "OverflowSlot", -12, 12, TUB_HEIGHT - 14, TUB_HEIGHT - 6, TUB_Z_MAX - 0.6, TUB_Z_MAX, Color3.fromRGB(120, 130, 140), nil, noCollide())
		end
	else
		span(b, "TubCeiling", -TUB_HALF_X - 2, TUB_HALF_X + 2, TUB_HEIGHT, TUB_HEIGHT + 2, TUB_Z_MIN, TUB_Z_MAX, steel, if trough then Enum.Material.WoodPlanks else Enum.Material.Metal)
		if trough then
			-- Iron hoops round the outside of the oak chest, iron corner straps and a banded lid.
			local iron = Color3.fromRGB(52, 50, 54)
			for _, y in { 16, 50, 84 } do
				for _, side in { -1, 1 } do
					span(b, "IronHoop", side * (TUB_HALF_X + 2), side * (TUB_HALF_X + 3.6), y - 3, y + 3, TUB_Z_MIN - 1, TUB_Z_MAX + 3.6, iron, Enum.Material.Metal, noCollide())
				end
				span(b, "IronHoop", -TUB_HALF_X - 3.6, TUB_HALF_X + 3.6, y - 3, y + 3, TUB_Z_MAX + 2, TUB_Z_MAX + 3.6, iron, Enum.Material.Metal, noCollide())
			end
			for _, side in { -1, 1 } do
				for _, z in { TUB_Z_MIN + 6, TUB_Z_MAX - 6 } do
					span(b, "IronStrap", side * (TUB_HALF_X + 2), side * (TUB_HALF_X + 4), 0, TUB_HEIGHT + 3, z - 3, z + 3, iron, Enum.Material.Metal, noCollide())
					span(b, "LidStrap", side * (TUB_HALF_X - 1), side * (TUB_HALF_X + 4), TUB_HEIGHT + 2, TUB_HEIGHT + 4.5, z - 4, z + 4, iron, Enum.Material.Metal, noCollide())
				end
			end
			for _, z in { TUB_Z_MIN + 20, (TUB_Z_MIN + TUB_Z_MAX) / 2, TUB_Z_MAX - 20 } do
				span(b, "LidBand", -TUB_HALF_X - 1, TUB_HALF_X + 1, TUB_HEIGHT + 2, TUB_HEIGHT + 4, z - 3, z + 3, iron, Enum.Material.Metal, noCollide())
			end
		end
	end

	-- Filter cup in the floor at the back, heating element loop.
	cyl(b, "Filter", 0.4, 14, 0, 0.2, 30, Color3.fromRGB(120, 125, 130), Enum.Material.DiamondPlate, noCollide())
	for _, x in { -40, 40 } do
		span(b, "Heater", x - 0.6, x + 0.6, 0.4, 1.4, -10, 50, Color3.fromRGB(90, 90, 95), Enum.Material.Metal, noCollide())
	end
	span(b, "Heater", -40, 40, 0.4, 1.4, 49.4, 50.6, Color3.fromRGB(90, 90, 95), Enum.Material.Metal, noCollide())

	-- Front frame around the opening, the machine's side panels, and the toe kick under the door.
	-- (Offsets of 0.2 keep every face off its neighbours' planes, so nothing flickers.)
	local frameColor = if trough then Color3.fromRGB(96, 66, 42) else K.Frame
	local frameMat = if trough then Enum.Material.Wood else Enum.Material.Metal
	if not sink then
		span(b, "FrameTop", -TUB_HALF_X - 6.2, TUB_HALF_X + 6.2, TUB_HEIGHT - 0.2, COUNTER_TOP_Y - 6, TUB_Z_MIN - 3.2, TUB_Z_MIN + 2, frameColor, frameMat)
	end
	for _, side in { -1, 1 } do
		span(b, "FrameSide", side * (TUB_HALF_X - 0.2), side * (TUB_HALF_X + 6), KITCHEN_FLOOR_Y, TUB_HEIGHT, TUB_Z_MIN - 3, TUB_Z_MIN + 2, frameColor, frameMat)
		span(b, "Gasket", side * (TUB_HALF_X - 0.4), side * TUB_HALF_X, 0, TUB_HEIGHT - 0.4, TUB_Z_MIN - 0.5, TUB_Z_MIN + 1, Color3.fromRGB(50, 50, 55), nil, noCollide())
	end
	span(b, "UnderTub", -TUB_HALF_X - 5.8, TUB_HALF_X + 5.8, KITCHEN_FLOOR_Y + 12, -2.2, TUB_Z_MIN + 1, TUB_Z_MAX, Color3.fromRGB(90, 90, 95), Enum.Material.Metal)
	span(b, "ToeKick", -TUB_HALF_X, TUB_HALF_X, KITCHEN_FLOOR_Y, KITCHEN_FLOOR_Y + 12, TUB_Z_MIN + 6, TUB_Z_MAX, K.Kick)

	-- Interior lights so the load is easy to see (PointLight range tops out at 60 studs).
	for _, spot in { { -30, 90, -20 }, { 30, 90, -20 }, { -30, 90, 35 }, { 30, 90, 35 }, { -30, 44, 0 }, { 30, 44, 0 }, { 0, 44, 40 } } do
		local lightPart = box(b, "InteriorLight", Vector3.new(1, 1, 1), spot[1], spot[2], spot[3], theme.Light, nil, { Transparency = 1, CanCollide = false, CastShadow = false })
		local light = Instance.new("PointLight")
		light.Color = theme.Light
		light.Brightness = if spot[2] &gt; 60 then 0.45 else 0.6
		light.Range = 60
		light.Shadows = false
		light.Parent = lightPart
	end

	-- Drifting bubbles for mood.
	local bubbleAnchor = box(b, "BubbleAnchor", Vector3.new(80, 1, 80), 0, 30, zMid, theme.Accent, nil, { Transparency = 1, CanCollide = false })
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = "rbxasset://textures/particles/forcefield_glow_main.dds"
	emitter.Color = ColorSequence.new(Color3.new(1, 1, 1))
	emitter.LightEmission = 0.3
	emitter.Lifetime = NumberRange.new(5, 8)
	emitter.Speed = NumberRange.new(1, 3)
	emitter.Rate = 3
	emitter.Size = NumberSequence.new(0.8, 0.3)
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.2, 0.6),
		NumberSequenceKeypoint.new(1, 1),
	})
	emitter.SpreadAngle = Vector2.new(30, 30)
	emitter.EmissionDirection = Enum.NormalId.Top
	emitter.Parent = bubbleAnchor
end

local function buildDoor(b: Builder, theme)
	-- The invisible walls and lid: as tall as the tub on a dishwasher, far taller over the open sink.
	local open = theme.Sink == true
	local oak = theme.Trough == true
	local wallTop = if open then 420 else TUB_HEIGHT
	-- Inner panel (the floor you stand on) and the outer skin below it.
	span(b, "DoorInner", -TUB_HALF_X, TUB_HALF_X, -1, 0, DOOR_Z_FAR, DOOR_Z_NEAR, theme.Tub, if theme.Trough then Enum.Material.WoodPlanks else Enum.Material.Metal)
	span(b, "DoorOuter", -TUB_HALF_X - 4, TUB_HALF_X + 4, -DOOR_THICK, -1, DOOR_Z_FAR - 6, DOOR_Z_NEAR, if theme.Sink then Color3.fromRGB(176, 130, 90) elseif oak then Color3.fromRGB(96, 66, 42) else K.Frame, if open or oak then Enum.Material.WoodPlanks else Enum.Material.Metal)
	if open or oak then
		-- Standing on four legs: wooden for the drainboard, stone piers for the drawbridge.
		for _, lx in { -TUB_HALF_X, TUB_HALF_X } do
			for _, lz in { DOOR_Z_FAR - 2, DOOR_Z_NEAR - 6 } do
				if theme.Sink then
					cyl(b, "DrainboardLeg", -DOOR_THICK - KITCHEN_FLOOR_Y, 8, lx, (-DOOR_THICK + KITCHEN_FLOOR_Y) / 2, lz, Color3.fromRGB(150, 104, 62), Enum.Material.Wood)
				else
					span(b, "BridgePier", lx - 7, lx + 7, KITCHEN_FLOOR_Y, -DOOR_THICK, lz - 7, lz + 7, Color3.fromRGB(128, 122, 116), Enum.Material.Cobblestone)
				end
			end
		end
		for gx = -TUB_HALF_X + 10, TUB_HALF_X - 10, 10 do
			span(b, "Groove", gx - 0.6, gx + 0.6, 0, 0.12, DOOR_Z_FAR + 4, DOOR_Z_NEAR - 4, if theme.Sink then Color3.fromRGB(170, 178, 186) else Color3.fromRGB(60, 40, 26), nil, noCollide())
		end
		if theme.Trough then
			-- Drawbridge: iron cross-bands and studs, and an iron torch stand at each side of the far end.
			local iron = Color3.fromRGB(52, 50, 54)
			for z = DOOR_Z_FAR + 12, DOOR_Z_NEAR - 8, 20 do
				span(b, "BridgeBand", -TUB_HALF_X, TUB_HALF_X, 0, 0.18, z - 1.5, z + 1.5, iron, Enum.Material.Metal, noCollide())
			end
			for _, tx in { -TUB_HALF_X - 10, TUB_HALF_X + 10 } do
				cyl(b, "TorchStand", 80, 4, tx, 40, DOOR_Z_FAR + 14, iron, Enum.Material.Metal, noCollide())
				cyl(b, "TorchBowl", 6, 14, tx, 82, DOOR_Z_FAR + 14, iron, Enum.Material.Metal, noCollide())
				local flame = box(b, "TorchFire", Vector3.new(9, 16, 9), tx, 92, DOOR_Z_FAR + 14, Color3.fromRGB(255, 160, 60), Enum.Material.Neon, noCollide())
				flame.Shape = Enum.PartType.Ball
				local fl = Instance.new("PointLight")
				fl.Color = Color3.fromRGB(255, 170, 90)
				fl.Brightness = 1.4
				fl.Range = 55
				fl.Parent = flame
			end
		end
	end
	-- Raised edges down the sides of the inner panel.
	for _, side in { -1, 1 } do
		span(b, "DoorEdge", side * (TUB_HALF_X - 2), side * TUB_HALF_X, 0, 2, DOOR_Z_FAR, DOOR_Z_NEAR, theme.Metal, Enum.Material.Metal)
		-- Invisible safety wall so nobody walks off the side.
		-- Invisible safety wall, as tall as the tub, so nobody can jump off the door.
		span(b, "SafetyWall", side * TUB_HALF_X, side * (TUB_HALF_X + 8), 0, wallTop, DOOR_Z_FAR - 14, DOOR_Z_NEAR, Color3.new(1, 1, 1), nil, { Transparency = 1, CastShadow = false })
	end
	span(b, "SafetyWall", -TUB_HALF_X - 8, TUB_HALF_X + 8, 0, wallTop, DOOR_Z_FAR - 14, DOOR_Z_FAR - 6, Color3.new(1, 1, 1), nil, { Transparency = 1, CastShadow = false })
	-- A lid over the door area as well, level with the tub ceiling.
	span(b, "SafetyLid", -TUB_HALF_X - 8, TUB_HALF_X + 8, wallTop, wallTop + 8, DOOR_Z_FAR - 14, if open then TUB_Z_MAX + 10 else DOOR_Z_NEAR - 3.2, Color3.new(1, 1, 1), nil, { Transparency = 1, CastShadow = false })

	-- Control strip along the far edge (the top of the door when it's closed), with buttons.
	if open or oak then
		return
	end
	span(b, "ControlStrip", -TUB_HALF_X - 4.3, TUB_HALF_X + 4.3, -DOOR_THICK - 0.3, 3, DOOR_Z_FAR - 6.3, DOOR_Z_FAR, Color3.fromRGB(40, 44, 52), Enum.Material.SmoothPlastic)
	for i = -3, 3 do
		local lit = i == 0
		box(b, "Button", Vector3.new(4, 0.6, 3), i * 9, 3.3, DOOR_Z_FAR - 3, if lit then theme.Accent else Color3.fromRGB(90, 95, 105), if lit then Enum.Material.Neon else nil, noCollide())
	end

end

----------------------------------------------------------------------------------------------------
-- Racks
----------------------------------------------------------------------------------------------------

-- A walkable rack floor: invisible collidable plate + a visible wire grid, frame and wheels.
local function buildRack(b: Builder, theme, y: number, zRange: { number }, wheels: boolean)
	local z0, z1 = zRange[1], zRange[2]
	local width = RACK_HALF_X * 2
	local depth = z1 - z0
	span(b, "RackFloor", -RACK_HALF_X, RACK_HALF_X, y - 1, y, z0, z1, Color3.new(1, 1, 1), nil, { Transparency = 1, CastShadow = false })

	local wire = { CanCollide = false }
	for x = -RACK_HALF_X, RACK_HALF_X, 4 do
		box(b, "Wire", Vector3.new(0.3, 0.3, depth), x, y - 0.15, (z0 + z1) / 2, theme.Rack, Enum.Material.SmoothPlastic, wire)
	end
	for z = z0, z1, 4 do
		box(b, "Wire", Vector3.new(width, 0.3, 0.3), 0, y - 0.45, z, theme.Rack, Enum.Material.SmoothPlastic, wire)
	end
	-- Chunky frame around the edge.
	for _, side in { -1, 1 } do
		box(b, "RackFrame", Vector3.new(0.9, 2.4, depth), side * RACK_HALF_X, y + 0.6, (z0 + z1) / 2, theme.Rack, nil, wire)
		if wheels then
			for _, z in { z0 + 8, z1 - 8 } do
				cyl(b, "Wheel", 3, 1, side * (RACK_HALF_X + 0.8), y - 1.2, z, Color3.fromRGB(60, 60, 64), nil, noCollide()).CFrame = footprint(b.origin, side * (RACK_HALF_X + 0.8), y - 1.2, z)
			end
		end
	end
	for _, z in { z0, z1 } do
		box(b, "RackFrame", Vector3.new(width, 2.4, 0.9), 0, y + 0.6, z, theme.Rack, nil, wire)
	end
end

-- Tines: the rows of little prongs plates stand in. Pure decoration.
local function buildTines(b: Builder, theme)
	local props = { CanCollide = false, CastShadow = false }
	for _, x in PLATE_ROW_X do
		for _, dx in { -9, 9 } do
			for _, z in PLATE_Z do
				box(b, "Tine", Vector3.new(0.35, 5, 0.35), x + dx, BOTTOM_RACK_Y + 2.5, z + 3.5, theme.Rack, nil, props)
			end
		end
	end
end

-- Ramp from the tub floor up onto the bottom rack.
local function buildRamp(b: Builder, theme)
	local z0, z1 = BOTTOM_RACK_Z[1] - 5, BOTTOM_RACK_Z[1]
	local wedge = Instance.new("WedgePart")
	wedge.Name = "Ramp"
	wedge.Size = Vector3.new(RACK_HALF_X * 2 - 20, BOTTOM_RACK_Y, z1 - z0)
	-- A wedge slopes down toward its LookVector, so point that at the door: low end by the drain,
	-- high end at the rack.
	wedge.CFrame = footprint(b.origin, 0, BOTTOM_RACK_Y / 2, (z0 + z1) / 2, -b.origin.LookVector)
	wedge.Color = theme.Rack
	wedge.Material = Enum.Material.DiamondPlate
	wedge.Anchored = true
	wedge.CanTouch = false
	wedge.CanQuery = false
	wedge.Parent = b.model
	b.count += 1
end

local function buildCutleryBasket(b: Builder, theme)
	local c, h = BASKET_CENTER, BASKET_HALF
	local y0 = BOTTOM_RACK_Y
	span(b, "BasketBase", c.X - h.X, c.X + h.X, y0, y0 + 0.6, c.Z - h.Z, c.Z + h.Z, theme.Rack)
	local props = { CanCollide = true, Transparency = 0.2 }
	span(b, "BasketWall", c.X - h.X - 0.5, c.X - h.X, y0, y0 + h.Y, c.Z - h.Z, c.Z + h.Z, theme.Rack, Enum.Material.DiamondPlate, props)
	span(b, "BasketWall", c.X + h.X, c.X + h.X + 0.5, y0, y0 + h.Y, c.Z - h.Z, c.Z + h.Z, theme.Rack, Enum.Material.DiamondPlate, props)
	span(b, "BasketWall", c.X - h.X, c.X + h.X, y0, y0 + h.Y, c.Z - h.Z - 0.5, c.Z - h.Z, theme.Rack, Enum.Material.DiamondPlate, props)
	span(b, "BasketWall", c.X - h.X, c.X + h.X, y0, y0 + h.Y, c.Z + h.Z, c.Z + h.Z + 0.5, theme.Rack, Enum.Material.DiamondPlate, props)
	-- Handle arching over the middle.
	span(b, "BasketHandle", c.X - 0.4, c.X + 0.4, y0 + h.Y, y0 + h.Y + 5, c.Z - h.Z, c.Z - h.Z + 0.8, theme.Rack, nil, noCollide())
	span(b, "BasketHandle", c.X - 0.4, c.X + 0.4, y0 + h.Y, y0 + h.Y + 5, c.Z + h.Z - 0.8, c.Z + h.Z, theme.Rack, nil, noCollide())
	span(b, "BasketHandle", c.X - 0.4, c.X + 0.4, y0 + h.Y + 4.2, y0 + h.Y + 5, c.Z - h.Z, c.Z + h.Z, theme.Rack, nil, noCollide())
end

local function sprayEmitter(parent: Instance, rate: number, speed: number, direction: Enum.NormalId)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = "Spray"
	emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	emitter.Color = ColorSequence.new(Color3.fromRGB(200, 235, 255))
	emitter.LightEmission = 0.25
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.28), NumberSequenceKeypoint.new(1, 0.12) })
	emitter.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(0.8, 0.5), NumberSequenceKeypoint.new(1, 1) })
	emitter.Lifetime = NumberRange.new(0.9, 1.4)
	emitter.Rate = rate
	emitter.Speed = NumberRange.new(speed * 0.8, speed)
	emitter.SpreadAngle = Vector2.new(18, 18)
	emitter.Acceleration = Vector3.new(0, -45, 0)
	emitter.EmissionDirection = direction
	emitter.Parent = parent
end

-- The spray arms spin (client side, tag SpinY) and throw arcs of droplets up into the load. A thin
-- drizzle falls from the ceiling. Kept light so it never gets in the way of aiming.
local function buildSprayArms(b: Builder, theme)
	for _, y in { 2, TOP_RACK_Y - 3 } do
		cyl(b, "ArmHub", 1.5, 5, 0, y, 10, theme.Metal, Enum.Material.Metal, noCollide())
		local length = RACK_HALF_X * 1.6
		local arm = box(b, "SprayArm", Vector3.new(length, 0.9, 3), 0, y, 10, theme.Metal, Enum.Material.Metal, noCollide())
		arm:SetAttribute("SpinSpeed", if y &gt; 10 then 1.1 else 0.8)
		CollectionService:AddTag(arm, "SpinY")
		for _, f in { -0.42, -0.2, 0.2, 0.42 } do
			local attach = Instance.new("Attachment")
			attach.Position = Vector3.new(length * f, 0.5, 0)
			attach.Parent = arm
			sprayEmitter(attach, 5, if y &gt; 10 then 22 else 30, Enum.NormalId.Top)
		end
	end
	local drizzle = box(b, "Drizzle", Vector3.new(TUB_HALF_X * 1.8, 1, (TUB_Z_MAX - TUB_Z_MIN) * 0.9), 0, TUB_HEIGHT - 2, (TUB_Z_MIN + TUB_Z_MAX) / 2, theme.Light, nil, { Transparency = 1, CanCollide = false, CastShadow = false })
	sprayEmitter(drizzle, 14, 4, Enum.NormalId.Bottom)
end

-- Bubble lifts and the drain chute. The client teleports whoever steps on a pad (Effects).
local function buildLifts(b: Builder, theme)
	local function pad(name: string, from: Vector3, to: Vector3, label: string, columnHeight: number)
		local p = cyl(b, name, 0.4, 8, from.X, from.Y + 0.2, from.Z, theme.Accent, Enum.Material.Neon, noCollide())
		p:SetAttribute("LiftTo", worldPoint(b.origin, to.X, to.Y + 3, to.Z))
		CollectionService:AddTag(p, "LiftPad")
		local ring = cyl(b, name .. "Ring", 0.2, 10, from.X, from.Y + 0.1, from.Z, Color3.new(1, 1, 1), Enum.Material.Neon, noCollide())
		ring.Transparency = 0.4
		if columnHeight &gt; 0 then
			local column = cyl(b, name .. "Column", columnHeight, 7, from.X, from.Y + columnHeight / 2, from.Z, theme.Accent, Enum.Material.ForceField, noCollide())
			column.Transparency = 0.6
		end
		local emitter = Instance.new("ParticleEmitter")
		emitter.Texture = "rbxasset://textures/particles/forcefield_glow_main.dds"
		emitter.Color = ColorSequence.new(Color3.new(1, 1, 1))
		emitter.Lifetime = NumberRange.new(1.2, 2)
		emitter.Speed = NumberRange.new(8, 14)
		emitter.Rate = 10
		emitter.Size = NumberSequence.new(0.9, 0.3)
		emitter.SpreadAngle = Vector2.new(10, 10)
		emitter.EmissionDirection = if to.Y &gt; from.Y then Enum.NormalId.Right else Enum.NormalId.Left
		emitter.Parent = p
		sign(p, label, 12, 2.6, 7)
	end
	for _, lift in LIFTS do
		pad("BubbleLift", lift.from, lift.to, "Bubble Lift", TOP_RACK_Y)
	end
end

-- A real-looking sink drain: a chrome rim round a dark gap, a brushed steel strainer with a
-- centre hole, a ring of 6 holes and an outer ring of 12, and a thin film of swirling water.
local function buildDrain(b: Builder, _theme): Vector3
	local x, z = DRAIN_POS.X, DRAIN_POS.Z
	local chrome = Color3.fromRGB(196, 202, 210)
	local steel = Color3.fromRGB(165, 172, 180)
	local hole = Color3.fromRGB(18, 20, 24)
	local rim = cyl(b, "DrainGrate", 0.5, 15, x, 0.25, z, chrome, Enum.Material.Metal)
	rim.Reflectance = 0.25
	cyl(b, "DrainGap", 0.1, 12.4, x, 0.53, z, Color3.fromRGB(40, 44, 50), Enum.Material.SmoothPlastic, noCollide())
	local plate = cyl(b, "DrainStrainer", 0.12, 10.6, x, 0.6, z, steel, Enum.Material.Metal, noCollide())
	plate.Reflectance = 0.15
	cyl(b, "DrainHole", 0.04, 1.5, x, 0.68, z, hole, Enum.Material.SmoothPlastic, noCollide())
	for i = 1, 6 do
		local a = math.rad(i * 60)
		cyl(b, "DrainHole", 0.04, 1.3, x + math.cos(a) * 2.3, 0.68, z + math.sin(a) * 2.3, hole, Enum.Material.SmoothPlastic, noCollide())
	end
	for i = 1, 12 do
		local a = math.rad(i * 30 + 15)
		cyl(b, "DrainHole", 0.04, 1.05, x + math.cos(a) * 4.1, 0.68, z + math.sin(a) * 4.1, hole, Enum.Material.SmoothPlastic, noCollide())
	end
	-- Water swirling down it (spun by the client, SpinY).
	local ring = cyl(b, "DrainSwirl", 0.04, 9.6, x, 0.72, z, Color3.fromRGB(170, 220, 255), Enum.Material.Glass, noCollide())
	ring.Transparency = 0.7
	ring:SetAttribute("SpinSpeed", 2.4)
	CollectionService:AddTag(ring, "SpinY")
	local post = box(b, "DrainSign", Vector3.new(0.6, 0.6, 0.6), DRAIN_POS.X, 1, DRAIN_POS.Z, Color3.new(1, 1, 1), nil, { Transparency = 1, CanCollide = false })
	sign(post, "DRAIN\nstand here to sell", 16, 5, 8, Color3.fromRGB(150, 230, 255))
	return worldPoint(b.origin, DRAIN_POS.X, 0, DRAIN_POS.Z)
end

----------------------------------------------------------------------------------------------------
-- Tool shop on the door (walk up to a tool and press the prompt to buy it) and the upgrade book.
----------------------------------------------------------------------------------------------------

-- A SurfaceGui sign on a real part, facing `facing` (so it never floats, sinks or flickers).
local function signBoard(b: Builder, name: string, size: Vector3, pos: Vector3, facing: Vector3, color: Color3): (Part, SurfaceGui)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = CFrame.lookAt(pos, pos + facing)
	p.Color = color
	p.Material = Enum.Material.SmoothPlastic
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Parent = b.model
	b.count += 1
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.LightInfluence = 0
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 60
	gui.Parent = p
	return p, gui
end

local function guiText(parent: Instance, name: string, text: string, pos: UDim2, size: UDim2, color: Color3): TextLabel
	local label = Instance.new("TextLabel")
	label.Name = name
	label.BackgroundTransparency = 1
	label.Position = pos
	label.Size = size
	label.Font = Enum.Font.LuckiestGuy
	label.TextScaled = true
	label.TextColor3 = color
	label.Text = text
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 3
	stroke.Color = Color3.fromRGB(12, 30, 60)
	stroke.Parent = label
	label.Parent = parent
	return label
end

-- The Tool Shop: a chrome wire shelving unit (it matches the dishwasher racks) standing on the
-- left of the open door, facing the players. One shelf holding every tool, a price tag on the front
-- lip of each spot, a sign on top. Buy any tool in any order with the prompt.
local function buildShop(b: Builder, theme, levelIndex: number): Vector3
	local z0, z1 = SHOP_Z[1], SHOP_Z[2]
	local depth = 9
	local x0, x1 = SHOP_X - depth / 2, SHOP_X + depth / 2 -- x1 is the front, facing the players
	local toPlayers = b.origin.RightVector
	local chrome = Color3.fromRGB(215, 220, 228)
	-- One waist-high display shelf for a ~5 stud character, with the unit's top just above head height.
	local shelfYs = { 4 }
	local topY = 13.5
	local TOOL_SCALE = 1.45

	-- Four corner posts plus a middle pair, floor to top, with little feet.
	for _, x in { x0, x1 } do
		for _, z in { z0, (z0 + z1) / 2, z1 } do
			cyl(b, "ShelfPost", topY, 0.7, x, topY / 2, z, chrome, Enum.Material.Metal)
			cyl(b, "ShelfFoot", 0.4, 1.3, x, 0.2, z, Color3.fromRGB(60, 62, 70), nil, noCollide())
		end
	end
	-- Shelves: a solid (invisible-ish) board so things rest on something, plus wire detail.
	for _, y in shelfYs do
		span(b, "ShelfBoard", x0, x1, y - 0.25, y, z0, z1, Color3.fromRGB(235, 238, 242), Enum.Material.DiamondPlate, { Transparency = 0.25 })
		for _, x in { x0, x1 } do
			span(b, "ShelfRail", x - 0.2, x + 0.2, y, y + 0.9, z0, z1, chrome, Enum.Material.Metal, noCollide())
		end
		for z = z0 + 3, z1 - 3, 3 do
			span(b, "ShelfWire", x0, x1, y + 0.01, y + 0.07, z - 0.08, z + 0.08, chrome, Enum.Material.Metal, noCollide())
		end
	end
	span(b, "ShelfTop", x0 - 0.3, x1 + 0.3, topY, topY + 0.4, z0 - 0.3, z1 + 0.3, chrome, Enum.Material.Metal)

	-- Sign across the top.
	local _, headerGui = signBoard(b, "ShopSign", Vector3.new(z1 - z0 - 4, 4, 0.5), worldPoint(b.origin, x1 - 0.5, topY + 2.6, (z0 + z1) / 2), toPlayers, theme.Accent)
	guiText(headerGui, "Title", "TOOL SHOP  •  any tool, any order", UDim2.fromScale(0.03, 0.1), UDim2.fromScale(0.94, 0.8), Color3.new(1, 1, 1))

	-- Every tool you can buy stands on the waist-high shelf (easy to reach and read from the door).
	-- Spots run from the front of the unit to the back.
	local buyable = #Config.Tools - 1
	local gap = (z1 - z0) / buyable
	local spots = {}
	for k = 1, buyable do
		spots[k + 1] = { y = shelfYs[1], z = z1 - gap * (k - 0.5) }
	end
	for i = 2, #Config.Tools do
		local tool = Config.Tools[i]
		local spot = spots[i]
		if not spot then
			break
		end
		-- Pedestal and glow sit a hair above the see-through shelf board, and the glow's faces never
		-- share a plane with the board or pedestal (that used to flicker as you moved).
		local riser = 0.4
		local pedestal = cyl(b, "Pedestal", riser, 6.4, SHOP_X - 0.5, spot.y + 0.03 + riser / 2, spot.z, Color3.new(1, 1, 1), nil, noCollide())
		pedestal.Name = "ToolDisplay_" .. i
		cyl(b, "PedestalGlow", 0.12, 7, SHOP_X - 0.5, spot.y + 0.2, spot.z, tool.Color, Enum.Material.Neon, noCollide())
		local okModel, model = pcall(ToolModels.Build, i, TOOL_SCALE)
		if okModel and model then
			local basePos = worldPoint(b.origin, SHOP_X - 0.5, spot.y + 0.03 + riser, spot.z)
			model:PivotTo(CFrame.lookAt(basePos, basePos + toPlayers) * CFrame.Angles(0, math.rad(25), 0))
			model.Parent = b.model
			b.count += #model:GetChildren()
		end

		local cost = Config.ToolCost(i, levelIndex) or 0
		-- Price tag: a camera-facing card floating just in front of the tool's own shelf, at the same
		-- height above the shelf on both shelves, so each tag clearly belongs to the tool above it.
		local tagY = spot.y + 1.3
		local tag = box(b, "PriceTag_" .. i, Vector3.new(0.2, 0.2, 0.2), x1 + 1.6, tagY, spot.z, Color3.new(1, 1, 1), nil, { Transparency = 1, CanCollide = false, CastShadow = false })
		tag:SetAttribute("ToolIndex", i)
		local card = Instance.new("BillboardGui")
		card.Name = "Tag"
		card.Size = UDim2.fromScale(6.4, 2.3)
		card.LightInfluence = 0
		card.MaxDistance = 70
		card.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
		card.Parent = tag
		local bg = Instance.new("Frame")
		bg.Size = UDim2.fromScale(1, 1)
		bg.BackgroundColor3 = Color3.fromRGB(22, 44, 78)
		bg.BackgroundTransparency = 0.1
		bg.ZIndex = 0
		bg.Parent = card
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0.25, 0)
		corner.Parent = bg
		local stroke = Instance.new("UIStroke")
		stroke.Thickness = 2
		stroke.Color = tool.Color
		stroke.Parent = bg
		guiText(card, "Title", tool.Icon .. " " .. tool.Name, UDim2.fromScale(0.05, 0.06), UDim2.fromScale(0.9, 0.46), Color3.new(1, 1, 1))
		guiText(card, "Price", Format.Short(cost) .. " coins", UDim2.fromScale(0.05, 0.5), UDim2.fromScale(0.9, 0.44), Color3.fromRGB(255, 210, 60))

		local prompt = Instance.new("ProximityPrompt")
		prompt.ActionText = "Buy"
		prompt.ObjectText = string.format("%s  (%s coins)", tool.Name, Format.Short(cost))
		prompt.HoldDuration = 0
		prompt.RequiresLineOfSight = false
		prompt.MaxActivationDistance = 14
		prompt:SetAttribute("BuyTool", i)
		prompt.Parent = pedestal
	end

	return worldPoint(b.origin, SHOP_X + depth, 0, (z0 + z1) / 2)
end

----------------------------------------------------------------------------------------------------
-- Dish layout
----------------------------------------------------------------------------------------------------

type PlacedDish = {
	Id: number,
	Kind: string,
	Model: Model,
	Grime: { BasePart },
	Center: Vector3,
}

type Slot = { x: number, y: number, z: number }

local function grid(xs: { number }, zs: { number }, y: number): { Slot }
	local slots = {}
	for _, z in zs do
		for _, x in xs do
			table.insert(slots, { x = x, y = y, z = z })
		end
	end
	return slots
end

-- Front-to-back, filling every row a little before moving back, so small loads still look spread out.
local function plateSlots(): { Slot }
	local slots = {}
	for _, z in PLATE_Z do
		for _, x in PLATE_ROW_X do
			table.insert(slots, { x = x, y = BOTTOM_RACK_Y, z = z })
		end
	end
	return slots
end

local function listSlots(list: { { x: number, z: number } }): { Slot }
	local slots = {}
	for _, s in list do
		table.insert(slots, { x = s.x, y = BOTTOM_RACK_Y, z = s.z })
	end
	return slots
end

-- Cutlery shares one basket: each kind takes every third slot so the basket looks mixed.
local function basketSlots(offset: number): { Slot }
	local all = grid(BASKET_X, BASKET_Z, BOTTOM_RACK_Y + 0.6)
	local slots = {}
	for i = offset, #all, 3 do
		table.insert(slots, all[i])
	end
	return slots
end

-- Trays share the plate rows, filling from the back (Plate + Tray must fit the 27 plate slots).
local function traySlots(): { Slot }
	local all = plateSlots()
	local slots = {}
	for i = #all, 1, -1 do
		table.insert(slots, all[i])
	end
	return slots
end

local KIND_SLOTS: { [string]: () -&gt; { Slot } } = {
	Plate = plateSlots,
	Tray = traySlots,
	Bowl = function()
		return grid(BOWL_X, BOWL_Z, TOP_RACK_Y)
	end,
	Cup = function()
		return grid(CUP_X, CUP_Z, TOP_RACK_Y)
	end,
	Glass = function()
		return grid(GLASS_X, GLASS_Z, TOP_RACK_Y)
	end,
	Goblet = function()
		return grid(GLASS_X, GLASS_Z, TOP_RACK_Y)
	end,
	Pan = function()
		return listSlots(PAN_SLOTS)
	end,
	Pot = function()
		return listSlots(POT_SLOTS)
	end,
	Fork = function()
		return basketSlots(1)
	end,
	Knife = function()
		return basketSlots(2)
	end,
	Spoon = function()
		return basketSlots(3)
	end,
	-- Pizza boards stand in the plate rows (from the back, around the trays); pizza cutters go in
	-- the cutlery basket's spare slots from the far end.
	Board = traySlots,
	Cutter = function()
		local all = grid(BASKET_X, BASKET_Z, BOTTOM_RACK_Y + 0.6)
		local slots = {}
		for i = #all, 1, -1 do
			table.insert(slots, all[i])
		end
		return slots
	end,
}

-- The CFrame DishFactory builds a dish at: contact point + orientation for that kind.
local function dishFrame(origin: CFrame, kind: string, slot: Slot, rng: Random): CFrame
	local toDoor = -origin.LookVector
	if kind == "Plate" or kind == "Tray" or kind == "Board" then
		-- Plates face the door, with a tiny random lean so the rows don't look copy-pasted.
		return footprint(origin, slot.x, slot.y, slot.z, toDoor) * CFrame.Angles(math.rad(rng:NextNumber(-4, 4)), 0, 0)
	elseif kind == "Bowl" then
		-- Lean the opening toward the door so the inside is visible and reachable.
		local r = DishFactory.Size("Bowl").Diameter / 2
		local lift = r * (1 - math.cos(BOWL_TILT)) + 0.2
		return footprint(origin, slot.x, slot.y + lift, slot.z) * CFrame.Angles(BOWL_TILT, 0, 0)
	elseif kind == "Pan" then
		local r = DishFactory.Size("Pan").Diameter / 2
		local lift = r * math.sin(PAN_TILT) + 0.2
		-- Spin about the pan's own axis so the handle points up and back, away from the pots.
		return footprint(origin, slot.x, slot.y + lift, slot.z) * CFrame.Angles(PAN_TILT, 0, 0) * CFrame.Angles(0, math.pi / 2, 0)
	elseif kind == "Fork" or kind == "Knife" or kind == "Spoon" or kind == "Cutter" then
		return footprint(origin, slot.x, slot.y, slot.z, toDoor) * CFrame.Angles(0, math.rad(rng:NextNumber(-20, 20)), math.rad(rng:NextNumber(-6, 6)))
	end
	return footprint(origin, slot.x, slot.y, slot.z, toDoor) * CFrame.Angles(0, rng:NextNumber() * math.pi * 2, 0)
end

----------------------------------------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------------------------------------

function ArenaBuilder.Init()
	getArenasFolder()
end

function ArenaBuilder.SlotOrigin(slot: number): CFrame
	-- A grid, four to a row: the Backyard's mountains reach well past its own patio, so neighbours
	-- are far apart (x by ArenaSpacing.X, the second row by ArenaSpacing.Z).
	local w = Config.World
	local col, row = (slot - 1) % 4, (slot - 1) // 4
	local pos = w.ArenaRowStart + Vector3.new(w.ArenaSpacing.X * col, 0, w.ArenaSpacing.Z * row)
	return CFrame.new(pos)
end

function ArenaBuilder.Build(slot: number, levelIndex: number, options: { GrimeScale: number, GoldenChance: number, HpScale: number? }): any
	assert(type(slot) == "number", "ArenaBuilder.Build: slot must be a number")
	local level = Config.GetLevel(levelIndex)
	-- The dishwasher is the same machine in every level (one steel tub, white racks, blue glow);
	-- only the room around it changes. The level's own theme still colours the dishes.
	local dishTheme = level.Theme
	local theme = setmetatable({
		Tub = Color3.fromRGB(172, 178, 187),
		Rack = Color3.fromRGB(235, 240, 245),
		Metal = Color3.fromRGB(190, 195, 200),
		Accent = Color3.fromRGB(80, 170, 255),
		Light = Color3.fromRGB(215, 235, 255),
		Sink = false,
	}, { __index = dishTheme }) :: any
	if levelIndex == 3 then
		-- The Royal Banquet's "machine" is an olden-day oak wash trough with iron racks.
		theme.Tub = Color3.fromRGB(112, 78, 50)
		theme.Rack = Color3.fromRGB(58, 56, 62)
		theme.Metal = Color3.fromRGB(70, 68, 74)
		theme.Accent = Color3.fromRGB(255, 205, 90)
		theme.Light = Color3.fromRGB(255, 220, 160)
		theme.Trough = true
	end
	if levelIndex == 2 then
		-- The Backyard's basin is a white porcelain sink.
		theme.Tub = Color3.fromRGB(238, 240, 242)
		theme.Rack = Color3.fromRGB(205, 215, 225)
		theme.Sink = true
	end
	-- The Backyard (level 2) is a shallow sink in a low outdoor counter; the others are full dishwashers.
	ROOM_HALF_X = if levelIndex == 3 then 780 else 420
	ROOM_Z_FRONT = if levelIndex == 3 then -1000 else -520
	ROOM_HEIGHT = if levelIndex == 3 then 860 else 520
	TUB_HEIGHT = if levelIndex == 2 then 34 else 100
	COUNTER_TOP_Y = if levelIndex == 2 then 40 else 112
	local origin = ArenaBuilder.SlotOrigin(slot)
	local rng = Random.new()
	local grimeScale = (options and options.GrimeScale) or 1
	local hpScale = (options and (options :: any).HpScale) or 1
	local goldenChance = (options and options.GoldenChance) or level.GoldenChance

	local arenasFolder = getArenasFolder()
	local name = "Arena_" .. slot
	local existing = arenasFolder:FindFirstChild(name)
	if existing then
		existing:Destroy()
	end

	local model = Instance.new("Model")
	model.Name = name
	model.Parent = arenasFolder -- live in workspace now, so dish raycasts work as we build

	local dishesFolder = Instance.new("Folder")
	dishesFolder.Name = "Dishes"
	dishesFolder.Parent = model

	local grimeFolder = Instance.new("Folder")
	grimeFolder.Name = "Grime"
	grimeFolder.Parent = model

	local b: Builder = { model = model, origin = origin, count = 0 }
	local pending = 0
	local function yieldTick()
		if b.count - pending &gt;= YIELD_EVERY then
			pending = b.count
			task.wait()
		end
	end

	buildRoom(b, levelIndex)
	yieldTick()
	buildTub(b, theme)
	buildDoor(b, theme)
	yieldTick()
	buildRack(b, theme, BOTTOM_RACK_Y, BOTTOM_RACK_Z, true)
	yieldTick()
	buildRack(b, theme, TOP_RACK_Y, TOP_RACK_Z, true)
	yieldTick()
	buildTines(b, theme)
	buildRamp(b, theme)
	buildCutleryBasket(b, theme)
	buildSprayArms(b, theme)
	buildLifts(b, theme)
	local drainPos = buildDrain(b, theme)
	local stationPos = buildShop(b, theme, levelIndex)
	yieldTick()

	local dishes: { [number]: PlacedDish } = {}
	local takenSlots: { [string]: boolean } = {} -- slots already holding a dish (kinds can share rows)
	local nextId = 0
	local totalGrime = 0
	for _, kind in Config.DishKinds do
		local wantCount = level.Dishes[kind] or 0
		local slotsFn = KIND_SLOTS[kind]
		if wantCount &gt; 0 and slotsFn then
			local spotsPerDish = math.max(1, math.floor((level.Spots[kind] or 1) * grimeScale + 0.5))
			local slots = {}
			for _, candidate in slotsFn() do
				local key = candidate.x .. "," .. candidate.y .. "," .. candidate.z
				if not takenSlots[key] then
					table.insert(slots, candidate)
				end
			end
			if wantCount &gt; #slots then
				warn(string.format("[ArenaBuilder] Only %d slots for %d %s; filling what fits", #slots, wantCount, kind))
			end
			for i = 1, math.min(wantCount, #slots) do
				takenSlots[slots[i].x .. "," .. slots[i].y .. "," .. slots[i].z] = true
				local cf = dishFrame(origin, kind, slots[i], rng)
				local dish = DishFactory.BuildDish(kind, cf, dishTheme, rng)
				dish.Parent = dishesFolder

				nextId += 1
				local grime = DishFactory.ApplyGrime(dish, nextId, spotsPerDish, levelIndex, rng, goldenChance, grimeFolder, hpScale)
				dishes[nextId] = {
					Id = nextId,
					Kind = kind,
					Model = dish,
					Grime = grime,
					Center = dish:GetPivot().Position,
				}
				totalGrime += #grime
				b.count += #dish:GetChildren() + #grime * 5
				yieldTick()
			end
		end
	end

	model:SetAttribute("Level", levelIndex)
	model:SetAttribute("Origin", origin.Position) -- where the room is (LevelNPCs puts the giants in it)
	model:SetAttribute("Total", totalGrime)
	model:SetAttribute("Cleaned", 0)

	local spawns: { CFrame } = {}
	for _, x in { -14, -10, -6, -2, 2, 6, 10, 14 } do -- one spot per party member (up to 8)
		table.insert(spawns, footprint(origin, x, 0.5, SPAWN_Z))
	end

	local arena = {
		Slot = slot,
		Name = name,
		Model = model,
		Origin = origin,
		Spawns = spawns,
		DrainPosition = drainPos,
		DrainRadius = Config.Round.DrainRadius,
		StationPosition = stationPos,
		GrimeFolder = grimeFolder,
		Dishes = dishes,
		TotalGrime = totalGrime,
		KillY = origin.Position.Y - 14, -- the kitchen floor is at -24
	}
	return arena
end

function ArenaBuilder.Destroy(arena: any)
	if not arena then
		return
	end
	if typeof(arena.Model) == "Instance" and arena.Model.Parent then
		arena.Model:Destroy()
	end
end

return ArenaBuilder</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000012"><Properties><string name="Name">BadgeAwards</string><ProtectedString name="Source">--[[
	BadgeAwards - gives the Roblox badges in Config.Badges (IDs in StoreIds &gt; Badges).

	Every few seconds (and right after a save loads) each player's profile is checked against the
	badge rules below. A badge that's earned and has an ID is awarded with BadgeService and noted in
	the profile (BadgesGot) so it's never asked for twice. Badges without an ID yet are skipped and
	not noted, so they're handed out as soon as the ID is pasted in, including for things players
	did before the badge existed. Roblox shows its own "badge awarded" pop-up.
]]

local BadgeService = game:GetService("BadgeService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))

local DataService = require(script.Parent:WaitForChild("DataService"))

local BadgeAwards = {}

local CHECK_EVERY = 5
local DISH_MASTER = 1000

local initialized = false
local awarding: { [Player]: { [string]: boolean } } = {}

local function bestRankOrder(profile: any): number
	local best = 0
	local function consider(id: any)
		local rank = if type(id) == "string" then Config.GetRank(id) else nil
		local rarity = rank and Config.RankRarities[rank.Rarity]
		if rarity then
			best = math.max(best, rarity.Order)
		end
	end
	consider(profile.Rank)
	for _, id in profile.Ranks or {} do
		consider(id)
	end
	return best
end

-- Has this player earned the badge? (Only reads the profile.)
local RULES: { [string]: (any) -&gt; boolean } = {
	Welcome = function()
		return true
	end,
	Level1 = function(p)
		return DataService.LevelsBeaten(p) &gt;= 1
	end,
	Level2 = function(p)
		return DataService.LevelsBeaten(p) &gt;= 2
	end,
	Level3 = function(p)
		return DataService.LevelsBeaten(p) &gt;= 3
	end,
	FirstPet = function(p)
		return #(p.Pets or {}) &gt; 0 or ((p.Stats and p.Stats.EggsHatched) or 0) &gt; 0
	end,
	GoldenPet = function(p)
		for _, pet in p.Pets or {} do
			if (tonumber(pet.Tier) or 1) &gt;= 2 then
				return true
			end
		end
		return false
	end,
	Rebirth = function(p)
		return (p.Rebirths or 0) &gt; 0
	end,
	LegendRank = function(p)
		return bestRankOrder(p) &gt;= Config.RankRarities.Legendary.Order
	end,
	Club = function(p)
		return type(p.ClubId) == "string" and p.ClubId ~= ""
	end,
	DishMaster = function(p)
		return ((p.Stats and p.Stats.DishesCleaned) or 0) &gt;= DISH_MASTER
	end,
}
BadgeAwards.Rules = RULES

local function award(player: Player, badge: any)
	local busy = awarding[player]
	if not busy or busy[badge.Key] then
		return
	end
	busy[badge.Key] = true
	task.spawn(function()
		local ok, result = pcall(function()
			return BadgeService:AwardBadge(player.UserId, badge.Id)
		end)
		local profile = DataService.Get(player)
		if ok and profile then
			-- true = given now. false usually means they already had it: note it either way.
			profile.BadgesGot[badge.Key] = true
		elseif not ok then
			warn(string.format("[BadgeAwards] %s for %s: %s", badge.Key, player.Name, tostring(result)))
		end
		task.wait(if ok then 0 else 60) -- a failed award is tried again a minute later
		if awarding[player] then
			awarding[player][badge.Key] = nil
		end
	end)
end

function BadgeAwards.Check(player: Player)
	local profile = DataService.Get(player)
	if not profile or type(profile.BadgesGot) ~= "table" then
		return
	end
	for _, badge in Config.Badges do
		local rule = RULES[badge.Key]
		if type(badge.Id) == "number" and badge.Id &gt; 0 and not profile.BadgesGot[badge.Key] and rule then
			local ok, earned = pcall(rule, profile)
			if ok and earned then
				award(player, badge)
			end
		end
	end
end

function BadgeAwards.Init()
	if initialized then
		return
	end
	initialized = true
	Players.PlayerAdded:Connect(function(player)
		awarding[player] = {}
	end)
	for _, player in Players:GetPlayers() do
		awarding[player] = {}
	end
	Players.PlayerRemoving:Connect(function(player)
		awarding[player] = nil
	end)
	DataService.ProfileLoaded:Connect(function(player)
		task.defer(BadgeAwards.Check, player)
	end)
end

function BadgeAwards.Start()
	task.spawn(function()
		while true do
			task.wait(CHECK_EVERY)
			for _, player in Players:GetPlayers() do
				pcall(BadgeAwards.Check, player)
			end
		end
	end)
end

return BadgeAwards</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000013"><Properties><string name="Name">Characters</string><ProtectedString name="Source">-- Character helpers shared by every server service: collision groups, teleporting,
-- walk speed that survives respawns, and "where should this player respawn".

local Players = game:GetService("Players")
local PhysicsService = game:GetService("PhysicsService")

local Characters = {}

Characters.Groups = {
	Players = "Players", -- every character by default (players never collide with each other)
	PartyMember = "PartyMember", -- characters waiting inside a party pad (the pad's walls block them)
	PadBarrier = "PadBarrier", -- pad walls: only block PartyMember
	NoCollide = "NoCollide", -- decoration / grime / effects: collide with nothing
}

local groupOf: { [Player]: string } = {}
local walkSpeedOf: { [Player]: number? } = {}
local respawnResolvers: { (Player) -&gt; CFrame? } = {}

local function registerGroup(name: string)
	local ok = pcall(function()
		if not workspace:IsCollisionGroupRegistered(name) then
			workspace:RegisterCollisionGroup(name)
		end
	end)
	if not ok then
		-- Older engines: collision groups still live on PhysicsService.
		pcall(function()
			if not PhysicsService:IsCollisionGroupRegistered(name) then
				PhysicsService:RegisterCollisionGroup(name)
			end
		end)
	end
end

local function setCollidable(a: string, b: string, collidable: boolean)
	local ok = pcall(function()
		workspace:CollisionGroupSetCollidable(a, b, collidable)
	end)
	if not ok then
		pcall(function()
			PhysicsService:CollisionGroupSetCollidable(a, b, collidable)
		end)
	end
end

local function applyGroup(character: Model, group: string)
	for _, d in character:GetDescendants() do
		if d:IsA("BasePart") then
			d.CollisionGroup = group
		end
	end
end

local function onCharacterAdded(player: Player, character: Model)
	applyGroup(character, groupOf[player] or Characters.Groups.Players)
	-- Accessories and tools arrive after CharacterAdded; keep them in the same group.
	character.DescendantAdded:Connect(function(d)
		if d:IsA("BasePart") then
			d.CollisionGroup = groupOf[player] or Characters.Groups.Players
		end
	end)

	local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
	local speed = walkSpeedOf[player]
	if humanoid and speed then
		humanoid.WalkSpeed = speed
	end

	-- A fresh character that hangs in the air (spawned a bit high, or held there while things load) is put
	-- on the ground straight away instead of floating for a second.
	task.spawn(function()
		local root = character:WaitForChild("HumanoidRootPart", 10) :: BasePart?
		if not humanoid or not root then
			return
		end
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { character }
		for _ = 1, 30 do
			task.wait(0.1)
			if not character.Parent or humanoid.Health &lt;= 0 then
				return
			end
			if humanoid.FloorMaterial == Enum.Material.Air and math.abs(root.AssemblyLinearVelocity.Y) &lt; 1 and not root:FindFirstChildOfClass("LinearVelocity") then
				local hit = workspace:Raycast(root.Position, Vector3.new(0, -40, 0), params)
				if hit then
					local gap = root.Position.Y - hit.Position.Y - (humanoid.HipHeight + root.Size.Y / 2)
					if gap &gt; 0.4 then
						character:PivotTo(character:GetPivot() - Vector3.new(0, gap, 0))
						root.AssemblyLinearVelocity = Vector3.zero
					end
				end
			end
		end
	end)

	-- Let services decide where this player should be (party pad, dishwasher, lobby).
	task.defer(function()
		for _, resolve in respawnResolvers do
			local ok, cf = pcall(resolve, player)
			if ok and cf then
				Characters.Teleport(player, cf)
				break
			end
		end
	end)
end

-- Call once from Main before anything else touches characters.
function Characters.Setup()
	for _, name in Characters.Groups :: { [string]: string } do
		registerGroup(name)
	end
	local g = Characters.Groups
	setCollidable(g.Players, g.Players, false)
	setCollidable(g.Players, g.PartyMember, false)
	setCollidable(g.PartyMember, g.PartyMember, false)
	setCollidable(g.PadBarrier, "Default", false)
	setCollidable(g.PadBarrier, g.Players, false)
	setCollidable(g.PadBarrier, g.PartyMember, true)
	setCollidable(g.PadBarrier, g.NoCollide, false)
	for _, other in { "Default", g.Players, g.PartyMember, g.NoCollide } do
		setCollidable(g.NoCollide, other, false)
	end

	local function hook(player: Player)
		player.CharacterAdded:Connect(function(character)
			onCharacterAdded(player, character)
		end)
		if player.Character then
			onCharacterAdded(player, player.Character)
		end
	end
	Players.PlayerAdded:Connect(hook)
	for _, p in Players:GetPlayers() do
		hook(p)
	end
	Players.PlayerRemoving:Connect(function(p)
		groupOf[p] = nil
		walkSpeedOf[p] = nil
	end)
end

-- Put a player's character (now and after every respawn) into a collision group.
function Characters.SetGroup(player: Player, group: string)
	groupOf[player] = group
	if player.Character then
		applyGroup(player.Character, group)
	end
end

function Characters.GetRoot(player: Player): BasePart?
	local character = player.Character
	if not character then
		return nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health &lt;= 0 then
		return nil
	end
	return character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

function Characters.IsAlive(player: Player): boolean
	return Characters.GetRoot(player) ~= nil
end

-- Moves a character to stand at `cframe` (feet roughly at cframe.Position). Returns false if the
-- player has no living character. Velocity is cleared so nobody keeps flying after a teleport.
function Characters.Teleport(player: Player, cframe: CFrame): boolean
	local character = player.Character
	local root = Characters.GetRoot(player)
	if not character or not root then
		return false
	end
	if workspace.StreamingEnabled then
		pcall(function()
			player:RequestStreamAroundAsync(cframe.Position, 2)
		end)
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local lift = (humanoid and humanoid.HipHeight or 2) + root.Size.Y / 2 + 0.5
	character:PivotTo(cframe + Vector3.new(0, lift, 0))
	for _, d in character:GetDescendants() do
		if d:IsA("BasePart") then
			d.AssemblyLinearVelocity = Vector3.zero
			d.AssemblyAngularVelocity = Vector3.zero
		end
	end
	return true
end

-- Walk speed that is re-applied after every respawn. nil resets to the lobby default
-- (StarterPlayer.CharacterWalkSpeed, which Main sets from Config.World.LobbyWalkSpeed).
function Characters.SetWalkSpeed(player: Player, speed: number?)
	walkSpeedOf[player] = speed
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.WalkSpeed = speed or game:GetService("StarterPlayer").CharacterWalkSpeed
	end
end

--[[
	Register a function that says where a player should appear after (re)spawning.
	It returns a CFrame to teleport them there, or nil to let the next resolver (or the
	normal SpawnLocation) decide. Resolvers are asked in the order they were added.
]]
function Characters.AddRespawnResolver(resolver: (Player) -&gt; CFrame?)
	table.insert(respawnResolvers, resolver)
end

return Characters</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000014"><Properties><string name="Name">ClubService</string><ProtectedString name="Source">--[[
	ClubService - player clubs (the Clubs button), like other Roblox games' clans.

	  * Make one for Config.Clubs.CreateCost Gems: a name and a prefix (the short [TAG] shown in
	    front of members' names; both through Roblox's text filter, names unique), public or private,
	    and requirements: a level beaten (0-3) and a number of rebirths. Up to MaxMembers.
	  * Public clubs: anyone who meets the requirements joins from the lists. Private clubs: only with
	    the club code (members see it; the owner can make a new one).
	  * Roles: Owner, Co-Leader (the owner promotes members; co-leaders can kick members) and
	    Member. The owner can kick anyone. Leaving as owner hands the club to a co-leader (else the
	    longest member); the last one out closes it.
	  * The owner can rename the club and change the prefix, each once every RenameDays days (each
	    has its own timer; a brand new club can change straight away).
	  * Points: members DONATE Bubbles to their club (Donate button). Every donated Bubble is a point
	    for the club and for that member (the club leaderboard). TOP CLUBS is the top 25 clubs this
	    month.
	  * Monthly contest: on the 1st of every month (00:00 UTC) every club's points start again from
	    zero. The top 3 clubs' members each get Gems (Config.Clubs.Season.PrizeGems) and the winning
	    club's members also get a limited pet (Config.Clubs.Season.Pet). Prizes are claimed the next
	    time each member is in the game (profile ClubPrizeSeason says which month they got).
	  * Club chat: members only, filtered by Roblox's text filter, the last ChatKeep messages kept.

	Storage (DataStores; in Studio without API access everything lives in memory):
	  RinseCycleClubs        "club_&lt;id&gt;"   the club record (members, settings, points)
	                         "name_&lt;name&gt;" -&gt; id (names are unique, any case)
	                         "code_&lt;CODE&gt;" -&gt; id (club codes)
	                         "dir_&lt;c&gt;"     { [id] = summary } every club whose name starts with c
	                                       (FIND lists them alphabetically)
	                         "chat_&lt;id&gt;"   the club's chat history
	  RinseCycleClubPoints_&lt;YYYYMM&gt;  OrderedDataStore id -&gt; points (TOP CLUBS, one per month)
	                         "season_&lt;YYYYMM&gt;" the finished month's top 3 clubs and their members
	Other servers hear about kicks and chat over MessagingService ("RinseCycle_Club"); a player's club
	is also checked against the record every time they join.

	ClubRequest (C-&gt;S, action, value) -&gt; { Ok, Error?, Club?, Clubs?, Messages? }:
	  "Mine"  "Top"  "Info" (club id)  "Donate" (bubbles)  "Find" (text)  "Create" ({Name, Tag, Public, ReqLevel, ReqRebirths})
	  "Join" (club id)  "JoinCode" (code)  "Leave"  "Kick" (userId)  "Promote" / "Demote" (userId)
	  "Settings" ({Public, ReqLevel, ReqRebirths})  "Rename" ({Name?, Tag?})  "NewCode"
	  "Chat" (text)  "ChatHistory"
]]

local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local MessagingService = game:GetService("MessagingService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TextService = game:GetService("TextService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local DataService = require(script.Parent:WaitForChild("DataService"))

local ClubService = {}

local STORE = "RinseCycleClubs"
local POINTS_STORE = "RinseCycleClubPoints"
local TOPIC = "RinseCycle_Club"
local TOP_REFRESH = 120 -- seconds the TOP CLUBS list is cached
local DIR_REFRESH = 60 -- seconds a FIND directory shard is cached
local TOP_COUNT = 25
local FIND_COUNT = 30
local CHAT_GAP = 1.5 -- seconds between one player's chat messages
local CODE_CHARS = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789" -- no 0/O or 1/I

local initialized = false
local clubStore: DataStore? = nil
local pointsStores: { [string]: OrderedDataStore } = {}
local memory: { [string]: any } = {} -- Studio / no API access
local memoryPoints: { [string]: { [string]: number? } } = {} -- season -&gt; club id -&gt; points
local lastRequest: { [Player]: number } = {}
local lastChat: { [Player]: number } = {}
local topCache: { any } = {}
local topAt = -math.huge
local dirCache: { [string]: { At: number, Entries: any } } = {}
local donate: (Player, any) -&gt; any
local info: (Player, string) -&gt; any
local stateRemote: RemoteEvent
local chatRemote: RemoteEvent

----------------------------------------------------------------------------------------------------
-- Storage
----------------------------------------------------------------------------------------------------

local function useMemory(): boolean
	return clubStore == nil or DataService.IsOffline()
end

local function deepCopy(v: any): any
	if type(v) ~= "table" then
		return v
	end
	local t = {}
	for k, x in v do
		t[k] = deepCopy(x)
	end
	return t
end

local function get(key: string): (boolean, any)
	if useMemory() then
		return true, deepCopy(memory[key])
	end
	local store = clubStore :: DataStore
	return pcall(function()
		return (store:GetAsync(key))
	end)
end

-- Atomic edit. `fn(old)` returns the new value, or nil to change nothing. Returns (ok, newValue).
local function update(key: string, fn: (any) -&gt; any): (boolean, any)
	if useMemory() then
		local new = fn(deepCopy(memory[key]))
		if new ~= nil then
			memory[key] = deepCopy(new)
		end
		return true, new
	end
	local store = clubStore :: DataStore
	local result = nil
	local ok, err = pcall(function()
		store:UpdateAsync(key, function(old)
			result = fn(old)
			return result
		end)
	end)
	if not ok then
		warn("[ClubService] " .. key .. ": " .. tostring(err))
	end
	return ok, result
end

local function remove(key: string)
	if useMemory() then
		memory[key] = nil
		return
	end
	local store = clubStore :: DataStore
	pcall(function()
		store:RemoveAsync(key)
	end)
end

----------------------------------------------------------------------------------------------------
-- Seasons (one per calendar month, UTC)
----------------------------------------------------------------------------------------------------

local function now(): number
	local fn = (ClubService :: any).NowFn
	return if fn then fn() else os.time()
end

-- Days since 1970-01-01 for a civil date (no timezone involved).
local function daysFromCivil(y: number, m: number, d: number): number
	y -= if m &lt;= 2 then 1 else 0
	local era = (if y &gt;= 0 then y else y - 399) // 400
	local yoe = y - era * 400
	local doy = (153 * (m + (if m &gt; 2 then -3 else 9)) + 2) // 5 + d - 1
	local doe = yoe * 365 + yoe // 4 - yoe // 100 + doy
	return era * 146097 + doe - 719468
end

local function monthStart(y: number, m: number): number
	while m &gt; 12 do
		m -= 12
		y += 1
	end
	while m &lt; 1 do
		m += 12
		y -= 1
	end
	return daysFromCivil(y, m, 1) * 86400
end

local function seasonOf(t: number): string
	return os.date("!%Y%m", t)
end

local function currentSeason(): string
	return seasonOf(now())
end

local function previousSeason(): string
	local d = os.date("!*t", now())
	return seasonOf(monthStart(d.year, d.month - 1))
end

local function nextResetAt(): number
	local d = os.date("!*t", now())
	return monthStart(d.year, d.month + 1)
end

-- What the client shows about the contest: "October 2026", when it resets (unix, shown in the
-- player's own time), and the prizes.
local function seasonInfo(): any
	return { Label = os.date("!%B %Y", now()), ResetAt = nextResetAt(), Id = currentSeason() }
end

local function pointsStoreFor(season: string): OrderedDataStore?
	if pointsStores[season] then
		return pointsStores[season]
	end
	local ok, store = pcall(function()
		return DataStoreService:GetOrderedDataStore(POINTS_STORE .. "_" .. season)
	end)
	if ok then
		pointsStores[season] = store
		return store
	end
	return nil
end

local function setPoints(id: string, points: number?, season: string?)
	local key = season or currentSeason()
	if useMemory() then
		memoryPoints[key] = memoryPoints[key] or {}
		memoryPoints[key][id] = points
		return
	end
	local store = pointsStoreFor(key)
	if not store then
		return
	end
	local value = if points then math.floor(points) else nil
	pcall(function()
		if value then
			store:SetAsync(id, value)
		else
			store:RemoveAsync(id)
		end
	end)
end

local function topIds(season: string?, count: number?): { string }
	local key = season or currentSeason()
	local limit = count or TOP_COUNT
	local ids: { string } = {}
	if useMemory() then
		local pairsList: { { any } } = {}
		local bucket: { [string]: number? } = memoryPoints[key] or {}
		for id, points in bucket do
			table.insert(pairsList, { id :: any, points })
		end
		table.sort(pairsList, function(a, b)
			return a[2] &gt; b[2]
		end)
		for i = 1, math.min(limit, #pairsList) do
			ids[i] = pairsList[i][1]
		end
		return ids
	end
	local store = pointsStoreFor(key)
	if not store then
		return ids
	end
	local ok, page = pcall(function()
		return store:GetSortedAsync(false, limit):GetCurrentPage()
	end)
	if ok and type(page) == "table" then
		for _, entry in page do
			if entry.value &gt; 0 then
				table.insert(ids, entry.key)
			end
		end
	end
	return ids
end

----------------------------------------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------------------------------------

local function fail(message: string): any
	return { Ok = false, Error = message }
end

local function memberCount(club: any): number
	local n = 0
	for _ in club.Members do
		n += 1
	end
	return n
end

local function newCode(): string
	local chars = {}
	for i = 1, Config.Clubs.CodeLength do
		local k = math.random(1, #CODE_CHARS)
		chars[i] = string.sub(CODE_CHARS, k, k)
	end
	return table.concat(chars)
end

-- A club id: unique enough (time, the maker and a random part), short for DataStore keys.
local function newId(player: Player): string
	local ok, guid = pcall(function()
		return HttpService:GenerateGUID(false)
	end)
	if ok and type(guid) == "string" then
		return string.sub((string.gsub(guid, "-", "")), 1, 16)
	end
	return string.format("%x%x%04x", os.time(), player.UserId % 65536, math.random(0, 65535))
end

local function nameKey(name: string): string
	return "name_" .. string.lower((string.gsub(name, "%s+", " ")))
end

-- The FIND directory shard a name lives in: its first letter / digit.
local function dirKey(name: string): string
	local c = string.lower(string.sub(name, 1, 1))
	return "dir_" .. (if string.match(c, "%w") then c else "_")
end

local function cleanName(text: any): string
	if type(text) ~= "string" then
		return ""
	end
	local name = string.gsub(string.gsub(text, "^%s+", ""), "%s+$", "")
	return (string.gsub(name, "%s+", " "))
end

local function cleanTag(text: any): string
	if type(text) ~= "string" then
		return ""
	end
	return string.upper((string.gsub(text, "%s+", "")))
end

local function checkName(name: string): string?
	local rules = Config.Clubs
	if utf8.len(name) == nil or #name &lt; rules.NameLength[1] or #name &gt; rules.NameLength[2] then
		return string.format("Club names are %d to %d letters.", rules.NameLength[1], rules.NameLength[2])
	end
	if not string.match(name, "^[%w ]+$") then
		return "Club names use letters, numbers and spaces only."
	end
	return nil
end

local function checkTag(tag: string): string?
	local rules = Config.Clubs
	if #tag &lt; rules.TagLength[1] or #tag &gt; rules.TagLength[2] or not string.match(tag, "^%w+$") then
		return string.format("Prefixes are %d to %d letters or numbers.", rules.TagLength[1], rules.TagLength[2])
	end
	return nil
end

-- Roblox's text filter. Anything it would hide (or a failed check outside Studio) is refused.
local function filterOk(player: Player, text: string): (boolean, string?)
	local ok, filtered = pcall(function()
		return TextService:FilterStringAsync(text, player.UserId, Enum.TextFilterContext.PublicChat):GetNonChatStringForBroadcastAsync()
	end)
	if not ok then
		if RunService:IsStudio() then
			return true
		end
		return false, "Couldn't check that. Try again in a moment."
	end
	if filtered ~= text then
		return false, "That isn't allowed. Try something else."
	end
	return true
end

local function renameWait(club: any, field: string): number
	local at = tonumber(club[field]) or 0
	if at &lt;= 0 then
		return 0
	end
	return math.max(0, at + Config.Clubs.RenameDays * 86400 - os.time())
end

local ROLE_ORDER = { Owner = 1, CoLeader = 2, Member = 3 }

-- What the client is shown. Members see the code, the member list and their own role.
local function view(club: any, forUserId: number?, withMembers: boolean?): any
	local members = {}
	local memberIds = {}
	local thisSeason = club.Season == currentSeason() -- last month's points count for nothing
	for uid, m in club.Members do
		local id = tonumber(uid) or 0
		table.insert(memberIds, id)
		table.insert(members, {
			UserId = id,
			Name = m.Name,
			Role = m.Role or "Member",
			Points = if thisSeason then math.floor(tonumber(m.Points) or 0) else 0,
			Online = Players:GetPlayerByUserId(id) ~= nil,
		})
	end
	table.sort(members, function(a, b)
		local ra, rb = ROLE_ORDER[a.Role] or 3, ROLE_ORDER[b.Role] or 3
		if ra ~= rb then
			return ra &lt; rb
		end
		return string.lower(a.Name) &lt; string.lower(b.Name)
	end)
	local me = forUserId and club.Members[tostring(forUserId)]
	return {
		Id = club.Id,
		Name = club.Name,
		Tag = club.Tag,
		Public = club.Public,
		ReqLevel = club.ReqLevel,
		ReqRebirths = club.ReqRebirths,
		Points = if thisSeason then math.floor(tonumber(club.Points) or 0) else 0,
		Season = seasonInfo(),
		Count = #members,
		Max = Config.Clubs.MaxMembers,
		Owner = club.Owner,
		OwnerName = club.OwnerName,
		MemberIds = memberIds,
		Code = if me then club.Code else nil,
		Members = if me or withMembers then members else nil,
		Mine = me ~= nil,
		MyRole = if me then me.Role or "Member" else nil,
		NameWait = if me then renameWait(club, "NameChangedAt") else nil,
		TagWait = if me then renameWait(club, "TagChangedAt") else nil,
	}
end

local function meets(player: Player, club: any): (boolean, string?)
	local profile = DataService.Get(player)
	if not profile then
		return false, "Your save is still loading."
	end
	if DataService.LevelsBeaten(profile) &lt; (club.ReqLevel or 0) then
		return false, string.format("You need to beat level %d to join.", club.ReqLevel)
	end
	if (profile.Rebirths or 0) &lt; (club.ReqRebirths or 0) then
		return false, string.format("You need %d rebirths to join.", club.ReqRebirths)
	end
	return true
end

local function publish(message: any)
	task.spawn(function()
		local ok = pcall(function()
			MessagingService:PublishAsync(TOPIC, message)
		end)
		if not ok and message.Kind == "Chat" then
			-- No MessagingService (Studio): deliver in this server only.
			local handler = (ClubService :: any).OnMessage
			if handler then
				handler(message)
			end
		end
	end)
end

local function pushState(player: Player, club: any?)
	if player.Parent == Players then
		stateRemote:FireClient(player, if club then view(club, player.UserId) else nil)
	end
end

-- Tells everyone in this server who's in the club that it changed.
local function pushToMembers(club: any)
	for uid in club.Members do
		local plr = Players:GetPlayerByUserId(tonumber(uid) or 0)
		if plr then
			pushState(plr, club)
		end
	end
end

-- Puts the membership on the player's profile (tag over their head) and tells their client.
local function setMembership(player: Player, club: any?, moved: boolean)
	DataService.SetClub(player, if club then club.Id else "", if club then club.Tag else "", moved)
	pushState(player, club)
end

local function clubOf(player: Player): (string?, any?)
	local profile = DataService.Get(player)
	local id = profile and profile.ClubId
	if not id or id == "" then
		return nil, nil
	end
	local ok, club = get("club_" .. id)
	if not ok then
		return id, nil
	end
	return id, club
end

local function cooldownLeft(player: Player): number
	local profile = DataService.Get(player)
	local at = profile and profile.ClubMovedAt or 0
	return math.max(0, at + Config.Clubs.JoinCooldown - os.time())
end

----------------------------------------------------------------------------------------------------
-- The FIND directory
----------------------------------------------------------------------------------------------------

local function summary(club: any): any
	return { Name = club.Name, Tag = club.Tag, Public = club.Public, ReqLevel = club.ReqLevel, ReqRebirths = club.ReqRebirths }
end

local function dirPut(club: any)
	local key = dirKey(club.Name)
	update(key, function(old)
		local t = if type(old) == "table" then old else {}
		t[club.Id] = summary(club)
		return t
	end)
	dirCache[key] = nil
end

local function dirRemove(name: string, id: string)
	local key = dirKey(name)
	update(key, function(old)
		if type(old) ~= "table" or old[id] == nil then
			return nil
		end
		old[id] = nil
		return old
	end)
	dirCache[key] = nil
end

local function dirRead(key: string): any
	local cached = dirCache[key]
	if cached and os.clock() - cached.At &lt; DIR_REFRESH then
		return cached.Entries
	end
	local ok, entries = get(key)
	local t = if ok and type(entries) == "table" then entries else {}
	dirCache[key] = { At = os.clock(), Entries = t }
	return t
end

----------------------------------------------------------------------------------------------------
-- Actions
----------------------------------------------------------------------------------------------------

local function join(player: Player, id: string, byCode: boolean)
	local profile = DataService.Get(player)
	if not profile then
		return fail("Your save is still loading.")
	end
	if profile.ClubId ~= "" then
		return fail("Leave your club first.")
	end
	local wait = cooldownLeft(player)
	if wait &gt; 0 then
		return fail(string.format("You can join a club in %d seconds.", wait))
	end
	local reason: string? = nil
	local ok, club = update("club_" .. id, function(old)
		if type(old) ~= "table" then
			reason = "That club doesn't exist any more."
			return nil
		end
		if not old.Public and not byCode then
			reason = "That club is invite only. Ask for its club code!"
			return nil
		end
		if memberCount(old) &gt;= Config.Clubs.MaxMembers then
			reason = "That club is full."
			return nil
		end
		local good, why = meets(player, old)
		if not good then
			reason = why
			return nil
		end
		old.Members[tostring(player.UserId)] = { Name = player.DisplayName, Role = "Member", Joined = os.time(), Points = 0 }
		return old
	end)
	if not ok then
		return fail("Clubs are busy. Try again in a moment.")
	end
	if not club then
		return fail(reason or "Couldn't join that club.")
	end
	setMembership(player, club, true)
	pushToMembers(club)
	return { Ok = true, Club = view(club, player.UserId), Message = "Welcome to " .. club.Name .. "!" }
end

local function create(player: Player, value: any)
	if type(value) ~= "table" then
		return fail("Bad request.")
	end
	local profile = DataService.Get(player)
	if not profile then
		return fail("Your save is still loading.")
	end
	if profile.ClubId ~= "" then
		return fail("Leave your club first.")
	end
	local rules = Config.Clubs
	local name, tag = cleanName(value.Name), cleanTag(value.Tag)
	local bad = checkName(name) or checkTag(tag)
	if bad then
		return fail(bad)
	end
	if (profile.Gems or 0) &lt; rules.CreateCost then
		return fail(string.format("You need %d Gems to make a club.", rules.CreateCost))
	end
	local okName, whyName = filterOk(player, name)
	if not okName then
		return fail(whyName or "That name isn't allowed.")
	end
	local okTag, whyTag = filterOk(player, tag)
	if not okTag then
		return fail(whyTag or "That prefix isn't allowed.")
	end
	local reqLevel = math.clamp(math.floor(tonumber(value.ReqLevel) or 0), 0, rules.MaxLevelReq)
	local reqRebirths = math.clamp(math.floor(tonumber(value.ReqRebirths) or 0), 0, rules.MaxRebirthReq)
	local id = newId(player)

	-- Claim the name first (unique, any case).
	local taken = false
	local okClaim = update(nameKey(name), function(old)
		if type(old) == "string" and old ~= "" then
			taken = true
			return nil
		end
		return id
	end)
	if not okClaim then
		return fail("Clubs are busy. Try again in a moment.")
	end
	if taken then
		return fail("A club already has that name.")
	end
	-- Pay after the name is ours (nothing yields between the check and the spend).
	if not DataService.SpendGems(player, rules.CreateCost) then
		remove(nameKey(name))
		return fail(string.format("You need %d Gems to make a club.", rules.CreateCost))
	end
	local code = newCode()
	local club = {
		Id = id,
		Name = name,
		Tag = tag,
		Owner = player.UserId,
		OwnerName = player.DisplayName,
		Public = value.Public ~= false,
		ReqLevel = reqLevel,
		ReqRebirths = reqRebirths,
		Code = code,
		Points = 0,
		Season = currentSeason(),
		Created = os.time(),
		NameChangedAt = 0, -- 0: the first change is free straight away
		TagChangedAt = 0,
		Members = { [tostring(player.UserId)] = { Name = player.DisplayName, Role = "Owner", Joined = os.time(), Points = 0 } },
	}
	local okSave = update("club_" .. id, function()
		return club
	end)
	if not okSave then
		DataService.AddGems(player, rules.CreateCost) -- refund
		remove(nameKey(name))
		return fail("Couldn't save your club. Your Gems were given back.")
	end
	update("code_" .. code, function()
		return id
	end)
	dirPut(club)
	setPoints(id, 0)
	topAt = -math.huge
	setMembership(player, club, true)
	return { Ok = true, Club = view(club, player.UserId), Message = name .. " is open!" }
end

local function deleteClub(club: any)
	remove("club_" .. club.Id)
	remove(nameKey(club.Name))
	if club.Code then
		remove("code_" .. club.Code)
	end
	remove("chat_" .. club.Id)
	dirRemove(club.Name, club.Id)
	setPoints(club.Id, nil)
	topAt = -math.huge
end

local function leave(player: Player)
	local id = clubOf(player)
	if not id then
		return fail("You're not in a club.")
	end
	local emptied: any = nil
	local ok, club = update("club_" .. id, function(old)
		if type(old) ~= "table" then
			return nil
		end
		old.Members[tostring(player.UserId)] = nil
		if memberCount(old) == 0 then
			emptied = old
			return nil
		end
		if old.Owner == player.UserId then
			-- A co-leader takes over (the longest-standing one), else the longest member.
			local heir, heirRank, heirJoined = nil, math.huge, math.huge
			for uid, m in old.Members do
				local rank = if m.Role == "CoLeader" then 1 else 2
				local joined = m.Joined or 0
				if rank &lt; heirRank or (rank == heirRank and joined &lt; heirJoined) then
					heir, heirRank, heirJoined = uid, rank, joined
				end
			end
			old.Owner = tonumber(heir)
			old.OwnerName = old.Members[heir].Name
			old.Members[heir].Role = "Owner"
		end
		return old
	end)
	if not ok then
		return fail("Clubs are busy. Try again in a moment.")
	end
	if emptied then
		deleteClub(emptied)
	elseif club then
		pushToMembers(club)
	end
	setMembership(player, nil, true)
	return { Ok = true, Message = if emptied then "Your club was closed." else "You left the club." }
end

-- An edit by a club leader. `allowed(me)` says if this member may do it; `edit(club)` returns an
-- error message or nil.
local function leaderEdit(player: Player, allowed: (any) -&gt; boolean, edit: (any) -&gt; string?)
	local id = clubOf(player)
	if not id then
		return fail("You're not in a club.")
	end
	local reason: string? = nil
	local ok, club = update("club_" .. id, function(old)
		if type(old) ~= "table" then
			reason = "That club doesn't exist any more."
			return nil
		end
		local me = old.Members[tostring(player.UserId)]
		if not me or not allowed(me) then
			reason = "You can't do that in this club."
			return nil
		end
		reason = edit(old)
		if reason then
			return nil
		end
		return old
	end)
	if not ok then
		return fail("Clubs are busy. Try again in a moment.")
	end
	if not club then
		return fail(reason or "Couldn't do that.")
	end
	pushToMembers(club)
	return { Ok = true, Club = view(club, player.UserId) }
end

local function isOwner(me: any): boolean
	return me.Role == "Owner"
end

local function isLeader(me: any): boolean
	return me.Role == "Owner" or me.Role == "CoLeader"
end

local function kick(player: Player, userId: any)
	if type(userId) ~= "number" or userId == player.UserId then
		return fail("Pick a member to kick.")
	end
	local result = leaderEdit(player, isLeader, function(club)
		local target = club.Members[tostring(userId)]
		if not target then
			return "They're not in your club."
		end
		local me = club.Members[tostring(player.UserId)]
		-- The owner kicks anyone; co-leaders only kick members.
		if target.Role == "Owner" or (me.Role == "CoLeader" and target.Role ~= "Member") then
			return "You can't kick them."
		end
		club.Members[tostring(userId)] = nil
		return nil
	end)
	if result.Ok then
		local target = Players:GetPlayerByUserId(userId)
		if target then
			setMembership(target, nil, false)
			Remotes.Event("Notify"):FireClient(target, "You were removed from your club.", "Info")
		else
			publish({ Kind = "Kicked", UserId = userId, ClubId = result.Club.Id })
		end
	end
	return result
end

local function setRole(player: Player, userId: any, role: string)
	if type(userId) ~= "number" or userId == player.UserId then
		return fail("Pick a member.")
	end
	return leaderEdit(player, isOwner, function(club)
		local target = club.Members[tostring(userId)]
		if not target or target.Role == "Owner" then
			return "They're not a member you can change."
		end
		target.Role = role
		return nil
	end)
end

local function settings(player: Player, value: any)
	if type(value) ~= "table" then
		return fail("Bad request.")
	end
	local result = leaderEdit(player, isOwner, function(club)
		if value.Public ~= nil then
			club.Public = value.Public == true
		end
		if value.ReqLevel ~= nil then
			club.ReqLevel = math.clamp(math.floor(tonumber(value.ReqLevel) or 0), 0, Config.Clubs.MaxLevelReq)
		end
		if value.ReqRebirths ~= nil then
			club.ReqRebirths = math.clamp(math.floor(tonumber(value.ReqRebirths) or 0), 0, Config.Clubs.MaxRebirthReq)
		end
		return nil
	end)
	if result.Ok then
		local _, club = clubOf(player)
		if club then
			dirPut(club)
		end
	end
	return result
end

-- Name and prefix changes: owner only, each once every RenameDays (its own timer).
local function rename(player: Player, value: any)
	if type(value) ~= "table" then
		return fail("Bad request.")
	end
	local id, current = clubOf(player)
	if not id or not current then
		return fail("You're not in a club.")
	end
	local newName = if value.Name ~= nil then cleanName(value.Name) else nil
	local newTag = if value.Tag ~= nil then cleanTag(value.Tag) else nil
	if newName == current.Name then
		newName = nil
	end
	if newTag == current.Tag then
		newTag = nil
	end
	if not newName and not newTag then
		return fail("Nothing to change.")
	end
	if newName then
		local bad = checkName(newName)
		if bad then
			return fail(bad)
		end
		if renameWait(current, "NameChangedAt") &gt; 0 then
			return fail("The club name can't be changed again yet.")
		end
		local okF, why = filterOk(player, newName)
		if not okF then
			return fail(why or "That name isn't allowed.")
		end
		-- Claim the new name (the old one is freed once the change is saved).
		local taken = false
		local okClaim = update(nameKey(newName), function(old)
			if type(old) == "string" and old ~= "" and old ~= id then
				taken = true
				return nil
			end
			return id
		end)
		if not okClaim then
			return fail("Clubs are busy. Try again in a moment.")
		end
		if taken then
			return fail("A club already has that name.")
		end
	end
	if newTag then
		local bad = checkTag(newTag)
		if bad then
			return fail(bad)
		end
		if renameWait(current, "TagChangedAt") &gt; 0 then
			return fail("The prefix can't be changed again yet.")
		end
		local okF, why = filterOk(player, newTag)
		if not okF then
			return fail(why or "That prefix isn't allowed.")
		end
	end
	local oldName = current.Name
	local result = leaderEdit(player, isOwner, function(club)
		if newName then
			if renameWait(club, "NameChangedAt") &gt; 0 then
				return "The club name can't be changed again yet."
			end
			club.Name = newName
			club.NameChangedAt = os.time()
		end
		if newTag then
			if renameWait(club, "TagChangedAt") &gt; 0 then
				return "The prefix can't be changed again yet."
			end
			club.Tag = newTag
			club.TagChangedAt = os.time()
		end
		return nil
	end)
	if not result.Ok then
		if newName then
			remove(nameKey(newName))
		end
		return result
	end
	if newName then
		remove(nameKey(oldName))
		dirRemove(oldName, id)
	end
	local _, club = clubOf(player)
	if club then
		dirPut(club)
		if newTag then
			-- Everyone here in the club gets the new prefix over their head now; others on join.
			for uid in club.Members do
				local plr = Players:GetPlayerByUserId(tonumber(uid) or 0)
				if plr then
					DataService.SetClub(plr, club.Id, club.Tag, false)
				end
			end
		end
	end
	topAt = -math.huge
	result.Message = "Saved!"
	return result
end

local function regenerateCode(player: Player)
	local oldCode: string? = nil
	local result = leaderEdit(player, isOwner, function(club)
		oldCode = club.Code
		club.Code = newCode()
		return nil
	end)
	if result.Ok then
		if oldCode then
			remove("code_" .. oldCode)
		end
		local id = result.Club.Id
		update("code_" .. result.Club.Code, function()
			return id
		end)
	end
	return result
end

-- FIND: a club code, or clubs whose name starts with the text (alphabetical).
local function find(player: Player, text: any)
	if type(text) ~= "string" then
		return fail("Type a club name or code.")
	end
	local query = string.gsub(string.gsub(text, "^%s+", ""), "%s+$", "")
	if #query &lt; 1 or #query &gt; 30 then
		return fail("Type a club name or code.")
	end
	local clubs = {}
	local seen = {}
	local function add(id: any, byCode: boolean)
		if type(id) ~= "string" or seen[id] or #clubs &gt;= FIND_COUNT then
			return
		end
		seen[id] = true
		local ok, club = get("club_" .. id)
		if ok and type(club) == "table" then
			local v = view(club, player.UserId)
			v.ByCode = byCode
			table.insert(clubs, v)
		end
	end
	if #query == Config.Clubs.CodeLength then
		local okCode, byCode = get("code_" .. string.upper(query))
		if okCode then
			add(byCode, true)
		end
	end
	local lower = string.lower(query)
	local matches = {}
	for id, entry in dirRead(dirKey(query)) do
		if type(entry) == "table" and type(entry.Name) == "string" and string.sub(string.lower(entry.Name), 1, #lower) == lower then
			table.insert(matches, { Id = id, Name = entry.Name })
		end
	end
	table.sort(matches, function(a, b)
		return string.lower(a.Name) &lt; string.lower(b.Name)
	end)
	for _, m in matches do
		add(m.Id, false)
	end
	return { Ok = true, Clubs = clubs }
end

local function refreshTop()
	local list = {}
	for _, id in topIds() do
		local ok, club = get("club_" .. id)
		if ok and type(club) == "table" then
			table.insert(list, view(club, nil))
		end
	end
	table.sort(list, function(a, b)
		return a.Points &gt; b.Points
	end)
	topCache = list
	topAt = os.clock()
end

local function top(player: Player)
	if os.clock() - topAt &gt; TOP_REFRESH then
		refreshTop()
	end
	local list = {}
	local profile = DataService.Get(player)
	for i, c in topCache do
		local v = table.clone(c)
		v.Rank = i
		v.Mine = profile ~= nil and profile.ClubId == c.Id
		table.insert(list, v)
	end
	return { Ok = true, Clubs = list, Season = seasonInfo() }
end

----------------------------------------------------------------------------------------------------
-- Chat
----------------------------------------------------------------------------------------------------

local function chatHistory(player: Player)
	local id = clubOf(player)
	if not id then
		return fail("You're not in a club.")
	end
	local ok, list = get("chat_" .. id)
	return { Ok = true, Messages = if ok and type(list) == "table" then list else {} }
end

local function chat(player: Player, text: any)
	if type(text) ~= "string" then
		return fail("Type a message.")
	end
	local message = string.gsub(string.gsub(text, "^%s+", ""), "%s+$", "")
	if #message == 0 or #message &gt; Config.Clubs.ChatLength then
		return fail(string.format("Messages are 1 to %d letters.", Config.Clubs.ChatLength))
	end
	if os.clock() - (lastChat[player] or 0) &lt; CHAT_GAP then
		return fail("Slow down a little!")
	end
	lastChat[player] = os.clock()
	local id = clubOf(player)
	if not id then
		return fail("You're not in a club.")
	end
	-- Roblox's text filter (members see it in every server, so filter for broadcast).
	local ok, filtered = pcall(function()
		return TextService:FilterStringAsync(message, player.UserId, Enum.TextFilterContext.PublicChat):GetNonChatStringForBroadcastAsync()
	end)
	if not ok then
		if not RunService:IsStudio() then
			return fail("Couldn't send that. Try again in a moment.")
		end
		filtered = message
	end
	local entry = { U = player.UserId, N = player.DisplayName, T = filtered, At = os.time() }
	update("chat_" .. id, function(old)
		local list = if type(old) == "table" then old else {}
		table.insert(list, entry)
		while #list &gt; Config.Clubs.ChatKeep do
			table.remove(list, 1)
		end
		return list
	end)
	publish({ Kind = "Chat", ClubId = id, Msg = entry })
	return { Ok = true }
end

local function onRequest(player: Player, action: any, value: any): any
	local now = os.clock()
	if now - (lastRequest[player] or 0) &lt; 0.3 then
		return fail("Slow down a little!")
	end
	lastRequest[player] = now
	if not DataService.Get(player) then
		return fail("Your save is still loading.")
	end
	local ok, result = pcall(function(): any
		if action == "Mine" then
			local id, club = clubOf(player)
			if id and club == nil then
				-- Gone (deleted, or we were kicked elsewhere): tidy the profile up.
				local okGet, again = get("club_" .. id)
				if okGet and again == nil then
					setMembership(player, nil, false)
				end
			elseif club and not club.Members[tostring(player.UserId)] then
				setMembership(player, nil, false)
				club = nil
			end
			return { Ok = true, Club = if club and club.Members[tostring(player.UserId)] then view(club, player.UserId) else nil }
		elseif action == "Top" then
			return top(player)
		elseif action == "Info" and type(value) == "string" and #value &lt;= 40 then
			return info(player, value)
		elseif action == "Donate" then
			return donate(player, value)
		elseif action == "Find" then
			return find(player, value)
		elseif action == "Create" then
			return create(player, value)
		elseif action == "Join" and type(value) == "string" and #value &lt;= 40 then
			return join(player, value, false)
		elseif action == "JoinCode" and type(value) == "string" and #value &lt;= 12 then
			local okCode, id = get("code_" .. string.upper(value))
			if not okCode then
				return fail("Clubs are busy. Try again in a moment.")
			end
			if type(id) ~= "string" then
				return fail("No club has that code.")
			end
			return join(player, id, true)
		elseif action == "Leave" then
			return leave(player)
		elseif action == "Kick" then
			return kick(player, value)
		elseif action == "Promote" then
			return setRole(player, value, "CoLeader")
		elseif action == "Demote" then
			return setRole(player, value, "Member")
		elseif action == "Settings" then
			return settings(player, value)
		elseif action == "Rename" then
			return rename(player, value)
		elseif action == "NewCode" then
			return regenerateCode(player)
		elseif action == "Chat" then
			return chat(player, value)
		elseif action == "ChatHistory" then
			return chatHistory(player)
		end
		return fail("Unknown request.")
	end)
	if not ok then
		warn("[ClubService] " .. tostring(action) .. " failed: " .. tostring(result))
		return fail("Something went wrong. Try again.")
	end
	return result
end

----------------------------------------------------------------------------------------------------
-- Points and membership checks
----------------------------------------------------------------------------------------------------

-- Donate Bubbles to your club: each one is a point for the club and for you this month.
function donate(player: Player, value: any): any
	local amount = math.floor(tonumber(value) or 0)
	if amount &lt; 1 or amount &gt; 1e9 then
		return fail("Pick an amount to donate.")
	end
	local id = clubOf(player)
	if not id then
		return fail("You're not in a club.")
	end
	if not DataService.SpendBubbles(player, amount) then
		return fail("You don't have that many Bubbles.")
	end
	local season = currentSeason()
	local uid = tostring(player.UserId)
	local ok, club = update("club_" .. id, function(old)
		if type(old) ~= "table" or not old.Members[uid] then
			return nil
		end
		if old.Season ~= season then -- a new month: everyone starts again from zero
			old.Season = season
			old.Points = 0
			for _, m in old.Members do
				m.Points = 0
			end
		end
		old.Points = (old.Points or 0) + amount
		old.Members[uid].Points = (tonumber(old.Members[uid].Points) or 0) + amount
		return old
	end)
	if not ok or not club then
		DataService.AddBubbles(player, amount, "ClubRefund")
		return fail("Couldn't donate right now. Your Bubbles were given back.")
	end
	setPoints(id, club.Points, season)
	topAt = -math.huge
	pushToMembers(club)
	return { Ok = true, Club = view(club, player.UserId), Message = string.format("Donated %d Bubbles!", amount) }
end

-- Any club's details and members (TOP CLUBS / FIND rows open it). Only members see the code.
function info(player: Player, id: string): any
	local ok, club = get("club_" .. id)
	if not ok then
		return fail("Clubs are busy. Try again in a moment.")
	end
	if type(club) ~= "table" then
		return fail("That club doesn't exist any more.")
	end
	return { Ok = true, Club = view(club, player.UserId, true) }
end

----------------------------------------------------------------------------------------------------
-- The monthly contest: closing a month and paying the winners
----------------------------------------------------------------------------------------------------

local closedSeasons: { [string]: boolean } = {}

-- Once per month (whichever server notices first): record the finished month's top 3 clubs and who
-- was in them.
local function ensureSeasonClosed()
	local prev = previousSeason()
	if closedSeasons[prev] then
		return
	end
	local ok, existing = get("season_" .. prev)
	if not ok then
		return
	end
	if existing then
		closedSeasons[prev] = true
		return
	end
	local clubs = {}
	for _, id in topIds(prev, 3) do
		local okClub, club = get("club_" .. id)
		if okClub and type(club) == "table" then
			local members = {}
			for uid in club.Members do
				table.insert(members, tonumber(uid))
			end
			table.insert(clubs, { Id = id, Name = club.Name, Tag = club.Tag, Rank = #clubs + 1, Members = members })
		end
	end
	update("season_" .. prev, function(old)
		if old then
			return nil
		end
		return { Season = prev, Clubs = clubs }
	end)
	closedSeasons[prev] = true
end

local function seasonName(season: string): string
	local y, m = tonumber(string.sub(season, 1, 4)) or 1970, tonumber(string.sub(season, 5, 6)) or 1
	return os.date("!%B %Y", daysFromCivil(y, m, 1) * 86400)
end

-- Pays last month's prize to a member of one of the top 3 clubs (once).
local function claimPrize(player: Player)
	local profile = DataService.Get(player)
	local prev = previousSeason()
	if not profile or profile.ClubPrizeSeason == prev then
		return
	end
	local ok, doc = get("season_" .. prev)
	if not ok or type(doc) ~= "table" then
		return
	end
	DataService.MarkClubPrize(player, prev)
	local rules = Config.Clubs.Season
	for _, c in doc.Clubs or {} do
		if table.find(c.Members or {}, player.UserId) then
			local gems = rules.PrizeGems[c.Rank] or 0
			local text = string.format("%s finished #%d in %s: +%d Gems", tostring(c.Name), c.Rank, seasonName(prev), gems)
			DataService.AddGems(player, gems)
			if c.Rank == 1 and rules.Pet then
				local okPet = (require(script.Parent:WaitForChild("PetService")) :: any).GivePet(player, rules.Pet)
				if okPet then
					text ..= " and the limited " .. Config.Pets[rules.Pet].Name .. " pet!"
				else
					DataService.AddGems(player, 150)
					text ..= " (pet bag full: +150 Gems instead of the pet)"
				end
			end
			;(require(script.Parent:WaitForChild("GiftService")) :: any).Celebrate(player, "Club contest prize!", text, "Gem")
			return
		end
	end
end

-- On join: is the club still there, and are they still in it? The prefix is refreshed from it, and
-- the client is told (so the Clubs window never has to guess). Then last month's prize, if any.
local function checkOnJoin(player: Player)
	local profile = DataService.Get(player)
	if not profile then
		return
	end
	if profile.ClubId ~= "" then
		local okGet, club = get("club_" .. profile.ClubId)
		if okGet then
			if type(club) ~= "table" or not club.Members[tostring(player.UserId)] then
				setMembership(player, nil, false)
			else
				if club.Tag ~= profile.ClubTag then
					DataService.SetClub(player, club.Id, club.Tag, false)
				end
				pushState(player, club)
			end
		end
	end
	pcall(ensureSeasonClosed)
	pcall(claimPrize, player)
end

-- MessagingService messages (and the Studio fallback).
function ClubService.OnMessage(data: any)
	if type(data) ~= "table" then
		return
	end
	if data.Kind == "Kicked" then
		local target = Players:GetPlayerByUserId(tonumber(data.UserId) or 0)
		local profile = target and DataService.Get(target)
		if target and profile and profile.ClubId == data.ClubId then
			setMembership(target, nil, false)
			Remotes.Event("Notify"):FireClient(target, "You were removed from your club.", "Info")
		end
	elseif data.Kind == "Chat" and type(data.Msg) == "table" then
		for _, plr in Players:GetPlayers() do
			local profile = DataService.Get(plr)
			if profile and profile.ClubId == data.ClubId then
				chatRemote:FireClient(plr, data.Msg)
			end
		end
	end
end

function ClubService.Init()
	if initialized then
		return
	end
	initialized = true
	pcall(function()
		clubStore = DataStoreService:GetDataStore(STORE)
		pointsStoreFor(currentSeason())
	end)
	stateRemote = Remotes.Event("ClubState")
	chatRemote = Remotes.Event("ClubChat")
	Remotes.Function("ClubRequest").OnServerInvoke = onRequest
	DataService.ProfileLoaded:Connect(function(player)
		task.spawn(checkOnJoin, player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		lastRequest[player] = nil
		lastChat[player] = nil
	end)
	pcall(function()
		MessagingService:SubscribeAsync(TOPIC, function(message)
			ClubService.OnMessage(message.Data)
		end)
	end)
end

function ClubService.Start()
	task.spawn(function()
		while true do
			task.wait(600)
			pcall(ensureSeasonClosed)
		end
	end)
end

-- For tests.
ClubService.EnsureSeasonClosed = ensureSeasonClosed
ClubService.ClaimPrize = claimPrize
function ClubService.FlushPoints() end

return ClubService</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000015"><Properties><string name="Name">DailyNotify</string><ProtectedString name="Source">--[[
	DailyNotify - "Your daily reward is ready!" Roblox notifications.

	When a player claims their daily reward, they're queued (MemoryStore sorted map, ordered by when
	the next reward is ready). Every server checks the front of the queue each minute; whichever takes
	a due entry first sends it through Open Cloud's user notifications API and removes it. Roblox
	only delivers it to players who turned notifications on (RewardsUI / DailyUI ask them), and
	tapping it joins the game.

	Needs (StoreIds &gt; Notifications explains each step): the notification string's ID, an Open
	Cloud API key saved as the secret Config.DailyNotify.SecretName, and HTTP requests allowed.
	Without them nothing is queued and nothing is sent.
]]

local HttpService = game:GetService("HttpService")
local MemoryStoreService = game:GetService("MemoryStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))

local DataService = require(script.Parent:WaitForChild("DataService"))

local DailyNotify = {}

local MAP_NAME = "RinseCycle_DailyNotify"
local POLL_EVERY = 60
local BATCH = 20
local CLAIM_SECONDS = 120 -- a taken entry is left alone this long (the sender removes it)

local initialized = false
local queue: MemoryStoreSortedMap? = nil
local warned = false

local function enabled(): boolean
	return Config.DailyNotify.MessageId ~= "" and game.GameId &gt; 0
end

-- Queues this player's "ready" notification for when their next daily reward unlocks.
function DailyNotify.Queue(player: Player)
	local profile = DataService.Get(player)
	if not profile or not enabled() or not queue then
		return
	end
	local due = (profile.DailyLast or os.time()) + Config.Daily.Cooldown
	local streak = (profile.DailyStreak or 0) % #Config.DailyRewards + 1
	profile.DailyNotifyAt = due
	local map = queue :: MemoryStoreSortedMap
	task.spawn(function()
		local ok, err = pcall(function()
			-- Kept until well after it's due (servers may be quiet for a while).
			map:SetAsync(tostring(player.UserId), { Due = due, Streak = streak }, Config.Daily.Cooldown + 2 * 86400, due)
		end)
		if not ok then
			warn("[DailyNotify] couldn't queue: " .. tostring(err))
		end
	end)
end

-- The API key secret: the name in Config.DailyNotify.SecretName first, then the other names it might
-- have been saved under (the first one that exists wins).
local function findSecret(): (any?, string)
	local tried = {}
	for _, name in Config.DailyNotify.SecretNames do
		table.insert(tried, name)
		local ok, secret = pcall(function()
			return HttpService:GetSecret(name)
		end)
		if ok and secret then
			return secret, name
		end
	end
	return nil, table.concat(tried, ", ")
end

-- Sends one notification. Returns (done, detail): `done` is false only when a retry might help.
local function send(userId: number, streak: number): (boolean, string)
	local secret, found = findSecret()
	if not secret then
		if not warned then
			warned = true
			warn("[DailyNotify] no API key secret found (tried: " .. found .. ")")
		end
		return false, "No API key secret found. Tried the names: " .. found
	end
	local body = HttpService:JSONEncode({
		source = { universe = "universes/" .. tostring(game.GameId) },
		payload = {
			message_id = Config.DailyNotify.MessageId,
			type = "MOMENT",
			parameters = { streak = { string_value = tostring(streak) } },
			join_experience = { launch_data = "daily" },
		},
		analytics_data = { category = "Daily reward" },
	})
	local ok, response = pcall(function()
		return HttpService:RequestAsync({
			Url = string.format("https://apis.roblox.com/cloud/v2/users/%d/notifications", userId),
			Method = "POST",
			Headers = { ["Content-Type"] = "application/json", ["x-api-key"] = secret :: any },
			Body = body,
		})
	end)
	if not ok then
		warn("[DailyNotify] request failed: " .. tostring(response))
		return false, "The request failed: " .. tostring(response) .. " (is Game Settings &gt; Security &gt; Allow HTTP Requests on?)"
	end
	if not response.Success then
		warn(string.format("[DailyNotify] %d %s", response.StatusCode, tostring(response.Body)))
		-- 4xx (not opted in, bad id) won't get better by retrying: drop it.
		return response.StatusCode &gt;= 400 and response.StatusCode &lt; 500, string.format("Roblox said %d: %s", response.StatusCode, string.sub(tostring(response.Body), 1, 160))
	end
	return true, "Sent using the secret '" .. found .. "'."
end

-- Studio / owner test: sends the notification to this player right now and says how it went.
function DailyNotify.TestNow(player: Player): string
	if Config.DailyNotify.MessageId == "" then
		return "No notification string ID set (StoreIds &gt; Notifications &gt; DailyReady)."
	end
	if game.GameId &lt;= 0 then
		return "This place isn't published (no experience ID), so Roblox can't send it."
	end
	local _, detail = send(player.UserId, 1)
	return detail
end

local function poll()
	local map = queue
	if not map or not enabled() then
		return
	end
	local now = os.time()
	local ok, items = pcall(function()
		return map:GetRangeAsync(Enum.SortDirection.Ascending, BATCH, nil, { sortKey = now + 1 })
	end)
	if not ok or type(items) ~= "table" then
		return
	end
	for _, item in items do
		local key = item.key
		local userId = tonumber(key)
		-- Take it (another server may be looking at the same entry).
		local mine = false
		local taken = nil
		pcall(function()
			map:UpdateAsync(key, function(value, sortKey)
				if type(value) ~= "table" or (value.Due or 0) &gt; now then
					return nil
				end
				if value.TakenAt and now - value.TakenAt &lt; CLAIM_SECONDS then
					return nil
				end
				value.TakenAt = now
				mine = true
				taken = value
				return value, sortKey
			end, CLAIM_SECONDS * 2)
		end)
		if mine and userId and taken then
			local value: any = taken
			-- Already in this server: the Daily button's "!" says it; no notification needed.
			local here = Players:GetPlayerByUserId(userId) ~= nil
			local done = here or DailyNotify.Send(userId, tonumber(value.Streak) or 1)
			if done then
				pcall(function()
					map:RemoveAsync(key)
				end)
			end
		end
	end
end

DailyNotify.Send = send

-- Tests: a stand-in queue, and one poll on demand.
function DailyNotify.SetQueueForTests(map: any)
	queue = map
end
DailyNotify.Poll = poll

function DailyNotify.Init()
	if initialized then
		return
	end
	initialized = true
	pcall(function()
		queue = MemoryStoreService:GetSortedMap(MAP_NAME)
	end)
end

function DailyNotify.Start()
	if RunService:IsStudio() then
		return -- no notifications from Studio test sessions
	end
	task.spawn(function()
		while true do
			task.wait(POLL_EVERY + math.random() * 10)
			pcall(poll)
		end
	end)
end

return DailyNotify</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000016"><Properties><string name="Name">DataService</string><ProtectedString name="Source">-- DataService: every player's permanent profile (Bubbles, perks, pets, unlocks, best times, stats).
--
-- Life of a profile:
--   join     -&gt; a Session is created and loaded in the background. The load is one UpdateAsync that
--               takes a session lock ({ JobId, Time }) so two servers never own the same save. If
--               another server holds a fresh lock (a server hop in progress), we wait and retry, and
--               steal the lock after LOCK_RETRIES attempts (that server has probably crashed).
--   playing  -&gt; services read and change the profile table directly (Get), or through the helpers
--               below. PushMeta sends the client a MetaState snapshot (coalesced to one per 0.1 s).
--   autosave -&gt; every AUTOSAVE_INTERVAL seconds (plus a random offset per player), the profile is
--               written and the lock refreshed. A save only lands while we still own the lock.
--   leave    -&gt; a final save that also clears the lock, so the next server can load straight away.
--
-- Data is NEVER wiped. If a save exists but can't be read (DataStore errors after every retry, or a
-- damaged record), the player plays on a temporary default profile that is never saved, and is told
-- so. Only profiles that loaded successfully (and whose lock we still hold) are ever written.
--
-- Offline mode (unpublished place, or Studio without API access): profiles live in memory only,
-- everything else works the same, and each player is told once that progress won't save.
--
-- Passes are runtime-only (MarketService fills them in) and never saved.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Types = require(Shared:WaitForChild("Types"))
local Util = require(Shared:WaitForChild("Util"))

local DataService = {}

----------------------------------------------------------------------------------------------------
-- Tunables
----------------------------------------------------------------------------------------------------

local STORE_NAME = "RinseCycle_Profiles_v1"
local KEY_PREFIX = "u_"
local PROFILE_VERSION = 1

local LOCK_TTL = 1800 -- seconds; an older lock belongs to a server that died without releasing it
local LOCK_RETRIES = 6 -- locked loads to wait through before stealing the lock
local LOCK_WAIT_MIN, LOCK_WAIT_MAX = 3, 5 -- seconds between locked load attempts
local HANDOFF_TTL = 120 -- seconds a handoff lock may be taken over straight away (see BeginHandoff)
local LOAD_ATTEMPTS = 6 -- DataStore errors tolerated while loading before falling back to a temp profile
local FINAL_SAVE_ATTEMPTS = 3
local RECEIPT_SAVE_ATTEMPTS = 2

local AUTOSAVE_INTERVAL = 120
local AUTOSAVE_JITTER = 30 -- random extra seconds before a player's first autosave, so saves spread out
local AUTOSAVE_TICK = 5 -- how often the autosave loop looks for due saves
local AUTOSAVE_RETRY = 30 -- a failed autosave tries again this soon
local SAVE_SOON_DELAY = 10 -- a level unlock is written within this many seconds
local SHUTDOWN_WAIT = 25

local PUSH_COALESCE = 0.1
local MAX_RECEIPTS = 50
local PROBE_WAIT = 5 -- max seconds IsOffline() waits for the Studio probe
local SAME_USER_WAIT = 30 -- max seconds a rejoin waits for this server to finish the previous session
local NOTICE_FALLBACK = 8 -- toasts go out this long after loading even if the client never asked for meta
local NOTICE_AFTER_READY = 1.5 -- ...or this long after the client's first GetMeta (its UI is up by then)
local META_REQUESTS_PER_SECOND = 3 -- GetMeta budget per player (burst of the same size)

local MSG_OFFLINE = "Progress won't save in this test (turn on Studio API access)."
local MSG_LOAD_FAILED = "We couldn't load your save - progress this session won't be saved. Rejoin to try again."
local MSG_LOCK_LOST = "Your save was opened on another server - progress here won't be saved. Rejoin to fix it."

----------------------------------------------------------------------------------------------------
-- Types
----------------------------------------------------------------------------------------------------

export type Profile = {
	Version: number,
	Bubbles: number,
	Gems: number, -- premium currency
	Rank: string, -- equipped rank id ("" = none)
	Ranks: { string }, -- owned rank ids
	Perks: { [string]: number }, -- Config.Perks[i].Id -&gt; level
	Pets: { Types.PetEntry },
	Equipped: { string }, -- Uids, slot order
	NextUid: number,
	Unlocked: number, -- highest level index the player may pick
	BestTimes: { number }, -- one per Config.Levels entry, seconds, 0 = never cleared
	Rebirths: number, -- times the player has rebirthed (Config.Rebirth)
	DailyDay: number, -- (old saves) UTC day number of the last daily reward claimed
	DailyLast: number, -- os.time() of the last daily claim (0 = never); the next is 24 h later
	DailyStreak: number, -- 1..#Config.DailyRewards, the day of the streak last claimed
	RedeemedCodes: { string }, -- Config.Codes already used (upper case)
	Ducks: { string }, -- lobby rubber ducks found (Config.Ducks ids)
	Episodes: { number }, -- per level index: run-start cutscene chapters seen (picks the next one)
	GroupReward: boolean, -- the join-the-community reward has been claimed
	FollowReward: boolean, -- the follow-the-dev reward has been claimed
	LikeReward: boolean, -- the like-the-game reward has been claimed
	FollowPending: boolean, -- pressed "I followed!": checked on the next join (SocialService)
	LikePending: boolean, -- pressed "I liked it!": paid on the next join
	RebirthReady: boolean, -- the last level has been cleared since the last rebirth
	BoostUntil: number, -- os.time() until which cleaning is x2 (the "stay" boost); 0 = none
	StayBoostDay: string, -- UTC date ("2026-10-03") the stay boost was last claimed: once a day
	PetIndex: { [string]: number }, -- every pet id ever owned -&gt; bits (1 normal, 2 Golden, 4 Rainbow)
	PetIndexPaid: { [string]: boolean }, -- collection sets already paid ("1".."3")
	PetsResting: boolean, -- the player switched their pets off: they follow but don't clean
	ReferredBy: number, -- UserId of the friend whose invite brought them in (0 = nobody)
	AdLuckStacks: number, -- rewarded ads watched for rank luck (each +PerAd), while AdLuckUntil lasts
	AdLuckUntil: number, -- os.time() the ad luck runs out
	ChestEventId: string, -- the Treasure Chest event ChestFreeUsed counts for (a new event resets it)
	ChestFreeUsed: number, -- free chests opened in that event
	ChestsOpened: number, -- every chest ever opened (free and bought)
	ClubId: string, -- the club they're in ("" = none); ClubService keeps the club's own record
	ClubTag: string, -- that club's tag, for the name tag (refreshed from the club on join)
	ClubMovedAt: number, -- os.time() they last joined / left a club (Config.Clubs.JoinCooldown)
	ClubPrizeSeason: string, -- the club contest month (YYYYMM) whose prize they've been paid
	BadgesGot: { [string]: boolean }, -- Config.Badges keys already awarded (BadgeAwards)
	DailyNotifyAt: number, -- os.time() the "daily reward ready" notification is queued for (0 = none)
	Referrals: number, -- new players who joined through this player's invites (paid out)
	Stats: {
		Runs: number,
		DishesCleaned: number,
		GrimeCleaned: number,
		EggsHatched: number,
		BubblesEarned: number,
	},
	Receipts: { string }, -- recent developer-product PurchaseIds, newest last
}

-- A Bubbles or stat change that arrived before the profile finished loading (replayed on load).
type PendingChange = { Stat: string?, Amount: number } -- Stat nil = Bubbles

-- A one-shot gate: threads that wait on it sleep until it opens (or their timeout passes).
type Latch = { Open: boolean, Threads: { thread } }

type Session = {
	Player: Player,
	UserId: number,
	Key: string,
	Profile: Profile?, -- nil while loading
	CanSave: boolean, -- true only for a profile loaded from the DataStore whose lock we still hold
	Left: boolean, -- PlayerRemoving has fired
	Finalizing: boolean, -- the final (lock-releasing) save has started; nothing is saved after it
	Released: boolean, -- the lock has been cleared
	Handoff: boolean, -- a teleport to another server is under way: that server may take the lock at once
	Busy: boolean, -- a save is in flight (saves for one session never overlap)
	SaveQueue: { thread },
	Loaded: Latch, -- opens when Profile is set, or the player leaves
	Done: Latch, -- opens when this session is completely finished (final save landed or given up)
	Previous: Session?, -- this user's previous session on this server, if it was still finishing
	NextAutosave: number, -- os.clock()
	Pending: { PendingChange }, -- Bubbles/stat changes that arrived while the profile was still loading
	Notices: { { string } }, -- { text, kind } toasts waiting for the client's UI
	ClientReady: boolean, -- the client has asked for its MetaState at least once
}

----------------------------------------------------------------------------------------------------
-- State
----------------------------------------------------------------------------------------------------

local TEMPLATE: Profile = {
	Version = PROFILE_VERSION,
	Bubbles = 0,
	Gems = 0,
	Rank = "",
	Ranks = {},
	Perks = {},
	Pets = {},
	Equipped = {},
	NextUid = 1,
	Unlocked = 1,
	BestTimes = {},
	Rebirths = 0,
	RebirthReady = false,
	DailyDay = 0,
	DailyLast = 0,
	DailyStreak = 0,
	RedeemedCodes = {},
	Ducks = {},
	Episodes = {},
	GroupReward = false,
	FollowReward = false,
	LikeReward = false,
	FollowPending = false,
	LikePending = false,
	BoostUntil = 0,
	StayBoostDay = "",
	PetIndex = {},
	PetIndexPaid = {},
	PetsResting = false,
	ReferredBy = 0,
	AdLuckStacks = 0,
	AdLuckUntil = 0,
	ChestEventId = "",
	ChestFreeUsed = 0,
	ChestsOpened = 0,
	ClubId = "",
	ClubTag = "",
	ClubMovedAt = 0,
	ClubPrizeSeason = "",
	BadgesGot = {},
	DailyNotifyAt = 0,
	Referrals = 0,
	Stats = { Runs = 0, DishesCleaned = 0, GrimeCleaned = 0, EggsHatched = 0, BubblesEarned = 0 },
	Receipts = {},
}
for _, perk in Config.Perks do
	TEMPLATE.Perks[perk.Id] = 0
end
for i = 1, #Config.Levels do
	TEMPLATE.BestTimes[i] = 0
end

local sessions: { [Player]: Session } = {}
local lastSessionOf: { [number]: Session } = {} -- userId -&gt; newest session on this server (until Done)
local passesOf: { [Player]: { [string]: boolean } } = {}
local pushQueued: { [Player]: boolean } = {}
local metaBudget: { [Player]: { Tokens: number, At: number } } = {}

local detection: Latch = { Open = false, Threads = {} } -- opens once we know whether we're offline
local offline = false
local shuttingDown = false
local activeJobs = 0 -- loads and saves in flight (BindToClose waits for these)
local initialized = false
local started = false

local store: DataStore? = nil
local rng = Random.new()

local metaRemote: RemoteEvent
local notifyRemote: RemoteEvent

DataService.ProfileLoaded = Util.Signal.new() -- (player, profile), for loaded, temporary and offline profiles
DataService.PassesChanged = Util.Signal.new() -- (player), after a pass (or pass-limited Equipped) changes

----------------------------------------------------------------------------------------------------
-- Small helpers
----------------------------------------------------------------------------------------------------

local function isFinite(n: any): boolean
	return type(n) == "number" and n == n and n ~= math.huge and n ~= -math.huge
end

-- A finite, non-negative whole number, or `default`.
local function toCount(value: any, default: number): number
	if not isFinite(value) then
		return default
	end
	return math.max(0, math.floor(value))
end

local function isPlayer(value: any): boolean
	return typeof(value) == "Instance" and value:IsA("Player")
end

local function isHere(player: Player): boolean
	return player.Parent == Players
end

local function newLatch(): Latch
	return { Open = false, Threads = {} }
end

local function openLatch(latch: Latch)
	if latch.Open then
		return
	end
	latch.Open = true
	local threads = latch.Threads
	latch.Threads = {}
	for _, thread in threads do
		task.spawn(thread)
	end
end

-- Yields until the latch opens or `timeout` seconds pass. Returns true if it opened.
local function waitLatch(latch: Latch, timeout: number): boolean
	if latch.Open then
		return true
	end
	local thread = coroutine.running()
	table.insert(latch.Threads, thread)
	task.delay(timeout, function()
		-- Still waiting? Then the latch never opened for us: wake up empty-handed.
		local index = table.find(latch.Threads, thread)
		if index then
			table.remove(latch.Threads, index)
			task.spawn(thread)
		end
	end)
	coroutine.yield()
	return latch.Open
end

-- Runs fn(...) as a tracked job so BindToClose knows to wait for it. Never throws.
local function track(fn: (...any) -&gt; ...any, ...: any)
	activeJobs += 1
	local ok, err = pcall(fn, ...)
	activeJobs -= 1
	if not ok then
		warn("[DataService] " .. tostring(err))
	end
end

local function getStore(): DataStore?
	if store then
		return store
	end
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = result
	end
	return store
end

local function newProfile(): Profile
	return Util.DeepCopy(TEMPLATE)
end

----------------------------------------------------------------------------------------------------
-- Offline detection
----------------------------------------------------------------------------------------------------

local function setOffline(value: boolean, reason: string?)
	offline = value
	if value then
		print("[DataService] Studio test: progress isn't saved (" .. tostring(reason) .. ")")
	end
	openLatch(detection)
end

-- A live server always has DataStores (an outage there is handled by retries and temp profiles, never
-- by turning saving off for the whole server). Only Studio can lack API access, so only Studio probes.
local function detectOffline()
	if game.PlaceId == 0 then
		setOffline(true, "the place isn't published")
		return
	end
	if not RunService:IsStudio() then
		setOffline(false)
		return
	end
	task.spawn(function()
		local ok, err = pcall(function()
			DataStoreService:GetDataStore(STORE_NAME):GetAsync("__probe")
		end)
		if ok then
			setOffline(false)
			return
		end
		local message = tostring(err)
		if
			string.find(message, "StudioAccessToApisNotAllowed", 1, true)
			or string.find(message, "API", 1, true)
			or string.find(string.lower(message), "publish", 1, true)
		then
			setOffline(true, message)
		else
			-- Some other hiccup: stay online. Loads retry and fall back to temp profiles if it persists.
			warn("[DataService] DataStore probe failed: " .. message)
			setOffline(false)
		end
	end)
end

----------------------------------------------------------------------------------------------------
-- Profile repair (runs after every load, outside the UpdateAsync transform)
----------------------------------------------------------------------------------------------------

-- Passes as far as pet slots are concerned. Until MarketService has checked the +2 Pet Slots pass
-- (it checks every pass one by one after the profile loads), an on-sale slot pass counts as owned,
-- so nobody who owns it is ever cut down to 3 pets while the checks are still running. Once the
-- answer is known, SetPass trims for real.
local function slotPasses(player: Player): { [string]: boolean }
	local passes = table.clone(passesOf[player] or {})
	local pass = Config.GetPass("PetSlots")
	if pass and type(pass.Id) == "number" and pass.Id &gt; 0 and passes.PetSlots == nil then
		passes.PetSlots = true
	end
	return passes
end

local function loadSlotCap(player: Player, profile: Profile): number
	return Config.PetSlots(profile.Perks, slotPasses(player))
end

local function sanitizeProfile(profile: Profile, player: Player)
	local p = profile :: any
	p.Lock = nil
	-- Reconcile only fills missing keys; wrong types from damaged or ancient saves are repaired below.
	Util.Reconcile(p, TEMPLATE :: any)

	p.Version = if isFinite(p.Version) then math.max(p.Version, PROFILE_VERSION) else PROFILE_VERSION
	p.Bubbles = toCount(p.Bubbles, 0)
	p.Gems = toCount(p.Gems, 0)
	p.Rebirths = toCount(p.Rebirths, 0)
	p.BoostUntil = toCount(p.BoostUntil, 0)
	p.StayBoostDay = if type(p.StayBoostDay) == "string" then p.StayBoostDay else ""
	p.PetsResting = p.PetsResting == true
	local index, paid = {}, {}
	for id, bits in (if type(p.PetIndex) == "table" then p.PetIndex else {}) do
		if type(id) == "string" and #id &lt;= 40 and isFinite(bits) then
			index[id] = math.clamp(math.floor(bits), 0, 7)
		end
	end
	for key, got in (if type(p.PetIndexPaid) == "table" then p.PetIndexPaid else {}) do
		if type(key) == "string" and got == true then
			paid[key] = true
		end
	end
	p.PetIndex, p.PetIndexPaid = index, paid
	p.ReferredBy = toCount(p.ReferredBy, 0)
	p.AdLuckStacks = toCount(p.AdLuckStacks, 0)
	p.AdLuckUntil = toCount(p.AdLuckUntil, 0)
	p.ChestEventId = if type(p.ChestEventId) == "string" then p.ChestEventId else ""
	p.ChestFreeUsed = toCount(p.ChestFreeUsed, 0)
	p.ChestsOpened = toCount(p.ChestsOpened, 0)
	p.ClubId = if type(p.ClubId) == "string" and #p.ClubId &lt;= 40 then p.ClubId else ""
	p.ClubTag = if type(p.ClubTag) == "string" and #p.ClubTag &lt;= 20 then p.ClubTag else ""
	p.ClubMovedAt = toCount(p.ClubMovedAt, 0)
	p.ClubPrizeSeason = if type(p.ClubPrizeSeason) == "string" and #p.ClubPrizeSeason &lt;= 8 then p.ClubPrizeSeason else ""
	local badges = {}
	for key, got in (if type(p.BadgesGot) == "table" then p.BadgesGot else {}) do
		if type(key) == "string" and #key &lt;= 30 and got == true then
			badges[key] = true
		end
	end
	p.BadgesGot = badges
	p.DailyNotifyAt = toCount(p.DailyNotifyAt, 0)
	p.Referrals = toCount(p.Referrals, 0)
	p.DailyDay = toCount(p.DailyDay, 0)
	p.DailyLast = toCount(p.DailyLast, 0)
	if p.DailyLast == 0 and p.DailyDay &gt; 0 then
		p.DailyLast = p.DailyDay * 86400 -- saves from before the 24-hour timer
	end
	p.DailyStreak = math.clamp(toCount(p.DailyStreak, 0), 0, #Config.DailyRewards)
	local codes = {}
	for _, code in (if type(p.RedeemedCodes) == "table" then p.RedeemedCodes else {}) do
		if type(code) == "string" and #code &lt;= 40 and #codes &lt; 500 then
			table.insert(codes, code)
		end
	end
	p.RedeemedCodes = codes
	local ducks = {}
	for _, id in (if type(p.Ducks) == "table" then p.Ducks else {}) do
		if type(id) == "string" and #id &lt;= 20 and #ducks &lt; 50 and not table.find(ducks, id) then
			table.insert(ducks, id)
		end
	end
	p.Ducks = ducks
	local episodes = {}
	for i = 1, #Config.Levels do
		local n = if type(p.Episodes) == "table" then p.Episodes[i] else nil
		episodes[i] = math.min(toCount(n, 0), 1e6)
	end
	p.Episodes = episodes
	p.GroupReward = p.GroupReward == true
	p.FollowReward = p.FollowReward == true
	p.LikeReward = p.LikeReward == true
	p.FollowPending = p.FollowPending == true and not p.FollowReward
	p.LikePending = p.LikePending == true and not p.LikeReward
	p.RebirthReady = p.RebirthReady == true
	local ranks, seenRank = {}, {}
	for _, id in (if type(p.Ranks) == "table" then p.Ranks else {}) do
		if type(id) == "string" and Config.GetRank(id) and not seenRank[id] then
			seenRank[id] = true
			table.insert(ranks, id)
		end
	end
	p.Ranks = ranks
	if type(p.Rank) ~= "string" or not seenRank[p.Rank] then
		p.Rank = ""
	end

	if type(p.Perks) ~= "table" then
		p.Perks = Util.DeepCopy(TEMPLATE.Perks)
	end
	for _, perk in Config.Perks do
		p.Perks[perk.Id] = math.min(toCount(p.Perks[perk.Id], 0), perk.Max) -- perks were re-capped at 6 levels
	end

	-- Pets: keep every well-formed entry (extra fields included). Uids become strings, and duplicate
	-- or missing uids get fresh ones so every pet stays addressable.
	local rawPets = if type(p.Pets) == "table" then p.Pets else {}
	local pets, seen, needsUid = {}, {}, {}
	local maxUid = 0
	for _, entry in rawPets do
		if type(entry) == "table" and type(entry.Id) == "string" then
			local uid = entry.Uid
			if isFinite(uid) then
				uid = tostring(math.floor(uid))
			end
			if type(uid) ~= "string" or uid == "" or seen[uid] then
				table.insert(needsUid, entry)
			else
				seen[uid] = true
				entry.Uid = uid
				table.insert(pets, entry)
				local n = tonumber(uid)
				if n and isFinite(n) and n &gt; maxUid and n &lt; 1e12 then
					maxUid = math.floor(n)
				end
			end
		end
	end
	local nextUid = math.max(toCount(p.NextUid, 1), maxUid + 1, 1)
	for _, entry in needsUid do
		entry.Uid = tostring(nextUid)
		nextUid += 1
		table.insert(pets, entry)
	end
	p.Pets = pets
	p.NextUid = nextUid

	-- Equipped: only uids that exist (with a pet id the game knows), no repeats, at most the slots.
	local idOf = {}
	for _, pet in pets do
		idOf[pet.Uid] = pet.Id
	end
	local cap = loadSlotCap(player, p)
	local equipped, used = {}, {}
	for _, uid in (if type(p.Equipped) == "table" then p.Equipped else {}) do
		if isFinite(uid) then
			uid = tostring(math.floor(uid))
		end
		if type(uid) == "string" and not used[uid] and idOf[uid] and Config.Pets[idOf[uid]] and #equipped &lt; cap then
			used[uid] = true
			table.insert(equipped, uid)
		end
	end
	p.Equipped = equipped

	-- BestTimes: exactly one entry per level.
	local rawTimes = if type(p.BestTimes) == "table" then p.BestTimes else {}
	local times = {}
	for i = 1, #Config.Levels do
		local t = rawTimes[i]
		times[i] = if isFinite(t) and t &gt; 0 then t else 0
	end
	p.BestTimes = times

	-- Unlocked: a valid level. Before anyone has rebirthed it is never below "one past every level
	-- already cleared" (repairs old saves); after a rebirth, best times stay but levels re-lock.
	local unlocked = math.clamp(toCount(p.Unlocked, 1), 1, #Config.Levels)
	if p.Rebirths == 0 then
		for i, t in times do
			if t &gt; 0 then
				unlocked = math.max(unlocked, math.min(i + 1, #Config.Levels))
			end
		end
		if (times[#Config.Levels] or 0) &gt; 0 then
			p.RebirthReady = true
		end
	end
	p.Unlocked = unlocked

	if type(p.Stats) ~= "table" then
		p.Stats = Util.DeepCopy(TEMPLATE.Stats)
	end
	for key in TEMPLATE.Stats :: any do
		p.Stats[key] = toCount(p.Stats[key], 0)
	end

	local receipts = {}
	if type(p.Receipts) == "table" then
		for _, id in p.Receipts do
			if type(id) == "string" then
				table.insert(receipts, id)
			end
		end
	end
	while #receipts &gt; MAX_RECEIPTS do
		table.remove(receipts, 1)
	end
	p.Receipts = receipts
end

-- Copy of the profile that is safe to store: no runtime-only keys ("Lock", anything starting with
-- "_"), no Instances or functions, and no NaN/inf (which the DataStore refuses to encode).
local function cleanValue(value: any, depth: number): any
	local kind = type(value)
	if kind == "number" then
		return if isFinite(value) then value else 0
	elseif kind == "string" or kind == "boolean" then
		return value
	elseif kind == "table" and depth &lt; 8 then
		local out = {}
		for k, v in value do
			if type(k) == "string" or type(k) == "number" then
				out[k] = cleanValue(v, depth + 1)
			end
		end
		return out
	end
	return nil
end

local function serialize(profile: Profile): { [string]: any }
	local out = {}
	for key, value in profile :: any do
		if type(key) == "string" and key ~= "Lock" and string.sub(key, 1, 1) ~= "_" then
			out[key] = cleanValue(value, 1)
		end
	end
	return out
end

----------------------------------------------------------------------------------------------------
-- Profile edits shared by the public API and the "arrived while loading" replay
----------------------------------------------------------------------------------------------------

local function applyBubbles(profile: Profile, amount: number)
	profile.Bubbles = math.max(0, profile.Bubbles + amount)
	if amount &gt; 0 then
		profile.Stats.BubblesEarned += amount
	end
end

local function applyStat(profile: Profile, statName: string, amount: number)
	local stats = profile.Stats :: any
	stats[statName] = math.max(0, (stats[statName] or 0) + amount)
end

----------------------------------------------------------------------------------------------------
-- MetaState, leaderstats and toasts
----------------------------------------------------------------------------------------------------

-- Daily reward timing (Config.Daily): claimable 24 h after the last claim; the streak carries on if
-- you claim within the grace window after that, otherwise the next claim starts again at day 1
-- (unless the streak is restored with the RestoreStreak product).
local function dailyClaimable(profile: Profile): boolean
	return profile.DailyLast == 0 or os.time() &gt;= profile.DailyLast + Config.Daily.Cooldown
end

local function dailyBroken(profile: Profile): boolean
	return profile.DailyStreak &gt; 0 and profile.DailyLast &gt; 0 and os.time() &gt;= profile.DailyLast + Config.Daily.Cooldown + Config.Daily.Grace
end

local function buildMeta(player: Player, profile: Profile): Types.MetaState
	local passes = passesOf[player] or {}
	local passCopy = {}
	for _, pass in Config.GamePasses do
		passCopy[pass.Key] = passes[pass.Key] == true
	end
	local perks = {}
	for _, perk in Config.Perks do
		perks[perk.Id] = profile.Perks[perk.Id] or 0
	end
	-- Pets whose id was removed from Config stay in the save but are hidden from the client, which
	-- could not draw them.
	local pets, known = {}, {}
	for _, pet in profile.Pets do
		if type(pet) == "table" and Config.Pets[pet.Id] then
			table.insert(pets, { Uid = pet.Uid, Id = pet.Id, Tier = if pet.Tier and pet.Tier &gt; 1 then pet.Tier else nil })
			known[pet.Uid] = true
		end
	end
	local equipped = {}
	for _, uid in profile.Equipped do
		if known[uid] then
			table.insert(equipped, uid)
		end
	end
	local stats = profile.Stats
	local state: Types.MetaState = {
		Bubbles = profile.Bubbles,
		Gems = profile.Gems,
		Rank = profile.Rank,
		Ranks = table.clone(profile.Ranks),
		Perks = perks,
		Pets = pets,
		Equipped = equipped,
		PetSlots = Config.PetSlots(profile.Perks, slotPasses(player)),
		MaxPets = Config.PetRules.MaxInventory,
		Unlocked = profile.Unlocked,
		BestTimes = table.clone(profile.BestTimes),
		Rebirths = profile.Rebirths,
		RebirthReady = profile.RebirthReady,
		DailyStreak = profile.DailyStreak,
		DailyClaimedToday = not dailyClaimable(profile),
		DailyReadyAt = if profile.DailyLast &gt; 0 then profile.DailyLast + Config.Daily.Cooldown else 0,
		DailyBroken = dailyBroken(profile),
		GroupReward = profile.GroupReward,
		FollowState = if profile.FollowReward then "Claimed" elseif profile.FollowPending then "Pending" else "",
		LikeState = if profile.LikeReward then "Claimed" elseif profile.LikePending then "Pending" else "",
		BoostUntil = profile.BoostUntil,
		StayBoostReady = profile.StayBoostDay ~= os.date("!%Y-%m-%d"),
		PetsResting = profile.PetsResting,
		PetIndex = table.clone(profile.PetIndex),
		PetIndexPaid = table.clone(profile.PetIndexPaid),
		Referrals = profile.Referrals,
		AdLuckStacks = DataService.AdLuckStacks(profile),
		AdLuckUntil = profile.AdLuckUntil,
		ChestFreeLeft = DataService.FreeChestsLeft(profile),
		ChestsOpened = profile.ChestsOpened,
		ClubId = profile.ClubId,
		LevelsBeaten = DataService.LevelsBeaten(profile),
		Stats = {
			Runs = stats.Runs,
			DishesCleaned = stats.DishesCleaned,
			GrimeCleaned = stats.GrimeCleaned,
			EggsHatched = stats.EggsHatched,
			BubblesEarned = stats.BubblesEarned,
		},
		Passes = passCopy,
		Episodes = table.clone(profile.Episodes),
	}
	return state
end

local function setupLeaderstats(player: Player)
	if player:FindFirstChild("leaderstats") then
		return
	end
	local folder = Instance.new("Folder")
	folder.Name = "leaderstats"
	-- Children are created in display order: Bubbles, then Dishes.
	for _, name in { "Bubbles", "Dishes" } do
		local value = Instance.new("IntValue")
		value.Name = name
		value.Value = 0
		value.Parent = folder
	end
	folder.Parent = player
end

local function setLeaderstat(player: Player, name: string, amount: number)
	local folder = player:FindFirstChild("leaderstats")
	local value = folder and folder:FindFirstChild(name)
	if value and value:IsA("IntValue") then
		value.Value = math.floor(amount)
	end
end

local queueNotice: (Session, string, string) -&gt; ()

-- Remembers every pet species/tier the player holds, and pays the Gems for a finished set once.
local function updatePetIndex(session: Session, profile: Profile)
	for _, pet in profile.Pets do
		if Config.Pets[pet.Id] then
			local bit = bit32.lshift(1, math.clamp(math.floor(tonumber(pet.Tier) or 1), 1, #Config.PetTiers) - 1)
			profile.PetIndex[pet.Id] = bit32.bor(profile.PetIndex[pet.Id] or 0, bit)
		end
	end
	for _, set in Config.Collection.Sets do
		local key = tostring(set.Tier)
		if not profile.PetIndexPaid[key] and Config.CollectionSetDone(profile.PetIndex, set.Tier) then
			profile.PetIndexPaid[key] = true
			profile.Gems += set.Gems
			queueNotice(session, string.format("Collection complete: every %s pet! +%d Gems and a bigger coin bonus!", set.Name, set.Gems), "Good")
		end
	end
end

local function pushNow(player: Player)
	local session = sessions[player]
	local profile = session and session.Profile
	if not profile or not isHere(player) then
		return
	end
	updatePetIndex(session, profile)
	player:SetAttribute("Bubbles", profile.Bubbles)
	setLeaderstat(player, "Bubbles", profile.Bubbles)
	setLeaderstat(player, "Dishes", profile.Stats.DishesCleaned)
	metaRemote:FireClient(player, buildMeta(player, profile))
end

local function flushNotices(session: Session)
	local player = session.Player
	if #session.Notices == 0 or not isHere(player) then
		return
	end
	local list = session.Notices
	session.Notices = {}
	for _, notice in list do
		notifyRemote:FireClient(player, notice[1], notice[2])
	end
end

-- Toasts sent the instant a player joins can arrive before their UI exists, so they wait until the
-- client has asked for its MetaState (or a fallback delay passes).
queueNotice = function(session: Session, text: string, kind: string)
	table.insert(session.Notices, { text, kind })
	task.delay(if session.ClientReady then NOTICE_AFTER_READY else NOTICE_FALLBACK, flushNotices, session)
end

----------------------------------------------------------------------------------------------------
-- Saving
----------------------------------------------------------------------------------------------------

local function ownsLock(record: { [string]: any }): boolean
	local lock = record.Lock
	return type(lock) == "table" and lock.JobId == game.JobId
end

local function lockedElsewhere(record: { [string]: any }): boolean
	local lock = record.Lock
	if type(lock) ~= "table" or lock.JobId == game.JobId or not isFinite(lock.Time) then
		return false
	end
	-- The other server saved this player just before teleporting them here and said so: the save is
	-- up to date, so take it now instead of waiting for that server to notice they left.
	if lock.Handoff == true and os.time() - lock.Time &lt; HANDOFF_TTL then
		return false
	end
	return os.time() - lock.Time &lt; LOCK_TTL
end

-- Saves for one session run one at a time (an autosave and the final save must never race).
local function acquireSaveSlot(session: Session)
	while session.Busy do
		table.insert(session.SaveQueue, coroutine.running())
		coroutine.yield()
	end
	session.Busy = true
end

local function releaseSaveSlot(session: Session)
	session.Busy = false
	local nextThread = table.remove(session.SaveQueue, 1)
	if nextThread then
		task.spawn(nextThread)
	end
end

-- One UpdateAsync: writes the profile and refreshes the lock (or clears it when `release`).
-- It only writes while this server still owns the lock; otherwise saving stops for this session.
local function writeProfile(session: Session, release: boolean): boolean
	local profile = session.Profile
	local dataStore = getStore()
	if not profile or not dataStore then
		return false
	end
	-- Everything that could be slow happens before UpdateAsync: the transform itself must not yield.
	local payload = serialize(profile)
	local userIds = { session.UserId }
	local outcome = "Error"
	local ok, err = pcall(function()
		dataStore:UpdateAsync(session.Key, function(old)
			if old == nil then
				outcome = "Missing" -- the save was erased (e.g. a data-removal request); don't resurrect it
				return nil
			end
			if type(old) ~= "table" or not ownsLock(old) then
				outcome = "LockLost"
				return nil
			end
			payload.Lock = if release
				then nil
				else { JobId = game.JobId, Time = os.time(), Handoff = if session.Handoff then true else nil }
			outcome = "Ok"
			return payload, userIds
		end)
	end)
	if not ok then
		warn(string.format("[DataService] save failed for %s: %s", session.Key, tostring(err)))
		return false
	end
	if outcome == "Ok" then
		return true
	end
	-- Another server owns this save now (or it's gone). Writing from here would clobber it.
	session.CanSave = false
	warn(string.format("[DataService] stopped saving %s (%s)", session.Key, outcome))
	if outcome == "LockLost" and not session.Left and isHere(session.Player) then
		queueNotice(session, MSG_LOCK_LOST, "Bad")
	end
	return false
end

local function saveSession(session: Session, release: boolean, attempts: number): boolean
	if not session.CanSave or not session.Profile or session.Released then
		return false
	end
	acquireSaveSlot(session)
	local saved = false
	for attempt = 1, attempts do
		if not session.CanSave or session.Released then
			break
		end
		saved = writeProfile(session, release)
		if saved or not session.CanSave then
			break
		end
		if attempt &lt; attempts then
			task.wait(attempt * 2)
		end
	end
	if saved and release then
		session.Released = true
	end
	releaseSaveSlot(session)
	return saved
end

local function autosave(session: Session)
	if not saveSession(session, false, 1) and session.CanSave and not session.Finalizing then
		session.NextAutosave = math.min(session.NextAutosave, os.clock() + AUTOSAVE_RETRY)
	end
end

-- Marks a session completely finished: wakes anyone waiting on it and forgets it.
local function finishSession(session: Session)
	openLatch(session.Loaded)
	openLatch(session.Done)
	if lastSessionOf[session.UserId] == session then
		lastSessionOf[session.UserId] = nil
	end
end

-- The last save of a session: writes the profile and releases the lock. Safe to call more than once.
local function finalize(session: Session)
	if session.Finalizing then
		return
	end
	session.Finalizing = true
	if session.CanSave and session.Profile then
		if not saveSession(session, true, FINAL_SAVE_ATTEMPTS) and session.CanSave then
			warn("[DataService] final save failed for " .. session.Key .. "; its lock expires on its own")
		end
	end
	finishSession(session)
end

----------------------------------------------------------------------------------------------------
-- Loading
----------------------------------------------------------------------------------------------------

-- Loads the record and takes the session lock. Returns:
--   "Ok", record   -&gt; we own the lock and have the data (a brand-new player gets the template)
--   "Abort", nil   -&gt; the player left or the server is closing; nothing was locked
--   "Failed", nil  -&gt; DataStore errors on every attempt, or a record we can't read
local function loadFromStore(session: Session): (string, any)
	local lockedTries, errorTries = 0, 0
	while true do
		if session.Left or shuttingDown or not isHere(session.Player) then
			return "Abort", nil
		end
		local steal = lockedTries &gt;= LOCK_RETRIES
		local status: string? = nil
		local record: any = nil
		local ok, err = false, "DataStoreService unavailable"
		local dataStore = getStore()
		if dataStore then
			local userIds = { session.UserId }
			ok, err = pcall(function()
				dataStore:UpdateAsync(session.Key, function(old)
					-- Must not yield. UpdateAsync may call this more than once; the last call wins.
					status, record = nil, nil
					if old ~= nil and type(old) ~= "table" then
						status = "Corrupt"
						return nil
					end
					if old ~= nil and not steal and lockedElsewhere(old) then
						status = "Locked"
						return nil
					end
					local data = if old ~= nil then old else Util.DeepCopy(TEMPLATE) :: any
					data.Lock = { JobId = game.JobId, Time = os.time() }
					status, record = "Ok", data
					return data, userIds
				end)
			end)
		end

		if ok and status == "Ok" then
			if steal then
				warn("[DataService] took over a stale session lock for " .. session.Key)
			end
			return "Ok", record
		elseif ok and status == "Corrupt" then
			warn("[DataService] unreadable save for " .. session.Key .. "; it will not be touched")
			return "Failed", nil
		elseif ok and status == "Locked" then
			-- Another server is still saving this player (a server hop). Give it a moment.
			lockedTries += 1
			task.wait(rng:NextNumber(LOCK_WAIT_MIN, LOCK_WAIT_MAX))
		else
			errorTries += 1
			warn(string.format("[DataService] load attempt %d for %s failed: %s", errorTries, session.Key, tostring(err)))
			if errorTries &gt;= LOAD_ATTEMPTS then
				return "Failed", nil
			end
			task.wait(math.min(1.5 * errorTries, 6) + rng:NextNumber(0, 1))
		end
	end
end


-- When a stay boost runs out, run stats drop back to normal (on whichever server they're on now).
local function watchBoostEnd(player: Player)
	local profile = DataService.Get(player)
	local untilTime = profile and profile.BoostUntil or 0
	if untilTime &lt;= os.time() then
		return
	end
	task.delay(untilTime - os.time() + 1, function()
		local p = DataService.Get(player)
		if p and p.BoostUntil == untilTime then
			DataService.PushMeta(player)
			DataService.PassesChanged:Fire(player)
		end
	end)
end

local function loadSession(session: Session)
	local player = session.Player

	-- A quick rejoin to this same server: let the previous session's final save land first, or we
	-- could read the save from before it.
	local previous = session.Previous
	session.Previous = nil
	if previous then
		waitLatch(previous.Done, SAME_USER_WAIT)
	end
	if not detection.Open then
		waitLatch(detection, PROBE_WAIT * 3)
	end

	local profile: Profile
	local canSave = false
	local notice: string? = nil
	local noticeKind = "Info"
	if offline then
		profile = newProfile()
		notice = MSG_OFFLINE
	else
		local status, record = loadFromStore(session)
		if status == "Abort" then
			finishSession(session)
			return
		end
		if status == "Ok" then
			profile = record
			canSave = true
		else
			-- Never overwrite a save we couldn't read: play on a temporary profile that is never saved.
			profile = newProfile()
			notice, noticeKind = MSG_LOAD_FAILED, "Bad"
			warn("[DataService] using a temporary unsaved profile for " .. session.Key)
		end
	end

	sanitizeProfile(profile, player)
	-- Rewards that arrived while we were loading.
	for _, change in session.Pending do
		if change.Stat then
			applyStat(profile, change.Stat, change.Amount)
		else
			applyBubbles(profile, change.Amount)
		end
	end
	session.Pending = {}

	session.Profile = profile
	session.CanSave = canSave
	session.NextAutosave = os.clock() + AUTOSAVE_INTERVAL + rng:NextNumber(0, AUTOSAVE_JITTER)

	if session.Left or not isHere(player) then
		-- They left while we were loading: hand the lock straight back.
		finalize(session)
		return
	end

	openLatch(session.Loaded)
	if notice then
		queueNotice(session, notice, noticeKind)
	end
	player:SetAttribute("PetsResting", profile.PetsResting == true) -- PetService reads this
	player:SetAttribute("ClubTag", if profile.ClubTag ~= "" then profile.ClubTag else nil) -- NameTags
	DataService.ProfileLoaded:Fire(player, profile)
	pushNow(player)
	task.defer(watchBoostEnd, player)

	if shuttingDown then
		finalize(session)
	end
end

local function ensureSession(player: Player): Session?
	local existing = sessions[player]
	if existing then
		return existing
	end
	if not isHere(player) then
		return nil
	end
	local userId = player.UserId
	local previous = lastSessionOf[userId]
	local session: Session = {
		Player = player,
		UserId = userId,
		Key = KEY_PREFIX .. tostring(userId),
		Profile = nil,
		CanSave = false,
		Left = false,
		Finalizing = false,
		Handoff = false,
		Released = false,
		Busy = false,
		SaveQueue = {},
		Loaded = newLatch(),
		Done = newLatch(),
		Previous = if previous and not previous.Done.Open then previous else nil,
		NextAutosave = math.huge,
		Pending = {},
		Notices = {},
		ClientReady = false,
	}
	sessions[player] = session
	lastSessionOf[userId] = session
	if not passesOf[player] then
		passesOf[player] = {}
	end
	setupLeaderstats(player)
	task.spawn(track, loadSession, session)
	return session
end

local function onPlayerRemoving(player: Player)
	local session = sessions[player]
	sessions[player] = nil
	passesOf[player] = nil
	pushQueued[player] = nil
	metaBudget[player] = nil
	if not session then
		return
	end
	session.Left = true
	openLatch(session.Loaded) -- WaitFor callers wake up and get nil
	if session.Profile then
		task.spawn(track, finalize, session)
	end
	-- Still loading: loadSession notices Left and releases the lock itself.
end

----------------------------------------------------------------------------------------------------
-- GetMeta
----------------------------------------------------------------------------------------------------

local function allowMetaRequest(player: Player): boolean
	local now = os.clock()
	local budget = metaBudget[player]
	if not budget then
		budget = { Tokens = META_REQUESTS_PER_SECOND, At = now }
		metaBudget[player] = budget
	end
	budget.Tokens = math.min(META_REQUESTS_PER_SECOND, budget.Tokens + (now - budget.At) * META_REQUESTS_PER_SECOND)
	budget.At = now
	if budget.Tokens &lt; 1 then
		return false
	end
	budget.Tokens -= 1
	return true
end

local function onGetMeta(player: Player): Types.MetaState?
	local session = sessions[player]
	if not session or not isHere(player) or not allowMetaRequest(player) then
		return nil
	end
	if not session.ClientReady then
		-- The client's remotes are hooked up now; anything waiting to be said can go out shortly.
		session.ClientReady = true
		task.delay(NOTICE_AFTER_READY, flushNotices, session)
	end
	local profile = session.Profile
	if not profile then
		return nil
	end
	return buildMeta(player, profile)
end

----------------------------------------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------------------------------------

function DataService.Init()
	if initialized then
		return
	end
	initialized = true

	metaRemote = Remotes.Event("MetaState")
	notifyRemote = Remotes.Event("Notify")
	Remotes.Function("GetMeta").OnServerInvoke = onGetMeta

	detectOffline()

	Players.PlayerAdded:Connect(function(player)
		ensureSession(player)
	end)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, player in Players:GetPlayers() do
		ensureSession(player)
	end

	game:BindToClose(function()
		shuttingDown = true
		if not detection.Open then
			waitLatch(detection, 3)
		end
		if offline then
			return
		end
		for _, session in sessions do
			if session.Profile then
				task.spawn(track, finalize, session)
			end
		end
		-- Sessions still loading abort (or release right after loading); PlayerRemoving saves run too.
		local deadline = os.clock() + SHUTDOWN_WAIT
		while activeJobs &gt; 0 and os.clock() &lt; deadline do
			task.wait(0.25)
		end
		if activeJobs &gt; 0 then
			warn(string.format("[DataService] shutdown: %d save(s) still running after %ds", activeJobs, SHUTDOWN_WAIT))
		end
	end)
end

function DataService.Start()
	if started then
		return
	end
	started = true
	task.spawn(function()
		while true do
			task.wait(AUTOSAVE_TICK)
			if not shuttingDown and not offline then
				local now = os.clock()
				for _, session in sessions do
					if
						session.CanSave
						and session.Profile
						and not session.Finalizing
						and not session.Busy
						and now &gt;= session.NextAutosave
					then
						session.NextAutosave = now + AUTOSAVE_INTERVAL
						task.spawn(track, autosave, session)
					end
				end
			end
		end
	end)
end

-- The player's profile, or nil while it's loading (or after they left).
function DataService.Get(player: Player): Profile?
	local session = sessions[player]
	return session and session.Profile
end

-- Yields until the profile is ready (or `timeout` seconds pass, default 60, or the player leaves).
function DataService.WaitFor(player: Player, timeout: number?): Profile?
	if not isPlayer(player) then
		return nil
	end
	local session = ensureSession(player)
	if not session then
		return nil
	end
	if not session.Profile then
		waitLatch(session.Loaded, if isFinite(timeout) then math.max(0, timeout :: number) else 60)
	end
	return DataService.Get(player)
end

-- Coalesces MetaState pushes: any number of calls within PUSH_COALESCE seconds send one snapshot.
function DataService.PushMeta(player: Player)
	if not isPlayer(player) or pushQueued[player] or not sessions[player] then
		return
	end
	pushQueued[player] = true
	task.delay(PUSH_COALESCE, function()
		if not pushQueued[player] then
			return -- the player left in the meantime
		end
		pushQueued[player] = nil
		pushNow(player)
	end)
end

-- Adds (or with a negative amount, removes) Bubbles. Positive amounts also count toward
-- Stats.BubblesEarned. `reason` is only used in warnings. Returns false if nothing was applied.
function DataService.AddBubbles(player: Player, amount: number, reason: string?): boolean
	if not isFinite(amount) then
		warn("[DataService] AddBubbles ignored a bad amount (" .. tostring(reason) .. ")")
		return false
	end
	local rounded = math.floor(amount + 0.5)
	local session = sessions[player]
	if not session then
		return false
	end
	if rounded == 0 then
		return true
	end
	local profile = session.Profile
	if not profile then
		table.insert(session.Pending, { Amount = rounded })
		return true
	end
	applyBubbles(profile, rounded)
	DataService.PushMeta(player)
	return true
end

-- Counts one run-start cutscene chapter as seen for a level (the next run plays the next one).
function DataService.SawEpisode(player: Player, levelIndex: number): boolean
	local profile = DataService.Get(player)
	if not profile or type(levelIndex) ~= "number" or levelIndex ~= levelIndex then
		return false
	end
	local i = math.floor(levelIndex)
	if i &lt; 1 or i &gt; #Config.Levels then
		return false
	end
	profile.Episodes[i] = math.min((profile.Episodes[i] or 0) + 1, 1e6)
	DataService.PushMeta(player)
	return true
end

-- Marks a lobby rubber duck as found. Returns (isNew, foundCount).
function DataService.FindDuck(player: Player, duckId: string): (boolean, number)
	local profile = DataService.Get(player)
	if not profile then
		return false, 0
	end
	if table.find(profile.Ducks, duckId) then
		return false, #profile.Ducks
	end
	table.insert(profile.Ducks, duckId)
	return true, #profile.Ducks
end

-- Takes Bubbles if the player has enough. Returns true when paid.
function DataService.SpendBubbles(player: Player, amount: number): boolean
	local profile = DataService.Get(player)
	if not profile or not isFinite(amount) or amount &lt; 0 then
		return false
	end
	local cost = math.ceil(amount)
	if profile.Bubbles &lt; cost then
		return false
	end
	profile.Bubbles -= cost
	DataService.PushMeta(player)
	return true
end

-- Gems (premium currency). Returns true when applied.
function DataService.AddGems(player: Player, amount: number): boolean
	local profile = DataService.Get(player)
	if not profile or not isFinite(amount) or amount &lt;= 0 then
		return false
	end
	profile.Gems += math.floor(amount + 0.5)
	DataService.PushMeta(player)
	return true
end

function DataService.SpendGems(player: Player, amount: number): boolean
	local profile = DataService.Get(player)
	if not profile or not isFinite(amount) or amount &lt; 0 then
		return false
	end
	local cost = math.ceil(amount)
	if profile.Gems &lt; cost then
		return false
	end
	profile.Gems -= cost
	DataService.PushMeta(player)
	return true
end

-- Claims the daily reward if 24 hours have passed since the last claim. Returns the streak day
-- claimed (1..7) or nil and an error.
function DataService.ClaimDaily(player: Player): (number?, string?)
	local profile = DataService.Get(player)
	if not profile then
		return nil, "Your data is still loading."
	end
	if not dailyClaimable(profile) then
		return nil, "Come back when the timer runs out!"
	end
	local streak = if dailyBroken(profile) or profile.DailyLast == 0 then 1 else profile.DailyStreak % #Config.DailyRewards + 1
	local reward = Config.DailyRewards[streak]
	profile.DailyLast = os.time()
	profile.DailyStreak = streak
	if reward.Kind == "Gems" then
		profile.Gems += reward.Amount
	else
		applyBubbles(profile, reward.Amount)
	end
	local session = sessions[player]
	if session then
		session.NextAutosave = math.min(session.NextAutosave, os.clock() + SAVE_SOON_DELAY)
	end
	DataService.PushMeta(player)
	return streak, nil
end

-- The "stay" boost: offered when a player opens the Roblox menu (often on the way out). x2 cleaning
-- for STAY_BOOST_SECONDS, claimable once per UTC day. Returns (ok, message).
local STAY_BOOST_SECONDS = 15 * 60
function DataService.ClaimStayBoost(player: Player): (boolean, string)
	local profile = DataService.Get(player)
	if not profile then
		return false, "Your data is still loading."
	end
	local today = os.date("!%Y-%m-%d")
	if profile.StayBoostDay == today then
		return false, "You've had today's free boost already. Come back tomorrow!"
	end
	profile.StayBoostDay = today
	profile.BoostUntil = math.max(os.time(), profile.BoostUntil) + STAY_BOOST_SECONDS
	-- Saved within seconds, so leaving and rejoining can't claim it again.
	local session = sessions[player]
	if session then
		session.NextAutosave = math.min(session.NextAutosave, os.clock() + 2)
	end
	DataService.PushMeta(player)
	DataService.PassesChanged:Fire(player) -- run stats pick up the x2 now
	watchBoostEnd(player)
	return true, "x2 Cleaning for 15 minutes! Enjoy!"
end

-- Adds `seconds` of x2 cleaning (the stay boost) on top of whatever's left. Admin events use this.
function DataService.AddBoost(player: Player, seconds: number): boolean
	local profile = DataService.Get(player)
	if not profile or not isFinite(seconds) or seconds &lt;= 0 then
		return false
	end
	profile.BoostUntil = math.max(os.time(), profile.BoostUntil) + math.floor(seconds)
	DataService.PushMeta(player)
	DataService.PassesChanged:Fire(player) -- run stats pick up the x2 now
	watchBoostEnd(player)
	return true
end

-- Referrals (SocialService). The new player's side: only for someone who hasn't really played yet
-- (no runs, dishes or rebirths) and wasn't referred before. Returns true if it paid out.
function DataService.ClaimReferred(player: Player, inviterId: number): boolean
	local profile = DataService.Get(player)
	if not profile or profile.ReferredBy ~= 0 or inviterId == player.UserId or inviterId &lt;= 0 then
		return false
	end
	if profile.Stats.Runs &gt; 0 or profile.Stats.DishesCleaned &gt; 0 or profile.Rebirths &gt; 0 then
		return false
	end
	profile.ReferredBy = inviterId
	local reward = Config.Social.ReferredReward
	profile.Gems += reward.Gems or 0
	applyBubbles(profile, reward.Bubbles or 0)
	local session = sessions[player]
	if session then
		session.NextAutosave = math.min(session.NextAutosave, os.clock() + 2)
	end
	DataService.PushMeta(player)
	return true
end

-- The inviter's side: `count` new friends joined through their invites. Returns how many paid out
-- (capped at Config.Social.MaxReferrals in total).
function DataService.AddReferrals(player: Player, count: number): number
	local profile = DataService.Get(player)
	if not profile or not isFinite(count) or count &lt;= 0 then
		return 0
	end
	local paid = math.min(math.floor(count), math.max(0, Config.Social.MaxReferrals - profile.Referrals))
	if paid &lt;= 0 then
		return 0
	end
	profile.Referrals += paid
	local reward = Config.Social.ReferralReward
	profile.Gems += (reward.Gems or 0) * paid
	applyBubbles(profile, (reward.Bubbles or 0) * paid)
	local session = sessions[player]
	if session then
		session.NextAutosave = math.min(session.NextAutosave, os.clock() + 2)
	end
	DataService.PushMeta(player)
	return paid
end

-- Treasure Chest event: free chests still to open in the current event.
function DataService.FreeChestsLeft(profile: any): number
	local event = Config.ChestEvent
	if not profile or not Config.ChestEventLive() then
		return 0
	end
	local used = if profile.ChestEventId == event.Id then profile.ChestFreeUsed else 0
	return math.max(0, event.FreeOpens - used)
end

-- Uses one free chest. False when there are none left.
function DataService.UseFreeChest(player: Player): boolean
	local profile = DataService.Get(player)
	if not profile or DataService.FreeChestsLeft(profile) &lt;= 0 then
		return false
	end
	if profile.ChestEventId ~= Config.ChestEvent.Id then
		profile.ChestEventId = Config.ChestEvent.Id
		profile.ChestFreeUsed = 0
	end
	profile.ChestFreeUsed += 1
	return true
end

-- Counts opened chests (after the rewards are given) and saves soon.
function DataService.CountChests(player: Player, count: number)
	local session = sessions[player]
	local profile = session and session.Profile
	if not profile then
		return
	end
	profile.ChestsOpened += math.max(0, math.floor(count))
	session.NextAutosave = math.min(session.NextAutosave, os.clock() + SAVE_SOON_DELAY)
	DataService.PushMeta(player)
end

-- The highest level this player has ever cleared (club requirements). Rebirthing means every level.
function DataService.LevelsBeaten(profile: any): number
	if not profile then
		return 0
	end
	if (profile.Rebirths or 0) &gt; 0 then
		return #Config.Levels
	end
	local best = 0
	for i = 1, #Config.Levels do
		if (tonumber(profile.BestTimes and profile.BestTimes[i]) or 0) &gt; 0 then
			best = i
		end
	end
	return best
end

-- Notes that this club-contest month's prize was dealt with (saved soon).
function DataService.MarkClubPrize(player: Player, season: string)
	local session = sessions[player]
	local profile = session and session.Profile
	if not profile then
		return
	end
	profile.ClubPrizeSeason = season
	session.NextAutosave = math.min(session.NextAutosave, os.clock() + SAVE_SOON_DELAY)
end

-- Club membership on the profile (ClubService owns the clubs themselves).
function DataService.SetClub(player: Player, clubId: string, tag: string, moved: boolean?)
	local session = sessions[player]
	local profile = session and session.Profile
	if not profile then
		return
	end
	profile.ClubId = clubId
	profile.ClubTag = tag
	if moved then
		profile.ClubMovedAt = os.time()
	end
	player:SetAttribute("ClubTag", if tag ~= "" then tag else nil)
	session.NextAutosave = math.min(session.NextAutosave, os.clock() + SAVE_SOON_DELAY)
	DataService.PushMeta(player)
end

-- Rewarded-ad luck was removed (friends' luck replaced it); kept as no-ops for old callers.
function DataService.AdLuckStacks(_profile: any): number
	return 0
end

function DataService.AddAdLuck(_player: Player): boolean
	return false
end

-- The pets on / off switch: resting pets follow you but don't clean. Saved, so it carries over
-- between the lobby and the dishwashers.
function DataService.SetPetsResting(player: Player, resting: boolean): boolean
	local profile = DataService.Get(player)
	if not profile then
		return false
	end
	profile.PetsResting = resting == true
	player:SetAttribute("PetsResting", profile.PetsResting)
	DataService.PushMeta(player)
	return true
end

-- RestoreStreak product: a missed day is forgiven, so the next claim (available now) carries on
-- from the streak you had.
function DataService.RestoreStreak(player: Player): boolean
	local profile = DataService.Get(player)
	if not profile then
		return false
	end
	if dailyBroken(profile) then
		-- As if the last claim was exactly 24 hours ago: claimable now, and the streak carries on.
		profile.DailyLast = os.time() - Config.Daily.Cooldown
	end
	DataService.PushMeta(player)
	return true
end

-- Redeems a code from Config.Codes (any capitalisation) once per player.
function DataService.RedeemCode(player: Player, text: string): (boolean, string)
	local profile = DataService.Get(player)
	if not profile then
		return false, "Your data is still loading."
	end
	local code = string.upper((string.gsub(text, "%s", "")))
	local def = Config.Codes[code]
	if not def or (def.Expires and os.time() &gt; def.Expires) then
		return false, "That code doesn't work."
	end
	if table.find(profile.RedeemedCodes, code) then
		return false, "You already used that code!"
	end
	table.insert(profile.RedeemedCodes, code)
	if def.Gems then
		profile.Gems += def.Gems
	end
	if def.Bubbles then
		applyBubbles(profile, def.Bubbles)
	end
	local session = sessions[player]
	if session then
		session.NextAutosave = math.min(session.NextAutosave, os.clock() + SAVE_SOON_DELAY)
	end
	DataService.PushMeta(player)
	return true, Config.RewardText(def)
end

-- A toast for this player that waits until their UI is up (safe to call right after joining).
function DataService.Notice(player: Player, text: string, kind: string)
	local session = sessions[player]
	if session then
		queueNotice(session, text, kind)
	end
end

-- Follow / Like rewards (Config.Social): "Follow" or "Like". Pending is set by the button and
-- settled by SocialService on the next join.
function DataService.SetSocialPending(player: Player, kind: string, pending: boolean): boolean
	local profile = DataService.Get(player)
	if not profile then
		return false
	end
	if kind == "Follow" then
		profile.FollowPending = pending and not profile.FollowReward
	elseif kind == "Like" then
		profile.LikePending = pending and not profile.LikeReward
	else
		return false
	end
	DataService.PushMeta(player)
	return true
end

function DataService.GrantSocialReward(player: Player, kind: string): boolean
	local profile = DataService.Get(player)
	if not profile then
		return false
	end
	local reward
	if kind == "Follow" and not profile.FollowReward then
		profile.FollowReward = true
		profile.FollowPending = false
		reward = Config.Social.FollowReward
	elseif kind == "Like" and not profile.LikeReward and Config.Social.LikeReward then
		profile.LikeReward = true
		profile.LikePending = false
		reward = Config.Social.LikeReward :: any
	else
		return false
	end
	profile.Gems += reward.Gems or 0
	applyBubbles(profile, reward.Bubbles or 0)
	local session = sessions[player]
	if session then
		session.NextAutosave = math.min(session.NextAutosave, os.clock() + SAVE_SOON_DELAY)
	end
	DataService.PushMeta(player)
	return true
end

-- The one-time community reward (ShopService checks membership first).
function DataService.GrantGroupReward(player: Player): boolean
	local profile = DataService.Get(player)
	if not profile or profile.GroupReward then
		return false
	end
	profile.GroupReward = true
	local reward = Config.Social.GroupReward
	profile.Gems += reward.Gems or 0
	applyBubbles(profile, reward.Bubbles or 0)
	local session = sessions[player]
	if session then
		session.NextAutosave = math.min(session.NextAutosave, os.clock() + SAVE_SOON_DELAY)
	end
	DataService.PushMeta(player)
	return true
end

-- Rebirth: needs the last level cleared since the last rebirth and Config.RebirthCost Bubbles.
-- Resets Bubbles, unlocked levels and perks; keeps pets, gems, ranks, passes and best times; adds
-- one rebirth (permanent coin and Bubble bonuses, see Config.Rebirth) and some gems.
function DataService.Rebirth(player: Player): (boolean, string?)
	local profile = DataService.Get(player)
	if not profile then
		return false, "Your data is still loading."
	end
	if not profile.RebirthReady then
		local last = Config.Levels[#Config.Levels]
		return false, string.format("Clean %s %s first!", last.Icon, last.Name)
	end
	local cost = Config.RebirthCost(profile.Rebirths)
	if profile.Bubbles &lt; cost then
		return false, string.format("You need %s Bubbles to rebirth.", Format.Commas(cost))
	end
	profile.Rebirths += 1
	profile.RebirthReady = false
	profile.Bubbles = 0
	profile.Unlocked = 1
	for id in profile.Perks do
		profile.Perks[id] = 0
	end
	profile.Gems += Config.RebirthGems(profile.Rebirths)
	local session = sessions[player]
	if session then
		session.NextAutosave = math.min(session.NextAutosave, os.clock() + SAVE_SOON_DELAY)
	end
	DataService.PushMeta(player)
	DataService.PassesChanged:Fire(player) -- run stats depend on rebirths too
	return true, nil
end

-- Adds a rank to the collection (no-op if owned). Returns true if it was new.
function DataService.AddRank(player: Player, rankId: string): boolean
	local profile = DataService.Get(player)
	if not profile or not Config.GetRank(rankId) or table.find(profile.Ranks, rankId) then
		return false
	end
	table.insert(profile.Ranks, rankId)
	DataService.PushMeta(player)
	return true
end

function DataService.SetRank(player: Player, rankId: string): boolean
	local profile = DataService.Get(player)
	if not profile or (rankId ~= "" and not table.find(profile.Ranks, rankId)) then
		return false
	end
	profile.Rank = rankId
	DataService.PushMeta(player)
	DataService.PassesChanged:Fire(player) -- same effect as a pass change: run stats recompute
	return true
end

-- Adds to one of profile.Stats (Runs, DishesCleaned, GrimeCleaned, EggsHatched, BubblesEarned).
function DataService.AddStat(player: Player, statName: string, amount: number): boolean
	if type(statName) ~= "string" or (TEMPLATE.Stats :: any)[statName] == nil or not isFinite(amount) then
		return false
	end
	local rounded = math.floor(amount + 0.5)
	local session = sessions[player]
	if not session then
		return false
	end
	if rounded == 0 then
		return true
	end
	local profile = session.Profile
	if not profile then
		table.insert(session.Pending, { Stat = statName, Amount = rounded })
		return true
	end
	applyStat(profile, statName, rounded)
	DataService.PushMeta(player)
	return true
end

-- Runtime pass ownership ({ [Key] = true }). Read-only for callers.
function DataService.GetPasses(player: Player): { [string]: boolean }
	return passesOf[player] or {}
end

-- Records pass ownership for this session. When it changes, Equipped is trimmed to the (possibly
-- smaller) slot count, MetaState is pushed and PassesChanged fires so run stats and pets update.
function DataService.SetPass(player: Player, key: string, owned: boolean)
	if not isPlayer(player) or type(key) ~= "string" then
		return
	end
	local passes = passesOf[player]
	if not passes then
		if not isHere(player) then
			return
		end
		passes = {}
		passesOf[player] = passes
	end
	local value = owned == true
	local changed = (passes[key] == true) ~= value
	passes[key] = value

	-- Loading trims Equipped as if an on-sale slot pass were owned; now that we know, trim for real.
	local trimmed = false
	local profile = DataService.Get(player)
	if profile then
		local slots = Config.PetSlots(profile.Perks, slotPasses(player))
		while #profile.Equipped &gt; slots do
			table.remove(profile.Equipped)
			trimmed = true
		end
	end

	if changed or trimmed then
		DataService.PushMeta(player)
		DataService.PassesChanged:Fire(player)
	end
end

function DataService.GetPetSlots(player: Player): number
	local profile = DataService.Get(player)
	return Config.PetSlots(profile and profile.Perks, slotPasses(player))
end

-- Records a finished run. Returns (firstClear, newBest, unlockedLevel?). A first clear also counts as
-- a new best. The next level unlocks if it exists and wasn't unlocked yet.
function DataService.RecordClear(player: Player, levelIndex: number, seconds: number): (boolean, boolean, number?)
	local session = sessions[player]
	local profile = session and session.Profile
	if
		not session
		or not profile
		or not isFinite(levelIndex)
		or levelIndex ~= math.floor(levelIndex)
		or not Config.Levels[levelIndex]
		or not isFinite(seconds)
		or seconds &lt;= 0
	then
		return false, false, nil
	end

	local time = math.max(0.1, math.floor(seconds * 10 + 0.5) / 10) -- tenths, like the leaderboards
	local previous = profile.BestTimes[levelIndex] or 0
	local firstClear = previous &lt;= 0
	local newBest = firstClear or time &lt; previous
	if newBest then
		profile.BestTimes[levelIndex] = time
	end

	local unlocked: number? = nil
	local nextLevel = levelIndex + 1
	if Config.Levels[nextLevel] and profile.Unlocked &lt; nextLevel then
		profile.Unlocked = nextLevel
		unlocked = nextLevel
	end
	profile.Stats.Runs += 1
	if levelIndex == #Config.Levels and not profile.RebirthReady then
		profile.RebirthReady = true
		-- A few seconds later, so it lands after the results screen.
		task.delay(6, queueNotice, session, "Every level is clean! Visit the Rebirth Fountain in the lobby to Rebirth.", "Good")
	end

	-- Unlocks and best times are the progress players care most about: write them soon.
	session.NextAutosave = math.min(session.NextAutosave, os.clock() + SAVE_SOON_DELAY)
	DataService.PushMeta(player)
	return firstClear, newBest, unlocked
end

function DataService.IsOffline(): boolean
	-- Resolves instantly except in a published place's Studio session, where the probe takes a moment.
	if not detection.Open then
		waitLatch(detection, PROBE_WAIT)
	end
	return offline
end

-- (Addition) Saves the player's profile right now and yields until done. True only if it was
-- written; always false offline and for temporary profiles. MarketService uses it for receipts.
function DataService.Save(player: Player): boolean
	local session = sessions[player]
	if not session or not session.Profile or not session.CanSave or session.Finalizing then
		return false
	end
	activeJobs += 1
	local ok, saved = pcall(saveSession, session, false, RECEIPT_SAVE_ATTEMPTS)
	activeJobs -= 1
	if not ok then
		warn("[DataService] " .. tostring(saved))
		return false
	end
	if saved then
		session.NextAutosave = os.clock() + AUTOSAVE_INTERVAL
	end
	return saved == true
end

-- (Addition) Server hops. Saves the player right now with a "handoff" lock, just before they are
-- teleported, so the server they arrive in can load them straight away (no waiting for this server
-- to notice they left). Yields until the save is done; false if it couldn't be written (the next
-- server then just waits for the normal release, as before).
function DataService.BeginHandoff(player: Player): boolean
	local session = sessions[player]
	if not session or not session.Profile or not session.CanSave or session.Finalizing then
		return false
	end
	session.Handoff = true
	activeJobs += 1
	local ok, saved = pcall(saveSession, session, false, 2)
	activeJobs -= 1
	return ok and saved == true
end

-- (Addition) The teleport failed and the player is staying: take the save back as a normal lock.
function DataService.CancelHandoff(player: Player)
	local session = sessions[player]
	if not session or not session.Handoff then
		return
	end
	session.Handoff = false
	if session.CanSave and not session.Finalizing then
		task.spawn(track, saveSession, session, false, 2)
	end
end

-- (Addition) True when this player's progress is being persisted: the profile loaded from the
-- DataStore and this server still owns its lock. False offline and for temporary profiles.
function DataService.CanSave(player: Player): boolean
	local session = sessions[player]
	return session ~= nil and session.Profile ~= nil and session.CanSave and not session.Finalizing
end

return DataService</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000017"><Properties><string name="Name">DishFactory</string><ProtectedString name="Source">-- DishFactory: builds one dish (plate/bowl/cup/glass/fork/knife/spoon/pan/pot) and covers a built
-- dish in dirt spots that sit on its real, raycast-checked surfaces.
--
-- Everything here works in the dish's own "anchor" frame: `cf` (a CFrame passed to BuildDish) whose
-- Position is the contact point where the dish touches the rack/basket, and whose axes we reuse as
-- a local coordinate system for the rest of the geometry:
--   local X = cf.RightVector   (sideways across the dish)
--   local Y = cf.UpVector      (straight up from the contact point, "up" for the dish itself)
--   local Z = cf.LookVector    (the direction a plate's face points; "forward" for everything else)
-- The anchor may be tilted (ArenaBuilder leans bowls and pans toward the aisle like a real rack);
-- every builder and dirt ray only uses the anchor's own axes, so tilted dishes just work.
-- BuildDish stores that CFrame on the model (attribute "Anchor") so ApplyGrime can rebuild the same
-- local geometry later.
--
-- Hollow shapes (bowl, pan, pot, mug) are cut once in Init with GeometryService and cloned per dish.
-- If GeometryService fails, each kind falls back to a primitive-part version.
--
-- The dirt: every spot is ONE queryable disc (the thing RoundService damages) plus a few child
-- decoration parts (splats, drips, crumbs, sprinkles) that make it read as food, not a sticker.

local ServerStorage = game:GetService("ServerStorage")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Util = require(Shared:WaitForChild("Util"))

local DishFactory = {}

----------------------------------------------------------------------------------------------------
-- Sizes, relative to a ~5 stud tall character. The dishwasher is sized so these look like a real
-- load: plates are four characters tall and stand close together in the rack.
----------------------------------------------------------------------------------------------------
local SIZE = {
	Plate = { Diameter = 20, Thickness = 1.2 },
	Tray = { Diameter = 23, Thickness = 0.8 },
	Bowl = { Diameter = 15, Depth = 7 },
	Cup = { Diameter = 8, Height = 10 },
	Glass = { Diameter = 7, Height = 12 },
	Fork = { Height = 18 },
	Knife = { Height = 18 },
	Spoon = { Height = 18 },
	Pan = { Diameter = 22, Depth = 4 },
	Pot = { Diameter = 18, Height = 14 },
	Board = { Diameter = 22, Thickness = 1.6, Handle = 6 },
	Cutter = { Height = 18, Wheel = 8 },
	Goblet = { Diameter = 11, Height = 22 },
}

local DIRT_SCALE = 1.6 -- Config.GrimeTypes sizes were tuned for the old, smaller dishes
local WALL = 0.8 -- wall thickness of hollow dishes

local SPRINKLE_COLORS = {
	Color3.fromRGB(255, 90, 90),
	Color3.fromRGB(90, 140, 255),
	Color3.fromRGB(90, 220, 120),
	Color3.fromRGB(255, 210, 60),
	Color3.fromRGB(255, 120, 200),
	Color3.fromRGB(255, 160, 60),
	Color3.fromRGB(170, 110, 255),
}

local STEEL = Color3.fromRGB(200, 205, 212)
local DARK_STEEL = Color3.fromRGB(70, 72, 78)
local HANDLE_BLACK = Color3.fromRGB(40, 40, 44)

----------------------------------------------------------------------------------------------------
-- Template state (built once in Init). Each template is a PartOperation plus the CFrame it sits at
-- relative to its build frame, so a clone can be placed without knowing how CSG chose its pivot.
----------------------------------------------------------------------------------------------------
type Template = { Part: BasePart, Rel: CFrame }

local templatesFolder: Folder? = nil
local templates: { [string]: Template } = {}
local BUILD_AT = CFrame.new(0, 4000, 0) -- far from everything while cutting

----------------------------------------------------------------------------------------------------
-- Small geometry helpers, all working in an anchor CFrame's local axes.
----------------------------------------------------------------------------------------------------

-- Local (x = Right, y = Up, z = Look) -&gt; world position.
local function localPos(anchor: CFrame, x: number, y: number, z: number): Vector3
	return anchor.Position + anchor.RightVector * x + anchor.UpVector * y + anchor.LookVector * z
end

-- Local (x, y, z) -&gt; world direction.
local function localDir(anchor: CFrame, x: number, y: number, z: number): Vector3
	return anchor.RightVector * x + anchor.UpVector * y + anchor.LookVector * z
end

-- A part whose local X axis is `axisWorld` (used for Shape = Cylinder, where X is the axis).
local function axisCFrame(pos: Vector3, axisWorld: Vector3, hintWorld: Vector3): CFrame
	local ok, cf = pcall(CFrame.fromMatrix, pos, axisWorld.Unit, hintWorld.Unit)
	if ok and cf == cf then
		return cf
	end
	return CFrame.fromMatrix(pos, axisWorld.Unit, Vector3.new(0, 1, 0))
end

-- The anchor rotated so a Cylinder's axis (X) points along the anchor's Up.
local function upright(anchor: CFrame, y: number): CFrame
	return CFrame.new(localPos(anchor, 0, y, 0)) * anchor.Rotation * CFrame.Angles(0, 0, math.rad(90))
end

local function setFlags(p: BasePart)
	p.Anchored = true
	p.CanCollide = true
	p.CanTouch = false
	p.CanQuery = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
end

local function newPart(shape: Enum.PartType?, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?): BasePart
	local p = Instance.new("Part")
	if shape then
		p.Shape = shape
	end
	p.Size = Vector3.new(math.max(size.X, 0.05), math.max(size.Y, 0.05), math.max(size.Z, 0.05))
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	setFlags(p)
	return p
end

-- Decoration that should never block aim, touch or movement.
local function decor(p: BasePart): BasePart
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	return p
end

-- A rounded capsule-ish bar: a Cylinder along `axisWorld`, used for handles and cutlery.
local function bar(from: Vector3, to: Vector3, thickness: number, hint: Vector3, color: Color3, material: Enum.Material?): BasePart
	local mid = (from + to) / 2
	local len = (to - from).Magnitude
	return newPart(Enum.PartType.Cylinder, Vector3.new(len, thickness, thickness), axisCFrame(mid, to - from, hint), color, material)
end

-- Places a clone of a CSG template so its build frame lands on `frame`. Nil if there's no template.
local function placeTemplate(name: string, frame: CFrame, color: Color3, material: Enum.Material?): BasePart?
	local t = templates[name]
	if not t then
		return nil
	end
	local ok, clone = pcall(function()
		return t.Part:Clone()
	end)
	if not ok or not clone then
		return nil
	end
	local part = clone :: BasePart
	part.CFrame = frame * t.Rel
	part.Color = color
	if material then
		part.Material = material
	end
	setFlags(part)
	-- UsePartColor so the per-level theme colour shows instead of the template's.
	pcall(function()
		(part :: any).UsePartColor = true
	end)
	return part
end

-- Mug/pot style loop handle on the anchor's +X side (sideways from the dish).
local function loopHandle(anchor: CFrame, radius: number, y0: number, y1: number, out: number, thick: number, color: Color3, material: Enum.Material?, side: number): { BasePart }
	local x0 = side * (radius - 0.2)
	local x1 = side * (radius + out)
	local up = anchor.UpVector
	return {
		bar(localPos(anchor, x1, y0, 0), localPos(anchor, x1, y1, 0), thick, anchor.LookVector, color, material),
		bar(localPos(anchor, x0, y0, 0), localPos(anchor, x1 + side * thick * 0.4, y0, 0), thick, up, color, material),
		bar(localPos(anchor, x0, y1, 0), localPos(anchor, x1 + side * thick * 0.4, y1, 0), thick, up, color, material),
	}
end

----------------------------------------------------------------------------------------------------
-- Per-kind builders. Each returns (parts: {BasePart}, primaryIndex: number).
----------------------------------------------------------------------------------------------------

-- Plate standing on its edge, face (the dirty side) toward anchor.LookVector. With CSG: a white body
-- with a recessed well, a coloured stripe ring on the rim and a foot ring on the back. Without CSG:
-- a coloured edge band behind a thicker white face. No two faces share a plane either way.
local function buildPlate(anchor: CFrame, theme, _rng: Random)
	local s = SIZE.Plate
	local frame = CFrame.new(anchor.Position) * anchor.Rotation
	local body = placeTemplate("PlateBody", frame, theme.Plate)
	if body then
		local parts = { body }
		local stripe = placeTemplate("PlateStripe", frame, theme.PlateRim)
		if stripe then
			table.insert(parts, stripe)
		end
		local foot = placeTemplate("PlateFoot", frame, theme.Plate)
		if foot then
			table.insert(parts, foot)
		end
		return parts, 1
	end
	local r = s.Diameter / 2
	local cf = axisCFrame(localPos(anchor, 0, r, 0), anchor.LookVector, anchor.UpVector)
	local t = s.Thickness
	return {
		newPart(Enum.PartType.Cylinder, Vector3.new(t, s.Diameter, s.Diameter), cf, theme.PlateRim), -- edge band
		newPart(Enum.PartType.Cylinder, Vector3.new(t + 0.3, s.Diameter * 0.88, s.Diameter * 0.88), cf, theme.Plate), -- face
	}, 2
end

-- Serving tray (pizza pan / banquet platter) standing on its edge like a plate, face toward
-- anchor.LookVector: a flat face inside a thick rolled rim (a CSG ring, or 18 short bars without
-- CSG). The rim is thicker than the face on both sides, so no faces share a plane.
local function buildTray(anchor: CFrame, theme, _rng: Random)
	local s = SIZE.Tray
	local r = s.Diameter / 2
	local color = theme.Tray or theme.Metal
	local rimColor = Color3.new(color.R * 0.85, color.G * 0.85, color.B * 0.85)
	local center = localPos(anchor, 0, r, 0)
	local cf = axisCFrame(center, anchor.LookVector, anchor.UpVector)
	local parts = {
		newPart(Enum.PartType.Cylinder, Vector3.new(s.Thickness, s.Diameter * 0.9, s.Diameter * 0.9), cf, color, Enum.Material.Metal),
	}
	local rim = placeTemplate("TrayRim", CFrame.new(anchor.Position) * anchor.Rotation, rimColor, Enum.Material.Metal)
	if rim then
		table.insert(parts, rim)
	else
		local n = 18
		local rr = r * 0.94
		for i = 0, n - 1 do
			local a0, a1 = i / n * math.pi * 2, (i + 1.08) / n * math.pi * 2
			local p0 = center + anchor.RightVector * (math.cos(a0) * rr) + anchor.UpVector * (math.sin(a0) * rr)
			local p1 = center + anchor.RightVector * (math.cos(a1) * rr) + anchor.UpVector * (math.sin(a1) * rr)
			table.insert(parts, bar(p0, p1, s.Thickness + 1, anchor.LookVector, rimColor, Enum.Material.Metal))
		end
	end
	return parts, 1
end

-- Bowl, opening along anchor Up. CSG shell when available, otherwise a ring of angled slats.
local function buildBowl(anchor: CFrame, theme, _rng: Random)
	local s = SIZE.Bowl
	local shell = placeTemplate("Bowl", CFrame.new(anchor.Position) * anchor.Rotation, theme.Bowl)
	local parts = {}
	if shell then
		table.insert(parts, shell)
	else
		local r = s.Diameter / 2
		table.insert(parts, newPart(Enum.PartType.Cylinder, Vector3.new(0.8, r * 1.1, r * 1.1), upright(anchor, 0.4), theme.Bowl))
		local slats = 20
		for i = 1, slats do
			local theta = (i - 1) / slats * math.pi * 2
			local nx, nz = math.cos(theta), math.sin(theta)
			local pos = localPos(anchor, nx * r * 0.78, s.Depth * 0.5, nz * r * 0.78)
			local out = localDir(anchor, nx, 0, nz)
			local cf = CFrame.lookAt(pos, pos + out, anchor.UpVector) * CFrame.Angles(math.rad(28), 0, 0)
			table.insert(parts, newPart(nil, Vector3.new(r * 0.3, s.Depth * 1.05, WALL), cf, theme.Bowl))
		end
	end
	-- Foot ring, and a coloured band hugging the outside of the rim.
	table.insert(parts, newPart(Enum.PartType.Cylinder, Vector3.new(0.6, s.Diameter * 0.45, s.Diameter * 0.45), upright(anchor, 0.3), theme.Bowl))
	local stripe = placeTemplate("BowlStripe", CFrame.new(anchor.Position) * anchor.Rotation, theme.PlateRim)
	if stripe then
		table.insert(parts, stripe)
	end
	return parts, 1
end

-- Mug upside down on the rack: open end at the contact point, base on top, handle on the side.
local function buildCup(anchor: CFrame, theme, _rng: Random)
	local s = SIZE.Cup
	local r = s.Diameter / 2
	local body = placeTemplate("Cup", CFrame.new(anchor.Position) * anchor.Rotation, theme.Cup)
		or newPart(Enum.PartType.Cylinder, Vector3.new(s.Height, s.Diameter, s.Diameter), upright(anchor, s.Height / 2), theme.Cup)
	local parts = { body }
	-- A white band near the (upturned) base for a little detail.
	table.insert(parts, decor(newPart(Enum.PartType.Cylinder, Vector3.new(0.5, s.Diameter + 0.08, s.Diameter + 0.08), upright(anchor, s.Height - 1.4), Color3.new(1, 1, 1))))
	for _, h in loopHandle(anchor, r, s.Height * 0.25, s.Height * 0.72, 2.2, 0.9, theme.Cup, nil, 1) do
		table.insert(parts, h)
	end
	return parts, 1
end

-- Tumbler upside down: see-through glass with a thick base on top.
local function buildGlass(anchor: CFrame, theme, _rng: Random)
	local s = SIZE.Glass
	local body = newPart(Enum.PartType.Cylinder, Vector3.new(s.Height, s.Diameter, s.Diameter), upright(anchor, s.Height / 2), theme.Glass, Enum.Material.Glass)
	body.Transparency = 0.35
	body.Reflectance = 0.15
	-- The thick base sits just inside the top (its faces never share a plane with the body's).
	local base = newPart(Enum.PartType.Cylinder, Vector3.new(1.2, s.Diameter * 0.96, s.Diameter * 0.96), upright(anchor, s.Height - 0.68), theme.Glass, Enum.Material.Glass)
	base.Transparency = 0.2
	local lip = decor(newPart(Enum.PartType.Cylinder, Vector3.new(0.3, s.Diameter + 0.1, s.Diameter + 0.1), upright(anchor, 0.2), Color3.new(1, 1, 1), Enum.Material.Glass))
	lip.Transparency = 0.4
	return { body, base, lip }, 1
end

-- Frying pan, cooking surface along anchor Up, long handle along +X.
local function buildPan(anchor: CFrame, theme, _rng: Random)
	local s = SIZE.Pan
	local r = s.Diameter / 2
	local body = placeTemplate("Pan", CFrame.new(anchor.Position) * anchor.Rotation, DARK_STEEL, Enum.Material.Metal)
	local parts = {}
	if body then
		table.insert(parts, body)
	else
		table.insert(parts, newPart(Enum.PartType.Cylinder, Vector3.new(s.Depth, s.Diameter, s.Diameter), upright(anchor, s.Depth / 2), DARK_STEEL, Enum.Material.Metal))
	end
	-- Outside of the pan in the theme metal colour, cooking surface darker.
	table.insert(parts, decor(newPart(Enum.PartType.Cylinder, Vector3.new(0.3, s.Diameter + 0.2, s.Diameter + 0.2), upright(anchor, 0.15), theme.Metal, Enum.Material.Metal)))
	local h0 = localPos(anchor, r - 0.5, s.Depth * 0.8, 0)
	local h1 = localPos(anchor, r + 12, s.Depth * 1.6, 0)
	table.insert(parts, bar(h0, h1, 1.3, anchor.UpVector, HANDLE_BLACK))
	return parts, 1
end

-- Stock pot, open top along anchor Up, two loop handles.
local function buildPot(anchor: CFrame, theme, _rng: Random)
	local s = SIZE.Pot
	local r = s.Diameter / 2
	local body = placeTemplate("Pot", CFrame.new(anchor.Position) * anchor.Rotation, theme.Metal, Enum.Material.Metal)
		or newPart(Enum.PartType.Cylinder, Vector3.new(s.Height, s.Diameter, s.Diameter), upright(anchor, s.Height / 2), theme.Metal, Enum.Material.Metal)
	local parts = { body }
	-- Rolled rim: a ring hugging the outside of the top edge (a CSG ring, or short bars without CSG).
	-- It never covers the opening, so the pot stays open and nothing overlaps its walls' top faces.
	local rim = placeTemplate("PotRim", CFrame.new(anchor.Position) * anchor.Rotation, STEEL, Enum.Material.Metal)
	if rim then
		table.insert(parts, decor(rim))
	else
		local rr = s.Diameter / 2 + 0.1
		local n = 20
		for i = 0, n - 1 do
			local a0, a1 = i / n * math.pi * 2, (i + 1.1) / n * math.pi * 2
			local p0 = localPos(anchor, math.cos(a0) * rr, s.Height - 0.45, math.sin(a0) * rr)
			local p1 = localPos(anchor, math.cos(a1) * rr, s.Height - 0.45, math.sin(a1) * rr)
			table.insert(parts, decor(bar(p0, p1, 0.55, anchor.UpVector, STEEL, Enum.Material.Metal)))
		end
	end
	for _, side in { 1, -1 } do
		for _, h in loopHandle(anchor, r, s.Height * 0.72, s.Height * 0.9, 1.8, 0.8, STEEL, Enum.Material.Metal, side) do
			table.insert(parts, h)
		end
	end
	return parts, 1
end

-- Cutlery stands handle-down in the basket. The flat side faces the anchor's Look.
local function cutleryHandle(anchor: CFrame, height: number, color: Color3, material: Enum.Material?): BasePart
	local handle = newPart(nil, Vector3.new(1.6, height, 0.7), CFrame.new(localPos(anchor, 0, height / 2, 0)) * anchor.Rotation, color, material)
	return handle
end

local function buildFork(anchor: CFrame, theme, _rng: Random)
	local total = SIZE.Fork.Height
	local handleH = total * 0.55
	local neckH = total * 0.12
	local tineH = total - handleH - neckH
	local rot = anchor.Rotation
	local parts = {
		cutleryHandle(anchor, handleH, theme.Metal, Enum.Material.Metal),
		newPart(nil, Vector3.new(2.2, neckH, 0.45), CFrame.new(localPos(anchor, 0, handleH + neckH / 2, 0)) * rot, theme.Metal, Enum.Material.Metal),
		newPart(nil, Vector3.new(3.6, 1.2, 0.45), CFrame.new(localPos(anchor, 0, handleH + neckH + 0.6, 0)) * rot, theme.Metal, Enum.Material.Metal),
	}
	for i = 1, 4 do
		local x = (i - 2.5) * 0.95
		table.insert(parts, newPart(nil, Vector3.new(0.45, tineH, 0.4), CFrame.new(localPos(anchor, x, handleH + neckH + tineH / 2, 0)) * rot, theme.Metal, Enum.Material.Metal))
	end
	return parts, 1
end

local function buildKnife(anchor: CFrame, theme, _rng: Random)
	local total = SIZE.Knife.Height
	local handleH = total * 0.42
	local bladeH = total - handleH
	local rot = anchor.Rotation
	local handle = newPart(nil, Vector3.new(1.4, handleH, 0.9), CFrame.new(localPos(anchor, 0, handleH / 2, 0)) * rot, HANDLE_BLACK)
	local bolster = newPart(nil, Vector3.new(1.6, 0.6, 1.0), CFrame.new(localPos(anchor, 0, handleH + 0.3, 0)) * rot, theme.Metal, Enum.Material.Metal)
	local blade = newPart(nil, Vector3.new(2.2, bladeH - 2.2, 0.3), CFrame.new(localPos(anchor, 0.3, handleH + 0.6 + (bladeH - 2.2) / 2, 0)) * rot, theme.Metal, Enum.Material.Metal)
	-- Tip: a wedge sloping from the spine down to the edge.
	local tip = Instance.new("WedgePart")
	tip.Size = Vector3.new(0.3, 2.2, 2.2)
	tip.CFrame = CFrame.new(localPos(anchor, 0.3, handleH + 0.6 + bladeH - 2.2 + 1.1, 0)) * rot * CFrame.Angles(0, math.rad(90), 0)
	tip.Color = theme.Metal
	tip.Material = Enum.Material.Metal
	setFlags(tip)
	return { handle, bolster, blade, tip }, 1
end

local function buildSpoon(anchor: CFrame, theme, _rng: Random)
	local total = SIZE.Spoon.Height
	local handleH = total * 0.66
	local parts = { cutleryHandle(anchor, handleH, theme.Metal, Enum.Material.Metal) }
	local bowl = newPart(nil, Vector3.new(4, 5.6, 1.4), CFrame.new(localPos(anchor, 0, handleH + 2.8, 0)) * anchor.Rotation, theme.Metal, Enum.Material.Metal)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = bowl
	table.insert(parts, bowl)
	return parts, 1
end

-- Wooden pizza board standing on its edge like a plate: a round board with a darker rim band and a
-- little handle tab at the top. Spots go on the face (the flat side toward anchor.LookVector).
local function buildBoard(anchor: CFrame, theme, _rng: Random)
	local s = SIZE.Board
	local r = s.Diameter / 2
	local wood = Color3.fromRGB(196, 146, 92)
	local woodDark = Color3.fromRGB(150, 104, 62)
	local center = localPos(anchor, 0, r, 0)
	local cf = axisCFrame(center, anchor.LookVector, anchor.UpVector)
	local rot = anchor.Rotation
	local parts = {
		newPart(Enum.PartType.Cylinder, Vector3.new(s.Thickness, s.Diameter, s.Diameter), cf, woodDark, Enum.Material.Wood),
		newPart(Enum.PartType.Cylinder, Vector3.new(s.Thickness + 0.3, s.Diameter * 0.9, s.Diameter * 0.9), cf, wood, Enum.Material.Wood),
	}
	-- Handle tab: sits on the rim, same thickness as the band.
	local tab = newPart(nil, Vector3.new(4.2, s.Handle, s.Thickness), CFrame.new(localPos(anchor, 0, s.Diameter + s.Handle / 2 - 0.8, 0)) * rot, woodDark, Enum.Material.Wood)
	table.insert(parts, tab)
	local hole = newPart(Enum.PartType.Cylinder, Vector3.new(s.Thickness + 0.2, 1.8, 1.8), axisCFrame(localPos(anchor, 0, s.Diameter + s.Handle / 2 - 0.2, 0), anchor.LookVector, anchor.UpVector), Color3.fromRGB(40, 30, 24), Enum.Material.Wood)
	table.insert(parts, decor(hole))
	return parts, 1
end

-- Pizza cutter standing handle-down in the basket: a wooden grip, a forked neck and a round blade.
local function buildCutter(anchor: CFrame, theme, _rng: Random)
	local s = SIZE.Cutter
	local rot = anchor.Rotation
	local gripH = s.Height * 0.5
	local wheelY = gripH + 3.5
	local grip = newPart(nil, Vector3.new(1.8, gripH, 1.3), CFrame.new(localPos(anchor, 0, gripH / 2, 0)) * rot, Color3.fromRGB(150, 104, 62), Enum.Material.Wood)
	local neck = newPart(nil, Vector3.new(0.8, 3.6, 1.2), CFrame.new(localPos(anchor, 0, gripH + 1.8, 0)) * rot, theme.Metal, Enum.Material.Metal)
	local parts = { grip, neck }
	for _, side in { -1, 1 } do
		table.insert(parts, newPart(nil, Vector3.new(0.4, 0.4, 1.6), CFrame.new(localPos(anchor, 0, wheelY, side * 0.8)) * rot, theme.Metal, Enum.Material.Metal))
	end
	local wheelCF = axisCFrame(localPos(anchor, 0, wheelY + 1.5, 0), anchor.LookVector, anchor.UpVector)
	table.insert(parts, newPart(Enum.PartType.Cylinder, Vector3.new(0.35, s.Wheel, s.Wheel), wheelCF, Color3.fromRGB(215, 220, 226), Enum.Material.Metal))
	table.insert(parts, newPart(Enum.PartType.Cylinder, Vector3.new(0.7, 1.6, 1.6), wheelCF, theme.Metal, Enum.Material.Metal))
	return parts, 1
end

-- Royal goblet standing on its foot: a round foot, a thin stem with a knob and a wide cup. Spots go on
-- the cup. (Gold in the theme's Metal colour.)
local function buildGoblet(anchor: CFrame, theme, _rng: Random)
	local s = SIZE.Goblet
	local gold = theme.Metal
	local function at(y: number): CFrame
		return axisCFrame(localPos(anchor, 0, y, 0), anchor.UpVector, anchor.LookVector)
	end
	local cupH = s.Height * 0.55
	local parts = {
		newPart(Enum.PartType.Cylinder, Vector3.new(1, s.Diameter * 0.78, s.Diameter * 0.78), at(0.5), gold, Enum.Material.Metal),
		newPart(Enum.PartType.Cylinder, Vector3.new(s.Height * 0.4, 1.6, 1.6), at(1 + s.Height * 0.2), gold, Enum.Material.Metal),
		newPart(Enum.PartType.Cylinder, Vector3.new(2, 3.4, 3.4), at(1 + s.Height * 0.2), gold, Enum.Material.Metal),
		newPart(Enum.PartType.Cylinder, Vector3.new(cupH, s.Diameter, s.Diameter), at(s.Height - cupH / 2), gold, Enum.Material.Metal),
		-- a darker lip, a little higher and wider than the cup so no faces share a plane
		newPart(Enum.PartType.Cylinder, Vector3.new(1.2, s.Diameter + 0.8, s.Diameter + 0.8), at(s.Height - 0.4), Color3.new(gold.R * 0.8, gold.G * 0.8, gold.B * 0.8), Enum.Material.Metal),
	}
	return parts, 4
end

local BUILDERS: { [string]: (CFrame, any, Random) -&gt; ({ BasePart }, number) } = {
	Plate = buildPlate,
	Tray = buildTray,
	Bowl = buildBowl,
	Cup = buildCup,
	Glass = buildGlass,
	Fork = buildFork,
	Knife = buildKnife,
	Spoon = buildSpoon,
	Pan = buildPan,
	Pot = buildPot,
	Board = buildBoard,
	Cutter = buildCutter,
	Goblet = buildGoblet,
}

----------------------------------------------------------------------------------------------------
-- Init: cut the hollow templates. Any failure just leaves that kind on its primitive fallback.
----------------------------------------------------------------------------------------------------

local function tempPart(shape: Enum.PartType?, size: Vector3, cf: CFrame): Part
	local p = Instance.new("Part")
	if shape then
		p.Shape = shape
	end
	p.Size = size
	p.CFrame = cf
	p.Anchored = true
	p.Parent = ServerStorage
	return p
end

-- Upright cylinder (axis = world Y) centred at build-frame height y.
local function uprightAt(y: number): CFrame
	return BUILD_AT * CFrame.new(0, y, 0) * CFrame.Angles(0, 0, math.rad(90))
end

local function cut(name: string, outer: Part, cutters: { Part })
	local GeometryService = game:GetService("GeometryService")
	local ok, result = pcall(function()
		return GeometryService:SubtractAsync(outer, cutters, { SplitApart = false })
	end)
	for _, p in cutters do
		p:Destroy()
	end
	outer:Destroy()
	if ok and type(result) == "table" and result[1] then
		local part = result[1] :: BasePart
		part.Name = name .. "Template"
		part.Anchored = true
		part.Parent = templatesFolder
		templates[name] = { Part = part, Rel = BUILD_AT:ToObjectSpace(part.CFrame) }
	else
		warn(string.format("[DishFactory] Couldn't cut the %s template, using the simple version: %s", name, tostring(result)))
	end
end

-- Cylinder whose axis runs along the build frame's Z (the plate's facing), centred at (0, y, z).
local function alongZAt(y: number, z: number): CFrame
	return BUILD_AT * CFrame.new(0, y, z) * CFrame.Angles(0, math.rad(90), 0)
end

-- A flat ring (annulus) cut from two cylinders.
local function ring(name: string, outerD: number, innerD: number, thickness: number, cf: CFrame)
	local outer = tempPart(Enum.PartType.Cylinder, Vector3.new(thickness, outerD, outerD), cf)
	local inner = tempPart(Enum.PartType.Cylinder, Vector3.new(thickness + 1, innerD, innerD), cf)
	cut(name, outer, { inner })
end

local function buildTemplates()
	-- Plate, standing on its edge at y = 0, face toward the build frame's -Z (its LookVector side).
	do
		local s = SIZE.Plate
		local d, t = s.Diameter, s.Thickness
		local r = d / 2
		local front = -t / 2 -- local Z of the front face
		local body = tempPart(Enum.PartType.Cylinder, Vector3.new(t, d, d), alongZAt(r, 0))
		-- A well 0.35 deep with a small bevel step around it.
		local well = tempPart(Enum.PartType.Cylinder, Vector3.new(1.4, d * 0.64, d * 0.64), alongZAt(r, front - 0.7 + 0.35))
		local bevel = tempPart(Enum.PartType.Cylinder, Vector3.new(1.4, d * 0.72, d * 0.72), alongZAt(r, front - 0.7 + 0.15))
		cut("PlateBody", body, { well, bevel })
		ring("PlateStripe", d * 0.93, d * 0.86, 0.1, alongZAt(r, front - 0.05))
		ring("PlateFoot", d * 0.6, d * 0.53, 0.3, alongZAt(r, t / 2 + 0.15))
	end
	-- Tray rim: a thick ring around the flat face.
	do
		local s = SIZE.Tray
		ring("TrayRim", s.Diameter, s.Diameter * 0.88, s.Thickness + 1, alongZAt(s.Diameter / 2, 0))
	end
	-- Pot rim: a band around the outside of the top edge, below the top face.
	do
		local s = SIZE.Pot
		ring("PotRim", s.Diameter + 0.5, s.Diameter - 0.02, 0.55, BUILD_AT * CFrame.new(0, s.Height - 0.45, 0) * CFrame.Angles(0, 0, math.rad(90)))
	end
	-- Bowl rim band.
	do
		local s = SIZE.Bowl
		ring("BowlStripe", s.Diameter + 0.4, s.Diameter - 0.8, 0.4, BUILD_AT * CFrame.new(0, s.Depth - 0.1, 0) * CFrame.Angles(0, 0, math.rad(90)))
	end
	-- Bowl: a ball, hollowed, with everything above the rim cut off. Contact point at y = 0.
	do
		local s = SIZE.Bowl
		local d = s.Diameter
		local outerH = s.Depth * 2
		local outer = tempPart(Enum.PartType.Ball, Vector3.new(d, d, d), BUILD_AT * CFrame.new(0, d / 2, 0))
		outer.Size = Vector3.new(d, d, d)
		local hollow = tempPart(Enum.PartType.Ball, Vector3.new(d - WALL * 2, d - WALL * 2, d - WALL * 2), BUILD_AT * CFrame.new(0, d / 2 + 0.2, 0))
		local lid = tempPart(nil, Vector3.new(d + 4, outerH, d + 4), BUILD_AT * CFrame.new(0, s.Depth + outerH / 2, 0))
		cut("Bowl", outer, { hollow, lid })
	end
	-- Mug (upside down): open at the bottom (y = 0), closed at the top.
	do
		local s = SIZE.Cup
		local outer = tempPart(Enum.PartType.Cylinder, Vector3.new(s.Height, s.Diameter, s.Diameter), uprightAt(s.Height / 2))
		local inner = tempPart(Enum.PartType.Cylinder, Vector3.new(s.Height, s.Diameter - WALL * 2, s.Diameter - WALL * 2), uprightAt(s.Height / 2 - WALL))
		cut("Cup", outer, { inner })
	end
	-- Pan: shallow dish, open on top.
	do
		local s = SIZE.Pan
		local outer = tempPart(Enum.PartType.Cylinder, Vector3.new(s.Depth, s.Diameter, s.Diameter), uprightAt(s.Depth / 2))
		local inner = tempPart(Enum.PartType.Cylinder, Vector3.new(s.Depth, s.Diameter - WALL * 2, s.Diameter - WALL * 2), uprightAt(s.Depth / 2 + WALL))
		cut("Pan", outer, { inner })
	end
	-- Pot: deep, open on top.
	do
		local s = SIZE.Pot
		local outer = tempPart(Enum.PartType.Cylinder, Vector3.new(s.Height, s.Diameter, s.Diameter), uprightAt(s.Height / 2))
		local inner = tempPart(Enum.PartType.Cylinder, Vector3.new(s.Height, s.Diameter - WALL * 2, s.Diameter - WALL * 2), uprightAt(s.Height / 2 + WALL))
		cut("Pot", outer, { inner })
	end
end

function DishFactory.Init()
	local folder = ServerStorage:FindFirstChild("DishTemplates")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "DishTemplates"
		folder.Parent = ServerStorage
	end
	templatesFolder = folder :: Folder
	local ok, err = pcall(buildTemplates)
	if not ok then
		warn("[DishFactory] Template build failed, using simple dishes: " .. tostring(err))
	end
end

-- Footprint size of a kind, for ArenaBuilder's layout: (width across, height, depth).
function DishFactory.Size(kind: string): { [string]: number }
	return SIZE[kind] or {}
end

----------------------------------------------------------------------------------------------------
-- BuildDish
----------------------------------------------------------------------------------------------------
function DishFactory.BuildDish(kind: string, cf: CFrame, theme, rng: Random): Model
	local builder = BUILDERS[kind]
	local model = Instance.new("Model")
	model.Name = kind

	if not builder then
		warn("[DishFactory] Unknown dish kind " .. tostring(kind))
		local stub = newPart(nil, Vector3.new(1, 1, 1), cf, Color3.new(1, 0, 1))
		stub.Parent = model
		model.PrimaryPart = stub
		model:SetAttribute("Anchor", cf)
		model:SetAttribute("Kind", kind)
		return model
	end

	local parts, primaryIndex = builder(cf, theme, rng)
	for _, part in parts do
		part.Parent = model
	end
	model.PrimaryPart = parts[primaryIndex] or parts[1]
	model:SetAttribute("Anchor", cf)
	model:SetAttribute("Kind", kind)
	return model
end

----------------------------------------------------------------------------------------------------
-- Dirt placement: per-kind candidate rays, in the dish's local (Right, Up, Look) axes.
-- Returns (localOrigin, localDirection); both get converted to world space before raycasting.
----------------------------------------------------------------------------------------------------
local function candidatePlate(rng: Random)
	local s = SIZE.Plate
	local side = 1 -- only the front (the side you can see) gets dirty
	local r = math.sqrt(rng:NextNumber()) * s.Diameter * 0.36
	local theta = rng:NextNumber() * math.pi * 2
	local x, y = r * math.cos(theta), s.Diameter / 2 + r * math.sin(theta)
	return Vector3.new(x, y, side * 4), Vector3.new(0, 0, -side)
end

-- Inside of an open-topped round dish (bowl, pan, pot): aim from above the opening at the inner wall
-- or floor.
local function candidateInside(diameter: number, depth: number, rng: Random)
	local theta = rng:NextNumber() * math.pi * 2
	local frac = rng:NextNumber() ^ 0.7
	local r = (diameter / 2 - WALL - 0.4) * frac
	local x, z = r * math.cos(theta), r * math.sin(theta)
	local origin = Vector3.new(-x * 0.3, depth + 6, -z * 0.3)
	local target = Vector3.new(x, WALL, z)
	return origin, (target - origin)
end

local function candidateCylinderSide(diameter: number, height: number, rng: Random)
	local theta = rng:NextNumber() * math.pi * 2
	local y = (0.12 + rng:NextNumber() * 0.8) * height
	local radius = diameter / 2
	local nx, nz = math.cos(theta), math.sin(theta)
	return Vector3.new(nx * (radius + 4), y, nz * (radius + 4)), Vector3.new(-nx, 0, -nz)
end

local function candidateCylinderTop(diameter: number, height: number, rng: Random)
	local r = math.sqrt(rng:NextNumber()) * (diameter / 2 - 0.4)
	local theta = rng:NextNumber() * math.pi * 2
	return Vector3.new(r * math.cos(theta), height + 4, r * math.sin(theta)), Vector3.new(0, -1, 0)
end

local function candidateUpsideDown(diameter: number, height: number, rng: Random)
	if rng:NextNumber() &lt; 0.8 then
		return candidateCylinderSide(diameter, height, rng)
	end
	return candidateCylinderTop(diameter, height, rng)
end

local function candidatePot(rng: Random)
	local s = SIZE.Pot
	if rng:NextNumber() &lt; 0.6 then
		return candidateCylinderSide(s.Diameter, s.Height, rng)
	end
	return candidateInside(s.Diameter, s.Height, rng)
end

-- Cutlery: the head (tines, blade, spoon bowl) on either flat side.
local function candidateCutlery(height: number, lowFrac: number, rng: Random)
	local side = if rng:NextNumber() &lt; 0.5 then 1 else -1
	local y = height * (lowFrac + rng:NextNumber() * (0.95 - lowFrac))
	local x = (rng:NextNumber() - 0.5) * 2.4
	return Vector3.new(x, y, side * 4), Vector3.new(0, 0, -side)
end

local function candidateTray(rng: Random)
	local s = SIZE.Tray
	local r = math.sqrt(rng:NextNumber()) * s.Diameter * 0.36
	local theta = rng:NextNumber() * math.pi * 2
	local x, y = r * math.cos(theta), s.Diameter / 2 + r * math.sin(theta)
	return Vector3.new(x, y, 4), Vector3.new(0, 0, -1)
end

local function candidateBoard(rng: Random)
	local s = SIZE.Board
	local r = math.sqrt(rng:NextNumber()) * s.Diameter * 0.36
	local theta = rng:NextNumber() * math.pi * 2
	local x, y = r * math.cos(theta), s.Diameter / 2 + r * math.sin(theta)
	return Vector3.new(x, y, 4), Vector3.new(0, 0, -1)
end

local CANDIDATES: { [string]: (Random) -&gt; (Vector3, Vector3) } = {
	Plate = candidatePlate,
	Board = candidateBoard,
	Goblet = function(rng)
		-- the cup (the upper 55% of it), from either side
		local side = if rng:NextNumber() &lt; 0.5 then 1 else -1
		local cupH = SIZE.Goblet.Height * 0.55
		local y = SIZE.Goblet.Height - cupH / 2 + (rng:NextNumber() - 0.5) * cupH * 0.5
		return Vector3.new((rng:NextNumber() - 0.5) * 3, y, side * 6), Vector3.new(0, 0, -side)
	end,
	Cutter = function(rng)
		-- the blade and the neck, from either side
		local side = if rng:NextNumber() &lt; 0.5 then 1 else -1
		local y = SIZE.Cutter.Height * (0.5 + rng:NextNumber() * 0.42)
		return Vector3.new((rng:NextNumber() - 0.5) * 2, y, side * 4), Vector3.new(0, 0, -side)
	end,
	Tray = candidateTray,
	Bowl = function(rng)
		return candidateInside(SIZE.Bowl.Diameter, SIZE.Bowl.Depth, rng)
	end,
	Cup = function(rng)
		return candidateUpsideDown(SIZE.Cup.Diameter, SIZE.Cup.Height, rng)
	end,
	Glass = function(rng)
		return candidateUpsideDown(SIZE.Glass.Diameter, SIZE.Glass.Height, rng)
	end,
	Pan = function(rng)
		return candidateInside(SIZE.Pan.Diameter, SIZE.Pan.Depth, rng)
	end,
	Pot = candidatePot,
	Fork = function(rng)
		return candidateCutlery(SIZE.Fork.Height, 0.5, rng)
	end,
	Knife = function(rng)
		return candidateCutlery(SIZE.Knife.Height, 0.45, rng)
	end,
	Spoon = function(rng)
		return candidateCutlery(SIZE.Spoon.Height, 0.68, rng)
	end,
}

----------------------------------------------------------------------------------------------------
-- Dirt shapes. `cf` has local X = outward surface normal and sits just proud of the surface; local
-- Y/Z span the surface. Each returns (main disc, decoration children).
----------------------------------------------------------------------------------------------------

local function disc(cf: CFrame, diameter: number, thickness: number, color: Color3, material: Enum.Material): BasePart
	local p = newPart(Enum.PartType.Cylinder, Vector3.new(thickness, diameter, diameter), cf, color, material)
	p.CanCollide = false
	p.CastShadow = false
	return p
end

-- Child splats are thinner than the main disc and centred slightly lower, so their top faces sit
-- 0.03 above the lift, under the main disc's (no two faces share a plane, so nothing flickers).
local function childDisc(cf: CFrame, dy: number, dz: number, diameter: number, thickness: number, color: Color3, material: Enum.Material): BasePart
	return decor(disc(cf * CFrame.new(-0.03, dy, dz), diameter, math.min(thickness, 0.12), color, material))
end

local function darker(c: Color3, f: number): Color3
	return Color3.new(c.R * f, c.G * f, c.B * f)
end

-- Sauce splat: a round blob with smaller splats and droplets around its edge.
local function shapeBlob(cf: CFrame, size: number, color: Color3, material: Enum.Material, rng: Random)
	local main = disc(cf, size, 0.24, color, material)
	main.Reflectance = 0.08
	local kids = {}
	for _ = 1, rng:NextInteger(3, 5) do
		local a = rng:NextNumber() * math.pi * 2
		local d = size * rng:NextNumber(0.3, 0.45)
		table.insert(kids, childDisc(cf, math.cos(a) * d, math.sin(a) * d, size * rng:NextNumber(0.35, 0.6), 0.18, color, material))
	end
	for _ = 1, rng:NextInteger(2, 4) do
		local a = rng:NextNumber() * math.pi * 2
		local d = size * rng:NextNumber(0.65, 0.9)
		table.insert(kids, childDisc(cf, math.cos(a) * d, math.sin(a) * d, size * rng:NextNumber(0.1, 0.18), 0.16, color, material))
	end
	-- A slightly darker centre makes it read as a thick dollop.
	table.insert(kids, decor(disc(cf * CFrame.new(0.06, 0, 0), size * 0.45, 0.24, darker(color, 0.85), material)))
	return main, kids
end

-- Smear: a chain of overlapping blobs that thin out in one direction.
local function shapeStreak(cf: CFrame, size: number, color: Color3, material: Enum.Material, rng: Random)
	local main = disc(cf, size * 0.8, 0.18, color, material)
	local kids = {}
	local a = rng:NextNumber() * math.pi * 2
	local dy, dz = math.cos(a), math.sin(a)
	local n = rng:NextInteger(3, 5)
	for i = 1, n do
		local t = i / n
		local along = size * 0.45 * i
		local wobble = (rng:NextNumber() - 0.5) * size * 0.15
		table.insert(kids, childDisc(cf, dy * along - dz * wobble, dz * along + dy * wobble, size * (0.75 - 0.4 * t), 0.16, color, material))
	end
	return main, kids
end

-- Crumbs: a faint greasy patch covered in little chunky bits.
local function shapeCrumbs(cf: CFrame, size: number, color: Color3, material: Enum.Material, rng: Random)
	local main = disc(cf, size * 0.9, 0.12, darker(color, 0.9), material)
	main.Transparency = 0.25
	local kids = {}
	for _ = 1, rng:NextInteger(5, 8) do
		local a = rng:NextNumber() * math.pi * 2
		local d = size * 0.4 * math.sqrt(rng:NextNumber())
		local s = size * rng:NextNumber(0.12, 0.24)
		local bit = decor(newPart(nil, Vector3.new(s * 0.7, s, s * rng:NextNumber(0.7, 1.2)), cf * CFrame.new(s * 0.3, math.cos(a) * d, math.sin(a) * d) * CFrame.Angles(rng:NextNumber() * 6, rng:NextNumber() * 6, rng:NextNumber() * 6), color, material))
		table.insert(kids, bit)
	end
	return main, kids
end

-- Frosting with sprinkles on top.
local function shapeSprinkles(cf: CFrame, size: number, color: Color3, material: Enum.Material, rng: Random)
	local main, kids = shapeBlob(cf, size, Color3.fromRGB(255, 235, 245), material, rng)
	for _ = 1, rng:NextInteger(7, 11) do
		local a = rng:NextNumber() * math.pi * 2
		local d = size * 0.4 * math.sqrt(rng:NextNumber())
		local stick = decor(newPart(nil, Vector3.new(0.15, size * 0.22, 0.15), cf * CFrame.new(0.2, math.cos(a) * d, math.sin(a) * d) * CFrame.Angles(rng:NextNumber() * math.pi, 0, 0), SPRINKLE_COLORS[rng:NextInteger(1, #SPRINKLE_COLORS)], Enum.Material.SmoothPlastic))
		table.insert(kids, stick)
	end
	return main, kids
end

----------------------------------------------------------------------------------------------------
-- ApplyGrime (dirt)
----------------------------------------------------------------------------------------------------
local GOLDEN_COLOR = Color3.fromRGB(255, 213, 80)
local RAY_ATTEMPTS = 14
local MIN_SPACING = 1.2 -- spots on the same dish don't pile on top of each other
-- Every outward face of a splat sits a multiple of 0.03 above its spot's lift (child tops 0.03,
-- crumb patch 0.06, streak 0.09, blob 0.12, dollop 0.18). An overlapping spot on a parallel surface
-- gets a lift whose face planes land between the other spot's (as close to 0.015 off as possible,
-- measured from its real plane, so curved dishes count), so splats never flicker through each other.
type Spot = { Pos: Vector3, Normal: Vector3, Radius: number, Lift: number }

local function pickLift(pos: Vector3, normal: Vector3, radius: number, placed: { Spot }): number
	local offsets = {}
	for _, other in placed do
		if (other.Pos - pos).Magnitude &lt; other.Radius + radius and other.Normal:Dot(normal) &gt; 0.95 then
			table.insert(offsets, (other.Pos - pos):Dot(normal) + other.Lift)
		end
	end
	local best, bestGap = 0.1, -1
	for step = 0, 29 do
		local lift = 0.1 + step * 0.001
		local gap = math.huge
		for _, o in offsets do
			local r = (lift - o) % 0.03
			gap = math.min(gap, r, 0.03 - r)
		end
		if gap &gt; bestGap + 1e-6 then
			best, bestGap = lift, gap
		end
	end
	return best
end
local FIT_TOLERANCE = 0.35 -- how far the dish surface may drift from a spot's plane at its edge

-- The dish surface under `pos` along `normal` (a short ray back down onto the dish), or nil.
local function surfaceAt(params: RaycastParams, pos: Vector3, normal: Vector3): RaycastResult?
	return workspace:Raycast(pos + normal * 1.2, -normal * 2.6, params)
end

-- Does a flat spot of `radius` at `center` sit on the dish all the way round? (No overhang off an
-- edge, and not floating over a curve.)
local function fits(params: RaycastParams, center: Vector3, normal: Vector3, radius: number): boolean
	local cf = axisCFrame(center, normal, if math.abs(normal.Y) &gt; 0.9 then Vector3.new(1, 0, 0) else Vector3.new(0, 1, 0))
	for i = 1, 8 do
		local a = i / 8 * math.pi * 2
		local p = (cf * CFrame.new(0, math.cos(a) * radius, math.sin(a) * radius)).Position
		local hit = surfaceAt(params, p, normal)
		if not hit or math.abs((hit.Position - p):Dot(normal)) &gt; FIT_TOLERANCE then
			return false
		end
	end
	return true
end

-- Glues a decoration part onto the dish surface under it, keeping its height above the surface.
-- Returns false (and the caller drops it) when there's no dish underneath: that's what used to leave
-- splats hanging off plate edges and cutlery.
local function snapToSurface(params: RaycastParams, child: BasePart, basePos: Vector3, baseNormal: Vector3): boolean
	local c = child.CFrame
	local lift = (c.Position - basePos):Dot(baseNormal)
	local hit = surfaceAt(params, c.Position - baseNormal * lift, baseNormal)
	if not hit then
		return false
	end
	local ok, rot = pcall(CFrame.fromRotationBetweenVectors, baseNormal, hit.Normal)
	local turn = if ok and rot then rot else CFrame.identity
	child.CFrame = CFrame.new(hit.Position + hit.Normal * lift) * turn * c.Rotation
	return true
end

function DishFactory.ApplyGrime(dish: Model, dishId: number, count: number, levelIndex: number, rng: Random, goldenChance: number, folder: Folder, hpScale: number?): { BasePart }
	local partyHp = math.max(1, hpScale or 1) -- bigger parties: tougher dirt worth more units
	local kind = dish:GetAttribute("Kind")
	local anchor = dish:GetAttribute("Anchor")
	if typeof(anchor) ~= "CFrame" or typeof(kind) ~= "string" then
		warn("[DishFactory] ApplyGrime: dish is missing its Anchor/Kind attributes")
		return {}
	end
	local candidateFn = CANDIDATES[kind]
	if not candidateFn then
		return {}
	end

	local level = Config.GetLevel(levelIndex)
	local levelMult = level.Mult

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { dish }

	local placed: { BasePart } = {}
	local used: { Vector3 } = {}
	local spots: { Spot } = {}
	count = math.max(1, count)

	for _ = 1, count do
		local entry = Util.WeightedPick(level.Grime, "Weight", rng)
		local grimeType = Config.GrimeTypes[entry.Type]
		if not grimeType then
			continue
		end
		local size = rng:NextNumber(grimeType.Size[1], grimeType.Size[2]) * DIRT_SCALE

		-- Find a spot where the whole splat sits on the dish; shrink it if it only just misses.
		local hitPos, hitNormal = nil, nil
		for attempt = 1, RAY_ATTEMPTS do
			local lo, ld = candidateFn(rng)
			if ld.Magnitude &gt; 1e-4 then
				local originWorld = localPos(anchor, lo.X, lo.Y, lo.Z)
				local dirWorld = localDir(anchor, ld.X, ld.Y, ld.Z).Unit * 40
				local result = workspace:Raycast(originWorld, dirWorld, params)
				if result then
					local crowded = false
					for _, p in used do
						if (p - result.Position).Magnitude &lt; MIN_SPACING then
							crowded = true
							break
						end
					end
					if not crowded then
						if fits(params, result.Position, result.Normal, size * 0.5) then
							hitPos, hitNormal = result.Position, result.Normal
							break
						elseif attempt &gt; RAY_ATTEMPTS / 2 and fits(params, result.Position, result.Normal, size * 0.32) then
							size *= 0.65
							hitPos, hitNormal = result.Position, result.Normal
							break
						end
					end
				end
			end
		end
		if hitPos and hitNormal then
			table.insert(used, hitPos)
			local golden = rng:NextNumber() &lt; goldenChance
			local hint = if math.abs(hitNormal:Dot(Vector3.new(0, 1, 0))) &gt; 0.9 then anchor.RightVector else Vector3.new(0, 1, 0)
			-- Where two splats overlap they sit at different heights whose faces never line up and flicker.
			-- Streaks trail up to ~2.6 sizes from their centre; blobs' outer droplets reach ~1 size.
			local reach = size * (if grimeType.Shape == "Streak" then 2.6 else 1.0)
			local lift = pickLift(hitPos, hitNormal, reach, spots)
			table.insert(spots, { Pos = hitPos, Normal = hitNormal, Radius = reach, Lift = lift })
			local cf = axisCFrame(hitPos + hitNormal * lift, hitNormal, hint)
			cf = cf * CFrame.Angles(rng:NextNumber() * math.pi * 2, 0, 0)

			local color = if golden then GOLDEN_COLOR else grimeType.Color
			local material = grimeType.Material

			local part: BasePart, children: { BasePart }
			if grimeType.Shape == "Crumbs" then
				part, children = shapeCrumbs(cf, size, color, material, rng)
			elseif grimeType.Shape == "Sprinkles" then
				part, children = shapeSprinkles(cf, size, color, material, rng)
			elseif grimeType.Shape == "Streak" then
				part, children = shapeStreak(cf, size, color, material, rng)
			else
				part, children = shapeBlob(cf, size, color, material, rng)
			end

			part.Name = "Dirt"
			part.CanTouch = false
			part.CanQuery = true
			part.CanCollide = false
			part.CastShadow = false
			-- Stay in the Default collision group: spatial queries (the server's scrub overlap,
			-- raycasts) skip parts whose group can't collide with the query's group, so a
			-- "collides with nothing" group would make dirt impossible to clean.

			local hp = math.max(1, math.floor(grimeType.HP * levelMult * (level.Toughness or 1) * partyHp + 0.5))
			local units = math.max(1, math.floor(grimeType.Units * levelMult * partyHp + 0.5))
			local minTool = grimeType.MinTool
			if golden then
				units = math.floor(units * Config.Round.GoldenUnitsMult + 0.5)
				minTool = 1
				part.Material = Enum.Material.Neon
				part.Color = GOLDEN_COLOR
				for _, child in children do
					child.Color = GOLDEN_COLOR
					child.Material = Enum.Material.Foil
				end
				local attach = Instance.new("Attachment")
				attach.Parent = part
				local emitter = Instance.new("ParticleEmitter")
				emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
				emitter.Lifetime = NumberRange.new(0.5, 1.0)
				emitter.Rate = 6
				emitter.Speed = NumberRange.new(0.5, 1.5)
				emitter.Size = NumberSequence.new(0.5, 0)
				emitter.Color = ColorSequence.new(GOLDEN_COLOR)
				emitter.Parent = attach
			end

			part:SetAttribute("HP", hp)
			part:SetAttribute("MaxHP", hp)
			part:SetAttribute("Units", units)
			part:SetAttribute("Type", entry.Type)
			part:SetAttribute("DishId", dishId)
			part:SetAttribute("Golden", golden)
			part:SetAttribute("MinTool", minTool)
			part:SetAttribute("BaseSize", part.Size)
			part:SetAttribute("BaseTransparency", part.Transparency)

			for _, child in children do
				if snapToSurface(params, child, hitPos, hitNormal) then
					child:SetAttribute("BaseSize", child.Size)
					child.Parent = part
				else
					child:Destroy()
				end
			end

			part.Parent = folder
			table.insert(placed, part)
		end
	end

	return placed
end

----------------------------------------------------------------------------------------------------
-- SetGrimeHealth: cheap per-frame-ish update while a spot is being scrubbed. The splat shrinks and
-- fades toward nothing as it's cleaned.
----------------------------------------------------------------------------------------------------
function DishFactory.SetGrimeHealth(part: BasePart, fraction: number)
	fraction = math.clamp(fraction, 0, 1)
	local shrink = 0.45 + 0.55 * fraction
	local baseT = part:GetAttribute("BaseTransparency")
	local fade = (1 - fraction) * 0.8
	local baseSize = part:GetAttribute("BaseSize")
	if typeof(baseSize) == "Vector3" then
		part.Size = Vector3.new(baseSize.X, baseSize.Y * shrink, baseSize.Z * shrink)
	end
	part.Transparency = math.min(1, (if type(baseT) == "number" then baseT else 0) + fade)

	for _, child in part:GetChildren() do
		if child:IsA("BasePart") then
			local childBase = child:GetAttribute("BaseSize")
			if typeof(childBase) == "Vector3" then
				child.Size = childBase * shrink
			end
			child.Transparency = fade
		end
	end
end

----------------------------------------------------------------------------------------------------
-- Sparkle: the finished-dish effect. Server-side so every client sees the same thing.
----------------------------------------------------------------------------------------------------
function DishFactory.Sparkle(dish: Model)
	if not dish or not dish.Parent then
		return
	end
	local root = dish.PrimaryPart or dish:FindFirstChildWhichIsA("BasePart")
	if not root then
		return
	end

	local ok = pcall(function()
		local highlight = Instance.new("Highlight")
		highlight.FillColor = Color3.new(1, 1, 1)
		highlight.FillTransparency = 0.3
		highlight.OutlineTransparency = 1
		highlight.Adornee = dish
		highlight.Parent = dish
		Debris:AddItem(highlight, 0.5)

		local attach = Instance.new("Attachment")
		attach.Parent = root
		local emitter = Instance.new("ParticleEmitter")
		emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		emitter.Lifetime = NumberRange.new(0.4, 0.9)
		emitter.Rate = 0
		emitter.Speed = NumberRange.new(3, 8)
		emitter.SpreadAngle = Vector2.new(180, 180)
		emitter.Size = NumberSequence.new(1, 0)
		emitter.Color = ColorSequence.new(Color3.new(1, 1, 1))
		emitter.Parent = attach
		emitter:Emit(30)
		Debris:AddItem(attach, 1.5)
	end)
	if not ok then
		warn("[DishFactory] Sparkle effect failed")
	end
end

return DishFactory</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000018"><Properties><string name="Name">EventService</string><ProtectedString name="Source">--[[
	EventService - the limited-time Treasure Chest event (Config.ChestEvent).

	  * Free chests: ChestRequest "Free" opens one (Config.ChestEvent.FreeOpens per event, saved).
	  * Bought chests: x1 / x3 / x10 developer products (StoreIds &gt; Events). Roblox's receipt lands in
	    MarketService, which calls the grant registered here: the chests are opened on the server
	    right away and the results go to the client (ChestResult) for the reveal.
	  * Studio: packs without a product Id open for free (ChestRequest "Test"), like the shop's tests.

	Every roll is weighted by Config.ChestEvent.Rewards (the same odds the chest window shows).
	Rewards never yield: Bubbles / Gems / the x2 Cleaning boost / a pet / a game pass (a random one
	you don't own, saved like a gift; if you own them all, Gems instead).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local DataService = require(script.Parent:WaitForChild("DataService"))
local MarketService = require(script.Parent:WaitForChild("MarketService"))

local EventService = {}

local rng = Random.new()
local initialized = false
local lastRequest: { [Player]: number } = {}

local function petService(): any
	return require(script.Parent:WaitForChild("PetService")) :: any
end

local function giftService(): any
	return require(script.Parent:WaitForChild("GiftService")) :: any
end

local function pick(): (number, any)
	local rewards = Config.ChestEvent.Rewards
	local x = rng:NextNumber() * 100
	for i, r in rewards do
		x -= r.Chance
		if x &lt;= 0 then
			return i, r
		end
	end
	return 1, rewards[1]
end

-- Gives one reward; returns what to show ("Golden Treasure Turtle", "x2 Luck pass!").
local function give(player: Player, reward: any): string
	local name = Config.ChestRewardName(reward)
	if reward.Kind == "Bubbles" then
		DataService.AddBubbles(player, reward.Amount, "Chest")
	elseif reward.Kind == "Gems" then
		DataService.AddGems(player, reward.Amount)
	elseif reward.Kind == "Boost" then
		DataService.AddBoost(player, reward.Minutes * 60)
	elseif reward.Kind == "Pet" then
		local ok = petService().GivePet(player, reward.Pet, reward.Tier)
		if not ok then
			-- Inventory full: the pet's worth in Gems instead, so nothing is lost.
			local gems = if reward.Tier and reward.Tier &gt; 1 then 250 elseif Config.Pets[reward.Pet].Rarity == "Legendary" then 150 else 60
			DataService.AddGems(player, gems)
			name = string.format("%s (bag full: %d Gems)", name, gems)
		end
	elseif reward.Kind == "Pass" then
		local free = {}
		for _, pass in Config.GamePasses do
			if not giftService().Owns(player, pass.Key) then
				table.insert(free, pass)
			end
		end
		if #free &gt; 0 then
			local pass = free[rng:NextInteger(1, #free)]
			giftService().GrantPass(player, pass.Key, "JACKPOT!", "The Treasure Chest had " .. pass.Name .. " inside!")
			name = pass.Name .. " pass!"
		else
			DataService.AddGems(player, reward.Fallback or 150)
			name = string.format("%d Gems (you own every pass!)", reward.Fallback or 150)
		end
	end
	return name
end

-- Opens `count` chests for this player. Never yields.
function EventService.Open(player: Player, count: number): { { Index: number, Text: string } }
	local results = {}
	for _ = 1, count do
		local index, reward = pick()
		local ok, text = pcall(give, player, reward)
		table.insert(results, { Index = index, Text = if ok then text else Config.ChestRewardName(reward) })
		if not ok then
			warn("[EventService] chest reward failed: " .. tostring(text))
		end
	end
	DataService.CountChests(player, count)
	return results
end

local function testAllowed(): boolean
	local rules: any = Config.TestPasses or {}
	return if RunService:IsStudio() then rules.AllowInStudio == true else rules.AllowInLiveGame == true
end

local function onRequest(player: Player, action: any, value: any): any
	local now = os.clock()
	if now - (lastRequest[player] or 0) &lt; 0.5 then
		return { Ok = false, Error = "Slow down a little!" }
	end
	lastRequest[player] = now
	if not DataService.Get(player) then
		return { Ok = false, Error = "Your save is still loading." }
	end
	if action == "Free" then
		if not DataService.UseFreeChest(player) then
			return { Ok = false, Error = if Config.ChestEventLive() then "You've opened your free chest!" else "The event has ended." }
		end
		return { Ok = true, Rewards = EventService.Open(player, 1) }
	elseif action == "Test" then
		-- A pack without a product Id: free in Studio, so the buttons can be tried.
		for _, pack in Config.ChestEvent.Packs do
			if pack.Count == value then
				local id = Config.EventProducts[pack.Key]
				if type(id) == "number" and id &gt; 0 then
					return { Ok = false, Error = "This is on sale for real. Use the purchase prompt!" }
				end
				if not testAllowed() then
					return { Ok = false, Error = "Coming soon!" }
				end
				return { Ok = true, Rewards = EventService.Open(player, pack.Count) }
			end
		end
	end
	return { Ok = false, Error = "Unknown request." }
end

function EventService.Init()
	if initialized then
		return
	end
	initialized = true
	Remotes.Function("ChestRequest").OnServerInvoke = onRequest
	local resultRemote = Remotes.Event("ChestResult")
	for _, pack in Config.ChestEvent.Packs do
		MarketService.RegisterProduct(Config.EventProducts[pack.Key], function(player)
			if not DataService.Get(player) then
				error("profile not loaded")
			end
			-- Bought: always opens, even if the event ended while the prompt was up.
			local results = EventService.Open(player, pack.Count)
			if player.Parent == Players then
				resultRemote:FireClient(player, results)
			end
		end)
	end
	Players.PlayerRemoving:Connect(function(player)
		lastRequest[player] = nil
	end)
end

function EventService.Start() end

return EventService</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000019"><Properties><string name="Name">GiftService</string><ProtectedString name="Source">--[[
	GiftService - gifting game passes to another player.

	Roblox can't sell a game pass to one player on behalf of another, so every pass has a matching
	developer product (Config.GiftProducts, "Gift: VIP", same price, Ids in StoreIds &gt; GiftPasses).

	  1. The buyer picks a pass and a player in their server (ShopUI). GiftRequest checks the gift
	     makes sense (they're here, they don't own it yet) and remembers "this buyer is gifting this
	     pass to that player", then the client shows Roblox's purchase prompt for the gift product.
	  2. When Roblox confirms the purchase, MarketService's receipt handler calls Deliver: the
	     recipient gets the pass (the same kind of grant the admin panel's :givegamepass makes, saved
	     in the "RinseCycleGamepassGrants" store, so it lasts forever), and both players get a popup.
	  3. If the recipient left or hopped servers meanwhile the grant is still saved, and any server
	     they're in right now is told through MessagingService.

	In Studio (gift product Id still 0) a gift is free, for testing.
]]

local MessagingService = game:GetService("MessagingService")
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local DataService = require(script.Parent:WaitForChild("DataService"))

local GiftService = {}

local TOPIC = "RinseCycle_Gift"
local GRANT_STORE = "RinseCycleGamepassGrants" -- shared with AdminServer (:givegamepass)
local PENDING_TTL = 600 -- seconds a picked recipient is remembered while the prompt is open
local SAVE_ATTEMPTS = 4

type Pending = { Key: string, ToUserId: number, ToName: string, At: number }
local pending: { [Player]: Pending } = {}
local grantStore: DataStore? = nil

local function isHere(player: Player): boolean
	return player.Parent == Players
end

local function passByKey(key: any)
	if type(key) ~= "string" then
		return nil
	end
	return Config.GetPass(key)
end

-- A popup with confetti on that player's screen (Celebrate on the client).
function GiftService.Celebrate(player: Player, title: string, text: string, icon: string?)
	if isHere(player) then
		Remotes.Event("Celebrate"):FireClient(player, title, text, icon)
	end
end

local function owns(player: Player, key: string): boolean
	if player:GetAttribute("GP_" .. key) == true then
		return true
	end
	local ok, passes = pcall(DataService.GetPasses, player)
	return ok and type(passes) == "table" and passes[key] == true
end

-- Turns the pass on for a recipient who is in this server, with their popup.
local function applyHere(recipient: Player, key: string, fromName: string)
	local pass = passByKey(key)
	if not pass or not isHere(recipient) then
		return
	end
	recipient:SetAttribute("GP_" .. key, true)
	DataService.SetPass(recipient, key, true)
	GiftService.Celebrate(recipient, "You got a gift!", string.format("%s gifted you %s!", fromName, pass.Name), pass.Icon)
end

-- Saves the grant for good (same record AdminServer loads on join).
local function saveGrant(userId: number, key: string)
	task.spawn(function()
		if not grantStore then
			local ok, store = pcall(function()
				return DataStoreService:GetDataStore(GRANT_STORE)
			end)
			if ok then
				grantStore = store
			end
		end
		local store = grantStore
		if not store then
			return
		end
		for attempt = 1, SAVE_ATTEMPTS do
			local ok, err = pcall(function()
				store:UpdateAsync("grants_" .. tostring(userId), function(old)
					local list = if type(old) == "table" then old else {}
					if not table.find(list, key) then
						table.insert(list, key)
					end
					return list
				end)
			end)
			if ok then
				return
			end
			if attempt == SAVE_ATTEMPTS then
				warn(string.format("[GiftService] couldn't save gift %s for %d: %s", key, userId, tostring(err)))
			else
				task.wait(attempt * 2)
			end
		end
	end)
end

-- Gives a pass for good (Treasure Chest prizes): saved like a gift, with a popup. Never yields.
function GiftService.GrantPass(player: Player, key: string, title: string, text: string): boolean
	local pass = passByKey(key)
	if not pass or not isHere(player) then
		return false
	end
	saveGrant(player.UserId, key)
	player:SetAttribute("GP_" .. key, true)
	DataService.SetPass(player, key, true)
	GiftService.Celebrate(player, title, text, pass.Icon)
	return true
end

function GiftService.Owns(player: Player, key: string): boolean
	return owns(player, key)
end

-- Called when a gift product purchase is confirmed. Never yields. Returns true when handled.
function GiftService.Deliver(buyer: Player, key: string): boolean
	local pass = passByKey(key)
	if not pass then
		return false
	end
	local p = pending[buyer]
	pending[buyer] = nil
	local toUserId, toName
	if p and p.Key == key then
		toUserId, toName = p.ToUserId, p.ToName
	else
		-- We lost track of who it was for (e.g. the buyer rejoined): they keep it themselves.
		toUserId, toName = buyer.UserId, buyer.DisplayName
	end

	saveGrant(toUserId, key)
	local recipient = Players:GetPlayerByUserId(toUserId)
	if recipient then
		applyHere(recipient, key, buyer.DisplayName)
	else
		task.spawn(function()
			pcall(function()
				MessagingService:PublishAsync(TOPIC, { UserId = toUserId, Key = key, From = buyer.DisplayName })
			end)
		end)
	end
	if toUserId ~= buyer.UserId then
		GiftService.Celebrate(buyer, "Gift sent!", string.format("Successfully gifted %s to %s!", pass.Name, toName), pass.Icon)
	end
	return true
end

local function onGiftRequest(player: Player, key: any, toUserId: any)
	local pass = passByKey(key)
	local gift = pass and Config.GetGiftProduct(pass.Key)
	if not pass or not gift then
		return { Ok = false, Error = "That can't be gifted." }
	end
	if type(toUserId) ~= "number" or toUserId == player.UserId then
		return { Ok = false, Error = "Pick someone to gift it to." }
	end
	local target = Players:GetPlayerByUserId(toUserId)
	if not target then
		return { Ok = false, Error = "They're not in this server any more." }
	end
	if owns(target, pass.Key) then
		return { Ok = false, Error = string.format("%s already has %s!", target.DisplayName, pass.Name) }
	end
	pending[player] = { Key = pass.Key, ToUserId = target.UserId, ToName = target.DisplayName, At = os.clock() }
	if type(gift.Id) == "number" and gift.Id &gt; 0 then
		return { Ok = true, ProductId = gift.Id }
	end
	-- No gift product Id yet: free in Studio tests, "coming soon" in the live game.
	local test = Config.TestPasses
	if (RunService:IsStudio() and test.AllowInStudio) or test.AllowInLiveGame then
		GiftService.Deliver(player, pass.Key)
		return { Ok = true, Done = true }
	end
	pending[player] = nil
	return { Ok = false, Error = "Gifting this is coming soon!" }
end

function GiftService.Init()
	Remotes.Function("GiftRequest").OnServerInvoke = onGiftRequest
	Players.PlayerRemoving:Connect(function(player)
		pending[player] = nil
	end)
	-- Forget recipients picked long ago (a prompt that was never finished).
	task.spawn(function()
		while true do
			task.wait(60)
			local now = os.clock()
			for player, p in pending do
				if now - p.At &gt; PENDING_TTL then
					pending[player] = nil
				end
			end
		end
	end)
	-- A gift bought in another server for someone playing here.
	task.spawn(function()
		pcall(function()
			MessagingService:SubscribeAsync(TOPIC, function(message)
				local data = message.Data
				if type(data) ~= "table" or type(data.UserId) ~= "number" then
					return
				end
				local recipient = Players:GetPlayerByUserId(data.UserId)
				if recipient then
					applyHere(recipient, tostring(data.Key), tostring(data.From or "Someone"))
				end
			end)
		end)
	end)
end

return GiftService</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000001A"><Properties><string name="Name">LeaderboardService</string><ProtectedString name="Source">-- Lobby leaderboards: "Fastest Clean" (one page per level) and "Top Players" (pages: Most Dishes
-- Cleaned, Most Rebirths, Most Bubbles Collected). Players flip pages with the arrows.
--
--   * OrderedDataStores: RinseCycle_Fastest_L&lt;n&gt; holds best times in tenths of a second (ascending,
--     lower is better); RinseCycle_Dishes / _Rebirths / _Bubbles hold lifetime DishesCleaned,
--     Rebirths and Stats.BubblesEarned (descending). Keys are
--     "u_" .. userId, the same as the profile store.
--   * Every REFRESH_INTERVAL seconds: write the online players' values (times only when they
--     improved, and only values that changed since this server last wrote them), read the top 100
--     of every store, and redraw (each board scrolls).
--   * Your position: every player gets attributes "Lb_&lt;board id&gt;" = "&lt;rank&gt;|&lt;value text&gt;" (board
--     ids D1..D3 for the Top Players pages, T1..Tn for Fastest), drawn as a highlighted row under
--     each page by the client (BoardView). Ranks past the top 100 come from a slow background scan
--     of the store, 100 entries per read, up to DEEP_LIMIT, only while the DataStore budget allows.
--   * Offline (Studio without API access) the boards rank the players in this server instead.
--   * The Times board draws every level's page; each client shows the page it picked (Effects).
--   * Admin resets (the admin panel's Leaderboards view): a reset takes a player off one board
--     without touching their real stats. For Dishes / Rebirths / Bubbles it stores an offset
--     (RinseCycle_LbResets), so the board only counts what they earn after the reset (2,000 dishes
--     reset, then 2,000 more = 4,000 dishes but 2,000 on the board). For a Fastest board they come
--     back once they beat the time they had when they were reset. Other servers hear about a
--     reset through MessagingService.

local CollectionService = game:GetService("CollectionService")
local DataStoreService = game:GetService("DataStoreService")
local MessagingService = game:GetService("MessagingService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))

local LobbyBuilder = require(script.Parent:WaitForChild("LobbyBuilder"))
local DataService = require(script.Parent:WaitForChild("DataService"))

local LeaderboardService = {}

----------------------------------------------------------------------------------------------------
-- Tunables
----------------------------------------------------------------------------------------------------

local REFRESH_INTERVAL = 60
local OFFLINE_REFRESH_INTERVAL = 10 -- offline boards are free to rebuild, so keep them fresh
local FIRST_REFRESH_DELAY = 6 -- the first WRITE waits for the first players' profiles to load
local TOP_N = 100 -- rows on each board (it scrolls); also what the admin viewer lists
local DEEP_LIMIT = 1000 -- "your position" is looked up this far down; past it you're "#1000+"
local DEEP_RESCAN = 300 -- seconds before a board's deep ranks are read again
local KEY_PREFIX = "u_"
local ROW_HEIGHT = 34

local ROW_COLORS = {
	Color3.fromRGB(255, 215, 90),
	Color3.fromRGB(220, 230, 240),
	Color3.fromRGB(240, 170, 110),
}

----------------------------------------------------------------------------------------------------
-- State
----------------------------------------------------------------------------------------------------

type Row = { UserId: number, Name: string, Value: number }

local levelCount = #Config.Levels
local timesTop: { [number]: { Row } } = {}
local timeStores: { [number]: OrderedDataStore } = {}

-- The "Top Players" pages, in page order: what each ranks and how it reads from a profile.
type Stat = { Key: string, Store: string, Title: string, Empty: string, Get: (any) -&gt; number, Top: { Row }, DS: OrderedDataStore?, Written: { [number]: number } }
local STATS: { Stat } = {
	{ Key = "Dishes", Store = "RinseCycle_Dishes", Title = "Most Dishes Cleaned", Empty = "No dishes cleaned yet!", Get = function(p)
		return p.Stats.DishesCleaned or 0
	end, Top = {}, Written = {} },
	{ Key = "Rebirths", Store = "RinseCycle_Rebirths", Title = "Most Rebirths", Empty = "No rebirths yet!", Get = function(p)
		return p.Rebirths or 0
	end, Top = {}, Written = {} },
	{ Key = "Bubbles", Store = "RinseCycle_Bubbles", Title = "Most Bubbles Collected", Empty = "No Bubbles yet!", Get = function(p)
		return p.Stats.BubblesEarned or 0
	end, Top = {}, Written = {} },
}

-- What this server last wrote per user, so unchanged values aren't rewritten every refresh.
local writtenTimes: { [number]: { [number]: number } } = {}
local nameCache: { [number]: string } = {}

-- Admin resets, per user: Stats[statKey] = amount taken off, Times[tostring(level)] = the time
-- (tenths) they have to beat to be listed again.
type Resets = { Stats: { [string]: number }, Times: { [string]: number } }
local RESET_STORE = "RinseCycle_LbResets"
local RESET_TOPIC = "RinseCycle_LbReset"
local resets: { [number]: Resets } = {}
local resetsLoaded: { [number]: boolean } = {}
local resetStore: DataStore? = nil

----------------------------------------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------------------------------------

local function toTenths(seconds: number): number
	return math.max(1, math.floor(seconds * 10 + 0.5))
end

-- 753 tenths -&gt; "1:15.3"
local function formatTenths(tenths: number): string
	return string.format("%s.%d", Format.Time(tenths // 10), tenths % 10)
end

local function nameFor(userId: number): string
	local cached = nameCache[userId]
	if cached then
		return cached
	end
	local player = Players:GetPlayerByUserId(userId)
	if player then
		nameCache[userId] = player.Name
		return player.Name
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	if ok and type(name) == "string" then
		nameCache[userId] = name
		return name
	end
	return "Player " .. tostring(userId)
end

local function emptyResets(): Resets
	return { Stats = {}, Times = {} }
end

local function resetsOf(userId: number): Resets
	local r = resets[userId]
	if not r then
		r = emptyResets()
		resets[userId] = r
	end
	return r
end

local function getResetStore(): DataStore?
	if not resetStore then
		local ok, store = pcall(function()
			return DataStoreService:GetDataStore(RESET_STORE)
		end)
		if ok then
			resetStore = store
		end
	end
	return resetStore
end

local function cleanResets(value: any): Resets
	local r = emptyResets()
	if type(value) == "table" then
		for k, v in (if type(value.Stats) == "table" then value.Stats else {}) do
			if type(k) == "string" and type(v) == "number" then
				r.Stats[k] = v
			end
		end
		for k, v in (if type(value.Times) == "table" then value.Times else {}) do
			if type(v) == "number" then
				r.Times[tostring(k)] = v
			end
		end
	end
	return r
end

-- Reads a player's resets (on join, and when another server reset them). Until this has worked,
-- their values aren't written, so a reset can't be undone by a server that doesn't know about it.
local function loadResets(userId: number)
	if DataService.IsOffline() then
		resetsLoaded[userId] = true
		return
	end
	local store = getResetStore()
	if not store then
		return
	end
	local ok, value = pcall(function()
		return store:GetAsync(KEY_PREFIX .. userId)
	end)
	if ok then
		resets[userId] = cleanResets(value)
		resetsLoaded[userId] = true
	end
end

-- The value a player shows on a stat board: their real total minus any admin reset.
local function boardValue(stat: Stat, profile: any, userId: number): number
	local taken = resetsOf(userId).Stats[stat.Key] or 0
	return math.max(0, math.floor(stat.Get(profile)) - taken)
end

-- May this best time go on the board? (After a reset, only a better time than back then.)
local function timeAllowed(userId: number, level: number, tenths: number): boolean
	local floor = resetsOf(userId).Times[tostring(level)]
	return floor == nil or tenths &lt; floor
end

local function openStores(): boolean
	if STATS[#STATS].DS then
		return true
	end
	local ok = pcall(function()
		for i = 1, levelCount do
			timeStores[i] = DataStoreService:GetOrderedDataStore("RinseCycle_Fastest_L" .. i)
		end
		for _, stat in STATS do
			stat.DS = DataStoreService:GetOrderedDataStore(stat.Store)
		end
	end)
	return ok and STATS[#STATS].DS ~= nil
end

----------------------------------------------------------------------------------------------------
-- Drawing
----------------------------------------------------------------------------------------------------

local function clearList(list: GuiObject)
	for _, child in list:GetChildren() do
		if not child:IsA("UIListLayout") then
			child:Destroy()
		end
	end
end

local function label(props: { [string]: any }, parent: Instance): TextLabel
	local lbl = Instance.new("TextLabel")
	lbl.BackgroundTransparency = 1
	lbl.Font = Enum.Font.LuckiestGuy
	lbl.TextScaled = true
	lbl.TextColor3 = Color3.new(1, 1, 1)
	-- A text stroke instead of a UIStroke: 100 rows a page, so fewer instances to send to everyone.
	lbl.TextStrokeTransparency = 0.2
	lbl.TextStrokeColor3 = Color3.fromRGB(10, 30, 60)
	for k, v in props do
		(lbl :: any)[k] = v
	end
	lbl.Parent = parent
	return lbl
end

-- What each list last showed, so an unchanged board isn't torn down and rebuilt every minute.
local drawn: { [Instance]: string } = {}

local function drawRows(list: GuiObject, rows: { Row }, valueText: (number) -&gt; string, emptyText: string)
	local parts = { emptyText }
	for _, row in rows do
		table.insert(parts, row.UserId .. ":" .. row.Name .. ":" .. row.Value)
	end
	local signature = table.concat(parts, ";")
	if drawn[list] == signature then
		return
	end
	drawn[list] = signature
	clearList(list :: any)
	if #rows == 0 then
		label({
			Name = "Empty",
			Size = UDim2.new(1, 0, 0, ROW_HEIGHT * 1.5),
			Text = emptyText,
			TextColor3 = Color3.fromRGB(190, 220, 245),
		}, list)
		return
	end
	for rank, row in rows do
		local frame = Instance.new("Frame")
		frame.Name = "Row" .. rank
		frame.LayoutOrder = rank
		frame.Size = UDim2.new(1, -16, 0, ROW_HEIGHT)
		frame.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
		frame.BackgroundTransparency = rank % 2 == 1 and 0.9 or 0.95
		frame.BorderSizePixel = 0
		frame:SetAttribute("UserId", row.UserId) -- the client lights up its own row
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 8)
		corner.Parent = frame

		local color = ROW_COLORS[rank] or Color3.new(1, 1, 1)
		label({
			Name = "Rank",
			Size = UDim2.new(0, 72, 1, -4),
			Position = UDim2.new(0, 4, 0, 2),
			Text = "#" .. rank,
			TextColor3 = color,
		}, frame)
		label({
			Name = "Player",
			Size = UDim2.new(1, -240, 1, -4),
			Position = UDim2.new(0, 84, 0, 2),
			Text = row.Name,
			TextColor3 = color,
			TextXAlignment = Enum.TextXAlignment.Left,
		}, frame)
		label({
			Name = "Value",
			Size = UDim2.new(0, 150, 1, -4),
			Position = UDim2.new(1, -154, 0, 2),
			Text = valueText(row.Value),
			TextColor3 = color,
			TextXAlignment = Enum.TextXAlignment.Right,
		}, frame)
		frame.Parent = list
	end
end

local function drawTimes()
	local lobby = LobbyBuilder.GetLobby()
	if not lobby then
		return
	end
	local board = lobby.Boards.Times
	local pages = board.Pages or { { Title = board.Title, List = board.List } }
	for i, page in pages do
		local level = Config.Levels[i]
		if level then
			page.Title.Text = string.format("Fastest: %s", level.Name)
			drawRows(page.List, timesTop[i] or {}, formatTenths, "No clears yet!")
		end
	end
end

local function drawDishes()
	local lobby = LobbyBuilder.GetLobby()
	if not lobby then
		return
	end
	local board = lobby.Boards.Dishes
	local pages = board.Pages or { { Title = board.Title, List = board.List } }
	for i, page in pages do
		local stat = STATS[i]
		if stat then
			page.Title.Text = stat.Title
			drawRows(page.List, stat.Top, Format.Commas, stat.Empty)
		end
	end
end

----------------------------------------------------------------------------------------------------
-- Refresh
----------------------------------------------------------------------------------------------------

-- Offline: rank the players in this server from their in-memory profiles.
local function refreshOffline()
	for i = 1, levelCount do
		local rows: { Row } = {}
		for _, player in Players:GetPlayers() do
			local profile = DataService.Get(player)
			local best = profile and profile.BestTimes[i]
			if best and best &gt; 0 and timeAllowed(player.UserId, i, toTenths(best)) then
				table.insert(rows, { UserId = player.UserId, Name = player.Name, Value = toTenths(best) })
			end
		end
		table.sort(rows, function(a, b)
			return a.Value &lt; b.Value
		end)
		timesTop[i] = { table.unpack(rows, 1, math.min(#rows, TOP_N)) }
	end

	for _, stat in STATS do
		local rows: { Row } = {}
		for _, player in Players:GetPlayers() do
			local profile = DataService.Get(player)
			local value = if profile then boardValue(stat, profile, player.UserId) else 0
			if value &gt; 0 then
				table.insert(rows, { UserId = player.UserId, Name = player.Name, Value = value })
			end
		end
		table.sort(rows, function(a, b)
			return a.Value &gt; b.Value
		end)
		stat.Top = { table.unpack(rows, 1, math.min(#rows, TOP_N)) }
	end
end

local function writeOnline()
	for _, player in Players:GetPlayers() do
		local profile = DataService.Get(player)
		if not profile then
			continue
		end
		local userId = player.UserId
		local key = KEY_PREFIX .. userId
		if not resetsLoaded[userId] then
			task.spawn(loadResets, userId)
			continue
		end

		local written = writtenTimes[userId] or {}
		writtenTimes[userId] = written
		for i = 1, levelCount do
			local best = profile.BestTimes[i]
			local store = timeStores[i]
			if not best or best &lt;= 0 or not store then
				continue
			end
			local tenths = toTenths(best)
			if written[i] and written[i] &lt;= tenths then
				continue
			end
			if not timeAllowed(userId, i, tenths) then
				continue
			end
			local ok = pcall(function()
				(store :: any):UpdateAsync(key, function(old: any): number?
					if type(old) == "number" and old &lt;= tenths then
						return nil -- the stored time is already as good or better
					end
					return tenths
				end)
			end)
			if ok then
				written[i] = tenths
			end
		end

		for _, stat in STATS do
			local value = boardValue(stat, profile, userId)
			local store = stat.DS
			if value &gt; 0 and stat.Written[userId] ~= value and store then
				local ok = pcall(function()
					store:SetAsync(key, value)
				end)
				if ok then
					stat.Written[userId] = value
				end
			end
		end
	end
end

-- Returns nil if the read failed, so the board keeps its last good rows.
local function readTop(store: OrderedDataStore, ascending: boolean): { Row }?
	local ok, entries = pcall(function()
		local pages = store:GetSortedAsync(ascending, TOP_N)
		return pages:GetCurrentPage()
	end)
	if not ok or type(entries) ~= "table" then
		return nil
	end
	local found: { { UserId: number, Value: number } } = {}
	for _, entry in entries do
		local userId = tonumber((string.match(tostring(entry.key), "^" .. KEY_PREFIX .. "(%d+)$")))
		local value = tonumber(entry.value)
		if userId and value and value &gt; 0 then
			table.insert(found, { UserId = userId, Value = value })
		end
	end
	-- Names: a few lookups at a time (each is a web call; most are cached after the first read).
	local names: { [number]: string } = {}
	local nextIndex = 0
	local workers = math.min(12, #found)
	local busy = workers
	for _ = 1, workers do
		task.spawn(function()
			while true do
				nextIndex += 1
				local i = nextIndex
				if i &gt; #found then
					break
				end
				names[i] = nameFor(found[i].UserId)
			end
			busy -= 1
		end)
	end
	local deadline = os.clock() + 15
	while busy &gt; 0 and os.clock() &lt; deadline do
		task.wait()
	end
	local rows: { Row } = {}
	for i, f in found do
		table.insert(rows, { UserId = f.UserId, Name = names[i] or ("Player " .. f.UserId), Value = f.Value })
	end
	return rows
end

-- Reads every board's top 100 (no writes), all boards at once. Also run the moment the server
-- starts, so the boards are filled before anyone looks at them.
local function readAll()
	local left = 0
	local function read(store: OrderedDataStore?, ascending: boolean, apply: ({ Row }) -&gt; ())
		if not store then
			return
		end
		left += 1
		task.spawn(function()
			local rows = readTop(store, ascending)
			if rows then
				apply(rows)
			end
			left -= 1
		end)
	end
	for i = 1, levelCount do
		read(timeStores[i], true, function(rows)
			timesTop[i] = rows
		end)
	end
	for _, stat in STATS do
		read(stat.DS, false, function(rows)
			stat.Top = rows
		end)
	end
	local deadline = os.clock() + 20
	while left &gt; 0 and os.clock() &lt; deadline do
		task.wait()
	end
end

local function refreshOnline()
	writeOnline()
	readAll()
end

----------------------------------------------------------------------------------------------------
-- Your position: each player's rank on every board, for the highlighted "you" row under each page
----------------------------------------------------------------------------------------------------

-- Board ids: "D&lt;i&gt;" = STATS[i] (Top Players page i), "T&lt;i&gt;" = Fastest on level i.
local function boardIds(): { string }
	local ids = {}
	for i = 1, #STATS do
		table.insert(ids, "D" .. i)
	end
	for i = 1, levelCount do
		table.insert(ids, "T" .. i)
	end
	return ids
end

local function boardParts(id: string): (Stat?, number?)
	local kind, n = string.match(id, "^(%a)(%d+)$")
	local index = tonumber(n) or 0
	if kind == "D" then
		return STATS[index], nil
	end
	return nil, index
end

local function topRowsOf(id: string): { Row }
	local stat, level = boardParts(id)
	if stat then
		return stat.Top
	end
	return timesTop[level :: number] or {}
end

-- Ranks past the top 100: read 100 at a time in the background, as far as DEEP_LIMIT.
type Scan = { Pages: any, Rank: number, Found: { [number]: number }, Done: { [number]: number }, FinishedAt: number }
local scans: { [string]: Scan } = {}
local scanCursor = 0

local function sortedBudget(): number
	local ok, n = pcall(function()
		return DataStoreService:GetRequestBudgetForRequestType(Enum.DataStoreRequestType.GetSortedAsync)
	end)
	return if ok and type(n) == "number" then n else 0
end

local function deepScan()
	local ids = boardIds()
	for _ = 1, #ids * 2 do
		if sortedBudget() &lt;= 4 then
			return -- leave room for the top-100 reads
		end
		scanCursor = scanCursor % #ids + 1
		local id = ids[scanCursor]
		local scan = scans[id]
		if not scan then
			scan = { Pages = nil, Rank = 0, Found = {}, Done = {}, FinishedAt = -math.huge }
			scans[id] = scan
		end
		if scan.Pages == nil and (os.clock() - scan.FinishedAt &lt; DEEP_RESCAN or #topRowsOf(id) &lt; TOP_N) then
			continue -- read recently, or everyone fits in the top 100 anyway
		end
		local stat, level = boardParts(id)
		local store: OrderedDataStore? = if stat then stat.DS elseif level then timeStores[level] else nil
		if not store then
			continue
		end
		local ok = pcall(function()
			if scan.Pages == nil then
				scan.Pages = (store :: OrderedDataStore):GetSortedAsync(stat == nil, 100)
			else
				scan.Pages:AdvanceToNextPageAsync()
			end
			for _, entry in scan.Pages:GetCurrentPage() do
				local userId = tonumber((string.match(tostring(entry.key), "^" .. KEY_PREFIX .. "(%d+)$")))
				local value = tonumber(entry.value)
				if userId and value and value &gt; 0 then
					scan.Rank += 1
					scan.Found[userId] = scan.Rank
				end
			end
		end)
		if not ok or scan.Pages == nil or scan.Pages.IsFinished or scan.Rank &gt;= DEEP_LIMIT then
			if ok then
				scan.Done = scan.Found
			end
			scan.Pages, scan.Rank, scan.Found, scan.FinishedAt = nil, 0, {}, os.clock()
		end
	end
end

local function rankOf(id: string, userId: number): number?
	for rank, row in topRowsOf(id) do
		if row.UserId == userId then
			return rank
		end
	end
	local scan = scans[id]
	if scan then
		local rank = scan.Found[userId] or scan.Done[userId]
		if rank and rank &gt; TOP_N then
			return rank
		end
	end
	return nil
end

-- "&lt;rank&gt;|&lt;value text&gt;": rank 0 = past DEEP_LIMIT or not read yet; empty text = not on the board.
local function publishRanks()
	for _, player in Players:GetPlayers() do
		local profile = DataService.Get(player)
		if not profile then
			continue
		end
		for _, id in boardIds() do
			local stat, level = boardParts(id)
			local text = ""
			if stat then
				local value = boardValue(stat, profile, player.UserId)
				text = if value &gt; 0 then Format.Commas(value) else ""
			elseif level then
				local best = profile.BestTimes[level]
				local tenths = if best and best &gt; 0 then toTenths(best) else nil
				text = if tenths and timeAllowed(player.UserId, level, tenths) then formatTenths(tenths) else ""
			end
			local rank = if text ~= "" then (rankOf(id, player.UserId) or 0) else 0
			player:SetAttribute("Lb_" .. id, rank .. "|" .. text)
		end
	end
end

----------------------------------------------------------------------------------------------------
-- Admin: view every board, reset a player on one
----------------------------------------------------------------------------------------------------

export type BoardRow = { UserId: number, Name: string, Value: number, Text: string }

-- Board n: 1..#STATS are the Top Players pages, then one Fastest page per level.
function LeaderboardService.BoardCount(): number
	return #STATS + levelCount
end

function LeaderboardService.BoardTitle(index: number): string
	local stat = STATS[index]
	if stat then
		return stat.Title
	end
	local level = Config.Levels[index - #STATS]
	return if level then "Fastest: " .. level.Name else "?"
end

-- Up to `limit` entries of board `index`, best first. Straight from what the lobby boards last
-- read (no wait); only reads the DataStore if nothing has been read yet.
function LeaderboardService.ListBoard(index: number, limit: number?): { BoardRow }
	local count = math.clamp(math.floor(limit or 100), 1, 100)
	local stat = STATS[index]
	local level = if stat then nil else index - #STATS
	local rows: { BoardRow } = {}
	local cached = if stat then stat.Top elseif level then timesTop[level] else nil
	if cached and #cached &gt; 0 then
		for i = 1, math.min(#cached, count) do
			local r = cached[i]
			table.insert(rows, { UserId = r.UserId, Name = r.Name, Value = r.Value, Text = if stat then Format.Commas(r.Value) else formatTenths(r.Value) })
		end
		return rows
	end
	local offline = DataService.IsOffline() or not openStores()
	if offline then
		for _, player in Players:GetPlayers() do
			local profile = DataService.Get(player)
			if not profile then
				continue
			end
			if stat then
				local v = boardValue(stat, profile, player.UserId)
				if v &gt; 0 then
					table.insert(rows, { UserId = player.UserId, Name = player.Name, Value = v, Text = Format.Commas(v) })
				end
			elseif level then
				local best = profile.BestTimes[level]
				local tenths = if best and best &gt; 0 then toTenths(best) else nil
				if tenths and timeAllowed(player.UserId, level, tenths) then
					table.insert(rows, { UserId = player.UserId, Name = player.Name, Value = tenths, Text = formatTenths(tenths) })
				end
			end
		end
		table.sort(rows, function(a, b)
			return if stat then a.Value &gt; b.Value else a.Value &lt; b.Value
		end)
		return { table.unpack(rows, 1, math.min(#rows, count)) }
	end
	local store: OrderedDataStore? = if stat then stat.DS elseif level then timeStores[level] else nil
	if not store then
		return rows
	end
	local ok, entries = pcall(function()
		return (store :: OrderedDataStore):GetSortedAsync(stat == nil, count):GetCurrentPage()
	end)
	if not ok or type(entries) ~= "table" then
		return rows
	end
	for _, entry in entries do
		local userId = tonumber((string.match(tostring(entry.key), "^" .. KEY_PREFIX .. "(%d+)$")))
		local value = tonumber(entry.value)
		if userId and value and value &gt; 0 then
			table.insert(rows, {
				UserId = userId,
				Name = nameFor(userId),
				Value = value,
				Text = if stat then Format.Commas(value) else formatTenths(value),
			})
		end
	end
	return rows
end

-- Takes a player off board `index` (they keep their real stats). Yields. Returns (ok, message).
function LeaderboardService.ResetEntry(index: number, userId: number): (boolean, string)
	local stat = STATS[index]
	local level = if stat then nil else index - #STATS
	if not stat and not (level and Config.Levels[level]) then
		return false, "Unknown leaderboard."
	end
	local key = KEY_PREFIX .. userId
	local player = Players:GetPlayerByUserId(userId)
	local profile = player and DataService.Get(player)
	local offline = DataService.IsOffline() or not openStores()
	local store: OrderedDataStore? = if offline then nil elseif stat then stat.DS else timeStores[level :: number]

	-- What they show on the board right now.
	local shown: number? = nil
	if profile then
		if stat then
			shown = boardValue(stat, profile, userId)
		else
			local best = profile.BestTimes[level :: number]
			shown = if best and best &gt; 0 then toTenths(best) else nil
		end
	end
	if store then
		local ok, value = pcall(function()
			return (store :: OrderedDataStore):GetAsync(key)
		end)
		if ok and tonumber(value) then
			local v = tonumber(value) :: number
			shown = if shown == nil then v elseif stat then math.max(shown, v) else math.min(shown, v)
		end
	end

	-- The new reset record: stats move the offset up by what's shown; times remember the time to beat.
	local function apply(r: Resets): Resets
		if stat then
			if profile then
				r.Stats[stat.Key] = math.floor(stat.Get(profile))
			else
				r.Stats[stat.Key] = (r.Stats[stat.Key] or 0) + (shown or 0)
			end
		elseif shown then
			local floor = r.Times[tostring(level)]
			r.Times[tostring(level)] = if floor then math.min(floor, shown) else shown
		end
		return r
	end

	if offline then
		resets[userId] = apply(resetsOf(userId))
		resetsLoaded[userId] = true
	else
		local rs = getResetStore()
		if not rs then
			return false, "Couldn't reach the leaderboard save."
		end
		local newResets: Resets? = nil
		local ok, err = pcall(function()
			(rs :: DataStore):UpdateAsync(key, function(old)
				newResets = apply(cleanResets(old))
				return newResets
			end)
		end)
		if not ok or not newResets then
			return false, "Couldn't save the reset: " .. tostring(err)
		end
		resets[userId] = newResets :: Resets
		resetsLoaded[userId] = true
		if store then
			pcall(function()
				(store :: OrderedDataStore):RemoveAsync(key)
			end)
		end
		task.spawn(function()
			pcall(function()
				MessagingService:PublishAsync(RESET_TOPIC, { UserId = userId })
			end)
		end)
	end

	-- Forget what this server wrote for them, and take them off the boards on screen now.
	if stat then
		stat.Written[userId] = nil
		for i = #stat.Top, 1, -1 do
			if stat.Top[i].UserId == userId then
				table.remove(stat.Top, i)
			end
		end
	else
		local w = writtenTimes[userId]
		if w then
			w[level :: number] = nil
		end
		local top = timesTop[level :: number] or {}
		for i = #top, 1, -1 do
			if top[i].UserId == userId then
				table.remove(top, i)
			end
		end
	end
	pcall(drawTimes)
	pcall(drawDishes)
	pcall(publishRanks)
	return true, string.format("Reset %s on %s", nameFor(userId), LeaderboardService.BoardTitle(index))
end

----------------------------------------------------------------------------------------------------
-- Lifecycle
----------------------------------------------------------------------------------------------------

function LeaderboardService.Init()
	for i = 1, levelCount do
		timesTop[i] = {}
	end
	Players.PlayerAdded:Connect(function(player)
		loadResets(player.UserId)
		-- Their "you" rows: as soon as their save has loaded.
		task.spawn(function()
			DataService.WaitFor(player, 30)
			pcall(publishRanks)
		end)
	end)
	for _, player in Players:GetPlayers() do
		task.spawn(loadResets, player.UserId)
	end
	Players.PlayerRemoving:Connect(function(player)
		resets[player.UserId] = nil
		resetsLoaded[player.UserId] = nil
	end)
	-- Another server reset someone: re-read their resets and forget what we wrote for them.
	task.spawn(function()
		pcall(function()
			MessagingService:SubscribeAsync(RESET_TOPIC, function(message)
				local data = message.Data
				local userId = type(data) == "table" and tonumber(data.UserId)
				if not userId then
					return
				end
				for _, stat in STATS do
					stat.Written[userId] = nil
				end
				writtenTimes[userId] = nil
				if Players:GetPlayerByUserId(userId) then
					resetsLoaded[userId] = nil
					loadResets(userId)
				end
			end)
		end)
	end)
end

function LeaderboardService.Start()
	if not LobbyBuilder.GetLobby() then
		warn(string.format("[%s] LeaderboardService: no lobby, boards disabled", Config.GameName))
		return
	end
	-- The client (BoardView) makes these scrollable and adds each player's own "you" row.
	local lobby = LobbyBuilder.GetLobby()
	for kind, board in { T = lobby.Boards.Times, D = lobby.Boards.Dishes } do
		board.Part:SetAttribute("LbBoard", kind)
		CollectionService:AddTag(board.Part, "LeaderboardBoard")
	end
	drawTimes()
	drawDishes()

	task.spawn(function()
		-- Straight away: show what's already on the boards (reads only, in parallel per board).
		if not DataService.IsOffline() and openStores() then
			pcall(readAll)
			drawTimes()
			drawDishes()
		end
		task.wait(FIRST_REFRESH_DELAY)
		while true do
			local offline = DataService.IsOffline() or not openStores()
			local ok, err = pcall(if offline then refreshOffline else refreshOnline)
			if not ok then
				warn(string.format("[%s] LeaderboardService refresh failed: %s", Config.GameName, tostring(err)))
			end
			drawTimes()
			drawDishes()
			pcall(publishRanks)
			if not offline then
				pcall(deepScan)
				pcall(publishRanks)
			end
			task.wait(if offline then OFFLINE_REFRESH_INTERVAL else REFRESH_INTERVAL)
		end
	end)
end

return LeaderboardService</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000001B"><Properties><string name="Name">LobbyBuilder</string><ProtectedString name="Source">-- LobbyBuilder: builds the entire lobby world at boot. Nothing here is an uploaded asset: every part
-- is a primitive. The layout is deliberately compact (you can cross it in a few seconds):
--
--                         [ giant dishwasher building + title ]
--        [Soap Shop]         [egg]  [egg]  [egg]            [Pet Stand]
--   (pad 1)            [Fastest]  [How to Play]  [Dishes]            (pad 4)
--   (pad 2)                                                          (pad 5)
--   (pad 3)                        ( spawn )                         (pad 6)
--
-- A tiled plaza (floor top at Y = 0.2) sits on a lawn, ringed by a white picket fence with invisible
-- walls behind it. Party pads are flat circles with a world-sized sign ("0/4 / Touch to create a
-- party"), so signs never fill the screen or cover menus.
--
-- Build() is the only entry point that creates anything; GetLobby()/GetSpawnCFrame() just read back
-- what was built. No server-side dependencies (see DESIGN.md's dependency graph).

local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local LobbyBuilder = {}

----------------------------------------------------------------------------------------------------
-- Types (mirrors DESIGN.md section 5)
----------------------------------------------------------------------------------------------------
export type PadGui = { Count: TextLabel, Title: TextLabel, Status: TextLabel, Privacy: TextLabel }
export type PadInfo = {
	Id: number,
	Model: Model,
	Zone: BasePart,
	Floor: BasePart,
	Inside: CFrame,
	Exit: CFrame,
	Barriers: { BasePart },
	Gui: PadGui,
}
export type BoardPage = { Title: TextLabel, List: ScrollingFrame }
-- Pages: one per level on a paged board (the Fastest Clean board); each client flips them locally
-- with the arrows (tag "BoardArrow"), so nobody changes the page for anyone else.
export type BoardInfo = { Part: BasePart, Title: TextLabel, List: ScrollingFrame, Pages: { BoardPage }? }
export type Lobby = {
	Model: Model,
	Pads: { PadInfo },
	Boards: { Times: BoardInfo, Dishes: BoardInfo },
}

----------------------------------------------------------------------------------------------------
-- Layout constants
----------------------------------------------------------------------------------------------------
local ORIGIN = Config.World.LobbyOrigin

local PLAZA_X = 96 -- plaza spans X -96..96
local PLAZA_Z0, PLAZA_Z1 = -100, 64
local FLOOR_Y = 0.2 -- top of the plaza tiles
local FENCE_MARGIN = 3

local SPAWN = Vector3.new(0, 0, 36)

local PAD_COUNT = Config.Party.PadCount
local PAD_RADIUS = 9
local PAD_X = 60
local PAD_Z = { -34, -6, 22 }
local PAD_WALL_HEIGHT = 8

local HATCHERY_Z = -76 -- front face of the dishwasher building (it faces +Z, toward the spawn)
local EGG_Z = -66
local SHOP_X = -40
local PETSTAND_X = 40

-- Colors
local WOOD_A = Color3.fromRGB(196, 146, 98) -- table-top planks
local WOOD_B = Color3.fromRGB(184, 134, 88)
local WOOD_DARK = Color3.fromRGB(128, 86, 56)
local CLOTH_RED = Color3.fromRGB(214, 70, 72)
local CLOTH_WHITE = Color3.fromRGB(250, 246, 238)
local ROOM_WALL = Color3.fromRGB(236, 222, 196)
local ROOM_FLOOR = Color3.fromRGB(150, 104, 70)
local LOW = Enum.Material.SmoothPlastic -- the lobby is flat-shaded, low-poly style

local function shadeColor(c: Color3, f: number): Color3
	return Color3.new(c.R * f, c.G * f, c.B * f)
end

-- The plaza is the top of a giant dining table; the room around it (floor far below).
local TABLE_MARGIN = 16 -- table top overhang past the plaza
local ROOM_FLOOR_Y = -130
local ROOM_X = 420
local ROOM_Z0, ROOM_Z1 = -560, 400
local ROOM_TOP = 330
local NAVY = Color3.fromRGB(18, 55, 100)

----------------------------------------------------------------------------------------------------
-- Build bookkeeping: yield every ~200 parts so the server never hitches.
----------------------------------------------------------------------------------------------------
local lobby: Lobby? = nil
local southWall: BasePart? = nil -- the table's south edge wall (opened while the obby stands)
local partsBuilt = 0

local function maybeYield()
	partsBuilt += 1
	if partsBuilt % 200 == 0 then
		task.wait()
	end
end

-- Creates a BasePart (or SpawnLocation), applies props, parents last, and counts toward the budget.
local function mkPart(className: string, props: { [string]: any }, parent: Instance): BasePart
	local inst = Instance.new(className) :: BasePart
	inst.Anchored = true
	if props.CanCollide == nil then
		inst.CanCollide = true
	end
	if props.CanTouch == nil then
		inst.CanTouch = false
	end
	inst.TopSurface = Enum.SurfaceType.Smooth
	inst.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in props do
		(inst :: any)[k] = v
	end
	-- Solid, visible scenery is queryable so the camera bumps into it instead of clipping through.
	if props.CanQuery == nil then
		inst.CanQuery = inst.CanCollide and inst.Transparency &lt; 0.25
	end
	inst.Parent = parent
	maybeYield()
	return inst :: BasePart
end

-- Non-part instances (GUIs, lights, particles, models, folders...).
local function mk(className: string, props: { [string]: any }?, parent: Instance?): Instance
	local inst = Instance.new(className)
	if props then
		for k, v in props do
			(inst :: any)[k] = v
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

local function at(x: number, y: number, z: number): CFrame
	return CFrame.new(ORIGIN.X + x, ORIGIN.Y + y, ORIGIN.Z + z)
end

-- Upright cylinder (axis = Y).
local function upright(x: number, y: number, z: number): CFrame
	return at(x, y, z) * CFrame.Angles(0, 0, math.rad(90))
end

local function decor(props: { [string]: any }): { [string]: any }
	props.CanCollide = false
	props.CastShadow = if props.CastShadow == nil then true else props.CastShadow
	return props
end

-- A world-sized floating sign (scales with distance like a real object; never fills the screen).
-- It hangs off its own unrotated, invisible anchor part placed `offsetY` above `parent`: cylinders
-- are rotated 90 degrees internally, and a BillboardGui's offset follows that rotation, which is
-- what used to push signs sideways into the floor.
local function worldSign(parent: BasePart, text: string, width: number, height: number, offsetY: number, color: Color3?): TextLabel
	local anchor = Instance.new("Part")
	anchor.Name = "SignAnchor"
	anchor.Size = Vector3.new(0.2, 0.2, 0.2)
	anchor.CFrame = CFrame.new(parent.Position + Vector3.new(0, offsetY, 0))
	anchor.Transparency = 1
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.CastShadow = false
	anchor.Parent = parent.Parent
	local gui = mk("BillboardGui", {
		Name = "Sign",
		Size = UDim2.fromScale(width, height),
		LightInfluence = 0,
		MaxDistance = 140,
		AlwaysOnTop = false,
	}, anchor)
	local label = mk("TextLabel", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = text,
		Font = Enum.Font.LuckiestGuy,
		TextScaled = true,
		TextColor3 = color or Color3.new(1, 1, 1),
	}, gui) :: TextLabel
	mk("UIStroke", { Thickness = 3, Color = Color3.fromRGB(12, 30, 60) }, label)
	return label
end

----------------------------------------------------------------------------------------------------
-- The dining room around the table: panelling, curtains, pictures, a fireplace, a bookcase, a sofa,
-- ceiling beams and plants. Everything that meets a wall or the floor overlaps into it (never a
-- face flush with another face), so nothing z-fights.
----------------------------------------------------------------------------------------------------
local function buildHouseDetail(parent: Instance, box: (string, number, number, number, number, number, number, Color3, { [string]: any }?) -&gt; BasePart)
	local fy = ROOM_FLOOR_Y
	local white = Color3.fromRGB(250, 248, 242)
	local panel = Color3.fromRGB(222, 206, 178)
	local trim = Color3.fromRGB(244, 238, 226)
	local nc = { CanCollide = false, CastShadow = false }
	local winY0, winY1 = fy + 110, fy + 380
	local IN = 2 -- walls are 4 thick, centred on the room edge: inner faces are 2 in

	-- Floorboards: slightly darker seams (the rug covers the middle).
	for x = -ROOM_X + 40, ROOM_X - 40, 40 do
		box("FloorSeam", x - 0.6, x + 0.6, fy - 1, fy + 0.25, ROOM_Z0 + IN, ROOM_Z1 - IN, Color3.fromRGB(128, 86, 56), nc)
	end

	-- Window positions (the same maths as the walls): 3 per wall.
	local function spots(a0: number, a1: number): { number }
		local winW = 120
		local gap = (a1 - a0 - 3 * winW) / 4
		return { a0 + gap, a0 + 2 * gap + winW, a0 + 3 * gap + 2 * winW }
	end

	-- Along one wall. `along(a0, a1, y0, y1, d0, d1)` makes a box spanning a0..a1 along the wall,
	-- y0..y1 up, d0..d1 in from the wall's inner face.
	local function dress(along: (string, number, number, number, number, number, number, Color3, { [string]: any }?) -&gt; (), a0: number, a1: number)
		-- wainscot (dado) panelling with a chair rail and raised panels
		along("Wainscot", a0, a1, fy + 6, fy + 100, -0.5, 1.5, panel)
		along("ChairRail", a0 + 0.3, a1 - 0.3, fy + 98, fy + 105, -0.8, 3, trim)
		local n = math.floor((a1 - a0) / 60)
		local step = (a1 - a0) / n
		for k = 0, n - 1 do
			local c = a0 + step * (k + 0.5)
			along("Panel", c - step / 2 + 7, c + step / 2 - 7, fy + 20, fy + 88, 1, 2.2, Color3.fromRGB(232, 218, 192))
		end
		-- crown moulding under the ceiling
		along("Crown", a0 + 0.6, a1 - 0.6, ROOM_TOP - 12, ROOM_TOP + 1, -1.1, 4, trim)
		-- curtains and rods at each window
		for _, w0 in spots(a0, a1) do
			local w1 = w0 + 120
			along("CurtainRod", w0 - 40, w1 + 40, winY1 + 16, winY1 + 20, 8, 12, Color3.fromRGB(150, 110, 60), nc)
			for _, e in { { w0 - 36, w0 - 4 }, { w1 + 4, w1 + 36 } } do
				along("Curtain", e[1], e[2], winY0 - 30, winY1 + 16, 6, 12, Color3.fromRGB(176, 60, 64), nc)
				along("CurtainTie", e[1] - 1, e[2] + 1, winY0 + 60, winY0 + 68, 5, 13, Color3.fromRGB(236, 196, 96), nc)
			end
		end
	end
	-- back and front walls (along X)
	for _, zw in { ROOM_Z0, ROOM_Z1 } do
		local inward = if zw &lt; 0 then 1 else -1
		local face = zw + inward * IN
		dress(function(name, a0, a1, y0, y1, d0, d1, color, extra)
			box(name, a0, a1, y0, y1, face + inward * d0, face + inward * d1, color, extra)
		end, -ROOM_X + IN, ROOM_X - IN)
	end
	-- side walls (along Z)
	for _, xw in { -ROOM_X, ROOM_X } do
		local inward = if xw &lt; 0 then 1 else -1
		local face = xw + inward * IN
		dress(function(name, a0, a1, y0, y1, d0, d1, color, extra)
			box(name, face + inward * d0, face + inward * d1, y0, y1, a0, a1, color, extra)
		end, ROOM_Z0 + IN, ROOM_Z1 - IN)
	end

	-- Pictures between the windows on the back wall (frame, mat, painting: each proud of the last).
	local backFace = ROOM_Z0 + IN
	local paintings = {
		{ -120, Color3.fromRGB(90, 150, 210), Color3.fromRGB(120, 190, 110) }, -- hills
		{ 120, Color3.fromRGB(250, 190, 110), Color3.fromRGB(230, 120, 90) }, -- sunset
	}
	for _, pnt in paintings do
		local cx = pnt[1]
		box("PictureFrame", cx - 40, cx + 40, fy + 190, fy + 290, backFace - 0.5, backFace + 3, Color3.fromRGB(160, 116, 60))
		box("PictureMat", cx - 33, cx + 33, fy + 197, fy + 283, backFace + 2, backFace + 3.6, white)
		box("PictureSky", cx - 28, cx + 28, fy + 230, fy + 278, backFace + 3, backFace + 4.2, pnt[2])
		box("PictureLand", cx - 28, cx + 28, fy + 202, fy + 231, backFace + 3, backFace + 4.4, pnt[3])
	end

	-- Fireplace on the left wall, between the first two windows.
	local lf = -ROOM_X + IN
	local fz0, fz1 = -275, -155
	box("ChimneyBreast", lf - 1.4, lf + 30, fy - 0.6, ROOM_TOP + 1.3, fz0, fz1, Color3.fromRGB(200, 120, 96))
	box("Hearth", lf + 28.4, lf + 60, fy - 1, fy + 6, fz0 - 10, fz1 + 10, Color3.fromRGB(120, 120, 128))
	box("FireSurround", lf + 29, lf + 40, fy + 4, fy + 120, fz0 - 6, fz1 + 6, white)
	box("Mantel", lf + 28, lf + 50, fy + 118, fy + 128, fz0 - 14, fz1 + 14, Color3.fromRGB(150, 104, 70))
	box("Firebox", lf + 36, lf + 41, fy + 6, fy + 80, fz0 + 18, fz1 - 18, Color3.fromRGB(34, 30, 30))
	for i, c in { Color3.fromRGB(255, 150, 40), Color3.fromRGB(255, 210, 90) } do
		local flame = box("Flame", lf + 41.5 - i, lf + 43.5 - i, fy + 8, fy + 40 - i * 8, fz0 + 34 + i * 8, fz1 - 34 - i * 8, c, { CanCollide = false, CastShadow = false, Material = Enum.Material.Neon })
		if i == 1 then
			mk("PointLight", { Range = 50, Brightness = 1.2, Color = Color3.fromRGB(255, 170, 90), Shadows = false }, flame)
		end
	end
	box("Log", lf + 41, lf + 49, fy + 6, fy + 14, fz0 + 26, fz1 - 26, Color3.fromRGB(110, 70, 40))
	-- a clock and two candlesticks on the mantel
	box("MantelClock", lf + 32, lf + 46, fy + 128, fy + 158, -222, -208, Color3.fromRGB(120, 80, 50))
	box("ClockFace", lf + 46, lf + 47, fy + 134, fy + 152, -220, -210, white)
	for _, cz in { fz0 + 4, fz1 - 4 } do
		box("Candlestick", lf + 36, lf + 42, fy + 128, fy + 134, cz - 3, cz + 3, Color3.fromRGB(236, 196, 96))
		box("Candle", lf + 37.5, lf + 40.5, fy + 134, fy + 150, cz - 1.5, cz + 1.5, white)
	end

	-- Bookcase on the right wall, between the first two windows.
	local rf = ROOM_X - IN
	local bz0, bz1 = -270, -160
	local wood = Color3.fromRGB(120, 80, 50)
	box("Bookcase", rf - 40, rf + 1.3, fy - 0.4, fy + 250, bz0, bz1, wood)
	local bookColors = { Color3.fromRGB(200, 60, 60), Color3.fromRGB(60, 110, 190), Color3.fromRGB(240, 200, 80), Color3.fromRGB(80, 160, 100), Color3.fromRGB(150, 90, 170), Color3.fromRGB(230, 130, 60) }
	for shelf = 0, 4 do
		local y0 = fy + 14 + shelf * 46
		box("BookShelfBack", rf - 38, rf - 36, y0, y0 + 40, bz0 + 6, bz1 - 6, Color3.fromRGB(90, 60, 38))
		local z = bz0 + 8
		local k = shelf * 3
		while z &lt; bz1 - 14 do
			k += 1
			local thick = 5 + (k * 7) % 5
			local tall = 26 + (k * 11) % 12
			box("Book", rf - 44, rf - 36.5, y0, y0 + tall, z, z + thick, bookColors[(k % #bookColors) + 1])
			z += thick + 0.6
		end
	end

	-- A sofa by the front wall, facing the table, with cushions.
	local sz0 = ROOM_Z1 - IN - 64
	local sofa = Color3.fromRGB(90, 130, 110)
	box("SofaBase", -130, 130, fy, fy + 42, sz0, sz0 + 60, sofa)
	box("SofaBack", -130, 130, fy + 40, fy + 100, sz0 + 42, sz0 + 61.4, sofa)
	for _, sx in { -1, 1 } do
		box("SofaArm", sx * 130 - 12, sx * 130 + 12, fy, fy + 66, sz0 - 2, sz0 + 62, Color3.fromRGB(80, 118, 100))
	end
	for i = -1, 1 do
		box("SofaCushion", i * 80 - 38, i * 80 + 38, fy + 41, fy + 52, sz0 + 2, sz0 + 42, Color3.fromRGB(110, 152, 130))
	end
	box("Pillow", -100, -70, fy + 50, fy + 78, sz0 + 32, sz0 + 41.2, Color3.fromRGB(236, 196, 96))
	box("Pillow", 70, 100, fy + 50, fy + 78, sz0 + 32, sz0 + 41.2, Color3.fromRGB(200, 90, 90))

	-- Ceiling beams (they sink into the ceiling a little).
	for _, bz in { -330, -80, 170 } do
		box("CeilingBeam", -ROOM_X + IN + 1.5, ROOM_X - IN - 1.5, ROOM_TOP - 14, ROOM_TOP + 1.7, bz - 9, bz + 9, Color3.fromRGB(150, 104, 70))
	end

	-- Potted plants in the corners.
	for _, c in { { -370, -510 }, { 370, -510 }, { -370, 350 }, { 370, 350 } } do
		local px, pz = c[1], c[2]
		box("PlantPot", px - 18, px + 18, fy, fy + 40, pz - 18, pz + 18, Color3.fromRGB(190, 110, 70))
		box("PlantSoil", px - 15, px + 15, fy + 38, fy + 40.6, pz - 15, pz + 15, Color3.fromRGB(80, 56, 40))
		for i, leaf in { { 0, 70, 0, 44 }, { -14, 56, 8, 30 }, { 14, 60, -8, 30 }, { 4, 92, 4, 28 } } do
			mkPart("Part", {
				Name = "PlantLeaves",
				Shape = Enum.PartType.Ball,
				Size = Vector3.new(leaf[4], leaf[4], leaf[4]),
				CFrame = at(px + leaf[1], fy + leaf[2], pz + leaf[3]),
				Color = if i % 2 == 0 then Color3.fromRGB(70, 150, 80) else Color3.fromRGB(90, 170, 90),
				Material = LOW,
				CanCollide = false,
			}, parent)
		end
	end
end

----------------------------------------------------------------------------------------------------
-- Ground: the plaza is the top of a giant wooden dining table (planks, a checked runner down the
-- middle), with invisible walls at its edges. The table stands in a dining room (buildRoom).
----------------------------------------------------------------------------------------------------
local function buildGround(parent: Instance)
	-- Safety floor just under the table top (invisible), so nothing ever falls through.
	mkPart("Part", {
		Name = "SafetyFloor",
		Size = Vector3.new(PLAZA_X * 2 + TABLE_MARGIN * 2, 2, PLAZA_Z1 - PLAZA_Z0 + TABLE_MARGIN * 2),
		CFrame = at(0, -3, (PLAZA_Z0 + PLAZA_Z1) / 2),
		Transparency = 1,
		CastShadow = false,
	}, parent)

	-- Table top: planks running along X, alternating two wood tones, over a thick slab.
	local x0, x1 = -PLAZA_X - TABLE_MARGIN, PLAZA_X + TABLE_MARGIN
	local z0, z1 = PLAZA_Z0 - TABLE_MARGIN, PLAZA_Z1 + TABLE_MARGIN
	mkPart("Part", {
		Name = "TableSlab",
		Size = Vector3.new(x1 - x0, 6, z1 - z0),
		CFrame = at(0, -3.2, (z0 + z1) / 2),
		Color = WOOD_DARK,
		Material = LOW,
	}, parent)
	local plank = 14
	local i = 0
	for z = z0, z1 - 0.01, plank do
		local zEnd = math.min(z + plank, z1)
		mkPart("Part", {
			Name = "Plank",
			Size = Vector3.new(x1 - x0, 0.4, zEnd - z - 0.3),
			CFrame = at(0, FLOOR_Y - 0.2, (z + zEnd) / 2),
			Color = if i % 2 == 0 then WOOD_A else WOOD_B,
			Material = LOW,
		}, parent)
		i += 1
	end
	-- Low-poly chamfer along the table's edges (wedges sloping down and out).
	for _, side in { -1, 1 } do
		mkPart("Part", {
			Name = "Chamfer",
			Size = Vector3.new(x1 - x0, 2, 2),
			CFrame = at(0, -1, if side &lt; 0 then z0 - 1 else z1 + 1) * CFrame.Angles(0, if side &lt; 0 then 0 else math.pi, 0),
			Color = WOOD_DARK,
			Material = LOW,
		}, parent)
		mkPart("Part", {
			Name = "Chamfer",
			Size = Vector3.new(z1 - z0, 2, 2),
			CFrame = at(if side &lt; 0 then x0 - 1 else x1 + 1, -1, (z0 + z1) / 2) * CFrame.Angles(0, if side &lt; 0 then -math.pi / 2 else math.pi / 2, 0),
			Color = WOOD_DARK,
			Material = LOW,
		}, parent)
	end
	-- Checked runner (the path) from the spawn to the dishwasher building.
	local cell = 7
	local rz0, rz1 = HATCHERY_Z + 2, SPAWN.Z - 14
	local row = 0
	for z = rz0, rz1 - cell, cell do
		for col = 0, 1 do
			mkPart("Part", {
				Name = "Runner",
				Size = Vector3.new(cell, 0.1, cell),
				CFrame = at(-cell / 2 + col * cell, FLOOR_Y + 0.05, z + cell / 2),
				Color = if (row + col) % 2 == 0 then CLOTH_RED else CLOTH_WHITE,
				Material = LOW,
				CanCollide = false,
				CastShadow = false,
			}, parent)
		end
		row += 1
	end

	-- Invisible walls at the plaza edges (nobody falls off the table).
	local fx0, fx1 = -PLAZA_X - FENCE_MARGIN, PLAZA_X + FENCE_MARGIN
	local fz0, fz1 = PLAZA_Z0 - FENCE_MARGIN, PLAZA_Z1 + FENCE_MARGIN
	local h = 80
	local w = 4
	for _, spec: { any } in {
		{ Vector3.new(fx1 - fx0 + w * 2, h, w), at(0, h / 2, fz0 - w / 2) },
		{ Vector3.new(fx1 - fx0 + w * 2, h, w), at(0, h / 2, fz1 + w / 2), true },
		{ Vector3.new(w, h, fz1 - fz0), at(fx0 - w / 2, h / 2, (fz0 + fz1) / 2) },
		{ Vector3.new(w, h, fz1 - fz0), at(fx1 + w / 2, h / 2, (fz0 + fz1) / 2) },
	} do
		local wall = mkPart("Part", { Name = "Barrier", Size = spec[1], CFrame = spec[2], Transparency = 1, CastShadow = false }, parent)
		if spec[3] then
			southWall = wall -- opened while the obby stands (see OpenObby)
		end
	end
end

-- The dining room around the table: legs down to a floor far below, giant chairs, a sideboard, a
-- pendant lamp, and walls with big windows looking out at the back garden (buildGarden).
-- Walls and ceiling cast no shadows, so daylight still fills the room.
local function buildRoom(parent: Instance)
	local fy = ROOM_FLOOR_Y
	local shadowless = { CastShadow = false }
	local function box(name: string, ax0: number, ax1: number, ay0: number, ay1: number, az0: number, az1: number, color: Color3, extra: { [string]: any }?)
		local props: { [string]: any } = {
			Name = name,
			Size = Vector3.new(math.abs(ax1 - ax0), math.abs(ay1 - ay0), math.abs(az1 - az0)),
			CFrame = at((ax0 + ax1) / 2, (ay0 + ay1) / 2, (az0 + az1) / 2),
			Color = color,
			Material = LOW,
		}
		if extra then
			for k, v in extra do
				props[k] = v
			end
		end
		return mkPart("Part", props, parent)
	end

	-- Table legs (chunky, low-poly: a square leg with a wider foot and a collar).
	local tx0, tx1 = -PLAZA_X - TABLE_MARGIN, PLAZA_X + TABLE_MARGIN
	local tz0, tz1 = PLAZA_Z0 - TABLE_MARGIN, PLAZA_Z1 + TABLE_MARGIN
	box("TableApron", tx0 + 6, tx1 - 6, -16, -6.2, tz0 + 6, tz1 - 6, WOOD_DARK)
	for _, lx in { tx0 + 14, tx1 - 14 } do
		for _, lz in { tz0 + 14, tz1 - 14 } do
			box("TableLeg", lx - 8, lx + 8, fy, -16, lz - 8, lz + 8, WOOD_DARK)
			box("LegCollar", lx - 10, lx + 10, -30, -24, lz - 10, lz + 10, WOOD_A)
			box("LegFoot", lx - 10, lx + 10, fy, fy + 8, lz - 10, lz + 10, WOOD_A)
		end
	end

	-- Floor, walls with windows, ceiling.
	box("RoomFloor", -ROOM_X, ROOM_X, fy - 4, fy, ROOM_Z0, ROOM_Z1, ROOM_FLOOR)
	box("Rug", -200, 200, fy, fy + 0.9, -330, 170, Color3.fromRGB(70, 110, 150), { CanCollide = false })
	box("RugBorder", -210, 210, fy - 0.1, fy + 0.5, -340, 180, Color3.fromRGB(240, 200, 110), { CanCollide = false })
	box("Ceiling", -ROOM_X, ROOM_X, ROOM_TOP, ROOM_TOP + 4, ROOM_Z0, ROOM_Z1, Color3.fromRGB(250, 246, 238), shadowless)

	local winY0, winY1 = fy + 110, fy + 380
	-- A wall along X at z (from x = -ROOM_X to ROOM_X) with `n` windows.
	local function wallX(z: number, n: number)
		local span = ROOM_X * 2
		local winW = 120
		local gap = (span - n * winW) / (n + 1)
		box("Wall", -ROOM_X, ROOM_X, fy, winY0, z - 2, z + 2, ROOM_WALL, shadowless)
		box("Wall", -ROOM_X, ROOM_X, winY1, ROOM_TOP, z - 2, z + 2, ROOM_WALL, shadowless)
		box("Skirting", -ROOM_X - 1, ROOM_X + 1, fy, fy + 10, z - 3, z + 3, Color3.fromRGB(255, 255, 255), shadowless)
		local x = -ROOM_X
		for k = 0, n do
			box("Wall", x, x + gap, winY0, winY1, z - 2, z + 2, ROOM_WALL, shadowless)
			x += gap
			if k &lt; n then
				box("WindowSill", x - 6, x + winW + 6, winY0 - 6, winY0 + 0.4, z - 8, z + 8, Color3.fromRGB(255, 255, 255), shadowless)
				box("WindowBar", x + winW / 2 - 2, x + winW / 2 + 2, winY0 - 1, winY1 + 1, z - 1, z + 1, Color3.fromRGB(255, 255, 255), { CanCollide = false, CastShadow = false })
				box("WindowBar", x - 1, x + winW + 1, (winY0 + winY1) / 2 - 2, (winY0 + winY1) / 2 + 2, z - 1, z + 1, Color3.fromRGB(255, 255, 255), { CanCollide = false, CastShadow = false })
				box("WindowGlass", x, x + winW, winY0, winY1, z - 0.3, z + 0.3, Color3.fromRGB(200, 230, 255), { Transparency = 0.85, Material = Enum.Material.Glass, CastShadow = false })
				x += winW
			end
		end
	end
	local function wallZ(xw: number, n: number)
		local span = ROOM_Z1 - ROOM_Z0
		local winW = 120
		local gap = (span - n * winW) / (n + 1)
		box("Wall", xw - 2, xw + 2, fy, winY0, ROOM_Z0, ROOM_Z1, ROOM_WALL, shadowless)
		box("Wall", xw - 2, xw + 2, winY1, ROOM_TOP, ROOM_Z0, ROOM_Z1, ROOM_WALL, shadowless)
		box("Skirting", xw - 3, xw + 3, fy, fy + 10, ROOM_Z0 - 1, ROOM_Z1 + 1, Color3.fromRGB(255, 255, 255), shadowless)
		local z = ROOM_Z0
		for k = 0, n do
			box("Wall", xw - 2, xw + 2, winY0, winY1, z, z + gap, ROOM_WALL, shadowless)
			z += gap
			if k &lt; n then
				box("WindowSill", xw - 8, xw + 8, winY0 - 6, winY0 + 0.4, z - 6, z + winW + 6, Color3.fromRGB(255, 255, 255), shadowless)
				box("WindowBar", xw - 1, xw + 1, winY0 - 1, winY1 + 1, z + winW / 2 - 2, z + winW / 2 + 2, Color3.fromRGB(255, 255, 255), { CanCollide = false, CastShadow = false })
				box("WindowBar", xw - 1, xw + 1, (winY0 + winY1) / 2 - 2, (winY0 + winY1) / 2 + 2, z - 1, z + winW + 1, Color3.fromRGB(255, 255, 255), { CanCollide = false, CastShadow = false })
				box("WindowGlass", xw - 0.3, xw + 0.3, winY0, winY1, z, z + winW, Color3.fromRGB(200, 230, 255), { Transparency = 0.85, Material = Enum.Material.Glass, CastShadow = false })
				z += winW
			end
		end
	end
	wallX(ROOM_Z0, 3)
	wallX(ROOM_Z1, 3)
	wallZ(-ROOM_X, 3)
	wallZ(ROOM_X, 3)

	-- Giant chairs around the table: seat below the table top, tall back rising above it.
	local function chair(cx: number, cz: number, faceX: number, faceZ: number)
		-- (faceX, faceZ): unit direction from the chair toward the table.
		local seatY = -48
		local half = 38
		mkPart("Part", { Name = "ChairSeat", Size = Vector3.new(half * 2, 8, half * 2), CFrame = at(cx, seatY, cz), Color = WOOD_A, Material = LOW }, parent)
		mkPart("Part", { Name = "ChairCushion", Size = Vector3.new(half * 2 - 10, 3, half * 2 - 10), CFrame = at(cx, seatY + 5.5, cz), Color = CLOTH_RED, Material = LOW }, parent)
		local bx, bz = cx - faceX * (half - 4), cz - faceZ * (half - 4)
		local sx = if faceX ~= 0 then 8 else half * 2
		local sz = if faceZ ~= 0 then 8 else half * 2
		mkPart("Part", { Name = "ChairBack", Size = Vector3.new(sx, 110, sz), CFrame = at(bx, seatY + 59, bz), Color = WOOD_A, Material = LOW }, parent)
		-- The rail overhangs the back a little (side-by-side chairs stay well apart now).
		mkPart("Part", { Name = "ChairTopRail", Size = Vector3.new(if faceX ~= 0 then sx + 4 else sx + 2, 10, if faceZ ~= 0 then sz + 4 else sz + 2), CFrame = at(bx, seatY + 116, bz), Color = WOOD_DARK, Material = LOW }, parent)
		for _, dx in { -half + 5, half - 5 } do
			for _, dz in { -half + 5, half - 5 } do
				mkPart("Part", { Name = "ChairLeg", Size = Vector3.new(7, seatY - 4 - fy, 7), CFrame = at(cx + dx, (fy + seatY - 4) / 2, cz + dz), Color = WOOD_DARK, Material = LOW }, parent)
			end
		end
	end
	for _, cz in { -68, 28 } do
		chair(tx0 - 52, cz, 1, 0)
		chair(tx1 + 52, cz, -1, 0)
	end
	chair(0, tz0 - 52, 0, 1)

	-- Sideboard against the back wall with a stack of plates and a vase.
	box("Sideboard", -150, 150, fy, fy + 90, ROOM_Z0 + 4, ROOM_Z0 + 60, WOOD_DARK)
	box("SideboardTop", -156, 156, fy + 90, fy + 96, ROOM_Z0 + 2, ROOM_Z0 + 64, WOOD_A)
	for i = -2, 2 do
		box("SideboardDoor", i * 58 - 26, i * 58 + 26, fy + 12, fy + 82, ROOM_Z0 + 60, ROOM_Z0 + 62, WOOD_A)
		box("SideboardKnob", i * 58 - 2, i * 58 + 2, fy + 48, fy + 54, ROOM_Z0 + 62, ROOM_Z0 + 64, Color3.fromRGB(240, 200, 110))
	end

	-- Pendant lamp over the table (hexagonal-ish shade from two boxes, glowing bulb).
	local lampY = 150
	box("LampCord", -1, 1, lampY + 20, ROOM_TOP, -19, -17, Color3.fromRGB(40, 40, 44), { CanCollide = false })
	for k = 0, 2 do
		mkPart("Part", {
			Name = "LampShade",
			Size = Vector3.new(60, 20, 26),
			CFrame = at(0, lampY + 10, -18) * CFrame.Angles(0, k * math.pi / 3, 0),
			Color = Color3.fromRGB(60, 120, 110),
			Material = LOW,
			CanCollide = false,
			CastShadow = false,
		}, parent)
	end
	local bulb = mkPart("Part", { Name = "LampBulb", Shape = Enum.PartType.Ball, Size = Vector3.new(16, 16, 16), CFrame = at(0, lampY - 2, -18), Color = Color3.fromRGB(255, 240, 200), Material = Enum.Material.Neon, CanCollide = false, CastShadow = false }, parent)
	mk("PointLight", { Range = 60, Brightness = 0.6, Color = Color3.fromRGB(255, 230, 190), Shadows = false }, bulb)

	buildHouseDetail(parent, box)
end

----------------------------------------------------------------------------------------------------
-- Spawn: built FIRST so a player who spawns mid-build has a floor.
----------------------------------------------------------------------------------------------------
local function buildSpawn(parent: Instance)
	-- A stepped round platform: navy base, marble top, the game's emblem on it, and four bubble
	-- lamps around the edge. No two faces share a plane.
	mkPart("Part", {
		Name = "SpawnBase",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.7, 28, 28),
		CFrame = upright(SPAWN.X, 0.45, SPAWN.Z),
		Color = Color3.fromRGB(38, 78, 128),
		Material = Enum.Material.SmoothPlastic,
	}, parent)
	mkPart("Part", {
		Name = "SpawnTop",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.5, 24, 24),
		CFrame = upright(SPAWN.X, 0.9, SPAWN.Z),
		Color = Color3.fromRGB(236, 240, 244),
		Material = Enum.Material.Marble,
	}, parent)
	local emblem = mkPart("Part", {
		Name = "SpawnEmblem",
		Size = Vector3.new(18, 0.05, 18),
		-- A Top-face SurfaceGui's "up" is the part's -X, so turn the part a quarter so the text reads
		-- left-to-right for someone who just spawned (facing -Z, camera behind them).
		CFrame = at(SPAWN.X, 1.2, SPAWN.Z) * CFrame.Angles(0, -math.pi / 2, 0),
		Transparency = 1,
		CanCollide = false,
		CastShadow = false,
	}, parent)
	local gui = mk("SurfaceGui", { Face = Enum.NormalId.Top, CanvasSize = Vector2.new(600, 600), LightInfluence = 0.3 }, emblem)
	local circle = mk("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.96, 0.96),
		BackgroundColor3 = Color3.fromRGB(120, 200, 250),
		BackgroundTransparency = 0.35,
	}, gui)
	mk("UICorner", { CornerRadius = UDim.new(0.5, 0) }, circle)
	mk("UIStroke", { Thickness = 10, Color = Color3.fromRGB(255, 255, 255) }, circle)
	local title = mk("TextLabel", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.8, 0.36),
		BackgroundTransparency = 1,
		Text = string.upper(Config.GameName),
		Font = Enum.Font.LuckiestGuy,
		TextScaled = true,
		TextColor3 = Color3.new(1, 1, 1),
	}, gui)
	mk("UIStroke", { Thickness = 6, Color = Color3.fromRGB(20, 60, 110) }, title)
	for i = 1, 4 do
		local a = (i - 0.5) / 4 * math.pi * 2
		local px, pz = SPAWN.X + math.cos(a) * 12.5, SPAWN.Z + math.sin(a) * 12.5
		mkPart("Part", { Name = "LampPost", Shape = Enum.PartType.Cylinder, Size = Vector3.new(3, 0.8, 0.8), CFrame = upright(px, 2.3, pz), Color = Color3.fromRGB(230, 234, 240), Material = Enum.Material.Metal }, parent)
		local bulb = mkPart("Part", decor({ Name = "Bubble", Shape = Enum.PartType.Ball, Size = Vector3.new(2, 2, 2), CFrame = at(px, 4.6, pz), Color = if i % 2 == 0 then Color3.fromRGB(150, 220, 255) else Color3.fromRGB(255, 170, 215), Material = Enum.Material.Neon, Transparency = 0.2 }), parent)
		mk("PointLight", { Range = 12, Brightness = 0.8, Color = bulb.Color }, bulb)
	end
	for i = 1, 4 do
		local angle = (i - 1) / 4 * math.pi * 2 + math.pi / 4
		local pos = Vector3.new(SPAWN.X + math.cos(angle) * 6, 1.8, SPAWN.Z + math.sin(angle) * 6)
		mkPart("SpawnLocation", {
			Name = "Spawn" .. i,
			Size = Vector3.new(5, 1, 5),
			CFrame = at(pos.X, pos.Y, pos.Z),
			Neutral = true,
			Duration = 0,
			Transparency = 1,
			CanCollide = false,
		}, parent)
	end
end

-- The back garden seen through the windows: a lawn level with the room floor, a paved patio, a
-- wooden fence all round, low-poly trees and hedges. All plain parts (no Terrain), so nothing can
-- ever pop up on the table, and nothing unrealistic (no mountains) sits on the horizon.
local function buildGarden(parent: Instance)
	local fy = ROOM_FLOOR_Y
	local GX0, GX1 = -ROOM_X - 260, ROOM_X + 260
	local GZ0, GZ1 = ROOM_Z0 - 260, ROOM_Z1 + 260
	local lawn = Color3.fromRGB(110, 170, 90)
	-- The lawn runs far past the fence so the horizon is always grass, never empty sky.
	mkPart("Part", { Name = "Lawn", Size = Vector3.new(4000, 4, 4000), CFrame = at(0, fy - 2.6, (GZ0 + GZ1) / 2), Color = lawn, Material = LOW, CastShadow = false }, parent)
	mkPart("Part", { Name = "Patio", Size = Vector3.new(360, 1, 120), CFrame = at(0, fy - 0.9, ROOM_Z1 + 64), Color = Color3.fromRGB(200, 190, 175), Material = LOW }, parent)

	-- Fence: posts every 30 studs with two rails, along all four sides.
	local fenceColor = Color3.fromRGB(176, 128, 86)
	local function run(x0: number, z0: number, x1: number, z1: number)
		local len = math.max(math.abs(x1 - x0), math.abs(z1 - z0))
		local alongX = math.abs(x1 - x0) &gt; math.abs(z1 - z0)
		for _, y in { 22, 44 } do
			mkPart("Part", { Name = "FenceRail", Size = if alongX then Vector3.new(len, 5, 2) else Vector3.new(2, 5, len), CFrame = at((x0 + x1) / 2, fy + y, (z0 + z1) / 2), Color = fenceColor, Material = LOW, CastShadow = false }, parent)
		end
		local n = math.floor(len / 30)
		for i = 0, n do
			local t = i / n
			mkPart("Part", { Name = "FencePost", Size = Vector3.new(4, 56, 4), CFrame = at(x0 + (x1 - x0) * t, fy + 28, z0 + (z1 - z0) * t), Color = shadeColor(fenceColor, 0.85), Material = LOW, CastShadow = false }, parent)
		end
	end
	local fx0, fx1, fz0, fz1 = GX0 + 40, GX1 - 40, GZ0 + 40, GZ1 - 40
	run(fx0, fz0, fx1, fz0)
	run(fx0, fz1, fx1, fz1)
	run(fx0, fz0, fx0, fz1)
	run(fx1, fz0, fx1, fz1)

	-- Low-poly trees: a hexagonal trunk and a stack of turned, faceted canopy blocks.
	local rng = Random.new(21)
	local function treeAt(x: number, z: number, scale: number)
		local trunkH = 70 * scale
		local tr = 9 * scale
		local side = tr / math.sqrt(3)
		for k = 0, 2 do
			mkPart("Part", { Name = "TreeTrunk", Size = Vector3.new(side, trunkH, tr), CFrame = at(x, fy + trunkH / 2, z) * CFrame.Angles(0, k * math.pi / 3, 0), Color = Color3.fromRGB(120, 84, 56), Material = LOW, CastShadow = false }, parent)
		end
		local greens = { Color3.fromRGB(86, 150, 78), Color3.fromRGB(104, 168, 86), Color3.fromRGB(74, 136, 70) }
		for i = 0, 2 do
			local size = (64 - i * 14) * scale
			mkPart("Part", {
				Name = "TreeCanopy",
				Size = Vector3.new(size, size * 0.8, size),
				CFrame = at(x, fy + trunkH + (i * 26 - 4) * scale, z) * CFrame.Angles(math.rad(12 * (i % 2 == 0 and 1 or -1)), math.rad(rng:NextNumber(0, 90)), math.rad(8)),
				Color = greens[i + 1],
				Material = LOW,
				CastShadow = false,
			}, parent)
		end
	end
	for _ = 1, 22 do
		-- Pick a spot in the ring between the house walls and the fence.
		local x, z
		repeat
			x = rng:NextNumber(fx0 + 50, fx1 - 50)
			z = rng:NextNumber(fz0 + 50, fz1 - 50)
		until x &lt; -ROOM_X - 70 or x &gt; ROOM_X + 70 or z &lt; ROOM_Z0 - 70 or z &gt; ROOM_Z1 + 150
		treeAt(x, z, rng:NextNumber(0.8, 1.25))
	end
	-- A thicker tree line beyond the fence (neighbours' gardens), so the view out ends in trees.
	for i = 1, 40 do
		local ang = i / 40 * math.pi * 2 + rng:NextNumber(-0.05, 0.05)
		local rx, rz = (GX1 - GX0) / 2 + rng:NextNumber(40, 160), (GZ1 - GZ0) / 2 + rng:NextNumber(40, 160)
		treeAt(math.cos(ang) * rx, (GZ0 + GZ1) / 2 + math.sin(ang) * rz, rng:NextNumber(1.2, 1.8))
	end
	-- Hedges hugging the house walls.
	for _, spec in { { -ROOM_X - 20, ROOM_Z0, -ROOM_X - 20, ROOM_Z1 }, { ROOM_X + 20, ROOM_Z0, ROOM_X + 20, ROOM_Z1 } } do
		mkPart("Part", { Name = "Hedge", Size = Vector3.new(24, 40, math.abs(spec[4] - spec[2]) - 40), CFrame = at(spec[1], fy + 20, (spec[2] + spec[4]) / 2), Color = Color3.fromRGB(80, 142, 72), Material = LOW, CastShadow = false }, parent)
	end
end

----------------------------------------------------------------------------------------------------
-- Party pads: flat circles with a low see-through ring (it only blocks party members, so they stay
-- put while waiting) and a floating world-sized sign.
----------------------------------------------------------------------------------------------------
local function padPosition(id: number): (number, number)
	local side = if id &lt;= 3 then -1 else 1
	local row = ((id - 1) % 3) + 1
	return side * PAD_X, PAD_Z[row]
end

local function buildPad(parent: Instance, id: number): PadInfo
	local cx, cz = padPosition(id)
	local model = mk("Model", { Name = "Pad" .. id }, parent) :: Model

	local floor = mkPart("Part", {
		Name = "Floor",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.4, PAD_RADIUS * 2, PAD_RADIUS * 2),
		CFrame = upright(cx, FLOOR_Y + 0.2, cz),
		Color = Color3.fromRGB(125, 195, 255),
		Material = Enum.Material.SmoothPlastic,
	}, model)
	-- White rim ring: wider than the floor but lower (top at +0.2 vs the floor's +0.4), so no two
	-- faces share a plane.
	mkPart("Part", {
		Name = "Rim",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.3, PAD_RADIUS * 2 + 1.2, PAD_RADIUS * 2 + 1.2),
		CFrame = upright(cx, FLOOR_Y + 0.05, cz),
		Color = Color3.fromRGB(255, 255, 255),
		Material = Enum.Material.SmoothPlastic,
		CanCollide = false,
	}, model)
	-- A dishwasher spray arm lying on the pad: a hub and two arms with nozzle dots, spun by the
	-- client (tag SpinY). It floats a hair above the floor and never touches another face.
	local spinner = mkPart("Part", {
		Name = "SprayArm",
		Size = Vector3.new(PAD_RADIUS * 1.7, 0.2, 1.6),
		CFrame = at(cx, FLOOR_Y + 0.55, cz),
		Color = Color3.fromRGB(255, 255, 255),
		Material = Enum.Material.SmoothPlastic,
		CanCollide = false,
		CastShadow = false,
	}, model)
	spinner:SetAttribute("SpinSpeed", 1.2)
	CollectionService:AddTag(spinner, "SpinY")
	local cross = mkPart("Part", {
		Name = "SprayArm",
		Size = Vector3.new(1.6, 0.18, PAD_RADIUS * 1.7),
		CFrame = at(cx, FLOOR_Y + 0.54, cz),
		Color = Color3.fromRGB(255, 255, 255),
		Material = Enum.Material.SmoothPlastic,
		CanCollide = false,
		CastShadow = false,
	}, model)
	cross:SetAttribute("SpinSpeed", 1.2)
	CollectionService:AddTag(cross, "SpinY")
	mkPart("Part", {
		Name = "SprayHub",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.5, 3, 3),
		CFrame = upright(cx, FLOOR_Y + 0.6, cz),
		Color = Color3.fromRGB(120, 200, 250),
		Material = Enum.Material.SmoothPlastic,
		CanCollide = false,
		CastShadow = false,
	}, model)

	-- A ring of glass panels; CollisionGroup PadBarrier collides only with PartyMember.
	local barriers: { BasePart } = {}
	local panels = 14
	local panelW = 2 * math.pi * (PAD_RADIUS + 0.3) / panels + 0.2
	for i = 1, panels do
		local a = (i - 0.5) / panels * math.pi * 2
		local px, pz = cx + math.cos(a) * (PAD_RADIUS + 0.3), cz + math.sin(a) * (PAD_RADIUS + 0.3)
		local b = mkPart("Part", {
			Name = "Barrier",
			Size = Vector3.new(panelW, PAD_WALL_HEIGHT, 0.4),
			CFrame = CFrame.lookAt(at(px, PAD_WALL_HEIGHT / 2, pz).Position, at(cx, PAD_WALL_HEIGHT / 2, cz).Position),
			Color = Color3.fromRGB(200, 235, 255),
			Material = Enum.Material.Glass,
			Transparency = 0.85,
			CastShadow = false,
			CollisionGroup = "PadBarrier",
		}, model)
		table.insert(barriers, b)
	end
	-- A genuinely invisible, much taller ring behind the glass so party members can't jump out
	-- (PadBarrier only blocks party members; everyone else walks straight through).
	local tallWalls = 18
	for i = 1, tallWalls do
		local a = (i - 0.5) / tallWalls * math.pi * 2
		local px, pz = cx + math.cos(a) * (PAD_RADIUS + 0.9), cz + math.sin(a) * (PAD_RADIUS + 0.9)
		local wallW = 2 * math.pi * (PAD_RADIUS + 0.9) / tallWalls + 0.4
		local b = mkPart("Part", {
			Name = "InvisibleWall",
			Size = Vector3.new(wallW, 60, 0.6),
			CFrame = CFrame.lookAt(at(px, 30, pz).Position, at(cx, 30, cz).Position),
			Transparency = 1,
			CastShadow = false,
			CollisionGroup = "PadBarrier",
		}, model)
		table.insert(barriers, b)
	end
	-- And a lid, so nobody escapes by jumping straight up either.
	table.insert(barriers, mkPart("Part", {
		Name = "InvisibleLid",
		Size = Vector3.new(PAD_RADIUS * 2 + 3, 1, PAD_RADIUS * 2 + 3),
		CFrame = at(cx, 60.5, cz),
		Transparency = 1,
		CastShadow = false,
		CollisionGroup = "PadBarrier",
	}, model))

	-- The box a player's root must be in to count as "on the pad" (inscribed in the circle).
	local zoneHalf = PAD_RADIUS * 0.72
	local zone = mkPart("Part", {
		Name = "Zone",
		Size = Vector3.new(zoneHalf * 2, 12, zoneHalf * 2),
		CFrame = at(cx, 6, cz),
		Transparency = 1,
		CanCollide = false,
		CastShadow = false,
	}, model)

	-- Floating sign: world-sized, not AlwaysOnTop, so it looks the same size as the pad on every
	-- screen and never covers menus.
	local anchor = mkPart("Part", {
		Name = "SignAnchor",
		Size = Vector3.new(1, 1, 1),
		CFrame = at(cx, FLOOR_Y, cz),
		Transparency = 1,
		CanCollide = false,
		CastShadow = false,
	}, model)
	local billboard = mk("BillboardGui", {
		Name = "PadGui",
		Size = UDim2.fromScale(16, 8),
		StudsOffsetWorldSpace = Vector3.new(0, 11, 0),
		LightInfluence = 0,
		MaxDistance = 120,
		AlwaysOnTop = false,
	}, anchor)
	local function line(name: string, y: number, h: number, text: string, color: Color3, font: Enum.Font): TextLabel
		local lbl = mk("TextLabel", {
			Name = name,
			Size = UDim2.fromScale(1, h),
			Position = UDim2.fromScale(0, y),
			BackgroundTransparency = 1,
			Text = text,
			Font = font,
			TextScaled = true,
			TextColor3 = color,
		}, billboard) :: TextLabel
		mk("UIStroke", { Thickness = 2.5, Color = Color3.fromRGB(12, 30, 60) }, lbl)
		return lbl
	end
	local titleLbl = line("Title", 0, 0.2, "", Color3.fromRGB(255, 230, 140), Enum.Font.LuckiestGuy)
	local countLbl = line("Count", 0.2, 0.42, "0/" .. Config.Party.MaxPlayers, Color3.new(1, 1, 1), Enum.Font.LuckiestGuy)
	local statusLbl = line("Status", 0.63, 0.2, "Touch to create a party", Color3.new(1, 1, 1), Enum.Font.LuckiestGuy)
	local privacyLbl = line("Privacy", 0.84, 0.15, "", Color3.fromRGB(215, 230, 250), Enum.Font.SourceSansBold)

	-- Members stand in the middle facing the plaza centre; leavers are put outside, towards it.
	local toCentre = -math.sign(cx)
	local inside = at(cx, FLOOR_Y + 0.4, cz)
	local exitPos = at(cx + toCentre * (PAD_RADIUS + 6), FLOOR_Y, cz)
	return {
		Id = id,
		Model = model,
		Zone = zone,
		Floor = floor,
		Inside = CFrame.lookAt(inside.Position, inside.Position + Vector3.new(toCentre, 0, 0)),
		Exit = CFrame.lookAt(exitPos.Position, exitPos.Position + Vector3.new(toCentre, 0, 0)),
		Barriers = barriers,
		Gui = { Count = countLbl, Title = titleLbl, Status = statusLbl, Privacy = privacyLbl },
	}
end

----------------------------------------------------------------------------------------------------
-- The giant dishwasher building at the back (the game's "barn"), with the title on its control panel.
----------------------------------------------------------------------------------------------------
local function buildDishwasherBuilding(parent: Instance)
	local w, h, d = 84, 52, 26
	local z = HATCHERY_Z - d / 2
	-- Low-poly body: flat white box on a navy plinth, a wooden worktop slab on top with an overhang,
	-- and chamfered front corners (wedges) so it reads chunky rather than boxy.
	mkPart("Part", { Name = "Body", Size = Vector3.new(w, h - 4, d), CFrame = at(0, (h - 4) / 2 + 4, z), Color = Color3.fromRGB(238, 242, 246), Material = LOW }, parent)
	mkPart("Part", { Name = "Plinth", Size = Vector3.new(w - 4, 4, d - 3), CFrame = at(0, 2, z - 1.5), Color = Color3.fromRGB(38, 60, 96), Material = LOW }, parent)
	mkPart("Part", { Name = "Worktop", Size = Vector3.new(w + 10, 3, d + 6), CFrame = at(0, h + 1.5, z + 1), Color = Color3.fromRGB(196, 146, 98), Material = LOW }, parent)
	mkPart("Part", { Name = "WorktopEdge", Size = Vector3.new(w + 10.4, 1.0, 1), CFrame = at(0, h + 0.7, z + d / 2 + 4.2), Color = Color3.fromRGB(150, 104, 70), Material = LOW }, parent)
	for _, side in { -1, 1 } do
		-- Vertical chamfer strips on the front corners.
		mkPart("Part", {
			Name = "CornerChamfer",
			Size = Vector3.new(4, h - 4.4, 4),
			CFrame = at(side * (w / 2 - 1.4), (h - 4.4) / 2 + 4, HATCHERY_Z - 1.4) * CFrame.Angles(0, math.rad(45), 0),
			Color = Color3.fromRGB(214, 222, 230),
			Material = LOW,
		}, parent)
	end
	-- One solid, invisible block over the whole front (door, window, frames, handle, panel), so the
	-- detail can't be jumped into: it all reads as the face of one big machine.
	mkPart("Part", { Name = "FrontCollider", Size = Vector3.new(w, h - 4, 4.4), CFrame = at(0, (h - 4) / 2 + 4, HATCHERY_Z + 2.2), Transparency = 1, CastShadow = false, CanQuery = false }, parent)
	-- Door panel with a recessed window and handle.
	mkPart("Part", decor({ Name = "Door", Size = Vector3.new(w - 6, h - 16, 1), CFrame = at(0, (h - 16) / 2 + 3, HATCHERY_Z + 0.5), Color = Color3.fromRGB(225, 229, 234), Material = LOW }), parent)
	-- The window shows a rack of plates behind the glass, like a real dishwasher.
	local winW, winH, winY = w - 26, h - 30, (h - 16) / 2 + 3
	mkPart("Part", decor({ Name = "WindowBack", Size = Vector3.new(winW, winH, 0.4), CFrame = at(0, winY, HATCHERY_Z + 1.2), Color = Color3.fromRGB(60, 80, 105), Material = LOW }), parent)
	for i = 0, 4 do
		local px = -winW / 2 + 6 + i * ((winW - 12) / 4)
		mkPart("Part", decor({ Name = "WindowPlate", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.4, 13, 13), CFrame = at(px, winY - 1, HATCHERY_Z + 2.2) * CFrame.Angles(0, math.rad(90), 0), Color = Color3.fromRGB(110, 170, 230), Material = Enum.Material.SmoothPlastic }), parent)
		mkPart("Part", decor({ Name = "WindowPlateFace", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.4, 11, 11), CFrame = at(px, winY - 1, HATCHERY_Z + 2.45) * CFrame.Angles(0, math.rad(90), 0), Color = Color3.fromRGB(250, 250, 248), Material = Enum.Material.SmoothPlastic }), parent)
	end
	mkPart("Part", decor({ Name = "WindowRack", Size = Vector3.new(winW - 2, 0.6, 2), CFrame = at(0, winY - 8, HATCHERY_Z + 2.3), Color = Color3.fromRGB(220, 225, 230), Material = LOW }), parent)
	local window = mkPart("Part", decor({ Name = "Window", Size = Vector3.new(winW, winH, 0.3), CFrame = at(0, winY, HATCHERY_Z + 3.2), Color = Color3.fromRGB(150, 215, 250), Material = Enum.Material.Glass, Transparency = 0.55 }), parent)
	for _, side in { -1, 1 } do
		mkPart("Part", decor({ Name = "WindowFrame", Size = Vector3.new(1.2, winH + 1.2, 3), CFrame = at(side * (winW / 2 + 0.6), winY, HATCHERY_Z + 2), Color = Color3.fromRGB(200, 205, 212), Material = LOW }), parent)
	end
	for _, side in { -1, 1 } do
		mkPart("Part", decor({ Name = "WindowFrame", Size = Vector3.new(winW + 2.4, 1.2, 3), CFrame = at(0, winY + side * (winH / 2 + 0.6), HATCHERY_Z + 2), Color = Color3.fromRGB(200, 205, 212), Material = LOW }), parent)
	end
	-- Suds sloshing behind the window.
	mk("ParticleEmitter", {
		Texture = "rbxasset://textures/particles/forcefield_glow_main.dds",
		Color = ColorSequence.new(Color3.new(1, 1, 1)),
		Size = NumberSequence.new(1.6, 0.6),
		Transparency = NumberSequence.new(0.2, 1),
		Lifetime = NumberRange.new(1.5, 3),
		Rate = 12,
		Speed = NumberRange.new(1, 3),
		SpreadAngle = Vector2.new(60, 60),
		EmissionDirection = Enum.NormalId.Top,
	}, window)
	mkPart("Part", decor({ Name = "Handle", Size = Vector3.new(30, 2, 2), CFrame = at(0, h - 17, HATCHERY_Z + 2), Color = Color3.fromRGB(170, 176, 184), Material = LOW }), parent)
	-- Control panel strip with the title and a few glowing buttons.
	local panel = mkPart("Part", { Name = "ControlPanel", Size = Vector3.new(w, 12, 2), CFrame = at(0, h - 6, HATCHERY_Z + 1), Color = Color3.fromRGB(40, 46, 58), Material = Enum.Material.SmoothPlastic }, parent)
	-- Back is the +Z face of an unrotated part, which is the side facing the spawn.
	local gui = mk("SurfaceGui", { Face = Enum.NormalId.Back, CanvasSize = Vector2.new(1400, 200), LightInfluence = 0 }, panel)
	local title = mk("TextLabel", {
		Size = UDim2.fromScale(0.7, 0.9),
		Position = UDim2.fromScale(0.03, 0.05),
		BackgroundTransparency = 1,
		Text = string.upper(Config.GameName),
		Font = Enum.Font.LuckiestGuy,
		TextScaled = true,
		TextColor3 = Color3.fromRGB(120, 220, 255),
		TextXAlignment = Enum.TextXAlignment.Left,
	}, gui)
	mk("UIStroke", { Thickness = 4, Color = Color3.fromRGB(10, 30, 70) }, title)
	for i = 0, 3 do
		mkPart("Part", decor({
			Name = "PanelButton",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.6, 4, 4),
			CFrame = at(22 + i * 6, h - 6, HATCHERY_Z + 2.2) * CFrame.Angles(0, math.rad(90), 0),
			Color = if i == 0 then Color3.fromRGB(80, 230, 140) else Color3.fromRGB(120, 200, 255),
			Material = Enum.Material.Neon,
		}), parent)
	end
	-- Roof sign.
	local roofSign = mkPart("Part", { Name = "RoofSign", Size = Vector3.new(44, 9, 1), CFrame = at(0, h + 8.5, HATCHERY_Z - 4) * CFrame.Angles(0, math.pi, 0), Color = Color3.fromRGB(255, 120, 180), Material = Enum.Material.SmoothPlastic }, parent)
	local signGui = mk("SurfaceGui", { Face = Enum.NormalId.Front, CanvasSize = Vector2.new(880, 180), LightInfluence = 0 }, roofSign)
	local signText = mk("TextLabel", { Size = UDim2.fromScale(0.94, 0.86), Position = UDim2.fromScale(0.03, 0.07), BackgroundTransparency = 1, Text = "PETS &amp; EGGS", Font = Enum.Font.LuckiestGuy, TextScaled = true, TextColor3 = Color3.new(1, 1, 1) }, signGui)
	mk("UIStroke", { Thickness = 5, Color = Color3.fromRGB(140, 40, 90) }, signText)
	for _, x in { -18, 18 } do
		mkPart("Part", { Name = "SignPost", Size = Vector3.new(0.8, 3, 0.8), CFrame = at(x, h + 3.5, HATCHERY_Z - 4), Color = Color3.fromRGB(200, 205, 212), Material = LOW }, parent)
	end
	-- Steam puffing out of the top.
	local vent = mkPart("Part", decor({ Name = "Vent", Size = Vector3.new(10, 1, 4), CFrame = at(-24, h + 3.5, z), Color = Color3.fromRGB(150, 155, 160), Material = LOW }), parent)
	mk("ParticleEmitter", {
		Texture = "rbxasset://textures/particles/smoke_main.dds",
		Color = ColorSequence.new(Color3.new(1, 1, 1)),
		Size = NumberSequence.new(3, 9),
		Transparency = NumberSequence.new(0.5, 1),
		Lifetime = NumberRange.new(2, 4),
		Rate = 4,
		Speed = NumberRange.new(4, 7),
		SpreadAngle = Vector2.new(15, 15),
	}, vent)
end

----------------------------------------------------------------------------------------------------
-- Soap Shop stall (perks): striped awning, counter, a giant pump bottle, and the prompt.
----------------------------------------------------------------------------------------------------
local function buildSoapShop(parent: Instance)
	local x, z = SHOP_X, EGG_Z
	local counter = mkPart("Part", { Name = "Counter", Size = Vector3.new(16, 4, 6), CFrame = at(x, 2, z), Color = Color3.fromRGB(165, 112, 70), Material = Enum.Material.Wood }, parent)
	mkPart("Part", ({ Name = "CounterTop", Size = Vector3.new(17, 0.6, 7), CFrame = at(x, 4.3, z), Color = Color3.fromRGB(120, 78, 48), Material = Enum.Material.Wood }), parent)
	for _, dx in { -7.5, 7.5 } do
		mkPart("Part", ({ Name = "AwningPost", Size = Vector3.new(0.8, 12, 0.8), CFrame = at(x + dx, 6, z - 2.5), Color = Color3.fromRGB(250, 250, 250) }), parent)
	end
	for i = 0, 7 do
		mkPart("Part", ({
			Name = "Awning",
			Size = Vector3.new(2.2, 0.6, 9),
			CFrame = at(x - 7.7 + i * 2.2, 12.5, z - 1) * CFrame.Angles(math.rad(-12), 0, 0),
			Color = if i % 2 == 0 then Color3.fromRGB(80, 190, 250) else Color3.new(1, 1, 1),
		}), parent)
	end
	worldSign(counter, "SOAP SHOP", 14, 3, 16.5, Color3.fromRGB(255, 235, 140))
	worldSign(counter, "Perks", 8, 1.8, 14, Color3.fromRGB(220, 235, 255))

	local prompt = mk("ProximityPrompt", {
		ActionText = "Open Shop",
		ObjectText = "Soap Shop",
		RequiresLineOfSight = false,
		HoldDuration = 0,
		MaxActivationDistance = 12,
	}, counter) :: ProximityPrompt
	prompt:SetAttribute("OpenWindow", "Shop")
	prompt:SetAttribute("WindowArg", "Perks") -- the Soap Shop always opens on its perks
end

----------------------------------------------------------------------------------------------------
-- Egg Hatchery (one pedestal per Config.Eggs entry, in front of the dishwasher) and the Pet Stand.
----------------------------------------------------------------------------------------------------
local function fallbackEggModel(egg: any): Model
	local m = Instance.new("Model")
	m.Name = "Egg_" .. tostring(egg.Id)
	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.new(6, 8, 6)
	root.Color = egg.Color
	root.Material = Enum.Material.SmoothPlastic
	root.Anchored = true
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = root
	root.Parent = m
	m.PrimaryPart = root
	return m
end

local function buildEggHatchery(parent: Instance)
	local petModelsOk, PetModels = pcall(function()
		return require(Shared:WaitForChild("PetModels"))
	end)

	local eggs = Config.Eggs
	local n = #eggs
	for i, egg in eggs do
		local ex = (i - (n + 1) / 2) * 20
		local pedestal = mkPart("Part", {
			Name = "EggPedestal" .. i,
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(3, 9, 9),
			CFrame = upright(ex, 1.5, EGG_Z),
			Color = Color3.fromRGB(255, 255, 255),
			Material = Enum.Material.SmoothPlastic,
		}, parent)
		mkPart("Part", decor({
			Name = "EggPedestalRing",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.6, 9.6, 9.6),
			CFrame = upright(ex, 3, EGG_Z),
			Color = egg.Color,
			Material = Enum.Material.Neon,
		}), parent)

		local eggModel: Model? = nil
		if petModelsOk then
			local ok2, result = pcall((PetModels :: any).Egg, egg.Id)
			if ok2 and typeof(result) == "Instance" then
				eggModel = result :: Model
			end
		end
		local model = eggModel or fallbackEggModel(egg)
		model.Parent = parent
		pcall(function()
			model:ScaleTo(2)
		end)
		pcall(function()
			model:PivotTo(at(ex, 8.5, EGG_Z))
		end)
		-- The egg model is decor; one invisible capsule-ish block keeps players from walking into it.
		mkPart("Part", { Name = "EggCollider", Size = Vector3.new(5, 7.5, 5), CFrame = at(ex, 8, EGG_Z), Transparency = 1, CastShadow = false, CanQuery = false }, parent)
		for _, d in model:GetDescendants() do
			if d:IsA("BasePart") then
				d.Anchored = true
				d.CanCollide = false
				d.CanTouch = false
				d.CanQuery = false
				maybeYield()
			end
		end

		local label = worldSign(pedestal, egg.Name, 10, 2.2, 18.5)
		label.Name = "EggName"
		worldSign(pedestal, tostring(egg.Cost) .. " Bubbles", 7, 1.8, 16.3, Color3.fromRGB(255, 210, 120))
		if egg.RequiredLevel and egg.RequiredLevel &gt; 1 then
			worldSign(pedestal, "Locked: level " .. tostring(egg.RequiredLevel), 7, 1.5, 14.4, Color3.fromRGB(255, 160, 160))
		end

		local prompt = mk("ProximityPrompt", {
			ActionText = "Hatch",
			ObjectText = egg.Name,
			RequiresLineOfSight = false,
			HoldDuration = 0,
			MaxActivationDistance = 12,
		}, pedestal) :: ProximityPrompt
		prompt:SetAttribute("OpenWindow", "Eggs")
		prompt:SetAttribute("EggId", egg.Id)
	end
end

----------------------------------------------------------------------------------------------------
-- A ladder up the right side of the dishwasher building, so players can climb onto its roof.
----------------------------------------------------------------------------------------------------
local function buildRoofLadder(parent: Instance)
	-- One invisible TrussPart does the climbing; rails and rungs are the looks.
	local lx, lz = 48.2, -84
	mkPart("TrussPart", { Name = "LadderClimb", Size = Vector3.new(2, 56, 2), CFrame = at(lx, 28, lz), Transparency = 1, CastShadow = false }, parent)
	local wood = Color3.fromRGB(196, 146, 98)
	for _, dz in { -1.4, 1.4 } do
		mkPart("Part", decor({ Name = "LadderRail", Size = Vector3.new(0.5, 58, 0.5), CFrame = at(lx + 0.6, 29, lz + dz), Color = wood, Material = LOW }), parent)
	end
	for y = 2, 56, 2 do
		mkPart("Part", decor({ Name = "LadderRung", Size = Vector3.new(0.4, 0.4, 2.8), CFrame = at(lx + 0.6, y, lz), Color = Color3.fromRGB(170, 120, 78), Material = LOW }), parent)
	end
end

local function buildPetStand(parent: Instance)
	local x, z = PETSTAND_X, EGG_Z
	local base = mkPart("Part", { Name = "PetStand", Shape = Enum.PartType.Cylinder, Size = Vector3.new(3, 12, 12), CFrame = upright(x, 1.5, z), Color = Color3.fromRGB(255, 205, 230), Material = Enum.Material.SmoothPlastic }, parent)
	-- A little doghouse.
	mkPart("Part", { Name = "Doghouse", Size = Vector3.new(7, 6, 6), CFrame = at(x, 6, z - 1), Color = Color3.fromRGB(240, 120, 150), Material = Enum.Material.WoodPlanks }, parent)
	-- A proper gable roof: two wedges close the triangle over the body (front and back), two planks
	-- rest on the slopes with a little overhang, and a cap covers the ridge where they meet.
	local pitch = math.rad(38)
	local half, top, zc = 3.5, 9, z - 1
	local rise = half * math.tan(pitch)
	local roofColor = Color3.fromRGB(150, 62, 58)
	for _, side in { -1, 1 } do
		mkPart("WedgePart", {
			Name = "Gable",
			Size = Vector3.new(6, rise, half),
			CFrame = at(x + side * half / 2, top + rise / 2, zc) * CFrame.Angles(0, math.rad(-side * 90), 0),
			Color = Color3.fromRGB(240, 120, 150),
			Material = Enum.Material.WoodPlanks,
		}, parent)
		-- plank: from the ridge down the slope and 0.9 past the eave, sitting on the slope
		local length = half / math.cos(pitch) + 0.9
		local down = Vector3.new(side * math.cos(pitch), -math.sin(pitch), 0)
		local outward = Vector3.new(side * math.sin(pitch), math.cos(pitch), 0)
		local ridge = Vector3.new(0, top + rise, 0)
		local c = ridge + down * (length / 2) + outward * 0.25
		mkPart("Part", {
			Name = "Roof",
			Size = Vector3.new(length, 0.6, 7.2),
			CFrame = at(x + c.X, c.Y, zc) * CFrame.Angles(0, 0, -side * pitch),
			Color = roofColor,
			Material = LOW,
		}, parent)
	end
	mkPart("Part", {
		Name = "RoofRidge",
		Size = Vector3.new(0.9, 0.9, 7.6),
		CFrame = at(x, top + rise + 0.35, zc) * CFrame.Angles(0, 0, math.rad(45)),
		Color = Color3.fromRGB(120, 48, 46),
		Material = LOW,
	}, parent)
	mkPart("Part", decor({ Name = "DoghouseDoor", Size = Vector3.new(3, 3.6, 0.3), CFrame = at(x, 4.8, z + 2.05), Color = Color3.fromRGB(40, 30, 30) }), parent)
	worldSign(base, "PETS", 10, 2.6, 13, Color3.fromRGB(255, 170, 210))
	local prompt = mk("ProximityPrompt", {
		ActionText = "My Pets",
		ObjectText = "Pet Stand",
		RequiresLineOfSight = false,
		HoldDuration = 0,
		MaxActivationDistance = 12,
	}, base) :: ProximityPrompt
	prompt:SetAttribute("OpenWindow", "Pets")
end

----------------------------------------------------------------------------------------------------
-- Boards: two leaderboards and How to Play, facing the spawn (+Z).
----------------------------------------------------------------------------------------------------
-- A board on legs at (x, z), its front (the side with the SurfaceGui, the part's Front face) turned
-- toward (faceX, faceZ). Trim and legs follow the rotation.
local function boardShell(parent: Instance, x: number, z: number, w: number, h: number, name: string, faceX: number, faceZ: number): BasePart
	local centre = at(x, h / 2 + 3, z).Position
	local facing = CFrame.lookAt(centre, Vector3.new(ORIGIN.X + faceX, centre.Y, ORIGIN.Z + faceZ))
	local boardPart = mkPart("Part", {
		Name = name,
		Size = Vector3.new(w, h, 1),
		CFrame = facing,
		Color = NAVY,
		Material = Enum.Material.SmoothPlastic,
	}, parent)
	mkPart("Part", decor({ Name = "Trim", Size = Vector3.new(w + 1.4, h + 1.4, 0.6), CFrame = facing * CFrame.new(0, 0, 0.7), Color = Color3.fromRGB(40, 90, 150) }), parent)
	for _, dx in { -w / 2 + 2, w / 2 - 2 } do
		mkPart("Part", { Name = "Leg", Size = Vector3.new(1.2, 3.2, 1.2), CFrame = facing * CFrame.new(dx, -h / 2 - 1.4, 0.3), Color = Color3.fromRGB(150, 155, 160), Material = Enum.Material.Metal }, parent)
	end
	return boardPart
end

local function buildBoard(parent: Instance, x: number, z: number, titleText: string, faceX: number, faceZ: number, pageCount: number?): BoardInfo
	local boardPart = boardShell(parent, x, z, 22, 15, "Board", faceX, faceZ)
	-- MaxDistance: readable from anywhere in the lobby, not only up close.
	local gui = mk("SurfaceGui", { Face = Enum.NormalId.Front, CanvasSize = Vector2.new(700, 480), LightInfluence = 0, MaxDistance = 5000 }, boardPart)
	mk("UIPadding", {
		PaddingTop = UDim.new(0, 10),
		PaddingBottom = UDim.new(0, 10),
		PaddingLeft = UDim.new(0, 12),
		PaddingRight = UDim.new(0, 12),
	}, gui)
	local paged = pageCount and pageCount &gt; 1
	local function page(i: number, parentGui: Instance): BoardPage
		local root = mk("Frame", { Name = "Page" .. i, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = i == 1 }, parentGui)
		local titleLbl = mk("TextLabel", {
			Name = "Title",
			Size = if paged then UDim2.new(1, -150, 0, 64) else UDim2.new(1, 0, 0, 64),
			Position = if paged then UDim2.fromOffset(75, 0) else UDim2.new(),
			BackgroundTransparency = 1,
			Text = titleText,
			Font = Enum.Font.LuckiestGuy,
			TextScaled = true,
			TextColor3 = Color3.new(1, 1, 1),
		}, root) :: TextLabel
		mk("UIStroke", { Thickness = 3, Color = Color3.fromRGB(10, 30, 60) }, titleLbl)
		-- The top 100, scrollable (the client moves this SurfaceGui into PlayerGui so it takes the
		-- mouse wheel / a finger: BoardView). The 46 px under it are for each player's own row.
		local list = mk("ScrollingFrame", {
			Name = "List",
			Size = UDim2.new(1, 0, 1, if paged then -150 else -116),
			Position = UDim2.new(0, 0, 0, 70),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			CanvasSize = UDim2.new(),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			ScrollingDirection = Enum.ScrollingDirection.Y,
			ScrollBarThickness = 10,
			ScrollBarImageColor3 = Color3.fromRGB(255, 205, 70),
			ElasticBehavior = Enum.ElasticBehavior.Never,
		}, root) :: ScrollingFrame
		mk("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 4) }, list)
		if paged then
			-- Page dots along the bottom, this page's dot lit.
			local dots = mk("Frame", { Name = "PageDots", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -2), Size = UDim2.fromOffset(200, 22), BackgroundTransparency = 1 }, root)
			mk("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, VerticalAlignment = Enum.VerticalAlignment.Center, Padding = UDim.new(0, 12) }, dots)
			for d = 1, pageCount :: number do
				local dot = mk("Frame", { Name = "Dot" .. d, LayoutOrder = d, Size = if d == i then UDim2.fromOffset(34, 16) else UDim2.fromOffset(16, 16), BackgroundColor3 = if d == i then Color3.fromRGB(255, 205, 70) else Color3.fromRGB(70, 110, 160) }, dots)
				mk("UICorner", { CornerRadius = UDim.new(1, 0) }, dot)
			end
		end
		return { Title = titleLbl, List = list }
	end

	if not paged then
		local only = page(1, gui)
		return { Part = boardPart, Title = only.Title, List = only.List }
	end

	local pages = {}
	for i = 1, pageCount :: number do
		pages[i] = page(i, gui)
	end
	-- Round arrow buttons drawn in the board's own SurfaceGui (crisp, same resolution as the board),
	-- either side of the title, with an invisible click target over each (click or tap), plus a
	-- prompt for controllers. The client flips the pages locally and lights a button on hover
	-- (Effects).
	local w, h = boardPart.Size.X, boardPart.Size.Y
	local canvas = Vector2.new(700, 480)
	local pxPerStud = canvas.X / w
	local btn = 60
	for _, dir in { -1, 1 } do
		local name = if dir &lt; 0 then "ArrowLeft" else "ArrowRight"
		local frame = mk("Frame", {
			Name = name,
			AnchorPoint = Vector2.new(if dir &lt; 0 then 0 else 1, 0),
			Position = if dir &lt; 0 then UDim2.fromOffset(0, 2) else UDim2.new(1, 0, 0, 2),
			Size = UDim2.fromOffset(btn, btn),
			BackgroundColor3 = Color3.fromRGB(255, 205, 70),
			ZIndex = 5,
		}, gui)
		mk("UICorner", { CornerRadius = UDim.new(1, 0) }, frame)
		mk("UIStroke", { Thickness = 4, Color = Color3.fromRGB(255, 245, 200) }, frame)
		mk("UIGradient", {
			Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(200, 200, 200)),
			Rotation = 90,
		}, frame)
		mk("TextLabel", {
			Size = UDim2.fromScale(1, 1),
			Position = UDim2.fromOffset(if dir &lt; 0 then -2 else 2, -1),
			BackgroundTransparency = 1,
			Text = if dir &lt; 0 then "◀" else "▶",
			Font = Enum.Font.LuckiestGuy,
			TextSize = 34,
			TextColor3 = Color3.fromRGB(60, 40, 10),
			ZIndex = 6,
		}, frame)
		-- Click target over the drawn button (board padding: 12 px left/right, 10 px top).
		local cx = if dir &lt; 0 then 12 + btn / 2 else canvas.X - 12 - btn / 2
		local cy = 10 + 2 + btn / 2
		local arrow = mkPart("Part", {
			Name = "BoardArrow",
			Size = Vector3.new(btn / pxPerStud + 0.3, btn / pxPerStud + 0.3, 0.3),
			CFrame = boardPart.CFrame * CFrame.new(cx / pxPerStud - w / 2, h / 2 - cy / pxPerStud, -0.7),
			Transparency = 1,
			CanCollide = false,
			CanQuery = true, -- ClickDetectors need the mouse ray to hit the part
			CastShadow = false,
		}, boardPart)
		arrow:SetAttribute("Dir", dir)
		arrow:SetAttribute("Button", name)
		CollectionService:AddTag(arrow, "BoardArrow")
		mk("ClickDetector", { MaxActivationDistance = 70 }, arrow)
	end
	local prompt = mk("ProximityPrompt", {
		ActionText = "Next page",
		ObjectText = titleText,
		RequiresLineOfSight = false,
		HoldDuration = 0,
		MaxActivationDistance = 14,
		KeyboardKeyCode = Enum.KeyCode.F,
	}, boardPart) :: ProximityPrompt
	prompt:SetAttribute("BoardNext", true)
	return { Part = boardPart, Title = pages[1].Title, List = pages[1].List, Pages = pages }
end

local function buildHowToPlay(parent: Instance, x: number, z: number, faceX: number, faceZ: number)
	local boardPart = boardShell(parent, x, z, 24, 15, "HowToPlayBoard", faceX, faceZ)
	boardPart.Color = Color3.fromRGB(255, 255, 255)
	local gui = mk("SurfaceGui", { Face = Enum.NormalId.Front, CanvasSize = Vector2.new(760, 480), LightInfluence = 0 }, boardPart)
	mk("UIPadding", {
		PaddingTop = UDim.new(0, 12),
		PaddingBottom = UDim.new(0, 12),
		PaddingLeft = UDim.new(0, 18),
		PaddingRight = UDim.new(0, 18),
	}, gui)
	mk("TextLabel", {
		Size = UDim2.new(1, 0, 0, 56),
		BackgroundTransparency = 1,
		Text = "How to Play",
		Font = Enum.Font.LuckiestGuy,
		TextScaled = true,
		TextColor3 = Color3.fromRGB(20, 110, 190),
	}, gui)
	local list = mk("Frame", {
		Size = UDim2.new(1, 0, 1, -60),
		Position = UDim2.new(0, 0, 0, 60),
		BackgroundTransparency = 1,
	}, gui)
	mk("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6) }, list)
	local steps = {
		"Step on a party pad and pick a level.",
		"Aim at dirt and hold to scrub it off.",
		"Stand in the drain to sell your dirt for coins.",
		"Buy better tools and upgrades.",
		"Clean every dish, earn Bubbles and hatch pets!",
	}
	for i, text in steps do
		mk("TextLabel", {
			Name = "Step" .. i,
			Size = UDim2.new(1, 0, 0, 66),
			BackgroundTransparency = 1,
			Text = tostring(i) .. ". " .. text,
			Font = Enum.Font.SourceSansBold,
			-- one fixed size for every step (scaled text made each line a different size)
			TextSize = 31,
			TextColor3 = Color3.fromRGB(20, 40, 70),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextWrapped = true,
			LayoutOrder = i,
		}, list)
	end
end

----------------------------------------------------------------------------------------------------
-- Decorations: giant tableware on the table (salt and pepper, a flower vase, a coffee cup, cutlery),
-- a sponge and soap bars, floating bubbles. Low-poly: hexagonal prisms, flat colours.
----------------------------------------------------------------------------------------------------

-- Hexagonal prism (flat-to-flat width d, height h) with its base at y0: three boxes at 0/60/120.
local function hex(parent: Instance, name: string, x: number, y0: number, z: number, d: number, h: number, color: Color3, collide: boolean?)
	local side = d / math.sqrt(3)
	for k = 0, 2 do
		mkPart("Part", {
			Name = name,
			Size = Vector3.new(side, h, d),
			CFrame = at(x, y0 + h / 2, z) * CFrame.Angles(0, k * math.pi / 3, 0),
			Color = color,
			Material = LOW,
			CanCollide = collide ~= false,
		}, parent)
	end
end

local function shaker(parent: Instance, x: number, z: number, body: Color3, holes: Color3)
	hex(parent, "Shaker", x, FLOOR_Y, z, 6, 11, body)
	hex(parent, "ShakerCap", x, FLOOR_Y + 11, z, 6.4, 2.6, Color3.fromRGB(200, 205, 212))
	for k = 0, 2 do
		local a = k / 3 * math.pi * 2
		mkPart("Part", decor({ Name = "ShakerHole", Size = Vector3.new(0.7, 0.1, 0.7), CFrame = at(x + math.cos(a) * 1.4, FLOOR_Y + 13.63, z + math.sin(a) * 1.4), Color = holes, Material = LOW }), parent)
	end
end

local function flowerVase(parent: Instance, x: number, z: number)
	hex(parent, "Vase", x, FLOOR_Y, z, 7, 9, Color3.fromRGB(90, 150, 220))
	hex(parent, "VaseNeck", x, FLOOR_Y + 9, z, 4.4, 2, Color3.fromRGB(70, 125, 200))
	local petals = { Color3.fromRGB(255, 120, 150), Color3.fromRGB(255, 200, 80), Color3.fromRGB(190, 130, 255), Color3.fromRGB(255, 255, 255) }
	for k = 0, 3 do
		local a = k / 4 * math.pi * 2
		local fx, fz = x + math.cos(a) * 2.6, z + math.sin(a) * 2.6
		local top = FLOOR_Y + 17 + (k % 2) * 2.5
		mkPart("Part", decor({ Name = "Stem", Size = Vector3.new(0.5, top - FLOOR_Y - 8, 0.5), CFrame = at((x + fx) / 2, (FLOOR_Y + 8 + top) / 2, (z + fz) / 2) * CFrame.Angles(math.sin(a) * 0.2, 0, -math.cos(a) * 0.2), Color = Color3.fromRGB(80, 160, 80), Material = LOW }), parent)
		hex(parent, "Petals", fx, top, fz, 3.4, 0.8, petals[k + 1], false)
		mkPart("Part", decor({ Name = "FlowerMiddle", Size = Vector3.new(1.2, 0.9, 1.2), CFrame = at(fx, top + 0.55, fz), Color = Color3.fromRGB(255, 220, 90), Material = LOW }), parent)
	end
end

local function coffeeCup(parent: Instance, x: number, z: number)
	mkPart("Part", { Name = "Saucer", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.8, 13, 13), CFrame = upright(x, FLOOR_Y + 0.4, z), Color = Color3.fromRGB(245, 245, 240), Material = LOW }, parent)
	hex(parent, "Cup", x, FLOOR_Y + 0.8, z, 8, 8, Color3.fromRGB(245, 245, 240))
	hex(parent, "Coffee", x, FLOOR_Y + 8.7, z, 6.6, 0.2, Color3.fromRGB(110, 70, 45))
	mkPart("Part", { Name = "CupHandle", Size = Vector3.new(3, 5, 1.2), CFrame = at(x + 5.3, FLOOR_Y + 4.8, z), Color = Color3.fromRGB(245, 245, 240), Material = LOW }, parent)
	hex(parent, "CupBand", x, FLOOR_Y + 5.8, z, 8.3, 1.2, Color3.fromRGB(90, 170, 230))
end

-- Cutlery lying flat in the table's margin (outside the invisible walls, just to look at).
local function cutlery(parent: Instance, x: number, z: number, kind: string)
	local steel = Color3.fromRGB(205, 210, 218)
	mkPart("Part", decor({ Name = "CutleryHandle", Size = Vector3.new(3, 1, 26), CFrame = at(x, FLOOR_Y + 0.5, z + 14), Color = steel, Material = Enum.Material.Metal }), parent)
	if kind == "Fork" then
		mkPart("Part", decor({ Name = "ForkHead", Size = Vector3.new(6, 1, 5), CFrame = at(x, FLOOR_Y + 0.5, z - 1.5), Color = steel, Material = Enum.Material.Metal }), parent)
		for k = 0, 3 do
			mkPart("Part", decor({ Name = "ForkTine", Size = Vector3.new(0.9, 1, 10), CFrame = at(x - 2.55 + k * 1.7, FLOOR_Y + 0.5, z - 9), Color = steel, Material = Enum.Material.Metal }), parent)
		end
	else
		mkPart("Part", decor({ Name = "KnifeBlade", Size = Vector3.new(4.5, 0.8, 18), CFrame = at(x + 0.7, FLOOR_Y + 0.4, z - 8), Color = steel, Material = Enum.Material.Metal }), parent)
	end
end

local function buildDecorations(parent: Instance)
	shaker(parent, -91, -94, Color3.fromRGB(250, 250, 250), Color3.fromRGB(60, 60, 60))
	shaker(parent, -83, -96, Color3.fromRGB(70, 70, 76), Color3.fromRGB(220, 220, 220))
	flowerVase(parent, -90, 58)
	coffeeCup(parent, 90, 58)
	cutlery(parent, -PLAZA_X - TABLE_MARGIN / 2 - 1, -20, "Fork")
	cutlery(parent, PLAZA_X + TABLE_MARGIN / 2 + 1, -20, "Knife")

	-- Giant sponge and soap bars around the spawn.
	mkPart("Part", { Name = "GiantSponge", Size = Vector3.new(12, 5, 8), CFrame = at(-78, 2.7, 44) * CFrame.Angles(0, math.rad(20), 0), Color = Color3.fromRGB(255, 215, 90), Material = LOW }, parent)
	mkPart("Part", ({ Name = "SpongeScrub", Size = Vector3.new(12.2, 1.6, 8.2), CFrame = at(-78, 5.9, 44) * CFrame.Angles(0, math.rad(20), 0), Color = Color3.fromRGB(80, 180, 100), Material = LOW }), parent)
	mkPart("Part", { Name = "SoapBar", Size = Vector3.new(10, 3.5, 6), CFrame = at(78, 2, 44) * CFrame.Angles(0, math.rad(-15), 0), Color = Color3.fromRGB(190, 230, 255), Material = LOW }, parent)
	mkPart("Part", { Name = "SoapBar", Size = Vector3.new(8, 3, 5), CFrame = at(79, 5.3, 44) * CFrame.Angles(0, math.rad(10), 0), Color = Color3.fromRGB(255, 190, 220), Material = LOW }, parent)

	-- Big floating soap bubbles over the table. The server only places them (tag "FloatBubble");
	-- every client bobs them locally (Effects), so they move smoothly with no network traffic.
	local bubbleFolder = mk("Folder", { Name = "Bubbles" }, parent)
	local tints = { Color3.fromRGB(165, 225, 255), Color3.fromRGB(255, 195, 238), Color3.fromRGB(200, 255, 232), Color3.fromRGB(226, 208, 255) }
	local rng = Random.new(11)
	for i = 1, 14 do
		local pos = at(rng:NextNumber(-85, 85), rng:NextNumber(12, 30), rng:NextNumber(-85, 50)).Position
		local size = rng:NextNumber(2.2, 4.2)
		local bubble = mkPart("Part", {
			Name = "Bubble" .. i,
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(size, size, size),
			CFrame = CFrame.new(pos),
			Color = tints[(i - 1) % #tints + 1],
			Material = Enum.Material.ForceField,
			CanCollide = false,
			CastShadow = false,
		}, bubbleFolder)
		CollectionService:AddTag(bubble, "FloatBubble")
	end
end

-- Rebirth Fountain: a low-poly stone fountain with glowing water and a spinning gold star; bubbles
-- stream up from its spout (tag "BubbleSpout", client). Opens the Rebirth window.
local function buildRebirthFountain(parent: Instance)
	local x, z = -34, 14
	local stone = Color3.fromRGB(236, 232, 224)
	local water = Color3.fromRGB(120, 200, 255)
	hex(parent, "FountainBasin", x, FLOOR_Y, z, 13, 2.2, stone)
	hex(parent, "FountainWater", x, FLOOR_Y + 2.2, z, 11.6, 0.2, water, false)
	hex(parent, "FountainPillar", x, FLOOR_Y + 2.2, z, 2.6, 5, stone)
	hex(parent, "FountainBowl", x, FLOOR_Y + 7.2, z, 6.5, 1.2, stone)
	hex(parent, "FountainBowlWater", x, FLOOR_Y + 8.4, z, 5.4, 0.2, water, false)
	local spout = mkPart("Part", decor({ Name = "BubbleSpout", Size = Vector3.new(1, 1, 1), CFrame = at(x, FLOOR_Y + 9, z), Transparency = 1, CastShadow = false }), parent)
	CollectionService:AddTag(spout, "BubbleSpout")
	local star = mkPart("Part", decor({
		Name = "RebirthStar",
		Size = Vector3.new(3, 3, 0.8),
		CFrame = at(x, FLOOR_Y + 14, z) * CFrame.Angles(0, 0, math.rad(45)),
		Color = Color3.fromRGB(255, 210, 80),
		Material = Enum.Material.Neon,
		CastShadow = false,
	}), parent)
	star:SetAttribute("SpinSpeed", 1.2)
	CollectionService:AddTag(star, "SpinY")
	mk("PointLight", { Range = 16, Brightness = 0.8, Color = Color3.fromRGB(255, 220, 140) }, star)
	local base = mkPart("Part", { Name = "FountainPrompt", Size = Vector3.new(1, 1, 1), CFrame = at(x, FLOOR_Y + 2, z), Transparency = 1, CanCollide = false, CastShadow = false }, parent)
	worldSign(base, "REBIRTH", 10, 2.6, 16, Color3.fromRGB(255, 225, 130))
	local prompt = mk("ProximityPrompt", {
		ActionText = "Rebirth",
		ObjectText = "Rebirth Fountain",
		RequiresLineOfSight = false,
		HoldDuration = 0,
		MaxActivationDistance = 12,
	}, base) :: ProximityPrompt
	prompt:SetAttribute("OpenWindow", "Rebirth")
end

-- Rank Shrine: a floating, spinning crystal over a pedestal. Opens the Ranks window.
local function buildRankShrine(parent: Instance)
	local x, z = -32, 40
	local base = mkPart("Part", { Name = "ShrineBase", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1.6, 12, 12), CFrame = upright(x, 1, z), Color = Color3.fromRGB(60, 40, 110), Material = Enum.Material.SmoothPlastic }, parent)
	mkPart("Part", { Name = "ShrinePillar", Shape = Enum.PartType.Cylinder, Size = Vector3.new(4, 5, 5), CFrame = upright(x, 3.8, z), Color = Color3.fromRGB(235, 225, 250), Material = Enum.Material.Marble }, parent)
	local crystal = mkPart("Part", decor({
		Name = "Crystal",
		Size = Vector3.new(4, 4, 4),
		CFrame = at(x, 10, z) * CFrame.Angles(math.rad(45), 0, math.rad(45)),
		Color = Color3.fromRGB(190, 120, 255),
		Material = Enum.Material.Glass,
		Transparency = 0.15,
		CastShadow = false,
	}), parent)
	crystal:SetAttribute("SpinSpeed", 0.8)
	CollectionService:AddTag(crystal, "SpinY")
	mk("PointLight", { Range = 16, Brightness = 1, Color = Color3.fromRGB(200, 140, 255) }, crystal)
	mk("ParticleEmitter", {
		Texture = "rbxasset://textures/particles/sparkles_main.dds",
		Color = ColorSequence.new(Color3.fromRGB(230, 190, 255)),
		Size = NumberSequence.new(0.6, 0),
		Lifetime = NumberRange.new(0.8, 1.4),
		Rate = 8,
		Speed = NumberRange.new(1, 3),
		SpreadAngle = Vector2.new(180, 180),
	}, crystal)
	worldSign(base, "RANKS", 10, 2.6, 15.5, Color3.fromRGB(230, 190, 255))
	worldSign(base, string.format("Roll for %d Gems", Config.RankRoll.Cost), 8, 1.6, 13.4, Color3.fromRGB(255, 255, 255))
	local prompt = mk("ProximityPrompt", {
		ActionText = "Roll Ranks",
		ObjectText = "Rank Shrine",
		RequiresLineOfSight = false,
		HoldDuration = 0,
		MaxActivationDistance = 12,
	}, base) :: ProximityPrompt
	prompt:SetAttribute("OpenWindow", "Ranks")
end

-- The Treasure Chest event (Config.ChestEvent): a big gold-banded chest on stone steps inside a glowing
-- ring on the floor, facing the spawn. Only built while the event runs (servers restart with updates,
-- so it goes when the event does). No prompt: stepping INTO the ring shows the Open buttons and the odds
-- (ChestUI, which finds the chest by its "EventChest" tag and animates the lid; the ring's radius is
-- the model's ZoneRadius attribute). Every piece has its own size and height, so nothing z-fights.
local CHEST_ZONE_RADIUS = 11
local function buildTreasureChest(parent: Instance)
	if not Config.ChestEventLive() then
		return
	end
	local x, z = 34, 12
	local wood = Color3.fromRGB(150, 90, 48)
	local gold = Color3.fromRGB(255, 200, 60)
	local stone = Color3.fromRGB(226, 214, 190)
	local model = Instance.new("Model")
	model.Name = "TreasureChest"
	model.Parent = parent
	local function disc(name: string, d: number, thickness: number, centerY: number, color: Color3, material: Enum.Material?)
		return mkPart("Part", decor({ Name = name, Shape = Enum.PartType.Cylinder, Size = Vector3.new(thickness, d, d), CFrame = upright(x, centerY, z), Color = color, Material = material or LOW, CastShadow = false }), parent)
	end
	-- The zone: a glowing gold ring, then a darker floor inside it.
	local ring = disc("ChestRing", CHEST_ZONE_RADIUS * 2 + 1.2, 0.3, FLOOR_Y + 0.15, gold, Enum.Material.Neon)
	ring.Transparency = 0.2
	disc("ChestFloor", CHEST_ZONE_RADIUS * 2 - 0.4, 0.3, FLOOR_Y + 0.2, Color3.fromRGB(40, 70, 90), LOW)
	-- Stone steps up to the chest.
	local y = FLOOR_Y + 0.35
	for k, step in { { 15, 0.5 }, { 12.5, 0.5 }, { 10, 0.6 } } do
		mkPart("Part", { Name = "ChestStep" .. k, Shape = Enum.PartType.Cylinder, Size = Vector3.new(step[2], step[1], step[1]), CFrame = upright(x, y + step[2] / 2, z), Color = stone, Material = Enum.Material.Marble }, parent)
		y += step[2]
	end
	-- Face the spawn: the chest's front (-Z, where the lock is) points at it.
	local look = CFrame.lookAt(Vector3.new(x, 0, z), Vector3.new(SPAWN.X, 0, SPAWN.Z))
	local base = CFrame.new(x, y, z) * (look - look.Position)
	local W, H, D = 8.4, 4.8, 5.4
	local box = mkPart("Part", { Name = "ChestBox", Size = Vector3.new(W, H, D), CFrame = base * CFrame.new(0, H / 2, 0), Color = wood, Material = Enum.Material.Wood }, model)
	-- The lid: a half-round (cylinder) a touch shorter than the box, hinged at the back.
	local lid = mkPart("Part", { Name = "ChestLid", Shape = Enum.PartType.Cylinder, Size = Vector3.new(W - 0.1, D, D), CFrame = base * CFrame.new(0, H, 0), Color = Color3.fromRGB(170, 104, 56), Material = Enum.Material.Wood }, model)
	CollectionService:AddTag(lid, "EventChestLid")
	-- Gold bands stand proud of every face (0.15 out), so they never share a plane with the wood.
	for _, dx in { -2.7, 2.7 } do
		mkPart("Part", decor({ Name = "ChestBand", Size = Vector3.new(0.7, H + 0.3, D + 0.3), CFrame = base * CFrame.new(dx, H / 2, 0), Color = gold, Material = Enum.Material.Metal }), model)
		local band = mkPart("Part", decor({ Name = "LidBand", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.7, D + 0.3, D + 0.3), CFrame = base * CFrame.new(dx, H, 0), Color = gold, Material = Enum.Material.Metal }), model)
		band:SetAttribute("LidPart", true)
	end
	mkPart("Part", decor({ Name = "ChestTrim", Size = Vector3.new(W + 0.4, 0.5, D + 0.4), CFrame = base * CFrame.new(0, 0.25, 0), Color = gold, Material = Enum.Material.Metal }), model)
	-- Corner studs on the base.
	for _, cx in { -1, 1 } do
		for _, cz in { -1, 1 } do
			mkPart("Part", decor({ Name = "ChestStud", Shape = Enum.PartType.Ball, Size = Vector3.new(0.9, 0.9, 0.9), CFrame = base * CFrame.new(cx * (W / 2 + 0.05), 0.6, cz * (D / 2 + 0.05)), Color = gold, Material = Enum.Material.Metal }), model)
		end
	end
	local lock = mkPart("Part", decor({ Name = "ChestLock", Size = Vector3.new(1.4, 1.7, 0.4), CFrame = base * CFrame.new(0, H - 0.6, -D / 2 - 0.15), Color = gold, Material = Enum.Material.Metal }), model)
	lock:SetAttribute("LidPart", true)
	mkPart("Part", decor({ Name = "Keyhole", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.1, 0.45, 0.45), CFrame = lock.CFrame * CFrame.new(0, 0.1, -0.22) * CFrame.Angles(0, math.rad(90), 0), Color = Color3.fromRGB(40, 25, 15), Material = LOW }), model):SetAttribute("LidPart", true)
	-- Spilled treasure on the steps: coin stacks and gems, all at their own heights.
	local rng = Random.new(77)
	for k = 1, 9 do
		local a = rng:NextNumber(0, math.pi * 2)
		local r = rng:NextNumber(5.3, 6.0) -- on the second step (its top is FLOOR_Y + 1.35)
		local cx, cz = x + math.cos(a) * r, z + math.sin(a) * r
		local stack = rng:NextInteger(2, 4)
		for n = 1, stack do
			mkPart("Part", decor({ Name = "Coin", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.18, 1.1, 1.1), CFrame = upright(cx, FLOOR_Y + 1.35 + 0.09 + (n - 1) * 0.2 + k * 0.001, cz), Color = gold, Material = Enum.Material.Metal }), parent)
		end
	end
	for k, c in { Color3.fromRGB(255, 90, 140), Color3.fromRGB(90, 200, 255), Color3.fromRGB(150, 255, 150), Color3.fromRGB(190, 120, 255) } do
		local a = k * 1.57 + 0.5
		local gx, gz = x + math.cos(a) * 5.65, z + math.sin(a) * 5.65
		mkPart("Part", decor({ Name = "Gem", Size = Vector3.new(0.9, 1.2, 0.9), CFrame = CFrame.new(gx, FLOOR_Y + 1.35 + 0.6 + k * 0.01, gz) * CFrame.Angles(math.rad(20), a, math.rad(25)), Color = c, Material = Enum.Material.Neon, CastShadow = false }), parent)
	end
	-- Two lantern posts either side of the steps.
	for _, side in { -1, 1 } do
		local pxp = x + side * 9.2
		mkPart("Part", { Name = "LanternPost", Shape = Enum.PartType.Cylinder, Size = Vector3.new(6.5, 0.7, 0.7), CFrame = upright(pxp, FLOOR_Y + 3.6, z - 3), Color = Color3.fromRGB(80, 60, 50), Material = Enum.Material.Metal }, parent)
		local bulb = mkPart("Part", decor({ Name = "Lantern", Shape = Enum.PartType.Ball, Size = Vector3.new(1.6, 1.6, 1.6), CFrame = at(pxp, FLOOR_Y + 7.3, z - 3), Color = Color3.fromRGB(255, 190, 90), Material = Enum.Material.Neon, Transparency = 0.1 }), parent)
		mk("PointLight", { Range = 16, Brightness = 0.9, Color = Color3.fromRGB(255, 200, 120) }, bulb)
	end
	-- The glow inside, seen when the lid opens.
	local glow = mkPart("Part", decor({ Name = "ChestGlow", Size = Vector3.new(1, 1, 1), CFrame = base * CFrame.new(0, H + 1.8, 0), Transparency = 1, CastShadow = false }), model)
	mk("PointLight", { Range = 20, Brightness = 1.3, Color = Color3.fromRGB(255, 210, 120) }, glow)
	mk("ParticleEmitter", {
		Texture = "rbxasset://textures/particles/sparkles_main.dds",
		Color = ColorSequence.new(Color3.fromRGB(255, 225, 120)),
		Size = NumberSequence.new(0.9, 0),
		Lifetime = NumberRange.new(0.9, 1.8),
		Rate = 16,
		Speed = NumberRange.new(2, 5),
		SpreadAngle = Vector2.new(60, 60),
	}, glow)
	model.PrimaryPart = box
	model:SetAttribute("ZoneRadius", CHEST_ZONE_RADIUS)
	CollectionService:AddTag(model, "EventChest")
	worldSign(box, "LIMITED TREASURE CHEST", 15, 2.8, 19, Color3.fromRGB(255, 215, 90))
	worldSign(box, "Sunken Treasure event", 9, 1.4, 16.2, Color3.fromRGB(190, 235, 255))
end

-- The Next Event spot: a glowing ring on the floor with a sign. Walk in and the client
-- (EventZone) shows what's coming next, with Roblox's Notify Me (Config.UpcomingEvents).
local function buildEventZone(parent: Instance)
	local x, z = 34, -18
	local ring = mkPart("Part", decor({
		Name = "EventRing",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.3, 16, 16),
		CFrame = upright(x, FLOOR_Y + 0.15, z),
		Color = Color3.fromRGB(255, 120, 160),
		Material = Enum.Material.Neon,
		Transparency = 0.25,
	}), parent)
	mkPart("Part", decor({ Name = "EventFloor", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.34, 14, 14), CFrame = upright(x, FLOOR_Y + 0.17, z), Color = Color3.fromRGB(60, 40, 90), Material = LOW }), parent)
	local zone = mkPart("Part", {
		Name = "NextEventZone",
		Size = Vector3.new(14, 8, 14),
		CFrame = at(x, FLOOR_Y + 4, z),
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		CastShadow = false,
	}, parent)
	CollectionService:AddTag(zone, "NextEventZone")
	-- Two posts and a banner across the back.
	for _, dx in { -6.5, 6.5 } do
		mkPart("Part", { Name = "EventPost", Shape = Enum.PartType.Cylinder, Size = Vector3.new(11, 0.8, 0.8), CFrame = upright(x + dx, FLOOR_Y + 5.5, z - 6.5), Color = Color3.fromRGB(240, 240, 250), Material = Enum.Material.Metal }, parent)
	end
	local banner = mkPart("Part", { Name = "EventBanner", Size = Vector3.new(13, 4, 0.4), CFrame = at(x, FLOOR_Y + 9, z - 6.5), Color = Color3.fromRGB(70, 40, 120), Material = LOW }, parent)
	local gui = mk("SurfaceGui", { Name = "Sign", Face = Enum.NormalId.Back, CanvasSize = Vector2.new(650, 200), LightInfluence = 0 }, banner) -- faces the spawn (+Z)
	local title = mk("TextLabel", { Name = "Title", Size = UDim2.fromScale(1, 0.45), BackgroundTransparency = 1, Text = "NEXT EVENT", Font = Enum.Font.LuckiestGuy, TextScaled = true, TextColor3 = Color3.fromRGB(255, 200, 230) }, gui)
	mk("UIStroke", { Thickness = 3, Color = Color3.fromRGB(12, 30, 60) }, title)
	local when = mk("TextLabel", { Name = "When", Position = UDim2.fromScale(0, 0.45), Size = UDim2.fromScale(1, 0.55), BackgroundTransparency = 1, Text = "", Font = Enum.Font.LuckiestGuy, TextScaled = true, TextColor3 = Color3.new(1, 1, 1) }, gui)
	mk("UIStroke", { Thickness = 3, Color = Color3.fromRGB(12, 30, 60) }, when)
	CollectionService:AddTag(when, "NextEventCountdown")
	mk("PointLight", { Range = 16, Brightness = 0.8, Color = Color3.fromRGB(255, 150, 200) }, ring)
end

-- Bubble lamps and bushy planters along the central path.
local function buildPathDressing(parent: Instance)
	for _, z in { -52, -22, 8 } do
		for _, side in { -1, 1 } do
			local x = side * 11
			mkPart("Part", { Name = "PathLampPost", Shape = Enum.PartType.Cylinder, Size = Vector3.new(7, 0.8, 0.8), CFrame = upright(x, 3.7, z), Color = Color3.fromRGB(230, 234, 240), Material = Enum.Material.Metal }, parent)
			local bulb = mkPart("Part", decor({ Name = "PathLamp", Shape = Enum.PartType.Ball, Size = Vector3.new(2.2, 2.2, 2.2), CFrame = at(x, 8.3, z), Color = if (z / 30) % 2 &lt; 1 then Color3.fromRGB(150, 220, 255) else Color3.fromRGB(255, 180, 220), Material = Enum.Material.Neon, Transparency = 0.15 }), parent)
			mk("PointLight", { Range = 14, Brightness = 0.7, Color = bulb.Color }, bulb)
			mkPart("Part", { Name = "Planter", Size = Vector3.new(4, 2, 8), CFrame = at(x + side * 4, 1.2, z + 7), Color = Color3.fromRGB(230, 234, 240), Material = Enum.Material.SmoothPlastic }, parent)
			for k = -1, 1 do
				local d = 3 + (k + 1) % 2
				local bush = mkPart("Part", decor({ Name = "Bush", Size = Vector3.new(d, d, d), CFrame = at(x + side * 4, 2.6, z + 7 + k * 2.4) * CFrame.Angles(math.rad(35), math.rad(45 + k * 20), 0), Color = Color3.fromRGB(80 + k * 10, 160, 80), Material = LOW }), parent)
				bush.CastShadow = true
			end
		end
	end
end

----------------------------------------------------------------------------------------------------
-- Lighting: a soft, natural afternoon. Much gentler than before (no blown-out whites).
----------------------------------------------------------------------------------------------------
local function getOrMake(className: string): Instance
	return Lighting:FindFirstChildOfClass(className) or mk(className, nil, Lighting)
end

local function setupLighting()
	Lighting.ClockTime = 15
	Lighting.Brightness = 1.3
	Lighting.ExposureCompensation = -0.35
	Lighting.Ambient = Color3.fromRGB(80, 84, 94)
	Lighting.OutdoorAmbient = Color3.fromRGB(100, 104, 116)
	Lighting.GlobalShadows = true
	Lighting.EnvironmentDiffuseScale = 0.45
	Lighting.EnvironmentSpecularScale = 0.35

	local atmo = getOrMake("Atmosphere") :: Atmosphere
	atmo.Density = 0.3
	atmo.Offset = 0.1
	atmo.Color = Color3.fromRGB(199, 218, 240)
	atmo.Decay = Color3.fromRGB(120, 150, 190)
	atmo.Glare = 0
	atmo.Haze = 1

	local bloom = getOrMake("BloomEffect") :: BloomEffect
	bloom.Intensity = 0.15
	bloom.Size = 20
	bloom.Threshold = 2

	local cc = getOrMake("ColorCorrectionEffect") :: ColorCorrectionEffect
	cc.Saturation = 0.1
	cc.Contrast = 0.08
	cc.Brightness = -0.02

	local rays = getOrMake("SunRaysEffect") :: SunRaysEffect
	rays.Intensity = 0.03
	rays.Spread = 0.4
end

----------------------------------------------------------------------------------------------------
-- The obby (only exists while the Admin Abuse show has it open: LobbyBuilder.OpenObby builds it up
-- piece by piece, LobbyBuilder.BreakObby smashes it and the pieces fade away). Behind the spawn, off
-- the table's edge and out over the room toward the sofa: five checkpoints and seven stages, a
-- finish on a high platform. Falling or touching a spinner puts you on your last checkpoint.
----------------------------------------------------------------------------------------------------
local OBBY_COLORS = {
	Color3.fromRGB(86, 168, 255),
	Color3.fromRGB(255, 124, 178),
	Color3.fromRGB(255, 205, 80),
	Color3.fromRGB(110, 220, 160),
	Color3.fromRGB(176, 140, 255),
}
local OBBY_CHECKPOINTS = 5
local OBBY_BOX = { X0 = -30, X1 = 340, Z0 = 66, Z1 = 396 }

local obbyModel: Model? = nil
local obbyOpen = false -- built and playable
local obbyBeat: RBXScriptConnection? = nil
local obbyProgress: { [number]: number } = {} -- userId -&gt; highest checkpoint reached
local obbySpawnAt: { [number]: CFrame } = {}
local obbyLastPrize: { [number]: number } = {}

local function playerOfPart(hit: BasePart): Player?
	local character = hit:FindFirstAncestorOfClass("Model")
	return if character then Players:GetPlayerFromCharacter(character) else nil
end

local function onTouch(part: BasePart, fn: (BasePart) -&gt; ())
	pcall(function()
		part.Touched:Connect(fn)
	end)
end

local function notifyPlayer(player: Player, text: string, kind: string)
	pcall(function()
		Remotes.Event("Notify"):FireClient(player, text, kind)
	end)
end

local function sendToLobbySpawn(player: Player)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return
	end
	local angle = math.random() * math.pi * 2
	local pos = Vector3.new(ORIGIN.X + SPAWN.X + math.cos(angle) * 6, ORIGIN.Y + 4, ORIGIN.Z + SPAWN.Z + math.sin(angle) * 6)
	;(character :: Model):PivotTo(CFrame.lookAt(pos, pos + Vector3.new(0, 0, -10)))
	root.AssemblyLinearVelocity = Vector3.zero
end

local function sendToCheckpoint(player: Player)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local cf = obbySpawnAt[player.UserId]
	if not root then
		return
	end
	if not obbyOpen or not cf then
		-- no checkpoint yet: the start pad
		local pad = if obbyModel then obbyModel:FindFirstChild("Start") :: BasePart? else nil
		if pad and obbyOpen then
			cf = pad.CFrame
		else
			sendToLobbySpawn(player)
			return
		end
	end
	;(character :: Model):PivotTo((cf :: CFrame) + Vector3.new(0, 4, 0))
	root.AssemblyLinearVelocity = Vector3.zero
end

local function constructObby(parent: Instance): { Model: Model, Parts: { BasePart } }
	local model = mk("Model", { Name = "Obby" }, parent) :: Model
	local colorIndex = 0
	local function nextColor(): Color3
		colorIndex = colorIndex % #OBBY_COLORS + 1
		return OBBY_COLORS[colorIndex]
	end
	-- A chunky platform: a coloured slab with a darker underside (top surface at yTop). extra.Bare:
	-- no underside (parts that move or vanish).
	local function plat(name: string, cx: number, yTop: number, cz: number, sx: number, sz: number, color: Color3?, extra: { [string]: any }?): BasePart
		local c = color or nextColor()
		local top = mkPart("Part", {
			Name = name,
			Size = Vector3.new(sx, 2, sz),
			CFrame = at(cx, yTop - 1, cz),
			Color = c,
			Material = LOW,
			CanTouch = true,
		}, model)
		if extra then
			for k, v in extra do
				if k ~= "Bare" then
					(top :: any)[k] = v
				end
			end
		end
		if not (extra and extra.Bare) then
			mkPart("Part", { Name = "Underside", Size = Vector3.new(sx - 1.2, 1.2, sz - 1.2), CFrame = at(cx, yTop - 2.7, cz), Color = shadeColor(c, 0.55), Material = LOW, CanCollide = false, CanQuery = false, CastShadow = false }, model)
		end
		return top
	end
	local killParts: { BasePart } = {}
	local function kill(name: string, size: Vector3, cf: CFrame, color: Color3): BasePart
		local part = mkPart("Part", {
			Name = name,
			Size = size,
			CFrame = cf,
			Color = color,
			Material = Enum.Material.Neon,
			CanTouch = true,
			CanCollide = false,
			CastShadow = false,
		}, model)
		table.insert(killParts, part)
		return part
	end
	local checkpointPads: { BasePart } = {}
	local function checkpoint(index: number, cx: number, yTop: number, cz: number)
		local pad = plat("Checkpoint" .. index, cx, yTop, cz, 20, 20, Color3.fromRGB(70, 205, 130))
		pad:SetAttribute("Index", index)
		-- A glowing flag so it reads from far away (pole and flag don't share any face).
		mkPart("Part", decor({ Name = "FlagPole", Size = Vector3.new(0.6, 12, 0.6), CFrame = at(cx - 8, yTop + 6.2, cz - 8), Color = Color3.fromRGB(240, 240, 240), Material = LOW }), model)
		mkPart("Part", decor({ Name = "Flag", Size = Vector3.new(0.3, 4, 6), CFrame = at(cx - 8, yTop + 10, cz - 4.8), Color = Color3.fromRGB(255, 255, 255), Material = Enum.Material.Neon }), model)
		worldSign(pad, "CHECKPOINT " .. index, 22, 4, 16, Color3.fromRGB(150, 255, 190))
		table.insert(checkpointPads, pad)
	end

	local Y = 0.2

	-- Start: a wide pad on the table's edge with a gate and a sign (the sign hangs ABOVE the gate beam).
	local startPad = plat("Start", 0, Y, 92.4, 28, 24, Color3.fromRGB(255, 255, 255))
	for _, sx in { -13, 13 } do
		mkPart("Part", decor({ Name = "GatePost", Size = Vector3.new(2, 22, 2), CFrame = at(sx, Y + 11, 92.4), Color = Color3.fromRGB(255, 205, 80), Material = LOW }), model)
	end
	local gateBeam = mkPart("Part", decor({ Name = "GateBeam", Size = Vector3.new(31, 5, 3.4), CFrame = at(0, Y + 23.5, 92.4), Color = Color3.fromRGB(255, 124, 178), Material = LOW }), model)
	worldSign(gateBeam, "OBBY", 26, 7, 8, Color3.fromRGB(255, 255, 255))
	worldSign(startPad, "Reach the top for a prize!", 24, 3, 9, Color3.fromRGB(255, 232, 140))

	-- Stage 1: hops (6 platforms, 6-stud gaps).
	do
		local dx = { 0, -7, 0, 7, 0, -6 }
		local dy = { 0, 0, 1.5, 3, 3, 1.5 }
		for i = 1, 6 do
			plat("Hop" .. i, dx[i], Y + dy[i], 113 + (i - 1) * 15, 9, 9)
		end
	end
	checkpoint(1, -2, Y + 1.5, 210)

	-- Stage 2: stepping stones over the drop (a fall puts you back).
	do
		local dx = { 0, -8, 0, 8, 0 }
		for i = 1, 5 do
			plat("Stone" .. i, dx[i], Y + 1.5, 226 + (i - 1) * 14, 7, 7)
		end
	end
	checkpoint(2, 0, Y + 1.5, 298)

	-- Stage 3: the spinner deck (jump the bars), running along +X.
	plat("SpinnerDeck", 66, Y + 1.5, 300, 104, 16, Color3.fromRGB(255, 255, 255))
	local spinners: { { Part: BasePart, Speed: number, Center: Vector3 } } = {}
	for i, x in { 38, 66, 94 } do
		local center = at(x, Y + 1.5 + 2.2, 300).Position
		local bar = kill("Spinner" .. i, Vector3.new(26, 3, 2.4), CFrame.new(center), if i % 2 == 0 then Color3.fromRGB(255, 70, 90) else Color3.fromRGB(255, 190, 50))
		mkPart("Part", decor({ Name = "SpinnerHub", Size = Vector3.new(4, 4.4, 4), CFrame = CFrame.new(center), Color = Color3.fromRGB(60, 64, 78), Material = LOW }), model)
		table.insert(spinners, { Part = bar, Speed = (if i % 2 == 0 then -1 else 1) * (1.1 + i * 0.35), Center = center })
	end
	checkpoint(3, 134, Y + 1.5, 300)

	-- Stage 4: three sliders crossing the way (they carry you).
	local sliders: { { Part: BasePart, Base: Vector3, Phase: number, Speed: number } } = {}
	for i, x in { 156, 171, 186 } do
		local p = plat("Slider" .. i, x, Y + 1.5, 300, 8, 8, nil, { Bare = true })
		table.insert(sliders, { Part = p, Base = p.Position, Phase = i * 1.7, Speed = 0.9 + i * 0.12 })
	end
	checkpoint(4, 206, Y + 1.5, 300)

	-- Stage 5: vanishing tiles (they go almost the moment you touch them).
	local tiles: { BasePart } = {}
	for col = 1, 4 do
		for row = -1, 1 do
			table.insert(tiles, plat("Tile", 226 + (col - 1) * 11, Y + 1.5, 300 + row * 11, 8.5, 8.5, Color3.fromRGB(255, 228, 120), { Bare = true }))
		end
	end

	-- Stage 6: a conveyor belt that runs against you.
	local conveyor = plat("Conveyor", 285, Y + 1.5, 300, 30, 12, Color3.fromRGB(70, 74, 92), { Bare = true })
	for i = -2, 2 do
		mkPart("Part", decor({ Name = "ConveyorStripe", Size = Vector3.new(1.4, 0.2, 11), CFrame = at(285 + i * 6, Y + 1.6, 300), Color = Color3.fromRGB(255, 205, 60), Material = LOW }), model)
	end
	plat("Landing", 312, Y + 1.5, 300, 12, 12, nil)

	-- Stage 7: balance beams (round the corner and back over the sofa): thin ones.
	plat("Beam1", 312, Y + 3, 322, 0.8, 32, Color3.fromRGB(255, 255, 255), { Bare = true })
	plat("Corner", 312, Y + 3, 345, 10, 10, nil)
	plat("Beam2a", 275.5, Y + 3, 345, 51, 0.8, Color3.fromRGB(255, 255, 255), { Bare = true })
	plat("Beam2b", 220, Y + 3, 345, 48, 0.8, Color3.fromRGB(255, 255, 255), { Bare = true })
	checkpoint(5, 180, Y + 3, 345)

	-- Stage 8: the climb: stairs of small platforms up to the finish.
	for i = 1, 8 do
		plat("Stair" .. i, 180 - 10 - i * 11, Y + 3 + i * 3.5, 345 + (if i % 2 == 0 then 3 else -3), 7, 7)
	end
	local finishTop = Y + 3 + 8 * 3.5 + 3
	local finish = plat("Finish", 56, finishTop, 345, 24, 24, Color3.fromRGB(255, 205, 60))
	for _, dz in { -10, 10 } do
		mkPart("Part", decor({ Name = "FinishPost", Size = Vector3.new(2, 18, 2), CFrame = at(56, finishTop + 9, 345 + dz), Color = Color3.fromRGB(255, 124, 178), Material = LOW }), model)
	end
	local arch = mkPart("Part", decor({ Name = "FinishArch", Size = Vector3.new(3.4, 4, 22.6), CFrame = at(56, finishTop + 19.5, 345), Color = Color3.fromRGB(255, 124, 178), Material = LOW }), model)
	worldSign(arch, "FINISH", 24, 7, 8, Color3.fromRGB(255, 255, 255))
	-- The trophy: a gold cup of stacked blocks.
	mkPart("Part", decor({ Name = "TrophyBase", Size = Vector3.new(6, 2, 6), CFrame = at(56, finishTop + 1, 345), Color = Color3.fromRGB(120, 80, 50), Material = LOW }), model)
	mkPart("Part", decor({ Name = "TrophyStem", Size = Vector3.new(2, 4, 2), CFrame = at(56, finishTop + 4, 345), Color = Color3.fromRGB(255, 205, 60), Material = Enum.Material.Metal }), model)
	mkPart("Part", decor({ Name = "TrophyCup", Size = Vector3.new(6.4, 5, 6.4), CFrame = at(56, finishTop + 8.6, 345), Color = Color3.fromRGB(255, 215, 80), Material = Enum.Material.Metal }), model)

	-- ----- Runtime ----------------------------------------------------------------------------
	for _, pad in checkpointPads do
		onTouch(pad, function(hit)
			local player = playerOfPart(hit)
			local index = pad:GetAttribute("Index")
			if obbyOpen and player and type(index) == "number" and (obbyProgress[player.UserId] or 0) &lt; index then
				obbyProgress[player.UserId] = index
				obbySpawnAt[player.UserId] = pad.CFrame + Vector3.new(0, 1, 0)
				notifyPlayer(player, string.format("Checkpoint %d of %d!", index, OBBY_CHECKPOINTS), "Good")
			end
		end)
	end
	local lastHit: { [number]: number } = {}
	for _, part in killParts do
		onTouch(part, function(hit)
			local player = playerOfPart(hit)
			if obbyOpen and player and os.clock() - (lastHit[player.UserId] or 0) &gt; 0.6 then
				lastHit[player.UserId] = os.clock()
				sendToCheckpoint(player)
			end
		end)
	end
	onTouch(finish, function(hit)
		local player = playerOfPart(hit)
		if not obbyOpen or not player or (obbyProgress[player.UserId] or 0) &lt; OBBY_CHECKPOINTS then
			return
		end
		obbyProgress[player.UserId] = 0
		obbySpawnAt[player.UserId] = nil
		local show = ReplicatedStorage:GetAttribute("AbuseObbyOpen") == true
		local last = obbyLastPrize[player.UserId] or -1e9
		local gems = if show then Config.Obby.ShowGems else Config.Obby.Gems
		if show or os.clock() - last &gt; Config.Obby.Cooldown then
			obbyLastPrize[player.UserId] = os.clock()
			task.spawn(function()
				local okData, DataService = pcall(function()
					return require(script.Parent:WaitForChild("DataService"))
				end)
				local okGift, GiftService = pcall(function()
					return require(script.Parent:WaitForChild("GiftService"))
				end)
				if okData then
					DataService.AddGems(player, gems)
				end
				if okGift and not show then
					-- (during the show the director shows ONE popup for it: first finisher or not)
					(GiftService :: any).Celebrate(player, "You beat the obby!", string.format("You got %d Gems!", gems), "@Gem")
				end
			end)
			-- The show hears who finished (it announces and rewards the first one in every server).
			ReplicatedStorage:SetAttribute("AbuseObbyFinish", player.Name .. ":" .. tostring(os.clock()))
		else
			notifyPlayer(player, "You finished! (Prize again in a few minutes)", "Info")
		end
		-- Back to the lobby spawn (a moment later, so the popup isn't fighting the teleport).
		task.delay(0.8, function()
			sendToLobbySpawn(player)
		end)
	end)

	local tileBusy: { [BasePart]: boolean } = {}
	for _, t in tiles do
		onTouch(t, function(hit)
			if tileBusy[t] or not obbyOpen or not playerOfPart(hit) then
				return
			end
			tileBusy[t] = true
			task.delay(0.1, function()
				TweenService:Create(t, TweenInfo.new(0.12), { Transparency = 1 }):Play()
				task.wait(0.12)
				t.CanCollide = false
				task.wait(2.4)
				if t.Parent then
					t.CanCollide = true
					TweenService:Create(t, TweenInfo.new(0.25), { Transparency = 0 }):Play()
				end
				tileBusy[t] = false
			end)
		end)
	end
	pcall(function()
		conveyor.AssemblyLinearVelocity = Vector3.new(-15, 0, 0) -- anchored parts still carry whoever stands on them
	end)

	-- The moving parts, once a frame. Sliders carry the players standing on them.
	local beat: any = RunService.Heartbeat
	local clock, fallClock = 0, 0
	if beat then
		obbyBeat = beat:Connect(function(dt)
			clock += dt
			fallClock += dt
			for _, s in spinners do
				s.Part.CFrame = CFrame.new(s.Center) * CFrame.Angles(0, clock * s.Speed, 0)
			end
			for _, s in sliders do
				-- The platform is moved by position AND given its velocity: the Humanoid carries whoever
				-- stands on it by the floor's velocity (moving the character from the server fights the
				-- player's own physics and rubber-bands).
				local p = s.Part
				local phase = clock * s.Speed + s.Phase
				p.Position = s.Base + Vector3.new(0, 0, 13 * math.sin(phase))
				p.AssemblyLinearVelocity = Vector3.new(0, 0, 13 * s.Speed * math.cos(phase))
			end
			if fallClock &gt; 0.3 then
				fallClock = 0
				for _, player in Players:GetPlayers() do
					local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
					if root and obbyOpen then
						local p = root.Position - ORIGIN
						if p.Y &lt; -35 and p.Y &gt; -125 and p.X &gt; OBBY_BOX.X0 and p.X &lt; OBBY_BOX.X1 and p.Z &gt; OBBY_BOX.Z0 and p.Z &lt; OBBY_BOX.Z1 then
							sendToCheckpoint(player)
						end
					end
				end
			end
		end)
	end

	local parts: { BasePart } = {}
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			table.insert(parts, d)
		end
	end
	return { Model = model, Parts = parts }
end

-- Builds the obby up piece by piece (about 10 seconds), then it is playable. The gate in the table's
-- edge wall opens.
function LobbyBuilder.OpenObby()
	if obbyModel or not lobby then
		return
	end
	local built = constructObby(lobby.Model)
	obbyModel = built.Model
	local n = #built.Parts
	for i, part in built.Parts do
		local finalCF, finalT, finalCollide = part.CFrame, part.Transparency, part.CanCollide
		if finalT &lt; 0.95 and not rawget(_G, "__RINSE_NO_ANIM") then
			part.Transparency = 1
			part.CanCollide = false
			part.CFrame = finalCF - Vector3.new(0, 45, 0)
			task.delay((i / n) * 9, function()
				if not part.Parent or not obbyModel then
					return
				end
				local tween = TweenService:Create(part, TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Transparency = finalT, CFrame = finalCF })
				tween.Completed:Connect(function()
					if part.Parent then
						part.CanCollide = finalCollide
					end
				end)
				tween:Play()
			end)
		end
	end
	task.delay(10, function()
		if obbyModel == built.Model then
			obbyOpen = true
			local wall = southWall
			if wall then
				wall.CanCollide = false
			end
		end
	end)
end

function LobbyBuilder.ObbyExists(): boolean
	return obbyModel ~= nil
end

-- Smashes it: every piece drops to the floor, then fades away; the table's edge wall closes again.
function LobbyBuilder.BreakObby()
	local model = obbyModel
	if not model then
		return
	end
	obbyOpen = false
	obbyModel = nil
	if obbyBeat then
		obbyBeat:Disconnect()
		obbyBeat = nil
	end
	table.clear(obbyProgress)
	table.clear(obbySpawnAt)
	local wall = southWall
	if wall then
		wall.CanCollide = true
	end
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			if d.Transparency &gt;= 0.95 then
				d:Destroy()
			else
				task.delay(math.random() * 2, function()
					if not d.Parent then
						return
					end
					d.Anchored = false
					d.CanCollide = true
					d.CanTouch = false
					d.AssemblyLinearVelocity = Vector3.new(math.random(-30, 30), math.random(5, 35), math.random(-30, 30))
					d.AssemblyAngularVelocity = Vector3.new(math.random(-6, 6), math.random(-6, 6), math.random(-6, 6))
				end)
			end
		end
	end
	task.delay(6, function()
		for _, d in model:GetDescendants() do
			if d:IsA("BasePart") then
				TweenService:Create(d, TweenInfo.new(2.4), { Transparency = 1 }):Play()
			end
		end
	end)
	task.delay(9, function()
		model:Destroy()
	end)
end

----------------------------------------------------------------------------------------------------
-- Holes in the table (Admin Abuse). Config.AbuseShow.Holes = { { x, z, radius } }. The table top,
-- slab and the invisible floor under it are cut into small tiles around the spot: the tiles inside
-- the circle fall away, the ones on the rim tilt and crack, things standing there fall too, and
-- HealHoles puts it all back (the hole closes in from the rim, the props return).
----------------------------------------------------------------------------------------------------
type Tile = { Part: BasePart, Flat: CFrame, D: number, Fall: boolean, Transparency: number }
type HoleRec = {
	Hidden: { BasePart },
	Pieces: { Instance },
	Tiles: { Tile },
	Props: { { Part: BasePart, CF: CFrame, Anchored: boolean, Collide: boolean } },
	Cracks: { BasePart },
	Center: Vector3,
	Radius: number,
}
local holes: { [number]: HoleRec } = {}
local TABLE_PART_NAMES = { SafetyFloor = true, TableSlab = true, Plank = true, Chamfer = true }
local TILE = 5.5

local function worldBox(part: BasePart): (Vector3, Vector3)
	local cf, s = part.CFrame, part.Size
	local ex = (math.abs(cf.RightVector.X) * s.X + math.abs(cf.UpVector.X) * s.Y + math.abs(cf.LookVector.X) * s.Z) / 2
	local ey = (math.abs(cf.RightVector.Y) * s.X + math.abs(cf.UpVector.Y) * s.Y + math.abs(cf.LookVector.Y) * s.Z) / 2
	local ez = (math.abs(cf.RightVector.Z) * s.X + math.abs(cf.UpVector.Z) * s.Y + math.abs(cf.LookVector.Z) * s.Z) / 2
	return cf.Position, Vector3.new(ex, ey, ez)
end

-- Makes `clone` the box [x0,x1] x [y0,y1] x [z0,z1] in world space (the source part's own turn kept).
local function setBox(clone: BasePart, source: BasePart, x0: number, x1: number, y0: number, y1: number, z0: number, z1: number)
	local rot = source.CFrame.Rotation
	local swapped = math.abs(rot.RightVector.X) &lt; 0.5
	local wx, wy, wz = x1 - x0, y1 - y0, z1 - z0
	clone.Size = if swapped then Vector3.new(wz, wy, wx) else Vector3.new(wx, wy, wz)
	clone.CFrame = CFrame.new((x0 + x1) / 2, (y0 + y1) / 2, (z0 + z1) / 2) * rot
end

local ROOF_PART_NAMES = { Ceiling = true, CeilingBeam = true, Crown = true }

-- Cuts a round hole (tiles fall, rim tilts) in the named parts around (x, z). opts.Roof: the ceiling
-- (bigger tiles, no props / cracks / glow, and the falling tiles never collide with anyone).
local function cutDisc(index: number, holeX: number, holeZ: number, R: number, names: { [string]: boolean }, opts: { Roof: boolean? })
	local model = lobby and lobby.Model
	if not model or holes[index] then
		return
	end
	local roof = opts.Roof == true
	local TILE = if roof then 11 else TILE
	local cx, cz = ORIGIN.X + holeX, ORIGIN.Z + holeZ
	local S = R + 10
	local rec: HoleRec = { Hidden = {}, Pieces = {}, Tiles = {}, Props = {}, Cracks = {}, Center = Vector3.new(cx, ORIGIN.Y, cz), Radius = R }
	holes[index] = rec
	local folder = mk("Folder", { Name = "HolePieces" .. index }, Workspace) :: Folder
	table.insert(rec.Pieces, folder)

	-- Anyone close to it is moved clear first.
	for _, player in Players:GetPlayers() do
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root then
			local offset = Vector3.new(root.Position.X - cx, 0, root.Position.Z - cz)
			if offset.Magnitude &lt; R + 6 and root.Position.Y &lt; 60 then
				local dir = if offset.Magnitude &gt; 0.5 then offset.Unit else Vector3.new(0, 0, 1)
				local out = Vector3.new(cx, 0, cz) + dir * (R + 18)
				;(player.Character :: Model):PivotTo(CFrame.new(out.X, root.Position.Y + 2, out.Z))
			end
		end
	end

	local sources: { BasePart } = {}
	for _, p in model:GetChildren() do
		if p:IsA("BasePart") and names[p.Name] then
			local c, e = worldBox(p)
			if c.X + e.X &gt; cx - S and c.X - e.X &lt; cx + S and c.Z + e.Z &gt; cz - S and c.Z - e.Z &lt; cz + S then
				table.insert(sources, p)
			end
		end
	end
	local rng = Random.new(index * 97 + 5)
	for _, p in sources do
		local c, e = worldBox(p)
		local invisible = p.Transparency &gt;= 0.95
		local px0, px1, pz0, pz1 = c.X - e.X, c.X + e.X, c.Z - e.Z, c.Z + e.Z
		local y0, y1 = c.Y - e.Y, c.Y + e.Y
		local ix0, ix1 = math.max(px0, cx - S), math.min(px1, cx + S)
		local iz0, iz1 = math.max(pz0, cz - S), math.min(pz1, cz + S)
		local function piece(x0: number, x1: number, z0: number, z1: number): BasePart
			local clone = p:Clone() :: BasePart
			clone.Name = "HolePiece"
			setBox(clone, p, x0, x1, y0, y1, z0, z1)
			clone.Parent = folder
			return clone
		end
		if px0 &lt; ix0 - 0.01 then
			piece(px0, ix0, pz0, pz1)
		end
		if px1 &gt; ix1 + 0.01 then
			piece(ix1, px1, pz0, pz1)
		end
		if pz0 &lt; iz0 - 0.01 then
			piece(ix0, ix1, pz0, iz0)
		end
		if pz1 &gt; iz1 + 0.01 then
			piece(ix0, ix1, iz1, pz1)
		end
		local x = ix0
		while x &lt; ix1 - 0.01 do
			local x1 = math.min(x + TILE, ix1)
			local z = iz0
			while z &lt; iz1 - 0.01 do
				local z1 = math.min(z + TILE, iz1)
				local tcx, tcz = (x + x1) / 2, (z + z1) / 2
				local d = math.sqrt((tcx - cx) ^ 2 + (tcz - cz) ^ 2) + (rng:NextNumber() - 0.5) * 6
				if d &lt; R then
					if not invisible then
						local tile = piece(x, x1, z, z1)
						local flat = tile.CFrame
						tile.Anchored = false
						tile.CanCollide = not roof
						table.insert(rec.Tiles, { Part = tile, Flat = flat, D = d, Fall = true, Transparency = tile.Transparency })
						tile.AssemblyLinearVelocity = Vector3.new(rng:NextNumber(-8, 8), rng:NextNumber(-4, 6), rng:NextNumber(-8, 8))
						tile.AssemblyAngularVelocity = Vector3.new(rng:NextNumber(-3, 3), rng:NextNumber(-3, 3), rng:NextNumber(-3, 3))
					end
				else
					local tile = piece(x, x1, z, z1)
					if d &lt; R + 9 and not invisible then
						-- the broken rim: crooked, a little sunk
						local flat = tile.CFrame
						local axis = Vector3.new(rng:NextNumber(-1, 1), 0, rng:NextNumber(-1, 1))
						axis = if axis.Magnitude &gt; 0.1 then axis.Unit else Vector3.xAxis
						tile.CFrame = flat * CFrame.fromAxisAngle(flat:VectorToObjectSpace(axis), math.rad(rng:NextNumber(3, 9))) - Vector3.new(0, rng:NextNumber(0.1, 0.7), 0)
						table.insert(rec.Tiles, { Part = tile, Flat = flat, D = d, Fall = false, Transparency = tile.Transparency })
					end
				end
				z = z1
			end
			x = x1
		end
		p.Parent = nil
		table.insert(rec.Hidden, p)
	end

	if not roof then
		-- Cracks across the table around the rim.
		for i = 1, 16 do
			local a = rng:NextNumber(0, math.pi * 2)
			local len = rng:NextNumber(8, 22)
			local mid = R + 2 + len / 2
			local crack = mkPart("Part", {
				Name = "HoleCrack",
				Size = Vector3.new(rng:NextNumber(0.5, 1.1), 0.1, len),
				CFrame = CFrame.new(cx + math.cos(a) * mid, ORIGIN.Y + FLOOR_Y + 0.06, cz + math.sin(a) * mid) * CFrame.Angles(0, -a + math.pi / 2 + rng:NextNumber(-0.25, 0.25), 0),
				Color = Color3.fromRGB(34, 20, 14),
				Material = LOW,
				CanCollide = false,
				CastShadow = false,
			}, folder)
			table.insert(rec.Cracks, crack)
		end
		-- A glow and smoke from below.
		local glow = mkPart("Part", { Name = "HoleGlow", Size = Vector3.new(2, 2, 2), CFrame = CFrame.new(cx, ORIGIN.Y - 14, cz), Transparency = 1, CanCollide = false, CastShadow = false }, folder)
		mk("PointLight", { Color = Color3.fromRGB(255, 120, 50), Range = 70, Brightness = 3, Shadows = false }, glow)
		mk("ParticleEmitter", {
			Texture = "rbxasset://textures/particles/smoke_main.dds",
			Color = ColorSequence.new(Color3.fromRGB(60, 50, 46)),
			Lifetime = NumberRange.new(2, 3.5),
			Speed = NumberRange.new(10, 22),
			SpreadAngle = Vector2.new(20, 20),
			Rate = 14,
			Size = NumberSequence.new(6, 16),
			Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.55), NumberSequenceKeypoint.new(1, 1) }),
			EmissionDirection = Enum.NormalId.Top,
		}, glow)
		mk("ParticleEmitter", {
			Texture = "rbxasset://textures/particles/sparkles_main.dds",
			Color = ColorSequence.new(Color3.fromRGB(255, 170, 70)),
			Lifetime = NumberRange.new(1, 2),
			Speed = NumberRange.new(20, 40),
			SpreadAngle = Vector2.new(35, 35),
			Rate = 18,
			Size = NumberSequence.new(1.6, 0),
			LightEmission = 1,
			EmissionDirection = Enum.NormalId.Top,
		}, glow)

		-- Whatever stands in it falls with it (boards, cups, sponge, shakers...).
		for _, d in model:GetDescendants() do
			if d:IsA("BasePart") and d.Anchored and d.Transparency &lt; 0.95 and d.Name ~= "Barrier" and not string.find(d.Name, "^Bubble") and not TABLE_PART_NAMES[d.Name] and d.Size.Y &lt; 70 then
				local dx, dz = d.Position.X - cx, d.Position.Z - cz
				local y = d.Position.Y - ORIGIN.Y
				if math.sqrt(dx * dx + dz * dz) &lt; R + 4 and y &gt; -1 and y &lt; 60 and not d:IsDescendantOf(folder) then
					table.insert(rec.Props, { Part = d, CF = d.CFrame, Anchored = d.Anchored :: boolean, Collide = d.CanCollide })
				end
			end
		end
		for _, prop in rec.Props do
			task.delay(rng:NextNumber(0.1, 0.9), function()
				prop.Part.Anchored = false
				prop.Part.CanCollide = true
				prop.Part.AssemblyAngularVelocity = Vector3.new(rng:NextNumber(-2, 2), rng:NextNumber(-2, 2), rng:NextNumber(-2, 2))
			end)
		end
		-- Chunks flung out of it.
		for i = 1, 20 do
			local size = rng:NextNumber(1.2, 3.6)
			local chunk = mkPart("Part", {
				Name = "HoleChunk",
				Size = Vector3.new(size, size * 0.6, size * 1.3),
				CFrame = CFrame.new(cx + rng:NextNumber(-R * 0.6, R * 0.6), ORIGIN.Y + 2, cz + rng:NextNumber(-R * 0.6, R * 0.6)),
				Color = if i % 3 == 0 then WOOD_DARK else WOOD_A,
				Material = LOW,
				Anchored = false,
			}, folder)
			chunk.AssemblyLinearVelocity = Vector3.new(rng:NextNumber(-40, 40), rng:NextNumber(40, 90), rng:NextNumber(-40, 40))
			chunk.AssemblyAngularVelocity = Vector3.new(rng:NextNumber(-8, 8), rng:NextNumber(-8, 8), rng:NextNumber(-8, 8))
			task.delay(7, function()
				if chunk.Parent then
					TweenService:Create(chunk, TweenInfo.new(1.5), { Transparency = 1 }):Play()
					task.wait(1.6)
					chunk:Destroy()
				end
			end)
		end
	end
	-- The fallen tiles lie on the floor a while, then fade (kept for the repair).
	task.delay(7, function()
		for _, tile in rec.Tiles do
			if tile.Fall and tile.Part.Parent then
				TweenService:Create(tile.Part, TweenInfo.new(1.5), { Transparency = 1 }):Play()
			end
		end
		task.wait(1.6)
		for _, tile in rec.Tiles do
			if tile.Fall then
				tile.Part.Anchored = true
				tile.Part.Parent = nil
			end
		end
	end)
end

function LobbyBuilder.OpenHole(index: number)
	local def = (Config.AbuseShow :: any).Holes[index]
	if def then
		cutDisc(index, def[1], def[2], def[3], TABLE_PART_NAMES, {})
	end
end

-- A hole in the ceiling (the giant's exit). It heals with HealRoof (or HealHoles).
function LobbyBuilder.OpenRoofHole(x: number, z: number, radius: number)
	cutDisc(100, x, z, radius, ROOF_PART_NAMES, { Roof = true })
end

-- Everything comes back: the hole closes in from its rim over `seconds`, cracks fade, props return.
local function healRec(index: number, rec: HoleRec, total: number)
	do
		holes[index] = nil
		local folder = rec.Pieces[1]
		for _, crack in rec.Cracks do
			TweenService:Create(crack, TweenInfo.new(total * 0.6), { Transparency = 1 }):Play()
		end
		-- the fallen tiles reappear (outer ones first)
		local fallen = {}
		for _, tile in rec.Tiles do
			if tile.Fall then
				table.insert(fallen, tile)
			end
		end
		table.sort(fallen, function(a, b)
			return a.D &gt; b.D
		end)
		for i, tile in fallen do
			task.delay((i / math.max(1, #fallen)) * total * 0.7, function()
				local part = tile.Part
				part.Anchored = true
				part.CanCollide = true
				part.AssemblyLinearVelocity = Vector3.zero
				part.AssemblyAngularVelocity = Vector3.zero
				part.CFrame = tile.Flat
				part.Transparency = 1
				part.Parent = folder
				TweenService:Create(part, TweenInfo.new(0.9), { Transparency = tile.Transparency }):Play()
			end)
		end
		for _, tile in rec.Tiles do
			if not tile.Fall then
				TweenService:Create(tile.Part, TweenInfo.new(total * 0.5, Enum.EasingStyle.Quad), { CFrame = tile.Flat }):Play()
			end
		end
		task.delay(total * 0.8, function()
			for _, prop in rec.Props do
				prop.Part.Anchored = true
				prop.Part.AssemblyLinearVelocity = Vector3.zero
				prop.Part.AssemblyAngularVelocity = Vector3.zero
				prop.Part.CFrame = prop.CF
				prop.Part.CanCollide = prop.Collide
			end
		end)
		-- Finally the original parts go back (they are exactly what the pieces looked like).
		task.delay(total + 1.5, function()
			local model = lobby and lobby.Model
			for _, p in rec.Hidden do
				p.Parent = model
			end
			if folder then
				folder:Destroy()
			end
			for _, prop in rec.Props do
				prop.Part.Anchored = prop.Anchored
			end
		end)
	end
end

function LobbyBuilder.HealHoles(seconds: number?)
	for index, rec in holes do
		healRec(index, rec, seconds or 8)
	end
end

function LobbyBuilder.HealRoof(seconds: number?)
	local rec = holes[100]
	if rec then
		healRec(100, rec, seconds or 4)
	end
end

-- The invisible walls round the table: open (no collision) for the whole Admin Abuse show, then closed
-- again; anyone left outside when they close is put back at the spawn.
function LobbyBuilder.SetBarriers(open: boolean)
	local model = lobby and lobby.Model
	if not model then
		return
	end
	for _, d in model:GetChildren() do
		if d:IsA("BasePart") and d.Name == "Barrier" then
			d.CanCollide = not open
		end
	end
	if not open then
		for _, player in Players:GetPlayers() do
			local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if root then
				local p = root.Position - ORIGIN
				if math.abs(p.X) &gt; PLAZA_X + FENCE_MARGIN or p.Z &lt; PLAZA_Z0 - FENCE_MARGIN or p.Z &gt; PLAZA_Z1 + FENCE_MARGIN or p.Y &lt; -20 then
					sendToLobbySpawn(player)
				end
			end
		end
	end
end

-- While the show runs: anyone who ends up below the table (fell off an edge, into a hole...) is put
-- back at the spawn. Inside the obby's area they go to their checkpoint instead (see the obby).
local rescueBeat: RBXScriptConnection? = nil
function LobbyBuilder.SetRescue(on: boolean)
	if rescueBeat then
		rescueBeat:Disconnect()
		rescueBeat = nil
	end
	local beat: any = RunService.Heartbeat
	if not on or not beat then
		return
	end
	local clock = 0
	rescueBeat = beat:Connect(function(dt)
		clock += dt
		if clock &lt; 0.4 then
			return
		end
		clock = 0
		for _, player in Players:GetPlayers() do
			local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if root then
				local p = root.Position - ORIGIN
				local inObbyBox = p.X &gt; OBBY_BOX.X0 and p.X &lt; OBBY_BOX.X1 and p.Z &gt; OBBY_BOX.Z0 and p.Z &lt; OBBY_BOX.Z1
				local inTable = math.abs(p.X) &lt; 150 and p.Z &gt; -150 and p.Z &lt; OBBY_BOX.Z1
				if p.Y &lt; -30 and p.Y &gt; -125 and (inTable or inObbyBox) and not (inObbyBox and obbyOpen) then
					sendToLobbySpawn(player)
				end
			end
		end
	end)
end

----------------------------------------------------------------------------------------------------
-- Build() / GetLobby() / GetSpawnCFrame()
----------------------------------------------------------------------------------------------------

-- Builds the whole lobby under workspace.Lobby. Safe to call once; a second call just returns the
-- existing Lobby table without building anything again.
function LobbyBuilder.Build(): Lobby
	if lobby then
		return lobby
	end

	local oldBase = Workspace:FindFirstChild("Baseplate")
	if oldBase then
		oldBase:Destroy()
	end
	local oldSpawn = Workspace:FindFirstChild("SpawnLocation")
	if oldSpawn and oldSpawn:IsA("BasePart") then
		oldSpawn:Destroy()
	end

	local model = Instance.new("Model")
	model.Name = "Lobby"
	model.Parent = Workspace

	-- Spawn first, so a player who spawns mid-build has a floor under them.
	buildSpawn(model)
	buildGround(model)
	buildRoom(model)

	local pads: { PadInfo } = {}
	for i = 1, PAD_COUNT do
		pads[i] = buildPad(model, i)
	end

	buildDishwasherBuilding(model)
	buildEggHatchery(model)
	buildSoapShop(model)
	buildPetStand(model)
	buildRoofLadder(model)

	-- Leaderboards in the back corners, angled at the middle of the plaza; How to Play beside the
	-- spawn, facing it. Nothing stands behind the spawn, so the default camera has a clear view.
	local timesBoard = buildBoard(model, -80, -74, "Fastest Clean", 0, 0, #Config.Levels)
	local dishesBoard = buildBoard(model, 80, -74, "Top Players", 0, 0, 3) -- dishes / rebirths / bubbles
	buildHowToPlay(model, 34, 44, SPAWN.X, SPAWN.Z)

	buildRankShrine(model)
	buildRebirthFountain(model)
	buildTreasureChest(model)
	buildEventZone(model)
	buildPathDressing(model)
	buildDecorations(model)
	setupLighting()

	local built: Lobby = {
		Model = model,
		Pads = pads,
		Boards = { Times = timesBoard, Dishes = dishesBoard },
	}
	lobby = built
	-- No Terrain anywhere (it used to cover the table with grass); wipe any saved in the place.
	pcall(function()
		workspace.Terrain:Clear()
	end)
	buildGarden(model)
	return built
end

function LobbyBuilder.GetLobby(): Lobby?
	return lobby
end

-- A random spot on the spawn pad, facing north toward the boards and pads.
function LobbyBuilder.GetSpawnCFrame(): CFrame
	local angle = math.random() * math.pi * 2
	local radius = 2 + math.random() * 8
	local pos = Vector3.new(ORIGIN.X + SPAWN.X + math.cos(angle) * radius, ORIGIN.Y + 3, ORIGIN.Z + SPAWN.Z + math.sin(angle) * radius)
	return CFrame.lookAt(pos, pos + Vector3.new(0, 0, -10))
end

return LobbyBuilder</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000001C"><Properties><string name="Name">LobbyFun</string><ProtectedString name="Source">--[[
	LobbyFun - little things to do in the lobby between runs (Config.LobbyBubbles, Config.Ducks).

	* Poppable soap bubbles float over the plaza. Touch or click one to pop it for +1 Bubble (a rare
	  golden one pays more); it comes back somewhere else a few seconds later. Pops are capped per
	  player per minute so an autoclicker can't farm them.
	* Rubber ducks are hidden around the lobby. Each one pays once (saved in Profile.Ducks); finding
	  them all pays the big reward. Player attribute "DucksFound" (comma list) lets each client hide
	  the ducks it already found.

	The server owns every part (anchored, never moved); clients bob the bubbles locally and add
	their glint (Effects, tag "PopBubble") and play the pop / quack effects from RunFX "LobbyPop" / "Duck".
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local Services = script.Parent
local DataService = require(Services:WaitForChild("DataService"))
local LobbyBuilder = require(Services:WaitForChild("LobbyBuilder"))

local LobbyFun = {}

local FLOOR_Y = 0.2
local BUBBLE_SIZE = 3.4
local GOLDEN_SIZE = 3.8

-- Spots the bubbles keep away from (x, z, radius): props they would sit inside of.
local AVOID = {
	{ -34, 14, 9 }, -- rebirth fountain
	{ -32, 40, 8 }, -- rank shrine
	{ 34, 44, 15 }, -- how-to-play board
	{ -11, -52, 3 },
	{ 11, -52, 3 },
	{ -11, -22, 3 },
	{ 11, -22, 3 }, -- path lamps
}

-- Where each duck sits (feet position) and which way it faces (yaw, degrees; 0 = facing +Z).
local DUCK_SPOTS: { [string]: { Pos: Vector3, Yaw: number, Float: boolean? } } = {
	Fountain = { Pos = Vector3.new(-34, FLOOR_Y + 2.4, 18.6), Yaw = 70, Float = true },
	Doghouse = { Pos = Vector3.new(40, 3, -62.4), Yaw = 0 },
	Sponge = { Pos = Vector3.new(-79, 6.7, 45), Yaw = 160 },
	Board = { Pos = Vector3.new(88, FLOOR_Y, -86), Yaw = 200 },
	Shakers = { Pos = Vector3.new(-44, 55.1, -101.5), Yaw = 130 }, -- on the building's roof, back corner
	Saucer = { Pos = Vector3.new(84.4, FLOOR_Y + 0.8, 56), Yaw = -60 },
}

local folder: Folder? = nil
local fxRemote: RemoteEvent? = nil
local rng = Random.new()
local alive: { [BasePart]: boolean } = {}
local aliveCount = 0
local popLog: { [Player]: { number } } = {}
local duckCooldown: { [Player]: number } = {}

local function fire(kind: string, data: any)
	if fxRemote then
		fxRemote:FireAllClients(kind, data)
	end
end

local function playerFromHit(hit: BasePart): Player?
	local model = hit:FindFirstAncestorOfClass("Model")
	while model and not model:FindFirstChildOfClass("Humanoid") do
		model = model:FindFirstAncestorOfClass("Model")
	end
	return if model then Players:GetPlayerFromCharacter(model) else nil
end

local function nearPlayer(player: Player, pos: Vector3, range: number): boolean
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	return root ~= nil and root:IsA("BasePart") and (root.Position - pos).Magnitude &lt;= range
end

-- Per-player pop cap: true if this pop is allowed (and records it).
local function allowPop(player: Player): boolean
	local now = os.clock()
	local log = popLog[player]
	if not log then
		log = {}
		popLog[player] = log
	end
	while log[1] and now - log[1] &gt; 60 do
		table.remove(log, 1)
	end
	if #log &gt;= Config.LobbyBubbles.PerMinute then
		return false
	end
	table.insert(log, now)
	return true
end

----------------------------------------------------------------------------------------------------
-- Bubbles
----------------------------------------------------------------------------------------------------
local spawnBubble: () -&gt; ()

local function pickSpot(): Vector3?
	for _ = 1, 30 do
		local x, z = rng:NextNumber(-46, 46), rng:NextNumber(-48, 58)
		local ok = true
		for _, a in AVOID do
			if (x - a[1]) ^ 2 + (z - a[2]) ^ 2 &lt; a[3] ^ 2 then
				ok = false
				break
			end
		end
		if ok then
			for part in alive do
				local p = part.Position
				if (p.X - x) ^ 2 + (p.Z - z) ^ 2 &lt; 36 then
					ok = false
					break
				end
			end
		end
		if ok then
			return Vector3.new(x, FLOOR_Y + rng:NextNumber(3.6, 8.6), z)
		end
	end
	return nil
end

local function pop(bubble: BasePart, player: Player)
	if not alive[bubble] then
		return
	end
	if not allowPop(player) then
		return
	end
	alive[bubble] = nil
	aliveCount -= 1
	local golden = bubble:GetAttribute("Golden") == true
	local amount = if golden then Config.LobbyBubbles.GoldenReward else Config.LobbyBubbles.Reward
	local pos = bubble.Position
	bubble:Destroy()
	DataService.AddBubbles(player, amount, "LobbyBubble")
	fire("LobbyPop", { Position = pos, Golden = golden, By = player.UserId, Amount = amount })
	local delay = Config.LobbyBubbles.RespawnDelay
	task.delay(rng:NextNumber(delay[1], delay[2]), spawnBubble)
end

spawnBubble = function()
	local parent = folder
	if not parent or aliveCount &gt;= Config.LobbyBubbles.Max then
		return
	end
	local pos = pickSpot()
	if not pos then
		task.delay(3, spawnBubble)
		return
	end
	local golden = rng:NextNumber() &lt; Config.LobbyBubbles.GoldenChance
	local size = if golden then GOLDEN_SIZE else BUBBLE_SIZE
	local bubble = Instance.new("Part")
	bubble.Name = if golden then "GoldenBubble" else "PopBubble"
	bubble.Shape = Enum.PartType.Ball
	bubble.Size = Vector3.one * size
	bubble.CFrame = CFrame.new(pos)
	bubble.Anchored = true
	bubble.CanCollide = false
	bubble.CanQuery = true -- clickable
	bubble.CanTouch = true
	bubble.CastShadow = false
	bubble.Material = Enum.Material.ForceField
	bubble.Color = if golden then Color3.fromRGB(255, 205, 70) else Color3.fromRGB(150, 215, 255)
	bubble:SetAttribute("Base", pos)
	bubble:SetAttribute("Golden", golden)
	if golden then
		local light = Instance.new("PointLight")
		light.Color = Color3.fromRGB(255, 210, 90)
		light.Range = 10
		light.Brightness = 1.2
		light.Parent = bubble
	end
	local click = Instance.new("ClickDetector")
	click.MaxActivationDistance = 24
	click.Parent = bubble
	click.MouseClick:Connect(function(player: Player)
		if nearPlayer(player, bubble.Position, 28) then
			pop(bubble, player)
		end
	end)
	bubble.Touched:Connect(function(hit: BasePart)
		local player = playerFromHit(hit)
		if player then
			pop(bubble, player)
		end
	end)
	CollectionService:AddTag(bubble, "PopBubble")
	alive[bubble] = true
	aliveCount += 1
	bubble.Parent = parent
end

-- The big soap bubbles floating over the table (tag "FloatBubble", placed by LobbyBuilder) pop too,
-- for anyone who manages to reach one: +1 Bubble, and it comes back in the same spot a bit later.
local function makeFloatPoppable(bubble: BasePart)
	bubble.CanTouch = true
	bubble.CanQuery = true
	local popped = false
	local click = Instance.new("ClickDetector")
	click.MaxActivationDistance = 24
	local function tryPop(player: Player)
		if popped or not allowPop(player) then
			return
		end
		popped = true
		local pos = bubble.Position
		local shown = bubble.Transparency
		bubble.Transparency = 1
		bubble.CanTouch = false
		click.Parent = nil
		DataService.AddBubbles(player, Config.LobbyBubbles.Reward, "LobbyBubble")
		fire("LobbyPop", { Position = pos, Golden = false, By = player.UserId, Amount = Config.LobbyBubbles.Reward })
		task.delay(rng:NextNumber(8, 16), function()
			if bubble.Parent then
				bubble.Transparency = shown
				bubble.CanTouch = true
				click.Parent = bubble
				popped = false
			end
		end)
	end
	click.MouseClick:Connect(function(player: Player)
		if nearPlayer(player, bubble.Position, 28) then
			tryPop(player)
		end
	end)
	bubble.Touched:Connect(function(hit: BasePart)
		local player = playerFromHit(hit)
		if player then
			tryPop(player)
		end
	end)
	click.Parent = bubble
end

----------------------------------------------------------------------------------------------------
-- Ducks
----------------------------------------------------------------------------------------------------
local function duckPart(parent: Instance, name: string, oval: boolean, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if oval then
		-- Ball parts are always round; a sphere mesh stretches to the part's size (an ellipsoid).
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = p
	end
	p.Parent = parent
	return p
end

-- A classic yellow rubber duck, about 3.4 studs tall, feet at `feet`, looking along its -Z.
local function buildDuck(id: string, feet: CFrame, parent: Instance): Model
	local model = Instance.new("Model")
	model.Name = "RubberDuck_" .. id
	local yellow = Color3.fromRGB(255, 212, 50)
	local shade = Color3.fromRGB(246, 192, 34)
	local orange = Color3.fromRGB(255, 140, 40)
	duckPart(model, "Body", true, Vector3.new(2.7, 2.1, 3.3), feet * CFrame.new(0, 1.05, 0.2), yellow)
	duckPart(model, "Tail", true, Vector3.new(1.3, 1.1, 1.3), feet * CFrame.new(0, 1.75, 1.55) * CFrame.Angles(math.rad(-40), 0, 0), yellow)
	for _, side in { -1, 1 } do
		duckPart(model, "Wing", true, Vector3.new(0.5, 1.2, 1.9), feet * CFrame.new(side * 1.12, 1.25, 0.4) * CFrame.Angles(math.rad(-12), 0, 0), shade)
	end
	local headCF = feet * CFrame.new(0, 2.45, -0.7)
	duckPart(model, "Head", true, Vector3.new(1.9, 1.85, 1.9), headCF, yellow)
	duckPart(model, "Beak", true, Vector3.new(1.1, 0.42, 1.0), headCF * CFrame.new(0, -0.18, -0.95), orange)
	for _, side in { -1, 1 } do
		duckPart(model, "Eye", true, Vector3.new(0.3, 0.38, 0.2), headCF * CFrame.new(side * 0.45, 0.25, -0.82) * CFrame.Angles(0, side * math.rad(25), 0), Color3.fromRGB(20, 20, 24))
		duckPart(model, "EyeShine", true, Vector3.new(0.1, 0.1, 0.06), headCF * CFrame.new(side * 0.45 + 0.05, 0.34, -0.91), Color3.new(1, 1, 1), Enum.Material.Neon)
	end
	-- Touch/click target (a bit bigger than the duck so it's easy to grab).
	local hit = Instance.new("Part")
	hit.Name = "Hitbox"
	hit.Size = Vector3.new(3.6, 3.6, 3.8)
	hit.CFrame = feet * CFrame.new(0, 1.6, 0)
	hit.Transparency = 1
	hit.Anchored = true
	hit.CanCollide = false
	hit.CanQuery = true
	hit.CanTouch = true
	hit.CastShadow = false
	hit.Parent = model
	model.PrimaryPart = hit
	model:SetAttribute("DuckId", id)
	CollectionService:AddTag(model, "RubberDuck")
	model.Parent = parent
	return model
end

local function foundList(player: Player): { string }
	local profile = DataService.Get(player)
	return if profile then (profile :: any).Ducks or {} else {}
end

local function syncAttribute(player: Player)
	player:SetAttribute("DucksFound", table.concat(foundList(player), ","))
end

local function giveReward(player: Player, reward: { Bubbles: number?, Gems: number? })
	if reward.Bubbles and reward.Bubbles &gt; 0 then
		DataService.AddBubbles(player, reward.Bubbles, "Duck")
	end
	if reward.Gems and reward.Gems &gt; 0 then
		DataService.AddGems(player, reward.Gems)
	end
end

local function findDuck(player: Player, id: string, model: Model)
	local now = os.clock()
	if (duckCooldown[player] or 0) &gt; now then
		return
	end
	duckCooldown[player] = now + 0.5
	local pos = (model.PrimaryPart :: BasePart).Position
	if not nearPlayer(player, pos, 30) then
		return
	end
	local isNew, count = DataService.FindDuck(player, id)
	local total = #Config.Ducks.List
	if not isNew then
		return -- already found: the client hides it, so this is only a stale touch
	end
	giveReward(player, Config.Ducks.Reward)
	local all = count &gt;= total
	if all then
		giveReward(player, Config.Ducks.AllReward)
		DataService.Notice(player, "You found every rubber duck! +" .. Config.RewardText(Config.Ducks.AllReward), "Good")
	else
		DataService.Notice(player, string.format("Rubber duck %d/%d found! +%s", count, total, Config.RewardText(Config.Ducks.Reward)), "Good")
	end
	DataService.PushMeta(player)
	syncAttribute(player)
	if fxRemote then
		fxRemote:FireClient(player, "Duck", { Position = pos, Count = count, Total = total, All = all })
	end
end

local function buildDucks(parent: Instance)
	for _, entry in Config.Ducks.List do
		local spot = DUCK_SPOTS[entry.Id]
		if not spot then
			warn("[LobbyFun] no spot for duck " .. entry.Id)
			continue
		end
		-- Yaw 0 faces +Z (toward the spawn side); the duck model looks along its own -Z.
		local feet = CFrame.new(spot.Pos) * CFrame.Angles(0, math.rad(spot.Yaw) + math.pi, 0)
		local model = buildDuck(entry.Id, feet, parent)
		if spot.Float then
			model:SetAttribute("Float", true)
		end
		local hit = model.PrimaryPart :: BasePart
		local click = Instance.new("ClickDetector")
		click.MaxActivationDistance = 24
		click.Parent = hit
		click.MouseClick:Connect(function(player: Player)
			findDuck(player, entry.Id, model)
		end)
		hit.Touched:Connect(function(other: BasePart)
			local player = playerFromHit(other)
			if player then
				findDuck(player, entry.Id, model)
			end
		end)
	end
end

----------------------------------------------------------------------------------------------------
-- Lifecycle
----------------------------------------------------------------------------------------------------
function LobbyFun.Init()
	fxRemote = Remotes.Event("RunFX")
	Players.PlayerRemoving:Connect(function(player)
		popLog[player] = nil
		duckCooldown[player] = nil
	end)
end

function LobbyFun.Start()
	local lobby = LobbyBuilder.GetLobby()
	if not lobby then
		warn("[LobbyFun] no lobby; skipping")
		return
	end
	local f = Instance.new("Folder")
	f.Name = "LobbyFun"
	f.Parent = lobby.Model
	folder = f
	buildDucks(f)
	for _ = 1, Config.LobbyBubbles.Max do
		spawnBubble()
	end
	for _, inst in CollectionService:GetTagged("FloatBubble") do
		if inst:IsA("BasePart") and inst:IsDescendantOf(lobby.Model) then
			makeFloatPoppable(inst)
		end
	end
	local function onPlayer(player: Player)
		task.spawn(function()
			DataService.WaitFor(player, 60)
			if player.Parent then
				syncAttribute(player)
			end
		end)
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in Players:GetPlayers() do
		onPlayer(player)
	end
end

return LobbyFun</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000001D"><Properties><string name="Name">MarketService</string><ProtectedString name="Source">-- MarketService: Robux purchases.
--
-- Game passes (Config.GamePasses, only entries with Id ~= 0):
--   * When a profile loads, ownership is checked with UserOwnsGamePassAsync and recorded with
--     DataService.SetPass. Passes are runtime-only and re-checked every session.
--   * PromptGamePassPurchaseFinished grants a pass the moment it's bought.
--   * DataService.SetPass fires DataService.PassesChanged, which RoundService (run stats) and
--     PetService (slot count) listen to. We can't call RoundService from here: it requires
--     DataService, and MarketService may only require DataService.
--
-- Developer products (Config.DevProducts, entries with Id ~= 0): Bubbles, Gems and in-run Coins packs.
-- MarketService.GrantProduct gives the goods; ShopService also uses it for Studio test purchases.
-- ProcessReceipt implements the idempotent pattern:
--   1. unknown product / player not here / save not writable  -&gt; NotProcessedYet (Roblox retries)
--   2. PurchaseId already in profile.Receipts (and saved)      -&gt; PurchaseGranted, grant nothing
--   3. otherwise grant, append PurchaseId to Receipts, save now; PurchaseGranted only once saved

local Players = game:GetService("Players")
local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local DataService = require(script.Parent:WaitForChild("DataService"))
local RoundService = require(script.Parent:WaitForChild("RoundService"))
local GiftService = require(script.Parent:WaitForChild("GiftService"))

local MarketService = {}

local OWNERSHIP_ATTEMPTS = 3
local RECHECK_DELAY = 60 -- a pass check that failed completely is tried once more after this long
local RECEIPT_PROFILE_WAIT = 20
local MAX_RECEIPTS = 50

type Receipt = {
	PlayerId: number,
	ProductId: number,
	PurchaseId: string,
	CurrencySpent: number?,
	PlaceIdWherePurchased: number?,
}

-- ProductId -&gt; grant(player, profile, receipt). The grant edits the profile (or calls DataService
-- helpers) and must not yield; if it throws, nothing is recorded and Roblox retries later.
-- Example shape for a future product (never Bubbles, see DESIGN.md section 7):
--   [1234567890] = function(player, profile, receipt)
--       -- give the item here
--   end,
local PRODUCTS: { [number]: (Player, any, Receipt) -&gt; () } = {}

-- Other services' developer products (Treasure Chests, the luck ad): `grant` runs once per real
-- purchase, never yields, and errors to have Roblox retry later.
function MarketService.RegisterProduct(productId: number, grant: (Player) -&gt; ())
	if type(productId) == "number" and productId &gt; 0 then
		PRODUCTS[productId] = function(player: Player, _profile: any, _receipt: Receipt)
			grant(player)
		end
	end
end

-- Gives a developer product's goods. Never yields. Coins only make sense inside a run; bought
-- anywhere else (e.g. the run ended while the prompt was open) they turn into Bubbles instead.
function MarketService.GrantProduct(player: Player, product: any): boolean
	if type(product) ~= "table" or type(product.Amount) ~= "number" then
		return false
	end
	if product.Kind == "Bubbles" then
		return DataService.AddBubbles(player, product.Amount, "Product")
	elseif product.Kind == "Gems" then
		return DataService.AddGems(player, product.Amount)
	elseif product.Kind == "RestoreStreak" then
		return DataService.RestoreStreak(player)
	elseif product.Kind == "Coins" then
		if RoundService.AddCoins(player, product.Amount) then
			return true
		end
		return DataService.AddBubbles(player, math.floor(product.Amount / 2), "ProductCoinsFallback")
	end
	return false
end

for _, product in Config.DevProducts or {} do
	if type(product.Id) == "number" and product.Id ~= 0 then
		PRODUCTS[product.Id] = function(player: Player, _profile: any, _receipt: Receipt)
			if not MarketService.GrantProduct(player, product) then
				error("grant failed")
			end
			-- (The client congratulates once Roblox's own purchase box has gone: ShopUI.)
		end
	end
end

-- Gift products (Config.GiftProducts): the pass goes to whoever the buyer picked (GiftService).
for _, gift in Config.GiftProducts or {} do
	if type(gift.Id) == "number" and gift.Id ~= 0 then
		PRODUCTS[gift.Id] = function(player: Player, _profile: any, _receipt: Receipt)
			if not GiftService.Deliver(player, gift.Key) then
				error("gift failed")
			end
		end
	end
end

local checked: { [Player]: boolean } = {}
local boughtThisSession: { [Player]: { [string]: boolean } } = {} -- never downgraded by a stale check
local processing: { [string]: boolean } = {} -- PurchaseIds being granted right now
local unsavedReceipts: { [Player]: { [string]: boolean } } = {} -- granted in memory, save not landed yet

local notifyRemote: RemoteEvent
local initialized = false

----------------------------------------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------------------------------------

local function isHere(player: Player): boolean
	return player.Parent == Players
end

-- Passes that are actually on sale (a real Id was pasted into Config).
local function livePasses()
	local list = {}
	for _, pass in Config.GamePasses do
		if type(pass.Id) == "number" and pass.Id &gt; 0 then
			table.insert(list, pass)
		end
	end
	return list
end

local function passById(passId: number)
	if type(passId) ~= "number" or passId &lt;= 0 then
		return nil
	end
	for _, pass in Config.GamePasses do
		if pass.Id == passId then
			return pass
		end
	end
	return nil
end

-- true / false when Roblox answered, nil when every attempt failed (or the player left).
local function ownsPass(player: Player, passId: number): boolean?
	for attempt = 1, OWNERSHIP_ATTEMPTS do
		local ok, result = pcall(function()
			return MarketplaceService:UserOwnsGamePassAsync(player.UserId, passId)
		end)
		if ok then
			return result == true
		end
		if not isHere(player) then
			return nil
		end
		if attempt &lt; OWNERSHIP_ATTEMPTS then
			task.wait(attempt)
		else
			warn(string.format("[MarketService] ownership check for pass %d failed: %s", passId, tostring(result)))
		end
	end
	return nil
end

local function checkPasses(player: Player, isRetry: boolean)
	local passes = livePasses()
	if #passes == 0 then
		return
	end
	local failed = false
	for _, pass in passes do
		if not isHere(player) then
			return
		end
		local owned = ownsPass(player, pass.Id)
		if not isHere(player) then
			return
		end
		if owned == nil then
			failed = true
		else
			-- A purchase that landed while this check was in flight wins over a cached "not owned".
			local bought = boughtThisSession[player]
			-- A pass the owner gifted with the admin panel (:givegamepass) stays on too.
			local gifted = player:GetAttribute("GP_" .. pass.Key) == true
			if owned or gifted or not (bought and bought[pass.Key]) then
				DataService.SetPass(player, pass.Key, owned or gifted)
			end
		end
	end
	DataService.PushMeta(player)
	if failed and not isRetry then
		task.delay(RECHECK_DELAY, function()
			if isHere(player) and checked[player] then
				checkPasses(player, true)
			end
		end)
	end
end

local function onProfileLoaded(player: Player)
	if checked[player] or not isHere(player) then
		return
	end
	checked[player] = true
	checkPasses(player, false)
end

local function onPassPurchaseFinished(player: Player, passId: number, wasPurchased: boolean)
	if not wasPurchased or not isHere(player) then
		return
	end
	local pass = passById(passId)
	if not pass then
		return
	end
	local bought = boughtThisSession[player]
	if not bought then
		bought = {}
		boughtThisSession[player] = bought
	end
	bought[pass.Key] = true
	DataService.SetPass(player, pass.Key, true)
	DataService.PushMeta(player)
	-- (The client shows the confirmation itself, a few seconds on, once Roblox's own box is gone.)
end

----------------------------------------------------------------------------------------------------
-- Developer products
----------------------------------------------------------------------------------------------------

local function markUnsaved(player: Player, purchaseId: string, unsaved: boolean)
	local set = unsavedReceipts[player]
	if unsaved then
		if not set then
			set = {}
			unsavedReceipts[player] = set
		end
		set[purchaseId] = true
	elseif set then
		set[purchaseId] = nil
	end
end

local function grantReceipt(receipt: Receipt, purchaseId: string): Enum.ProductPurchaseDecision
	local grant = PRODUCTS[receipt.ProductId]
	if not grant then
		warn("[MarketService] receipt for unknown product " .. tostring(receipt.ProductId))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet -- granted next time they join
	end
	local profile = DataService.WaitFor(player, RECEIPT_PROFILE_WAIT)
	if not profile or not isHere(player) then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local offline = DataService.IsOffline()
	if not isHere(player) then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if not offline and not DataService.CanSave(player) then
		-- A temporary (unloaded) profile: granting here would vanish. Wait for a session that saves.
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local receipts = profile.Receipts
	local pending = unsavedReceipts[player]
	if table.find(receipts, purchaseId) then
		if not (pending and pending[purchaseId]) then
			return Enum.ProductPurchaseDecision.PurchaseGranted -- granted and saved before
		end
		-- Granted earlier this session but the save didn't land yet: just try saving again below.
	else
		local ok, err = pcall(grant, player, profile, receipt)
		if not ok then
			warn("[MarketService] grant failed for product " .. tostring(receipt.ProductId) .. ": " .. tostring(err))
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		table.insert(receipts, purchaseId)
		while #receipts &gt; MAX_RECEIPTS do
			table.remove(receipts, 1)
		end
		markUnsaved(player, purchaseId, true)
		DataService.PushMeta(player)
	end

	if offline or DataService.Save(player) then
		markUnsaved(player, purchaseId, false)
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	-- The grant and its receipt are in memory; the retry only needs to save. If this server dies
	-- first, both are lost together and the purchase is granted again elsewhere.
	return Enum.ProductPurchaseDecision.NotProcessedYet
end

local function processReceipt(receiptInfo: { [string]: any }): Enum.ProductPurchaseDecision
	local receipt = receiptInfo :: any
	if type(receipt) ~= "table" or receipt.PurchaseId == nil then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local purchaseId = tostring(receipt.PurchaseId)
	-- Roblox can deliver the same receipt twice at once; only one grant may run.
	if processing[purchaseId] then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	processing[purchaseId] = true
	local ok, decision = pcall(grantReceipt, receipt, purchaseId)
	processing[purchaseId] = nil
	if not ok then
		warn("[MarketService] ProcessReceipt error: " .. tostring(decision))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	return decision
end

----------------------------------------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------------------------------------

function MarketService.Init()
	if initialized then
		return
	end
	initialized = true
	notifyRemote = Remotes.Event("Notify")

	DataService.ProfileLoaded:Connect(onProfileLoaded)
	-- Profiles that loaded before we subscribed.
	for _, player in Players:GetPlayers() do
		if DataService.Get(player) then
			task.spawn(onProfileLoaded, player)
		end
	end

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(onPassPurchaseFinished)
	MarketplaceService.ProcessReceipt = processReceipt

	Players.PlayerRemoving:Connect(function(player)
		checked[player] = nil
		boughtThisSession[player] = nil
		unsavedReceipts[player] = nil
	end)
end

function MarketService.Start()
	-- Nothing to loop: everything here is event driven.
end

return MarketService</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000001E"><Properties><string name="Name">NameTags</string><ProtectedString name="Source">-- NameTags: the overhead tag every player wears: their name (with an "R N" badge once they've
-- rebirthed) and their rank underneath in its rarity colour. No rank yet: just the name. VIPs get
-- a gold [VIP] tag in front of their name (and in chat: the VIP attribute is read by the client's
-- chat hook).
--
-- Sizing is what makes or breaks overhead GUIs, so the rules are:
--   * the BillboardGui is sized in STUDS (UDim2 scale), so it behaves like a real object: it
--     shrinks with distance exactly like the character does and never covers the screen;
--   * text is TextScaled inside fixed rows, capped by UITextSizeConstraint, so zooming right in
--     can't blow it up, and a long name shrinks to fit instead of spilling;
--   * it sits a fixed height above the head in WORLD space (StudsOffsetWorldSpace), so head bobs,
--     emotes and ragdolls never swing it around;
--   * it fades out past MaxDistance, and Roblox's own name display is turned off so there's
--     never a second name.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))

local DataService = require(script.Parent:WaitForChild("DataService"))

local NameTags = {}

local TAG_WIDTH_STUDS = 7
local TAG_HEIGHT_STUDS = 1.9
local HEIGHT_ABOVE_HEAD = 2.1
local MAX_DISTANCE = 90
local NAME_MAX_TEXT = 30
local RANK_MAX_TEXT = 24
local DEFAULT_COLOR = Color3.fromRGB(200, 205, 215)
local GOLD = Color3.fromRGB(255, 210, 74)
local CLUB_COLOR = Color3.fromRGB(110, 225, 255)

local function makeLabel(name: string, parent: Instance, y: number, h: number, maxText: number): TextLabel
	local label = Instance.new("TextLabel")
	label.Name = name
	label.BackgroundTransparency = 1
	label.Position = UDim2.fromScale(0, y)
	label.Size = UDim2.fromScale(1, h)
	label.Font = Enum.Font.LuckiestGuy
	label.TextScaled = true
	label.TextColor3 = Color3.new(1, 1, 1)
	label.Text = ""
	local limit = Instance.new("UITextSizeConstraint")
	limit.MaxTextSize = maxText
	limit.MinTextSize = 1
	limit.Parent = label
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Color = Color3.fromRGB(15, 25, 45)
	stroke.Transparency = 0.15
	stroke.Parent = label
	label.Parent = parent
	return label
end

local function isVip(player: Player): boolean
	local ok, passes = pcall(DataService.GetPasses, player)
	return ok and type(passes) == "table" and passes.VIP == true
end

local function textFor(player: Player): (string, string, Color3)
	local profile = DataService.Get(player)
	local rebirths = (profile and tonumber(profile.Rebirths)) or 0
	local name = player.DisplayName
	if rebirths &gt; 0 then
		name = string.format("R%d  %s", rebirths, name)
	end
	local rank = profile and Config.GetRank(profile.Rank)
	if rank then
		local rarity = Config.RankRarities[rank.Rarity]
		return name, rank.Icon .. " " .. rank.Name, if rarity then rarity.Color else DEFAULT_COLOR
	end
	return name, "", DEFAULT_COLOR
end

-- The player list shows everyone's rebirths (leaderstats).
local function updateLeaderstats(player: Player)
	local stats = player:FindFirstChild("leaderstats")
	if not stats then
		stats = Instance.new("Folder")
		stats.Name = "leaderstats"
		stats.Parent = player
	end
	local value = stats:FindFirstChild("Rebirths")
	if not value then
		value = Instance.new("IntValue")
		value.Name = "Rebirths"
		value.Parent = stats
	end
	local profile = DataService.Get(player)
	;(value :: IntValue).Value = (profile and tonumber(profile.Rebirths)) or 0
end

-- Staff wear their rank's tag instead of [VIP] (player attribute StaffTag, set by AdminServer).
local STAFF_COLORS = {
	MOD = Color3.fromRGB(80, 220, 100),
	ADMIN = Color3.fromRGB(255, 75, 75),
	DEV = Color3.fromRGB(80, 160, 255),
	OWNER = Color3.fromRGB(185, 100, 255),
}

local function refresh(player: Player)
	pcall(updateLeaderstats, player)
	local character = player.Character
	local head = character and character:FindFirstChild("Head")
	local tag = head and head:FindFirstChild("NameTag")
	if not tag then
		return
	end
	local nameText, rankText, rankColor = textFor(player)
	local vip = isVip(player)
	player:SetAttribute("VIP", vip)
	local nameLabel = tag:FindFirstChild("PlayerName", true)
	local rankLabel = tag:FindFirstChild("Rank", true)
	local hasRank = rankText ~= ""
	if nameLabel and nameLabel:IsA("TextLabel") then
		-- display names can't contain markup characters, but escape anyway: the label is rich text
		local safe = string.gsub(string.gsub(string.gsub(nameText, "&amp;", "&amp;amp;"), "&lt;", "&amp;lt;"), "&gt;", "&amp;gt;")
		nameLabel.RichText = true
		local staff = player:GetAttribute("StaffTag")
		local staffColor = type(staff) == "string" and STAFF_COLORS[staff]
		if staffColor then
			nameLabel.Text = string.format('&lt;font color="#%s"&gt;[%s]&lt;/font&gt; %s', staffColor:ToHex(), staff, safe)
		elseif vip then
			nameLabel.Text = string.format('&lt;font color="#%s"&gt;[VIP]&lt;/font&gt; %s', GOLD:ToHex(), safe)
		else
			nameLabel.Text = safe
		end
		-- Their club's tag after the name (ClubService sets the attribute; filtered when the club was made).
		local club = player:GetAttribute("ClubTag")
		if type(club) == "string" and club ~= "" then
			local safeClub = string.gsub(string.gsub(string.gsub(club, "&amp;", "&amp;amp;"), "&lt;", "&amp;lt;"), "&gt;", "&amp;gt;")
			nameLabel.Text ..= string.format(' &lt;font color="#%s"&gt;[%s]&lt;/font&gt;', CLUB_COLOR:ToHex(), safeClub)
		end
		nameLabel.TextColor3 = Color3.new(1, 1, 1)
		-- without a rank line the name sits in the middle of the tag
		nameLabel.Position = UDim2.fromScale(0, if hasRank then 0 else 0.3)
	end
	if rankLabel and rankLabel:IsA("TextLabel") then
		rankLabel.Text = rankText
		rankLabel.TextColor3 = rankColor
		rankLabel.Visible = hasRank
	end
end

local function attach(player: Player, character: Model)
	local head = character:WaitForChild("Head", 10)
	local humanoid = character:WaitForChild("Humanoid", 10)
	if not head or not head:IsA("BasePart") or character.Parent == nil then
		return
	end
	if humanoid and humanoid:IsA("Humanoid") then
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	end
	local old = head:FindFirstChild("NameTag")
	if old then
		old:Destroy()
	end
	local tag = Instance.new("BillboardGui")
	tag.Name = "NameTag"
	tag.Adornee = head
	tag.Size = UDim2.fromScale(TAG_WIDTH_STUDS, TAG_HEIGHT_STUDS)
	tag.StudsOffsetWorldSpace = Vector3.new(0, HEIGHT_ABOVE_HEAD, 0)
	tag.MaxDistance = MAX_DISTANCE
	tag.AlwaysOnTop = false
	tag.LightInfluence = 0
	makeLabel("PlayerName", tag, 0, 0.56, NAME_MAX_TEXT)
	makeLabel("Rank", tag, 0.56, 0.44, RANK_MAX_TEXT)
	tag.Parent = head
	refresh(player)
end

local function watch(player: Player)
	player.CharacterAdded:Connect(function(character)
		task.spawn(attach, player, character)
	end)
	if player.Character then
		task.spawn(attach, player, player.Character)
	end
	player:GetPropertyChangedSignal("DisplayName"):Connect(function()
		refresh(player)
	end)
	player:GetAttributeChangedSignal("StaffTag"):Connect(function()
		refresh(player)
	end)
	player:GetAttributeChangedSignal("ClubTag"):Connect(function()
		refresh(player)
	end)
end

function NameTags.Init()
	-- Rank rolls and rebirths both fire PassesChanged (they change run stats too).
	DataService.PassesChanged:Connect(refresh)
	DataService.ProfileLoaded:Connect(function(player)
		refresh(player)
	end)
	Players.PlayerAdded:Connect(watch)
	for _, player in Players:GetPlayers() do
		watch(player)
	end
	-- Belt and braces: anyone whose character is missing its tag (a respawn that raced us, a
	-- character swapped by another script) gets one, and Roblox's own name stays off.
	task.spawn(function()
		while true do
			task.wait(2)
			for _, player in Players:GetPlayers() do
				local character = player.Character
				local head = character and character:FindFirstChild("Head")
				if head and character.Parent and not head:FindFirstChild("NameTag") then
					task.spawn(attach, player, character)
				end
				local humanoid = character and character:FindFirstChildOfClass("Humanoid")
				if humanoid and humanoid.DisplayDistanceType ~= Enum.HumanoidDisplayDistanceType.None then
					humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
				end
			end
		end
	end)
end

return NameTags</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000001F"><Properties><string name="Name">PartyService</string><ProtectedString name="Source">-- Party pads: walk-in matchmaking in the lobby. One party per pad, fully server-authoritative.
--
--   * A poll loop (Config.Party.PollInterval) tests every free player's HumanoidRootPart against each
--     pad's Zone box, in the Zone's own space so rotated pads work.
--   * Walking into an empty pad makes you host of a new party. Walking into a pad that has a party
--     joins it, unless it is full, about to launch, or Friends Only and you aren't the host's friend.
--     Then you're pushed out the front with a toast and can't re-enter for RejoinCooldown seconds.
--   * Members go into the "PartyMember" collision group (the pad's barrier walls block only that
--     group) and stand on a 2x2 grid inside the pad. A member found outside the pad is put back.
--   * The countdown is one timestamp (EndsAt, server time) set when the party is created. Clients
--     draw the timer from it; the server only rewrites the pad billboard every 0.25 s.
--   * At EndsAt (or Start Now) the party launches: RoundService.StartRound builds a dishwasher and
--     takes the players. If no dishwasher is free the countdown is pushed back and it tries again.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Types = require(Shared:WaitForChild("Types"))
local Util = require(Shared:WaitForChild("Util"))

local Characters = require(script.Parent:WaitForChild("Characters"))
local DataService = require(script.Parent:WaitForChild("DataService"))
local LobbyBuilder = require(script.Parent:WaitForChild("LobbyBuilder"))
local RoundService = require(script.Parent:WaitForChild("RoundService"))
local RunServers = require(script.Parent:WaitForChild("RunServers"))

local PartyService = {}

----------------------------------------------------------------------------------------------------
-- Tuning (the gameplay numbers live in Config.Party)
----------------------------------------------------------------------------------------------------
local PARTY = Config.Party
local MAX_PLAYERS = PARTY.MaxPlayers
local LABEL_INTERVAL = 0.25 -- how often pad billboards are rewritten (the countdown text)
local RETRY_DELAY = 10 -- seconds added to the countdown when every dishwasher is busy

-- Seconds from Create to launch: a solo party (max 1) clearly just wants to play; a bigger one waits
-- long enough for people to wander over and join.
local function countdownFor(maxPlayers: number): number
	return if maxPlayers &lt;= 1 then PARTY.SoloCountdown else PARTY.Countdown
end
local PICK_SECONDS = 60 -- a host who hasn't pressed Create by then is walked out of the pad
local ACTIONS_PER_SECOND = 5 -- PartyAction rate limit per player
local FRIEND_CACHE_TTL = 300 -- seconds a friends answer is trusted
local FRIEND_FAIL_TTL = 5 -- a failed friends lookup counts as "no" for this long, then it retries
local PUT_BACK_COOLDOWN = 0.75 -- min seconds between "you escaped the pad" teleports per member
-- Members are held to a looser box than the entry check, so hugging a wall or jumping never counts
-- as escaping (and a slightly-off LobbyBuilder Zone can't cause a teleport loop).
local HOLD_MARGIN_XZ = 1.5
local HOLD_MARGIN_BELOW = 3
local HOLD_MARGIN_ABOVE = 12

local FLOOR_COLORS = {
	Idle = Color3.fromRGB(125, 195, 255), -- soft blue: walk in to start a party
	Open = Color3.fromRGB(70, 225, 145), -- green: public party with room
	Friends = Color3.fromRGB(180, 125, 255), -- purple: friends only
	Full = Color3.fromRGB(255, 165, 60), -- orange: full, or launching
}
local PRIVACY_TEXT = {
	Public = "Public",
	Friends = "Friends Only",
}
local IDLE_TITLE = "Party Pad"
local IDLE_STATUS = "Touch to create a party"
local LAUNCH_STATUS = "Launching!"

local FLOOR_TWEEN = TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local PULSE_TWEEN = TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

----------------------------------------------------------------------------------------------------
-- Types
----------------------------------------------------------------------------------------------------
type PadGui = { Count: TextLabel?, Title: TextLabel?, Status: TextLabel?, Privacy: TextLabel? }

-- LobbyBuilder's PadInfo (DESIGN.md §5). Read-only here, except the Floor colour.
type PadInfo = {
	Id: number,
	Model: Model,
	Zone: BasePart,
	Floor: BasePart?,
	Inside: CFrame,
	Exit: CFrame,
	Barriers: { BasePart }?,
	Gui: PadGui?,
}

type Privacy = "Public" | "Friends"
-- Picking: the host is choosing a dishwasher and party size; nobody else can join yet.
-- Waiting: created, counting down, open to joiners. Launching: handed to RoundService.
type Status = "Picking" | "Waiting" | "Launching"

type Party = {
	PadId: number,
	Pad: Pad,
	Host: Player,
	Members: { Player }, -- join order; Members[1] is next in line to be host
	MaxPlayers: number,
	Privacy: Privacy,
	Level: number,
	LevelChosen: boolean, -- the host picked a level, so don't overwrite it when their profile loads
	EndsAt: number, -- server time (Util.Now) when the countdown hits 0 (Picking: when it's cancelled)
	Status: Status,
	Slots: { [Player]: number }, -- standing spot per member (see slotCFrame)
	Dead: boolean, -- dissolved or launched: anything still holding this table must stop using it
	FlushQueued: boolean, -- a PartyState push is already scheduled for this frame
}

type Pad = {
	Info: PadInfo,
	Party: Party?,
	FloorColor: Color3?, -- colour the floor is tweening towards
	Sounds: { [string]: Sound },
}

-- How a member is let go:
--   "Exit" : teleport out the front of the pad and start the rejoin cooldown (left or removed)
--   "Stay" : leave the character where it is (died, launched into a run, or already in a run)
--   "Gone" : they left the game, so touch nothing on the Player
type ReleaseMode = "Exit" | "Stay" | "Gone"

----------------------------------------------------------------------------------------------------
-- State
----------------------------------------------------------------------------------------------------
local pads: { Pad } = {}
local padsLoaded = false
local memberOf: { [Player]: Party } = {}
local memberConns: { [Player]: { RBXScriptConnection } } = {}
local pendingJoin: { [Player]: boolean } = {} -- friends check in flight: the poll skips them
local launching: { [Player]: boolean } = {} -- handed to StartRound, which hasn't returned yet
local cooldownUntil: { [Player]: number } = {} -- os.clock() before which they can't enter a pad
-- Just sent out of a pad (Back, ejected, cancelled): that pad is ignored for them until the poll
-- sees them outside it once. No timer, so walking straight back in starts a new party at once, but
-- a character still reporting its old spot right after the teleport can't re-trigger it.
local mustLeave: { [Player]: { Pad: any, Since: number } } = {}
local MUST_LEAVE_MAX = 4 -- seconds: if the teleport out somehow never lands, stop waiting
-- The character's own late position updates can put it back in the pad for a moment right after the
-- teleport out, so "outside" only counts once this long has passed.
local MUST_LEAVE_SETTLE = 0.6
local lastPutBack: { [Player]: number } = {}
local actionWindow: { [Player]: { Start: number, Count: number } } = {}
-- friendCache[candidate][hostUserId] = the answer to candidate:IsFriendsWithAsync(hostUserId)
local friendCache: { [Player]: { [number]: { Value: boolean, Expires: number } } } = {}

local partyStateRemote: RemoteEvent
local notifyRemote: RemoteEvent

local lastWarnAt = -math.huge

----------------------------------------------------------------------------------------------------
-- Small helpers
----------------------------------------------------------------------------------------------------

-- At most one warning every 10 s, so a bug inside the poll loop can't flood the output.
local function warnThrottled(message: string)
	local now = os.clock()
	if now - lastWarnAt &gt;= 10 then
		lastWarnAt = now
		warn("[PartyService] " .. message)
	end
end

local function notify(player: Player, text: string, kind: string?)
	if player.Parent == Players then
		notifyRemote:FireClient(player, text, kind or "Info")
	end
end

local function isInRun(player: Player): boolean
	return RoundService.IsInRun(player) == true
end

-- Highest level this player may pick (1 while their profile is still loading).
local function unlockedOf(player: Player): number
	local ok, profile = pcall(DataService.Get, player)
	local unlocked = ok and profile and (profile :: any).Unlocked
	if type(unlocked) ~= "number" or unlocked ~= unlocked then
		return 1
	end
	return math.clamp(math.floor(unlocked), 1, #Config.Levels)
end

local function isInteger(value: any): boolean
	return type(value) == "number" and value == value and value == math.floor(value)
end

-- True if this request fits in the player's PartyAction budget (ACTIONS_PER_SECOND per 1 s window).
local function allowAction(player: Player): boolean
	local now = os.clock()
	local window = actionWindow[player]
	if not window or now - window.Start &gt;= 1 then
		window = { Start = now, Count = 0 }
		actionWindow[player] = window
	end
	window.Count += 1
	return window.Count &lt;= ACTIONS_PER_SECOND
end

-- Characters.Teleport may yield (streaming requests), so it never runs on the poll loop's thread.
local function teleport(player: Player, cframe: CFrame)
	task.spawn(function()
		pcall(Characters.Teleport, player, cframe)
	end)
end

----------------------------------------------------------------------------------------------------
-- Pad geometry
----------------------------------------------------------------------------------------------------

-- `position` in the Zone's own space (so rotated pads work), and the Zone's half size.
local function toZoneSpace(zone: BasePart, position: Vector3): (Vector3, Vector3)
	return zone.CFrame:PointToObjectSpace(position), zone.Size / 2
end

-- Strict point-in-box: is a free player standing in this pad?
local function isInsideZone(zone: BasePart, position: Vector3): boolean
	local p, half = toZoneSpace(zone, position)
	return math.abs(p.X) &lt;= half.X and math.abs(p.Y) &lt;= half.Y and math.abs(p.Z) &lt;= half.Z
end

-- Loose point-in-box: is a member still (near enough) inside their pad?
local function isHeldInZone(zone: BasePart, position: Vector3): boolean
	local p, half = toZoneSpace(zone, position)
	return math.abs(p.X) &lt;= half.X + HOLD_MARGIN_XZ
		and math.abs(p.Z) &lt;= half.Z + HOLD_MARGIN_XZ
		and p.Y &gt;= -half.Y - HOLD_MARGIN_BELOW
		and p.Y &lt;= half.Y + HOLD_MARGIN_ABOVE
end

-- Where member slot `slot` stands: a 2x2 grid around the pad centre (a bigger MaxPlayers would
-- simply fill more grid cells). Spacing scales with the pad so nobody is placed inside a wall.
local function slotCFrame(pad: Pad, slot: number): CFrame
	local info = pad.Info
	local cols = math.max(2, math.ceil(math.sqrt(MAX_PLAYERS)))
	local rows = math.max(1, math.ceil(MAX_PLAYERS / cols))
	local size = info.Zone.Size
	local spacing = math.clamp(math.min(size.X, size.Z) / (cols + 1.5), 1.5, 3.5)
	local index = math.max(slot, 1) - 1
	local col = index % cols
	local row = (index // cols) % rows
	local dx = (col - (cols - 1) / 2) * spacing
	local dz = (row - (rows - 1) / 2) * spacing
	return info.Inside * CFrame.new(dx, 0, dz)
end

local function freeSlot(party: Party): number
	local used = {}
	for _, slot in party.Slots do
		used[slot] = true
	end
	local slot = 1
	while used[slot] do
		slot += 1
	end
	return slot
end

----------------------------------------------------------------------------------------------------
-- Pad visuals (billboard text, floor colour, sounds)
----------------------------------------------------------------------------------------------------

local function setText(label: TextLabel?, text: string)
	-- Only write real changes: identical writes are free, but this runs 4x a second per pad.
	if label and label.Parent and label.Text ~= text then
		label.Text = text
	end
end

local function floorColorFor(party: Party?): Color3
	if not party then
		return FLOOR_COLORS.Idle
	end
	if party.Status ~= "Waiting" or #party.Members &gt;= party.MaxPlayers then
		return FLOOR_COLORS.Full
	end
	if party.Privacy == "Friends" then
		return FLOOR_COLORS.Friends
	end
	return FLOOR_COLORS.Open
end

local function statusText(party: Party?, now: number): string
	if not party then
		return IDLE_STATUS
	end
	if party.Status == "Launching" then
		return LAUNCH_STATUS
	end
	if party.Status == "Picking" then
		return party.Host.DisplayName .. " is picking a level..."
	end
	local left = math.ceil(party.EndsAt - now)
	if left &lt;= 0 then
		return LAUNCH_STATUS
	end
	return "Starting in " .. left
end

-- Tweens the floor (and any light parented to it) to `color`. `pulse` flashes it bright first,
-- which reads as "someone just joined".
local function tweenFloor(pad: Pad, color: Color3, pulse: boolean?)
	local floor = pad.Info.Floor
	if not floor or not floor.Parent then
		return
	end
	if not pulse and pad.FloorColor == color then
		return
	end
	pad.FloorColor = color
	local info = FLOOR_TWEEN
	if pulse then
		floor.Color = color:Lerp(Color3.new(1, 1, 1), 0.6)
		info = PULSE_TWEEN
	end
	TweenService:Create(floor, info, { Color = color }):Play()
	for _, child in floor:GetChildren() do
		if child:IsA("Light") then
			TweenService:Create(child, info, { Color = color }):Play()
		end
	end
end

-- A positional sound at the pad (a Sound in the workspace plays for everyone nearby).
local function playPadSound(pad: Pad, key: string)
	local def = (Config.Sounds :: any)[key]
	local floor = pad.Info.Floor
	if not def or not floor or not floor.Parent then
		return
	end
	local sound = pad.Sounds[key]
	if not sound or sound.Parent ~= floor then
		sound = Instance.new("Sound")
		sound.Name = "Party" .. key
		sound.SoundId = def.Id
		sound.Volume = def.Volume
		sound.RollOffMode = Enum.RollOffMode.InverseTapered
		sound.RollOffMinDistance = 10
		sound.RollOffMaxDistance = 90
		sound.Parent = floor
		pad.Sounds[key] = sound
	end
	sound:Play()
end

local function refreshPad(pad: Pad, pulse: boolean?)
	local party = pad.Party
	local gui = pad.Info.Gui
	if gui then
		if party then
			local level = Config.GetLevel(party.Level)
			setText(gui.Count, #party.Members .. "/" .. party.MaxPlayers)
			setText(gui.Title, level.Name)
			setText(gui.Privacy, PRIVACY_TEXT[party.Privacy])
		else
			setText(gui.Count, "0/" .. MAX_PLAYERS)
			setText(gui.Title, IDLE_TITLE)
			setText(gui.Privacy, PRIVACY_TEXT.Public)
		end
		setText(gui.Status, statusText(party, Util.Now()))
	end
	tweenFloor(pad, floorColorFor(party), pulse)
end

----------------------------------------------------------------------------------------------------
-- PartyState pushes
----------------------------------------------------------------------------------------------------

local function buildState(party: Party): Types.PartyState
	local members: { Types.PartyMember } = {}
	for _, member in party.Members do
		table.insert(members, { UserId = member.UserId, Name = member.Name, DisplayName = member.DisplayName })
	end
	return {
		PadId = party.PadId,
		HostUserId = party.Host.UserId,
		IsHost = false,
		Members = members,
		MaxPlayers = party.MaxPlayers,
		Privacy = party.Privacy,
		Level = party.Level,
		HostUnlocked = unlockedOf(party.Host),
		EndsAt = party.EndsAt,
		Status = party.Status,
	}
end

-- Sends every member their own copy (IsHost differs per recipient).
local function pushNow(party: Party)
	if party.Dead or #party.Members == 0 then
		return
	end
	local base = buildState(party)
	for _, member in party.Members do
		if member.Parent == Players then
			local state: Types.PartyState = table.clone(base)
			state.IsHost = member == party.Host
			partyStateRemote:FireClient(member, state)
		end
	end
end

-- Coalesces every change made to a party in the same frame into one push per member.
-- (A member who is removed gets PartyState(nil) immediately, not through here.)
local function markDirty(party: Party)
	if party.Dead or party.FlushQueued then
		return
	end
	party.FlushQueued = true
	task.defer(function()
		party.FlushQueued = false
		pushNow(party)
	end)
end

----------------------------------------------------------------------------------------------------
-- Membership
----------------------------------------------------------------------------------------------------

local function unhookMember(player: Player)
	local conns = memberConns[player]
	if conns then
		for _, conn in conns do
			conn:Disconnect()
		end
		memberConns[player] = nil
	end
end

-- Back to the normal "Players" group so the pad walls stop blocking them. RoundService already does
-- this for launched players; it's only redone if the character is still in PartyMember (or has no
-- root right now, e.g. dead, so the next character spawns in the right group).
local function releaseGroup(player: Player)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") and root.CollisionGroup ~= Characters.Groups.PartyMember then
		return
	end
	Characters.SetGroup(player, Characters.Groups.Players)
end

-- Forgets a member's per-player bookkeeping. Does not touch party.Members (callers do).
local function releaseMember(party: Party, player: Player, mode: ReleaseMode)
	memberOf[player] = nil
	party.Slots[player] = nil
	lastPutBack[player] = nil
	unhookMember(player)
	if mode == "Gone" or player.Parent ~= Players then
		return
	end
	player:SetAttribute("InParty", false)
	releaseGroup(player)
	if mode == "Exit" then
		mustLeave[player] = { Pad = party.Pad, Since = os.clock() }
		if not isInRun(player) then
			teleport(player, party.Pad.Info.Exit)
		end
	end
	partyStateRemote:FireClient(player, nil)
end

local function dissolve(party: Party)
	party.Dead = true
	local pad = party.Pad
	if pad.Party == party then
		pad.Party = nil
	end
	refreshPad(pad)
end

-- The longest-waiting member becomes host. They may not have unlocked the level the old host
-- picked, so the level is clamped to what they can play.
local function promoteHost(party: Party)
	local newHost = party.Members[1]
	if not newHost then
		return
	end
	party.Host = newHost
	party.Level = math.clamp(party.Level, 1, unlockedOf(newHost))
	notify(newHost, "You're the party host now!", "Good")
end

local function removeMember(player: Player, mode: ReleaseMode, message: string?)
	local party = memberOf[player]
	if not party then
		return
	end
	local index = table.find(party.Members, player)
	if index then
		table.remove(party.Members, index)
	end
	releaseMember(party, player, mode)
	if message then
		notify(player, message, "Info")
	end

	if #party.Members == 0 then
		dissolve(party)
		return
	end
	if party.Host == player then
		promoteHost(party)
	end
	markDirty(party)
	refreshPad(party.Pad)
end

-- Death (Humanoid.Died) or losing the character (CharacterRemoving, e.g. a respawn) ends membership.
-- They respawn in the lobby as normal.
local function hookMember(player: Player)
	unhookMember(player)
	local function onLost()
		if memberOf[player] then
			removeMember(player, "Stay", "You left the party.")
		end
	end
	local conns = {}
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		table.insert(conns, humanoid.Died:Connect(onLost))
	end
	table.insert(conns, player.CharacterRemoving:Connect(onLost))
	memberConns[player] = conns
end

local function joinParty(party: Party, player: Player)
	local pad = party.Pad
	table.insert(party.Members, player)
	memberOf[player] = party
	local slot = freeSlot(party)
	party.Slots[player] = slot
	cooldownUntil[player] = nil
	mustLeave[player] = nil
	lastPutBack[player] = os.clock()

	Characters.SetGroup(player, Characters.Groups.PartyMember)
	player:SetAttribute("InParty", true)
	hookMember(player)
	teleport(player, slotCFrame(pad, slot))

	markDirty(party)
	refreshPad(pad, true)
	playPadSound(pad, "Pop")
end

local function createParty(pad: Pad, host: Player)
	local party: Party = {
		PadId = pad.Info.Id,
		Pad = pad,
		Host = host,
		Members = {},
		MaxPlayers = MAX_PLAYERS,
		Privacy = "Public",
		Level = unlockedOf(host), -- default to their best dishwasher
		LevelChosen = false,
		EndsAt = Util.Now() + PICK_SECONDS, -- replaced by the real countdown when they press Create
		Status = "Picking",
		Slots = {},
		Dead = false,
		FlushQueued = false,
	}
	pad.Party = party
	joinParty(party, host)
end

----------------------------------------------------------------------------------------------------
-- Walking into a pad
----------------------------------------------------------------------------------------------------

-- Joins and leaves are refused this close to launch (and while launching).
local function inLockWindow(party: Party): boolean
	if party.Status == "Picking" then
		return false
	end
	return party.Status ~= "Waiting" or Util.Now() &gt;= party.EndsAt - PARTY.LockSeconds
end

-- Pushes a free player out the front of a pad they may not join.
local function eject(player: Player, pad: Pad, message: string)
	mustLeave[player] = { Pad = pad, Since = os.clock() }
	teleport(player, pad.Info.Exit)
	notify(player, message, "Bad")
end

local function cachedFriendship(candidate: Player, host: Player): boolean?
	local byHost = friendCache[candidate]
	local entry = byHost and byHost[host.UserId]
	if entry and os.clock() &lt; entry.Expires then
		return entry.Value
	end
	return nil
end

local function storeFriendship(candidate: Player, hostUserId: number, value: boolean, ttl: number)
	local byHost = friendCache[candidate]
	if not byHost then
		byHost = {}
		friendCache[candidate] = byHost
	end
	byHost[hostUserId] = { Value = value, Expires = os.clock() + ttl }
end

-- A player the poll loop should look at: not busy with a party, run or pending check, and not on
-- the rejoin cooldown.
local function canEnterPads(player: Player, clock: number): boolean
	if player.Parent ~= Players or memberOf[player] or pendingJoin[player] or launching[player] then
		return false
	end
	-- On their way to a run server (still standing on the pad, frozen, screen black): hands off.
	if player:GetAttribute("Teleporting") == true then
		return false
	end
	local cooldown = cooldownUntil[player]
	if cooldown then
		if clock &lt; cooldown then
			return false
		end
		cooldownUntil[player] = nil
	end
	return not isInRun(player)
end

local admit: (player: Player, pad: Pad) -&gt; ()

-- Asks Roblox whether `player` is friends with the host, then runs admit() again. Everything is
-- re-checked after the yield: the party may have filled up, started launching, changed host or
-- privacy, or the player may have walked off or left.
local function startFriendCheck(player: Player, pad: Pad, party: Party)
	local host = party.Host
	pendingJoin[player] = true
	task.spawn(function()
		local ok, result = false, nil
		if player.Parent == Players and host.Parent == Players then
			ok, result = pcall(player.IsFriendsWithAsync, player, host.UserId)
		end
		pendingJoin[player] = nil
		if player.Parent ~= Players then
			return
		end
		if ok then
			storeFriendship(player, host.UserId, result == true, FRIEND_CACHE_TTL)
		else
			-- The web call failed: count it as "no" briefly so they get a clear answer, then retry.
			storeFriendship(player, host.UserId, false, FRIEND_FAIL_TTL)
		end

		-- Same party, same host, player still free and standing in the pad? Otherwise the next poll
		-- simply starts over with whatever is true now.
		if party.Dead or pad.Party ~= party or party.Host ~= host then
			return
		end
		if not canEnterPads(player, os.clock()) then
			return
		end
		local root = Characters.GetRoot(player)
		if not root or not isInsideZone(pad.Info.Zone, root.Position) then
			return
		end
		admit(player, pad) -- the answer is cached now, so this doesn't yield again
	end)
end

-- Decides what happens to a free player standing in `pad`.
function admit(player: Player, pad: Pad)
	local party = pad.Party
	if not party then
		createParty(pad, player)
		return
	end
	if party.Status == "Picking" then
		eject(player, pad, party.Host.DisplayName .. " is picking a level. Try another pad!")
		return
	end
	if inLockWindow(party) then
		eject(player, pad, "That party is launching! Try another pad.")
		return
	end
	if #party.Members &gt;= party.MaxPlayers then
		eject(player, pad, "This party is full!")
		return
	end
	if party.Privacy == "Friends" then
		local isFriend = cachedFriendship(player, party.Host)
		if isFriend == nil then
			startFriendCheck(player, pad, party)
			return
		elseif not isFriend then
			eject(player, pad, "Friends only!")
			return
		end
	end
	joinParty(party, player)
end

----------------------------------------------------------------------------------------------------
-- Launch
----------------------------------------------------------------------------------------------------

local function launch(party: Party)
	local pad = party.Pad
	party.Status = "Launching"

	-- Only take members who can actually play right now; drop the rest.
	local roster: { Player } = {}
	for _, member in table.clone(party.Members) do
		if member.Parent ~= Players then
			removeMember(member, "Gone")
		elseif isInRun(member) then
			removeMember(member, "Stay")
		elseif not Characters.IsAlive(member) then
			removeMember(member, "Stay", "You left the party.")
		else
			table.insert(roster, member)
		end
	end
	if party.Dead or #roster == 0 then
		return -- removeMember dissolved it
	end

	for _, member in roster do
		launching[member] = true
	end
	markDirty(party)
	refreshPad(pad)
	playPadSound(pad, "Splash")

	local level = party.Level
	task.spawn(function()
		-- Give every member's screen time to fade to black (Cutscene.Cover on "Launching") before
		-- anyone is moved, so the teleport into the dishwasher is never seen.
		task.wait(0.25)
		-- In the live game the party plays in its own private server; otherwise (Studio, or the
		-- teleport can't start) StartRound builds the dishwasher here. It yields while it builds.
		-- Pass a copy: it's RoundService's now.
		local ok, started, err
		-- Anyone whose teleport fails later is unfrozen by RunServers and walked out of the pad here.
		local teleported = RunServers.Launch(table.clone(roster), level, function(member: Player)
			if member.Parent == Players and not memberOf[member] then
				mustLeave[member] = { Pad = pad, Since = os.clock() }
				teleport(member, pad.Info.Exit)
			end
		end)
		if teleported then
			ok, started = true, true
		else
			ok, started, err = pcall(RoundService.StartRound, table.clone(roster), level)
		end
		for _, member in roster do
			launching[member] = nil
		end
		if not ok then
			warn("[PartyService] StartRound errored: " .. tostring(started))
		end
		if party.Dead then
			return -- everyone left or died while the dishwasher was being built
		end

		if ok and started == true then
			-- RoundService has already moved everyone into the dishwasher (and sent RunState), so just
			-- let go of them here without teleporting. Anyone it didn't take is walked out of the pad.
			party.Dead = true
			for _, member in party.Members do
				releaseMember(party, member, if teleported or isInRun(member) then "Stay" else "Exit")
			end
			table.clear(party.Members)
			if pad.Party == party then
				pad.Party = nil
			end
			refreshPad(pad)
		else
			if ok and err then
				warn("[PartyService] StartRound refused pad " .. party.PadId .. ": " .. tostring(err))
			end
			party.Status = "Waiting"
			party.EndsAt = math.max(party.EndsAt, Util.Now()) + RETRY_DELAY
			for _, member in party.Members do
				notify(member, "All dishwashers are busy, trying again...", "Bad")
			end
			markDirty(party)
			refreshPad(pad)
		end
	end)
end

----------------------------------------------------------------------------------------------------
-- Poll loop
----------------------------------------------------------------------------------------------------

-- Keeps one member honest: still here, not in a run, alive, and inside their pad.
local function validateMember(party: Party, player: Player, clock: number)
	if memberOf[player] ~= party then
		return
	end
	if player.Parent ~= Players then
		removeMember(player, "Gone")
		return
	end
	if isInRun(player) then
		removeMember(player, "Stay")
		return
	end
	local root = Characters.GetRoot(player)
	if not root then
		-- Dead or no character. The Died / CharacterRemoving hooks normally get here first.
		removeMember(player, "Stay", "You left the party.")
		return
	end
	if not isHeldInZone(party.Pad.Info.Zone, root.Position) then
		-- Glitched or exploited out through a wall: put them back on their spot.
		if clock - (lastPutBack[player] or 0) &gt;= PUT_BACK_COOLDOWN then
			lastPutBack[player] = clock
			Characters.SetGroup(player, Characters.Groups.PartyMember)
			teleport(player, slotCFrame(party.Pad, party.Slots[player] or 1))
		end
	end
end

local function loadPads(): boolean
	if padsLoaded then
		return true
	end
	local ok, lobby = pcall(LobbyBuilder.GetLobby)
	local padList = ok and lobby and (lobby :: any).Pads
	if type(padList) ~= "table" then
		return false
	end
	for _, raw in padList do
		local info = raw :: PadInfo
		local zone = (info :: any).Zone
		if typeof(zone) == "Instance" and zone:IsA("BasePart") and typeof(info.Inside) == "CFrame" and typeof(info.Exit) == "CFrame" then
			-- The walls must only block party members (LobbyBuilder sets this; make sure of it).
			local barriers: { BasePart } = info.Barriers or {}
			for _, barrier in barriers do
				if typeof(barrier) == "Instance" and barrier:IsA("BasePart") and barrier.CollisionGroup ~= Characters.Groups.PadBarrier then
					barrier.CollisionGroup = Characters.Groups.PadBarrier
				end
			end
			local pad: Pad = { Info = info, Party = nil, FloorColor = nil, Sounds = {} }
			table.insert(pads, pad)
			refreshPad(pad)
		else
			warn("[PartyService] pad " .. tostring(info.Id) .. " has no Zone/Inside/Exit, skipped")
		end
	end
	padsLoaded = true
	return true
end

local function tick()
	if not padsLoaded and not loadPads() then
		warnThrottled("waiting for LobbyBuilder.GetLobby() to return the pads")
		return
	end
	local now = Util.Now()
	local clock = os.clock()

	-- 1) Existing parties: hold members in, drop invalid ones, launch when the countdown is over.
	--    Members of a launching party are left alone: RoundService is busy moving them.
	for _, pad in pads do
		local party = pad.Party
		if party and (party.Status == "Waiting" or party.Status == "Picking") then
			for _, member in table.clone(party.Members) do
				validateMember(party, member, clock)
			end
			if not party.Dead and party.Status == "Waiting" and now &gt;= party.EndsAt then
				launch(party)
			elseif not party.Dead and party.Status == "Picking" and now &gt;= party.EndsAt then
				removeMember(party.Host, "Exit", "Party cancelled: you didn't pick a level in time.")
			end
		end
	end

	-- 2) Free players standing in a pad.
	for _, player in Players:GetPlayers() do
		if canEnterPads(player, clock) then
			local root = Characters.GetRoot(player)
			if root then
				local position = root.Position
				local leaving = mustLeave[player]
				if leaving then
					local zone = leaving.Pad.Info.Zone
					local settled = clock - leaving.Since &gt; MUST_LEAVE_SETTLE
					if not zone.Parent or (settled and not isInsideZone(zone, position)) or clock - leaving.Since &gt; MUST_LEAVE_MAX then
						mustLeave[player] = nil
						leaving = nil
					end
				end
				for _, pad in pads do
					local zone = pad.Info.Zone
					if zone.Parent and (not leaving or leaving.Pad ~= pad) and isInsideZone(zone, position) then
						admit(player, pad)
						break
					end
				end
			end
		end
	end
end

----------------------------------------------------------------------------------------------------
-- PartyAction (client requests)
----------------------------------------------------------------------------------------------------

local function onPartyAction(player: Player, action: any, value: any)
	if not allowAction(player) or type(action) ~= "string" then
		return
	end
	local party = memberOf[player]
	if not party or party.Dead then
		return
	end

	if action == "Leave" then
		if inLockWindow(party) then
			notify(player, "Too late to leave, the dishwasher is starting!", "Bad")
			return
		end
		removeMember(player, "Exit")
		return
	end

	-- Everything else is a host setting, and settings freeze once the party is launching.
	if party.Host ~= player then
		notify(player, "Only the host can change that.", "Bad")
		return
	end
	if party.Status == "Launching" then
		return
	end

	if action == "Create" then
		-- The host confirms the Create Party screen: { Level, MaxPlayers, Privacy }.
		if party.Status ~= "Picking" or type(value) ~= "table" then
			return
		end
		local level, max, privacy = value.Level, value.MaxPlayers, value.Privacy
		-- Rounds are paused before and during the Admin Abuse show.
		local locked, why = Config.EventLockdown()
		if locked then
			notify(player, why, "Bad")
			return
		end
		if not isInteger(level) or level &lt; 1 or level &gt; #Config.Levels then
			return
		end
		if level &gt; unlockedOf(player) then
			notify(player, "That level is still locked!", "Bad")
			return
		end
		if not isInteger(max) or max &lt; 1 or max &gt; MAX_PLAYERS then
			return
		end
		if privacy ~= "Public" and privacy ~= "Friends" then
			return
		end
		party.Level = level
		party.LevelChosen = true
		party.MaxPlayers = max
		party.Privacy = privacy
		party.Status = "Waiting"
		party.EndsAt = Util.Now() + countdownFor(max)
		markDirty(party)
		refreshPad(party.Pad, true)
		playPadSound(party.Pad, "Pop")
		return
	end

	if action == "SetMax" then
		if not isInteger(value) or value &lt; 1 or value &gt; MAX_PLAYERS then
			return
		end
		if value &lt; #party.Members then
			notify(player, "There are already " .. #party.Members .. " players in the party.", "Bad")
			return
		end
		local was = party.MaxPlayers
		party.MaxPlayers = value
		if party.Status == "Waiting" and value ~= was and (value == 1 or was == 1) then
			-- a party of one goes almost straight away; opening it up gives others time to join
			party.EndsAt = Util.Now() + countdownFor(value)
		end
	elseif action == "SetPrivacy" then
		if value ~= "Public" and value ~= "Friends" then
			return
		end
		party.Privacy = value
	elseif action == "SetLevel" then
		if not isInteger(value) or value &lt; 1 or value &gt; #Config.Levels then
			return
		end
		if value &gt; unlockedOf(player) then
			notify(player, "That level is still locked!", "Bad")
			return
		end
		party.Level = value
		party.LevelChosen = true
	elseif action == "StartNow" then
		if party.Status ~= "Waiting" then
			return
		end
		local locked, why = Config.EventLockdown()
		if locked then
			notify(player, why, "Bad")
			return
		end
		party.EndsAt = math.min(party.EndsAt, Util.Now()) -- the poll loop launches it next tick
	else
		return
	end
	markDirty(party)
	refreshPad(party.Pad)
end

----------------------------------------------------------------------------------------------------
-- Players joining and leaving the server
----------------------------------------------------------------------------------------------------

local function onPlayerRemoving(player: Player)
	removeMember(player, "Gone")
	unhookMember(player)
	pendingJoin[player] = nil
	launching[player] = nil
	cooldownUntil[player] = nil
	mustLeave[player] = nil
	lastPutBack[player] = nil
	actionWindow[player] = nil
	friendCache[player] = nil
	local userId = player.UserId
	for _, byHost in friendCache do
		byHost[userId] = nil
	end
end

-- A host whose profile finished loading after they made the party: default the level to their best
-- dishwasher (unless they already picked one) and send the new HostUnlocked.
local function onProfileLoaded(player: Player)
	local party = memberOf[player]
	if not party or party.Dead then
		return
	end
	if party.Host == player and not party.LevelChosen and party.Status ~= "Launching" then
		party.Level = unlockedOf(player)
	end
	markDirty(party)
	refreshPad(party.Pad)
end

----------------------------------------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------------------------------------

function PartyService.Init()
	partyStateRemote = Remotes.Event("PartyState")
	notifyRemote = Remotes.Event("Notify")

	if not loadPads() then
		warn("[PartyService] lobby pads not ready at Init; will keep trying")
	end

	Remotes.Event("PartyAction").OnServerEvent:Connect(onPartyAction)

	Players.PlayerAdded:Connect(function(player)
		player:SetAttribute("InParty", false)
	end)
	for _, player in Players:GetPlayers() do
		if player:GetAttribute("InParty") == nil then
			player:SetAttribute("InParty", false)
		end
	end
	Players.PlayerRemoving:Connect(onPlayerRemoving)

	local profileLoaded = DataService.ProfileLoaded
	if profileLoaded then
		profileLoaded:Connect(onProfileLoaded)
	end

	-- Party members are removed the moment they die, so a respawning player is never in a party and
	-- this resolver has no opinion (the lobby spawn or RoundService decides).
	Characters.AddRespawnResolver(function(_player: Player): CFrame?
		return nil
	end)
end

function PartyService.Start()
	task.spawn(function()
		while true do
			local ok, err = xpcall(tick, debug.traceback)
			if not ok then
				warnThrottled("poll error: " .. tostring(err))
			end
			task.wait(PARTY.PollInterval)
		end
	end)

	-- Billboards: the countdown text changes once a second, so 4 checks a second keeps it crisp.
	task.spawn(function()
		while true do
			task.wait(LABEL_INTERVAL)
			for _, pad in pads do
				local ok, err = pcall(refreshPad, pad)
				if not ok then
					warnThrottled("pad refresh error: " .. tostring(err))
				end
			end
		end
	end)
end

function PartyService.IsInParty(player: Player): boolean
	return memberOf[player] ~= nil
end

-- Takes a player out of their party right now (ignores the launch lock), walking them out of the
-- pad unless they're in a run.
function PartyService.RemovePlayer(player: Player)
	removeMember(player, "Exit")
end

return PartyService</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000020"><Properties><string name="Name">PetService</string><ProtectedString name="Source">-- PetService: pet inventory (Hatch / Equip / Unequip / EquipBest / Delete), the EquippedPets
-- folders clients render from, and the pet auto-clean loop inside runs.
--
--   * Every inventory op validates everything first, then writes the profile with no yield in
--     between, then pushes MetaState, rebuilds EquippedPets and refreshes run stats. Ops never
--     throw: any error comes back as { Ok = false, Error = ... }. A per-player lock stops two
--     requests from interleaving if a DataService call ever yields.
--   * Hatch rolls the pets BEFORE taking the Bubbles, so nothing after the payment can fail halfway.
--   * Only the first GetPetSlots(player) valid uids of profile.Equipped are "active" (rendered and
--     cleaning). Equipped is never trimmed on load: game passes are checked asynchronously after
--     the profile loads, so trimming would cost a +2 slot owner their pets on every join. A slow
--     watcher rebuilds whenever the slot count changes (perk bought, pass granted).
--   * Auto-clean (every PetRules.ThinkInterval): each active slot holds one grime target. The pet
--     "flies" for distance / Speed seconds (clients animate it from the Target ObjectValue), then
--     deals GetRunPower(owner) * PowerShare per second through RoundService.DamageGrime(..., true).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Types = require(Shared:WaitForChild("Types"))
local Util = require(Shared:WaitForChild("Util"))

local DataService = require(script.Parent:WaitForChild("DataService"))
local RoundService = require(script.Parent:WaitForChild("RoundService"))

local PetService = {}

----------------------------------------------------------------------------------------------------
-- Tuning (gameplay numbers live in Config.PetRules)
----------------------------------------------------------------------------------------------------

local RULES = Config.PetRules
local FOLDER_NAME = "EquippedPets"
local PAY_INTERVAL = 1 -- seconds: a pet's cleaning is paid out this often
local MAX_HIT_DT = RULES.ThinkInterval * 2 -- a server hitch can't turn into one giant pet hit
local QUERY_MAX_PARTS = 250 -- grime parts considered per owner per think
local SLOT_WATCH_INTERVAL = 1 -- seconds between slot-count checks (perks / passes / late profiles)
local MAX_SLOTS = 20 -- sanity clamp on whatever GetPetSlots returns
local MAX_UID_LENGTH = 16
-- Legendary hatches are announced after the hatcher's reveal animation (egg wobbles, flash,
-- card), so their own toast doesn't spoil it.
local ANNOUNCE_DELAY = 3
local LOADING = "Your data is still loading. Try again in a moment!"

----------------------------------------------------------------------------------------------------
-- Types
----------------------------------------------------------------------------------------------------

-- Profile fields this service reads and writes (DESIGN.md section 5, DataService).
type Profile = {
	Bubbles: number,
	Perks: { [string]: number },
	Pets: { Types.PetEntry },
	Equipped: { string },
	NextUid: number,
	Unlocked: number,
}

type ActiveEntry = { Uid: string, Id: string, Tier: number, Share: number, Capacity: number }

-- One active pet slot: the replicated StringValue/ObjectValue pair plus server-only cleaning state.
type Slot = {
	Uid: string,
	PetId: string,
	Share: number, -- Config.PetStats Speed (share of the owner's pet power per second)
	Tier: number,
	Capacity: number, -- bag size in dirt units, before the level multiplier
	Bag: number, -- units cleaned and not yet paid out (paid every PAY_INTERVAL)
	LastPay: number?, -- os.clock() of the last payout
	Value: StringValue, -- EquippedPets["&lt;index&gt;"], Value = pet id; attributes Uid, Tier, Bag (0..1)
	TargetValue: ObjectValue, -- its "Target" child
	Target: BasePart?, -- the grime part this pet is cleaning (mirrors TargetValue.Value)
	ArriveAt: number, -- os.clock() when the pet reaches Target
	LastHit: number, -- os.clock() of the last damage tick (the next tick's dt starts here)
	From: Vector3?, -- where the pet just finished a spot (travel starts there); nil = at the owner
}

type OwnerState = {
	Slots: { Slot },
	Cap: number, -- slot count the folder was last built with (-1 = never built)
	Loaded: boolean, -- the profile has been seen and sanitized
	Ignore: { [BasePart]: boolean }, -- weak-keyed: parts DamageGrime refused (not grime of this run)
}

----------------------------------------------------------------------------------------------------
-- State
----------------------------------------------------------------------------------------------------

local owners: { [Player]: OwnerState } = {}
local busy: { [Player]: boolean } = {}
-- Players who have left. Weak keys, so this can't leak; it stops a late rebuild from recreating
-- state for someone who is already gone.
local gone: { [Player]: boolean } = setmetatable({}, { __mode = "k" }) :: any
local rng = Random.new()
local overlap = OverlapParams.new()
overlap.FilterType = Enum.RaycastFilterType.Include
overlap.MaxParts = QUERY_MAX_PARTS

local NotifyRemote: RemoteEvent

----------------------------------------------------------------------------------------------------
-- Small helpers
----------------------------------------------------------------------------------------------------

-- pcall wrapper for calls into other services (DataService / RoundService may be mid-rewrite or
-- fail); errors are logged and swallowed so an inventory op never half-applies because of them.
local function safe(fn: any, ...: any): (boolean, any)
	if type(fn) ~= "function" then
		return false, nil
	end
	local ok, result = pcall(fn, ...)
	if not ok then
		warn("[PetService] " .. tostring(result))
		return false, nil
	end
	return true, result
end

local function fail(message: string): Types.RequestResult
	return { Ok = false, Error = message }
end

local function isHere(player: Player): boolean
	return player.Parent == Players and not gone[player]
end

local function getProfile(player: Player): Profile?
	local ok, profile = safe(DataService.Get, player)
	if ok and type(profile) == "table" then
		return profile :: Profile
	end
	return nil
end

-- Equip slots right now, from DataService (perks + passes). Falls back to perks only.
local function slotCap(player: Player, profile: Profile?): number
	local ok, n = safe(DataService.GetPetSlots, player)
	if not ok or type(n) ~= "number" or n ~= n then
		n = Config.PetSlots(profile and profile.Perks, nil)
	end
	return math.clamp(math.floor(n), 0, MAX_SLOTS)
end

local function inRun(player: Player): boolean
	local ok, result = safe(RoundService.IsInRun, player)
	return ok and result == true
end

-- Living character root, without depending on Characters (not in PetService's dependency list).
local function getRoot(player: Player): BasePart?
	local character = player.Character
	if not character then
		return nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health &lt;= 0 then
		return nil
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root
	end
	return nil
end

-- Client uids arrive as strings; tolerate an integer number, reject anything else.
local function normalizeUid(value: any): string?
	if type(value) == "number" and value == value and value % 1 == 0 and value &gt; 0 and value &lt; 1e12 then
		return string.format("%d", value)
	end
	if type(value) == "string" and #value &gt; 0 and #value &lt;= MAX_UID_LENGTH then
		return value
	end
	return nil
end

-- Numeric uids compare as numbers (so "10" sorts after "9"); anything else as strings.
local function uidLess(a: string, b: string): boolean
	local na, nb = tonumber(a), tonumber(b)
	if na and nb and na ~= nb then
		return na &lt; nb
	end
	return a &lt; b
end

local function findPet(profile: Profile, uid: string): (Types.PetEntry?, number?)
	for i, pet in profile.Pets do
		if pet.Uid == uid then
			return pet, i
		end
	end
	return nil, nil
end

----------------------------------------------------------------------------------------------------
-- Profile hygiene
----------------------------------------------------------------------------------------------------

--[[
	Makes the pet fields safe to work with. Cheap (at most MaxInventory pets), so every op runs it:
	  * Pets: drops malformed entries and duplicate uids. Pets whose id left Config are KEPT (they may
	    come back); they just can't be equipped.
	  * Equipped: drops duplicates, unknown uids and pets without a Config entry. It is NOT trimmed
	    to the slot count (see the header).
	  * NextUid: a positive integer greater than every numeric uid, so a new uid can never collide.
]]
local function sanitize(profile: Profile)
	local p = profile :: any
	if type(p.Pets) ~= "table" then
		p.Pets = {}
	end
	if type(p.Equipped) ~= "table" then
		p.Equipped = {}
	end

	local pets = {}
	local byUid: { [string]: Types.PetEntry } = {}
	local maxUid = 0
	for _, pet in p.Pets do
		if type(pet) == "table" and type(pet.Uid) == "string" and type(pet.Id) == "string" and not byUid[pet.Uid] then
			-- Tier: nil (normal), 2 (Golden) or 3 (Rainbow); anything else is dropped.
			if pet.Tier ~= nil and not (pet.Tier == 2 or pet.Tier == 3) then
				pet.Tier = nil
			end
			byUid[pet.Uid] = pet
			table.insert(pets, pet)
			local n = tonumber(pet.Uid)
			if n and n &gt; maxUid then
				maxUid = n
			end
		end
	end
	if #pets ~= #p.Pets then
		p.Pets = pets
	end

	local equipped = {}
	local seen: { [string]: boolean } = {}
	for _, uid in p.Equipped do
		local pet = type(uid) == "string" and byUid[uid] or nil
		if pet and not seen[uid] and Config.Pets[pet.Id] then
			seen[uid] = true
			table.insert(equipped, uid)
		end
	end
	if #equipped ~= #p.Equipped then
		p.Equipped = equipped
	end

	local raw = tonumber(p.NextUid)
	local nextUid: number = 1
	if raw and raw == raw and raw &gt;= 1 and raw &lt; math.huge then
		nextUid = math.floor(raw)
	end
	if nextUid &lt;= maxUid then
		nextUid = math.floor(maxUid) + 1
	end
	p.NextUid = nextUid
end

-- The pets that are actually out: the first `cap` equipped uids that still resolve to a Config pet.
local function activeEntries(profile: Profile, cap: number): { ActiveEntry }
	local byUid: { [string]: Types.PetEntry } = {}
	for _, pet in profile.Pets do
		byUid[pet.Uid] = pet
	end
	local out: { ActiveEntry } = {}
	for _, uid in profile.Equipped do
		if #out &gt;= cap then
			break
		end
		local pet = byUid[uid]
		local stats = pet and Config.PetStats(pet.Id, pet.Tier)
		if pet and stats then
			table.insert(out, { Uid = uid, Id = pet.Id, Tier = pet.Tier or 1, Share = stats.Speed, Capacity = stats.Capacity })
		end
	end
	return out
end

----------------------------------------------------------------------------------------------------
-- EquippedPets folder (DESIGN.md section 4): StringValue "1".."n" (Value = pet id), each with an
-- ObjectValue "Target" (Value = grime part or nil). Clients render from this and nothing else.
----------------------------------------------------------------------------------------------------

local function ensureState(player: Player): OwnerState?
	if not isHere(player) then
		return nil
	end
	local state = owners[player]
	if not state then
		state = {
			Slots = {},
			Cap = -1,
			Loaded = false,
			Ignore = setmetatable({}, { __mode = "k" }) :: any,
		}
		owners[player] = state
	end
	return state
end

local function getFolder(player: Player): Folder?
	if not isHere(player) then
		return nil
	end
	local existing = player:FindFirstChild(FOLDER_NAME)
	if existing and existing:IsA("Folder") then
		return existing
	end
	local folder = Instance.new("Folder")
	folder.Name = FOLDER_NAME
	folder.Parent = player
	return folder
end

local function setTarget(slot: Slot, part: BasePart?)
	slot.Target = part
	if slot.TargetValue.Value ~= part then
		slot.TargetValue.Value = part
	end
end

local function destroySlot(slot: Slot)
	slot.Target = nil
	slot.Value:Destroy()
end

local function newSlot(folder: Folder, index: number, entry: ActiveEntry): Slot
	local value = Instance.new("StringValue")
	value.Name = tostring(index)
	value.Value = entry.Id
	value:SetAttribute("Uid", entry.Uid)
	value:SetAttribute("Tier", entry.Tier)

	local target = Instance.new("ObjectValue")
	target.Name = "Target"
	target.Parent = value

	value.Parent = folder
	return {
		Uid = entry.Uid,
		PetId = entry.Id,
		Share = entry.Share,
		Tier = entry.Tier,
		Capacity = entry.Capacity,
		Bag = 0,
		LastPay = nil,
		Value = value,
		TargetValue = target,
		Target = nil,
		ArriveAt = 0,
		LastHit = 0,
		From = nil,
	}
end

--[[
	Brings the folder in line with the profile. A slot whose pet id is unchanged keeps its
	StringValue (and its target), so the client model doesn't flicker. A slot whose pet changed is
	destroyed and recreated, so a renderer that only listens to ChildAdded/ChildRemoved stays correct.
]]
local function rebuild(player: Player)
	local state = ensureState(player)
	local folder = getFolder(player)
	if not state or not folder then
		return
	end
	local profile = getProfile(player)
	local cap = slotCap(player, profile)
	local active: { ActiveEntry } = {}
	if profile then
		sanitize(profile)
		state.Loaded = true
		active = activeEntries(profile, cap)
	end
	state.Cap = cap

	for i, entry in active do
		local slot = state.Slots[i]
		if slot and slot.PetId == entry.Id and slot.Tier == entry.Tier and slot.Value.Parent == folder then
			slot.Uid = entry.Uid
			slot.Share = entry.Share
			slot.Capacity = entry.Capacity
			if slot.Value:GetAttribute("Uid") ~= entry.Uid then
				slot.Value:SetAttribute("Uid", entry.Uid)
			end
		else
			if slot then
				destroySlot(slot)
			end
			state.Slots[i] = newSlot(folder, i, entry)
		end
	end
	for i = #state.Slots, #active + 1, -1 do
		destroySlot(state.Slots[i])
		state.Slots[i] = nil
	end

	-- Anything else in the folder (left over from an old slot layout) goes.
	local keep: { [Instance]: boolean } = {}
	for _, slot in state.Slots do
		keep[slot.Value] = true
	end
	for _, child in folder:GetChildren() do
		if not keep[child] then
			child:Destroy()
		end
	end
end

----------------------------------------------------------------------------------------------------
-- Auto-clean loop (DESIGN.md section 5, "PetService"). Every ThinkInterval, for players in a run:
--   * a slot keeps its target while it's still alive and within Range of the owner
--   * otherwise it claims the nearest unclaimed grime part within Range (parts already targeted by
--     another slot of the same owner this tick don't count)
--   * a freshly-claimed target gets an arrival delay (distance / Speed); only after arriving does it
--     start dealing GetRunPower(owner) * PowerShare per second, applied via RoundService.DamageGrime
--   * a full tank clears every target (pets drift back to the owner formation on the client)
--   * outside a run every Target is nil
----------------------------------------------------------------------------------------------------


local function runPower(player: Player): number
	local ok, power = safe(RoundService.GetRunPower, player)
	if ok and type(power) == "number" and power == power and power &gt;= 0 then
		return power
	end
	return 0
end

-- (alive, units): alive while the part still stands; units the pet picked up if it finished it.
local function damageGrime(owner: Player, part: BasePart, amount: number): (boolean, number)
	local ok, alive, units = pcall(RoundService.DamageGrime, owner, part, amount, true)
	if not ok then
		warn("[PetService] " .. tostring(alive))
		return false, 0
	end
	return alive == true, tonumber(units) or 0
end

local function grimeFolderOf(player: Player): Folder?
	local ok, folder = safe(RoundService.GetGrimeFolder, player)
	if ok and typeof(folder) == "Instance" and folder:IsA("Folder") then
		return folder
	end
	return nil
end

-- Drops every slot's target (used when the owner leaves the run or their tank fills up).
local function clearTargets(state: OwnerState)
	for _, slot in state.Slots do
		if slot.Target then
			setTarget(slot, nil)
		end
		slot.From = nil
	end
end

-- Nearest grime part in `grimeFolder` within Range of `root` that isn't in `claimed` or `ignored`.
local function pickTarget(root: BasePart, grimeFolder: Folder, claimed: { [BasePart]: boolean }, ignored: { [BasePart]: boolean }): BasePart?
	overlap.FilterDescendantsInstances = { grimeFolder }
	local ok, parts = pcall(workspace.GetPartBoundsInRadius, workspace, root.Position, RULES.Range, overlap)
	if not ok or type(parts) ~= "table" then
		return nil
	end
	local best: BasePart? = nil
	local bestDist = math.huge
	for _, part in parts do
		if part:IsA("BasePart") and not claimed[part] and not ignored[part] then
			local dist = (part.Position - root.Position).Magnitude
			if dist &lt;= RULES.Range and dist &lt; bestDist then
				best = part
				bestDist = dist
			end
		end
	end
	return best
end

-- One think tick for a single owner. `now` is os.clock(), shared by every owner this tick.
local function think(player: Player, state: OwnerState, now: number)
	if #state.Slots == 0 then
		return
	end
	if not inRun(player) then
		clearTargets(state)
		return
	end
	local root = getRoot(player)
	local grimeFolder = grimeFolderOf(player)
	-- An admin who is hidden (invisible, spectating, controlling someone) has their pets put away.
	local character = player.Character
	local hidden = character ~= nil and character:GetAttribute("AdminHidden") == true
	-- Switched off by the player (the Pets On / Off button): they just follow, no cleaning.
	local resting = player:GetAttribute("PetsResting") == true
	if not root or not grimeFolder or hidden or resting then
		clearTargets(state)
		return
	end

	-- Parts already spoken for this tick, so two slots of the same owner never chase the same spot.
	local claimed: { [BasePart]: boolean } = {}
	for _, slot in state.Slots do
		if slot.Target then
			claimed[slot.Target] = true
		end
	end

	local power = runPower(player)

	for slotIndex, slot in state.Slots do
		-- No bag any more: what a pet cleans is paid straight to the owner's coins, gathered up
		-- and paid about once a second (PAY_INTERVAL) so the coin pop-ups don't spam.
		if slot.Bag &gt; 0 and now - (slot.LastPay or 0) &gt;= PAY_INTERVAL then
			local units = slot.Bag
			slot.Bag = 0
			slot.LastPay = now
			safe(RoundService.PayPetCoins, player, units, slotIndex) -- "+coins" floats over that pet
		end

		local target = slot.Target
		if target then
			local alive = target.Parent == grimeFolder
			if alive and (target.Position - root.Position).Magnitude &gt; RULES.Range then
				alive = false
			end
			if not alive then
				claimed[target] = nil
				slot.From = target.Position
				setTarget(slot, nil)
				target = nil
			end
		end

		if not target then
			local pick = pickTarget(root, grimeFolder, claimed, state.Ignore)
			if pick then
				claimed[pick] = true
				local from = slot.From or root.Position
				local travel = (pick.Position - from).Magnitude / RULES.Speed
				slot.ArriveAt = now + travel
				slot.LastHit = now + travel -- damage starts counting from the moment it arrives
				slot.From = nil
				setTarget(slot, pick)
				target = pick
			end
		end

		if target and now &gt;= slot.ArriveAt then
			local sinceLast = math.min(now - slot.LastHit, MAX_HIT_DT)
			if sinceLast &gt; 0 then
				slot.LastHit = now
				local amount = power * slot.Share * sinceLast
				if amount &gt; 0 then
					local alive, units = damageGrime(player, target, amount)
					if units &gt; 0 then
						slot.Bag += units
					end
					if not alive then
						if target.Parent then
							-- Refused for a reason other than dying (e.g. it stopped belonging to this
							-- run mid-tick). Remember it so this slot doesn't just re-target it.
							state.Ignore[target] = true
						end
						slot.From = target.Position
						setTarget(slot, nil)
					end
				end
			end
		end
	end
end

local function autoCleanTick()
	local now = os.clock()
	for player, state in owners do
		if isHere(player) then
			local ok, err = pcall(think, player, state, now)
			if not ok then
				warn("[PetService] auto-clean tick failed for " .. player.Name .. ": " .. tostring(err))
			end
		end
	end
end

-- Catches slot-count changes that don't go through PetService itself: a Pet Slot perk purchase
-- (ShopService writes profile.Perks directly) or a +2 Pet Slots pass grant that raced ahead of
-- PassesChanged (SetPass already fires it, but this is a cheap, harmless backstop).
local function slotWatchTick()
	for player, state in owners do
		if isHere(player) and state.Loaded then
			local profile = getProfile(player)
			local cap = slotCap(player, profile)
			if cap ~= state.Cap then
				local ok, err = pcall(rebuild, player)
				if not ok then
					warn("[PetService] slot watcher rebuild failed for " .. player.Name .. ": " .. tostring(err))
				end
			end
		end
	end
end

----------------------------------------------------------------------------------------------------
-- Inventory operations
----------------------------------------------------------------------------------------------------

-- Everything that follows a successful change. equipChanged = the active pets may differ, which
-- changes the coin bonus RoundService folds into run stats.
local function afterChange(player: Player, equipChanged: boolean)
	safe(DataService.PushMeta, player)
	rebuild(player)
	if equipChanged and inRun(player) then
		safe(RoundService.RefreshStats, player)
	end
end

-- Runs one op under the player's lock and turns any error into a RequestResult.
local function guarded(player: any, op: (Player, any, any) -&gt; Types.RequestResult, a: any, b: any): Types.RequestResult
	if typeof(player) ~= "Instance" or not player:IsA("Player") then
		return fail("Unknown player.")
	end
	if busy[player] then
		return fail("Hold on, still working on your last request!")
	end
	busy[player] = true
	local ok, result = pcall(op, player, a, b)
	busy[player] = nil
	if not ok then
		warn("[PetService] " .. tostring(result))
		return fail("Something went wrong. Try again!")
	end
	return result
end

-- Puts newly hatched pets into empty slots (never replaces anything). Returns true if it did.
local function autoEquip(player: Player, profile: Profile, hatched: { Types.PetEntry }): boolean
	local cap = slotCap(player, profile)
	local changed = false
	for _, pet in hatched do
		if #profile.Equipped &gt;= cap then
			break
		end
		table.insert(profile.Equipped, pet.Uid)
		changed = true
	end
	return changed
end

local function announceLegendary(player: Player, petName: string)
	local who = player.DisplayName
	task.delay(ANNOUNCE_DELAY, function()
		NotifyRemote:FireAllClients(string.format("%s hatched a Legendary %s!", who, petName), "Good")
	end)
end

local function hatch(player: Player, eggId: any, count: any): Types.RequestResult
	if type(eggId) ~= "string" then
		return fail("That egg doesn't exist.")
	end
	if count ~= 1 and count ~= 3 then
		return fail("You can hatch 1 or 3 eggs at a time.")
	end
	local egg = Config.GetEgg(eggId)
	if not egg then
		return fail("That egg doesn't exist.")
	end
	local profile = getProfile(player)
	if not profile then
		return fail(LOADING)
	end
	sanitize(profile)

	local unlocked = tonumber(profile.Unlocked) or 1
	if unlocked &lt; egg.RequiredLevel then
		local level = Config.Levels[egg.RequiredLevel]
		local where = if level then level.Name else "the next dishwasher"
		return fail(string.format("Unlock %s to hatch the %s!", where, egg.Name))
	end
	local room = RULES.MaxInventory - #profile.Pets
	if room &lt; count then
		if room &lt;= 0 then
			return fail("Your pet inventory is full! Delete some pets first.")
		end
		return fail(string.format("Only room for %d more pet%s! Delete some first.", room, if room == 1 then "" else "s"))
	end
	local cost = egg.Cost * count
	if (tonumber(profile.Bubbles) or 0) &lt; cost then
		return fail(string.format("Not enough Bubbles! You need %s.", Format.Commas(cost)))
	end

	-- Roll first: after the payment below, nothing can fail.
	local rolled: { string } = {}
	for i = 1, count do
		rolled[i] = Util.WeightedPick(egg.Pets, "Chance", rng).Pet
	end
	local paid, spent = safe(DataService.SpendBubbles, player, cost)
	if not paid or spent ~= true then
		return fail("Not enough Bubbles!")
	end

	local used: { [string]: boolean } = {}
	for _, pet in profile.Pets do
		used[pet.Uid] = true
	end
	local nextUid = profile.NextUid
	local hatched: { Types.PetEntry } = {}
	for _, petId in rolled do
		while used[tostring(nextUid)] do
			nextUid += 1
		end
		local uid = tostring(nextUid)
		nextUid += 1
		used[uid] = true
		table.insert(profile.Pets, { Uid = uid, Id = petId })
		table.insert(hatched, { Uid = uid, Id = petId }) -- a separate copy goes over the network
	end
	profile.NextUid = nextUid

	safe(DataService.AddStat, player, "EggsHatched", count)
	afterChange(player, autoEquip(player, profile, hatched))

	for _, pet in hatched do
		local def = Config.Pets[pet.Id]
		if def and def.Rarity == "Legendary" then
			announceLegendary(player, def.Name)
		end
	end
	return { Ok = true, Pets = hatched }
end

local function equip(player: Player, rawUid: any): Types.RequestResult
	local uid = normalizeUid(rawUid)
	local profile = getProfile(player)
	if not profile then
		return fail(LOADING)
	end
	sanitize(profile)
	local pet = uid and findPet(profile, uid)
	if not uid or not pet then
		return fail("That pet doesn't exist.")
	end
	if not Config.Pets[pet.Id] then
		return fail("That pet can't be equipped.")
	end
	if table.find(profile.Equipped, uid) then
		return { Ok = true } -- already out (double click): nothing to do
	end
	local cap = slotCap(player, profile)
	if #profile.Equipped &gt;= cap then
		return fail(string.format("All %d pet slots are full! Unequip a pet first.", cap))
	end
	table.insert(profile.Equipped, uid)
	afterChange(player, true)
	return { Ok = true }
end

local function unequip(player: Player, rawUid: any): Types.RequestResult
	local uid = normalizeUid(rawUid)
	local profile = getProfile(player)
	if not profile then
		return fail(LOADING)
	end
	sanitize(profile)
	if not uid or not findPet(profile, uid) then
		return fail("That pet doesn't exist.")
	end
	local index = table.find(profile.Equipped, uid)
	if not index then
		return { Ok = true } -- already put away
	end
	table.remove(profile.Equipped, index)
	afterChange(player, true)
	return { Ok = true }
end

type Ranked = { Uid: string, Share: number, Coin: number }

local function equipBest(player: Player): Types.RequestResult
	local profile = getProfile(player)
	if not profile then
		return fail(LOADING)
	end
	sanitize(profile)

	local ranked: { Ranked } = {}
	for _, pet in profile.Pets do
		local stats = Config.PetStats(pet.Id, pet.Tier)
		if stats then
			table.insert(ranked, { Uid = pet.Uid, Share = stats.Speed + stats.Capacity * 0.002, Coin = stats.CoinBonus })
		end
	end
	if #ranked == 0 then
		return fail("You don't have any pets yet. Hatch an egg!")
	end
	-- Best cleaners first; ties go to the bigger coin bonus, then the older pet (stable order).
	table.sort(ranked, function(a, b)
		if a.Share ~= b.Share then
			return a.Share &gt; b.Share
		end
		if a.Coin ~= b.Coin then
			return a.Coin &gt; b.Coin
		end
		return uidLess(a.Uid, b.Uid)
	end)

	local cap = slotCap(player, profile)
	local best: { [string]: boolean } = {}
	for i = 1, math.min(cap, #ranked) do
		best[ranked[i].Uid] = true
	end
	-- Pets that stay keep their slot position (no model shuffle on the client); the rest follow in
	-- rank order.
	local equipped: { string } = {}
	for _, uid in profile.Equipped do
		if best[uid] then
			table.insert(equipped, uid)
			best[uid] = nil
		end
	end
	for i = 1, math.min(cap, #ranked) do
		local uid = ranked[i].Uid
		if best[uid] then
			table.insert(equipped, uid)
		end
	end

	local changed = #equipped ~= #profile.Equipped
	if not changed then
		for i, uid in equipped do
			if profile.Equipped[i] ~= uid then
				changed = true
				break
			end
		end
	end
	if changed then
		profile.Equipped = equipped
		afterChange(player, true)
	end
	return { Ok = true }
end

local function delete(player: Player, rawUid: any): Types.RequestResult
	local uid = normalizeUid(rawUid)
	local profile = getProfile(player)
	if not profile then
		return fail(LOADING)
	end
	sanitize(profile)
	if not uid then
		return fail("That pet doesn't exist.")
	end
	local _, index = findPet(profile, uid)
	if not index then
		return fail("That pet doesn't exist.")
	end
	table.remove(profile.Pets, index)
	local equippedAt = table.find(profile.Equipped, uid)
	if equippedAt then
		table.remove(profile.Equipped, equippedAt)
	end
	afterChange(player, equippedAt ~= nil)
	return { Ok = true }
end

-- Merge: three of the SAME pet at the same tier become one of that pet at the next tier (normal -&gt;
-- Golden -&gt; Rainbow; Config.PetTiers). If any of them was out, the new one takes its slot.
local MERGE_COUNT = RULES.MergeCount or 3

local function merge(player: Player, rawUids: any): Types.RequestResult
	if type(rawUids) ~= "table" then
		return fail("Pick three of the same pet to merge.")
	end
	local profile = getProfile(player)
	if not profile then
		return fail(LOADING)
	end
	sanitize(profile)
	local uids: { string } = {}
	local seen: { [string]: boolean } = {}
	local petId: string? = nil
	local tier = 1
	for i = 1, MERGE_COUNT do
		local uid = normalizeUid(rawUids[i])
		local pet = uid and findPet(profile, uid)
		if not uid or seen[uid] or not pet or not Config.Pets[pet.Id] then
			return fail("Pick three different pets to merge.")
		end
		if Config.Pets[pet.Id].Event then
			return fail("Limited pets can't be merged.")
		end
		local petTier = pet.Tier or 1
		if petId and (pet.Id ~= petId or petTier ~= tier) then
			return fail("Merging needs three of the SAME pet at the same tier.")
		end
		petId, tier = pet.Id, petTier
		seen[uid] = true
		uids[i] = uid
	end
	if tier &gt;= #Config.PetTiers then
		return fail("Rainbow pets are already maxed!")
	end

	-- Everything is checked: remove the three, add the new one (no yields in between).
	local slot: number? = nil
	for _, uid in uids do
		local _, index = findPet(profile, uid)
		if index then
			table.remove(profile.Pets, index)
		end
		local at = table.find(profile.Equipped, uid)
		if at then
			table.remove(profile.Equipped, at)
			slot = math.min(slot or at, at)
		end
	end
	local used: { [string]: boolean } = {}
	for _, pet in profile.Pets do
		used[pet.Uid] = true
	end
	local nextUid = profile.NextUid
	while used[tostring(nextUid)] do
		nextUid += 1
	end
	local uid = tostring(nextUid)
	profile.NextUid = nextUid + 1
	local newTier = tier + 1
	table.insert(profile.Pets, { Uid = uid, Id = petId :: string, Tier = newTier })
	if slot then
		table.insert(profile.Equipped, math.min(slot, #profile.Equipped + 1), uid)
	end
	afterChange(player, true)
	return { Ok = true, Pets = { { Uid = uid, Id = petId :: string, Tier = newTier } } }
end

-- Public API: each returns a Types.RequestResult and never throws.

-- Admin (:givepet): adds one pet (tier 1 normal, 2 Golden, 3 Rainbow) to the player's collection.
function PetService.GivePet(player: Player, petId: string, tier: number?): (boolean, string?)
	local profile = DataService.Get(player)
	if not profile then
		return false, "Their data isn't loaded yet"
	end
	if not Config.Pets[petId] then
		return false, "That pet doesn't exist"
	end
	if #profile.Pets &gt;= Config.PetRules.MaxInventory then
		return false, "Their pet inventory is full"
	end
	local used: { [string]: boolean } = {}
	for _, pet in profile.Pets do
		used[pet.Uid] = true
	end
	local nextUid = profile.NextUid
	while used[tostring(nextUid)] do
		nextUid += 1
	end
	local entry: Types.PetEntry = { Uid = tostring(nextUid), Id = petId }
	if tier and tier &gt; 1 then
		entry.Tier = tier
	end
	table.insert(profile.Pets, entry)
	profile.NextUid = nextUid + 1
	afterChange(player, false)
	return true, nil
end

function PetService.Merge(player: Player, uids: { string }): Types.RequestResult
	return guarded(player, merge, uids)
end

function PetService.Hatch(player: Player, eggId: string, count: number): Types.RequestResult
	return guarded(player, hatch, eggId, count)
end

function PetService.Equip(player: Player, uid: string): Types.RequestResult
	return guarded(player, equip, uid)
end

function PetService.Unequip(player: Player, uid: string): Types.RequestResult
	return guarded(player, unequip, uid)
end

function PetService.EquipBest(player: Player): Types.RequestResult
	return guarded(player, function(p)
		return equipBest(p)
	end)
end

function PetService.Delete(player: Player, uid: string): Types.RequestResult
	return guarded(player, delete, uid)
end

-- (Trading) Swaps pets between two players in one go: a's `giveA` uids go to b, b's `giveB` go to
-- a. Everything is checked first (both still own every pet, both have room), then both profiles
-- change with no yield in between, so a trade can never half-happen or duplicate a pet. Moved pets
-- get fresh uids from their new owner. Returns (true) or (false, reason).
function PetService.Transfer(a: Player, b: Player, giveA: { string }, giveB: { string }): (boolean, string?)
	if a == b or busy[a] or busy[b] then
		return false, "Hold on, still working on your last request!"
	end
	local pa, pb = getProfile(a), getProfile(b)
	if not pa or not pb then
		return false, LOADING
	end
	local function collect(profile: Profile, uids: { string }): { Types.PetEntry }?
		local out, seen = {}, {}
		for _, uid in uids do
			local pet = type(uid) == "string" and not seen[uid] and findPet(profile, uid) or nil
			if not pet then
				return nil
			end
			seen[uid] = true
			table.insert(out, pet)
		end
		return out
	end
	local petsA, petsB = collect(pa, giveA), collect(pb, giveB)
	if not petsA or not petsB then
		return false, "A pet in the trade isn't there any more."
	end
	local max = RULES.MaxInventory
	if #pa.Pets - #petsA + #petsB &gt; max or #pb.Pets - #petsB + #petsA &gt; max then
		return false, "Someone's pet inventory would be too full."
	end

	busy[a], busy[b] = true, true
	local ok, err = pcall(function()
		local function take(profile: Profile, pets: { Types.PetEntry })
			for _, pet in pets do
				local _, index = findPet(profile, pet.Uid)
				if index then
					table.remove(profile.Pets, index)
				end
				local e = table.find(profile.Equipped, pet.Uid)
				if e then
					table.remove(profile.Equipped, e)
				end
			end
		end
		local function give(profile: Profile, pets: { Types.PetEntry })
			local used = {}
			for _, pet in profile.Pets do
				used[pet.Uid] = true
			end
			local nextUid = math.max(1, math.floor(tonumber(profile.NextUid) or 1))
			for _, pet in pets do
				while used[tostring(nextUid)] do
					nextUid += 1
				end
				local entry: Types.PetEntry = { Uid = tostring(nextUid), Id = pet.Id }
				if pet.Tier and pet.Tier &gt; 1 then
					entry.Tier = pet.Tier
				end
				used[entry.Uid] = true
				table.insert(profile.Pets, entry)
				nextUid += 1
			end
			profile.NextUid = nextUid
		end
		take(pa, petsA)
		take(pb, petsB)
		give(pa, petsB)
		give(pb, petsA)
	end)
	busy[a], busy[b] = nil, nil
	if not ok then
		warn("[PetService] Transfer: " .. tostring(err))
		return false, "Something went wrong. Try again!"
	end
	afterChange(a, true)
	afterChange(b, true)
	return true, nil
end

-- Rebuilds a player's EquippedPets now (e.g. right after a Pet Slot perk purchase). Optional: the
-- slot watcher catches slot-count changes within SLOT_WATCH_INTERVAL anyway.
function PetService.Refresh(player: Player)
	if typeof(player) == "Instance" and player:IsA("Player") then
		local ok, err = pcall(rebuild, player)
		if not ok then
			warn("[PetService] Refresh: " .. tostring(err))
		end
	end
end

local initialized = false
local started = false

-- Rebuilds now, swallowing errors (used from signal handlers, where a throw would kill the signal
-- for every other listener too).
local function safeRebuild(player: Player)
	if isHere(player) then
		local ok, err = pcall(rebuild, player)
		if not ok then
			warn("[PetService] rebuild failed for " .. player.Name .. ": " .. tostring(err))
		end
	end
end

function PetService.Init()
	if initialized then
		return
	end
	initialized = true
	NotifyRemote = Remotes.Event("Notify")

	-- The profile may already be loaded for players who joined before this service subscribed
	-- (boot order, or a service restart in Studio).
	DataService.ProfileLoaded:Connect(function(player)
		safeRebuild(player)
	end)
	for _, player in Players:GetPlayers() do
		if getProfile(player) then
			task.spawn(safeRebuild, player)
		end
	end

	-- Pet slots depend on perks and passes; a pass grant (or the trim SetPass already does) can
	-- change the active count without going through any PetService op.
	DataService.PassesChanged:Connect(function(player)
		safeRebuild(player)
	end)

	Players.PlayerRemoving:Connect(function(player)
		gone[player] = true
		owners[player] = nil
		busy[player] = nil
	end)
end

function PetService.Start()
	if started then
		return
	end
	started = true

	task.spawn(function()
		while true do
			task.wait(RULES.ThinkInterval)
			autoCleanTick()
		end
	end)

	task.spawn(function()
		while true do
			task.wait(SLOT_WATCH_INTERVAL)
			slotWatchTick()
		end
	end)
end

return PetService</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000021"><Properties><string name="Name">RoundService</string><ProtectedString name="Source">-- RoundService: owns every run (one party inside one dishwasher).
--
-- A run's life:
--   StartRound  -&gt; claim an arena slot, ArenaBuilder.Build (yields), index the grime, create a
--                  PlayerRun per member, teleport them onto the open door, push RunState.
--   Playing     -&gt; Scrub packets and pets call DamageGrime; cleaned grime fills the tank; standing
--                  in the drain sells the tank for coins; coins buy upgrades and tools (RunRequest).
--   Complete    -&gt; the last spot is gone: Bubbles are paid, per-player Results are pushed, and after
--                  Config.Round.ResultsSeconds everyone still inside is sent back to the lobby.
--   Ended       -&gt; the last member left: the arena is destroyed and its slot is freed.
--
-- The server trusts nothing from the client: every Scrub is checked for run state, a finite aim,
-- reach and rate, and the damage it deals is derived from server-side time, never from the packet.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Types = require(Shared:WaitForChild("Types"))
local Util = require(Shared:WaitForChild("Util"))

local DataService = require(script.Parent:WaitForChild("DataService"))
local ArenaBuilder = require(script.Parent:WaitForChild("ArenaBuilder"))
local DishFactory = require(script.Parent:WaitForChild("DishFactory"))
local LobbyBuilder = require(script.Parent:WaitForChild("LobbyBuilder"))
local Characters = require(script.Parent:WaitForChild("Characters"))
local ToolModels = require(Shared:WaitForChild("ToolModels"))

local RoundService = {}

----------------------------------------------------------------------------------------------------
-- Types (server-side only; network payloads use Types.luau)
----------------------------------------------------------------------------------------------------

-- What ArenaBuilder.Build returns (DESIGN.md section 5, ArenaBuilder).
type Arena = {
	Slot: number,
	Name: string,
	Model: Model,
	Origin: CFrame,
	Spawns: { CFrame },
	DrainPosition: Vector3,
	DrainRadius: number?,
	StationPosition: Vector3?,
	GrimeFolder: Folder,
	Dishes: { [number]: any },
	TotalGrime: number,
	KillY: number?,
}

-- Cached copy of one grime spot's attributes. The table is the authority for HP during a run;
-- the part's "HP" attribute is only a mirror for clients.
type GrimeEntry = {
	HP: number,
	MaxHP: number,
	Units: number,
	DishId: number,
	Golden: boolean,
	MinTool: number,
	Color: Color3,
	Dead: boolean, -- set the instant the spot is retired, so a second hit in the same frame is a no-op
}

type DishState = {
	Id: number,
	Kind: string,
	Model: Model?,
	Center: Vector3,
	Remaining: number, -- grime spots left on this dish
	Units: number, -- total units of every spot it started with (for the dish bonus)
	Done: boolean,
}

type PlayerRun = {
	Coins: number,
	Tank: number,
	Upgrades: Types.RunUpgrades, -- global upgrades (TankSize, Sneakers); per-tool ones live in ToolUpgrades
	ToolIndex: number, -- the tool in hand
	OwnedTools: { boolean },
	ToolUpgrades: { Types.RunUpgrades }, -- [toolIndex] = that tool's HandSize / ScrubPower levels
	Stats: Types.RunStats,
	GrimeCleaned: number,
	LastScrubAt: number, -- os.clock() of the last accepted Scrub packet
	LastFullFX: number, -- os.clock() of the last "TankFull" FX (throttled)
	Results: Types.RunResults?,
}

type Run = {
	Id: number,
	Slot: number,
	Arena: Arena,
	ArenaName: string,
	Level: number,
	Players: { [Player]: PlayerRun },
	Order: { Player }, -- members in join order (spawn assignment, results order)
	MemberIds: { number }, -- cached UserIds for RunState.Members
	StartedAt: number, -- Util.Now() (server time, so client timers agree)
	ClockAt: number?, -- when the run clock started: the first player done with (or skipping) the cutscene
	Phase: "Playing" | "Complete",
	Ended: boolean,
	Total: number,
	Cleaned: number,
	Remaining: number,
	LastDamageAt: number, -- os.clock() (stuck guard)
	Grime: { [BasePart]: GrimeEntry },
	Dishes: { [number]: DishState },
	Overlap: OverlapParams, -- Include filter on this run's GrimeFolder, built once per run
	Splats: { FoamSplat }, -- live Foam Cannon splats, ticked by the foam loop
	Connections: { RBXScriptConnection },
	DrainSound: Sound?,
	DrainRadius: number,
	KillY: number,
}

-- A Foam Cannon splat: cleans everything within Radius of Position at Dps until Until.
type FoamSplat = { Player: Player, Position: Vector3, Radius: number, Dps: number, Until: number }

----------------------------------------------------------------------------------------------------
-- Constants
----------------------------------------------------------------------------------------------------

local R = Config.Round
local PUSH_INTERVAL = 0.1 -- RunState: at most one push per player per 0.1 s
local DRAIN_INTERVAL = 0.2
local WATCHDOG_INTERVAL = 0.5 -- fall guard + stuck guard
local DRAIN_MAX_DY = 8 -- vertical tolerance for "standing in the drain"
local TANK_FULL_FX_COOLDOWN = 2
-- Held-scrub packets closer together than this are dropped without touching LastScrubAt, so the
-- time rolls into the next accepted packet: no damage is lost, but a flood can't burn server CPU
-- on spatial queries.
local HOLD_MIN_INTERVAL = R.ScrubSendInterval * 0.4
local HP_EPSILON = 1e-3
local FOAM_TICK = 0.2
local MAX_SPLATS_PER_PLAYER = 4
local REQUESTS_PER_SECOND = 10
local LEFT_GAME = "PlayerRemoving" -- internal RemoveFromRun reason: skip everything client-facing
local EMPTY: { [string]: any } = table.freeze({})

----------------------------------------------------------------------------------------------------
-- State
----------------------------------------------------------------------------------------------------

local runs: { [number]: Run } = {}
local runOf: { [Player]: Run } = {}
local slotBusy: { [number]: boolean } = {}
local starting: { [Player]: boolean } = {} -- members of a StartRound that is still building
local pushInfo: { [Player]: { Last: number, Scheduled: boolean } } = {}
local requestWindow: { [Player]: { Start: number, Count: number } } = {}
local nextRunId = 0
local rng = Random.new()

local RunStateRemote: RemoteEvent
local RunFXRemote: RemoteEvent
local NotifyRemote: RemoteEvent

-- Forward declarations (these call each other).
local completeRun: (run: Run) -&gt; ()
local endRun: (run: Run) -&gt; ()
local sell: (run: Run, player: Player, pr: PlayerRun) -&gt; ()

----------------------------------------------------------------------------------------------------
-- Small helpers
----------------------------------------------------------------------------------------------------

-- pcall wrapper for calls into other services. A failing DataService call must never break a
-- run's bookkeeping (dish tracking, completion), so errors are logged and swallowed.
local function safe(fn: any, ...: any): (boolean, any, any, any)
	if type(fn) ~= "function" then
		return false, nil, nil, nil
	end
	local ok, a, b, c = pcall(fn, ...)
	if not ok then
		warn("[RoundService] " .. tostring(a))
		return false, nil, nil, nil
	end
	return true, a, b, c
end

local function getProfile(player: Player): any
	local ok, profile = safe(DataService.Get, player)
	if ok and type(profile) == "table" then
		return profile
	end
	return nil
end

local function getPasses(player: Player): { [string]: boolean }
	local ok, passes = safe(DataService.GetPasses, player)
	if ok and type(passes) == "table" then
		return passes
	end
	return EMPTY
end

-- A finite, strictly positive number, or nil.
local function positive(value: any): number?
	if type(value) == "number" and value == value and value &gt; 0 and value &lt; math.huge then
		return value
	end
	return nil
end

local function isHere(player: Player): boolean
	return player.Parent == Players
end

local function notify(player: Player, text: string, kind: string)
	if isHere(player) then
		NotifyRemote:FireClient(player, text, kind)
	end
end

-- RunFX to every member still in the game (never FireAllClients: other parties don't care).
local function fireAll(run: Run, kind: string, data: any)
	for member in run.Players do
		if isHere(member) then
			RunFXRemote:FireClient(member, kind, data)
		end
	end
end

local function fireOne(player: Player, kind: string, data: any)
	if isHere(player) then
		RunFXRemote:FireClient(player, kind, data)
	end
end

local warnedHealth = false
local function setGrimeHealth(part: BasePart, fraction: number)
	local ok, err = pcall(DishFactory.SetGrimeHealth, part, fraction)
	if not ok and not warnedHealth then
		warnedHealth = true
		warn("[RoundService] DishFactory.SetGrimeHealth failed: " .. tostring(err))
	end
end

local function sparkle(model: Model)
	safe(DishFactory.Sparkle, model)
end

local function lobbySpawn(): CFrame
	local ok, cf = safe(LobbyBuilder.GetSpawnCFrame)
	if ok and typeof(cf) == "CFrame" then
		return cf
	end
	return CFrame.new(Config.World.LobbyOrigin + Vector3.new(0, 3, 0))
end

local function randomSpawn(run: Run): CFrame
	local spawns = run.Arena.Spawns
	return spawns[rng:NextInteger(1, #spawns)]
end

local function newUpgrades(): Types.RunUpgrades
	local upgrades: any = { Hold = 0, HandSize = 0, ScrubPower = 0, TankSize = 0, Sneakers = 0 }
	-- Any upgrade added to Config later starts at 0 too.
	for _, def in Config.Upgrades do
		if upgrades[def.Id] == nil then
			upgrades[def.Id] = 0
		end
	end
	return upgrades
end

-- The upgrade levels that apply right now: the global ones plus the tool-in-hand's own.
local function effectiveUpgrades(pr: PlayerRun): Types.RunUpgrades
	local merged = table.clone(pr.Upgrades) :: any
	local own = pr.ToolUpgrades[pr.ToolIndex] :: any
	for _, def in Config.Upgrades do
		if def.PerTool then
			merged[def.Id] = (own and own[def.Id]) or 0
		end
	end
	return merged
end

-- Tool passes (Config.Tools[i].PassKey): the tool is yours from the start of every run.
local function grantPassTools(player: Player, pr: any): boolean
	local passes = getPasses(player)
	local changed = false
	for i, tool in Config.Tools do
		if tool.PassKey and passes[tool.PassKey] and not pr.OwnedTools[i] then
			pr.OwnedTools[i] = true
			changed = true
		end
	end
	return changed
end

local function newToolState(): ({ boolean }, { Types.RunUpgrades })
	local owned, ups = {}, {}
	for i in Config.Tools do
		owned[i] = i == 1 -- everyone starts with Bare Hands
		ups[i] = newUpgrades()
	end
	return owned, ups
end

-- Puts a model of the tool in hand into the character's right hand (everyone can see it).
local function attachHeldTool(player: Player, toolIndex: number)
	local character = player.Character
	if not character then
		return
	end
	local old = character:FindFirstChild("HeldTool")
	if old then
		old:Destroy()
	end
	if toolIndex &lt;= 1 then
		character:SetAttribute("HeldToolIndex", toolIndex)
		return
	end
	-- Only mark it attached once it really is, so the watchdog retries while the character loads.
	-- The tool hangs off the torso, held out in front at the right hand's height, so it always
	-- points where you face (in first person too) whatever the animations are doing. Clients raise
	-- the right arm to meet it (HoldPose).
	local torso = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
	if not torso or not torso:IsA("BasePart") then
		return
	end
	local ok, model = pcall(ToolModels.Build, toolIndex, 0.42, true)
	if not ok or not model then
		return
	end
	character:SetAttribute("HeldToolIndex", toolIndex)
	model.Name = "HeldTool"
	local grip = model.PrimaryPart :: BasePart
	-- Where a raised right hand ends up relative to the torso (R15 and R6 are close enough), scaled
	-- with the avatar.
	local r15 = torso.Name == "UpperTorso"
	local sx = torso.Size.X / 2
	local sy = torso.Size.Y / (if r15 then 1.6 else 2)
	local handPoint = CFrame.new(1.5 * sx, (if r15 then 0.55 else 0.5) * sy, -1.9 * sy)
	local offset = handPoint * ToolModels.HoldOffset(toolIndex)
	model:PivotTo(torso.CFrame * offset)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = false
			d.Massless = true
			if d ~= grip then
				local weld = Instance.new("WeldConstraint")
				weld.Part0 = grip
				weld.Part1 = d
				weld.Parent = d
			end
		end
	end
	local weld = Instance.new("Weld")
	weld.Part0 = torso
	weld.Part1 = grip
	weld.C0 = offset
	weld.Parent = grip
	model.Parent = character
end

local function detachHeldTool(player: Player)
	local character = player.Character
	local old = character and character:FindFirstChild("HeldTool")
	if old then
		old:Destroy()
	end
	if character then
		character:SetAttribute("HeldToolIndex", nil)
	end
end

local function rebuildMemberIds(run: Run)
	table.clear(run.MemberIds)
	for _, member in run.Order do
		table.insert(run.MemberIds, member.UserId)
	end
end

----------------------------------------------------------------------------------------------------
-- RunState pushes (coalesced per player)
----------------------------------------------------------------------------------------------------

local function buildState(run: Run, pr: PlayerRun): Types.RunState
	return {
		Level = run.Level,
		ArenaName = run.ArenaName,
		StartedAt = run.StartedAt,
		ClockAt = run.ClockAt or 0,
		Phase = run.Phase,
		Coins = pr.Coins,
		Tank = pr.Tank,
		TankMax = pr.Stats.TankMax,
		ToolIndex = pr.ToolIndex,
		OwnedTools = pr.OwnedTools,
		ToolUpgrades = pr.ToolUpgrades,
		Upgrades = effectiveUpgrades(pr),
		Stats = pr.Stats,
		DrainPosition = run.Arena.DrainPosition,
		StationPosition = run.Arena.StationPosition or run.Arena.DrainPosition,
		Total = run.Total,
		Cleaned = run.Cleaned,
		Members = run.MemberIds,
		Results = pr.Results,
	}
end

local function sendRunState(player: Player)
	local run = runOf[player]
	local pr = run and run.Players[player]
	if not run or not pr or run.Ended or not isHere(player) then
		return
	end
	RunStateRemote:FireClient(player, buildState(run, pr))
end

local function flushPush(player: Player, info: { Last: number, Scheduled: boolean })
	-- A newer info table means RemoveFromRun cancelled this push (and maybe a new run began).
	if pushInfo[player] ~= info then
		return
	end
	info.Scheduled = false
	info.Last = os.clock()
	sendRunState(player)
end

-- Leading-edge throttle: the first change goes out immediately (so RunState reaches the client
-- before PartyService's PartyState(nil)); changes inside the next 0.1 s are merged into one push.
local function queuePush(player: Player)
	local info = pushInfo[player]
	if not info then
		info = { Last = -math.huge, Scheduled = false }
		pushInfo[player] = info
	end
	if info.Scheduled then
		return
	end
	local waitFor = info.Last + PUSH_INTERVAL - os.clock()
	if waitFor &lt;= 0 then
		info.Last = os.clock()
		sendRunState(player)
	else
		info.Scheduled = true
		task.delay(waitFor, flushPush, player, info)
	end
end

local pushAll: (run: Run) -&gt; ()

-- Starts the run clock (once).
local function startClock(run: Run)
	if run.ClockAt or run.Ended then
		return
	end
	run.ClockAt = Util.Now()
	pushAll(run)
end

pushAll = function(run: Run)
	for member in run.Players do
		queuePush(member)
	end
end

----------------------------------------------------------------------------------------------------
-- Stats
----------------------------------------------------------------------------------------------------

local function computeStats(levelIndex: number, player: Player, pr: PlayerRun): Types.RunStats
	local profile = getProfile(player)
	local perks = profile and profile.Perks
	local petBonus = 0
	if profile then
		local ok, bonus = safe(Config.PetCoinBonus, profile.Pets, profile.Equipped, profile.PetIndex)
		petBonus = (ok and positive(bonus)) or 0
	end
	local rank = profile and profile.Rank or nil
	local rebirths = profile and profile.Rebirths or 0
	local stats = Config.GetRunStats(levelIndex, effectiveUpgrades(pr), pr.ToolIndex, perks, getPasses(player), petBonus, rank, rebirths)
	-- The stay boost: x2 cleaning (you and your pets) while it lasts.
	if profile and (tonumber(profile.BoostUntil) or 0) &gt; os.time() then
		stats.Power *= 2
		stats.PetPower *= 2
	end
	return stats
end

-- Recomputes a member's stats from their upgrades, tool, perks, passes and pets, and re-applies
-- walk speed when Sneakers (or anything else) changed it.
local function recomputeStats(run: Run, player: Player, pr: PlayerRun)
	local old = pr.Stats
	local stats = computeStats(run.Level, player, pr)
	pr.Stats = stats
	if not old or old.WalkSpeed ~= stats.WalkSpeed then
		Characters.SetWalkSpeed(player, stats.WalkSpeed)
	end
end

local function sendTankFull(player: Player, pr: PlayerRun)
	local now = os.clock()
	if now - pr.LastFullFX &lt; TANK_FULL_FX_COOLDOWN then
		return
	end
	pr.LastFullFX = now
	fireOne(player, "TankFull", EMPTY)
end

----------------------------------------------------------------------------------------------------
-- Selling at the drain
----------------------------------------------------------------------------------------------------

sell = function(run: Run, player: Player, pr: PlayerRun)
	if pr.Tank &lt;= 0 or run.Phase ~= "Playing" then
		return
	end
	-- Recompute first so a pass or pet granted since the last recompute pays out on this sale.
	recomputeStats(run, player, pr)
	local units = pr.Tank
	local coins = math.floor(units * pr.Stats.CoinMult)
	pr.Tank = 0
	pr.Coins += coins

	local fx: Types.FXSold = { Coins = coins, Units = units, By = player.UserId }
	fireOne(player, "Sold", fx)
	local sound = run.DrainSound
	if sound then
		sound.PlaybackSpeed = 0.9 + rng:NextNumber() * 0.25
		sound:Play()
	end
	queuePush(player)
end

----------------------------------------------------------------------------------------------------
-- Grime
----------------------------------------------------------------------------------------------------

--[[
	Removes one grime spot from the run. Every path that ends a spot goes through here: scrubbing,
	pets, the stuck guard and (defensively) a spot that vanished on its own.
	  cleaner  : the player credited (nil for unrewarded pops)
	  rewarded : false = no tank units, no Bubbles, no dish bonus, no stats
]]
-- Returns the units the cleaner picked up (for a pet: what goes into its bag).
local function retireGrime(run: Run, part: BasePart, entry: GrimeEntry, cleaner: Player?, fromPet: boolean, rewarded: boolean): number
	-- Mark first, before anything that could yield or re-enter, so this runs exactly once per spot.
	entry.Dead = true
	entry.HP = 0
	run.Grime[part] = nil
	run.Remaining -= 1
	run.Cleaned += 1

	local pr = if cleaner then run.Players[cleaner] else nil
	local rewardPlayer = if rewarded and pr then cleaner else nil
	local gained = 0
	local bubbles = 0

	if rewardPlayer and pr then
		if fromPet then
			-- A pet keeps what it cleans in its own bag and sells it itself (PetService).
			gained = entry.Units
		else
			-- Units go into the tank, capped at TankMax (the overflow is simply lost).
			gained = math.min(entry.Units, math.max(0, pr.Stats.TankMax - pr.Tank))
			pr.Tank += gained
		end
		pr.GrimeCleaned += 1

		local gems = if entry.Golden then Config.Gems.GoldenDrop elseif rng:NextNumber() &lt; Config.Gems.DropChance then 1 else 0
		if gems &gt; 0 then
			safe(DataService.AddGems, rewardPlayer, gems)
			notify(rewardPlayer, string.format("You found %d Gem%s!", gems, if gems == 1 then "" else "s"), "Good")
		end

		if entry.Golden then
			local range = R.GoldenBubbles
			bubbles = rng:NextInteger(range[1], range[2]) * run.Level
			safe(DataService.AddBubbles, rewardPlayer, bubbles, "GoldenGrime")
			local text = if fromPet then "Your pet found golden dirt! +%d Bubbles" else "Golden dirt! +%d Bubbles"
			notify(rewardPlayer, string.format(text, bubbles), "Good")
		end
	end

	local fx: Types.FXCleaned = {
		Position = part.Position,
		Color = entry.Color,
		Units = gained,
		By = if rewardPlayer then rewardPlayer.UserId else 0,
		Golden = entry.Golden,
		Bubbles = bubbles,
		Pet = fromPet,
	}
	fireAll(run, "Cleaned", fx)

	if part.Parent then
		part:Destroy()
	end

	-- Dish tracking: the spot that finishes a dish makes it sparkle and pays the dish bonus.
	local dish = run.Dishes[entry.DishId]
	if dish and not dish.Done then
		dish.Remaining -= 1
		if dish.Remaining &lt;= 0 then
			dish.Done = true
			if dish.Model then
				task.spawn(sparkle, dish.Model)
			end
			local bonus = 0
			if rewardPlayer and pr then
				bonus = math.floor(dish.Units * R.DishBonusShare * pr.Stats.CoinMult)
				pr.Coins += bonus
				for member in run.Players do
					safe(DataService.AddStat, member, "DishesCleaned", 1)
				end
			end
			local doneFx: Types.FXDishDone = {
				Position = dish.Center,
				Kind = dish.Kind,
				By = if rewardPlayer then rewardPlayer.UserId else 0,
				Bonus = bonus,
			}
			fireAll(run, "DishDone", doneFx)
		end
	end

	run.Arena.Model:SetAttribute("Cleaned", run.Cleaned)
	pushAll(run)

	-- The tank just filled: Auto Drain sells it on the spot, everyone else gets the "go sell" cue.
	if rewardPlayer and pr and pr.Tank &gt;= pr.Stats.TankMax then
		if getPasses(rewardPlayer).AutoDrain then
			sell(run, rewardPlayer, pr)
		else
			sendTankFull(rewardPlayer, pr)
		end
	end

	if run.Remaining &lt;= 0 then
		completeRun(run)
	end
	return gained
end

-- Applies damage to a spot already known to be in `run`. Returns (alive, units picked up if it
-- was finished).
local function damageEntry(run: Run, player: Player, pr: PlayerRun, part: BasePart, entry: GrimeEntry, amount: number, fromPet: boolean): (boolean, number)
	if part.Parent == nil then
		-- Destroyed between the query and now by something else: count it, reward nobody.
		retireGrime(run, part, entry, nil, false, false)
		return false, 0
	end
	if not fromPet and pr.Tank &gt;= pr.Stats.TankMax then
		return true, 0 -- tank full: the player has to go sell first (pets have their own bags)
	end
	if not fromPet and (pr.Stats.Tier or pr.ToolIndex) &lt; entry.MinTool then
		-- Too tough for this tool: it still works, just slowly (so nobody can get stuck without the
		-- coins for a better tool). Pets ignore MinTool.
		amount *= R.UnderTierMult
	end

	run.LastDamageAt = os.clock()
	local hp = entry.HP - amount
	if hp &gt; HP_EPSILON then
		entry.HP = hp
		setGrimeHealth(part, hp / entry.MaxHP)
		part:SetAttribute("HP", hp)
		return true, 0
	end
	return false, retireGrime(run, part, entry, player, fromPet, true)
end

-- Reads every grime spot's attributes once, so the hot path never touches attributes.
local function indexGrime(run: Run)
	local arena = run.Arena

	if type(arena.Dishes) == "table" then
		for key, d in arena.Dishes do
			if type(d) == "table" then
				local id = tonumber(d.Id) or tonumber(key)
				if id then
					local model = if typeof(d.Model) == "Instance" and d.Model:IsA("Model") then d.Model else nil
					local center: Vector3 = if typeof(d.Center) == "Vector3"
						then d.Center
						elseif model then model:GetPivot().Position
						else arena.Origin.Position
					run.Dishes[id] = {
						Id = id,
						Kind = tostring(d.Kind or "Dish"),
						Model = model,
						Center = center,
						Remaining = 0,
						Units = 0,
						Done = false,
					}
				end
			end
		end
	end

	local toolCount = #Config.Tools
	for _, child in arena.GrimeFolder:GetChildren() do
		if child:IsA("BasePart") then
			local maxHP = positive(child:GetAttribute("MaxHP")) or positive(child:GetAttribute("HP")) or 1
			local hp = math.min(positive(child:GetAttribute("HP")) or maxHP, maxHP)
			local units = math.max(1, math.floor(positive(child:GetAttribute("Units")) or 1))
			local dishId = tonumber(child:GetAttribute("DishId")) or 0
			local minTool = math.clamp(math.floor(tonumber(child:GetAttribute("MinTool")) or 1), 1, toolCount)
			local entry: GrimeEntry = {
				HP = hp,
				MaxHP = maxHP,
				Units = units,
				DishId = dishId,
				Golden = child:GetAttribute("Golden") == true,
				MinTool = minTool,
				Color = child.Color,
				Dead = false,
			}
			run.Grime[child] = entry
			run.Total += 1
			local dish = run.Dishes[dishId]
			if dish then
				dish.Remaining += 1
				dish.Units += units
			end
		end
	end
	run.Remaining = run.Total
end

-- Stuck guard: nobody has damaged anything for a while and only a few spots are left (probably
-- somewhere unreachable). Pop them with no reward so the party can finish.
local function popRemaining(run: Run)
	-- Snapshot first: retireGrime removes entries from run.Grime.
	local parts: { BasePart } = {}
	local entries: { GrimeEntry } = {}
	for part, entry in run.Grime do
		table.insert(parts, part)
		table.insert(entries, entry)
	end
	for member in run.Players do
		notify(member, "The last few spots washed away on their own!", "Info")
	end
	for i, entry in entries do
		if not entry.Dead and run.Phase == "Playing" and not run.Ended then
			retireGrime(run, parts[i], entry, nil, false, false)
		end
	end
	-- Counters and the map can only disagree through a bug; never leave a run unfinishable.
	if run.Phase == "Playing" and not run.Ended and next(run.Grime) == nil then
		run.Remaining = 0
		completeRun(run)
	end
end

----------------------------------------------------------------------------------------------------
-- Completion and teardown
----------------------------------------------------------------------------------------------------

-- Pays every member and builds their Results. Runs in its own thread because DataService calls
-- may yield, and DamageGrime (which triggers completion) must never yield for its callers.
local function rewardRun(run: Run, members: { Player }, seconds: number, returnAt: number)
	local level = Config.GetLevel(run.Level)
	local total = math.max(1, run.Total)
	local underPar = seconds &lt; level.ParTime

	local valid = {}
	for _, p in members do
		if run.Players[p] and isHere(p) then
			table.insert(valid, p)
		end
	end
	local n = #valid

	local rows: { Types.ResultRow } = {}
	local personal: { [Player]: { FirstClear: boolean, NewBest: boolean, Unlocked: number?, Bubbles: number } } = {}

	for _, p in valid do
		local pr = run.Players[p]
		if pr then
			local share = pr.GrimeCleaned / total
			local bubbles = level.Bubbles * (0.6 + 0.4 * math.min(1, share * n))

			local ok, first, best, unlocked = safe(DataService.RecordClear, p, run.Level, seconds)
			local firstClear = ok and first == true
			if firstClear then
				bubbles *= R.FirstClearMult
			end
			if underPar then
				bubbles *= 1 + R.UnderParBonus
			end
			if getPasses(p).DoubleBubbles then
				bubbles *= 2
			end
			if getPasses(p).VIP then
				bubbles *= 1.25
			end
			local profile = getProfile(p)
			bubbles *= Config.RebirthBubbleMult(profile and profile.Rebirths or 0)
			bubbles = math.floor(bubbles)

			safe(DataService.AddBubbles, p, bubbles, "RunClear")
			safe(DataService.AddGems, p, Config.Gems.PerClear * run.Level)
			safe(DataService.AddStat, p, "GrimeCleaned", pr.GrimeCleaned)
			safe(DataService.PushMeta, p)

			table.insert(rows, {
				UserId = p.UserId,
				Name = p.DisplayName,
				Grime = pr.GrimeCleaned,
				Share = pr.GrimeCleaned / total,
				Bubbles = bubbles,
			})
			personal[p] = {
				FirstClear = firstClear,
				NewBest = ok and best == true,
				Unlocked = if ok and type(unlocked) == "number" then unlocked else nil,
				Bubbles = bubbles,
			}
		end
	end

	table.sort(rows, function(a, b)
		if a.Grime ~= b.Grime then
			return a.Grime &gt; b.Grime
		end
		return a.UserId &lt; b.UserId
	end)

	for p, info in personal do
		local pr = run.Players[p]
		if pr and not run.Ended then
			pr.Results = {
				TimeSeconds = seconds,
				ParTime = level.ParTime,
				UnderPar = underPar,
				FirstClear = info.FirstClear,
				NewBest = info.NewBest,
				UnlockedLevel = info.Unlocked,
				Bubbles = info.Bubbles,
				Players = rows,
				ReturnAt = returnAt,
			}
			queuePush(p)
		end
	end
end

local function sendEveryoneHome(run: Run)
	if run.Ended then
		return
	end
	for _, member in table.clone(run.Order) do
		RoundService.RemoveFromRun(member, "Complete")
	end
end

completeRun = function(run: Run)
	-- Phase flips synchronously, so however many callers race here only the first one completes.
	if run.Phase ~= "Playing" or run.Ended then
		return
	end
	run.Phase = "Complete"
	local now = Util.Now()
	local seconds = math.max(0, math.floor((now - (run.ClockAt or now)) * 10 + 0.5) / 10)
	local returnAt = now + R.ResultsSeconds
	pushAll(run) -- Phase change first; Results follow as soon as the rewards are written
	task.spawn(rewardRun, run, table.clone(run.Order), seconds, returnAt)
	task.delay(R.ResultsSeconds, sendEveryoneHome, run)
end

endRun = function(run: Run)
	if run.Ended then
		return
	end
	run.Ended = true
	runs[run.Id] = nil
	for _, connection in run.Connections do
		connection:Disconnect()
	end
	table.clear(run.Connections)
	table.clear(run.Grime)
	for member in run.Players do
		if runOf[member] == run then
			runOf[member] = nil
		end
	end
	table.clear(run.Players)

	local arena = run.Arena
	local slot = run.Slot
	task.spawn(function()
		local ok = safe(ArenaBuilder.Destroy, arena)
		if not ok and arena.Model.Parent then
			pcall(function()
				arena.Model:Destroy()
			end)
		end
		slotBusy[slot] = nil
	end)
end

----------------------------------------------------------------------------------------------------
-- Starting a run
----------------------------------------------------------------------------------------------------

local function claimSlot(): number?
	for slot = 1, Config.World.MaxArenas do
		if not slotBusy[slot] then
			slotBusy[slot] = true
			return slot
		end
	end
	return nil
end

local function isValidArena(arena: any): boolean
	return type(arena) == "table"
		and typeof(arena.Model) == "Instance"
		and arena.Model.Parent ~= nil
		and typeof(arena.GrimeFolder) == "Instance"
		and type(arena.Spawns) == "table"
		and #arena.Spawns &gt; 0
		and typeof(arena.DrainPosition) == "Vector3"
		and typeof(arena.Origin) == "CFrame"
end

-- Frees a slot whose build failed or was abandoned, destroying whatever got built.
local function abandonBuild(slot: number, arena: any)
	if type(arena) == "table" then
		safe(ArenaBuilder.Destroy, arena)
	end
	local folder = workspace:FindFirstChild("Arenas")
	local leftover = folder and folder:FindFirstChild("Arena_" .. slot)
	if leftover then
		leftover:Destroy()
	end
	slotBusy[slot] = nil
end

-- A 3D splash at the drain for every sale, so teammates hear it too (the seller also gets the
-- coin sound from the client's "Sold" FX).
local function makeDrainSound(run: Run): Sound?
	local def = Config.Sounds.Splash or Config.Sounds.Fallback
	if not def then
		return nil
	end
	local emitter = Instance.new("Part")
	emitter.Name = "DrainSound"
	emitter.Size = Vector3.new(1, 1, 1)
	emitter.Transparency = 1
	emitter.Anchored = true
	emitter.CanCollide = false
	emitter.CanQuery = false
	emitter.CanTouch = false
	emitter.CastShadow = false
	emitter.CollisionGroup = Characters.Groups.NoCollide
	emitter.CFrame = CFrame.new(run.Arena.DrainPosition)
	local sound = Instance.new("Sound")
	sound.Name = "Sell"
	sound.SoundId = def.Id
	sound.Volume = def.Volume
	sound.RollOffMinDistance = 12
	sound.RollOffMaxDistance = 140
	sound.Parent = emitter
	emitter.Parent = run.Arena.Model
	return sound
end

local function teleportInto(run: Run, player: Player, cf: CFrame)
	if runOf[player] == run and not run.Ended and isHere(player) then
		-- If the character is dead or missing, the respawn resolver brings them here instead.
		Characters.Teleport(player, cf)
	end
end

local function joinRun(run: Run, player: Player, index: number)
	local profile = getProfile(player)
	local pr: PlayerRun = {
		Coins = Config.StartCoins(run.Level, profile and profile.Perks),
		Tank = 0,
		Upgrades = newUpgrades(),
		ToolIndex = 1,
		OwnedTools = {},
		ToolUpgrades = {},
		Stats = nil :: any,
		GrimeCleaned = 0,
		LastScrubAt = 0,
		LastFullFX = 0,
		Results = nil,
	}
	pr.OwnedTools, pr.ToolUpgrades = newToolState()
	grantPassTools(player, pr)
	pr.Stats = computeStats(run.Level, player, pr)

	run.Players[player] = pr
	table.insert(run.Order, player)
	runOf[player] = run

	Characters.SetGroup(player, Characters.Groups.Players)
	Characters.SetWalkSpeed(player, pr.Stats.WalkSpeed)
	player:SetAttribute("InRun", true)
	player:SetAttribute("RunArena", run.ArenaName)

	local spawns = run.Arena.Spawns
	task.spawn(teleportInto, run, player, spawns[((index - 1) % #spawns) + 1])
end

function RoundService.StartRound(players: { Player }, levelIndex: number): (boolean, string?)
	if type(players) ~= "table" then
		return false, "Nobody is ready to play."
	end
	if type(levelIndex) ~= "number" or levelIndex % 1 ~= 0 or not Config.Levels[levelIndex] then
		return false, "That level doesn't exist."
	end

	local members: { Player } = {}
	for _, p in players do
		if
			typeof(p) == "Instance"
			and p:IsA("Player")
			and isHere(p)
			and not runOf[p]
			and not starting[p]
			and not table.find(members, p)
		then
			table.insert(members, p)
		end
	end
	if #members == 0 then
		return false, "Nobody is ready to play."
	end

	local slot = claimSlot()
	if not slot then
		return false, "All dishwashers are busy!"
	end

	local level = Config.GetLevel(levelIndex)
	local bestLucky = 0
	local charm = false
	for _, p in members do
		local profile = getProfile(p)
		local lucky = profile and profile.Perks and positive(profile.Perks.LuckySuds) or 0
		bestLucky = math.max(bestLucky, lucky)
		charm = charm or getPasses(p).LuckyCharm == true
		local rank = profile and Config.GetRank(profile.Rank)
		if rank and rank.Effects.Golden then
			charm = true
		end
	end
	local luckyPerk = Config.GetPerk("LuckySuds")
	local goldenChance = level.GoldenChance + bestLucky * (if luckyPerk then luckyPerk.PerLevel else 0.01)
	if charm then
		goldenChance *= 2 -- Lucky Charm pass: anyone in the party having it doubles the whole load's gold
	end
	-- Party size: more spots (up to PartyGrimeCap), and past that tougher dirt, so the whole party's
	-- work is PartyWorkPerPlayer x players x solo (a party run takes a bit longer than solo).
	local n = #members
	local grimeScale = math.min(R.PartyGrimeCap or 99, 1 + R.PartyGrimeScale * (n - 1))
	local hpScale = if n &lt;= 1 then 1 else math.max(1, n * (R.PartyWorkPerPlayer or 1) / grimeScale)
	local options = {
		GrimeScale = grimeScale,
		HpScale = hpScale,
		GoldenChance = goldenChance,
	}

	for _, p in members do
		starting[p] = true
	end
	local built, result = pcall(ArenaBuilder.Build, slot, levelIndex, options)
	for _, p in members do
		starting[p] = nil
	end

	-- The build yielded: the arena may have failed and players may have left or been put
	-- into another run meanwhile. Re-check everything.
	local arena: Arena? = if built and isValidArena(result) then result else nil
	if not arena then
		warn("[RoundService] ArenaBuilder.Build failed for slot " .. slot .. ": " .. tostring(result))
		abandonBuild(slot, if built then result else nil)
		return false, "Couldn't fill the dishwasher. Try again!"
	end

	local stillHere: { Player } = {}
	for _, p in members do
		if isHere(p) and not runOf[p] then
			table.insert(stillHere, p)
		end
	end
	if #stillHere == 0 then
		abandonBuild(slot, arena)
		return false, "Everyone left before the wash started."
	end

	local overlap = OverlapParams.new()
	overlap.FilterType = Enum.RaycastFilterType.Include
	overlap.FilterDescendantsInstances = { arena.GrimeFolder }
	overlap.MaxParts = 60

	nextRunId += 1
	local run: Run = {
		Id = nextRunId,
		Slot = slot,
		Arena = arena,
		ArenaName = arena.Model.Name,
		Level = levelIndex,
		Players = {},
		Order = {},
		MemberIds = {},
		StartedAt = Util.Now(),
		Phase = "Playing",
		Ended = false,
		Total = 0,
		Cleaned = 0,
		Remaining = 0,
		LastDamageAt = os.clock(),
		Grime = {},
		Dishes = {},
		Overlap = overlap,
		Splats = {},
		Connections = {},
		DrainSound = nil,
		DrainRadius = positive(arena.DrainRadius) or R.DrainRadius,
		KillY = if type(arena.KillY) == "number" then arena.KillY else arena.Origin.Position.Y - 60,
	}

	indexGrime(run)
	if run.Total == 0 then
		warn("[RoundService] Arena_" .. slot .. " was built with no grime")
		abandonBuild(slot, arena)
		return false, "Couldn't fill the dishwasher. Try again!"
	end

	arena.Model:SetAttribute("Level", levelIndex)
	arena.Model:SetAttribute("Total", run.Total)
	arena.Model:SetAttribute("Cleaned", 0)
	run.DrainSound = makeDrainSound(run)

	-- Safety net: a spot removed by anything other than retireGrime still counts, so the run can
	-- always finish. retireGrime drops the map entry first, so its own destroys are ignored here.
	table.insert(
		run.Connections,
		arena.GrimeFolder.ChildRemoved:Connect(function(child)
			local entry = run.Grime[child :: BasePart]
			if entry and not entry.Dead and not run.Ended and run.Phase == "Playing" then
				retireGrime(run, child :: BasePart, entry, nil, false, false)
			end
		end)
	)

	runs[run.Id] = run
	for i, p in stillHere do
		joinRun(run, p, i)
	end
	rebuildMemberIds(run)
	pushAll(run)
	-- The clock waits for the intro cutscene: it starts when the first player finishes or skips it
	-- (RunRequest "Loaded"), or after the whole cutscene's length if nobody reports in.
	task.delay(R.IntroMaxSeconds, function()
		startClock(run)
	end)
	return true
end

-- (Run servers) A party member who arrived after their run had already started joins it now.
-- Returns false if there is no run still being played to join.
function RoundService.JoinLate(player: Player): boolean
	if not isHere(player) or runOf[player] or starting[player] then
		return false
	end
	for _, run in runs do
		if not run.Ended and run.Phase == "Playing" then
			joinRun(run, player, #run.Order + 1)
			rebuildMemberIds(run)
			pushAll(run)
			return true
		end
	end
	return false
end

----------------------------------------------------------------------------------------------------
-- Leaving a run
----------------------------------------------------------------------------------------------------

-- Set by RunServers in a run server: players go home to the lobby server instead.
RoundService.SendHomeHook = nil :: ((Player) -&gt; ())?

local function sendToLobby(player: Player)
	-- Skip if they were put into another run in the meantime or left the game.
	if runOf[player] == nil and isHere(player) then
		local hook = RoundService.SendHomeHook
		if hook then
			hook(player)
		else
			Characters.Teleport(player, lobbySpawn())
		end
	end
end

function RoundService.RemoveFromRun(player: Player, reason: string?)
	local run = runOf[player]
	if not run then
		return
	end
	runOf[player] = nil
	pushInfo[player] = nil -- cancels any coalesced push still waiting
	run.Players[player] = nil
	local index = table.find(run.Order, player)
	if index then
		table.remove(run.Order, index)
	end
	rebuildMemberIds(run)

	if reason ~= LEFT_GAME and isHere(player) then
		detachHeldTool(player)
		player:SetAttribute("InRun", false)
		player:SetAttribute("RunArena", "")
		Characters.SetWalkSpeed(player, nil)
		Characters.SetGroup(player, Characters.Groups.Players)
		RunStateRemote:FireClient(player, nil)
		task.spawn(sendToLobby, player)
	end

	if next(run.Players) == nil then
		endRun(run)
	else
		pushAll(run)
	end
end

----------------------------------------------------------------------------------------------------
-- Public queries
----------------------------------------------------------------------------------------------------

function RoundService.IsInRun(player: Player): boolean
	return runOf[player] ~= nil
end

function RoundService.GetGrimeFolder(player: Player): Folder?
	local run = runOf[player]
	if run and not run.Ended then
		return run.Arena.GrimeFolder
	end
	return nil
end

function RoundService.GetRunPower(player: Player): number
	local run = runOf[player]
	local pr = run and run.Players[player]
	return if pr then (pr.Stats.PetPower or pr.Stats.Power) else 0
end

function RoundService.IsTankFull(player: Player): boolean
	local run = runOf[player]
	local pr = run and run.Players[player]
	return pr ~= nil and pr.Tank &gt;= pr.Stats.TankMax
end

-- Damages a grime part if it belongs to the player's run. Returns true while the part is alive.
-- Used by the Scrub handler (fromPet = false) and PetService (fromPet = true).
function RoundService.DamageGrime(player: Player, part: BasePart, amount: number, fromPet: boolean): (boolean, number)
	local run = runOf[player]
	if not run or run.Phase ~= "Playing" or run.Ended then
		return false, 0
	end
	local pr = run.Players[player]
	local entry = run.Grime[part]
	if not pr or not entry or entry.Dead then
		return false, 0
	end
	if type(amount) ~= "number" or amount ~= amount or amount &lt;= 0 then
		return part.Parent ~= nil, 0
	end
	return damageEntry(run, player, pr, part, entry, math.min(amount, entry.HP), fromPet == true)
end

-- For pets: the level multiplier of the player's run (bag sizes scale with it), 0 if not in one.
function RoundService.GetLevelMult(player: Player): number
	local run = runOf[player]
	return if run then Config.GetLevel(run.Level).Mult else 0
end

-- For pets: the drain grate of the player's arena (where a full bag gets sold).
function RoundService.GetDrainPart(player: Player): BasePart?
	local run = runOf[player]
	local model = run and run.Arena and run.Arena.Model
	local drain = model and model:FindFirstChild("DrainGrate")
	return if drain and drain:IsA("BasePart") then drain else nil
end

-- A pet cleaned `units` of dirt: pay its owner straight away (no trip to the drain). `slot` is
-- the pet's slot number, so the "+coins" pop-up can float over that pet.
function RoundService.PayPetCoins(player: Player, units: number, slot: number?)
	local run = runOf[player]
	local pr = run and run.Players[player]
	if not run or not pr or run.Ended or type(units) ~= "number" or units ~= units or units &lt;= 0 then
		return
	end
	local coins = math.floor(units * pr.Stats.CoinMult)
	if coins &lt;= 0 then
		return
	end
	pr.Coins += coins
	fireOne(player, "Sold", { Coins = coins, Units = units, By = player.UserId, Pet = true, Slot = slot })
	queuePush(player)
end

-- Recomputes a player's run stats (perks, passes, pets). Called after pet equip changes, perk
-- purchases and pass grants; harmless when the player isn't in a run.
-- Coin packs (MarketService): adds coins to the player's current run. False if not in a run.
-- Admin (:finishrun): cleans every spot of dirt in the player's dishwasher at once. Returns how
-- many spots were cleaned, or nil when they aren't in a dishwasher.
function RoundService.DebugFinish(player: Player): number?
	local run = runOf[player]
	if not run or run.Phase ~= "Playing" then
		return nil
	end
	-- Collected first: cleaning a spot removes it from run.Grime.
	local parts: { BasePart } = {}
	for part, entry in run.Grime do
		if not entry.Dead and part.Parent then
			table.insert(parts, part)
		end
	end
	for _, part in parts do
		RoundService.DamageGrime(player, part, math.huge, true)
	end
	return #parts
end

function RoundService.AddCoins(player: Player, amount: number): boolean
	local run = runOf[player]
	local pr = run and run.Players[player]
	if not run or not pr or run.Ended or type(amount) ~= "number" or amount ~= amount or amount &lt;= 0 then
		return false
	end
	pr.Coins += math.floor(amount * Config.GetLevel(run.Level).Mult + 0.5)
	queuePush(player)
	return true
end

function RoundService.RefreshStats(player: Player)
	local run = runOf[player]
	local pr = run and run.Players[player]
	if not run or not pr or run.Ended then
		return
	end
	grantPassTools(player, pr) -- a tool pass bought mid-run works straight away
	recomputeStats(run, player, pr)
	if run.Phase == "Playing" and pr.Tank &gt; 0 and pr.Tank &gt;= pr.Stats.TankMax and getPasses(player).AutoDrain then
		sell(run, player, pr)
	end
	queuePush(player)
end

----------------------------------------------------------------------------------------------------
-- Remote handlers
----------------------------------------------------------------------------------------------------

-- Damages every live grime part in `parts` by `amount` (stops early when the tank fills).
local function damageParts(run: Run, player: Player, pr: PlayerRun, parts: { BasePart }, amount: number)
	for _, part in parts do
		local entry = run.Grime[part]
		if entry and not entry.Dead then
			damageEntry(run, player, pr, part, entry, math.min(amount, entry.HP), false)
			if run.Phase ~= "Playing" or pr.Tank &gt;= pr.Stats.TankMax then
				break
			end
		end
	end
end

local function unitOr(v: any, fallback: Vector3): Vector3
	if Util.IsFiniteVector3(v) and v.Magnitude &gt; 1e-3 then
		return v.Unit
	end
	return fallback
end

-- extra (optional table): { Dir = Vector3, Normal = Vector3 } for Line; { Normal = Vector3 } for Foam.
local function onScrub(player: Player, aim: any, holding: any, extra: any)
	-- 1. In a Playing run, finite aim, alive.
	local run = runOf[player]
	if not run or run.Phase ~= "Playing" or run.Ended then
		return
	end
	local pr = run.Players[player]
	if not pr or not Util.IsFiniteVector3(aim) then
		return
	end
	local root = Characters.GetRoot(player)
	if not root then
		return
	end

	-- 2. Reach (plus slack for latency).
	local stats = pr.Stats
	local mode = stats.Mode or "Scrub"
	local extent = if mode == "Line" then (stats.LineLength or 5) / 2 else stats.Radius
	if (aim - root.Position).Magnitude &gt; stats.Reach + extent + R.ReachSlack then
		return
	end
	local info = if type(extra) == "table" then extra else {}

	-- 3. Foam: one blob per FoamInterval; the splat does the cleaning over time (foamStep).
	local now = os.clock()
	if mode == "Foam" then
		if now - pr.LastScrubAt &lt; (stats.FoamInterval or 0.4) * 0.9 then
			return
		end
		pr.LastScrubAt = now
		if pr.Tank &gt;= stats.TankMax then
			sendTankFull(player, pr)
			return
		end
		local mine = 0
		local oldest: number? = nil
		for i, splat in run.Splats do
			if splat.Player == player then
				mine += 1
				oldest = oldest or i
			end
		end
		if mine &gt;= MAX_SPLATS_PER_PLAYER and oldest then
			table.remove(run.Splats, oldest)
		end
		local seconds = stats.FoamSeconds or 2.5
		table.insert(run.Splats, {
			Player = player,
			Position = aim,
			Radius = stats.Radius,
			Dps = stats.Power * (stats.FoamShare or 0.6),
			Until = now + seconds,
		})
		fireAll(run, "Foam", {
			Position = aim,
			Normal = unitOr(info.Normal, Vector3.yAxis),
			Radius = stats.Radius,
			Duration = seconds,
			By = player.UserId,
		})
		return
	end

	-- 4. Rate. Damage comes from server time, never from anything in the packet.
	local seconds
	if holding == true and stats.Hold then
		local dt = now - pr.LastScrubAt
		if dt &lt; HOLD_MIN_INTERVAL then
			return
		end
		seconds = math.min(dt, R.MaxScrubDt)
	else
		if now - pr.LastScrubAt &lt; R.MinClickInterval then
			return
		end
		seconds = R.ClickPulseSeconds
	end
	pr.LastScrubAt = now

	-- 5. Tank full: nothing to do but remind them.
	if pr.Tank &gt;= stats.TankMax then
		sendTankFull(player, pr)
		return
	end

	local amount = stats.Power * seconds
	if mode == "Line" then
		-- A thin box along the line, a little deep along the surface normal so curved dishes count.
		local normal = unitOr(info.Normal, Vector3.yAxis)
		local dir = unitOr(info.Dir, root.CFrame.RightVector)
		dir = dir - normal * dir:Dot(normal)
		dir = if dir.Magnitude &gt; 1e-3 then dir.Unit else normal:Cross(Vector3.xAxis).Unit
		local cf = CFrame.fromMatrix(aim, dir, normal)
		local size = Vector3.new(stats.LineLength or 5, 2.4, stats.LineWidth or 0.9)
		damageParts(run, player, pr, workspace:GetPartBoundsInBox(cf, size, run.Overlap), amount)
		return
	end
	-- Scrub / Spray: every grime spot under the circle takes the full hit (that's what Size buys).
	damageParts(run, player, pr, workspace:GetPartBoundsInRadius(aim, stats.Radius, run.Overlap), amount)
end

-- Foam splats: every FOAM_TICK, each live splat cleans what it covers.
local function foamStep()
	local now = os.clock()
	for _, run in runs do
		if run.Ended or run.Phase ~= "Playing" or #run.Splats == 0 then
			continue
		end
		local i = 1
		while i &lt;= #run.Splats do
			local splat = run.Splats[i]
			local pr = run.Players[splat.Player]
			if now &gt;= splat.Until or not pr or not isHere(splat.Player) then
				table.remove(run.Splats, i)
			else
				local parts = workspace:GetPartBoundsInRadius(splat.Position, splat.Radius, run.Overlap)
				damageParts(run, splat.Player, pr, parts, splat.Dps * FOAM_TICK)
				i += 1
			end
		end
	end
end

local function allowRequest(player: Player): boolean
	local now = os.clock()
	local window = requestWindow[player]
	if not window then
		requestWindow[player] = { Start = now, Count = 1 }
		return true
	end
	if now - window.Start &gt;= 1 then
		window.Start = now
		window.Count = 1
		return true
	end
	window.Count += 1
	return window.Count &lt;= REQUESTS_PER_SECOND
end

local function fail(message: string): Types.RequestResult
	return { Ok = false, Error = message }
end

local OK: Types.RequestResult = { Ok = true }

local function handleRunRequest(player: Player, action: any, value: any): Types.RequestResult
	if type(action) ~= "string" then
		return fail("Unknown action.")
	end
	if not allowRequest(player) then
		return fail("Slow down a little!")
	end
	local run = runOf[player]
	local pr = run and run.Players[player]
	if not run or not pr or run.Ended then
		return fail("You're not in a dishwasher right now.")
	end

	if action == "Loaded" then
		-- This player is in (their cutscene ended or was skipped): the clock runs from now.
		startClock(run)
		return OK
	elseif action == "BuyUpgrade" then
		if run.Phase ~= "Playing" then
			return fail("The dishwasher is already sparkling clean!")
		end
		local def = if type(value) == "string" then Config.GetUpgrade(value) else nil
		if not def then
			return fail("That upgrade doesn't exist.")
		end
		-- Per-tool upgrades belong to the tool in hand; the rest are global.
		local upgrades = (if def.PerTool then pr.ToolUpgrades[pr.ToolIndex] else pr.Upgrades) :: any
		local current = upgrades[def.Id] or 0
		local cost = Config.UpgradeCost(def.Id, current, run.Level, pr.ToolIndex)
		if not cost then
			return fail("Already maxed!")
		end
		if pr.Coins &lt; cost then
			return fail("Not enough coins!")
		end
		pr.Coins -= cost
		upgrades[def.Id] = current + 1
		recomputeStats(run, player, pr)
		queuePush(player)
		return OK
	elseif action == "BuyTool" then
		if run.Phase ~= "Playing" then
			return fail("The dishwasher is already sparkling clean!")
		end
		if type(value) ~= "number" or value % 1 ~= 0 or not Config.Tools[value] then
			return fail("That tool doesn't exist.")
		end
		if pr.OwnedTools[value] then
			return fail("You already have that tool!")
		end
		local cost = Config.ToolCost(value, run.Level)
		if not cost then
			return fail("That tool doesn't exist.")
		end
		if pr.Coins &lt; cost then
			return fail("Not enough coins!")
		end
		pr.Coins -= cost
		pr.OwnedTools[value] = true
		pr.ToolIndex = value -- a new tool goes straight into your hand
		recomputeStats(run, player, pr)
		attachHeldTool(player, value)
		queuePush(player)
		return OK
	elseif action == "EquipTool" then
		if type(value) ~= "number" or value % 1 ~= 0 or not pr.OwnedTools[value] then
			return fail("You don't have that tool yet.")
		end
		if pr.ToolIndex ~= value then
			pr.ToolIndex = value
			recomputeStats(run, player, pr)
			attachHeldTool(player, value)
			queuePush(player)
		end
		return OK
	elseif action == "Leave" then
		RoundService.RemoveFromRun(player, "Leave")
		return OK
	elseif action == "ReturnToLobby" then
		if run.Phase ~= "Complete" then
			return fail("Finish the load first!")
		end
		RoundService.RemoveFromRun(player, "ReturnToLobby")
		return OK
	end
	return fail("Unknown action.")
end

----------------------------------------------------------------------------------------------------
-- Loops
----------------------------------------------------------------------------------------------------

-- Anyone standing in their run's drain with grime in the tank sells it.
local function drainStep()
	for _, run in runs do
		if run.Phase == "Playing" and not run.Ended then
			local drain = run.Arena.DrainPosition
			local r2 = run.DrainRadius * run.DrainRadius
			for player, pr in run.Players do
				if pr.Tank &gt; 0 then
					local root = Characters.GetRoot(player)
					if root then
						local pos = root.Position
						local dx, dz = pos.X - drain.X, pos.Z - drain.Z
						if dx * dx + dz * dz &lt;= r2 and math.abs(pos.Y - drain.Y) &lt; DRAIN_MAX_DY then
							sell(run, player, pr)
						end
					end
				end
			end
		end
	end
end

-- Fall guard (below KillY -&gt; back to a spawn) and stuck guard.
local function watchdogStep()
	local now = os.clock()
	for _, run in runs do
		if not run.Ended then
			for player, pr in run.Players do
				local root = Characters.GetRoot(player)
				if root and root.Position.Y &lt; run.KillY then
					Characters.Teleport(player, randomSpawn(run))
				end
				-- Re-attach the tool in hand after a respawn (a new character has none).
				local character = player.Character
				if root and character and character:GetAttribute("HeldToolIndex") ~= pr.ToolIndex then
					attachHeldTool(player, pr.ToolIndex)
				end
			end
			if
				run.Phase == "Playing"
				and run.Remaining &gt; 0
				and run.Remaining &lt;= R.StuckMaxRemaining
				and now - run.LastDamageAt &gt;= R.StuckSeconds
			then
				popRemaining(run)
			end
		end
	end
end

----------------------------------------------------------------------------------------------------
-- Lifecycle
----------------------------------------------------------------------------------------------------

function RoundService.Init()
	RunStateRemote = Remotes.Event("RunState")
	RunFXRemote = Remotes.Event("RunFX")
	NotifyRemote = Remotes.Event("Notify")

	Remotes.Event("Scrub").OnServerEvent:Connect(onScrub)

	Remotes.Function("RunRequest").OnServerInvoke = function(player: Player, action: any, value: any)
		local ok, result = pcall(handleRunRequest, player, action, value)
		if not ok then
			warn("[RoundService] RunRequest error: " .. tostring(result))
			return fail("Something went wrong. Try again!")
		end
		return result
	end

	-- A player in a run always respawns on their dishwasher's door.
	Characters.AddRespawnResolver(function(player: Player): CFrame?
		local run = runOf[player]
		if run and not run.Ended then
			return randomSpawn(run)
		end
		return nil
	end)

	local function onPlayerAdded(player: Player)
		if player:GetAttribute("InRun") == nil then
			player:SetAttribute("InRun", false)
		end
		if player:GetAttribute("RunArena") == nil then
			player:SetAttribute("RunArena", "")
		end
	end
	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, player in Players:GetPlayers() do
		onPlayerAdded(player)
	end

	Players.PlayerRemoving:Connect(function(player)
		RoundService.RemoveFromRun(player, LEFT_GAME)
		pushInfo[player] = nil
		requestWindow[player] = nil
		starting[player] = nil
	end)

	-- Pass grants (MarketService) and late-loading profiles change run stats.
	local passesChanged = (DataService :: any).PassesChanged
	if type(passesChanged) == "table" and type(passesChanged.Connect) == "function" then
		passesChanged:Connect(function(player: Player)
			RoundService.RefreshStats(player)
		end)
	end
	local profileLoaded = (DataService :: any).ProfileLoaded
	if type(profileLoaded) == "table" and type(profileLoaded.Connect) == "function" then
		profileLoaded:Connect(function(player: Player)
			RoundService.RefreshStats(player)
		end)
	end
end

function RoundService.Start()
	task.spawn(function()
		while true do
			task.wait(DRAIN_INTERVAL)
			local ok, err = pcall(drainStep)
			if not ok then
				warn("[RoundService] drain loop: " .. tostring(err))
			end
		end
	end)
	task.spawn(function()
		while true do
			task.wait(FOAM_TICK)
			local ok, err = pcall(foamStep)
			if not ok then
				warn("[RoundService] foam loop: " .. tostring(err))
			end
		end
	end)
	task.spawn(function()
		while true do
			task.wait(WATCHDOG_INTERVAL)
			local ok, err = pcall(watchdogStep)
			if not ok then
				warn("[RoundService] watchdog loop: " .. tostring(err))
			end
		end
	end)
end

return RoundService</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000022"><Properties><string name="Name">RunServers</string><ProtectedString name="Source">--[[
	RunServers - each party plays its run in its own private server.

	  * Lobby side: when a party launches, Launch() freezes the party (their screens are already
	    black), saves each of them with a "handoff" lock (DataService.BeginHandoff) so the run server
	    can load their saves at once, and teleports the whole party into a freshly reserved server of
	    this same place, with { Mode = "Run", Level, Party = userIds } as teleport data.
	  * Run side (IsRunServer): the party's players arrive, their saves load, and once everyone is in
	    (or after ARRIVE_WAIT) RoundService.StartRound runs for them as usual. A party member who
	    arrives after that joins the run already going. When a player's run ends (results, Leave,
	    Back to Lobby), SendHome teleports them back to a lobby server.
	  * Every teleport is watched: a teleport Roblox couldn't start (TeleportInitFailed) is retried,
	    and if it still fails the player is unfrozen and told, instead of being left stuck.
	  * Studio, unpublished places, or a teleport that can't start: everything falls back to playing
	    the run in this server, exactly as before.

	The workspace attribute "RunServer" tells clients they're in a run server (they stay behind a
	loading cover until the run starts, and while heading home). The player attribute "Teleporting"
	keeps a player's screen black while a teleport is in progress.
]]

local MemoryStoreService = game:GetService("MemoryStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TeleportService = game:GetService("TeleportService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local DataService = require(script.Parent:WaitForChild("DataService"))
local RoundService = require(script.Parent:WaitForChild("RoundService"))
local Characters = require(script.Parent:WaitForChild("Characters"))

local RunServers = {}

local ARRIVE_WAIT = 12 -- seconds to wait for the rest of the party (anyone later joins the run already going)
local PROFILE_WAIT = 20 -- seconds to wait for an arriving player's save to load
local CHARACTER_WAIT = 15 -- seconds to wait for an arriving player's character
local HANDOFF_WAIT = 3 -- seconds the handoff saves may take before teleporting anyway
local TELEPORT_TIMEOUT = 45 -- a teleport still not done after this long counts as failed
local TELEPORT_RETRIES = 3 -- tries per teleport (the first one included)

-- A reserved server (made by TeleportOptions.ShouldReserveServer) has a PrivateServerId but no owner.
RunServers.IsRunServer = game.PrivateServerId ~= "" and game.PrivateServerOwnerId == 0

-- So the admin can teleport into a run server (a reserved server needs its access code): the lobby
-- that reserves one remembers "psid_&lt;PrivateServerId&gt;" = code, and the run server, once it starts,
-- files it under its own JobId ("job_&lt;JobId&gt;"). Kept for a few hours in a MemoryStore map.
local CODE_TTL = 4 * 3600
local codeMap: MemoryStoreHashMap? = nil
local function getCodeMap(): MemoryStoreHashMap?
	if not codeMap then
		pcall(function()
			codeMap = MemoryStoreService:GetHashMap("RinseCycle_RunServerCodes")
		end)
	end
	return codeMap
end
local function putCode(key: string, code: string)
	local map = getCodeMap()
	if map then
		pcall(function()
			(map :: MemoryStoreHashMap):SetAsync(key, code, CODE_TTL)
		end)
	end
end
local function getCode(key: string): string?
	local map = getCodeMap()
	if not map then
		return nil
	end
	local ok, value = pcall(function()
		return (map :: MemoryStoreHashMap):GetAsync(key)
	end)
	return if ok and type(value) == "string" and value ~= "" then value else nil
end

RunServers.AccessCode = nil :: string? -- this run server's own access code, once known

-- The access code of the run server with this JobId, or nil for a normal (public) server.
function RunServers.AccessCodeForJob(jobId: string): string?
	if jobId == game.JobId then
		return RunServers.AccessCode
	end
	return getCode("job_" .. jobId)
end

local function canTeleport(): boolean
	return game.PlaceId ~= 0 and not RunService:IsStudio()
end

local function isHere(player: Player): boolean
	return player.Parent == Players
end

local function notify(player: Player, text: string, kind: string)
	if isHere(player) then
		Remotes.Event("Notify"):FireClient(player, text, kind)
	end
end

-- Holds a player still (anchored in place) while they are being teleported.
local function setFrozen(player: Player, frozen: boolean)
	local root = Characters.GetRoot(player)
	if root then
		root.Anchored = frozen
	end
end

----------------------------------------------------------------------------------------------------
-- Watched teleports
----------------------------------------------------------------------------------------------------

type Pending = {
	Kind: "Run" | "Home",
	Tries: number,
	Token: number,
	AccessCode: string?, -- Run: the reserved server's code, so a retry goes to the same server
	Data: { [string]: any },
	OnFail: ((Player) -&gt; ())?,
}
local pending: { [Player]: Pending } = {}
local nextToken = 0

local function giveUp(player: Player, p: Pending)
	if pending[player] ~= p then
		return
	end
	pending[player] = nil
	if not isHere(player) then
		return
	end
	player:SetAttribute("Teleporting", false)
	setFrozen(player, false)
	DataService.CancelHandoff(player)
	if p.Kind == "Run" then
		notify(player, "Couldn't reach the dishwasher. Please try again!", "Bad")
	else
		notify(player, "Couldn't get back to the lobby. Please rejoin the game.", "Bad")
	end
	if p.OnFail then
		task.spawn(p.OnFail, player)
	end
end

-- One teleport attempt for one player (retries go one player at a time).
local function sendOne(player: Player, p: Pending): boolean
	local ok, err = pcall(function()
		local options = Instance.new("TeleportOptions")
		if p.AccessCode then
			options.ReservedServerAccessCode = p.AccessCode
		end
		options:SetTeleportData(p.Data)
		TeleportService:TeleportAsync(game.PlaceId, { player }, options)
	end)
	if not ok then
		warn(string.format("[RunServers] teleport for %s failed: %s", player.Name, tostring(err)))
	end
	return ok
end

-- Tries again (up to TELEPORT_RETRIES in all), or gives up.
local function retry(player: Player, p: Pending)
	while pending[player] == p and isHere(player) do
		if p.Tries &gt;= TELEPORT_RETRIES then
			giveUp(player, p)
			return
		end
		p.Tries += 1
		task.wait(1.5 * p.Tries)
		if pending[player] ~= p or not isHere(player) then
			return
		end
		if sendOne(player, p) then
			return
		end
	end
end

-- Starts watching a teleport that was just started for `player`.
local function watch(player: Player, p: Pending)
	nextToken += 1
	p.Token = nextToken
	pending[player] = p
	local token = p.Token
	task.delay(TELEPORT_TIMEOUT, function()
		local current = pending[player]
		if current and current.Token == token and isHere(player) then
			giveUp(player, current)
		end
	end)
end

local function onTeleportInitFailed(player: Player, result: Enum.TeleportResult, message: string)
	local p = pending[player]
	if not p then
		return
	end
	warn(string.format("[RunServers] teleport for %s didn't start (%s): %s", player.Name, tostring(result), tostring(message)))
	task.spawn(retry, player, p)
end

----------------------------------------------------------------------------------------------------
-- Lobby side
----------------------------------------------------------------------------------------------------

-- Sends `players` to a new private server for a run of `level`. Returns true if the teleport was
-- started; false means "play it here instead". `onFail` runs for anyone whose teleport later fails.
function RunServers.Launch(players: { Player }, level: number, onFail: ((Player) -&gt; ())?): boolean
	if RunServers.IsRunServer or not canTeleport() or #players == 0 then
		return false
	end
	local userIds = {}
	for _, p in players do
		table.insert(userIds, p.UserId)
		p:SetAttribute("Teleporting", true)
		setFrozen(p, true)
	end

	-- Save everyone with a handoff lock (all at once), so the run server can load them straight away.
	local left = #players
	for _, p in players do
		task.spawn(function()
			pcall(DataService.BeginHandoff, p)
			left -= 1
		end)
	end
	local deadline = os.clock() + HANDOFF_WAIT
	while left &gt; 0 and os.clock() &lt; deadline do
		task.wait(0.1)
	end

	local going: { Player } = {}
	for _, p in players do
		if isHere(p) then
			table.insert(going, p)
		end
	end
	local data: { [string]: any } = { Mode = "Run", Level = level, Party = userIds, AdminInvis = RunServers.InvisList(players) }
	local ok, result = pcall(function()
		local options = Instance.new("TeleportOptions")
		options.ShouldReserveServer = true
		options:SetTeleportData(data)
		return TeleportService:TeleportAsync(game.PlaceId, going, options)
	end)
	if not ok or #going == 0 then
		if not ok then
			warn("[RunServers] couldn't reserve a run server, playing here: " .. tostring(result))
		end
		for _, p in players do
			if isHere(p) then
				p:SetAttribute("Teleporting", false)
				setFrozen(p, false)
				DataService.CancelHandoff(p)
			end
		end
		return false
	end
	local accessCode, privateId = nil, nil
	pcall(function()
		accessCode = (result :: any).ReservedServerAccessCode
		privateId = (result :: any).PrivateServerId
	end)
	if type(accessCode) == "string" and type(privateId) == "string" and privateId ~= "" then
		task.spawn(putCode, "psid_" .. privateId, accessCode)
	end
	for _, p in going do
		watch(p, {
			Kind = "Run",
			Tries = 1,
			Token = 0,
			AccessCode = if type(accessCode) == "string" and accessCode ~= "" then accessCode else nil,
			Data = data,
			OnFail = onFail,
		})
	end
	return true
end

----------------------------------------------------------------------------------------------------
-- Run side
----------------------------------------------------------------------------------------------------

type Plan = { Level: number, Party: { number } }
local plan: Plan? = nil
local arrived: { [number]: Player } = {}
local started = false

-- Teleports a player home to a lobby server. Safe to call more than once.
function RunServers.SendHome(player: Player)
	if not isHere(player) or pending[player] then
		return
	end
	player:SetAttribute("Teleporting", true)
	setFrozen(player, true)
	pcall(DataService.BeginHandoff, player)
	if not isHere(player) then
		return
	end
	local p: Pending = { Kind = "Home", Tries = 1, Token = 0, Data = { Mode = "Lobby", AdminInvis = RunServers.InvisList({ player }) } }
	watch(player, p)
	if not sendOne(player, p) then
		task.spawn(retry, player, p)
	end
end

local function waitUntilReady(player: Player)
	DataService.WaitFor(player, PROFILE_WAIT)
	local waited = 0
	while not Characters.IsAlive(player) and waited &lt; CHARACTER_WAIT and isHere(player) do
		waited += task.wait(0.25)
	end
end

local function startRun()
	if started or not plan then
		return
	end
	started = true
	local players: { Player } = {}
	for _, p in arrived do
		if isHere(p) then
			table.insert(players, p)
		end
	end
	if #players == 0 then
		started = false -- nobody left to play: the next arrival starts it
		return
	end
	-- Everyone's save and character at once, not one after another.
	local left = #players
	for _, p in players do
		task.spawn(function()
			waitUntilReady(p)
			left -= 1
		end)
	end
	while left &gt; 0 do
		task.wait(0.1)
	end

	local best = 1
	local ready: { Player } = {}
	for _, p in players do
		if isHere(p) then
			local profile = DataService.Get(p) :: any
			if profile then
				best = math.max(best, tonumber(profile.Unlocked) or 1)
			end
			table.insert(ready, p)
		end
	end
	if #ready == 0 then
		started = false
		return
	end
	-- Never deeper than anyone in the party has unlocked.
	local level = math.clamp((plan :: Plan).Level, 1, math.min(best, #Config.Levels))
	local ok, result, err = pcall(RoundService.StartRound, ready, level)
	if not ok or result ~= true then
		warn("[RunServers] couldn't start the run: " .. tostring(if ok then err else result))
		for _, p in ready do
			task.spawn(RunServers.SendHome, p)
		end
	end
end

-- A party member who got here after the run started: into the run with the others.
local function joinLate(player: Player)
	waitUntilReady(player)
	if not isHere(player) then
		return
	end
	local ok, joined = pcall(RoundService.JoinLate, player)
	if not (ok and joined) then
		RunServers.SendHome(player) -- the run is already over
	end
end

-- Admins who dropped in from the server list. They play the run like anyone else (invisible),
-- but they aren't what keeps it going: once every real player has gone, they go home too.
local guests: { [number]: boolean } = {}

local function realPlayersHere(): boolean
	for _, p in Players:GetPlayers() do
		if not guests[p.UserId] and isHere(p) then
			return true
		end
	end
	return false
end

local function sendGuestsHome()
	if realPlayersHere() then
		return
	end
	for _, p in Players:GetPlayers() do
		if guests[p.UserId] then
			task.spawn(RunServers.SendHome, p)
		end
	end
end

-- Someone dropping in on a run (an admin from the server list, or a player an admin brought):
-- into the run as soon as it's going; home if it's already over or nobody's left.
local function dropIn(player: Player)
	local waited = 0
	while not started and waited &lt; 90 and isHere(player) do
		waited += task.wait(0.5)
	end
	if not isHere(player) then
		return
	end
	if guests[player.UserId] and not realPlayersHere() then
		RunServers.SendHome(player)
	elseif started then
		joinLate(player)
	end
end

local function onArrive(player: Player)
	local data: any = nil
	pcall(function()
		data = player:GetJoinData().TeleportData
	end)
	if type(data) == "table" and (data.Mode == "AdminJoin" or data.Mode == "AdminBring") then
		if data.Mode == "AdminJoin" then
			guests[player.UserId] = true
		end
		if plan then
			dropIn(player)
		end
		return
	end
	if not plan and type(data) == "table" and data.Mode == "Run" then
		local party = {}
		if type(data.Party) == "table" then
			for _, id in data.Party do
				if type(id) == "number" then
					table.insert(party, id)
				end
			end
		end
		local newPlan: Plan = { Level = math.floor(tonumber(data.Level) or 1), Party = party }
		plan = newPlan
		task.delay(ARRIVE_WAIT, startRun)
	end
	local current = plan
	if not current then
		RunServers.SendHome(player) -- no run was ever set up here
		return
	end
	arrived[player.UserId] = player
	if started then
		joinLate(player)
		return
	end
	-- Everyone's here: start as soon as their saves are loaded.
	for _, id in current.Party do
		if not arrived[id] then
			return
		end
	end
	task.spawn(startRun)
end

-- UserIds of these players who are invisible by the admin :invis command, so the server they
-- arrive in makes them invisible again (AdminServer reads TeleportData.AdminInvis).
function RunServers.InvisList(players: { Player }): { number }
	local list = {}
	for _, p in players do
		if p:GetAttribute("AdminInvis") == true then
			table.insert(list, p.UserId)
		end
	end
	return list
end

function RunServers.Init()
	TeleportService.TeleportInitFailed:Connect(onTeleportInitFailed)
	Players.PlayerRemoving:Connect(function(player)
		pending[player] = nil
		arrived[player.UserId] = nil
		guests[player.UserId] = nil
		if RunServers.IsRunServer and next(guests) ~= nil then
			task.delay(0.5, sendGuestsHome)
		end
	end)
	if not RunServers.IsRunServer then
		return
	end
	Workspace:SetAttribute("RunServer", true)
	RoundService.SendHomeHook = RunServers.SendHome
	-- Look up our own access code (the lobby stored it) and file it under our JobId.
	task.spawn(function()
		for _ = 1, 5 do
			local code = getCode("psid_" .. game.PrivateServerId)
			if code then
				RunServers.AccessCode = code
				putCode("job_" .. game.JobId, code)
				return
			end
			task.wait(3)
		end
	end)
end

function RunServers.Start()
	if not RunServers.IsRunServer then
		return
	end
	for _, p in Players:GetPlayers() do
		task.spawn(onArrive, p)
	end
	Players.PlayerAdded:Connect(onArrive)
end

return RunServers</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000023"><Properties><string name="Name">ShopService</string><ProtectedString name="Source">-- ShopService: owns the MetaRequest RemoteFunction (permanent purchases and pet management).
--
--   "BuyPerk"   (perkId)                     handled here: price from Config.PerkCost, pay with
--                                            DataService.SpendBubbles, level up, push MetaState, and
--                                            refresh run stats if the buyer is mid-run.
--   "Hatch"     ({ Egg = id, Count = 1|3 })  shape-checked here, then PetService.Hatch
--   "Equip" / "Unequip" / "Delete" (uid)     shape-checked here, then PetService
--   "EquipBest"                              PetService.EquipBest
--
-- Whatever the client sends, the reply is always a Types.RequestResult and this never throws.
-- Requests are rate limited (REQUESTS_PER_SECOND per player) and handled one at a time per player.

local GroupService = game:GetService("GroupService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Types = require(Shared:WaitForChild("Types"))

local DataService = require(script.Parent:WaitForChild("DataService"))
local PetService = require(script.Parent:WaitForChild("PetService"))
local RoundService = require(script.Parent:WaitForChild("RoundService"))

local ShopService = {}

local REQUESTS_PER_SECOND = 8 -- sustained rate, and also the burst size
local MAX_ID_LENGTH = 64 -- longer strings can't be a real perk id, egg id or uid

local ERR_GENERIC = "Something went wrong. Try again."
local ERR_SLOW = "Slow down a little!"
local ERR_BUSY = "Still working on your last request..."
local ERR_LOADING = "Your save is still loading. Try again in a moment."
local ERR_UNKNOWN = "Unknown request."

local budgets: { [Player]: { Tokens: number, At: number } } = {}
local busy: { [Player]: boolean } = {}
local initialized = false

----------------------------------------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------------------------------------

local function fail(message: string): Types.RequestResult
	return { Ok = false, Error = message }
end

local function isId(value: any): boolean
	return type(value) == "string" and #value &gt; 0 and #value &lt;= MAX_ID_LENGTH
end

-- Token bucket: REQUESTS_PER_SECOND tokens, refilled continuously.
local function allowRequest(player: Player): boolean
	local now = os.clock()
	local budget = budgets[player]
	if not budget then
		budget = { Tokens = REQUESTS_PER_SECOND, At = now }
		budgets[player] = budget
	end
	budget.Tokens = math.min(REQUESTS_PER_SECOND, budget.Tokens + (now - budget.At) * REQUESTS_PER_SECOND)
	budget.At = now
	if budget.Tokens &lt; 1 then
		return false
	end
	budget.Tokens -= 1
	return true
end

-- Whatever a handler returned, turn it into a well-formed RequestResult.
local function normalize(result: any): Types.RequestResult
	if type(result) ~= "table" then
		return fail(ERR_GENERIC)
	end
	local out: Types.RequestResult = { Ok = result.Ok == true }
	if type(result.Error) == "string" then
		out.Error = result.Error
	elseif not out.Ok then
		out.Error = ERR_GENERIC
	end
	if type(result.Pets) == "table" then
		out.Pets = result.Pets
	end
	if type(result.Rank) == "string" then
		out.Rank = result.Rank
		out.Equipped = result.Equipped == true
	end
	if type(result.Previous) == "string" then
		out.Previous = result.Previous
	end
	if type(result.Message) == "string" then
		out.Message = result.Message
	end
	if type(result.Day) == "number" then
		out.Day = result.Day
	end
	return out
end

local function callPetService(name: string, ...: any): any
	local fn = (PetService :: any)[name]
	if type(fn) ~= "function" then
		warn("[ShopService] PetService." .. name .. " is missing")
		return fail(ERR_GENERIC)
	end
	return fn(...)
end

-- Run stats depend on perks; a failure here must not turn a successful purchase into an error.
local function refreshRunStats(player: Player)
	local ok, err = pcall(function()
		if RoundService.IsInRun(player) then
			RoundService.RefreshStats(player)
		end
	end)
	if not ok then
		warn("[ShopService] RefreshStats failed: " .. tostring(err))
	end
end

----------------------------------------------------------------------------------------------------
-- Actions
----------------------------------------------------------------------------------------------------

local function buyPerk(player: Player, value: any): Types.RequestResult
	if not isId(value) then
		return fail("That perk doesn't exist.")
	end
	local perk = Config.GetPerk(value)
	local profile = DataService.Get(player)
	if not perk then
		return fail("That perk doesn't exist.")
	end
	if not profile then
		return fail(ERR_LOADING)
	end
	local level = profile.Perks[perk.Id] or 0
	local cost = Config.PerkCost(perk.Id, level)
	if not cost then
		return fail(perk.Name .. " is maxed out!")
	end
	if profile.Bubbles &lt; cost then
		return fail("You need " .. Format.Short(cost - profile.Bubbles) .. " more Bubbles")
	end
	if not DataService.SpendBubbles(player, cost) then
		return fail("Not enough Bubbles!")
	end
	profile.Perks[perk.Id] = level + 1
	DataService.PushMeta(player)
	refreshRunStats(player)
	return { Ok = true }
end

local function hatch(player: Player, value: any): Types.RequestResult
	if type(value) ~= "table" or not isId(value.Egg) then
		return fail("Pick an egg to hatch.")
	end
	local count = value.Count
	if count ~= 1 and count ~= 3 then
		return fail("You can hatch 1 or 3 eggs at a time.")
	end
	return callPetService("Hatch", player, value.Egg, count)
end

local function petAction(name: string): (Player, any) -&gt; Types.RequestResult
	return function(player: Player, value: any): Types.RequestResult
		if not isId(value) then
			return fail("That pet doesn't exist.")
		end
		return callPetService(name, player, value)
	end
end

-- Free "test purchases" of passes/products without an Id: Studio only, unless Config says otherwise.
local function testAllowed(): boolean
	local rules = Config.TestPasses or {}
	return if RunService:IsStudio() then rules.AllowInStudio == true else rules.AllowInLiveGame == true
end

-- Test mode for game passes that don't have an Id yet (see Config.GamePasses): grants the pass for
-- this session only, and only in Studio unless Config.TestPasses.AllowInLiveGame is on.
local function testPass(player: Player, value: any): Types.RequestResult
	if type(value) ~= "string" then
		return fail(ERR_UNKNOWN)
	end
	local pass = Config.GetPass(value)
	if not pass then
		return fail("That pass doesn't exist.")
	end
	if type(pass.Id) == "number" and pass.Id ~= 0 then
		return fail("This pass is on sale for real. Use the purchase prompt!")
	end
	if not testAllowed() then
		return fail("Coming soon!")
	end
	DataService.SetPass(player, pass.Key, true)
	return { Ok = true }
end

-- Test mode for developer products without an Id: gives the goods for free (Studio only).
local function testProduct(player: Player, value: any): Types.RequestResult
	local product = if type(value) == "string" then Config.GetProduct(value) else nil
	if not product then
		return fail("That item doesn't exist.")
	end
	if type(product.Id) == "number" and product.Id ~= 0 then
		return fail("This is on sale for real. Use the purchase prompt!")
	end
	if not testAllowed() then
		return fail("Coming soon!")
	end
	local MarketService = require(script.Parent:WaitForChild("MarketService")) :: any
	if not MarketService.GrantProduct(player, product) then
		return fail("Couldn't give that right now.")
	end
	return { Ok = true }
end

-- Rank roll: spend gems, pick a weighted random rank (x2 Luck pass boosts Rare+) and it REPLACES
-- your rank - a gamble, so a good rank is worth keeping. One roll at a time per player.
local rankRng = Random.new()
local ROLL_SECONDS = 1.2 -- matches the client's reel; no second roll until it has landed
local rollingUntil: { [Player]: number } = {}
Players.PlayerRemoving:Connect(function(player)
	rollingUntil[player] = nil
end)
local function rollRank(player: Player, _value: any): Types.RequestResult
	local now = os.clock()
	if now &lt; (rollingUntil[player] or 0) then
		return fail("Wait for your roll to finish!")
	end
	local cost = Config.RankRoll.Cost
	local profile = DataService.Get(player)
	if not profile then
		return fail(ERR_LOADING)
	end
	if profile.Gems &lt; cost then
		return fail(string.format("You need %d Gems to roll!", cost))
	end
	if not DataService.SpendGems(player, cost) then
		return fail(ERR_GENERIC)
	end
	local passes = DataService.GetPasses(player)
	rollingUntil[player] = now + ROLL_SECONDS
	local weights, total = Config.RankWeights(Config.LuckMult(passes.DoubleLuck == true, profile.Referrals))
	local r = rankRng:NextNumber() * total
	local picked = weights[#weights].Rank
	for _, entry in weights do
		r -= entry.Weight
		if r &lt;= 0 then
			picked = entry.Rank
			break
		end
	end
	local previous = profile.Rank
	DataService.AddRank(player, picked.Id)
	DataService.SetRank(player, picked.Id)
	return { Ok = true, Rank = picked.Id, Equipped = true, Previous = previous }
end


local function rebirth(player: Player, _value: any): Types.RequestResult
	if RoundService.IsInRun(player) then
		return fail("Finish your wash first!")
	end
	local ok, err = DataService.Rebirth(player)
	if not ok then
		return fail(err or ERR_GENERIC)
	end
	-- Everyone hears about it: rebirths are the big flex.
	local profile = DataService.Get(player)
	local count = profile and profile.Rebirths or 1
	local notify = Remotes.Event("Notify")
	for _, other in Players:GetPlayers() do
		if other ~= player then
			notify:FireClient(other, string.format("%s just reached Rebirth %d!", player.DisplayName, count), "Good")
		end
	end
	return { Ok = true }
end

-- Daily reward: claimable 24 hours after the last one (DataService.ClaimDaily).
local function claimDaily(player: Player, _value: any): Types.RequestResult
	local day, err = DataService.ClaimDaily(player)
	if not day then
		return fail(err or ERR_GENERIC)
	end
	-- "Your next reward is ready" notification for 24 h from now.
	pcall(function()
		(require(script.Parent:WaitForChild("DailyNotify")) :: any).Queue(player)
	end)
	return { Ok = true, Day = day, Message = Config.RewardText({
		Bubbles = if Config.DailyRewards[day].Kind == "Gems" then nil else Config.DailyRewards[day].Amount,
		Gems = if Config.DailyRewards[day].Kind == "Gems" then Config.DailyRewards[day].Amount else nil,
	}) }
end

local function redeemCode(player: Player, value: any): Types.RequestResult
	if type(value) ~= "string" or #value == 0 or #value &gt; 40 then
		return fail("Type a code first!")
	end
	local ok, message = DataService.RedeemCode(player, value)
	if not ok then
		return fail(message)
	end
	return { Ok = true, Message = message }
end

-- Community reward: checked live with Roblox (GroupService:GetGroupsAsync isn't cached for the
-- session like the old Player:IsInGroup), so it works right after joining from the in-game prompt.
local function inGroup(player: Player, groupId: number): boolean
	local ok, groups = pcall(function()
		return GroupService:GetGroupsAsync(player.UserId)
	end)
	if ok and type(groups) == "table" then
		for _, g in groups do
			if type(g) == "table" and g.Id == groupId then
				return true
			end
		end
		return false
	end
	local okFallback, member = pcall(function()
		return player:IsInGroupAsync(groupId)
	end)
	return okFallback and member == true
end

local function claimGroup(player: Player, _value: any): Types.RequestResult
	local groupId = Config.GetGroupId()
	if groupId &lt;= 0 then
		return fail("The community isn't set up yet!")
	end
	local profile = DataService.Get(player)
	if not profile then
		return fail(ERR_LOADING)
	end
	if profile.GroupReward then
		return fail("You already got this reward. Thanks for joining!")
	end
	if not inGroup(player, groupId) then
		return fail("Join the community first, then claim!")
	end
	if not DataService.GrantGroupReward(player) then
		return fail(ERR_GENERIC)
	end
	return { Ok = true, Message = Config.RewardText(Config.Social.GroupReward) }
end

-- Follow / Like: checked right away (SocialService.CheckNow).
local function socialDone(player: Player, value: any): Types.RequestResult
	local SocialService = require(script.Parent:WaitForChild("SocialService")) :: any
	local ok, message = SocialService.CheckNow(player, if type(value) == "string" then value else "")
	if not ok then
		return fail(message)
	end
	return { Ok = true, Message = message }
end

-- The free x2 cleaning boost offered when a player opens the Roblox menu (once a day).
local function claimStayBoost(player: Player, _value: any): Types.RequestResult
	local ok, message = DataService.ClaimStayBoost(player)
	if not ok then
		return fail(message)
	end
	return { Ok = true, Message = message }
end

local function setPetsResting(player: Player, value: any): Types.RequestResult
	if type(value) ~= "boolean" then
		return fail("Bad request.")
	end
	if not DataService.SetPetsResting(player, value) then
		return fail("Your data is still loading.")
	end
	return { Ok = true }
end

local HANDLERS: { [string]: (Player, any) -&gt; Types.RequestResult } = {
	ClaimDaily = claimDaily,
	ClaimStayBoost = claimStayBoost,
	SetPetsResting = setPetsResting,
	SocialDone = socialDone,
	RedeemCode = redeemCode,
	ClaimGroup = claimGroup,
	Rebirth = rebirth,
	BuyPerk = buyPerk,
	TestPass = testPass,
	TestProduct = testProduct,
	RollRank = rollRank,
	Hatch = hatch,
	Equip = petAction("Equip"),
	Unequip = petAction("Unequip"),
	Delete = petAction("Delete"),
	Merge = function(player: Player, value: any): Types.RequestResult
		local n = Config.PetRules.MergeCount or 3
		if type(value) ~= "table" or #value ~= n then
			return fail(string.format("Pick %d pets to merge.", n))
		end
		local uids = {}
		for i = 1, n do
			if not isId(value[i]) then
				return fail("That pet doesn't exist.")
			end
			uids[i] = value[i]
		end
		return callPetService("Merge", player, uids)
	end,
	EquipBest = function(player: Player, _value: any): Types.RequestResult
		return callPetService("EquipBest", player)
	end,
	-- The run-start cutscene played (or was skipped): move this level's story on a chapter.
	SawEpisode = function(player: Player, value: any): Types.RequestResult
		if type(value) ~= "number" or not DataService.SawEpisode(player, value) then
			return fail(ERR_GENERIC)
		end
		return { Ok = true }
	end,
}

local function onMetaRequest(player: Player, action: any, value: any): Types.RequestResult
	if player.Parent ~= Players then
		return fail(ERR_GENERIC)
	end
	if not allowRequest(player) then
		return fail(ERR_SLOW)
	end
	local handler = if type(action) == "string" then HANDLERS[action] else nil
	if not handler then
		return fail(ERR_UNKNOWN)
	end
	if not DataService.Get(player) then
		return fail(ERR_LOADING)
	end
	-- Handlers don't yield today, but if one ever does, a second request must not interleave with it
	-- (that is how double-spends happen).
	if busy[player] then
		return fail(ERR_BUSY)
	end
	busy[player] = true
	local ok, result = pcall(handler, player, value)
	busy[player] = nil
	if not ok then
		warn(string.format("[ShopService] %s failed for %s: %s", action, player.Name, tostring(result)))
		return fail(ERR_GENERIC)
	end
	return normalize(result)
end

----------------------------------------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------------------------------------

function ShopService.Init()
	if initialized then
		return
	end
	initialized = true
	Remotes.Function("MetaRequest").OnServerInvoke = onMetaRequest
	Players.PlayerRemoving:Connect(function(player)
		budgets[player] = nil
		busy[player] = nil
	end)
end

function ShopService.Start()
	-- Nothing to loop: every purchase arrives through MetaRequest.
end

return ShopService</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000024"><Properties><string name="Name">SocialService</string><ProtectedString name="Source">-- SocialService: the Follow / Favorite rewards and friend referrals (Config.Social). Nothing is
-- paid without a check.
--
-- The Free Rewards window's buttons check straight away (CheckNow). A follow Roblox can't show us
-- yet stays pending and is checked again automatically on the next join:
--   * Follow: the player's public following list is read (friends API, through Config.Social.
--     ProxyDomain because games can't call roblox.com directly; needs "Allow HTTP Requests" on in
--     Game Settings &gt; Security). The dev on it = reward. Not on it, or the check can't run = no
--     reward (they're told why).
--   * Favorite: checked on the player's own device with AvatarEditorService (the game's place is
--     favorited), which is the only way Roblox offers. Likes can't be checked by any game, so
--     there is no Like reward any more. (Saves keep the old "Like" field names for this reward.)

local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local MessagingService = game:GetService("MessagingService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))

local DataService = require(script.Parent:WaitForChild("DataService"))

local SocialService = {}

local MAX_PAGES = 20 -- 2,000 followings is plenty

local initialized = false

-- true / false when the list was read, nil when it couldn't be checked.
local function follows(userId: number, targetId: number): boolean?
	local cursor = ""
	for _ = 1, MAX_PAGES do
		local url = string.format("https://friends.%s/v1/users/%d/followings?limit=100&amp;sortOrder=Desc%s", Config.Social.ProxyDomain, userId, if cursor ~= "" then "&amp;cursor=" .. HttpService:UrlEncode(cursor) else "")
		local ok, body = pcall(function()
			return HttpService:GetAsync(url)
		end)
		if not ok then
			-- HTTP off or the proxy is down: the caller treats "can't check" as a follow (on trust).
			return nil
		end
		local okJson, data = pcall(function()
			return HttpService:JSONDecode(body)
		end)
		if not okJson or type(data) ~= "table" or type(data.data) ~= "table" then
			return nil
		end
		for _, entry in data.data do
			if type(entry) == "table" and entry.id == targetId then
				return true
			end
		end
		if type(data.nextPageCursor) ~= "string" or data.nextPageCursor == "" then
			return false
		end
		cursor = data.nextPageCursor
	end
	return false
end

local function settle(player: Player)
	local profile = DataService.Get(player)
	if not profile or player.Parent ~= Players then
		return
	end
	if profile.FollowPending and not profile.FollowReward then
		local result = follows(player.UserId, Config.Social.CreatorUserId)
		if player.Parent ~= Players then
			return
		end
		-- Only a follow we can actually see is paid. Can't check right now: stay pending.
		if result == nil then
			return
		end
		if result == true then
			if DataService.GrantSocialReward(player, "Follow") then
				DataService.Notice(player, "Thanks for following! You got " .. Config.RewardText(Config.Social.FollowReward) .. "!", "Good")
			end
		else
			DataService.SetSocialPending(player, "Follow", false)
			DataService.Notice(player, "We couldn't find your follow yet. Follow the dev, press the button again, then rejoin.", "Info")
		end
	end
end

-- MetaRequest "SocialDone": the Free Rewards button. Follow is checked right now (and, if the
-- check can't see it yet, again automatically next time they join); Like can't be checked by any
-- game, so it's paid on the click. Returns (ok, message).
function SocialService.CheckNow(player: Player, kind: string): (boolean, string)
	local profile = DataService.Get(player)
	if not profile then
		return false, "Your data is still loading."
	end
	if kind == "Favorite" then
		-- The client only sends this after AvatarEditorService confirmed the favorite.
		if not Config.Social.LikeReward then
			return false, "That reward isn't available."
		end
		if profile.LikeReward then
			return false, "You already got this reward. Thank you!"
		end
		DataService.GrantSocialReward(player, "Like")
		return true, "Thanks for favoriting and liking the game! You got " .. Config.RewardText(Config.Social.LikeReward :: any) .. "!"
	elseif kind == "Follow" then
		if profile.FollowReward then
			return false, "You already got this reward. Thank you!"
		end
		local result = follows(player.UserId, Config.Social.CreatorUserId)
		if result == nil then
			return false, "We couldn't check your follow right now. Try again in a minute!"
		end
		if result == true then
			DataService.GrantSocialReward(player, "Follow")
			return true, "Thanks for following! You got " .. Config.RewardText(Config.Social.FollowReward) .. "!"
		end
		-- Roblox can take a little while to show a new follow: keep it pending so the next join
		-- checks again by itself.
		DataService.SetSocialPending(player, "Follow", true)
		return false, "We can't see your follow yet. If you followed and it's not working, please leave and rejoin the game."
	end
	return false, "That reward doesn't exist."
end

----------------------------------------------------------------------------------------------------
-- Referrals. The Free Rewards "Invite" button opens Roblox's invite prompt with the inviter's
-- UserId as launch data. When a friend joins through it, their join data carries that UserId:
--   * the friend gets Config.Social.ReferredReward (only if they're new: DataService.ClaimReferred)
--   * the inviter gets Config.Social.ReferralReward: straight away if they're in this server,
--     otherwise it waits in the "RinseCycle_ReferralPending" store and MessagingService tells
--     their server (or it's paid on their next join).
----------------------------------------------------------------------------------------------------

local PENDING_STORE = "RinseCycle_ReferralPending"
local REFERRAL_TOPIC = "RinseCycle_Referral"
local pendingStore: DataStore? = nil

local function getPendingStore(): DataStore?
	if pendingStore == nil and not DataService.IsOffline() then
		pcall(function()
			pendingStore = DataStoreService:GetDataStore(PENDING_STORE)
		end)
	end
	return pendingStore
end

local function celebrate(player: Player, title: string, text: string)
	pcall(function()
		local Remotes = require(Shared:WaitForChild("Remotes"))
		Remotes.Event("Celebrate"):FireClient(player, title, text, "@Gift")
	end)
end

local function payInviter(inviter: Player, count: number)
	local paid = DataService.AddReferrals(inviter, count)
	if paid &gt; 0 then
		local reward = Config.Social.ReferralReward
		local each = Config.RewardText({ Bubbles = (reward.Bubbles or 0) * paid, Gems = (reward.Gems or 0) * paid })
		celebrate(inviter, "A friend joined!", string.format("%d friend%s joined from your invite: +%s!", paid, if paid == 1 then "" else "s", each))
	end
end

-- Takes whatever referrals are waiting for this player and pays them.
local function claimPending(player: Player)
	local store = getPendingStore()
	if not store then
		return
	end
	local taken = 0
	local ok = pcall(function()
		store:UpdateAsync("u_" .. player.UserId, function(old)
			taken = math.max(0, math.floor(tonumber(old) or 0))
			if taken == 0 then
				return nil
			end
			return 0
		end)
	end)
	if ok and taken &gt; 0 and player.Parent then
		payInviter(player, taken)
	end
end

local function creditInviter(inviterId: number)
	local inviter = Players:GetPlayerByUserId(inviterId)
	if inviter and DataService.Get(inviter) then
		payInviter(inviter, 1)
		return
	end
	local store = getPendingStore()
	if not store then
		return
	end
	local ok = pcall(function()
		store:UpdateAsync("u_" .. inviterId, function(old)
			return math.max(0, math.floor(tonumber(old) or 0)) + 1
		end)
	end)
	if ok then
		pcall(function()
			MessagingService:PublishAsync(REFERRAL_TOPIC, { UserId = inviterId })
		end)
	end
end

-- A player who joined through someone's invite.
local function checkReferral(player: Player)
	local launch = nil
	pcall(function()
		launch = player:GetJoinData().LaunchData
	end)
	local inviterId = tonumber(launch)
	if not inviterId or inviterId &lt;= 0 or inviterId == player.UserId then
		return
	end
	if DataService.ClaimReferred(player, inviterId) then
		celebrate(player, "Welcome!", "You joined from a friend's invite: +" .. Config.RewardText(Config.Social.ReferredReward) .. "!")
		creditInviter(inviterId)
	end
end

function SocialService.Init()
	if initialized then
		return
	end
	initialized = true
	DataService.ProfileLoaded:Connect(function(player)
		task.spawn(settle, player)
		task.spawn(checkReferral, player)
		task.spawn(claimPending, player)
	end)
	-- Another server says one of our players got a referral: pay it now.
	task.spawn(function()
		pcall(function()
			MessagingService:SubscribeAsync(REFERRAL_TOPIC, function(message)
				local data = message.Data
				local player = type(data) == "table" and Players:GetPlayerByUserId(tonumber(data.UserId) or 0)
				if player then
					claimPending(player)
				end
			end)
		end)
	end)
end

function SocialService.Start() end

return SocialService</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000025"><Properties><string name="Name">TradeService</string><ProtectedString name="Source">--[[
	TradeService - pet trading between two players, in the lobby only.

	  1. "Request" (userId): asks another player in the lobby to trade. They get an invite with
	     Accept / Decline (it expires after INVITE_TTL). The sender can take it back
	     ("CancelRequest"). A request to the same player can only be sent again after
	     REQUEST_COOLDOWN, whatever their answer; once they've accepted one, there's no wait
	     between the two of them any more. The sender is kept up to date with ("Outgoing", map).
	  2. "Accept" (fromUserId) opens the trade for both. Each side adds / removes its own pets
	     ("Add" / "Remove" uid, up to MAX_OFFER each).
	  3. Both press "Ready". Any change to either offer un-readies both. When both are ready a short
	     countdown runs (CONFIRM_SECONDS) so nobody can be tricked by a last-second swap; then
	     PetService.Transfer swaps the pets in one step and both saves are written.
	  4. "Cancel", leaving, dying, joining a party, or starting a run ends the trade.

	Everything is checked on the server: a client can only offer pets it really owns, and the
	offers are re-checked at the moment of the swap.

	TradeState (S-&gt;C) is either nil (no trade), a TradeState table, or ("Invite", { UserId, Name }).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared:WaitForChild("Remotes"))
local Util = require(Shared:WaitForChild("Util"))

local DataService = require(script.Parent:WaitForChild("DataService"))
local RoundService = require(script.Parent:WaitForChild("RoundService"))
local PetService = require(script.Parent:WaitForChild("PetService"))

local TradeService = {}

local INVITE_TTL = 30
local REQUEST_SPAM = 2 -- seconds between any two requests from one player
local REQUEST_COOLDOWN = 120 -- seconds before the same player can be asked again
local MAX_OFFER = 8
local CONFIRM_SECONDS = 3 -- "3, 2, 1" after both press Ready
local ACTIONS_PER_SECOND = 10
local CHECK_INTERVAL = 0.5

type Trade = {
	A: Player,
	B: Player,
	Offer: { [Player]: { string } },
	Ready: { [Player]: boolean },
	ConfirmAt: number?, -- Util.Now() when the swap happens (both ready)
	Version: number, -- bumps on every change, so a pending countdown knows it's stale
	Done: boolean,
}

local tradeOf: { [Player]: Trade } = {}
local invites: { [Player]: { [number]: number } } = {} -- invites[target][fromUserId] = os.clock() sent
local lastRequest: { [Player]: number } = {}
local sentTo: { [Player]: { [number]: number } } = {} -- sentTo[sender][targetUserId] = os.clock() sent
local trusted: { [string]: boolean } = {} -- pairs that have accepted a trade: no cooldown between them

local function pairKey(a: number, b: number): string
	return if a &lt; b then a .. ":" .. b else b .. ":" .. a
end
local actionWindow: { [Player]: { Start: number, Count: number } } = {}

local stateRemote: RemoteEvent
local notifyRemote: RemoteEvent

local function isHere(player: Player): boolean
	return player.Parent == Players
end

local function notify(player: Player, text: string, kind: string?)
	if isHere(player) then
		notifyRemote:FireClient(player, text, kind or "Info")
	end
end

-- Trading is for the lobby: not in a run, a party, a teleport, or a run server.
local function canTrade(player: Player): (boolean, string?)
	if not isHere(player) then
		return false, "They left."
	end
	if Workspace:GetAttribute("RunServer") then
		return false, "Trading is only in the lobby."
	end
	local ok, inRun = pcall(RoundService.IsInRun, player)
	if ok and inRun then
		return false, "Trading is only in the lobby."
	end
	if player:GetAttribute("InParty") == true or player:GetAttribute("Teleporting") == true then
		return false, "Trading is only in the lobby."
	end
	if not DataService.Get(player) then
		return false, "Still loading, try again in a moment."
	end
	return true, nil
end

local function allowAction(player: Player): boolean
	local now = os.clock()
	local w = actionWindow[player]
	if not w or now - w.Start &gt;= 1 then
		w = { Start = now, Count = 0 }
		actionWindow[player] = w
	end
	w.Count += 1
	return w.Count &lt;= ACTIONS_PER_SECOND
end

local function other(trade: Trade, player: Player): Player
	return if trade.A == player then trade.B else trade.A
end

-- The pets behind a list of uids, as the client draws them.
local function describe(owner: Player, uids: { string }): { any }
	local profile = DataService.Get(owner) :: any
	local out = {}
	if not profile then
		return out
	end
	for _, uid in uids do
		for _, pet in profile.Pets do
			if pet.Uid == uid then
				table.insert(out, { Uid = pet.Uid, Id = pet.Id, Tier = pet.Tier })
				break
			end
		end
	end
	return out
end

local function push(trade: Trade)
	for _, p in { trade.A, trade.B } do
		if isHere(p) then
			local partner = other(trade, p)
			stateRemote:FireClient(p, {
				Partner = { UserId = partner.UserId, Name = partner.DisplayName },
				Mine = describe(p, trade.Offer[p]),
				Theirs = describe(partner, trade.Offer[partner]),
				MyReady = trade.Ready[p] == true,
				TheirReady = trade.Ready[partner] == true,
				ConfirmAt = trade.ConfirmAt,
				MaxOffer = MAX_OFFER,
			})
		end
	end
end

-- Tells a sender, per player they've asked: until when the request is still open (PendingUntil)
-- and until when they must wait before asking again (WaitUntil). Server time (Util.Now()).
local function pushOutgoing(sender: Player)
	if not isHere(sender) then
		return
	end
	local out = {}
	local now = os.clock()
	local sent: { [number]: number } = sentTo[sender] or {}
	for userId, at in sent do
		local entry: { [string]: number } = {}
		local target = Players:GetPlayerByUserId(userId)
		local list = target and invites[target]
		if list and list[sender.UserId] and now - list[sender.UserId] &lt; INVITE_TTL then
			entry.PendingUntil = Util.Now() + (INVITE_TTL - (now - list[sender.UserId]))
		end
		if not trusted[pairKey(sender.UserId, userId)] and now - at &lt; REQUEST_COOLDOWN then
			entry.WaitUntil = Util.Now() + (REQUEST_COOLDOWN - (now - at))
		end
		if next(entry) then
			out[tostring(userId)] = entry
		end
	end
	stateRemote:FireClient(sender, "Outgoing", out)
end

local function finish(trade: Trade, message: string?, kind: string?)
	if trade.Done then
		return
	end
	trade.Done = true
	for _, p in { trade.A, trade.B } do
		if tradeOf[p] == trade then
			tradeOf[p] = nil
		end
		if isHere(p) then
			stateRemote:FireClient(p, nil)
			if message then
				notify(p, message, kind)
			end
		end
	end
end

local function changed(trade: Trade)
	trade.Version += 1
	trade.Ready[trade.A] = false
	trade.Ready[trade.B] = false
	trade.ConfirmAt = nil
	push(trade)
end

local function execute(trade: Trade)
	local a, b = trade.A, trade.B
	for _, p in { a, b } do
		local ok, why = canTrade(p)
		if not ok then
			finish(trade, "Trade cancelled: " .. (why or "someone can't trade right now."), "Bad")
			return
		end
	end
	local ok, err = PetService.Transfer(a, b, trade.Offer[a], trade.Offer[b])
	if not ok then
		-- Nothing moved. Back to the offers, un-readied.
		notify(a, err or "The trade didn't go through.", "Bad")
		notify(b, err or "The trade didn't go through.", "Bad")
		changed(trade)
		return
	end
	finish(trade, "Trade complete!", "Good")
	for _, p in { a, b } do
		task.spawn(function()
			pcall(DataService.Save, p)
		end)
	end
end

local function checkReady(trade: Trade)
	if not (trade.Ready[trade.A] and trade.Ready[trade.B]) then
		trade.ConfirmAt = nil
		push(trade)
		return
	end
	if #trade.Offer[trade.A] == 0 and #trade.Offer[trade.B] == 0 then
		trade.Ready[trade.A], trade.Ready[trade.B] = false, false
		push(trade)
		return
	end
	trade.ConfirmAt = Util.Now() + CONFIRM_SECONDS
	local version = trade.Version
	push(trade)
	task.delay(CONFIRM_SECONDS, function()
		if not trade.Done and trade.Version == version and trade.Ready[trade.A] and trade.Ready[trade.B] then
			execute(trade)
		end
	end)
end

local function startTrade(a: Player, b: Player)
	local trade: Trade = {
		A = a,
		B = b,
		Offer = { [a] = {}, [b] = {} },
		Ready = { [a] = false, [b] = false },
		ConfirmAt = nil,
		Version = 0,
		Done = false,
	}
	tradeOf[a], tradeOf[b] = trade, trade
	invites[a], invites[b] = nil, nil
	push(trade)
end

local function onAction(player: Player, action: any, value: any)
	if type(action) ~= "string" or not allowAction(player) then
		return
	end
	local trade = tradeOf[player]

	if action == "Request" then
		if trade then
			return
		end
		local target = type(value) == "number" and Players:GetPlayerByUserId(value) or nil
		if not target or target == player then
			return
		end
		local now = os.clock()
		if lastRequest[player] and now - lastRequest[player] &lt; REQUEST_SPAM then
			return
		end
		local sent = sentTo[player] or {}
		sentTo[player] = sent
		local at = sent[target.UserId]
		if at and not trusted[pairKey(player.UserId, target.UserId)] and now - at &lt; REQUEST_COOLDOWN then
			local left = math.ceil(REQUEST_COOLDOWN - (now - at))
			notify(player, string.format("You've already sent %s a request. Please wait %d:%02d before sending another.", target.DisplayName, left // 60, left % 60), "Bad")
			pushOutgoing(player)
			return
		end
		local ok, why = canTrade(player)
		if not ok then
			notify(player, why or "You can't trade right now.", "Bad")
			return
		end
		ok, why = canTrade(target)
		if not ok or tradeOf[target] then
			notify(player, target.DisplayName .. " can't trade right now.", "Bad")
			return
		end
		lastRequest[player] = now
		sent[target.UserId] = now
		local list = invites[target] or {}
		invites[target] = list
		list[player.UserId] = now
		stateRemote:FireClient(target, "Invite", { UserId = player.UserId, Name = player.DisplayName })
		notify(player, "Trade request sent to " .. target.DisplayName .. "!", "Good")
		pushOutgoing(player)
		-- When it runs out unanswered, the sender's list updates by itself.
		task.delay(INVITE_TTL + 0.5, function()
			pushOutgoing(player)
		end)
		return
	end

	-- The sender takes their request back before it's answered.
	if action == "CancelRequest" then
		local target = type(value) == "number" and Players:GetPlayerByUserId(value) or nil
		local list = target and invites[target]
		if target and list and list[player.UserId] then
			list[player.UserId] = nil
			stateRemote:FireClient(target, "InviteCancelled", { UserId = player.UserId })
			notify(player, "Request to " .. target.DisplayName .. " cancelled.")
		end
		pushOutgoing(player)
		return
	end

	if action == "Accept" or action == "Decline" then
		if trade or type(value) ~= "number" then
			return
		end
		local list = invites[player]
		local sentAt = list and list[value]
		if list then
			list[value] = nil
		end
		local from = Players:GetPlayerByUserId(value)
		if not sentAt or os.clock() - sentAt &gt; INVITE_TTL or not from then
			if action == "Accept" then
				notify(player, "That trade request expired.")
			end
			return
		end
		if action == "Decline" then
			notify(from, player.DisplayName .. " declined your trade.")
			pushOutgoing(from)
			return
		end
		if tradeOf[from] then
			notify(player, from.DisplayName .. " is already trading.", "Bad")
			return
		end
		for _, p in { player, from } do
			local ok, why = canTrade(p)
			if not ok then
				notify(player, why or "You can't trade right now.", "Bad")
				return
			end
		end
		trusted[pairKey(from.UserId, player.UserId)] = true
		startTrade(from, player)
		pushOutgoing(from)
		return
	end

	if not trade or trade.Done then
		return
	end
	if action == "Cancel" then
		local partner = other(trade, player)
		finish(trade, nil)
		notify(player, "Trade cancelled.")
		notify(partner, player.DisplayName .. " cancelled the trade.")
	elseif action == "Add" then
		local offer = trade.Offer[player]
		if type(value) ~= "string" or table.find(offer, value) or #offer &gt;= MAX_OFFER then
			return
		end
		local profile = DataService.Get(player) :: any
		local owns = false
		for _, pet in (profile and profile.Pets or {}) do
			if pet.Uid == value then
				owns = true
				break
			end
		end
		if owns then
			table.insert(offer, value)
			changed(trade)
		end
	elseif action == "Remove" then
		local offer = trade.Offer[player]
		local i = type(value) == "string" and table.find(offer, value)
		if i then
			table.remove(offer, i)
			changed(trade)
		end
	elseif action == "Ready" then
		trade.Ready[player] = value == true
		if not trade.Ready[player] then
			trade.Version += 1 -- stops a countdown in progress
		end
		checkReady(trade)
	end
end

function TradeService.IsTrading(player: Player): boolean
	return tradeOf[player] ~= nil
end

function TradeService.Init()
	stateRemote = Remotes.Event("TradeState")
	notifyRemote = Remotes.Event("Notify")
	Remotes.Event("TradeAction").OnServerEvent:Connect(onAction)
	Players.PlayerRemoving:Connect(function(player)
		local trade = tradeOf[player]
		if trade then
			local partner = other(trade, player)
			finish(trade, nil)
			notify(partner, player.DisplayName .. " left, so the trade was cancelled.", "Bad")
		end
		invites[player] = nil
		lastRequest[player] = nil
		sentTo[player] = nil
		-- Their open requests to others disappear from those players' screens.
		for _, other in Players:GetPlayers() do
			local list = invites[other]
			if list and list[player.UserId] then
				list[player.UserId] = nil
				stateRemote:FireClient(other, "InviteCancelled", { UserId = player.UserId })
			end
		end
		actionWindow[player] = nil
	end)
end

function TradeService.Start()
	-- A trade ends as soon as either side stops being free to trade (party, run, died...).
	task.spawn(function()
		while true do
			task.wait(CHECK_INTERVAL)
			local seen: { [Trade]: boolean } = {}
			for _, trade in tradeOf do
				if seen[trade] or trade.Done then
					continue
				end
				seen[trade] = true
				for _, p in { trade.A, trade.B } do
					local ok = canTrade(p)
					if not ok then
						finish(trade, "Trade cancelled: trading is only in the lobby.", "Bad")
						break
					end
				end
			end
		end
	end)
end

return TradeService</ProtectedString></Properties></Item>
</Item>
<Item class="Script" referent="RBX00000026"><Properties><string name="Name">Main</string><bool name="Disabled">false</bool><token name="RunContext">1</token><ProtectedString name="Source">-- Rinse Cycle server entry point. Builds the world, then starts every service in order.
-- Each service module exposes Init() (set up state and remote handlers, no long yields)
-- and Start() (spawn loops). See DESIGN.md for what each one owns.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterPlayer = game:GetService("StarterPlayer")

-- Hold characters back until the lobby floor exists, or new players fall into the void.
Players.CharacterAutoLoads = false
Players.RespawnTime = 3

-- Spawning must NEVER stay off. Whatever happens below (a service erroring or hanging while the
-- server starts), players get their characters: the normal path turns spawning on once the lobby
-- is built; this safety net does it after SPAWN_FAILSAFE seconds no matter what, and a watchdog
-- keeps spawning anyone still without a character after that (it logs why it had to).
local SPAWN_FAILSAFE = 15
local spawnsReleased = false
local function spawnMissing(reason: string)
	for _, player in Players:GetPlayers() do
		if not player.Character and player.Parent == Players then
			warn(string.format("[Rinse Cycle] spawning %s (%s)", player.Name, reason))
			task.spawn(function()
				local ok = pcall(function()
					player:LoadCharacterAsync()
				end)
				if not ok then
					pcall(function()
						player:LoadCharacter()
					end)
				end
			end)
		end
	end
end
local function releaseSpawns(reason: string)
	if spawnsReleased then
		return
	end
	spawnsReleased = true
	Players.CharacterAutoLoads = true
	spawnMissing(reason)
end
task.delay(SPAWN_FAILSAFE, function()
	if not spawnsReleased then
		warn("[Rinse Cycle] server start took too long: spawning players anyway")
		releaseSpawns("start-up failsafe")
	end
end)
local joinedAt: { [Player]: number } = {}
Players.PlayerAdded:Connect(function(player)
	joinedAt[player] = os.clock()
end)
Players.PlayerRemoving:Connect(function(player)
	joinedAt[player] = nil
end)
task.spawn(function()
	while true do
		task.wait(5)
		if spawnsReleased then
			for _, player in Players:GetPlayers() do
				local at = joinedAt[player] or 0
				if not player.Character and os.clock() - at &gt; SPAWN_FAILSAFE then
					spawnMissing("had no character after joining")
					break
				end
			end
		end
	end
end)

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared:WaitForChild("Remotes"))
local Config = require(Shared:WaitForChild("Config"))

local ServicesFolder = script.Parent:WaitForChild("Services")

-- Loads one service. A missing or broken one is reported and skipped (an empty table) instead of
-- stopping this whole script - which would leave everything after it, spawning included, undone.
local function need(name: string): any
	local module = ServicesFolder:WaitForChild(name, 10)
	if not module or not module:IsA("ModuleScript") then
		warn(string.format("[Rinse Cycle] service %s is missing (it must be a ModuleScript in Server &gt; Services)", name))
		return {}
	end
	local ok, result = pcall(require, module)
	if not ok then
		warn(string.format("[Rinse Cycle] service %s failed to load: %s", name, tostring(result)))
		return {}
	end
	return result
end
local Characters = need("Characters")
local DataService = need("DataService")
local MarketService = need("MarketService")
local LobbyBuilder = need("LobbyBuilder")
local DishFactory = need("DishFactory")
local ArenaBuilder = need("ArenaBuilder")
local RoundService = need("RoundService")
local PetService = need("PetService")
local ShopService = need("ShopService")
local PartyService = need("PartyService")
local LeaderboardService = need("LeaderboardService")
local NameTags = need("NameTags")
local SocialService = need("SocialService")
local LobbyFun = need("LobbyFun")
local RunServers = need("RunServers")
local GiftService = need("GiftService")
local TradeService = need("TradeService")
local EventService = need("EventService")
local ClubService = need("ClubService")
local BadgeAwards = need("BadgeAwards")
local DailyNotify = need("DailyNotify")

local function step(name: string, fn: () -&gt; ())
	local started = os.clock()
	local ok, err = xpcall(fn, debug.traceback)
	if not ok then
		warn(string.format("[%s] %s FAILED:\n%s", Config.GameName, name, tostring(err)))
	elseif os.clock() - started &gt; 5 then
		print(string.format("[%s] %s took %.1fs", Config.GameName, name, os.clock() - started))
	end
end

-- Camera and movement defaults (apply to characters spawned after this point).
StarterPlayer.CameraMaxZoomDistance = 60
StarterPlayer.CameraMinZoomDistance = 0.5 -- scroll all the way in for first person
StarterPlayer.CharacterWalkSpeed = Config.World.LobbyWalkSpeed

-- The dishwashers are built deep under the lobby; make sure the kill plane is below them even if the
-- place file didn't set it (scripts may not be allowed to, hence the pcall).
pcall(function()
	if workspace.FallenPartsDestroyHeight &gt; -10000 then
		workspace.FallenPartsDestroyHeight = -20000
	end
end)
step("Remotes", Remotes.Setup)
step("Characters", Characters.Setup)
step("DataService.Init", DataService.Init)
step("MarketService.Init", MarketService.Init)
step("LobbyBuilder.Build", function()
	LobbyBuilder.Build()
end)

-- Players can spawn now that the lobby exists.
releaseSpawns("lobby ready")

local services = {
	{ "DishFactory", DishFactory },
	{ "ArenaBuilder", ArenaBuilder },
	{ "RoundService", RoundService },
	{ "RunServers", RunServers },
	{ "PetService", PetService },
	{ "ShopService", ShopService },
	{ "PartyService", PartyService },
	{ "LeaderboardService", LeaderboardService },
	{ "NameTags", NameTags },
	{ "SocialService", SocialService },
	{ "LobbyFun", LobbyFun },
	{ "GiftService", GiftService },
	{ "TradeService", TradeService },
	{ "EventService", EventService },
	{ "ClubService", ClubService },
	{ "BadgeAwards", BadgeAwards },
	{ "DailyNotify", DailyNotify },
}

for _, entry in services do
	local name, service = entry[1], entry[2] :: any
	if type(service.Init) == "function" then
		step(name .. ".Init", service.Init)
	end
end
for _, entry in services do
	local name, service = entry[1], entry[2] :: any
	if type(service.Start) == "function" then
		step(name .. ".Start", service.Start)
	end
end
if type((MarketService :: any).Start) == "function" then
	step("MarketService.Start", (MarketService :: any).Start)
end
if type((DataService :: any).Start) == "function" then
	step("DataService.Start", (DataService :: any).Start)
end

print(string.format("[%s] v%s server ready", Config.GameName, Config.Version))</ProtectedString></Properties></Item>
</Item>
</Item>
<Item class="StarterPlayer" referent="RBX00000027"><Properties><string name="Name">StarterPlayer</string><float name="NameDisplayDistance">0</float><float name="HealthDisplayDistance">0</float></Properties>
<Item class="StarterPlayerScripts" referent="RBX00000028"><Properties><string name="Name">StarterPlayerScripts</string></Properties>
<Item class="Folder" referent="RBX00000029"><Properties><string name="Name">Client</string></Properties>
<Item class="ModuleScript" referent="RBX0000002A"><Properties><string name="Name">Autocomplete</string><ProtectedString name="Source">--[[
	Autocomplete - Minecraft-style suggestions for a TextBox (the admin command line and name boxes).

	While the box is focused, a list of suggestions sits right above (or below) it: what the word
	you're typing can become, plus a usage line. Tab puts the highlighted suggestion in (and never
	types a tab character); Up / Down move the highlight; clicking one puts it in too. Enter does
	whatever the box normally does.

	Autocomplete.Attach(box, provider, options) -&gt; detach()
	  provider(text) -&gt; { Usage: string?, Items: { { Text: string, Hint: string? } }, Replace: number }
	    Items complete the word being typed: it starts at character Replace (1-based) and runs to the
	    end of the text. Return Items = {} when there's nothing to suggest.
	  options.Above: list above the box (default) or below; options.Parent: where the list lives
	  (default: the box's ScreenGui root), options.MaxItems (default 8).
]]

local UserInputService = game:GetService("UserInputService")

local Client = script.Parent
local UIKit = require(Client:WaitForChild("UIKit"))

local Autocomplete = {}

local Colors = UIKit.Theme.Colors
local Fonts = UIKit.Theme.Fonts

local ROW_H = 26

export type Item = { Text: string, Hint: string? }
export type Result = { Usage: string?, Items: { Item }, Replace: number }

-- The words of a command line, and where the last one starts (1-based). A trailing space starts a
-- new, empty word.
function Autocomplete.Split(text: string): ({ string }, number)
	local words = {}
	local lastStart = 1
	local i = 1
	while i &lt;= #text do
		local s, e = string.find(text, "%S+", i)
		if not s then
			break
		end
		table.insert(words, string.sub(text, s, e))
		lastStart = s
		i = (e :: number) + 1
	end
	if #text == 0 or string.match(text, "%s$") then
		table.insert(words, "")
		lastStart = #text + 1
	end
	return words, lastStart
end

-- Items from a list of candidates that start with `prefix` (any case), A to Z.
-- `keepOrder`: leave them in the order given (durations, numbered options) instead of A to Z.
function Autocomplete.Match(prefix: string, candidates: { Item }, keepOrder: boolean?): { Item }
	local lower = string.lower(prefix)
	local out = {}
	for _, c in candidates do
		if string.sub(string.lower(c.Text), 1, #lower) == lower and string.lower(c.Text) ~= lower then
			table.insert(out, c)
		end
	end
	if not keepOrder then
		table.sort(out, function(a, b)
			return string.lower(a.Text) &lt; string.lower(b.Text)
		end)
	end
	return out
end

function Autocomplete.Attach(box: TextBox, provider: (string) -&gt; Result, options: { [string]: any }?): () -&gt; ()
	local opts: any = options or {}
	local maxItems = opts.MaxItems or 8
	local above = opts.Above ~= false
	local connections: { RBXScriptConnection } = {}

	local list = Instance.new("Frame")
	list.Name = "Suggestions"
	list.BackgroundColor3 = Colors.Ink
	list.BackgroundTransparency = 0.1
	list.BorderSizePixel = 0
	list.Visible = false
	list.ZIndex = 200
	list.AutomaticSize = Enum.AutomaticSize.Y
	UIKit.Corner(list, 8)
	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = list
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 4)
	pad.PaddingBottom = UDim.new(0, 4)
	pad.PaddingLeft = UDim.new(0, 8)
	pad.PaddingRight = UDim.new(0, 8)
	pad.Parent = list

	local items: { Item } = {}
	local replaceAt = 1
	local selected = 1
	local applying = false
	local appliedAt = 0

	local function place()
		local parent = list.Parent :: GuiObject?
		if not parent or not parent:IsA("GuiObject") then
			return
		end
		local scale = UIKit.GetScale()
		local boxPos = (box.AbsolutePosition - parent.AbsolutePosition) / scale
		local boxSize = box.AbsoluteSize / scale
		list.Size = UDim2.fromOffset(math.max(260, boxSize.X), 0)
		if above then
			list.AnchorPoint = Vector2.new(0, 1)
			list.Position = UDim2.fromOffset(boxPos.X - 10, boxPos.Y - 8)
		else
			list.AnchorPoint = Vector2.new(0, 0)
			list.Position = UDim2.fromOffset(boxPos.X - 10, boxPos.Y + boxSize.Y + 8)
		end
	end

	local function apply(item: Item?)
		local pick = item or items[selected]
		if not pick then
			return
		end
		applying = true
		local text = string.gsub(box.Text, "\t", "")
		local before = string.sub(text, 1, replaceAt - 1)
		box.Text = before .. pick.Text .. " "
		box.CursorPosition = #box.Text + 1
		applying = false
		appliedAt = os.clock()
	end

	local function redraw(usage: string?)
		for _, c in list:GetChildren() do
			if c:IsA("GuiObject") then
				c:Destroy()
			end
		end
		local order = 0
		local function row(text: string, hint: string?, isSelected: boolean, item: Item?)
			order += 1
			local r = Instance.new("TextButton")
			r.Name = "Row"
			r.AutoButtonColor = false
			r.Text = ""
			r.LayoutOrder = order
			r.Size = UDim2.new(1, 0, 0, ROW_H)
			r.BackgroundColor3 = Colors.Primary
			r.BackgroundTransparency = if isSelected then 0.55 else 1
			r.ZIndex = 201
			UIKit.Corner(r, 6)
			local label = Instance.new("TextLabel")
			label.BackgroundTransparency = 1
			label.Size = UDim2.new(1, -8, 1, 0)
			label.Position = UDim2.fromOffset(4, 0)
			label.Font = Fonts.Body
			label.TextSize = 16
			label.RichText = true
			label.TextXAlignment = Enum.TextXAlignment.Left
			label.TextTruncate = Enum.TextTruncate.AtEnd
			label.TextColor3 = if item then Colors.Text else Colors.TextDim
			local safe = string.gsub(string.gsub(string.gsub(text, "&amp;", "&amp;amp;"), "&lt;", "&amp;lt;"), "&gt;", "&amp;gt;")
			local safeHint = if hint then string.gsub(string.gsub(string.gsub(hint, "&amp;", "&amp;amp;"), "&lt;", "&amp;lt;"), "&gt;", "&amp;gt;") else nil
			label.Text = if safeHint then string.format('%s  &lt;font color="#%s"&gt;%s&lt;/font&gt;', safe, Colors.TextDim:ToHex(), safeHint) else safe
			label.ZIndex = 202
			label.Parent = r
			if item then
				r.Activated:Connect(function()
					apply(item)
					box:CaptureFocus()
				end)
			end
			r.Parent = list
		end
		if usage and usage ~= "" then
			row(usage, nil, false, nil)
		end
		for i = 1, math.min(#items, maxItems) do
			row(items[i].Text, items[i].Hint, i == selected, items[i])
		end
		if #items &gt; maxItems then
			row(string.format("... and %d more (keep typing)", #items - maxItems), nil, false, nil)
		end
		list.Visible = box:IsFocused() and order &gt; 0
		place()
	end

	local function refresh()
		local ok, result = pcall(provider, box.Text)
		if not ok or type(result) ~= "table" then
			items = {}
			redraw(nil)
			return
		end
		items = result.Items or {}
		replaceAt = result.Replace or (#box.Text + 1)
		selected = math.clamp(selected, 1, math.max(1, math.min(#items, maxItems)))
		redraw(result.Usage)
	end

	table.insert(connections, box:GetPropertyChangedSignal("Text"):Connect(function()
		if applying then
			return
		end
		-- Tab: complete, and never leave a tab character behind.
		if string.find(box.Text, "\t", 1, true) then
			applying = true
			box.Text = string.gsub(box.Text, "\t", "")
			applying = false
			-- Suggestions for exactly what's typed now, then complete with the top one.
			selected = 1
			refresh()
			if #items &gt; 0 then
				apply(nil)
			end
			selected = 1
			refresh()
			return
		end
		selected = 1
		refresh()
	end))
	table.insert(connections, box.Focused:Connect(function()
		if list.Parent == nil then
			local screen = box:FindFirstAncestorWhichIsA("ScreenGui")
			local root = opts.Parent or (screen and screen:FindFirstChild("Root")) or screen
			list.Parent = root
		end
		selected = 1
		refresh()
	end))
	table.insert(connections, box.FocusLost:Connect(function()
		-- A moment later, so a click on a suggestion still lands.
		task.delay(0.15, function()
			if not box:IsFocused() then
				list.Visible = false
			end
		end)
	end))
	table.insert(connections, UserInputService.InputBegan:Connect(function(input)
		if not box:IsFocused() or #items == 0 then
			return
		end
		local shown = math.min(#items, maxItems)
		if input.KeyCode == Enum.KeyCode.Down then
			selected = selected % shown + 1
			refresh()
		elseif input.KeyCode == Enum.KeyCode.Up then
			selected = (selected - 2) % shown + 1
			refresh()
		elseif input.KeyCode == Enum.KeyCode.Tab then
			-- Some platforms don't type the tab into the box: complete here instead.
			task.defer(function()
				if os.clock() - appliedAt &gt; 0.1 and not string.find(box.Text, "\t", 1, true) and #items &gt; 0 then
					apply(nil)
					selected = 1
					refresh()
				end
			end)
		end
	end))

	return function()
		for _, c in connections do
			c:Disconnect()
		end
		list:Destroy()
	end
end

return Autocomplete</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000002B"><Properties><string name="Name">BoardView</string><ProtectedString name="Source">--[[
	BoardView - the lobby leaderboards on this player's screen.

	  * Scrolling: a SurfaceGui only takes the mouse wheel / a finger when it lives in PlayerGui, so
	    each leaderboard's SurfaceGui (tag "LeaderboardBoard", drawn by LeaderboardService) is moved
	    into PlayerGui and adorned back onto its board. The server keeps drawing into it as before.
	  * Your position: under every page, a highlighted row with your rank, name and score
	    ("#515  you  12,345"), from the player attribute "Lb_&lt;board&gt;&lt;page&gt;" = "&lt;rank&gt;|&lt;value&gt;".
	    Rank 0 with a value means you're further down than the board looks (past #1000).
	  * Your row in the top 100 is lit up too.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")

local LocalPlayer = Players.LocalPlayer

local BoardView = {}

local GOLD = Color3.fromRGB(255, 205, 70)
local INK = Color3.fromRGB(10, 30, 60)

local initialized = false
local guis: { [Instance]: SurfaceGui } = {}

-- The SurfaceGui of a leaderboard part (wherever it lives now). Effects uses this for the arrows.
function BoardView.GuiOf(board: Instance): SurfaceGui?
	return guis[board]
end

local function label(props: { [string]: any }, parent: Instance): TextLabel
	local lbl = Instance.new("TextLabel")
	lbl.BackgroundTransparency = 1
	lbl.Font = Enum.Font.LuckiestGuy
	lbl.TextScaled = true
	lbl.TextColor3 = INK
	for k, v in props do
		(lbl :: any)[k] = v
	end
	lbl.Parent = parent
	return lbl
end

-- Lights up this player's own row among the top 100 (rows carry a UserId attribute).
local function watchList(list: Instance)
	local function paint(row: Instance)
		if row:IsA("Frame") and row:GetAttribute("UserId") == LocalPlayer.UserId and not row:FindFirstChild("YouOutline") then
			row.BackgroundTransparency = 0.75
			local outline = Instance.new("UIStroke")
			outline.Name = "YouOutline"
			outline.Thickness = 3
			outline.Color = GOLD
			outline.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
			outline.Parent = row
		end
	end
	for _, row in list:GetChildren() do
		paint(row)
	end
	list.ChildAdded:Connect(paint)
end

-- The "you" row under one page.
local function addYouRow(page: Frame, id: string)
	local hasDots = page:FindFirstChild("PageDots") ~= nil
	local row = Instance.new("Frame")
	row.Name = "YouRow"
	row.AnchorPoint = Vector2.new(0, 1)
	row.Position = UDim2.new(0, 0, 1, if hasDots then -30 else -2)
	row.Size = UDim2.new(1, 0, 0, 40)
	row.BackgroundColor3 = GOLD
	row.BorderSizePixel = 0
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 10)
	corner.Parent = row
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 3
	stroke.Color = Color3.fromRGB(255, 245, 200)
	stroke.Parent = row
	local rankLabel = label({ Name = "Rank", Size = UDim2.new(0, 110, 1, -6), Position = UDim2.new(0, 6, 0, 3) }, row)
	label({
		Name = "Player",
		Size = UDim2.new(1, -290, 1, -6),
		Position = UDim2.new(0, 124, 0, 3),
		Text = LocalPlayer.Name .. " (you)",
		TextXAlignment = Enum.TextXAlignment.Left,
	}, row)
	local valueLabel = label({
		Name = "Value",
		Size = UDim2.new(0, 160, 1, -6),
		Position = UDim2.new(1, -166, 0, 3),
		TextXAlignment = Enum.TextXAlignment.Right,
	}, row)
	row.Parent = page

	local attr = "Lb_" .. id
	local function refresh()
		local raw = LocalPlayer:GetAttribute(attr)
		local rank, text = string.match(if type(raw) == "string" then raw else "", "^(%d+)|(.*)$")
		local n = tonumber(rank) or 0
		if not text or text == "" then
			rankLabel.Text = "#-"
			valueLabel.Text = "Not on it yet"
		else
			rankLabel.Text = if n &gt; 0 then "#" .. n else "#1000+"
			valueLabel.Text = text
		end
	end
	refresh()
	LocalPlayer:GetAttributeChangedSignal(attr):Connect(refresh)
end

local function setup(board: Instance)
	if guis[board] or not board:IsA("BasePart") then
		return
	end
	local gui = board:FindFirstChildOfClass("SurfaceGui") or board:WaitForChild("SurfaceGui", 15)
	if not gui or not gui:IsA("SurfaceGui") or guis[board] then
		return
	end
	guis[board] = gui
	local kind = tostring(board:GetAttribute("LbBoard") or "")
	for i = 1, 20 do
		local page = gui:FindFirstChild("Page" .. i)
		if not page or not page:IsA("Frame") then
			break
		end
		local list = page:FindFirstChild("List")
		if list then
			watchList(list)
		end
		if kind ~= "" then
			addYouRow(page, kind .. i)
		end
	end
	-- Into PlayerGui (still drawn on the board) so the list scrolls.
	gui.ResetOnSpawn = false
	gui.Adornee = board
	gui.Parent = LocalPlayer:WaitForChild("PlayerGui")
	board.AncestryChanged:Connect(function()
		if not board:IsDescendantOf(game) then
			guis[board] = nil
			gui:Destroy()
		end
	end)
end

function BoardView.Init()
	if initialized then
		return
	end
	initialized = true
	for _, board in CollectionService:GetTagged("LeaderboardBoard") do
		task.spawn(setup, board)
	end
	CollectionService:GetInstanceAddedSignal("LeaderboardBoard"):Connect(function(board)
		task.spawn(setup, board)
	end)
end

return BoardView</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000002C"><Properties><string name="Name">BubbleJets</string><ProtectedString name="Source">-- BubbleJets: inside a run, hold jump while in the air to fly up on a jet of soap bubbles.
-- Fuel (a few seconds) refills while you stand on something. The HUD shows the fuel bar from the
-- LocalPlayer's "JetFuel" attribute (0..1), so this module owns no UI.
--
-- The character is network-owned by the client, so setting its velocity here is all it takes.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Client = script.Parent
local ClientState = require(Client:WaitForChild("ClientState"))
local Bubbles = require(Client:WaitForChild("Bubbles"))

local FUEL_SECONDS = 2.6 -- full tank of flight
local REFILL_PER_SECOND = 1.3 -- seconds of flight regained per second on the ground
local RISE_SPEED = 34 -- studs/s upward while jetting
local HOLD_WINDOW = 0.2 -- JumpRequest repeats while jump is held; this bridges the gaps
local BUBBLES_PER_SECOND = 38

local BubbleJets = {}
local initialized = false

local player = Players.LocalPlayer
local fuel = FUEL_SECONDS
local lastJumpRequest = -1
local emitAccumulator = 0
local lastFuelShown: number? = nil

local touchJumpHeld = false -- the on-screen jump button (phones / tablets) is being held

-- Watches Roblox's own touch jump button (PlayerGui.TouchGui...JumpButton) while it's held. On
-- phones JumpRequest only fires once per press, so it can't tell "held" on its own.
local function watchTouchJump()
	local gui = player:WaitForChild("PlayerGui")
	local function hook(button: Instance)
		if not button:IsA("GuiButton") or button:GetAttribute("JetHooked") then
			return
		end
		button:SetAttribute("JetHooked", true)
		button.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch then
				touchJumpHeld = true
			end
		end)
		button.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch then
				touchJumpHeld = false
			end
		end)
	end
	local function scan(root: Instance)
		for _, d in root:GetDescendants() do
			if d.Name == "JumpButton" then
				hook(d)
			end
		end
	end
	scan(gui)
	gui.DescendantAdded:Connect(function(d)
		if d.Name == "JumpButton" then
			hook(d)
		end
	end)
end

local function jumpHeld(humanoid: Humanoid): boolean
	if UserInputService:GetFocusedTextBox() then
		return false
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.Space) or UserInputService:IsGamepadButtonDown(Enum.UserInputType.Gamepad1, Enum.KeyCode.ButtonA) then
		return true
	end
	-- Phones: the jump button itself, or the Jump flag Roblox's controls keep on while it's held.
	if touchJumpHeld or humanoid.Jump then
		return true
	end
	-- Anything else: JumpRequest repeating while jump is held.
	return os.clock() - lastJumpRequest &lt; HOLD_WINDOW
end

-- A stream of real 3D bubbles pouring out under the character (see Bubbles).
local function emitJet(root: BasePart, dt: number)
	emitAccumulator += dt * BUBBLES_PER_SECOND
	local n = math.floor(emitAccumulator)
	if n &lt;= 0 then
		return
	end
	emitAccumulator -= n
	local v = root.AssemblyLinearVelocity
	Bubbles.Emit(root.Position - Vector3.new(0, 2.6, 0) - root.CFrame.LookVector * 0.6, {
		Count = n,
		Spread = 0.45,
		Velocity = Vector3.new(v.X * 0.25, -9, v.Z * 0.25),
		Jitter = 2.2,
		Size = { 0.35, 1.0 },
		Life = { 0.8, 1.5 },
		Rise = 4,
	})
end

local function setFuel(value: number?)
	-- Only write the attribute when the shown value changes (the HUD listens to it).
	if value == nil then
		if lastFuelShown ~= nil then
			lastFuelShown = nil
			player:SetAttribute("JetFuel", nil)
		end
		return
	end
	local rounded = math.floor(value * 50 + 0.5) / 50
	if rounded ~= lastFuelShown then
		lastFuelShown = rounded
		player:SetAttribute("JetFuel", rounded)
	end
end

local function step(dt: number)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not ClientState.InRun() or not humanoid or not root or not root:IsA("BasePart") or humanoid.Health &lt;= 0 then
		fuel = FUEL_SECONDS
		emitAccumulator = 0
		setFuel(nil)
		return
	end

	local airborne = humanoid.FloorMaterial == Enum.Material.Air
	local jetting = airborne and jumpHeld(humanoid) and fuel &gt; 0
	if jetting then
		fuel = math.max(0, fuel - dt)
		-- Ease up to the climb speed (a smooth lift-off rather than a snap).
		local v = root.AssemblyLinearVelocity
		local vy = if v.Y &lt; RISE_SPEED then v.Y + (RISE_SPEED - v.Y) * math.min(1, 12 * dt) else v.Y
		root.AssemblyLinearVelocity = Vector3.new(v.X, vy, v.Z)
	elseif not airborne then
		fuel = math.min(FUEL_SECONDS, fuel + REFILL_PER_SECOND * dt)
	end
	if jetting then
		emitJet(root, dt)
	else
		emitAccumulator = 0
	end
	setFuel(fuel / FUEL_SECONDS)
end

function BubbleJets.Init()
	if initialized then
		return
	end
	initialized = true
	UserInputService.JumpRequest:Connect(function()
		lastJumpRequest = os.clock()
	end)
	task.spawn(watchTouchJump)
	RunService.Heartbeat:Connect(function(dt)
		local ok, err = pcall(step, dt)
		if not ok then
			warn("[BubbleJets] " .. tostring(err))
		end
	end)
end

return BubbleJets</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000002D"><Properties><string name="Name">Bubbles</string><ProtectedString name="Source">-- Bubbles: pooled, client-only 3D soap bubbles. Every bubble is an anchored ForceField sphere (the
-- shimmering, see-through film with a bright rim) plus a tiny glowing glint that always sits on
-- the camera-facing, upper-left side, like a real reflection.
--
-- A bubble pops in (grows from nothing), drifts upward with a gentle wobble, slows with drag, and
-- pops (a quick swell and vanish) at the end of its life. Nothing is physics-simulated or
-- replicated: one RenderStepped loop moves the whole pool with BulkMoveTo, so hundreds of bubbles
-- cost almost nothing and never fall like rocks.
--
-- Bubbles.Emit(position, options?) with options:
--   Count (1), Spread (radius, 0.5), Velocity (Vector3, (0, 3, 0)), Jitter (random speed added, 1.5),
--   Size ({ min, max }, { 0.35, 0.9 }), Life ({ min, max }, { 1.6, 2.8 }), Rise (buoyancy, 2.5)

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Bubbles = {}

local POOL_SIZE = 200
local GROW_TIME = 0.14
local POP_TIME = 0.1
local DRAG = 1.6

local TINTS = {
	Color3.fromRGB(165, 225, 255),
	Color3.fromRGB(255, 195, 238),
	Color3.fromRGB(200, 255, 232),
	Color3.fromRGB(226, 208, 255),
	Color3.fromRGB(255, 240, 190),
}

type Bubble = {
	Shell: Part,
	Glint: Part,
	Active: boolean,
	Pos: Vector3,
	Vel: Vector3,
	Age: number,
	Life: number,
	Size: number,
	Rise: number,
	Phase: number,
	Wobble: number,
	ShownSize: number,
	Poppable: boolean,
}

local pool: { Bubble } = {}
local cursor = 0
local folder: Folder? = nil
local initialized = false
local FAR = CFrame.new(0, -10000, 0)

local function newPart(name: string): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Shape = Enum.PartType.Ball
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Size = Vector3.one * 0.2
	p.CFrame = FAR
	p.Transparency = 1
	return p
end

local function ensurePool()
	if folder and folder.Parent then
		return
	end
	local f = Instance.new("Folder")
	f.Name = "ClientBubbles"
	f.Parent = workspace
	folder = f
	table.clear(pool)
	for i = 1, POOL_SIZE do
		local shell = newPart("Bubble")
		shell.Material = Enum.Material.ForceField
		local glint = newPart("Glint")
		glint.Material = Enum.Material.Neon
		glint.Color = Color3.new(1, 1, 1)
		shell.Parent = f
		glint.Parent = f
		pool[i] = {
			Shell = shell,
			Glint = glint,
			Active = false,
			Poppable = false,
			Pos = Vector3.zero,
			Vel = Vector3.zero,
			Age = 0,
			Life = 1,
			Size = 1,
			Rise = 2.5,
			Phase = 0,
			Wobble = 0,
			ShownSize = 0,
		}
	end
end

local function hide(b: Bubble)
	b.Active = false
	b.Shell.Transparency = 1
	b.Glint.Transparency = 1
	b.Shell.CFrame = FAR
	b.Glint.CFrame = FAR
end

local function range(r: { number }?, default: { number }): number
	local t = r or default
	return t[1] + math.random() * (t[2] - t[1])
end

function Bubbles.Emit(position: Vector3, options: { [string]: any }?)
	ensurePool()
	local o = options or {}
	local count = math.clamp(math.floor(tonumber(o.Count) or 1), 1, 40)
	local spread = tonumber(o.Spread) or 0.5
	local velocity: Vector3 = if typeof(o.Velocity) == "Vector3" then o.Velocity else Vector3.new(0, 3, 0)
	local jitter = tonumber(o.Jitter) or 1.5
	for _ = 1, count do
		cursor = cursor % POOL_SIZE + 1
		local b = pool[cursor] -- the oldest slot gets recycled when the pool is full
		local offset = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 2 * spread
		b.Active = true
		b.Pos = position + offset
		b.Vel = velocity + Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 2 * jitter
		b.Age = 0
		b.Life = range(o.Life, { 1.6, 2.8 })
		b.Size = range(o.Size, { 0.35, 0.9 })
		b.Rise = tonumber(o.Rise) or 2.5
		b.Phase = math.random() * math.pi * 2
		b.Wobble = 0.25 + math.random() * 0.35
		b.ShownSize = -1
		b.Poppable = o.Poppable == true -- pops early when your character touches it
		b.Shell.Color = TINTS[math.random(1, #TINTS)]
		b.Shell.Transparency = 0
		b.Glint.Transparency = 0.15
	end
end

local moveParts: { BasePart } = {}
local moveCFrames: { CFrame } = {}

local function step(dt: number)
	if not folder then
		return
	end
	local camera = workspace.CurrentCamera
	local camCF = if camera then camera.CFrame else CFrame.identity
	table.clear(moveParts)
	table.clear(moveCFrames)
	local character = Players.LocalPlayer and Players.LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local rootPos = if root and root:IsA("BasePart") then root.Position else nil
	for _, b in pool do
		if not b.Active then
			continue
		end
		b.Age += dt
		-- Touched by your character (anywhere from feet to head): pop now.
		if b.Poppable and rootPos and b.Age &lt; b.Life then
			local d = b.Pos - rootPos
			if math.abs(d.Y) &lt; 3.5 + b.Size / 2 and Vector2.new(d.X, d.Z).Magnitude &lt; 1.6 + b.Size / 2 then
				b.Life = b.Age
				b.Poppable = false
			end
		end
		if b.Age &gt;= b.Life + POP_TIME then
			hide(b)
			continue
		end
		-- Motion: drag, buoyancy, and a sideways wobble.
		b.Vel = b.Vel * math.max(0, 1 - DRAG * dt) + Vector3.new(0, b.Rise * dt, 0)
		b.Pos += b.Vel * dt
		local t = b.Age * 2.2 + b.Phase
		local pos = b.Pos + Vector3.new(math.sin(t) * b.Wobble, 0, math.cos(t * 0.8) * b.Wobble)

		-- Size: pop in, hold with a faint breathing wobble, then swell and vanish.
		local size
		if b.Age &lt; GROW_TIME then
			size = b.Size * (b.Age / GROW_TIME)
		elseif b.Age &gt; b.Life then
			local k = (b.Age - b.Life) / POP_TIME
			size = b.Size * (1 + 0.35 * k)
			b.Shell.Transparency = k
			b.Glint.Transparency = 0.15 + 0.85 * k
		else
			size = b.Size * (1 + 0.04 * math.sin(t * 3))
		end
		size = math.max(size, 0.05)
		if math.abs(size - b.ShownSize) &gt; 0.01 then
			b.ShownSize = size
			b.Shell.Size = Vector3.one * size
			b.Glint.Size = Vector3.one * math.max(size * 0.2, 0.05)
		end
		-- Glint on the camera-facing, upper-left side of the film.
		local toCam = (camCF.Position - pos)
		toCam = if toCam.Magnitude &gt; 1e-3 then toCam.Unit else Vector3.zAxis
		local glintPos = pos + (toCam * 0.3 + camCF.UpVector * 0.25 - camCF.RightVector * 0.22) * size
		table.insert(moveParts, b.Shell)
		table.insert(moveCFrames, CFrame.new(pos))
		table.insert(moveParts, b.Glint)
		table.insert(moveCFrames, CFrame.new(glintPos))
	end
	if #moveParts &gt; 0 then
		workspace:BulkMoveTo(moveParts, moveCFrames, Enum.BulkMoveMode.FireCFrameChanged)
	end
end

function Bubbles.Init()
	if initialized then
		return
	end
	initialized = true
	ensurePool()
	RunService.RenderStepped:Connect(function(dt)
		local ok, err = pcall(step, math.min(dt, 0.1))
		if not ok then
			warn("[Bubbles] " .. tostring(err))
		end
	end)
end

return Bubbles</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000002E"><Properties><string name="Name">Celebrate</string><ProtectedString name="Source">--[[
	Celebrate - the big "congrats" popup with confetti: a gift you sent or got (game passes, a rank
	from an admin). The server sends ("Celebrate", title, text, icon); popups that arrive together
	are shown one after another.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))

local Client = script.Parent
local UIKit = require(Client:WaitForChild("UIKit"))

local Celebrate = {}

local Colors = UIKit.Theme.Colors

local initialized = false
local queue: { { Title: string, Text: string, Icon: string } } = {}
local showing = false

local titleLabel: TextLabel
local textLabel: TextLabel
local iconLabel: TextLabel
local iconArt: Frame? = nil

local showNext: () -&gt; ()

showNext = function()
	local item = table.remove(queue, 1)
	if not item then
		showing = false
		return
	end
	showing = true
	titleLabel.Text = item.Title
	textLabel.Text = item.Text
	-- "@Gift" etc. are the game's drawn icons (IconArt); anything else is an emoji.
	if iconArt then
		iconArt:Destroy()
		iconArt = nil
	end
	local kind = string.match(item.Icon, "^@(%a+)$")
	if kind then
		iconLabel.Text = ""
		local art = UIKit.Icon(kind, 64)
		art.AnchorPoint = Vector2.new(0.5, 0.5)
		art.Position = UDim2.fromScale(0.5, 0.5)
		art.Parent = iconLabel
		iconArt = art
	else
		iconLabel.Text = item.Icon
	end
	UIKit.OpenWindow("Celebrate")
	UIKit.Confetti()
end

-- Shows a popup now (or after the ones already waiting).
function Celebrate.Show(title: string, text: string, icon: string?)
	table.insert(queue, { Title = tostring(title), Text = tostring(text), Icon = if icon and icon ~= "" then icon else "🎁" })
	if not showing then
		showNext()
	end
end

function Celebrate.Init()
	if initialized then
		return
	end
	initialized = true

	local _gui, root = UIKit.CreateScreen("Celebrate", 30)
	local _window, content = UIKit.Window({
		Name = "Celebrate",
		Title = "Congrats!",
		Icon = "🎉",
		Size = Vector2.new(480, 330),
		Parent = root,
	})
	iconLabel = UIKit.Label({
		Text = "🎁",
		TextSize = 64,
		Stroke = false,
		Size = UDim2.new(1, 0, 0, 76),
		Parent = content,
	})
	titleLabel = UIKit.Label({
		Text = "",
		TextSize = 30,
		TextColor3 = Colors.Warning,
		TextScaled = true,
		Position = UDim2.fromOffset(0, 78),
		Size = UDim2.new(1, 0, 0, 38),
		Parent = content,
	})
	textLabel = UIKit.Label({
		Text = "",
		TextSize = 20,
		TextWrapped = true,
		TextScaled = true,
		Position = UDim2.fromOffset(10, 120),
		Size = UDim2.new(1, -20, 0, 50),
		Parent = content,
	})
	UIKit.Button({
		Text = "Awesome!",
		Color = Colors.Good,
		TextSize = 24,
		Size = UDim2.fromOffset(220, 52),
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -4),
		Parent = content,
		OnClick = function()
			UIKit.CloseWindow()
		end,
	})
	UIKit.RegisterWindow("Celebrate", {
		Open = function() end,
		Close = function()
			task.delay(0.3, showNext)
		end,
	})

	Remotes.Event("Celebrate").OnClientEvent:Connect(function(title, text, icon)
		Celebrate.Show(title, text, icon)
	end)
end

return Celebrate</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000002F"><Properties><string name="Name">ChatNames</string><ProtectedString name="Source">--[[
	ChatNames - VIPs get a gold [VIP] tag before their name in the chat, "[VIP] Klushy: hi" (their
	overhead name has the same tag; see NameTags). Staff get [MOD] / [ADMIN] / [DEV] / [OWNER]
	instead (player attribute StaffTag, set by AdminServer).

	The server sets Player.VIP (attribute) from the VIP game pass; this client adds the tag to the
	prefix of every message from a VIP. TextChatService.OnIncomingMessage is a single callback, so
	this is the only place that sets it.
]]

local Players = game:GetService("Players")
local TextChatService = game:GetService("TextChatService")

local ChatNames = {}

local GOLD_HEX = "#FFD24A"
-- Staff get their rank's tag instead: [MOD] green, [ADMIN] red, [DEV] blue, [OWNER] purple.
local STAFF_HEX = { MOD = "#50DC64", ADMIN = "#FF4B4B", DEV = "#50A0FF", OWNER = "#B964FF" }
local initialized = false

function ChatNames.Init()
	if initialized then
		return
	end
	initialized = true
	-- Chat bubbles float above the overhead name tag (NameTags: 2.1 studs up, 1.9 tall) instead of
	-- covering it.
	pcall(function()
		local bubbles = TextChatService:FindFirstChildOfClass("BubbleChatConfiguration")
			or TextChatService:WaitForChild("BubbleChatConfiguration", 10)
		if bubbles then
			(bubbles :: any).VerticalStudsOffset = 2.4
		end
	end)
	TextChatService.OnIncomingMessage = function(message: TextChatMessage)
		local props = Instance.new("TextChatMessageProperties")
		local source = message.TextSource
		local player = source and Players:GetPlayerByUserId(source.UserId)
		local staff = player and player:GetAttribute("StaffTag")
		local staffHex = type(staff) == "string" and STAFF_HEX[staff]
		if staffHex and message.PrefixText ~= "" then
			props.PrefixText = string.format('&lt;font color="%s"&gt;&lt;b&gt;[%s]&lt;/b&gt;&lt;/font&gt; %s', staffHex, staff, message.PrefixText)
		elseif player and player:GetAttribute("VIP") == true and message.PrefixText ~= "" then
			props.PrefixText = string.format('&lt;font color="%s"&gt;&lt;b&gt;[VIP]&lt;/b&gt;&lt;/font&gt; %s', GOLD_HEX, message.PrefixText)
		end
		return props
	end
end

return ChatNames</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000030"><Properties><string name="Name">ChestUI</string><ProtectedString name="Source">--[[
	ChestUI - the Treasure Chest event, played at the chest itself (LobbyBuilder's "EventChest").

	  * Above the chest: a board with every reward and its exact chance, and "1 FREE CHEST!" while
	    you still have your free one.
	  * Walk up to it and the Open boxes come up at the bottom of the screen: OPEN 1 (FREE, or 49 R$),
	    OPEN 3 and OPEN 10. They're priced like cinema popcorn: x3 is barely cheaper per chest (and
	    looks it, small and grey), x10 is the big gold BEST VALUE. E opens one.
	  * Opening: the lid flies open and a card spins for every chest, slowing down until it lands on
	    what you got (like a rank roll), rarest last with confetti.
	  * The HUD's Event button (and E anywhere else in the lobby) takes you to the chest.

	Free chests ask EventService (ChestRequest "Free"); bought packs open on the server when Roblox
	confirms the purchase, and the results arrive on ChestResult. Studio: packs without a product
	ID open for free (ChestRequest "Test").
]]

local CollectionService = game:GetService("CollectionService")
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local Client = script.Parent
local ClientState = require(Client:WaitForChild("ClientState"))
local UIKit = require(Client:WaitForChild("UIKit"))

local ChestUI = {}

local Colors = UIKit.Theme.Colors
local LocalPlayer = Players.LocalPlayer

local DEFAULT_ZONE = 11 -- studs: the glowing ring around the chest (the model's ZoneRadius attribute)
local CARD_W, CARD_H = 150, 180

local initialized = false
local busy = false
local revealing = false
local near = false
local promptsShown = 0
local panel: Frame
local firstLabel: TextLabel
local firstPrice: TextLabel
local firstButton: TextButton
local freeSign: TextLabel? = nil
local reveal: Frame
local revealGrid: Frame
local revealTitle: TextLabel
local revealDone: TextButton

----------------------------------------------------------------------------------------------------
-- Rewards: how each one looks
----------------------------------------------------------------------------------------------------

local function rewardColor(r: any): Color3
	if r.Kind == "Bubbles" then
		return Colors.Bubble
	elseif r.Kind == "Gems" then
		return Colors.Primary
	elseif r.Kind == "Boost" then
		return Colors.Good
	elseif r.Kind == "Pet" then
		if (r.Tier or 1) &gt; 1 then
			return Config.PetTiers[r.Tier].Color or Colors.Coin
		end
		local pet = Config.Pets[r.Pet]
		local rarity = pet and Config.Rarities[pet.Rarity]
		return if rarity then rarity.Color else Colors.Accent
	end
	return Colors.Coin
end

local function rewardIcon(r: any): string
	if r.Kind == "Bubbles" then
		return "Bubble"
	elseif r.Kind == "Gems" then
		return "Gem"
	elseif r.Kind == "Boost" then
		return "Drop"
	elseif r.Kind == "Pet" then
		return "Paw"
	end
	return "Crown"
end

-- How rare a reward feels, from its chance.
local function tierOf(r: any): (string, number)
	if r.Chance &lt; 1 then
		return "LEGENDARY", 4
	elseif r.Chance &lt; 5 then
		return "EPIC", 3
	elseif r.Chance &lt; 15 then
		return "RARE", 2
	end
	return "COMMON", 1
end

local function pctText(chance: number): string
	return if chance &lt; 1 then string.format("%.1f%%", chance) else string.format("%g%%", chance)
end

----------------------------------------------------------------------------------------------------
-- The chest in the world
----------------------------------------------------------------------------------------------------

local function chestModel(): Model?
	for _, m in CollectionService:GetTagged("EventChest") do
		if m:IsA("Model") and m:IsDescendantOf(workspace) then
			return m
		end
	end
	return nil
end

local function chestPivot(): CFrame?
	local model = chestModel()
	local box = model and model.PrimaryPart
	return if box then box.CFrame else nil
end

-- The odds board and the free sign above the chest (built here, so each player sees their own).
local function buildBoard(model: Model): boolean
	local box = model.PrimaryPart
	if not box or freeSign ~= nil then
		return false
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "OddsBoard"
	gui.Adornee = box
	gui.Size = UDim2.fromScale(10, 9)
	gui.StudsOffsetWorldSpace = Vector3.new(0, 11, 0) -- well above the lid, under the title sign
	gui.MaxDistance = 70
	gui.LightInfluence = 0
	gui.ResetOnSpawn = false
	local list = Instance.new("Frame")
	list.BackgroundColor3 = Colors.PanelDark
	list.BackgroundTransparency = 0.15
	list.Size = UDim2.fromScale(1, 0.84)
	list.Position = UDim2.fromScale(0, 0.16)
	UIKit.Corner(list, 14)
	list.Parent = gui
	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0.01, 0)
	layout.Parent = list
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0.03, 0)
	pad.PaddingLeft = UDim.new(0.04, 0)
	pad.PaddingRight = UDim.new(0.04, 0)
	pad.Parent = list
	local count = #Config.ChestEvent.Rewards
	for i, r in Config.ChestEvent.Rewards do
		local row = Instance.new("Frame")
		row.BackgroundTransparency = 1
		row.Size = UDim2.fromScale(1, 0.94 / count - 0.01)
		row.LayoutOrder = i
		row.Parent = list
		local name = UIKit.Label({ Text = Config.ChestRewardName(r), TextScaled = true, TextColor3 = rewardColor(r), TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.fromScale(0.74, 1), Parent = row })
		local _ = name
		UIKit.Label({ Text = pctText(r.Chance), TextScaled = true, TextXAlignment = Enum.TextXAlignment.Right, Position = UDim2.fromScale(0.74, 0), Size = UDim2.fromScale(0.26, 1), Parent = row })
	end
	freeSign = UIKit.Label({ Name = "FreeSign", Text = "1 FREE CHEST!", TextScaled = true, TextColor3 = Colors.Good, Size = UDim2.fromScale(1, 0.14), Parent = gui })
	gui.Parent = LocalPlayer:WaitForChild("PlayerGui")
	return true
end

-- Lid open / shut (client only, just for looks). Lid parts turn about the back hinge.
local lidHome: { [BasePart]: CFrame } = {}
local function setLid(open: boolean)
	local model = chestModel()
	local box = model and model.PrimaryPart
	if not model or not box then
		return
	end
	local hinge = box.CFrame * CFrame.new(0, box.Size.Y / 2, box.Size.Z / 2)
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") and (CollectionService:HasTag(part, "EventChestLid") or part:GetAttribute("LidPart")) then
			lidHome[part] = lidHome[part] or part.CFrame
			local home = lidHome[part]
			local target = if open then hinge * CFrame.Angles(math.rad(-105), 0, 0) * hinge:Inverse() * home else home
			TweenService:Create(part, TweenInfo.new(if open then 0.35 else 0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { CFrame = target }):Play()
		end
	end
end

function ChestUI.GoToChest()
	local pivot = chestPivot()
	local character = LocalPlayer.Character
	if not pivot or not character or ClientState.Run ~= nil then
		if not pivot then
			UIKit.Toast("The Treasure Chest event isn't on right now.", "Info")
		end
		return
	end
	-- In front of the lock, looking at the chest.
	local spot = (pivot * CFrame.new(0, 1, -10)).Position
	character:PivotTo(CFrame.lookAt(spot, Vector3.new(pivot.Position.X, spot.Y, pivot.Position.Z)))
end

----------------------------------------------------------------------------------------------------
-- Reveal: one spinning card per chest
----------------------------------------------------------------------------------------------------

local function paintCard(card: Frame, r: any, landed: boolean)
	local color = rewardColor(r)
	card.BackgroundColor3 = UIKit.Darken(color, 0.55)
	local stroke = card:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Color = color
	end
	local holder = card:FindFirstChild("IconHolder") :: Frame
	for _, c in holder:GetChildren() do
		c:Destroy()
	end
	local icon = UIKit.Icon(rewardIcon(r), 64, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5) })
	icon.Parent = holder
	local name = card:FindFirstChild("RewardName") :: TextLabel
	name.Text = Config.ChestRewardName(r)
	name.TextColor3 = color
	local tierLabel = card:FindFirstChild("Tier") :: TextLabel
	local limitedPet = r.Kind == "Pet" and Config.Pets[r.Pet] ~= nil and Config.Pets[r.Pet].Limited ~= nil
	tierLabel.Text = if landed then (if limitedPet then "LIMITED PET" else (tierOf(r))) else ""
	tierLabel.TextColor3 = color
end

local function makeCard(i: number): Frame
	local card = Instance.new("Frame")
	card.Name = "Card" .. i
	card.LayoutOrder = i
	card.BackgroundColor3 = Colors.PanelLight
	UIKit.Corner(card, 14)
	UIKit.Stroke(card, Colors.Coin, 3, 0)
	local holder = Instance.new("Frame")
	holder.Name = "IconHolder"
	holder.BackgroundTransparency = 1
	holder.Position = UDim2.fromScale(0, 0.12)
	holder.Size = UDim2.fromScale(1, 0.5)
	holder.Parent = card
	UIKit.Label({ Name = "Tier", Text = "", TextSize = 14, Position = UDim2.fromScale(0, 0.02), Size = UDim2.fromScale(1, 0.12), Parent = card })
	UIKit.Label({ Name = "RewardName", Text = "", TextScaled = true, TextWrapped = true, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -6), Size = UDim2.new(1, -10, 0.3, 0), Parent = card })
	local scale = Instance.new("UIScale")
	scale.Name = "Pop"
	scale.Parent = card
	return card
end

-- Picks a random reward by weight, for the spinning faces.
local function randomReward(): any
	local x = math.random() * 100
	for _, r in Config.ChestEvent.Rewards do
		x -= r.Chance
		if x &lt;= 0 then
			return r
		end
	end
	return Config.ChestEvent.Rewards[1]
end

local function showResults(results: { any })
	if type(results) ~= "table" or #results == 0 then
		return
	end
	revealing = true
	panel.Visible = false
	for _, c in revealGrid:GetChildren() do
		if c:IsA("GuiObject") then
			c:Destroy()
		end
	end
	local count = #results
	local layout = revealGrid:FindFirstChildOfClass("UIGridLayout") :: UIGridLayout
	local scale = if count == 1 then 1.35 elseif count &lt;= 3 then 1.1 else 0.8
	layout.CellSize = UDim2.fromOffset(math.floor(CARD_W * scale), math.floor(CARD_H * scale))
	revealTitle.Text = if count == 1 then "OPENING..." else string.format("OPENING %d CHESTS...", count)
	revealDone.Visible = false
	reveal.Visible = true
	UIKit.Bounce(reveal)
	setLid(true)
	UIKit.PlaySound("Sparkle")

	-- Land the rarest last, so the best moment comes at the end.
	local order = {}
	for i, res in results do
		local def = Config.ChestEvent.Rewards[tonumber(res.Index) or 0] or Config.ChestEvent.Rewards[1]
		table.insert(order, { Def = def, Text = res.Text, I = i })
	end
	local cards = {}
	for i = 1, count do
		local card = makeCard(i)
		card.Parent = revealGrid
		paintCard(card, randomReward(), false)
		cards[i] = card
	end
	local landOrder = table.clone(order)
	table.sort(landOrder, function(a, b)
		local ta, tb = select(2, tierOf(a.Def)), select(2, tierOf(b.Def))
		if ta ~= tb then
			return ta &lt; tb
		end
		return a.I &lt; b.I
	end)
	local landAt: { [number]: number } = {}
	local start = os.clock()
	local spinFor = if count == 1 then 2.4 else 1.6
	local step = if count == 1 then 0 else math.min(0.22, 1.6 / count)
	for k, entry in landOrder do
		landAt[entry.I] = spinFor + (k - 1) * step
	end
	local nextFlip: { [number]: number } = {}
	local landed: { [number]: boolean } = {}
	local best = 0
	while true do
		local t = os.clock() - start
		local all = true
		for i, card in cards do
			if not landed[i] then
				all = false
				local left = landAt[i] - t
				if left &lt;= 0 then
					landed[i] = true
					local entry = order[i]
					paintCard(card, entry.Def, true)
					local nameLabel = card:FindFirstChild("RewardName") :: TextLabel
					nameLabel.Text = tostring(entry.Text)
					local pop = card:FindFirstChild("Pop") :: UIScale
					pop.Scale = 1.25
					TweenService:Create(pop, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
					local tier = select(2, tierOf(entry.Def))
					best = math.max(best, tier)
					UIKit.PlaySound(if tier &gt;= 3 then "Sparkle" else "Pop", 0.9 + tier * 0.1)
					if tier &gt;= 3 then
						UIKit.Confetti(if tier &gt;= 4 then 140 else 70)
					end
				elseif t &gt;= (nextFlip[i] or 0) then
					-- Faster at first, slowing right down as it lands.
					local gap = 0.05 + 0.3 * math.clamp(1 - left / 1.2, 0, 1) ^ 2
					nextFlip[i] = t + gap
					paintCard(card, randomReward(), false)
					UIKit.PlaySound("Click", 1.4)
				end
			end
		end
		if all then
			break
		end
		RunService.RenderStepped:Wait()
	end
	revealTitle.Text = if best &gt;= 4 then "JACKPOT!" elseif best &gt;= 3 then "AMAZING!" else "YOU GOT"
	revealDone.Visible = true
	UIKit.Bounce(revealDone)
end

local function finishReveal()
	reveal.Visible = false
	revealing = false
	setLid(false)
end

----------------------------------------------------------------------------------------------------
-- Opening
----------------------------------------------------------------------------------------------------

local function freeLeft(): number
	local meta = ClientState.Meta :: any
	return if meta then tonumber(meta.ChestFreeLeft) or 0 else 0
end

local function request(action: string, value: any?)
	if busy or revealing then
		return
	end
	busy = true
	local ok, result = pcall(function()
		return Remotes.Function("ChestRequest"):InvokeServer(action, value)
	end)
	busy = false
	if ok and result and result.Ok then
		task.spawn(showResults, result.Rewards)
	else
		UIKit.Toast(if ok and result then result.Error or "Couldn't open that." else "Couldn't open that.", "Info")
	end
end

function ChestUI.Open(count: number)
	if busy or revealing then
		return
	end
	if count == 1 and freeLeft() &gt; 0 then
		task.spawn(request, "Free")
		return
	end
	for _, pack in Config.ChestEvent.Packs do
		if pack.Count == count then
			local id = Config.EventProducts[pack.Key]
			if type(id) == "number" and id &gt; 0 then
				pcall(function()
					MarketplaceService:PromptProductPurchase(LocalPlayer, id)
				end)
			else
				task.spawn(request, "Test", pack.Count) -- Studio: free test
			end
			return
		end
	end
end

----------------------------------------------------------------------------------------------------
-- The Open boxes
----------------------------------------------------------------------------------------------------

-- style: "plain", "decoy" (the x3: small and grey on purpose) or "best" (the big gold x10).
local function openBox(parent: Frame, pack: any, style: string, order: number): (TextButton, TextLabel, TextLabel)
	local base = Config.ChestEvent.Packs[1]
	local each = pack.Price / pack.Count
	local save = math.floor((1 - each / (base.Price / base.Count)) * 100 + 0.5)
	local w, h = if style == "best" then 200 elseif style == "decoy" then 128 else 150, if style == "best" then 132 elseif style == "decoy" then 96 else 112
	local color = if style == "best" then Colors.Coin elseif style == "decoy" then Colors.Disabled else Colors.Primary
	local button = Instance.new("TextButton")
	button.Name = "Open" .. pack.Count
	button.Text = ""
	button.AutoButtonColor = false
	button.LayoutOrder = order
	button.Size = UDim2.fromOffset(w, h)
	button.BackgroundColor3 = if style == "best" then UIKit.Darken(Colors.Coin, 0.45) else Colors.PanelDark
	UIKit.Corner(button, 16)
	UIKit.Stroke(button, color, if style == "best" then 4 else 3, 0)
	local title = UIKit.Label({
		Name = "Title",
		Text = string.format("OPEN %d", pack.Count),
		TextSize = if style == "best" then 30 elseif style == "decoy" then 18 else 24,
		TextColor3 = if style == "decoy" then Colors.TextDim else Colors.Text,
		Position = UDim2.fromScale(0, 0.08),
		Size = UDim2.fromScale(1, 0.32),
		Parent = button,
	})
	local price = UIKit.Label({
		Name = "Price",
		Text = string.format("R$ %d", pack.Price),
		TextSize = if style == "best" then 28 elseif style == "decoy" then 16 else 22,
		TextColor3 = if style == "best" then Colors.Good elseif style == "decoy" then Colors.TextDim else Colors.Coin,
		Position = UDim2.fromScale(0, 0.4),
		Size = UDim2.fromScale(1, 0.3),
		Parent = button,
	})
	UIKit.Label({
		Name = "Each",
		Text = if save &gt; 0 then string.format("%d each, save %d%%", math.floor(each + 0.5), save) else "per chest",
		TextSize = if style == "best" then 15 else 12,
		TextColor3 = if style == "best" then Colors.Good else Colors.TextDim,
		Position = UDim2.fromScale(0, 0.72),
		Size = UDim2.fromScale(1, 0.2),
		Parent = button,
	})
	if pack.Tag then
		local ribbon = Instance.new("Frame")
		ribbon.Name = "Ribbon"
		ribbon.AnchorPoint = Vector2.new(0.5, 0.5)
		ribbon.Position = UDim2.fromScale(0.5, 0)
		ribbon.Size = UDim2.fromOffset(w - 30, 28)
		ribbon.BackgroundColor3 = Colors.Bad
		ribbon.ZIndex = 3
		UIKit.Corner(ribbon, 14)
		UIKit.Stroke(ribbon, Colors.Ink, 2)
		UIKit.Label({ Text = pack.Tag, TextSize = 16, Size = UDim2.fromScale(1, 1), ZIndex = 4, Parent = ribbon })
		ribbon.Parent = button
		local pulse = Instance.new("UIScale")
		pulse.Parent = button
		TweenService:Create(pulse, TweenInfo.new(0.7, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Scale = 1.05 }):Play()
	end
	button.Activated:Connect(function()
		UIKit.PlaySound("Click")
		ChestUI.Open(pack.Count)
	end)
	button.Parent = parent
	return button, title, price
end

local function refresh()
	local free = freeLeft()
	local packOne = Config.ChestEvent.Packs[1]
	if free &gt; 0 then
		firstLabel.Text = "OPEN 1"
		firstPrice.Text = "FREE!"
		firstPrice.TextColor3 = Colors.Good
	else
		firstLabel.Text = "OPEN 1"
		firstPrice.Text = string.format("R$ %d", packOne.Price)
		firstPrice.TextColor3 = Colors.Coin
	end
	local each = firstButton:FindFirstChild("Each")
	if each and each:IsA("TextLabel") then
		each.Visible = free &lt;= 0
	end
	local stroke = firstButton:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Color = if free &gt; 0 then Colors.Good else Colors.Primary
	end
	if freeSign then
		(freeSign :: TextLabel).Visible = free &gt; 0
	end
end

function ChestUI.Init()
	if initialized then
		return
	end
	initialized = true

	local _gui, root = UIKit.CreateScreen("ChestUI", 9)
	panel = Instance.new("Frame")
	panel.Name = "OpenBoxes"
	panel.AnchorPoint = Vector2.new(0.5, 1)
	panel.Position = UDim2.new(0.5, 0, 1, -24)
	panel.Size = UDim2.fromOffset(520, 150)
	panel.BackgroundTransparency = 1
	panel.Visible = false
	panel.Parent = root
	local row = Instance.new("UIListLayout")
	row.FillDirection = Enum.FillDirection.Horizontal
	row.HorizontalAlignment = Enum.HorizontalAlignment.Center
	row.VerticalAlignment = Enum.VerticalAlignment.Bottom
	row.Padding = UDim.new(0, 14)
	row.SortOrder = Enum.SortOrder.LayoutOrder
	row.Parent = panel
	local packs = Config.ChestEvent.Packs
	firstButton, firstLabel, firstPrice = openBox(panel, packs[1], "plain", 1)
	-- The E hint on the first box.
	local hint = Instance.new("Frame")
	hint.Name = "KeyHint"
	hint.Position = UDim2.fromOffset(-8, -8)
	hint.Size = UDim2.fromOffset(30, 28)
	hint.BackgroundColor3 = Colors.PanelDark
	hint.ZIndex = 5
	UIKit.Corner(hint, 8)
	UIKit.Stroke(hint, Colors.Ink, 2)
	UIKit.Label({ Text = "E", TextSize = 16, Size = UDim2.fromScale(1, 1), ZIndex = 6, Parent = hint })
	hint.Parent = firstButton
	openBox(panel, packs[2], "decoy", 2)
	openBox(panel, packs[3], "best", 3)

	-- The reveal (over everything).
	local _rgui, revealRoot = UIKit.CreateScreen("ChestReveal", 40)
	reveal = Instance.new("Frame")
	reveal.Name = "Reveal"
	reveal.AnchorPoint = Vector2.new(0.5, 0.5)
	reveal.Position = UDim2.fromScale(0.5, 0.5)
	reveal.Size = UDim2.fromOffset(860, 520)
	reveal.BackgroundColor3 = Colors.PanelDark
	reveal.BackgroundTransparency = 0.05
	reveal.Visible = false
	UIKit.Corner(reveal, 20)
	UIKit.Stroke(reveal, Colors.Coin, 4, 0)
	reveal.Parent = revealRoot
	revealTitle = UIKit.Label({ Text = "", TextSize = 38, TextColor3 = Colors.Coin, Position = UDim2.fromOffset(0, 12), Size = UDim2.new(1, 0, 0, 46), Parent = reveal })
	revealGrid = Instance.new("Frame")
	revealGrid.Name = "Grid"
	revealGrid.BackgroundTransparency = 1
	revealGrid.Position = UDim2.fromOffset(20, 66)
	revealGrid.Size = UDim2.new(1, -40, 1, -150)
	revealGrid.Parent = reveal
	local grid = Instance.new("UIGridLayout")
	grid.CellPadding = UDim2.fromOffset(12, 12)
	grid.HorizontalAlignment = Enum.HorizontalAlignment.Center
	grid.VerticalAlignment = Enum.VerticalAlignment.Center
	grid.SortOrder = Enum.SortOrder.LayoutOrder
	grid.Parent = revealGrid
	revealDone = UIKit.Button({
		Text = "AWESOME!",
		Color = Colors.Good,
		TextSize = 24,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -16),
		Size = UDim2.fromOffset(240, 56),
		Parent = reveal,
		OnClick = finishReveal,
	})

	ClientState.Changed:Connect(function(kind)
		if kind == "Meta" then
			refresh()
		end
	end)
	Remotes.Event("ChestResult").OnClientEvent:Connect(function(results)
		task.spawn(showResults, results)
	end)
	ProximityPromptService.PromptShown:Connect(function()
		promptsShown += 1
	end)
	ProximityPromptService.PromptHidden:Connect(function()
		promptsShown = math.max(0, promptsShown - 1)
	end)
	-- E: open one at the chest; anywhere else in the lobby, go to it. (Leaves E alone while
	-- another prompt is up or you're typing.)
	UserInputService.InputBegan:Connect(function(input, processed)
		if input.KeyCode ~= Enum.KeyCode.E or processed or UserInputService:GetFocusedTextBox() then
			return
		end
		if ClientState.Run ~= nil or promptsShown &gt; 0 or revealing or UIKit.IsWindowOpen() then
			return
		end
		if not Config.ChestEventLive() then
			return
		end
		if near then
			ChestUI.Open(1)
		else
			ChestUI.GoToChest()
		end
	end)

	-- Near the chest? Show the boxes. (Also builds the odds board once the chest has streamed in.)
	task.spawn(function()
		while true do
			local model = chestModel()
			if model and buildBoard(model) then
				refresh()
			end
			local pivot = chestPivot()
			local character = LocalPlayer.Character
			local rootPart = character and character:FindFirstChild("HumanoidRootPart")
			-- Inside the ring (flat distance from the chest), not just somewhere close by.
			local radius = (model and tonumber(model:GetAttribute("ZoneRadius"))) or DEFAULT_ZONE
			local isNear = pivot ~= nil
				and rootPart ~= nil
				and rootPart:IsA("BasePart")
				and ClientState.Run == nil
				and Vector3.new(rootPart.Position.X - pivot.Position.X, 0, rootPart.Position.Z - pivot.Position.Z).Magnitude &lt;= radius - 0.5
			if isNear ~= near then
				near = isNear
				refresh()
				if near and not revealing then
					panel.Visible = true
					UIKit.Bounce(panel)
				end
			end
			if not near then
				panel.Visible = false
			elseif not revealing then
				panel.Visible = not UIKit.IsWindowOpen()
			end
			task.wait(0.2)
		end
	end)
	refresh()
end

return ChestUI</ProtectedString></Properties></Item>
<Item class="LocalScript" referent="RBX00000031"><Properties><string name="Name">ClientMain</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Rinse Cycle client entry point. Starts the shared client state, then every UI / gameplay module.
-- Each module exposes Init(); anything that fails is reported without stopping the others.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local Client = script.Parent
local ClientState = require(Client:WaitForChild("ClientState"))
local UIKit = require(Client:WaitForChild("UIKit"))
local HUD = require(Client:WaitForChild("HUD"))
local PartyUI = require(Client:WaitForChild("PartyUI"))
local UpgradesUI = require(Client:WaitForChild("UpgradesUI"))
local ShopUI = require(Client:WaitForChild("ShopUI"))
local RanksUI = require(Client:WaitForChild("RanksUI"))
local RebirthUI = require(Client:WaitForChild("RebirthUI"))
local DailyUI = require(Client:WaitForChild("DailyUI"))
local RewardsUI = require(Client:WaitForChild("RewardsUI"))
local Cutscene = require(Client:WaitForChild("Cutscene"))
local PetsUI = require(Client:WaitForChild("PetsUI"))
local SprayController = require(Client:WaitForChild("SprayController"))
local PetRenderer = require(Client:WaitForChild("PetRenderer"))
local Effects = require(Client:WaitForChild("Effects"))
local BubbleJets = require(Client:WaitForChild("BubbleJets"))
local Bubbles = require(Client:WaitForChild("Bubbles"))
local HoldPose = require(Client:WaitForChild("HoldPose"))
local WaterFX = require(Client:WaitForChild("WaterFX"))
local LevelNPCs = require(Client:WaitForChild("LevelNPCs"))
local ChatNames = require(Client:WaitForChild("ChatNames"))
local Celebrate = require(Client:WaitForChild("Celebrate"))
local TradeUI = require(Client:WaitForChild("TradeUI"))
local StayOffer = require(Client:WaitForChild("StayOffer"))
local MusicPlayer = require(Client:WaitForChild("MusicPlayer"))
local BoardView = require(Client:WaitForChild("BoardView"))
local PollUI = require(Client:WaitForChild("PollUI"))
local ChestUI = require(Client:WaitForChild("ChestUI"))
local ClubsUI = require(Client:WaitForChild("ClubsUI"))
local EventZone = require(Client:WaitForChild("EventZone"))

local function step(name: string, fn: () -&gt; ())
	local ok, err = xpcall(fn, debug.traceback)
	if not ok then
		warn(string.format("[%s] client %s FAILED:\n%s", Config.GameName, name, tostring(err)))
	end
end

step("ClientState", ClientState.Init)
step("UIKit", UIKit.Init)

ClientState.Notified:Connect(function(text, kind)
	UIKit.Toast(text, kind)
end)

step("HUD", HUD.Init)
step("PartyUI", PartyUI.Init)
step("UpgradesUI", UpgradesUI.Init)
step("ShopUI", ShopUI.Init)
step("RanksUI", RanksUI.Init)
step("RebirthUI", RebirthUI.Init)
step("DailyUI", DailyUI.Init)
step("RewardsUI", RewardsUI.Init)
step("Cutscene", Cutscene.Init)
step("PetsUI", PetsUI.Init)
step("SprayController", SprayController.Init)
step("PetRenderer", PetRenderer.Init)
step("Bubbles", Bubbles.Init)
step("Effects", Effects.Init)
step("BubbleJets", BubbleJets.Init)
step("HoldPose", HoldPose.Init)
step("WaterFX", WaterFX.Init)
step("LevelNPCs", LevelNPCs.Init)
step("ChatNames", ChatNames.Init)
step("Celebrate", Celebrate.Init)
step("TradeUI", TradeUI.Init)
step("StayOffer", StayOffer.Init)
step("MusicPlayer", MusicPlayer.Init)
step("BoardView", BoardView.Init)
step("PollUI", PollUI.Init)
step("ChestUI", ChestUI.Init)
step("ClubsUI", ClubsUI.Init)
step("EventZone", EventZone.Init)</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000032"><Properties><string name="Name">ClientState</string><ProtectedString name="Source">-- The client's copy of everything the server tells it: permanent data (Meta), the party it is
-- waiting in (Party) and the run it is playing (Run). UI modules read from here and listen to
-- Changed instead of each hooking the remotes themselves.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared:WaitForChild("Remotes"))
local Util = require(Shared:WaitForChild("Util"))
local Types = require(Shared:WaitForChild("Types"))

local ClientState = {}

ClientState.Meta = nil :: Types.MetaState?
ClientState.Party = nil :: Types.PartyState?
ClientState.Run = nil :: Types.RunState?

-- Fired with "Meta", "Party" or "Run" after that field is replaced.
ClientState.Changed = Util.Signal.new()
-- Fired with (kind: string, data: table) for every RunFX message.
ClientState.FX = Util.Signal.new()
-- Fired with (text: string, kind: string) for every Notify message.
ClientState.Notified = Util.Signal.new()

local initialized = false

function ClientState.Init()
	if initialized then
		return
	end
	initialized = true

	Remotes.Event("MetaState").OnClientEvent:Connect(function(state)
		ClientState.Meta = state
		ClientState.Changed:Fire("Meta")
	end)
	Remotes.Event("PartyState").OnClientEvent:Connect(function(state)
		ClientState.Party = state
		ClientState.Changed:Fire("Party")
	end)
	Remotes.Event("RunState").OnClientEvent:Connect(function(state)
		ClientState.Run = state
		ClientState.Changed:Fire("Run")
	end)
	Remotes.Event("RunFX").OnClientEvent:Connect(function(kind, data)
		ClientState.FX:Fire(kind, data)
	end)
	Remotes.Event("Notify").OnClientEvent:Connect(function(text, kind)
		ClientState.Notified:Fire(text, kind or "Info")
	end)

	-- Ask for the first snapshot in case the server pushed it before we were listening.
	task.spawn(function()
		for _ = 1, 10 do
			local ok, state = pcall(function()
				return Remotes.Function("GetMeta"):InvokeServer()
			end)
			if ok and state then
				if not ClientState.Meta then
					ClientState.Meta = state
					ClientState.Changed:Fire("Meta")
				end
				return
			end
			task.wait(1)
		end
	end)
end

-- Wraps a RemoteFunction call so UI code never errors: always returns a RequestResult.
local function request(remoteName: string, action: string, value: any): Types.RequestResult
	local ok, result = pcall(function()
		return Remotes.Function(remoteName):InvokeServer(action, value)
	end)
	if not ok then
		return { Ok = false, Error = "Couldn't reach the server. Try again." }
	end
	if type(result) ~= "table" then
		return { Ok = false, Error = "Something went wrong." }
	end
	return result
end

-- In-run purchases and leaving: "BuyUpgrade" (id), "BuyTool" (index), "Leave", "ReturnToLobby".
function ClientState.RunRequest(action: string, value: any?): Types.RequestResult
	return request("RunRequest", action, value)
end

-- Permanent actions: "BuyPerk" (id), "Hatch" ({ Egg = id, Count = 1 | 3 }), "Equip" (uid),
-- "Unequip" (uid), "EquipBest", "Delete" (uid).
-- Slow ones get the "Working..." dots (UIKit.Busy: only shown if the wait is over a moment).
local BUSY_TEXT = {
	BuyPerk = "Buying",
	Rebirth = "Rebirthing",
	ClaimDaily = "Claiming your reward",
	ClaimStayBoost = "Claiming",
	RedeemCode = "Checking your code",
	ClaimGroup = "Checking the community",
	SocialDone = "Checking",
	Merge = "Merging",
	Delete = "Deleting",
	EquipBest = "Equipping",
}

function ClientState.MetaRequest(action: string, value: any?): Types.RequestResult
	local text = BUSY_TEXT[action]
	local done: (() -&gt; ())? = nil
	if text then
		local ok, UIKit = pcall(function()
			return require(script.Parent:WaitForChild("UIKit")) :: any
		end)
		if ok then
			done = UIKit.Busy(text)
		end
	end
	local result = request("MetaRequest", action, value)
	if done then
		done()
	end
	return result
end

function ClientState.InRun(): boolean
	return ClientState.Run ~= nil
end

function ClientState.InParty(): boolean
	return ClientState.Party ~= nil
end

-- The dishwasher model the local player is playing in, if it has replicated.
function ClientState.GetArena(): Model?
	local run = ClientState.Run
	if not run then
		return nil
	end
	local arenas = workspace:FindFirstChild("Arenas")
	local arena = arenas and arenas:FindFirstChild(run.ArenaName)
	if arena and arena:IsA("Model") then
		return arena
	end
	return nil
end

function ClientState.LocalPlayer(): Player
	return Players.LocalPlayer
end

-- The lobby is built on every server, a long way above the arenas. The open-air levels (the Backyard)
-- would show its giant lawn hanging in the sky, so while the player is in a run the lobby's parts are
-- made invisible for them alone (LocalTransparencyModifier is never replicated).
task.spawn(function()
	local hidden = false
	while true do
		task.wait(1)
		local wantHidden = ClientState.Run ~= nil
		if wantHidden ~= hidden then
			local lobby = workspace:FindFirstChild("Lobby")
			if lobby then
				hidden = wantHidden
				local n = 0
				for _, d in lobby:GetDescendants() do
					if d:IsA("BasePart") then
						d.LocalTransparencyModifier = if wantHidden then 1 else 0
					end
					n += 1
					if n % 600 == 0 then
						task.wait()
					end
				end
			end
		end
	end
end)

return ClientState</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000033"><Properties><string name="Name">ClubsUI</string><ProtectedString name="Source">--[[
	ClubsUI - the Clubs window (HUD "Clubs" button, C key).

	Tabs (not in a club):  CREATE CLUB  |  TOP CLUBS  |  FIND CLUBS
	Tabs (in a club):      MY CLUB  |  TOP CLUBS  |  FIND CLUBS  |  LEADERBOARD  |  CHAT

	  CREATE CLUB  Name, prefix (the [TAG] in front of members' names; the ? inside its box explains
	               it), public / private, requirements, CREATE (Gems, with a "Creating..." overlay).
	               Or join with a club code.
	  MY CLUB      The banner (prefix, name, points, members, requirements, the club code). The
	               owner can edit the name and prefix (each once every 30 days, with a warning
	               first) and the settings. Click a member for their options: Promote to Co-Leader
	               (owner, with a warning), Demote, Kick (owner: anyone; co-leaders: members).
	               Leave / Close club ask first.
	  TOP CLUBS    The top 25 by Bubbles donated this month: FULL, INVITE ONLY, LOCKED, JOIN or YOURS.
	               Click a club to see its members and what each has given.
	  FIND CLUBS   Type and the clubs starting with it come up, A to Z (a club code finds that club).
	               The filter button opens filters (public / private, friends in it, ones you can
	               join, ones with space); Back returns to the results.
	  LEADERBOARD  Your club's members by the Bubbles they've donated this month, and when the monthly
	               contest resets (in your own time). DONATE BUBBLES is on MY CLUB.
	  CHAT         The club's chat (filtered, kept between sessions).

	Everything goes through ClubRequest (ClubService); ClubState pushes changes, ClubChat messages.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local Client = script.Parent
local ClientState = require(Client:WaitForChild("ClientState"))
local UIKit = require(Client:WaitForChild("UIKit"))

local ClubsUI = {}

local Colors = UIKit.Theme.Colors
local Fonts = UIKit.Theme.Fonts
local LocalPlayer = Players.LocalPlayer

local initialized = false
local busy = false
local tab = "Club"
local myClub: any = nil
local content: Frame
local tabsRow: Frame
local pageHolder: Frame
local overlay: Frame
local chatLog: { any } = {}
local chatLoaded = false
local friends: { [number]: boolean }? = nil
local filters = { Type = "Any", Friends = false, CanJoin = false, Space = false }
local findText = ""
local renderToken = 0
local render: () -&gt; ()
local inClubPerMeta: () -&gt; boolean
local fetchMine: () -&gt; ()

local ROLE_NAMES = { Owner = "Owner", CoLeader = "Co-Leader", Member = "Member" }

----------------------------------------------------------------------------------------------------
-- Small helpers
----------------------------------------------------------------------------------------------------

-- `busyText`: shows the bouncing dots over the window ("Creating your club...") while it waits.
local function request(action: string, value: any?, busyText: string?): any
	if busy then
		return { Ok = false, Error = "One moment..." }
	end
	busy = true
	local done = if busyText then UIKit.Busy(busyText, true) else nil
	local ok, result = pcall(function()
		return Remotes.Function("ClubRequest"):InvokeServer(action, value)
	end)
	if done then
		done()
	end
	busy = false
	if not ok or type(result) ~= "table" then
		return { Ok = false, Error = "Couldn't reach the server." }
	end
	return result
end

local function clear(frame: Instance)
	for _, child in frame:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
end

local function setText(button: TextButton, text: string)
	button.Text = text
	local label = button:FindFirstChild("Label", true)
	if label and label:IsA("TextLabel") then
		label.Text = text
	end
end

local function reqText(club: any): string
	local parts = {}
	if (club.ReqLevel or 0) &gt; 0 then
		table.insert(parts, "Beat level " .. club.ReqLevel)
	end
	if (club.ReqRebirths or 0) &gt; 0 then
		table.insert(parts, club.ReqRebirths .. " rebirths")
	end
	return if #parts &gt; 0 then table.concat(parts, ", ") else "Anyone can join"
end

local function meetsReq(club: any): boolean
	local meta = ClientState.Meta :: any
	if not meta then
		return false
	end
	return (tonumber(meta.LevelsBeaten) or 0) &gt;= (club.ReqLevel or 0) and (tonumber(meta.Rebirths) or 0) &gt;= (club.ReqRebirths or 0)
end

local function daysText(seconds: number): string
	local days = math.ceil(seconds / 86400)
	return if days &lt;= 1 then "1 day" else days .. " days"
end

-- `help`: { Title, Text } puts a small "?" at the right end of the box that explains the field.
local showInfo: (string, string) -&gt; ()
local applyResult: (any, string?) -&gt; ()

local function textBox(parent: Instance, placeholder: string, props: { [string]: any }, maxLength: number?, help: { string }?): TextBox
	local frame = UIKit.Card({ Color = Colors.PanelDark, Parent = parent })
	for k, v in props do
		(frame :: any)[k] = v
	end
	local box = Instance.new("TextBox")
	box.BackgroundTransparency = 1
	box.Size = UDim2.new(1, if help then -52 else -20, 1, 0)
	box.Position = UDim2.fromOffset(10, 0)
	box.Font = Fonts.Title
	box.TextSize = 20
	box.TextColor3 = Colors.Text
	box.PlaceholderText = placeholder
	box.PlaceholderColor3 = Colors.TextDim
	box.Text = ""
	box.ClearTextOnFocus = false
	box.TextXAlignment = Enum.TextXAlignment.Left
	box.Parent = frame
	if help then
		UIKit.Button({
			Text = "?",
			Color = Colors.Accent,
			TextSize = 16,
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -8, 0.5, 0),
			Size = UDim2.fromOffset(28, 28),
			CornerRadius = 14,
			Parent = frame,
			OnClick = function()
				showInfo(help[1], help[2])
			end,
		})
	end
	if maxLength then
		box:GetPropertyChangedSignal("Text"):Connect(function()
			if #box.Text &gt; maxLength then
				box.Text = string.sub(box.Text, 1, maxLength)
			end
		end)
	end
	return box
end

local function toast(result: any, good: string?)
	if result.Ok then
		UIKit.PlaySound("Sparkle")
		if result.Message or good then
			UIKit.Toast(result.Message or good, "Good")
		end
	else
		UIKit.Toast(result.Error or "Couldn't do that.", "Info")
	end
end

local function scrollList(parent: Instance, top: number): ScrollingFrame
	local list = Instance.new("ScrollingFrame")
	list.Name = "List"
	list.BackgroundTransparency = 1
	list.BorderSizePixel = 0
	list.Position = UDim2.fromOffset(0, top)
	list.Size = UDim2.new(1, 0, 1, -top)
	list.ScrollBarThickness = 8
	list.ScrollBarImageColor3 = Colors.Primary
	list.AutomaticCanvasSize = Enum.AutomaticSize.Y
	list.CanvasSize = UDim2.new()
	list.Parent = parent
	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, 8)
	layout.Parent = list
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 4)
	pad.PaddingLeft = UDim.new(0, 4)
	pad.PaddingRight = UDim.new(0, 10)
	pad.Parent = list
	return list
end

----------------------------------------------------------------------------------------------------
-- Dialogs (drawn over the window's content)
----------------------------------------------------------------------------------------------------

local function closeDialog()
	clear(overlay)
	overlay.Visible = false
end

-- A dialog card; returns the card to fill. `height` in pixels.
local function dialog(title: string, height: number, width: number?): Frame
	clear(overlay)
	overlay.Visible = true
	local card = UIKit.Card({
		Name = "Dialog",
		Color = Colors.Panel,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(width or 460, height),
		Parent = overlay,
	})
	UIKit.Stroke(card, Colors.Primary, 3, 0)
	UIKit.Label({ Text = title, TextSize = 24, TextColor3 = Colors.Coin, Position = UDim2.fromOffset(0, 10), Size = UDim2.new(1, 0, 0, 30), Parent = card })
	UIKit.Bounce(card)
	return card
end

-- "Are you sure?" with a message, a yes button (colour) and Cancel.
local function confirm(title: string, message: string, yesText: string, yesColor: Color3, onYes: () -&gt; ())
	local card = dialog(title, 230)
	UIKit.Label({ Text = message, TextSize = 17, TextWrapped = true, TextColor3 = Colors.Text, Position = UDim2.fromOffset(20, 48), Size = UDim2.new(1, -40, 0, 100), Parent = card })
	UIKit.Button({
		Text = yesText,
		Color = yesColor,
		TextSize = 18,
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(0.5, -6, 1, -16),
		Size = UDim2.fromOffset(190, 50),
		Parent = card,
		OnClick = function()
			closeDialog()
			onYes()
		end,
	})
	UIKit.Button({
		Text = "Cancel",
		Color = Colors.PanelLight,
		TextSize = 18,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0.5, 6, 1, -16),
		Size = UDim2.fromOffset(150, 50),
		Parent = card,
		OnClick = closeDialog,
	})
end

function showInfo(title: string, message: string)
	-- Tall enough for the whole message (about 42 characters a line at this size), never cut off.
	local lines = math.ceil(#message / 40)
	local textH = lines * 24 + 8
	local card = dialog(title, textH + 130)
	UIKit.Label({ Text = message, TextSize = 17, TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top, Position = UDim2.fromOffset(20, 48), Size = UDim2.new(1, -40, 0, textH), Parent = card })
	UIKit.Button({
		Text = "Got it",
		Color = Colors.Primary,
		TextSize = 18,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -16),
		Size = UDim2.fromOffset(160, 48),
		Parent = card,
		OnClick = closeDialog,
	})
end

----------------------------------------------------------------------------------------------------
-- The monthly contest: text, donating, and a club's details
----------------------------------------------------------------------------------------------------

-- Bouncing dots in the middle of a page while its data loads ("Loading your club...").
local function dotsPage(page: Instance, text: string)
	local holder = Instance.new("Frame")
	holder.Name = "Loading"
	holder.BackgroundTransparency = 1
	holder.Size = UDim2.fromScale(1, 1)
	holder.Parent = page
	UIKit.Label({ Text = text, TextSize = 24, TextColor3 = Colors.TextDim, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, -26), Size = UDim2.new(1, 0, 0, 36), Parent = holder })
	for i = 1, 3 do
		local dot = Instance.new("Frame")
		dot.AnchorPoint = Vector2.new(0.5, 0.5)
		dot.Position = UDim2.new(0.5, (i - 2) * 30, 0.5, 22)
		dot.Size = UDim2.fromOffset(16, 16)
		dot.BackgroundColor3 = Colors.Primary
		UIKit.Corner(dot, 8)
		dot.Parent = holder
		TweenService:Create(dot, TweenInfo.new(0.35, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true, i * 0.12), { Position = UDim2.new(0.5, (i - 2) * 30, 0.5, 10) }):Play()
	end
end

local POINTS_HELP = "Points are Bubbles donated to your club (DONATE BUBBLES on MY CLUB). Every month the clubs with the most points win prizes: the top 3 clubs' members get Gems, and the #1 club's members also get a limited pet nothing else gives. On the 1st of every month everyone's points start again from zero."

-- "Resets 1 November 2026, 1:00 PM (your time)" from the server's UTC reset time.
local function resetText(season: any): string
	if type(season) ~= "table" or type(season.ResetAt) ~= "number" then
		return ""
	end
	local day = tonumber(os.date("%d", season.ResetAt)) or 1
	local rest = os.date("%B %Y, %I:%M %p", season.ResetAt)
	local cleaned = string.gsub(rest, "^(%a+ %d+, )0", "%1")
	return string.format("Resets %d %s (your time)", day, cleaned)
end

local function prizeText(): string
	local rules = Config.Clubs.Season
	local pet = Config.Pets[rules.Pet]
	return string.format(
		"Prizes: #1 %d Gems + the limited %s pet, #2 %d Gems, #3 %d Gems (for every member).",
		rules.PrizeGems[1],
		if pet then pet.Name else "pet",
		rules.PrizeGems[2],
		rules.PrizeGems[3]
	)
end

local function donateDialog()
	local meta = ClientState.Meta :: any
	local have = if meta then tonumber(meta.Bubbles) or 0 else 0
	local card = dialog("Donate Bubbles", 300)
	UIKit.Label({
		Text = string.format("You have %s Bubbles. Donated Bubbles can't be taken back: they become points for your club this month.", UIKit.Commas(have)),
		TextSize = 16,
		TextWrapped = true,
		Position = UDim2.fromOffset(20, 46),
		Size = UDim2.new(1, -40, 0, 60),
		Parent = card,
	})
	local amounts: { number } = table.clone(Config.Clubs.Season.DonateAmounts)
	table.insert(amounts, -1) -- "ALL"
	for i, amount in amounts do
		local all = amount &lt; 0
		local value = if all then have else amount
		UIKit.Button({
			Text = if all then string.format("ALL (%s)", UIKit.Commas(have)) else UIKit.Commas(amount),
			Color = if value &gt; 0 and value &lt;= have then Colors.Good else Colors.Disabled,
			TextSize = 18,
			Position = UDim2.new(0, 20 + ((i - 1) % 2) * 210, 0, 116 + ((i - 1) // 2) * 58),
			Size = UDim2.fromOffset(200, 50),
			Parent = card,
			OnClick = function()
				if value &lt;= 0 or value &gt; have then
					UIKit.Toast(if have &lt;= 0 then "You don't have any Bubbles to donate yet." else "You don't have that many Bubbles.", "Info")
					return
				end
				closeDialog()
				task.spawn(function()
					local result = request("Donate", value, "Donating")
					if result.Ok then
						UIKit.Confetti(40)
					end
					applyResult(result)
				end)
			end,
		})
	end
	UIKit.Button({ Text = "Close", Color = Colors.PanelLight, TextSize = 16, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -12), Size = UDim2.fromOffset(140, 40), Parent = card, OnClick = closeDialog })
end

-- A club's details: who's in it and what each has given this month (scrolls). Opened from TOP CLUBS /
-- FIND. Private clubs show too: private only means you need the code to join.
local function clubInfoDialog(summary: any)
	local card = dialog(string.format("[%s] %s", summary.Tag, summary.Name), 500, 560)
	UIKit.Label({ Name = "Status", Text = "Loading...", TextSize = 14, TextWrapped = true, TextColor3 = Colors.TextDim, Position = UDim2.fromOffset(16, 40), Size = UDim2.new(1, -32, 0, 34), Parent = card })
	local list = scrollList(card, 74)
	list.Position = UDim2.fromOffset(16, 74)
	list.Size = UDim2.new(1, -32, 1, -150)
	UIKit.Button({ Text = "Close", Color = Colors.PanelLight, TextSize = 18, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -12), Size = UDim2.fromOffset(160, 46), Parent = card, OnClick = closeDialog })
	task.spawn(function()
		local result = request("Info", summary.Id)
		if not card.Parent then
			return
		end
		if not result.Ok then
			(card:FindFirstChild("Status") :: TextLabel).Text = result.Error or "Couldn't load that club."
			return
		end
		local club = result.Club
		;(card:FindFirstChild("Status") :: TextLabel).Text = string.format(
			"%s Bubbles donated this month  •  %d/%d members  •  %s  •  %s",
			UIKit.Commas(club.Points or 0),
			club.Count or 0,
			club.Max or Config.Clubs.MaxMembers,
			if club.Public then "Public" else "Private (needs a code)",
			reqText(club)
		)
		local members: { any } = table.clone(club.Members or {})
		table.sort(members, function(a, b)
			if (a.Points or 0) ~= (b.Points or 0) then
				return (a.Points or 0) &gt; (b.Points or 0)
			end
			return string.lower(a.Name) &lt; string.lower(b.Name)
		end)
		for i, m in members do
			local row = UIKit.Card({ Name = "Entry", Size = UDim2.new(1, 0, 0, 40), LayoutOrder = i, Parent = list })
			local rankColor = if i == 1 then Colors.Coin elseif i == 2 then Color3.fromRGB(210, 220, 235) elseif i == 3 then Color3.fromRGB(230, 150, 90) else Colors.TextDim
			UIKit.Label({ Text = "#" .. i, TextSize = 18, TextColor3 = rankColor, Position = UDim2.fromOffset(6, 0), Size = UDim2.fromOffset(46, 40), Parent = row })
			UIKit.Label({ Text = m.Name .. (if m.Role == "Owner" then "  (Owner)" elseif m.Role == "CoLeader" then "  (Co-Leader)" else ""), TextSize = 16, TextXAlignment = Enum.TextXAlignment.Left, Position = UDim2.fromOffset(56, 0), Size = UDim2.new(1, -200, 1, 0), Parent = row })
			UIKit.Label({ Text = UIKit.Commas(m.Points or 0), TextSize = 16, TextColor3 = Colors.Coin, TextXAlignment = Enum.TextXAlignment.Right, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 0), Size = UDim2.fromOffset(130, 40), Parent = row })
		end
	end)
end

----------------------------------------------------------------------------------------------------
-- Club rows (TOP CLUBS and FIND CLUBS)
----------------------------------------------------------------------------------------------------

local function joinClub(club: any)
	task.spawn(function()
		local result = if club.ByCode then request("JoinCode", club.Code or findText, "Joining the club") else request("Join", club.Id, "Joining the club")
		closeDialog()
		toast(result)
		if result.Ok then
			myClub = result.Club
			tab = "Club"
			render()
		end
	end)
end

local function clubRow(parent: Instance, club: any, order: number)
	local row = UIKit.Card({ Name = "ClubRow", Size = UDim2.new(1, 0, 0, 64), LayoutOrder = order, Parent = parent })
	if club.Mine then
		UIKit.Stroke(row, Colors.Coin, 3, 0)
	end
	-- The whole row opens the club's members (the JOIN button, added last, sits on top of this).
	local hit = Instance.new("TextButton")
	hit.Name = "Open"
	hit.Text = ""
	hit.BackgroundTransparency = 1
	hit.Size = UDim2.fromScale(1, 1)
	hit.Parent = row
	hit.Activated:Connect(function()
		clubInfoDialog(club)
	end)
	local left = 12
	if club.Rank then
		local rankColor = if club.Rank == 1 then Colors.Coin elseif club.Rank == 2 then Color3.fromRGB(210, 220, 235) elseif club.Rank == 3 then Color3.fromRGB(230, 150, 90) else Colors.TextDim
		UIKit.Label({ Text = "#" .. club.Rank, TextSize = 22, TextColor3 = rankColor, Position = UDim2.fromOffset(6, 0), Size = UDim2.fromOffset(50, 64), Parent = row })
		left = 60
	end
	UIKit.Label({
		Text = string.format("[%s] %s", club.Tag, club.Name),
		TextSize = 20,
		TextScaled = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		Position = UDim2.fromOffset(left, 6),
		Size = UDim2.new(1, -(left + 170), 0, 28),
		Parent = row,
	})
	UIKit.Label({
		Text = string.format("%s donated  •  %d/%d  •  %s  •  %s", UIKit.Commas(club.Points or 0), club.Count or 0, club.Max or Config.Clubs.MaxMembers, if club.Public then "Public" else "Private (code)", reqText(club)),
		TextSize = 14,
		TextScaled = true,
		TextColor3 = Colors.TextDim,
		TextXAlignment = Enum.TextXAlignment.Left,
		Position = UDim2.fromOffset(left, 36),
		Size = UDim2.new(1, -(left + 170), 0, 20),
		Parent = row,
	})
	local full = (club.Count or 0) &gt;= (club.Max or Config.Clubs.MaxMembers)
	local label, color, enabled
	if club.Mine then
		label, color, enabled = "YOURS", Colors.Coin, false
	elseif full then
		label, color, enabled = "FULL", Colors.Bad, false
	elseif not club.Public and not club.ByCode then
		label, color, enabled = "INVITE ONLY", Colors.Disabled, false
	elseif not meetsReq(club) then
		label, color, enabled = "LOCKED", Colors.Disabled, false
	else
		label, color, enabled = "JOIN", Colors.Good, true
	end
	UIKit.Button({
		Text = label,
		Color = color,
		TextSize = 16,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.fromOffset(150, 44),
		Parent = row,
		OnClick = function()
			if enabled then
				joinClub(club)
			elseif label == "LOCKED" then
				UIKit.Toast("You don't meet this club's requirements yet: " .. reqText(club), "Info")
			elseif label == "INVITE ONLY" then
				UIKit.Toast("This club is private. Ask a member for the club code!", "Info")
			end
		end,
	})
	return row
end

----------------------------------------------------------------------------------------------------
-- CREATE CLUB
----------------------------------------------------------------------------------------------------

-- A button that cycles through values ("Level: anyone" -&gt; "Must beat level 1" -&gt; ...).
local function cycler(parent: Instance, values: { any }, format: (any) -&gt; string, start: number, props: { [string]: any }): () -&gt; any
	local index = start
	local button: TextButton
	button = UIKit.Button({
		Text = format(values[index]),
		Color = Colors.PanelLight,
		TextSize = 16,
		Parent = parent,
		OnClick = function()
			index = index % #values + 1
			setText(button, format(values[index]))
		end,
	})
	for k, v in props do
		(button :: any)[k] = v
	end
	return function()
		return values[index]
	end
end

local function levelValues(): { number }
	local out = {}
	for i = 0, Config.Clubs.MaxLevelReq do
		table.insert(out, i)
	end
	return out
end

local REBIRTH_STEPS = { 0, 1, 2, 3, 5, 10, 15, 20, 30, 50 }

local function levelText(n: number): string
	return if n == 0 then "Level: anyone" else "Must beat level " .. n
end

local function rebirthText(n: number): string
	return if n == 0 then "Rebirths: any" else n .. "+ rebirths"
end

local PREFIX_HELP = "The prefix is the short tag shown in front of every member's name, so everyone can see which club they're in. Example: [SOAP] YourName."

local function renderCreate(page: Frame)
	local rules = Config.Clubs
	local create = UIKit.Card({ Name = "Create", Color = Colors.PanelDark, Size = UDim2.new(0.6, -8, 1, 0), Parent = page })
	UIKit.Label({ Text = "MAKE A CLUB", TextSize = 22, TextColor3 = Colors.Coin, Position = UDim2.fromOffset(0, 8), Size = UDim2.new(1, 0, 0, 28), Parent = create })
	UIKit.Label({ Text = "Club name", TextSize = 14, TextColor3 = Colors.TextDim, TextXAlignment = Enum.TextXAlignment.Left, Position = UDim2.fromOffset(18, 38), Size = UDim2.new(0.6, 0, 0, 16), Parent = create })
	local nameBox = textBox(create, string.format("%d-%d letters", rules.NameLength[1], rules.NameLength[2]), {
		Position = UDim2.fromOffset(16, 56),
		Size = UDim2.new(1, -32, 0, 44),
	}, rules.NameLength[2])
	UIKit.Label({ Text = "Club prefix", TextSize = 14, TextColor3 = Colors.TextDim, TextXAlignment = Enum.TextXAlignment.Left, Position = UDim2.fromOffset(18, 106), Size = UDim2.new(0.4, 0, 0, 16), Parent = create })
	local tagBox = textBox(create, string.format("%d-%d letters", rules.TagLength[1], rules.TagLength[2]), {
		Position = UDim2.fromOffset(16, 132),
		Size = UDim2.new(0.5, -22, 0, 44),
	}, rules.TagLength[2], { "What's a prefix?", PREFIX_HELP })
	tagBox:GetPropertyChangedSignal("Text"):Connect(function()
		local upper = string.upper(tagBox.Text)
		if upper ~= tagBox.Text then
			tagBox.Text = upper
		end
	end)
	local getPublic = cycler(create, { true, false }, function(v)
		return if v then "Public" else "Private (code)"
	end, 1, { Position = UDim2.new(0.5, 6, 0, 132), Size = UDim2.new(0.5, -22, 0, 44) })
	local getLevel = cycler(create, levelValues(), levelText, 1, { Position = UDim2.fromOffset(16, 186), Size = UDim2.new(0.5, -22, 0, 44) })
	local getRebirths = cycler(create, REBIRTH_STEPS, rebirthText, 1, { Position = UDim2.new(0.5, 6, 0, 186), Size = UDim2.new(0.5, -22, 0, 44) })
	UIKit.Label({
		Text = string.format("Up to %d members. Donate Bubbles to earn club points: the top 3 clubs win prizes every month!", rules.MaxMembers),
		TextSize = 14,
		TextWrapped = true,
		TextColor3 = Colors.TextDim,
		Position = UDim2.fromOffset(16, 236),
		Size = UDim2.new(1, -32, 0, 40),
		Parent = create,
	})
	UIKit.Button({
		Text = string.format("CREATE  (%d Gems)", rules.CreateCost),
		Color = Colors.Good,
		TextSize = 22,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -14),
		Size = UDim2.new(1, -32, 0, 54),
		Parent = create,
		OnClick = function()
			local meta = ClientState.Meta :: any
			if meta and (meta.Gems or 0) &lt; rules.CreateCost then
				UIKit.Toast(string.format("You need %d Gems to make a club. Get more here!", rules.CreateCost), "Info")
				UIKit.OpenWindow("Shop", "Gems")
				return
			end
			task.spawn(function()
				local result = request("Create", {
					Name = nameBox.Text,
					Tag = tagBox.Text,
					Public = getPublic(),
					ReqLevel = getLevel(),
					ReqRebirths = getRebirths(),
				}, "Creating your club")
				closeDialog()
				toast(result)
				if result.Ok then
					UIKit.Confetti(80)
					myClub = result.Club
					tab = "Club"
					render()
				end
			end)
		end,
	})

	-- Join with a code.
	local join = UIKit.Card({ Name = "JoinCode", Color = Colors.PanelDark, AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.new(0.4, -8, 0, 210), Parent = page })
	UIKit.Label({ Text = "HAVE A CODE?", TextSize = 22, TextColor3 = Colors.Primary, Position = UDim2.fromOffset(0, 8), Size = UDim2.new(1, 0, 0, 28), Parent = join })
	UIKit.Label({ Text = "Private clubs are joined with their club code.", TextSize = 14, TextWrapped = true, TextColor3 = Colors.TextDim, Position = UDim2.fromOffset(12, 40), Size = UDim2.new(1, -24, 0, 36), Parent = join })
	local codeBox = textBox(join, "Club code", { Position = UDim2.fromOffset(16, 82), Size = UDim2.new(1, -32, 0, 48) }, 12)
	UIKit.Button({
		Text = "JOIN",
		Color = Colors.Primary,
		TextSize = 22,
		Position = UDim2.fromOffset(16, 142),
		Size = UDim2.new(1, -32, 0, 52),
		Parent = join,
		OnClick = function()
			findText = codeBox.Text
			joinClub({ ByCode = true, Code = codeBox.Text })
		end,
	})
	local browse = UIKit.Card({ Name = "Browse", Color = Colors.PanelDark, AnchorPoint = Vector2.new(1, 1), Position = UDim2.fromScale(1, 1), Size = UDim2.new(0.4, -8, 1, -222), Parent = page })
	UIKit.Label({ Text = "Or join a public club from TOP CLUBS or FIND CLUBS.", TextSize = 15, TextWrapped = true, TextColor3 = Colors.TextDim, Position = UDim2.fromOffset(12, 10), Size = UDim2.new(1, -24, 0, 44), Parent = browse })
	UIKit.Button({
		Text = "FIND CLUBS",
		Color = Colors.Accent,
		TextSize = 18,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -12),
		Size = UDim2.new(1, -32, 0, 46),
		Parent = browse,
		OnClick = function()
			tab = "Find"
			render()
		end,
	})
end

----------------------------------------------------------------------------------------------------
-- MY CLUB
----------------------------------------------------------------------------------------------------

function applyResult(result: any, good: string?)
	toast(result, good)
	if result.Ok and result.Club then
		myClub = result.Club
	end
	render()
end

-- Edit the name or the prefix (owner): a warning about the 30-day wait, then the box.
local function editField(field: string)
	local club = myClub
	if not club then
		return
	end
	local isName = field == "Name"
	local wait = if isName then club.NameWait or 0 else club.TagWait or 0
	local what = if isName then "club name" else "prefix"
	if wait &gt; 0 then
		showInfo("Not yet", string.format("You can change the %s again in %s.", what, daysText(wait)))
		return
	end
	local rules = Config.Clubs
	local card = dialog(if isName then "Change club name" else "Change prefix", 290)
	UIKit.Label({
		Text = string.format("You can only change the %s once every %d days. Make sure you like it!", what, rules.RenameDays),
		TextSize = 16,
		TextWrapped = true,
		TextColor3 = Colors.Warning,
		Position = UDim2.fromOffset(20, 46),
		Size = UDim2.new(1, -40, 0, 50),
		Parent = card,
	})
	local limits = if isName then rules.NameLength else rules.TagLength
	local box = textBox(card, string.format("%d-%d letters", limits[1], limits[2]), { Position = UDim2.fromOffset(20, 104), Size = UDim2.new(1, -40, 0, 48) }, limits[2])
	box.Text = if isName then club.Name else club.Tag
	if not isName then
		box:GetPropertyChangedSignal("Text"):Connect(function()
			local upper = string.upper(box.Text)
			if upper ~= box.Text then
				box.Text = upper
			end
		end)
	end
	UIKit.Button({
		Text = "SAVE",
		Color = Colors.Good,
		TextSize = 18,
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(0.5, -6, 1, -16),
		Size = UDim2.fromOffset(170, 50),
		Parent = card,
		OnClick = function()
			local text = box.Text
			task.spawn(function()
				local result = request("Rename", if isName then { Name = text } else { Tag = text }, "Saving")
				closeDialog()
				applyResult(result)
			end)
		end,
	})
	UIKit.Button({ Text = "Cancel", Color = Colors.PanelLight, TextSize = 18, AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0.5, 6, 1, -16), Size = UDim2.fromOffset(150, 50), Parent = card, OnClick = closeDialog })
end

-- A member's options (from clicking their row).
local function memberOptions(m: any)
	local club = myClub
	if not club or m.UserId == LocalPlayer.UserId then
		return
	end
	local myRole = club.MyRole
	local canKick = myRole == "Owner" or (myRole == "CoLeader" and m.Role == "Member")
	local isOwner = myRole == "Owner"
	local options: { any } = {}
	if isOwner and m.Role == "Member" then
		table.insert(options, {
			Text = "Promote to Co-Leader",
			Color = Colors.Good,
			Run = function()
				confirm("Promote to Co-Leader?", string.format("%s will become a Co-Leader. Co-Leaders can kick members from the club.", m.Name), "PROMOTE", Colors.Good, function()
					task.spawn(function()
						applyResult(request("Promote", m.UserId, "Promoting"), m.Name .. " is now a Co-Leader!")
					end)
				end)
			end,
		})
	elseif isOwner and m.Role == "CoLeader" then
		table.insert(options, {
			Text = "Make a Member again",
			Color = Colors.Warning,
			Run = function()
				task.spawn(function()
					applyResult(request("Demote", m.UserId, "Updating"), m.Name .. " is a Member again.")
				end)
			end,
		})
	end
	if canKick then
		table.insert(options, {
			Text = "Kick from club",
			Color = Colors.Bad,
			Run = function()
				confirm("Kick " .. m.Name .. "?", string.format("%s will be removed from %s.", m.Name, club.Name), "KICK", Colors.Bad, function()
					task.spawn(function()
						applyResult(request("Kick", m.UserId, "Removing them"), m.Name .. " was removed.")
					end)
				end)
			end,
		})
	end
	local card = dialog(m.Name, 120 + #options * 58 + 20)
	UIKit.Label({ Text = string.format("%s  •  %s points", ROLE_NAMES[m.Role] or "Member", UIKit.Commas(m.Points or 0)), TextSize = 16, TextColor3 = Colors.TextDim, Position = UDim2.fromOffset(0, 42), Size = UDim2.new(1, 0, 0, 20), Parent = card })
	for i, opt in options do
		UIKit.Button({
			Text = opt.Text,
			Color = opt.Color,
			TextSize = 18,
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0.5, 0, 0, 70 + (i - 1) * 58),
			Size = UDim2.fromOffset(300, 48),
			Parent = card,
			OnClick = function()
				closeDialog()
				opt.Run()
			end,
		})
	end
	UIKit.Button({ Text = "Close", Color = Colors.PanelLight, TextSize = 16, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -12), Size = UDim2.fromOffset(140, 40), Parent = card, OnClick = closeDialog })
	if #options == 0 then
		UIKit.Label({ Text = "Nothing you can change for them.", TextSize = 15, TextColor3 = Colors.TextDim, Position = UDim2.fromOffset(0, 74), Size = UDim2.new(1, 0, 0, 20), Parent = card })
	end
end

local function renderMyClub(page: Frame, club: any)
	local isOwner = club.MyRole == "Owner"
	-- Banner.
	local banner = UIKit.Card({ Name = "Banner", Size = UDim2.new(1, 0, 0, 112), Color = Colors.PanelDark, Parent = page })
	UIKit.Gradient(banner, Color3.fromRGB(40, 120, 200), Color3.fromRGB(14, 40, 90))
	local crest = UIKit.Icon("Club", 84, { Position = UDim2.fromOffset(14, 14) })
	crest.Parent = banner
	UIKit.Label({
		Text = string.format("[%s] %s", club.Tag, club.Name),
		TextSize = 28,
		TextScaled = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		Position = UDim2.fromOffset(110, 10),
		Size = UDim2.new(1, -(if isOwner then 470 else 330), 0, 34),
		Parent = banner,
	})
	if isOwner then
		-- Edit name / prefix.
		local editRow = Instance.new("Frame")
		editRow.BackgroundTransparency = 1
		editRow.AnchorPoint = Vector2.new(1, 0)
		editRow.Position = UDim2.new(1, -224, 0, 10)
		editRow.Size = UDim2.fromOffset(136, 34)
		editRow.Parent = banner
		UIKit.Button({ Text = "Name", Color = Colors.PanelLight, TextSize = 14, Size = UDim2.fromOffset(64, 32), Parent = editRow, OnClick = function()
			editField("Name")
		end })
		UIKit.Button({ Text = "Prefix", Color = Colors.PanelLight, TextSize = 14, Position = UDim2.fromOffset(70, 0), Size = UDim2.fromOffset(66, 32), Parent = editRow, OnClick = function()
			editField("Tag")
		end })
	end
	UIKit.Label({
		Text = string.format("%s points this month  •  %d/%d members  •  %s", UIKit.Commas(club.Points or 0), club.Count or 0, club.Max, if club.Public then "Public" else "Private"),
		TextSize = 16,
		TextScaled = true,
		TextColor3 = Colors.TextDim,
		TextXAlignment = Enum.TextXAlignment.Left,
		Position = UDim2.fromOffset(110, 48),
		Size = UDim2.new(1, -330, 0, 22),
		Parent = banner,
	})
	UIKit.Label({
		Text = "Requirements: " .. reqText(club),
		TextSize = 15,
		TextScaled = true,
		TextColor3 = Colors.Coin,
		TextXAlignment = Enum.TextXAlignment.Left,
		Position = UDim2.fromOffset(110, 76),
		Size = UDim2.new(1, -330, 0, 20),
		Parent = banner,
	})
	local codeCard = UIKit.Card({ Name = "Code", Color = Colors.PanelDark, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.fromOffset(200, 88), Parent = banner })
	UIKit.Label({ Text = "CLUB CODE", TextSize = 14, TextColor3 = Colors.TextDim, Position = UDim2.fromOffset(0, 4), Size = UDim2.new(1, 0, 0, 18), Parent = codeCard })
	local codeText = Instance.new("TextBox") -- read-only, so it can be selected and copied
	codeText.Name = "CodeText"
	codeText.BackgroundTransparency = 1
	codeText.TextEditable = false
	codeText.ClearTextOnFocus = false
	codeText.Font = Fonts.Title
	codeText.TextSize = 28
	codeText.TextColor3 = Colors.Coin
	codeText.Text = club.Code or "------"
	codeText.Position = UDim2.fromOffset(0, 22)
	codeText.Size = UDim2.new(1, 0, 0, 32)
	codeText.Parent = codeCard
	if isOwner then
		UIKit.Button({
			Text = "New code",
			Color = Colors.PanelLight,
			TextSize = 13,
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -4),
			Size = UDim2.fromOffset(110, 26),
			Parent = codeCard,
			OnClick = function()
				confirm("New club code?", "The old code stops working straight away.", "NEW CODE", Colors.Primary, function()
					task.spawn(function()
						applyResult(request("NewCode", nil, "Making a new code"), "New club code made.")
					end)
				end)
			end,
		})
	end

	-- Members (click one for options).
	local membersCard = UIKit.Card({
		Name = "Members",
		Color = Colors.PanelDark,
		Position = UDim2.fromOffset(0, 124),
		Size = UDim2.new(if isOwner then 0.62 else 1, if isOwner then -8 else 0, 1, -124),
		Parent = page,
	})
	UIKit.Label({ Text = "MEMBERS", TextSize = 16, TextXAlignment = Enum.TextXAlignment.Left, Position = UDim2.fromOffset(14, 8), Size = UDim2.fromOffset(110, 26), Parent = membersCard })
	UIKit.Button({
		Text = "?",
		Color = Colors.Accent,
		TextSize = 16,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -8, 0, 6),
		Size = UDim2.fromOffset(30, 30),
		CornerRadius = 15,
		Parent = membersCard,
		OnClick = function()
			showInfo("What are points?", POINTS_HELP)
		end,
	})
	UIKit.Button({
		Text = "DONATE BUBBLES",
		Color = Colors.Good,
		TextSize = 14,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -44, 0, 6),
		Size = UDim2.fromOffset(160, 30),
		Parent = membersCard,
		OnClick = donateDialog,
	})
	local list = scrollList(membersCard, 34)
	list.Size = UDim2.new(1, -12, 1, -94)
	list.Position = UDim2.fromOffset(6, 40)
	for i, m in club.Members or {} do
		local row = Instance.new("TextButton")
		row.Name = "Member"
		row.Text = ""
		row.AutoButtonColor = true
		row.Size = UDim2.new(1, 0, 0, 40)
		row.LayoutOrder = i
		row.BackgroundColor3 = Colors.PanelLight
		UIKit.Corner(row, 10)
		row.Parent = list
		local dot = Instance.new("Frame")
		dot.Size = UDim2.fromOffset(12, 12)
		dot.Position = UDim2.fromOffset(10, 14)
		dot.BackgroundColor3 = if m.Online then Colors.Good else Colors.Disabled
		UIKit.Corner(dot, 6)
		dot.Parent = row
		local roleColor = if m.Role == "Owner" then Colors.Coin elseif m.Role == "CoLeader" then Colors.Primary else Colors.Text
		UIKit.Label({ Text = m.Name, TextSize = 17, TextColor3 = roleColor, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Position = UDim2.fromOffset(30, 0), Size = UDim2.new(1, -250, 1, 0), Parent = row })
		UIKit.Label({ Text = ROLE_NAMES[m.Role] or "Member", TextSize = 13, TextColor3 = roleColor, TextXAlignment = Enum.TextXAlignment.Right, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -112, 0, 0), Size = UDim2.fromOffset(80, 40), Parent = row })
		UIKit.Label({ Text = UIKit.Commas(m.Points or 0), TextSize = 15, TextColor3 = Colors.Coin, TextXAlignment = Enum.TextXAlignment.Right, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 0), Size = UDim2.fromOffset(96, 40), Parent = row })
		row.Activated:Connect(function()
			memberOptions(m)
		end)
	end
	local closing = isOwner and (club.Count or 0) &lt;= 1
	UIKit.Button({
		Text = if closing then "Close club" else "Leave club",
		Color = Colors.Bad,
		TextSize = 16,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -10),
		Size = UDim2.fromOffset(180, 44),
		Parent = membersCard,
		OnClick = function()
			local title = if closing then "Close your club?" else "Leave the club?"
			local message = if closing
				then string.format("%s will be deleted for good, and the %d Gems you spent on it won't come back.", club.Name, Config.Clubs.CreateCost)
				elseif isOwner then "You're the owner: the club goes to a Co-Leader (or the longest member)."
				else string.format("You'll leave %s. You can join another club after a minute.", club.Name)
			confirm(title, message, if closing then "CLOSE CLUB" else "LEAVE", Colors.Bad, function()
				task.spawn(function()
					local result = request("Leave", nil, if closing then "Closing your club" else "Leaving the club")
					toast(result)
					if result.Ok then
						myClub = nil
						tab = "Club"
						render()
					end
				end)
			end)
		end,
	})

	if isOwner then
		local settingsCard = UIKit.Card({ Name = "Settings", Color = Colors.PanelDark, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 124), Size = UDim2.new(0.38, -8, 1, -124), Parent = page })
		UIKit.Label({ Text = "SETTINGS", TextSize = 18, Position = UDim2.fromOffset(0, 6), Size = UDim2.new(1, 0, 0, 22), Parent = settingsCard })
		local function startIndex(values: { any }, current: any): number
			return table.find(values, current) or 1
		end
		local getPublic = cycler(settingsCard, { true, false }, function(v)
			return if v then "Public" else "Private (code)"
		end, if club.Public then 1 else 2, { Position = UDim2.fromOffset(12, 38), Size = UDim2.new(1, -24, 0, 44) })
		local levels = levelValues()
		local getLevel = cycler(settingsCard, levels, levelText, startIndex(levels, club.ReqLevel), { Position = UDim2.fromOffset(12, 90), Size = UDim2.new(1, -24, 0, 44) })
		local getRebirths = cycler(settingsCard, REBIRTH_STEPS, rebirthText, startIndex(REBIRTH_STEPS, club.ReqRebirths), { Position = UDim2.fromOffset(12, 142), Size = UDim2.new(1, -24, 0, 44) })
		UIKit.Button({
			Text = "SAVE",
			Color = Colors.Good,
			TextSize = 18,
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -10),
			Size = UDim2.new(1, -24, 0, 44),
			Parent = settingsCard,
			OnClick = function()
				task.spawn(function()
					applyResult(request("Settings", { Public = getPublic(), ReqLevel = getLevel(), ReqRebirths = getRebirths() }, "Saving"), "Club settings saved.")
				end)
			end,
		})
	end
end

----------------------------------------------------------------------------------------------------
-- LEADERBOARD and CHAT
----------------------------------------------------------------------------------------------------

local function renderLeaderboard(page: Frame, club: any)
	UIKit.Label({ Text = string.format("[%s] %s  -  Bubbles donated this month (%s)", club.Tag, club.Name, tostring(if club.Season then club.Season.Label else "")), TextSize = 18, Size = UDim2.new(1, -44, 0, 26), Parent = page })
	UIKit.Button({
		Text = "?",
		Color = Colors.Accent,
		TextSize = 16,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.fromOffset(30, 30),
		CornerRadius = 15,
		Parent = page,
		OnClick = function()
			showInfo("Monthly contest", POINTS_HELP)
		end,
	})
	UIKit.Label({ Text = resetText(club.Season) .. "  •  every club starts again from zero", TextSize = 14, TextColor3 = Colors.Warning, TextXAlignment = Enum.TextXAlignment.Left, Position = UDim2.fromOffset(4, 30), Size = UDim2.new(1, -8, 0, 18), Parent = page })
	UIKit.Label({ Text = prizeText(), TextSize = 13, TextColor3 = Colors.TextDim, TextXAlignment = Enum.TextXAlignment.Left, Position = UDim2.fromOffset(4, 48), Size = UDim2.new(1, -8, 0, 18), Parent = page })
	local list = scrollList(page, 74)
	local members: { any } = table.clone(club.Members or {})
	table.sort(members, function(a, b)
		if (a.Points or 0) ~= (b.Points or 0) then
			return (a.Points or 0) &gt; (b.Points or 0)
		end
		return a.Name &lt; b.Name
	end)
	for i, m in members do
		local mine = m.UserId == LocalPlayer.UserId
		local row = UIKit.Card({ Name = "Entry", Size = UDim2.new(1, 0, 0, 46), LayoutOrder = i, Color = if mine then UIKit.Darken(Colors.Coin, 0.55) else Colors.PanelLight, Parent = list })
		local rankColor = if i == 1 then Colors.Coin elseif i == 2 then Color3.fromRGB(210, 220, 235) elseif i == 3 then Color3.fromRGB(230, 150, 90) else Colors.TextDim
		UIKit.Label({ Text = "#" .. i, TextSize = 20, TextColor3 = rankColor, Position = UDim2.fromOffset(8, 0), Size = UDim2.fromOffset(50, 46), Parent = row })
		UIKit.Label({ Text = m.Name .. (if mine then " (you)" else ""), TextSize = 18, TextXAlignment = Enum.TextXAlignment.Left, Position = UDim2.fromOffset(64, 0), Size = UDim2.new(1, -260, 1, 0), Parent = row })
		UIKit.Label({ Text = UIKit.Commas(m.Points or 0) .. " pts", TextSize = 18, TextColor3 = Colors.Coin, TextXAlignment = Enum.TextXAlignment.Right, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 0), Size = UDim2.fromOffset(180, 46), Parent = row })
	end
end

local chatList: ScrollingFrame? = nil

local function addChatLine(list: ScrollingFrame, msg: any, order: number)
	local mine = msg.U == LocalPlayer.UserId
	local line = UIKit.Label({
		Name = "Line",
		Text = string.format('&lt;font color="#%s"&gt;%s:&lt;/font&gt; %s', (if mine then Colors.Coin else Colors.Primary):ToHex(), tostring(msg.N), tostring(msg.T)),
		RichText = true,
		TextSize = 17,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		AutomaticSize = Enum.AutomaticSize.Y,
		Size = UDim2.new(1, -10, 0, 22),
		LayoutOrder = order,
		Parent = list,
	})
	local _ = line
end

local function escape(text: string): string
	return (string.gsub(string.gsub(string.gsub(text, "&amp;", "&amp;amp;"), "&lt;", "&amp;lt;"), "&gt;", "&amp;gt;"))
end

local function renderChat(page: Frame)
	local list = scrollList(page, 0)
	list.Size = UDim2.new(1, 0, 1, -62)
	list.ScrollingDirection = Enum.ScrollingDirection.Y
	chatList = list
	local function fill()
		clear(list)
		for i, msg in chatLog do
			addChatLine(list, msg, i)
		end
		task.defer(function()
			list.CanvasPosition = Vector2.new(0, 1e6)
		end)
	end
	if chatLoaded then
		fill()
	else
		UIKit.Label({ Text = "Loading chat...", TextSize = 18, TextColor3 = Colors.TextDim, Size = UDim2.new(1, 0, 0, 40), Parent = list })
		task.spawn(function()
			local result = request("ChatHistory")
			if result.Ok then
				chatLog = {}
				for _, msg in result.Messages or {} do
					table.insert(chatLog, { U = msg.U, N = escape(tostring(msg.N)), T = escape(tostring(msg.T)), At = msg.At })
				end
				chatLoaded = true
			end
			if chatList == list then
				fill()
			end
		end)
	end
	local box = textBox(page, "Say something to your club...", { AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(1, -140, 0, 50) }, Config.Clubs.ChatLength)
	local function send()
		local text = box.Text
		if text == "" then
			return
		end
		box.Text = ""
		task.spawn(function()
			local result = request("Chat", text)
			if not result.Ok then
				UIKit.Toast(result.Error or "Couldn't send that.", "Info")
			end
		end)
	end
	box.FocusLost:Connect(function(enter)
		if enter then
			send()
		end
	end)
	UIKit.Button({ Text = "SEND", Color = Colors.Primary, TextSize = 20, AnchorPoint = Vector2.new(1, 1), Position = UDim2.fromScale(1, 1), Size = UDim2.fromOffset(128, 50), Parent = page, OnClick = send })
end

----------------------------------------------------------------------------------------------------
-- FIND CLUBS (with filters)
----------------------------------------------------------------------------------------------------

local function loadFriends()
	if friends then
		return
	end
	local set: { [number]: boolean } = {}
	friends = set
	pcall(function()
		local pages = Players:GetFriendsAsync(LocalPlayer.UserId)
		while true do
			for _, f in pages:GetCurrentPage() do
				set[f.Id] = true
			end
			if pages.IsFinished then
				break
			end
			pages:AdvanceToNextPageAsync()
		end
	end)
end

local function passesFilters(club: any): boolean
	if filters.Type == "Public" and not club.Public then
		return false
	elseif filters.Type == "Private" and club.Public then
		return false
	end
	if filters.CanJoin and not meetsReq(club) then
		return false
	end
	if filters.Space and (club.Count or 0) &gt;= (club.Max or Config.Clubs.MaxMembers) then
		return false
	end
	if filters.Friends then
		local set = friends or {}
		local any = false
		for _, id in club.MemberIds or {} do
			if set[id] then
				any = true
				break
			end
		end
		if not any then
			return false
		end
	end
	return true
end

local function filterCount(): number
	return (if filters.Type ~= "Any" then 1 else 0) + (if filters.Friends then 1 else 0) + (if filters.CanJoin then 1 else 0) + (if filters.Space then 1 else 0)
end

local function renderFilters(page: Frame)
	UIKit.Button({
		Text = "&lt; Back",
		Color = Colors.PanelLight,
		TextSize = 18,
		Size = UDim2.fromOffset(130, 44),
		Parent = page,
		OnClick = function()
			tab = "Find"
			render()
		end,
	})
	UIKit.Label({ Text = "FILTERS", TextSize = 24, TextColor3 = Colors.Coin, Position = UDim2.fromOffset(0, 4), Size = UDim2.new(1, 0, 0, 36), Parent = page })
	local y = 62
	local function row(title: string, values: { string }, get: () -&gt; string, set: (string) -&gt; ())
		UIKit.Label({ Text = title, TextSize = 18, TextXAlignment = Enum.TextXAlignment.Left, Position = UDim2.fromOffset(10, y), Size = UDim2.fromOffset(260, 44), Parent = page })
		for i, v in values do
			local selected = get() == v
			UIKit.Button({
				Text = v,
				Color = if selected then Colors.Primary else Colors.PanelLight,
				TextSize = 16,
				Position = UDim2.fromOffset(270 + (i - 1) * 180, y),
				Size = UDim2.fromOffset(170, 44),
				Parent = page,
				OnClick = function()
					set(v)
					render()
				end,
			})
		end
		y += 58
	end
	row("Type", { "Any", "Public", "Private" }, function()
		return filters.Type
	end, function(v)
		filters.Type = v
	end)
	row("Friends", { "Any", "Has my friends" }, function()
		return if filters.Friends then "Has my friends" else "Any"
	end, function(v)
		filters.Friends = v ~= "Any"
		if filters.Friends then
			task.spawn(loadFriends)
		end
	end)
	row("Requirements", { "Any", "I can join" }, function()
		return if filters.CanJoin then "I can join" else "Any"
	end, function(v)
		filters.CanJoin = v ~= "Any"
	end)
	row("Space", { "Any", "Not full" }, function()
		return if filters.Space then "Not full" else "Any"
	end, function(v)
		filters.Space = v ~= "Any"
	end)
	UIKit.Button({
		Text = "Clear filters",
		Color = Colors.Bad,
		TextSize = 16,
		Position = UDim2.fromOffset(270, y + 6),
		Size = UDim2.fromOffset(170, 44),
		Parent = page,
		OnClick = function()
			filters = { Type = "Any", Friends = false, CanJoin = false, Space = false }
			render()
		end,
	})
	UIKit.Button({
		Text = "SHOW CLUBS",
		Color = Colors.Good,
		TextSize = 18,
		Position = UDim2.fromOffset(450, y + 6),
		Size = UDim2.fromOffset(200, 44),
		Parent = page,
		OnClick = function()
			tab = "Find"
			render()
		end,
	})
end

local function renderFind(page: Frame, token: number)
	local box = textBox(page, "Type a club name (or a club code)", { Size = UDim2.new(1, -220, 0, 50) }, 30)
	box.Text = findText
	local count = filterCount()
	UIKit.Button({
		Text = if count &gt; 0 then string.format("Filters (%d)", count) else "Filters",
		Color = if count &gt; 0 then Colors.Accent else Colors.PanelLight,
		TextSize = 16,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -108, 0, 0),
		Size = UDim2.fromOffset(104, 50),
		Parent = page,
		OnClick = function()
			findText = box.Text
			tab = "Filters"
			render()
		end,
	})
	local results = scrollList(page, 62)
	local searchToken = 0
	local function search()
		searchToken += 1
		local mine = searchToken
		findText = box.Text
		local text = string.gsub(box.Text, "^%s+", "")
		clear(results)
		if text == "" then
			UIKit.Label({ Text = "Start typing: clubs starting with it show up here, A to Z.", TextSize = 18, TextColor3 = Colors.TextDim, Size = UDim2.new(1, 0, 0, 50), Parent = results })
			return
		end
		UIKit.Label({ Name = "Searching", Text = "Searching...", TextSize = 18, TextColor3 = Colors.TextDim, Size = UDim2.new(1, 0, 0, 50), Parent = results })
		task.spawn(function()
			if filters.Friends then
				loadFriends()
			end
			local result = request("Find", text)
			if token ~= renderToken or mine ~= searchToken then
				return
			end
			clear(results)
			if not result.Ok then
				UIKit.Label({ Text = result.Error or "Couldn't search.", TextSize = 18, TextColor3 = Colors.TextDim, Size = UDim2.new(1, 0, 0, 50), Parent = results })
				return
			end
			local shown = 0
			for _, club in result.Clubs or {} do
				if club.ByCode or passesFilters(club) then
					shown += 1
					clubRow(results, club, shown)
				end
			end
			if shown == 0 then
				UIKit.Label({ Text = if #(result.Clubs or {}) &gt; 0 then "No clubs match your filters." else "No clubs found.", TextSize = 18, TextColor3 = Colors.TextDim, Size = UDim2.new(1, 0, 0, 50), Parent = results })
			end
		end)
	end
	-- Live: search a moment after typing stops.
	local typedAt = 0
	box:GetPropertyChangedSignal("Text"):Connect(function()
		typedAt = os.clock()
		local at = typedAt
		task.delay(0.45, function()
			if at == typedAt and token == renderToken then
				search()
			end
		end)
	end)
	box.FocusLost:Connect(function(enter)
		if enter then
			search()
		end
	end)
	UIKit.Button({ Text = "FIND", Color = Colors.Primary, TextSize = 20, AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.fromOffset(100, 50), Parent = page, OnClick = search })
	search()
end

----------------------------------------------------------------------------------------------------
-- Tabs
----------------------------------------------------------------------------------------------------

local function tabList(): { { string } }
	if myClub or inClubPerMeta() then
		return { { "Club", "MY CLUB" }, { "Top", "TOP CLUBS" }, { "Find", "FIND CLUBS" }, { "Board", "LEADERBOARD" }, { "Chat", "CHAT" } }
	end
	return { { "Club", "CREATE CLUB" }, { "Top", "TOP CLUBS" }, { "Find", "FIND CLUBS" } }
end

-- Does your save say you're in a club? (Known from login, before the club's details arrive.)
function inClubPerMeta(): boolean
	local meta = ClientState.Meta :: any
	return meta ~= nil and type(meta.ClubId) == "string" and meta.ClubId ~= ""
end

local fetching = false
function fetchMine()
	if fetching then
		return
	end
	fetching = true
	task.spawn(function()
		local result = request("Mine")
		fetching = false
		if result.Ok then
			myClub = result.Club
			if UIKit.IsWindowOpen("Clubs") and (tab == "Club" or tab == "Board") then
				render()
			end
		end
	end)
end

render = function()
	renderToken += 1
	local token = renderToken
	closeDialog()
	-- Tabs that need a club fall back to MY CLUB when you leave one.
	if not myClub and (tab == "Board" or tab == "Chat") then
		tab = "Club"
	end
	clear(tabsRow)
	local tabs = tabList()
	local width = math.floor((868 - (#tabs - 1) * 8) / #tabs)
	for i, def in tabs do
		local selected = def[1] == tab or (tab == "Filters" and def[1] == "Find")
		UIKit.Button({
			Name = "Tab" .. def[1],
			Text = def[2],
			Color = if selected then Colors.Primary else Colors.PanelLight,
			TextSize = 16,
			Size = UDim2.fromOffset(math.min(width, 200), 44),
			LayoutOrder = i,
			Parent = tabsRow,
			OnClick = function()
				tab = def[1]
				render()
			end,
		})
	end
	clear(pageHolder)
	chatList = nil
	local page = Instance.new("Frame")
	page.Name = tab .. "Page"
	page.BackgroundTransparency = 1
	page.Size = UDim2.fromScale(1, 1)
	page.Parent = pageHolder
	if tab == "Club" then
		if myClub then
			renderMyClub(page, myClub)
		elseif inClubPerMeta() then
			-- We know you're in a club but haven't got its details yet: dots, never the Create page.
			dotsPage(page, "Loading your club")
			fetchMine()
		else
			renderCreate(page)
		end
	elseif tab == "Top" then
		dotsPage(page, "Loading clubs")
		task.spawn(function()
			local result = request("Top")
			if token ~= renderToken then
				return
			end
			clear(page)
			if result.Ok then
				UIKit.Label({ Text = string.format("%s CONTEST  -  clubs with the most Bubbles donated", string.upper(tostring(if result.Season then result.Season.Label else ""))), TextSize = 17, TextColor3 = Colors.Coin, TextXAlignment = Enum.TextXAlignment.Left, Position = UDim2.fromOffset(4, 0), Size = UDim2.new(1, -44, 0, 24), Parent = page })
				UIKit.Button({
					Text = "?",
					Color = Colors.Accent,
					TextSize = 16,
					AnchorPoint = Vector2.new(1, 0),
					Position = UDim2.fromScale(1, 0),
					Size = UDim2.fromOffset(30, 30),
					CornerRadius = 15,
					Parent = page,
					OnClick = function()
						showInfo("Monthly contest", POINTS_HELP)
					end,
				})
				UIKit.Label({ Text = resetText(result.Season) .. "  •  every club starts again from zero", TextSize = 13, TextColor3 = Colors.Warning, TextXAlignment = Enum.TextXAlignment.Left, Position = UDim2.fromOffset(4, 24), Size = UDim2.new(1, -8, 0, 16), Parent = page })
				UIKit.Label({ Text = prizeText(), TextSize = 13, TextColor3 = Colors.TextDim, TextXAlignment = Enum.TextXAlignment.Left, TextScaled = true, Position = UDim2.fromOffset(4, 42), Size = UDim2.new(1, -8, 0, 16), Parent = page })
			end
			local list = scrollList(page, 66)
			if not result.Ok or #(result.Clubs or {}) == 0 then
				UIKit.Label({ Text = if result.Ok then "No clubs yet. Be the first to make one!" else (result.Error or "Couldn't load clubs."), TextSize = 20, TextColor3 = Colors.TextDim, Size = UDim2.new(1, 0, 0, 60), Parent = list })
				return
			end
			for i, club in result.Clubs do
				clubRow(list, club, i)
			end
		end)
	elseif tab == "Find" then
		renderFind(page, token)
	elseif tab == "Filters" then
		renderFilters(page)
	elseif tab == "Board" and myClub then
		renderLeaderboard(page, myClub)
	elseif tab == "Chat" and myClub then
		renderChat(page)
	end
end

function ClubsUI.Init()
	if initialized then
		return
	end
	initialized = true

	local _gui, screenRoot = UIKit.CreateScreen("ClubsUI", 10)
	local _window, windowContent = UIKit.Window({
		Name = "Clubs",
		Title = "Clubs",
		Size = Vector2.new(900, 580),
		Parent = screenRoot,
	})
	content = windowContent
	tabsRow = Instance.new("Frame")
	tabsRow.Name = "Tabs"
	tabsRow.BackgroundTransparency = 1
	tabsRow.Size = UDim2.new(1, 0, 0, 46)
	tabsRow.Parent = content
	local tabLayout = Instance.new("UIListLayout")
	tabLayout.FillDirection = Enum.FillDirection.Horizontal
	tabLayout.Padding = UDim.new(0, 8)
	tabLayout.SortOrder = Enum.SortOrder.LayoutOrder
	tabLayout.Parent = tabsRow
	pageHolder = Instance.new("Frame")
	pageHolder.Name = "Pages"
	pageHolder.BackgroundTransparency = 1
	pageHolder.Position = UDim2.fromOffset(0, 58)
	pageHolder.Size = UDim2.new(1, 0, 1, -58)
	pageHolder.Parent = content
	-- Dialogs dim the window under them.
	overlay = Instance.new("Frame")
	overlay.Name = "Overlay"
	overlay.BackgroundColor3 = Colors.Ink
	overlay.BackgroundTransparency = 0.35
	overlay.Size = UDim2.fromScale(1, 1)
	overlay.ZIndex = 50
	overlay.Visible = false
	overlay.Active = true
	overlay.Parent = content

	UIKit.RegisterWindow("Clubs", {
		Open = function()
			render()
			-- Then the real state from the server (it may have changed elsewhere).
			task.spawn(function()
				local result = request("Mine")
				if result.Ok then
					local old, new = myClub, result.Club
					local same = (old == nil and new == nil)
						or (old ~= nil and new ~= nil and old.Id == new.Id and old.Points == new.Points and old.Count == new.Count and old.MyRole == new.MyRole and old.Name == new.Name and old.Tag == new.Tag)
					myClub = new
					-- Only redraw when something actually changed (no flicker).
					if not same and not overlay.Visible then
						render()
					end
				end
			end)
		end,
	})
	-- Know your club before you open the window (so it never has to show the Create page first).
	ClientState.Changed:Connect(function(kind)
		if kind == "Meta" then
			if inClubPerMeta() and not myClub then
				fetchMine()
			elseif not inClubPerMeta() and myClub and not busy then
				myClub = nil
			end
		end
	end)
	if inClubPerMeta() then
		fetchMine()
	end
	Remotes.Event("ClubState").OnClientEvent:Connect(function(club)
		local joinedOrLeft = (myClub == nil) ~= (club == nil) or (myClub and club and myClub.Id ~= club.Id)
		myClub = club
		if joinedOrLeft then
			chatLog = {}
			chatLoaded = false
		end
		if UIKit.IsWindowOpen("Clubs") and (tab == "Club" or tab == "Board" or joinedOrLeft) and not overlay.Visible then
			render()
		end
	end)
	Remotes.Event("ClubChat").OnClientEvent:Connect(function(msg)
		if type(msg) ~= "table" then
			return
		end
		local entry = { U = msg.U, N = escape(tostring(msg.N)), T = escape(tostring(msg.T)), At = msg.At }
		table.insert(chatLog, entry)
		while #chatLog &gt; Config.Clubs.ChatKeep do
			table.remove(chatLog, 1)
		end
		local list = chatList
		if list and list.Parent then
			addChatLine(list, entry, #chatLog + 1000)
			task.defer(function()
				list.CanvasPosition = Vector2.new(0, 1e6)
			end)
		end
	end)
end

return ClubsUI</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000034"><Properties><string name="Name">Cutscene</string><ProtectedString name="Source">--[[
	Cutscene - the fade into a run (there is no cutscene any more; the name is kept so the rest of
	the client, which covers the screen with Cutscene.Cover / Uncover, doesn't change).

	  * When your party launches, the screen goes black before the server teleports you, so the
	    teleport is never seen.
	  * When the run starts, the camera is put back on your character in the dishwasher and the
	    screen fades in. Reporting "Loaded" starts the run clock.
	  * Leaving / returning to the lobby uses the same cover.
	  * While the server is teleporting us (player attribute "Teleporting"), the cover never lifts
	    on its own; if the teleport fails the server clears the attribute and it lifts.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TeleportService = game:GetService("TeleportService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Types = require(Shared:WaitForChild("Types"))

local Client = script.Parent
local ClientState = require(Client:WaitForChild("ClientState"))
local UIKit = require(Client:WaitForChild("UIKit"))

local Cutscene = {}

local LocalPlayer = Players.LocalPlayer
local FADE = 0.6
local MAX_START_AGE = 12 -- seconds into a run after which we just report in

local initialized = false
local playing = false
local lastRunKey: string? = nil

local gui: ScreenGui
local black: Frame
local loadingLabel: TextLabel

local covered = false
local coverToken = 0

local function isTeleporting(): boolean
	return LocalPlayer:GetAttribute("Teleporting") == true
end

-- True in a party's own run server. The workspace attribute can arrive a moment after this script
-- starts, so the teleport data we arrived with counts too.
local function inRunServer(): boolean
	if Workspace:GetAttribute("RunServer") then
		return true
	end
	local ok, data = pcall(function()
		return TeleportService:GetLocalPlayerTeleportData()
	end)
	return ok and type(data) == "table" and (data :: any).Mode == "Run"
end

-- Tells the server we're in: the run clock starts with the first player to get past the fade.
local function reportLoaded()
	task.spawn(function()
		pcall(ClientState.RunRequest, "Loaded")
	end)
end

local function tweenBlack(to: number, seconds: number)
	UIKit.Tween(black, { BackgroundTransparency = to }, seconds)
	task.wait(seconds)
end

-- The run has started: make sure the camera is on us in the dishwasher, then fade in.
local function play(_levelIndex: number)
	if playing then
		return
	end
	playing = true
	covered = false
	coverToken += 1
	gui.Enabled = true
	loadingLabel.Visible = false
	if black.BackgroundTransparency &gt; 0.05 then
		tweenBlack(0, 0.2)
	end
	-- give the room a moment to settle behind the black
	task.wait(0.2)
	local camera = Workspace.CurrentCamera
	local character = LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if camera then
		if camera.CameraType == Enum.CameraType.Scriptable then
			camera.CameraType = Enum.CameraType.Custom
		end
		if humanoid then
			camera.CameraSubject = humanoid
		end
	end
	reportLoaded()
	tweenBlack(1, FADE)
	gui.Enabled = false
	playing = false
end

-- Fades to black (0.35 s) with an optional line of text, and lifts itself after `timeout` seconds
-- if nothing else does. Returns once the screen is fully black.
function Cutscene.Cover(text: string?, timeout: number?)
	if playing or not gui then
		return
	end
	coverToken += 1
	local token = coverToken
	local already = covered and black.BackgroundTransparency &lt; 0.05
	covered = true
	gui.Enabled = true
	loadingLabel.Text = text or ""
	loadingLabel.Visible = text ~= nil
	if not already then
		tweenBlack(0, 0.35)
	end
	local function lift()
		if token ~= coverToken or not covered or playing then
			return
		end
		if isTeleporting() then
			task.delay(2, lift) -- still on our way: stay black
			return
		end
		Cutscene.Uncover()
	end
	task.delay(timeout or 12, lift)
end

function Cutscene.Uncover()
	if not covered or playing or not gui then
		return
	end
	coverToken += 1
	local token = coverToken
	covered = false
	loadingLabel.Visible = false
	UIKit.Tween(black, { BackgroundTransparency = 1 }, 0.45)
	task.delay(0.5, function()
		if token == coverToken and not playing and not covered then
			gui.Enabled = false
		end
	end)
end

function Cutscene.IsCovered(): boolean
	return covered
end

function Cutscene.IsPlaying(): boolean
	return playing
end

function Cutscene.Init()
	if initialized then
		return
	end
	initialized = true

	local screen, root = UIKit.CreateScreen("Cutscene", 60)
	gui = screen
	gui.Enabled = false
	black = Instance.new("Frame")
	black.Name = "Fade"
	black.BackgroundColor3 = Color3.new(0, 0, 0)
	black.BorderSizePixel = 0
	black.Size = UDim2.fromScale(1, 1)
	black.BackgroundTransparency = 1
	black.ZIndex = 20
	black.Parent = root
	loadingLabel = UIKit.Label({
		Name = "Loading",
		Text = "",
		TextSize = 34,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(700, 60),
		Visible = false,
		ZIndex = 21,
		Parent = root,
	})

	-- Just arrived in the party's own run server: stay black until the dishwasher is ready.
	if inRunServer() and not ClientState.Run then
		task.defer(Cutscene.Cover, "Filling your dishwasher...", 60)
	end

	-- The server is teleporting us (to a run, or home): black until we're gone. If it gives up, the
	-- attribute clears and we're back.
	local function onTeleporting()
		if isTeleporting() then
			local text = if inRunServer() then "Heading back to the lobby..." else "Heading to your dishwasher..."
			task.spawn(Cutscene.Cover, text, 60)
		elseif covered and not playing and not ClientState.Run then
			Cutscene.Uncover()
		end
	end
	LocalPlayer:GetAttributeChangedSignal("Teleporting"):Connect(onTeleporting)
	if isTeleporting() then
		onTeleporting()
	end

	-- Our party is launching: go black now, before the server teleports us into the dishwasher. If
	-- no run follows (the start failed), the cover lifts again.
	ClientState.Changed:Connect(function(kind)
		if kind ~= "Party" then
			return
		end
		local party = ClientState.Party :: Types.PartyState?
		if party and party.Status == "Launching" and not ClientState.Run then
			task.spawn(Cutscene.Cover, nil, 20)
		elseif not party and covered and not playing then
			task.delay(2, function()
				if covered and not playing and not ClientState.Run and not isTeleporting() then
					Cutscene.Uncover()
				end
			end)
		end
	end)

	-- A new run we're starting from the top: fade into it.
	ClientState.Changed:Connect(function(kind)
		if kind ~= "Run" then
			return
		end
		local run = ClientState.Run :: Types.RunState?
		if not run then
			lastRunKey = nil
			if inRunServer() then
				-- A run server: the server is teleporting us home, stay behind the cover.
				task.spawn(Cutscene.Cover, "Heading back to the lobby...", 40)
				return
			end
			-- Back in the lobby: lift the cover the Leave / Back to Lobby buttons put up.
			if covered then
				task.delay(0.35, Cutscene.Uncover)
			end
			return
		end
		local key = tostring(run.ArenaName) .. ":" .. tostring(run.StartedAt)
		if key == lastRunKey then
			return
		end
		lastRunKey = key
		local age = Workspace:GetServerTimeNow() - (tonumber(run.StartedAt) or 0)
		-- Fade in when the run just started, or whenever we're still behind the cover (e.g. we got to
		-- the run server after the others and joined their run already going).
		if run.Phase == "Playing" and (age &lt; MAX_START_AGE or covered) then
			task.spawn(play, run.Level)
		elseif run.Phase == "Playing" then
			reportLoaded() -- joined mid-run: we're in straight away
		end
	end)
end

return Cutscene</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000035"><Properties><string name="Name">DailyUI</string><ProtectedString name="Source">--[[
	DailyUI - the daily reward calendar (🎁 Daily button on the left; it also pops up by itself once
	per session when a reward is waiting).

	The next reward unlocks 24 hours after you claim one (Config.Daily). The window shows the 7-day
	streak, a CLAIM button (or a live countdown to the next one), and when you've missed a day, a
	"Restore Streak" offer (Config.DevProducts "RestoreStreak") so the streak isn't lost. The server
	does the timing (MetaRequest "ClaimDaily").
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Types = require(Shared:WaitForChild("Types"))

local Client = script.Parent
local ClientState = require(Client:WaitForChild("ClientState"))
local UIKit = require(Client:WaitForChild("UIKit"))
local ShopUI = require(Client:WaitForChild("ShopUI"))

local Colors = UIKit.Theme.Colors

local DailyUI = {}

local initialized = false
local autoShown = false
local claiming = false
local row: Frame
local footer: TextLabel
local claimButton: TextButton
local restoreButton: TextButton

local function now(): number
	return Workspace:GetServerTimeNow()
end

-- True when a reward is waiting (the HUD shows a "!" on the Daily button).
function DailyUI.Ready(): boolean
	local meta = ClientState.Meta :: Types.MetaState?
	return meta ~= nil and (meta.DailyReadyAt == 0 or now() &gt;= meta.DailyReadyAt)
end

local function rewardText(reward): string
	return string.format("%s %s", UIKit.Commas(reward.Amount), if reward.Kind == "Gems" then "Gems" else "Bubbles")
end

local function clock(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	return string.format("%02d:%02d:%02d", seconds // 3600, (seconds % 3600) // 60, seconds % 60)
end

-- The day the next claim would give.
local function nextDay(meta: Types.MetaState): number
	if meta.DailyBroken or meta.DailyStreak == 0 then
		return 1
	end
	return meta.DailyStreak % #Config.DailyRewards + 1
end

local function render()
	local meta = ClientState.Meta :: Types.MetaState?
	if not meta then
		return
	end
	local ready = DailyUI.Ready()
	local streak = if meta.DailyBroken then 0 else meta.DailyStreak
	local upcoming = nextDay(meta)
	for _, child in row:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	for day, reward in Config.DailyRewards do
		-- A finished week starts over once the next reward is ready.
		local claimed = day &lt;= streak and not (ready and upcoming == 1)
		local isNext = day == upcoming
		local card = UIKit.Card({
			Size = UDim2.fromOffset(96, 132),
			LayoutOrder = day,
			Color = if isNext and ready then Colors.Good elseif claimed then Colors.PanelLight else Colors.PanelDark,
			Parent = row,
		})
		if isNext then
			UIKit.Stroke(card, Color3.fromRGB(255, 230, 120), 3)
		end
		UIKit.Label({ Text = if day == #Config.DailyRewards then "Day 7" else "Day " .. day, TextSize = 18, Size = UDim2.new(1, 0, 0, 26), Position = UDim2.fromOffset(0, 8), Parent = card })
		UIKit.Label({ Text = if reward.Kind == "Gems" then "💎" else "🧼", TextSize = 38, Size = UDim2.new(1, 0, 0, 44), Position = UDim2.fromOffset(0, 36), Stroke = false, Parent = card })
		UIKit.Label({ Text = UIKit.Commas(reward.Amount), TextSize = 20, Size = UDim2.new(1, 0, 0, 24), Position = UDim2.fromOffset(0, 82), Parent = card })
		UIKit.Label({ Text = if claimed then "Claimed" else "", TextSize = 18, Size = UDim2.new(1, 0, 0, 20), Position = UDim2.fromOffset(0, 106), Parent = card })
	end
	if ready then
		footer.Text = string.format("Day %d is ready: %s!", upcoming, rewardText(Config.DailyRewards[upcoming]))
		claimButton.Text = "CLAIM!"
		UIKit.SetButtonColor(claimButton, Colors.Good)
	else
		footer.Text = string.format("Next up: Day %d (%s)", upcoming, rewardText(Config.DailyRewards[upcoming]))
		claimButton.Text = "Next in " .. clock(meta.DailyReadyAt - now())
		UIKit.SetButtonColor(claimButton, Colors.Disabled)
	end
	-- Missed a day with a streak worth saving: offer to restore it.
	restoreButton.Visible = meta.DailyBroken and meta.DailyStreak &gt; 1
	if restoreButton.Visible then
		footer.Text = string.format("You missed a day! Your Day %d streak will restart...", meta.DailyStreak)
	end
end


local function claim()
	if claiming or not DailyUI.Ready() then
		return
	end
	claiming = true
	local result = ClientState.MetaRequest("ClaimDaily")
	claiming = false
	if not result.Ok then
		UIKit.Toast(result.Error or "Not yet!", "Info")
		return
	end
	UIKit.PlaySound("Sparkle")
	UIKit.Confetti(50)
	UIKit.Toast(string.format("Day %d: %s!", result.Day or 1, result.Message or ""), "Good")
	render()
	-- (No notification pop-up here: it's only offered from the Free window and the Next Event spot.)
end

function DailyUI.Init()
	if initialized then
		return
	end
	initialized = true
	local _gui, screenRoot = UIKit.CreateScreen("DailyUI", 11)
	local _window, content = UIKit.Window({
		Name = "Daily",
		Title = "Daily Reward",
		Icon = "🎁",
		Size = Vector2.new(820, 400),
		Parent = screenRoot,
	})
	row = Instance.new("Frame")
	row.BackgroundTransparency = 1
	row.Size = UDim2.new(1, 0, 0, 140)
	row.Position = UDim2.fromOffset(0, 6)
	row.Parent = content
	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Horizontal
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, 10)
	layout.Parent = row
	footer = UIKit.Label({ Text = "", TextSize = 20, TextWrapped = true, Size = UDim2.new(1, -20, 0, 32), Position = UDim2.new(0.5, 0, 0, 154), AnchorPoint = Vector2.new(0.5, 0), Parent = content })
	claimButton = UIKit.Button({
		Text = "CLAIM!",
		Size = UDim2.fromOffset(240, 56),
		Position = UDim2.new(0.5, 0, 0, 196),
		AnchorPoint = Vector2.new(0.5, 0),
		Color = Colors.Good,
		TextSize = 26,
		Parent = content,
		OnClick = claim,
	})
	local restore = Config.GetProduct("RestoreStreak")
	restoreButton = UIKit.Button({
		Text = "Restore Streak",
		Size = UDim2.fromOffset(320, 48),
		Position = UDim2.new(0.5, 0, 0, 262),
		AnchorPoint = Vector2.new(0.5, 0),
		Color = Colors.Warning,
		TextSize = 20,
		Visible = false,
		Parent = content,
		OnClick = function()
			if ShopUI.BuyProduct("RestoreStreak") then
				UIKit.Toast("Streak restored! Claim your reward.", "Good")
			end
		end,
	})
	if restore then
		ShopUI.WatchPrice(restore, false, function(price)
			restoreButton.Text = string.format("Restore Streak  (R$ %d)", price)
		end)
	end
	UIKit.RegisterWindow("Daily", {
		Open = function()
			render()
		end,
	})
	-- Live countdown while the window is open.
	task.spawn(function()
		while true do
			task.wait(1)
			if UIKit.IsWindowOpen("Daily") then
				render()
			end
		end
	end)
	-- Pops up by itself once per session when a reward is waiting (in the lobby, nothing else open).
	local function maybeShow()
		if autoShown or not DailyUI.Ready() or ClientState.InRun() then
			return
		end
		autoShown = true
		task.delay(2.5, function()
			if not UIKit.IsWindowOpen() and not ClientState.InRun() then
				UIKit.OpenWindow("Daily")
			end
		end)
	end
	ClientState.Changed:Connect(function(kind)
		if kind == "Meta" then
			maybeShow()
			if UIKit.IsWindowOpen("Daily") then
				render()
			end
		end
	end)
	maybeShow()
end

return DailyUI</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000036"><Properties><string name="Name">Effects</string><ProtectedString name="Source">-- Effects: every world FX that isn't owned by another module. RunFX handlers (grime pops, floating
-- numbers, dish/sale celebrations), CollectionService-driven decoration (spinning arms, lift
-- pads), the drain guide beam, remaining-dirt sparkle markers, prompt routing (windows and the
-- in-arena tool shop), and a little lobby ambience.
--
-- Everything here is local: the only server calls are the tool shop's BuyTool requests (validated
-- by the server like any other purchase). Nothing here is authoritative, and every part/emitter this module creates is either pooled (reused) or handed to
-- Debris so a long session never accumulates instances.

local CollectionService = game:GetService("CollectionService")
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Types = require(Shared:WaitForChild("Types"))

local Client = script.Parent
local ClientState = require(Client:WaitForChild("ClientState"))
local UIKit = require(Client:WaitForChild("UIKit"))
local Bubbles = require(Client:WaitForChild("Bubbles"))
local ShopUI = require(Client:WaitForChild("ShopUI"))

local Effects = {}

local LocalPlayer = Players.LocalPlayer
local initialized = false

----------------------------------------------------------------------------------------------------
-- Constants
----------------------------------------------------------------------------------------------------

local MAX_FLOATERS = 24 -- floating +N labels alive at once (local player's own numbers)
local FLOATER_RISE = 3 -- studs
local FLOATER_TIME = 0.7
local DRAIN_FULL_FRACTION = 0.95

-- Floating "+N" labels currently alive, oldest first (capped, so a spam of Cleaned FX can't leak).
local floaters: { Instance } = {}

----------------------------------------------------------------------------------------------------
-- Small shared helpers
----------------------------------------------------------------------------------------------------

local function billboardNumber(position: Vector3, text: string, color: Color3, rise: number?)
	if #floaters &gt;= MAX_FLOATERS then
		local oldest = table.remove(floaters, 1)
		if oldest then
			oldest:Destroy()
		end
	end
	local anchor = Instance.new("Part")
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanTouch = false
	anchor.CanQuery = false
	anchor.CastShadow = false
	anchor.Transparency = 1
	anchor.Size = Vector3.new(0.2, 0.2, 0.2)
	anchor.CFrame = CFrame.new(position)
	anchor.Parent = workspace

	local gui = Instance.new("BillboardGui")
	gui.Name = "Floater"
	gui.Size = UDim2.fromOffset(220, 50)
	gui.StudsOffset = Vector3.new(0, 1, 0)
	gui.AlwaysOnTop = true
	gui.Parent = anchor

	local label = UIKit.Label({
		Text = text,
		Size = UDim2.fromScale(1, 1),
		TextSize = 28,
		TextColor3 = color,
		Parent = gui,
	})

	table.insert(floaters, anchor)
	local goalOffset = gui.StudsOffset + Vector3.new(0, rise or FLOATER_RISE, 0)
	UIKit.Tween(gui, { StudsOffset = goalOffset }, FLOATER_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	UIKit.Tween(label, { TextTransparency = 1 }, FLOATER_TIME * 0.8)
	task.delay(FLOATER_TIME + 0.05, function()
		local i = table.find(floaters, anchor)
		if i then
			table.remove(floaters, i)
		end
		anchor:Destroy()
	end)
end

-- One-shot sparkle/pop burst: an Attachment that emits once and is handed to Debris.
local function burst(position: Vector3, color: Color3, texture: string, count: number, lifetime: number)
	local anchor = Instance.new("Part")
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanTouch = false
	anchor.CanQuery = false
	anchor.CastShadow = false
	anchor.Transparency = 1
	anchor.Size = Vector3.new(0.2, 0.2, 0.2)
	anchor.CFrame = CFrame.new(position)
	anchor.Parent = workspace

	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = texture
	emitter.Color = ColorSequence.new(color)
	emitter.Lifetime = NumberRange.new(lifetime * 0.6, lifetime)
	emitter.Speed = NumberRange.new(3, 8)
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 0) })
	emitter.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.LightEmission = 0.5
	emitter.Rate = 0
	emitter.Parent = anchor
	emitter:Emit(count)

	Debris:AddItem(anchor, lifetime + 1)
end

-- A little cloud of soap bubbles that pops out of `position` and drifts up (see Bubbles).
local function popBubbles(position: Vector3, count: number, spread: number)
	Bubbles.Emit(position, {
		Count = count,
		Spread = spread * 0.5,
		Velocity = Vector3.new(0, 5, 0),
		Jitter = 2.5,
		Size = { 0.3, 0.85 },
		Life = { 0.9, 1.7 },
	})
end

----------------------------------------------------------------------------------------------------
-- RunFX handlers
----------------------------------------------------------------------------------------------------

local refreshDuck: (Instance) -&gt; ()
local comboCount = 0
local lastCleanedAt = 0
local COMBO_RESET_GAP = 0.6
local lastCleanedFXAt = 0
local CLEANED_FX_MIN_GAP = 0.03 -- guards against a burst of simultaneous pet + player cleans

local function onCleaned(data: Types.FXCleaned)
	local now = os.clock()
	if now - lastCleanedFXAt &lt; CLEANED_FX_MIN_GAP then
		-- Still play the sound (cheap, and combo feel matters most), but skip the heavier burst.
	else
		lastCleanedFXAt = now
		burst(data.Position, data.Color, "rbxasset://textures/particles/sparkles_main.dds", 10, 0.5)
		popBubbles(data.Position, 3, 1.2)
	end

	if now - lastCleanedAt &gt; COMBO_RESET_GAP then
		comboCount = 0
	end
	comboCount = math.min(comboCount + 1, 12)
	lastCleanedAt = now
	UIKit.PlaySound("Pop", 0.95 + comboCount * 0.03)

	if data.By == LocalPlayer.UserId then
		billboardNumber(data.Position, "+" .. UIKit.Short(data.Units), UIKit.Theme.Colors.Primary)
		if data.Golden and data.Bubbles &gt; 0 then
			billboardNumber(data.Position, "+" .. UIKit.Short(data.Bubbles) .. " Bubbles", UIKit.Theme.Colors.Bubble, FLOATER_RISE + 1)
		end
	end
end

local function onDishDone(data: Types.FXDishDone)
	burst(data.Position, UIKit.Theme.Colors.Good, "rbxasset://textures/particles/sparkles_main.dds", 24, 0.8)
	popBubbles(data.Position, 6, 2)
	UIKit.PlaySound("Sparkle")
	billboardNumber(data.Position, "Sparkling!", UIKit.Theme.Colors.Text, FLOATER_RISE + 1)
	if data.By == LocalPlayer.UserId and data.Bonus &gt; 0 then
		billboardNumber(data.Position + Vector3.new(0, 1.4, 0), "+" .. UIKit.Short(data.Bonus) .. " coins", UIKit.Theme.Colors.Coin, FLOATER_RISE + 1.6)
	end
end

-- Foam Cannon splat: a heap of foam blobs on the surface that slowly shrinks while it cleans,
-- fizzing bubbles the whole time.
local function onFoam(data: any)
	local pos = data and data.Position
	if typeof(pos) ~= "Vector3" then
		return
	end
	local normal: Vector3 = if typeof(data.Normal) == "Vector3" and data.Normal.Magnitude &gt; 0.5 then data.Normal.Unit else Vector3.yAxis
	local radius = math.clamp(tonumber(data.Radius) or 3, 1, 12)
	local duration = math.clamp(tonumber(data.Duration) or 2.5, 0.5, 6)
	local u = normal:Cross(if math.abs(normal.Y) &gt; 0.9 then Vector3.xAxis else Vector3.yAxis).Unit
	local v = normal:Cross(u)
	local folder = Instance.new("Folder")
	folder.Name = "FoamSplat"
	folder.Parent = workspace
	local blobs: { { Part: Part, Size: number, Base: Vector3 } } = {}
	local count = 9 + math.floor(radius * 2)
	for i = 1, count do
		local a = math.random() * math.pi * 2
		local d = math.sqrt(math.random()) * radius * 0.8
		local size = radius * (0.3 + math.random() * 0.35) * (if i == 1 then 1.4 else 1)
		local base = pos + (u * math.cos(a) + v * math.sin(a)) * (if i == 1 then 0 else d) + normal * size * 0.15
		local blob = Instance.new("Part")
		blob.Shape = Enum.PartType.Ball
		blob.Material = Enum.Material.SmoothPlastic
		blob.Color = Color3.fromRGB(255, 255, 255):Lerp(Color3.fromRGB(225, 205, 255), math.random() * 0.4)
		blob.Size = Vector3.one * 0.05
		blob.Anchored = true
		blob.CanCollide = false
		blob.CanQuery = false
		blob.CanTouch = false
		blob.CastShadow = false
		blob.CFrame = CFrame.new(base)
		blob.Parent = folder
		table.insert(blobs, { Part = blob, Size = size, Base = base })
	end
	Bubbles.Emit(pos + normal, { Count = 8, Spread = radius * 0.5, Velocity = normal * 4 + Vector3.new(0, 2, 0), Jitter = 3, Size = { 0.3, 0.9 }, Life = { 0.8, 1.6 } })
	task.spawn(function()
		local t = 0
		local fizz = 0
		while t &lt; duration and folder.Parent do
			local dt = RunService.Heartbeat:Wait()
			t += dt
			fizz += dt
			local grow = math.min(t / 0.15, 1)
			local shrink = 1 - math.clamp((t - duration * 0.35) / (duration * 0.65), 0, 1)
			for i, b in blobs do
				local wobble = 1 + 0.06 * math.sin(t * 7 + i)
				b.Part.Size = Vector3.one * math.max(b.Size * grow * shrink * wobble, 0.05)
			end
			if fizz &gt; 0.25 then
				fizz = 0
				Bubbles.Emit(pos + normal * 0.5, { Count = 2, Spread = radius * 0.6, Velocity = normal * 2, Jitter = 1.5, Size = { 0.25, 0.7 }, Life = { 0.6, 1.2 } })
			end
		end
		folder:Destroy()
	end)
	UIKit.PlaySound("Splash", 1.1 + math.random() * 0.2)
end

local function onSold(data: any)
	if data and data.Pet then
		-- A pet's cleaning paid out: a small "+coins" floater over that pet (over you if it can't
		-- be found), instead of a toast (pets earn often).
		local pos = nil
		if type(data.Slot) == "number" then
			local okPet, petPos = pcall(function()
				return (require(Client:WaitForChild("PetRenderer")) :: any).PetPosition(LocalPlayer, data.Slot)
			end)
			pos = if okPet and typeof(petPos) == "Vector3" then petPos else nil
		end
		if not pos then
			local character = LocalPlayer.Character
			local root = character and character:FindFirstChild("HumanoidRootPart")
			if root and root:IsA("BasePart") then
				pos = root.Position + Vector3.new(0, 3, 0)
			end
		end
		if pos then
			billboardNumber(pos, "+" .. UIKit.Short(data.Coins) .. " coins", UIKit.Theme.Colors.Coin, FLOATER_RISE + 1)
		end
		UIKit.PlaySound("Coins", 1.2)
		return
	end
	UIKit.PlaySound("Coins")
	UIKit.Toast("+" .. UIKit.Commas(data.Coins) .. " coins", "Good")
end

local function onTankFull()
	UIKit.PlaySound("Error")
end

-- A lobby bubble popped (anyone's): a splash of little bubbles; the popper gets the number.
local function onLobbyPop(data: any)
	local pos = data and data.Position
	if typeof(pos) ~= "Vector3" then
		return
	end
	local camera = workspace.CurrentCamera
	if camera and (camera.CFrame.Position - pos).Magnitude &gt; 160 then
		return
	end
	local golden = data.Golden == true
	burst(pos, if golden then UIKit.Theme.Colors.Coin else Color3.fromRGB(170, 225, 255), "rbxasset://textures/particles/sparkles_main.dds", if golden then 22 else 10, 0.6)
	Bubbles.Emit(pos, { Count = if golden then 14 else 8, Spread = 1.2, Velocity = Vector3.new(0, 2, 0), Jitter = 4, Size = { 0.3, 0.8 }, Life = { 0.5, 1.1 } })
	if data.By == LocalPlayer.UserId then
		UIKit.PlaySound("Pop", if golden then 0.8 else 1 + math.random() * 0.25)
		if golden then
			UIKit.PlaySound("Sparkle")
		end
		local amount = tonumber(data.Amount) or 1
		billboardNumber(pos, "+" .. amount .. (if amount == 1 then " Bubble" else " Bubbles"), if golden then UIKit.Theme.Colors.Coin else UIKit.Theme.Colors.Bubble, FLOATER_RISE + 1)
	end
end

-- You found a rubber duck.
local function onDuck(data: any)
	local pos = data and data.Position
	if typeof(pos) ~= "Vector3" then
		return
	end
	burst(pos, Color3.fromRGB(255, 215, 60), "rbxasset://textures/particles/sparkles_main.dds", if data.All then 40 else 20, 0.9)
	Bubbles.Emit(pos, { Count = 12, Spread = 1.5, Velocity = Vector3.new(0, 3, 0), Jitter = 3, Size = { 0.3, 0.9 }, Life = { 0.8, 1.6 } })
	-- A squeaky "quack": the pop, pitched up, twice.
	UIKit.PlaySound("Pop", 1.9)
	task.delay(0.12, function()
		UIKit.PlaySound("Pop", 2.3)
	end)
	UIKit.PlaySound("Sparkle")
	billboardNumber(pos + Vector3.new(0, 1.5, 0), string.format("Quack! %d/%d", tonumber(data.Count) or 0, tonumber(data.Total) or 0), Color3.fromRGB(255, 215, 60), FLOATER_RISE + 2)
end

-- Hides a rubber duck (for this player only) once they've found it.
refreshDuck = function(inst: Instance)
	local id = inst:GetAttribute("DuckId")
	if type(id) ~= "string" then
		return
	end
	local found = false
	local list = LocalPlayer:GetAttribute("DucksFound")
	if type(list) == "string" then
		for piece in string.gmatch(list, "[^,]+") do
			if piece == id then
				found = true
				break
			end
		end
	end
	for _, d in inst:GetDescendants() do
		if d:IsA("BasePart") then
			d.LocalTransparencyModifier = if found then 1 else 0
		elseif d:IsA("ClickDetector") then
			d.MaxActivationDistance = if found then 0 else 24
		end
	end
end

local function onRunFX(kind: string, data: any)
	if kind == "LobbyPop" then
		onLobbyPop(data)
	elseif kind == "Duck" then
		onDuck(data)
	elseif kind == "Cleaned" then
		onCleaned(data)
	elseif kind == "Foam" then
		onFoam(data)
	elseif kind == "DishDone" then
		onDishDone(data)
	elseif kind == "Sold" then
		onSold(data)
	elseif kind == "TankFull" then
		onTankFull()
	end
end

----------------------------------------------------------------------------------------------------
-- SpinY (CollectionService): drain whirlpool rings, spray arms under each rack. Streaming-safe:
-- parts that stream out simply stop appearing in GetTagged / are skipped if their Parent goes away.
----------------------------------------------------------------------------------------------------

local spinParts: { [BasePart]: boolean } = {}

local function addSpinPart(inst: Instance)
	if inst:IsA("BasePart") then
		spinParts[inst] = true
	end
end

local function removeSpinPart(inst: Instance)
	spinParts[inst :: BasePart] = nil
end

local function stepSpin(dt: number)
	for part in spinParts do
		if not part.Parent or not part:IsDescendantOf(workspace) then
			spinParts[part] = nil
			continue
		end
		local speed = part:GetAttribute("SpinSpeed")
		if type(speed) ~= "number" or speed == 0 then
			continue
		end
		part.CFrame *= CFrame.Angles(0, speed * dt, 0)
	end
end

----------------------------------------------------------------------------------------------------
-- Lift pads (CollectionService tag "LiftPad", attribute LiftTo = world Vector3): step on one and
-- you're carried to LiftTo in a puff of bubbles. The local client owns its character, so moving it
-- here replicates.
----------------------------------------------------------------------------------------------------

local LIFT_RADIUS = 4.2

local liftPads: { [BasePart]: boolean } = {}

local function addLiftPart(inst: Instance)
	if inst:IsA("BasePart") then
		liftPads[inst] = true
	end
end

local function removeLiftPart(inst: Instance)
	liftPads[inst :: BasePart] = nil
end

-- Bubble spouts (the Rebirth Fountain): a gentle stream of bubbles near the camera.
local spoutClock = 0
local function stepSpouts(dt: number)
	spoutClock += dt
	if spoutClock &lt; 0.2 then
		return
	end
	spoutClock = 0
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	for _, spout in CollectionService:GetTagged("BubbleSpout") do
		if spout:IsA("BasePart") and (spout.Position - camera.CFrame.Position).Magnitude &lt; 150 then
			Bubbles.Emit(spout.Position, { Count = 1, Spread = 0.6, Velocity = Vector3.new(0, 7, 0), Jitter = 1.2, Size = { 0.4, 1.1 }, Life = { 1.6, 2.6 }, Rise = 1.5 })
		end
	end
end

-- Bubbles streaming up every lift column near the camera.
local liftBubbleClock = 0
local function stepLiftBubbles(dt: number)
	liftBubbleClock += dt
	if liftBubbleClock &lt; 0.12 then
		return
	end
	liftBubbleClock = 0
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	for pad in liftPads do
		if pad.Parent and (pad.Position - camera.CFrame.Position).Magnitude &lt; 180 then
			local target = pad:GetAttribute("LiftTo")
			local height = if typeof(target) == "Vector3" then math.max(8, target.Y - pad.Position.Y) else 30
			Bubbles.Emit(pad.Position + Vector3.new(0, 0.8, 0), {
				Count = 1,
				Spread = 2.2,
				Velocity = Vector3.new(0, height * 1.4, 0),
				Jitter = 0.8,
				Size = { 0.4, 1.2 },
				Life = { 2.2, 3.2 },
				Rise = 3,
			})
		end
	end
end

-- Bubble columns (like Minecraft's bubble elevators). Anywhere inside a lift's column (walking in,
-- jumping in, or flying in with the bubble jets) the bubbles push you up; you keep full control
-- of your movement the whole way, so you can steer around or out. At the top you bob just above
-- the rack's height and, if you're not steering, drift gently onto the rack.
local LIFT_RISE_SPEED = 22 -- studs per second upward inside the column
local LIFT_OVERSHOOT = 4 -- the column's top is this far above the landing height
local LIFT_DRIFT_SPEED = 8 -- drift toward the landing at the top when you're not steering
local LIFT_TOP_EXTRA = 3 -- the column keeps you hovering this far above its top before letting go

local inColumn: BasePart? = nil

local function stepLift(_dt: number)
	local character = LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not character or not root or not root:IsA("BasePart") or not humanoid or humanoid.Health &lt;= 0 then
		inColumn = nil
		return
	end
	local rootPart = root :: BasePart
	local pos = rootPart.Position

	-- Which column (if any) are we in?
	local column: BasePart? = nil
	local target: Vector3? = nil
	for pad in liftPads do
		if not pad.Parent then
			liftPads[pad] = nil
			continue
		end
		local to = pad:GetAttribute("LiftTo")
		if typeof(to) ~= "Vector3" then
			continue
		end
		local d = pos - pad.Position
		local topY = to.Y + LIFT_OVERSHOOT
		if Vector3.new(d.X, 0, d.Z).Magnitude &lt;= LIFT_RADIUS and d.Y &gt; -1 and pos.Y &lt; topY + LIFT_TOP_EXTRA then
			column, target = pad, to
			break
		end
	end

	if not column or not target then
		inColumn = nil
		return
	end
	if inColumn ~= column then
		-- Just entered: a splash of bubbles, and off the ground if we were standing.
		inColumn = column
		popBubbles(pos, 8, 2.5)
		UIKit.PlaySound("Splash", 1.3)
		if humanoid:GetState() ~= Enum.HumanoidStateType.Freefall then
			humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
		end
	end

	local topY = target.Y + LIFT_OVERSHOOT
	local v = rootPart.AssemblyLinearVelocity
	local vy: number
	if pos.Y &lt; topY - 1 then
		vy = math.max(v.Y, LIFT_RISE_SPEED) -- never slows down the bubble jets
	else
		vy = (topY - pos.Y) * 4 + math.sin(os.clock() * 4) * 1.5 -- bob at the top
	end
	-- Horizontal movement is the player's own (air control); at the top, drift onto the rack
	-- unless they're steering somewhere else.
	local horizontal = Vector3.new(v.X, 0, v.Z)
	if pos.Y &gt;= topY - 2 and humanoid.MoveDirection.Magnitude &lt; 0.1 then
		local to = Vector3.new(target.X - pos.X, 0, target.Z - pos.Z)
		if to.Magnitude &gt; 0.5 then
			horizontal = to.Unit * math.min(LIFT_DRIFT_SPEED, to.Magnitude * 3)
		end
	end
	rootPart.AssemblyLinearVelocity = Vector3.new(horizontal.X, vy, horizontal.Z)
end

----------------------------------------------------------------------------------------------------
-- Drain guide beam: shown while the local player's tank is at or above 95% full.
----------------------------------------------------------------------------------------------------

local drainAnchor: BasePart? = nil
local drainAttachment: Attachment? = nil
local drainRootAttachment: Attachment? = nil
local drainBeam: Beam? = nil
local drainRoot: BasePart? = nil

local function ensureDrainGuide()
	if drainAnchor and drainAnchor.Parent then
		return
	end
	local anchor = Instance.new("Part")
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanTouch = false
	anchor.CanQuery = false
	anchor.CastShadow = false
	anchor.Transparency = 1
	anchor.Size = Vector3.new(0.2, 0.2, 0.2)
	anchor.Parent = workspace
	drainAnchor = anchor

	local a1 = Instance.new("Attachment")
	a1.Parent = anchor
	drainAttachment = a1
end

local function updateDrainGuide()
	local run = ClientState.Run :: Types.RunState?
	local character = LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")

	local wantsGuide = run ~= nil and run.Phase == "Playing" and root ~= nil and run.TankMax &gt; 0 and (run.Tank / run.TankMax) &gt;= DRAIN_FULL_FRACTION

	if not wantsGuide then
		if drainBeam then
			drainBeam.Enabled = false
		end
		return
	end

	ensureDrainGuide()
	;(drainAnchor :: BasePart).CFrame = CFrame.new((run :: Types.RunState).DrainPosition)

	if drainRoot ~= root then
		drainRoot = root :: BasePart
		if drainRootAttachment then
			drainRootAttachment:Destroy()
		end
		local a0 = Instance.new("Attachment")
		a0.Parent = drainRoot
		drainRootAttachment = a0
		if drainBeam then
			drainBeam:Destroy()
		end
		local b = Instance.new("Beam")
		b.Name = "DrainGuide"
		b.Attachment0 = drainRootAttachment
		b.Attachment1 = drainAttachment
		b.Width0 = 0.4
		b.Width1 = 0.15
		b.Color = ColorSequence.new(UIKit.Theme.Colors.Primary)
		b.Transparency = NumberSequence.new(0.35)
		b.LightEmission = 0.7
		b.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		b.TextureMode = Enum.TextureMode.Wrap
		b.TextureLength = 2
		b.TextureSpeed = -3 -- flows toward the drain
		b.FaceCamera = true
		b.Parent = drainRootAttachment
		drainBeam = b
	end
	(drainBeam :: Beam).Enabled = true
end

----------------------------------------------------------------------------------------------------
-- Remaining-grime markers: ✨ on every grime part still left once few remain.
----------------------------------------------------------------------------------------------------

local markedParts: { [BasePart]: BillboardGui } = {}
local cachedGrimeFolder: Folder? = nil
local cachedGrimeArena: Model? = nil

-- ArenaBuilder doesn't publish the grime folder's exact path to clients (only the Model
-- replicates), so we look for a child folder holding grime-shaped parts (parts carrying the
-- MinTool attribute every grime spot has). This is deliberately defensive: see needsFromOthers.
local function findGrimeFolder(arena: Model): Folder?
	if cachedGrimeArena == arena and cachedGrimeFolder and cachedGrimeFolder.Parent then
		return cachedGrimeFolder
	end
	local direct = arena:FindFirstChild("Grime")
	if direct and direct:IsA("Folder") then
		cachedGrimeArena, cachedGrimeFolder = arena, direct
		return direct
	end
	for _, child in arena:GetChildren() do
		if child:IsA("Folder") then
			for _, grandchild in child:GetChildren() do
				if grandchild:IsA("BasePart") and grandchild:GetAttribute("MinTool") ~= nil then
					cachedGrimeArena, cachedGrimeFolder = arena, child
					return child
				end
			end
		end
	end
	return nil
end

local function clearMarker(part: BasePart)
	local gui = markedParts[part]
	if gui then
		gui:Destroy()
		markedParts[part] = nil
	end
end

local function clearAllMarkers()
	for part in markedParts do
		clearMarker(part)
	end
end

local function markPart(part: BasePart)
	if markedParts[part] then
		return
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "RemainingMarker"
	gui.Size = UDim2.fromOffset(40, 40)
	gui.StudsOffset = Vector3.new(0, 1, 0)
	gui.AlwaysOnTop = true
	gui.Parent = part
	UIKit.Label({
		Text = "✨",
		Size = UDim2.fromScale(1, 1),
		TextSize = 30,
		Stroke = false,
		Parent = gui,
	})
	markedParts[part] = gui
	part.AncestryChanged:Connect(function(_, parent)
		if not parent then
			clearMarker(part)
		end
	end)
end

local function updateRemainingMarkers()
	local run = ClientState.Run :: Types.RunState?
	local arena = ClientState.GetArena()
	if not run or run.Phase ~= "Playing" or not arena then
		clearAllMarkers()
		return
	end
	local remaining = run.Total - run.Cleaned
	if remaining &gt; Config.Round.MarkerThreshold then
		clearAllMarkers()
		return
	end
	local folder = findGrimeFolder(arena)
	if not folder then
		return
	end
	local seen: { [BasePart]: boolean } = {}
	for _, child in folder:GetChildren() do
		if child:IsA("BasePart") then
			seen[child] = true
			markPart(child)
		end
	end
	for part in markedParts do
		if not seen[part] then
			clearMarker(part)
		end
	end
end

----------------------------------------------------------------------------------------------------
-- Prompts: route to UIKit windows using the attributes LobbyBuilder/ArenaBuilder set.
----------------------------------------------------------------------------------------------------

local buyingTool = false

local function buyTool(index: number)
	if buyingTool then
		return
	end
	buyingTool = true
	local result = ShopUI.GetTool(index)
	buyingTool = false
	local tool = Config.Tools[index]
	if not result then
		return -- the tool's pass was offered instead
	end
	if result.Ok then
		UIKit.PlaySound("Coins")
		UIKit.Toast(string.format("%s %s bought!", tool and tool.Icon or "", tool and tool.Name or "Tool"), "Good")
	else
		UIKit.PlaySound("Error")
		UIKit.Toast(result.Error or "Can't buy that yet.", "Bad")
	end
end

----------------------------------------------------------------------------------------------------
-- Paged leaderboards: the arrows (tag "BoardArrow") and the "Next level" prompt flip this client's
-- view of the pages (Page1..PageN in the board's SurfaceGui). Nothing is sent to the server.
----------------------------------------------------------------------------------------------------

-- A board's SurfaceGui: on the part, or in PlayerGui once BoardView has made it scrollable.
local function boardGui(board: Instance?): SurfaceGui?
	if not board then
		return nil
	end
	local onPart = board:FindFirstChildOfClass("SurfaceGui")
	if onPart then
		return onPart
	end
	local ok, gui = pcall(function()
		return (require(Client:WaitForChild("BoardView")) :: any).GuiOf(board)
	end)
	return if ok then gui else nil
end

local function flipBoard(board: Instance, dir: number)
	local gui = boardGui(board)
	if not gui then
		return
	end
	local pages = {}
	local current = 1
	for i = 1, 20 do
		local page = gui:FindFirstChild("Page" .. i)
		if not page or not page:IsA("GuiObject") then
			break
		end
		pages[i] = page
		if page.Visible then
			current = i
		end
	end
	if #pages &lt; 2 then
		return
	end
	local nextIndex = (current - 1 + dir) % #pages + 1
	for i, page in pages do
		page.Visible = i == nextIndex
	end
	UIKit.PlaySound("Click")
end

local function addBoardArrow(inst: Instance)
	local detector = inst:FindFirstChildOfClass("ClickDetector") or inst:WaitForChild("ClickDetector", 10)
	if not detector or not detector:IsA("ClickDetector") then
		return
	end
	-- The drawn button this click target sits over (in the board's SurfaceGui).
	local function button(): GuiObject?
		local board = inst.Parent
		local gui = boardGui(board)
		local name = inst:GetAttribute("Button")
		local b = gui and type(name) == "string" and gui:FindFirstChild(name)
		return if b and b:IsA("GuiObject") then b else nil
	end
	local function setLook(size: number, color: Color3)
		local b = button()
		if b then
			UIKit.Tween(b, { Size = UDim2.fromOffset(size, size), BackgroundColor3 = color }, 0.12)
		end
	end
	local IDLE, HOVER = Color3.fromRGB(255, 205, 70), Color3.fromRGB(255, 228, 130)
	detector.MouseHoverEnter:Connect(function(player)
		if player == LocalPlayer then
			setLook(66, HOVER)
		end
	end)
	detector.MouseHoverLeave:Connect(function(player)
		if player == LocalPlayer then
			setLook(60, IDLE)
		end
	end)
	detector.MouseClick:Connect(function(player)
		if player == LocalPlayer and inst.Parent then
			flipBoard(inst.Parent, tonumber(inst:GetAttribute("Dir")) or 1)
			setLook(54, HOVER)
			task.delay(0.12, function()
				setLook(60, IDLE)
			end)
		end
	end)
end

local function onPromptTriggered(prompt: ProximityPrompt, player: Player)
	if player ~= LocalPlayer then
		return
	end
	if prompt:GetAttribute("BoardNext") and prompt.Parent then
		flipBoard(prompt.Parent, 1)
		return
	end
	local windowName = prompt:GetAttribute("OpenWindow")
	if type(windowName) == "string" then
		UIKit.OpenWindow(windowName, prompt:GetAttribute("WindowArg") or prompt:GetAttribute("EggId"))
		return
	end
	local toolIndex = prompt:GetAttribute("BuyTool")
	if type(toolIndex) == "number" then
		task.spawn(buyTool, toolIndex)
	end
end

----------------------------------------------------------------------------------------------------
-- Tool shop displays in the arena: owned / next (buyable) / locked, refreshed on every RunState.
----------------------------------------------------------------------------------------------------

local function updateShopDisplays()
	local run = ClientState.Run :: Types.RunState?
	local arena = ClientState.GetArena()
	if not run or not arena then
		return
	end
	for _, inst in arena:GetChildren() do
		if not inst:IsA("BasePart") then
			continue
		end
		local display = string.match(inst.Name, "^ToolDisplay_(%d+)$")
		local tag = string.match(inst.Name, "^PriceTag_(%d+)$")
		local index = tonumber(display or tag)
		local tool = index and Config.Tools[index]
		if not index or not tool then
			continue
		end
		local owned = run.OwnedTools ~= nil and run.OwnedTools[index] == true
		if display then
			local prompt = inst:FindFirstChildOfClass("ProximityPrompt")
			if prompt then
				prompt.Enabled = not owned
			end
		else
			local gui = inst:FindFirstChildWhichIsA("LayerCollector")
			local price = gui and gui:FindFirstChild("Price") :: TextLabel?
			if price then
				local cost = Config.ToolCost(index, run.Level) or 0
				if owned then
					price.Text = "Owned"
					price.TextColor3 = UIKit.Theme.Colors.Good
				else
					price.Text = UIKit.Short(cost) .. " coins"
					price.TextColor3 = if run.Coins &gt;= cost then UIKit.Theme.Colors.Coin else UIKit.Theme.Colors.Bad
				end
			end
		end
	end
end

----------------------------------------------------------------------------------------------------
-- Lobby ambience: a handful of floating bubbles drifting near the camera.
----------------------------------------------------------------------------------------------------

local lastLobbyAmbienceAt = 0

-- The lobby's big floating bubbles (tag "FloatBubble", placed by the server): bobbed here, locally,
-- each with a glowing glint on its camera-facing side.
type FloatBubble = { Part: BasePart, Glint: Part, Base: Vector3, Phase: number, Speed: number, Amp: number }
local floatBubbles: { [BasePart]: FloatBubble } = {}

local function addFloatBubble(inst: Instance)
	if not inst:IsA("BasePart") or floatBubbles[inst] then
		return
	end
	local glint = Instance.new("Part")
	glint.Name = "BubbleGlint"
	glint.Shape = Enum.PartType.Ball
	glint.Material = Enum.Material.Neon
	glint.Color = Color3.new(1, 1, 1)
	glint.Transparency = 0.15
	glint.Size = Vector3.one * math.max(inst.Size.X * 0.18, 0.1)
	glint.Anchored = true
	glint.CanCollide = false
	glint.CanQuery = false
	glint.CanTouch = false
	glint.CastShadow = false
	glint.Parent = workspace.CurrentCamera
	-- Poppable lobby bubbles (tag "PopBubble") bob less so they stay where the server thinks they are.
	-- The big ones pop too now, so they drift only a little from where the server has them.
	local amp = if CollectionService:HasTag(inst, "PopBubble") then 0.3 else 0.5
	local speed = 0.35 + math.random() * 0.25
	floatBubbles[inst] = { Part = inst, Glint = glint, Base = inst.Position, Phase = math.random() * math.pi * 2, Speed = speed * (if amp &lt; 1 then 2.2 else 1), Amp = amp }
end

local function removeFloatBubble(inst: Instance)
	local fb = floatBubbles[inst :: BasePart]
	if fb then
		fb.Glint:Destroy()
		floatBubbles[inst :: BasePart] = nil
	end
end

local floatParts: { BasePart } = {}
local floatCFrames: { CFrame } = {}
local floatClock = 0
local function stepFloatBubbles(dt: number)
	floatClock += dt
	local camera = workspace.CurrentCamera
	if not camera or next(floatBubbles) == nil then
		return
	end
	local camCF = camera.CFrame
	table.clear(floatParts)
	table.clear(floatCFrames)
	for inst, fb in floatBubbles do
		if not inst.Parent then
			removeFloatBubble(inst)
			continue
		end
		local t = floatClock * fb.Speed + fb.Phase
		local pos = fb.Base + Vector3.new(math.sin(t) * 2.2, math.sin(t * 1.3) * 1.8, math.cos(t * 0.9) * 2.2) * fb.Amp
		local size = inst.Size.X
		local toCam = camCF.Position - pos
		toCam = if toCam.Magnitude &gt; 1e-3 then toCam.Unit else Vector3.zAxis
		table.insert(floatParts, inst)
		table.insert(floatCFrames, CFrame.new(pos))
		fb.Glint.Transparency = if inst.Transparency &gt;= 0.99 then 1 else 0.15
		table.insert(floatParts, fb.Glint)
		table.insert(floatCFrames, CFrame.new(pos + (toCam * 0.3 + camCF.UpVector * 0.25 - camCF.RightVector * 0.22) * size))
	end
	workspace:BulkMoveTo(floatParts, floatCFrames, Enum.BulkMoveMode.FireCFrameChanged)
end

-- Big, slow soap bubbles drifting up around the camera while you're in the lobby.
local function stepLobbyAmbience()
	if ClientState.Run ~= nil then
		return
	end
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local now = os.clock()
	if now - lastLobbyAmbienceAt &lt; 0.45 then
		return
	end
	lastLobbyAmbienceAt = now
	local look = camera.CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	flat = if flat.Magnitude &gt; 1e-3 then flat.Unit else Vector3.new(0, 0, -1)
	-- Mostly ahead of the camera, spread left/right, starting near the floor.
	local right = Vector3.new(-flat.Z, 0, flat.X)
	local ahead = 10 + math.random() * 35
	local side = (math.random() - 0.5) * 50
	local position = camera.CFrame.Position + flat * ahead + right * side
	position = Vector3.new(position.X, math.max(1, camera.CFrame.Position.Y - 8 + math.random() * 6), position.Z)
	Bubbles.Emit(position, {
		Count = 1,
		Spread = 0,
		Velocity = Vector3.new(0, 1.5, 0),
		Jitter = 0.6,
		Size = { 0.8, 2.2 },
		Life = { 6, 9 },
		Rise = 0.6,
		Poppable = true,
	})
end

----------------------------------------------------------------------------------------------------
-- Run lifecycle (the run-start banner itself lives in the HUD).
----------------------------------------------------------------------------------------------------

local function onStateChanged(kind: string)
	if kind ~= "Run" then
		return
	end
	updateRemainingMarkers()
	updateShopDisplays()
end

----------------------------------------------------------------------------------------------------
-- Init
----------------------------------------------------------------------------------------------------

function Effects.Init()
	if initialized then
		return
	end
	initialized = true

	ClientState.FX:Connect(onRunFX)
	ClientState.Changed:Connect(onStateChanged)

	for _, inst in CollectionService:GetTagged("SpinY") do
		addSpinPart(inst)
	end
	CollectionService:GetInstanceAddedSignal("SpinY"):Connect(addSpinPart)
	CollectionService:GetInstanceRemovedSignal("SpinY"):Connect(removeSpinPart)

	for _, inst in CollectionService:GetTagged("LiftPad") do
		addLiftPart(inst)
	end
	CollectionService:GetInstanceAddedSignal("LiftPad"):Connect(addLiftPart)
	CollectionService:GetInstanceRemovedSignal("LiftPad"):Connect(removeLiftPart)

	ProximityPromptService.PromptTriggered:Connect(onPromptTriggered)

	for _, inst in CollectionService:GetTagged("BoardArrow") do
		task.spawn(addBoardArrow, inst)
	end
	CollectionService:GetInstanceAddedSignal("BoardArrow"):Connect(function(inst)
		task.spawn(addBoardArrow, inst)
	end)

	RunService.Heartbeat:Connect(function(dt)
		stepSpin(dt)
		stepLift(dt)
		stepLiftBubbles(dt)
		stepSpouts(dt)
		updateDrainGuide()
		stepLobbyAmbience()
	end)
	RunService.RenderStepped:Connect(function(dt)
		stepFloatBubbles(dt)
	end)

	for _, inst in CollectionService:GetTagged("FloatBubble") do
		addFloatBubble(inst)
	end
	CollectionService:GetInstanceAddedSignal("FloatBubble"):Connect(addFloatBubble)
	CollectionService:GetInstanceRemovedSignal("FloatBubble"):Connect(removeFloatBubble)
	for _, inst in CollectionService:GetTagged("PopBubble") do
		addFloatBubble(inst)
	end
	CollectionService:GetInstanceAddedSignal("PopBubble"):Connect(addFloatBubble)
	CollectionService:GetInstanceRemovedSignal("PopBubble"):Connect(removeFloatBubble)

	-- Rubber ducks this player already found are hidden (for them only).
	for _, inst in CollectionService:GetTagged("RubberDuck") do
		refreshDuck(inst)
	end
	CollectionService:GetInstanceAddedSignal("RubberDuck"):Connect(function(inst)
		task.defer(refreshDuck, inst)
	end)
	LocalPlayer:GetAttributeChangedSignal("DucksFound"):Connect(function()
		for _, inst in CollectionService:GetTagged("RubberDuck") do
			refreshDuck(inst)
		end
	end)

	-- Grime count changes on every Cleaned/Sold push; the marker set only needs to react to those
	-- and to Run replacing wholesale (onStateChanged already covers both via ClientState.Changed).
end

return Effects</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000037"><Properties><string name="Name">EventZone</string><ProtectedString name="Source">--[[
	EventZone - the Next Event spot in the lobby (LobbyBuilder's glowing ring, tag "NextEventZone").

	Walk into the ring and Roblox's own event pop-up comes up for the next event (Config.NextEvent,
	SocialService:PromptRsvpToEventAsync with its RobloxEventId from StoreIds &gt; EventIds): the event
	card with Notify Me, or Join while it's on. Until an event ID is pasted in, a card of ours shows
	the event and its countdown, with Notify Me (experience notifications) and No thanks.
	The banner over the ring (tag "NextEventCountdown") counts down too.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SocialService = game:GetService("SocialService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))

local Client = script.Parent
local UIKit = require(Client:WaitForChild("UIKit"))

local EventZone = {}

local Colors = UIKit.Theme.Colors
local LocalPlayer = Players.LocalPlayer

local initialized = false
local card: Frame
local nameLabel: TextLabel
local descLabel: TextLabel
local whenLabel: TextLabel
local notifyButton: TextButton
local shownFor: any = nil

-- "Starts in 3d 04h" / "LIVE NOW!" / "" when there's nothing coming.
function EventZone.WhenText(event: any, now: number?): string
	if not event then
		return "More events soon!"
	end
	local t = now or os.time()
	if t &gt;= event.Starts then
		return "LIVE NOW!"
	end
	local left = event.Starts - t
	local d, h, m, sec = left // 86400, (left % 86400) // 3600, (left % 3600) // 60, left % 60
	if d &gt; 0 then
		return string.format("Starts in %dd %02dh", d, h)
	elseif h &gt; 0 then
		return string.format("Starts in %dh %02dm", h, m)
	end
	return string.format("Starts in %dm %02ds", m, sec)
end

local function notify(event: any)
	local id = tostring(event and event.RobloxEventId or "0")
	if id ~= "" and id ~= "0" then
		local ok, err = pcall(function()
			SocialService:PromptRsvpToEventAsync(id)
		end)
		if ok then
			return
		end
		warn("[EventZone] RSVP prompt failed: " .. tostring(err))
	end
	-- No Roblox event linked yet: just ask for notifications, and say ONE thing about it.
	local RewardsUI = require(Client:WaitForChild("RewardsUI")) :: any
	local name = if event then event.Name else "the next event"
	if RewardsUI.PromptNotifications() == "AlreadyOn" then
		UIKit.Toast("Notifications are already on. We'll let you know when " .. name .. " starts!", "Good")
	end
end

local lastPrompt = 0

-- Roblox's event pop-up, when the event is set up on Roblox. True if it was shown.
local function robloxPopup(event: any): boolean
	local id = tostring(event and event.RobloxEventId or "")
	if id == "" or id == "0" or os.clock() - lastPrompt &lt; 20 then
		return id ~= "" and id ~= "0"
	end
	lastPrompt = os.clock()
	local ok, err = pcall(function()
		SocialService:PromptRsvpToEventAsync(id)
	end)
	if not ok then
		warn("[EventZone] event pop-up failed: " .. tostring(err))
	end
	return ok
end

local function show(event: any)
	if robloxPopup(event) then
		return
	end
	shownFor = event
	nameLabel.Text = if event then event.Name else "No events planned yet"
	descLabel.Text = if event then event.Desc else "Check back soon. Turn on notifications so you never miss one!"
	whenLabel.Text = EventZone.WhenText(event)
	whenLabel.TextColor3 = if event and os.time() &gt;= event.Starts then Colors.Good else Colors.Coin
	local label = notifyButton:FindFirstChild("Label", true)
	local text = if event and os.time() &gt;= event.Starts then "IT'S ON!" else "TURN ON NOTIFICATIONS"
	if label and label:IsA("TextLabel") then
		label.Text = text
	end
	notifyButton.Text = text
	if not card.Visible then
		card.Visible = true
		UIKit.Bounce(card)
		UIKit.PlaySound("Pop")
	end
end

local function inside(zone: BasePart, position: Vector3): boolean
	local p = zone.CFrame:PointToObjectSpace(position)
	local half = zone.Size / 2
	return math.abs(p.X) &lt;= half.X and math.abs(p.Y) &lt;= half.Y + 3 and math.abs(p.Z) &lt;= half.Z
end

function EventZone.Init()
	if initialized then
		return
	end
	initialized = true

	local _gui, root = UIKit.CreateScreen("EventZone", 13)
	card = UIKit.Card({
		Name = "NextEvent",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -120),
		Size = UDim2.fromOffset(520, 210),
		Color = Colors.PanelDark,
		Parent = root,
	})
	card.Visible = false
	UIKit.Stroke(card, Color3.fromRGB(255, 120, 160), 3, 0)
	local icon = UIKit.Icon("Calendar", 72, { Position = UDim2.fromOffset(16, 18) })
	icon.Parent = card
	UIKit.Label({ Text = "NEXT EVENT", TextSize = 15, TextColor3 = Color3.fromRGB(255, 160, 200), TextXAlignment = Enum.TextXAlignment.Left, Position = UDim2.fromOffset(104, 12), Size = UDim2.new(1, -150, 0, 18), Parent = card })
	nameLabel = UIKit.Label({ Text = "", TextSize = 26, TextScaled = true, TextXAlignment = Enum.TextXAlignment.Left, Position = UDim2.fromOffset(104, 30), Size = UDim2.new(1, -120, 0, 32), Parent = card })
	whenLabel = UIKit.Label({ Text = "", TextSize = 20, TextColor3 = Colors.Coin, TextXAlignment = Enum.TextXAlignment.Left, Position = UDim2.fromOffset(104, 64), Size = UDim2.new(1, -120, 0, 24), Parent = card })
	descLabel = UIKit.Label({ Text = "", TextSize = 15, TextWrapped = true, TextColor3 = Colors.TextDim, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, Position = UDim2.fromOffset(16, 98), Size = UDim2.new(1, -32, 0, 40), Parent = card })
	notifyButton = UIKit.Button({
		Text = "TURN ON NOTIFICATIONS",
		Color = Color3.fromRGB(240, 90, 140),
		TextSize = 22,
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(0.5, 30, 1, -12),
		Size = UDim2.fromOffset(310, 52),
		Parent = card,
		OnClick = function()
			card.Visible = false
			task.spawn(notify, shownFor)
		end,
	})
	UIKit.Button({
		Text = "NO THANKS",
		Color = Colors.PanelLight,
		TextSize = 20,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0.5, 40, 1, -12),
		Size = UDim2.fromOffset(150, 52),
		Parent = card,
		OnClick = function()
			card.Visible = false
		end,
	})
	UIKit.Button({
		Text = "X",
		Color = Colors.Bad,
		TextSize = 18,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -8, 0, 8),
		Size = UDim2.fromOffset(36, 36),
		Parent = card,
		OnClick = function()
			card.Visible = false
		end,
	})

	local wasInside = false
	task.spawn(function()
		while true do
			local event = Config.NextEvent()
			local when = EventZone.WhenText(event)
			for _, label in CollectionService:GetTagged("NextEventCountdown") do
				if label:IsA("TextLabel") then
					label.Text = if event then event.Name .. "  •  " .. when else when
				end
			end
			local character = LocalPlayer.Character
			local rootPart = character and character:FindFirstChild("HumanoidRootPart")
			local isInside = false
			if rootPart and rootPart:IsA("BasePart") then
				for _, zone in CollectionService:GetTagged("NextEventZone") do
					if zone:IsA("BasePart") and inside(zone, rootPart.Position) then
						isInside = true
						break
					end
				end
			end
			if isInside and not wasInside then
				show(event)
			elseif isInside and card.Visible then
				whenLabel.Text = when
			elseif not isInside and wasInside then
				card.Visible = false
			end
			wasInside = isInside
			task.wait(0.3)
		end
	end)
end

return EventZone</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000038"><Properties><string name="Name">HoldPose</string><ProtectedString name="Source">--[[
	HoldPose - how a held cleaning tool looks, for every player on this client.

	  * Anyone holding a tool (character attribute HeldToolIndex &gt; 1) holds it out in front, the
	    classic Roblox way: the right arm is raised straight forward and the elbow and wrist are
	    straightened, set every frame after the animations run (R15 and R6; Motor6D or the newer
	    AnimationConstraint joints). The tool itself is welded to the torso by the server at the
	    raised hand, so it always sits in your hand pointing forward. It never tilts with the
	    camera.
	  * Roblox fades your character out when the camera gets close (looking up, backing into a
	    wall, first person). Your held tool is always kept fully visible, and in first person your
	    right arm too, so you can see what you're holding. Your own name tag is hidden in first
	    person (it would float in your face).
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local HoldPose = {}

local LocalPlayer = Players.LocalPlayer
local RAISE = CFrame.Angles(math.rad(90), 0, 0)
local RAISE_R6 = CFrame.Angles(0, 0, math.rad(90)) -- the R6 shoulder's joint axis is turned
local ARM_PARTS = { "RightUpperArm", "RightLowerArm", "RightHand", "Right Arm" }

local initialized = false

local function holding(character: Model): boolean
	local index = tonumber(character:GetAttribute("HeldToolIndex"))
	return index ~= nil and index &gt; 1 and character:FindFirstChild("HeldTool") ~= nil
end

local function setJoint(character: Model, partName: string, jointName: string, cf: CFrame)
	local part = character:FindFirstChild(partName)
	local joint = part and part:FindFirstChild(jointName)
	if joint and (joint:IsA("Motor6D") or joint:IsA("AnimationConstraint")) then
		(joint :: any).Transform = cf
	end
end

-- After the Animator has written this frame's joint transforms.
local function poseAll()
	for _, player in Players:GetPlayers() do
		local character = player.Character
		if character and holding(character) then
			if character:FindFirstChild("RightUpperArm") then
				setJoint(character, "RightUpperArm", "RightShoulder", RAISE)
				setJoint(character, "RightLowerArm", "RightElbow", CFrame.identity)
				setJoint(character, "RightHand", "RightWrist", CFrame.identity)
			else
				setJoint(character, "Torso", "Right Shoulder", RAISE_R6)
			end
		end
	end
end

-- After the camera's own update (which fades the character when the camera is close).
local function keepVisible()
	local character = LocalPlayer.Character
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	local head = character and character:FindFirstChild("Head")
	local firstPerson = head ~= nil and head:IsA("BasePart") and (camera.CFrame.Position - head.Position).Magnitude &lt;= 1.5
	-- Everyone's name tag follows the admin invisibility flag, so it comes straight back when
	-- they turn visible again (and after a respawn); yours also hides in first person.
	for _, player in Players:GetPlayers() do
		local other = player.Character
		local otherHead = other and other:FindFirstChild("Head")
		local tag = otherHead and otherHead:FindFirstChild("NameTag")
		if other and tag and tag:IsA("BillboardGui") then
			local show = other:GetAttribute("AdminHidden") ~= true and not (player == LocalPlayer and firstPerson)
			if tag.Enabled ~= show then
				tag.Enabled = show
			end
		end
	end
	if not character or not holding(character) then
		return
	end
	local held = character:FindFirstChild("HeldTool")
	if held then
		for _, d in held:GetDescendants() do
			if d:IsA("BasePart") then
				d.LocalTransparencyModifier = 0
			end
		end
	end
	if firstPerson then
		for _, name in ARM_PARTS do
			local part = character:FindFirstChild(name)
			if part and part:IsA("BasePart") then
				part.LocalTransparencyModifier = 0
			end
		end
	end
end

function HoldPose.Init()
	if initialized then
		return
	end
	initialized = true
	RunService.Stepped:Connect(poseAll)
	RunService:BindToRenderStep("RinseCycleHeldTool", Enum.RenderPriority.Camera.Value + 1, keepVisible)
end

return HoldPose</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000039"><Properties><string name="Name">HUD</string><ProtectedString name="Source">-- Always-on heads-up display, laid out like the big round-based simulators:
--   * top centre: the Bubbles pill with a green "+" (opens the Shop)
--   * right side: big square buttons (Shop/Pets in the lobby, Upgrades/Pets/Leave in a run) with
--     key hints for keyboard (Tab/G/P) or gamepad (Y/LB)
--   * in a run: coins + tank bottom-left, the timer bottom-right, dishwasher progress top-centre
--   * the run-start banner, the results screen and the Leave confirmation
-- On touch the corner widgets move clear of the thumbstick and jump button. See DESIGN.md section 6 "HUD". Everything here is built once in Init() and then only
-- shown/hidden/updated, so there's nothing to leak: no per-run instances, no per-run connections
-- besides the ones this module owns for its whole lifetime.

local Players = game:GetService("Players")
local StarterGui = game:GetService("StarterGui")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Types = require(Shared:WaitForChild("Types"))
local Util = require(Shared:WaitForChild("Util"))

local Client = script.Parent
local ClientState = require(Client:WaitForChild("ClientState"))
local UIKit = require(Client:WaitForChild("UIKit"))

local Colors = UIKit.Theme.Colors

local LocalPlayer = Players.LocalPlayer

local HUD = {}

-- The staff Admin button (AdminClient asks for it once the server confirms a staff tier). It sits
-- under Trade in the left column and stays there in runs too (alone, away from the timer).
local adminClick: (() -&gt; ())? = nil
local addAdminButton: (() -&gt; ())? = nil
local adminButton: TextButton? = nil

-- Shows or hides the Admin button (a staff rank given or taken away while playing).
function HUD.SetAdminButtonVisible(visible: boolean)
	if adminButton then
		adminButton.Visible = visible
		local column = adminButton.Parent
		if column and column:IsA("GuiObject") and visible then
			column.Visible = true
		end
	end
end

function HUD.AddAdminButton(onClick: () -&gt; ())
	adminClick = onClick
	if addAdminButton then
		addAdminButton()
	end
end
local initialized = false

----------------------------------------------------------------------------------------------------
-- Init
----------------------------------------------------------------------------------------------------

function HUD.Init()
	if initialized then
		return
	end
	initialized = true

	local _gui, root = UIKit.CreateScreen("HUD", 5)

	--------------------------------------------------------------------------------------------------
	-- Top centre: the Bubbles pill with a green "+" (opens the shop), like every simulator's.
	--------------------------------------------------------------------------------------------------
	local topCurrency = Instance.new("Frame")
	topCurrency.Name = "TopCurrency"
	topCurrency.AnchorPoint = Vector2.new(0.5, 0)
	topCurrency.Size = UDim2.fromOffset(250, 54)
	topCurrency.BackgroundColor3 = Color3.new(1, 1, 1)
	topCurrency.BorderSizePixel = 0
	UIKit.Corner(topCurrency, 16)
	UIKit.Gradient(topCurrency, Color3.fromRGB(120, 130, 145), Color3.fromRGB(70, 78, 92))
	UIKit.Stroke(topCurrency, Colors.Ink, 3)
	topCurrency.Parent = root

	UIKit.Icon("Bubble", 40, { Position = UDim2.fromOffset(10, 7), Parent = topCurrency })
	local bubblesValue = UIKit.Label({
		Name = "Value",
		Text = "0",
		TextSize = 38,
		Position = UDim2.fromOffset(58, 0),
		Size = UDim2.new(1, -120, 1, 0),
		TextXAlignment = Enum.TextXAlignment.Center,
		Parent = topCurrency,
	})
	local plusButton = UIKit.Button({
		Name = "Plus",
		Text = "+",
		Size = UDim2.fromOffset(46, 46),
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -6, 0.5, 0),
		Color = Colors.Good,
		TextSize = 34,
		CornerRadius = 10,
		Parent = topCurrency,
		OnClick = function()
			UIKit.OpenWindow("Shop", "Bubbles")
		end,
	})

	-- Count-up animation for the Bubbles number.
	local bubblesNV = Instance.new("NumberValue")
	bubblesNV.Parent = topCurrency
	bubblesNV:GetPropertyChangedSignal("Value"):Connect(function()
		bubblesValue.Text = UIKit.Commas(math.floor(bubblesNV.Value + 0.5))
	end)
	local bubblesShown = -1
	local function setBubbles(value: number)
		value = math.max(0, math.floor((tonumber(value) or 0) + 0.5))
		if value == bubblesShown then
			return
		end
		local increased = bubblesShown &gt;= 0 and value &gt; bubblesShown
		if bubblesShown &lt; 0 then
			bubblesNV.Value = value
			bubblesValue.Text = UIKit.Commas(value)
		else
			UIKit.Tween(bubblesNV, { Value = value }, 0.4)
		end
		bubblesShown = value
		if increased then
			UIKit.Bounce(topCurrency)
		end
	end

	-- Gems pill, to the right of the Bubbles pill.
	local gemsPill = Instance.new("Frame")
	gemsPill.Name = "Gems"
	gemsPill.AnchorPoint = Vector2.new(0, 0)
	gemsPill.Size = UDim2.fromOffset(168, 44)
	gemsPill.BackgroundColor3 = Color3.new(1, 1, 1)
	gemsPill.BorderSizePixel = 0
	UIKit.Corner(gemsPill, 14)
	UIKit.Gradient(gemsPill, Color3.fromRGB(150, 100, 200), Color3.fromRGB(90, 55, 140))
	UIKit.Stroke(gemsPill, Colors.Ink, 3)
	gemsPill.Parent = root
	UIKit.Icon("Gem", 34, { Position = UDim2.fromOffset(6, 5), Parent = gemsPill })
	local gemsValue = UIKit.Label({
		Text = "0",
		TextSize = 28,
		Position = UDim2.fromOffset(44, 0),
		Size = UDim2.new(1, -86, 1, 0),
		TextXAlignment = Enum.TextXAlignment.Center,
		Parent = gemsPill,
	})
	UIKit.Button({
		Name = "Plus",
		Text = "+",
		Size = UDim2.fromOffset(36, 36),
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -4, 0.5, 0),
		Color = Colors.Good,
		TextSize = 28,
		CornerRadius = 9,
		Parent = gemsPill,
		OnClick = function()
			UIKit.OpenWindow("Shop", "Gems")
		end,
	})
	local gemsShown = -1
	local function setGems(value: number)
		value = math.max(0, math.floor(tonumber(value) or 0))
		if value ~= gemsShown then
			if gemsShown &gt;= 0 and value &gt; gemsShown then
				UIKit.Bounce(gemsPill)
			end
			gemsShown = value
			gemsValue.Text = UIKit.Commas(value)
		end
	end

	--------------------------------------------------------------------------------------------------
	-- Right side: a grid of square buttons two wide (Event / Shop / Pets / Ranks / Clubs / Trade in
	-- the lobby; Upgrades / Shop / Pets / Leave in a run), each with a small key hint for keyboard
	-- or gamepad.
	--------------------------------------------------------------------------------------------------
	local SIDE_CELL = 86
	local SIDE_GAP = 10
	local rightColumn = Instance.new("Frame")
	rightColumn.Name = "RightColumn"
	rightColumn.AnchorPoint = Vector2.new(1, 0.5)
	rightColumn.Size = UDim2.fromOffset(SIDE_CELL * 2 + SIDE_GAP, 0)
	rightColumn.AutomaticSize = Enum.AutomaticSize.Y
	rightColumn.BackgroundTransparency = 1
	rightColumn.Parent = root
	local rightLayout = Instance.new("UIGridLayout")
	rightLayout.SortOrder = Enum.SortOrder.LayoutOrder
	rightLayout.CellSize = UDim2.fromOffset(SIDE_CELL, SIDE_CELL)
	rightLayout.CellPadding = UDim2.fromOffset(SIDE_GAP, SIDE_GAP + 4)
	rightLayout.FillDirectionMaxCells = 2
	rightLayout.HorizontalAlignment = Enum.HorizontalAlignment.Right
	rightLayout.Parent = rightColumn

	local hints: { [TextButton]: { Key: string, Pad: string } } = {}
	local function sideButton(icon: string, label: string, color: Color3, keyHint: string, padHint: string, onClick: () -&gt; ()): TextButton
		local b = UIKit.IconButton({
			Icon = icon,
			Label = label,
			Color = color,
			Size = UDim2.fromOffset(SIDE_CELL, SIDE_CELL),
			Parent = rightColumn,
			OnClick = onClick,
		})
		local badge = Instance.new("Frame")
		badge.Name = "KeyHint"
		badge.AnchorPoint = Vector2.new(0, 0)
		badge.Position = UDim2.fromOffset(-8, -8)
		badge.Size = UDim2.fromOffset(34, 28)
		badge.BackgroundColor3 = Colors.PanelDark
		badge.ZIndex = 6
		UIKit.Corner(badge, 8)
		UIKit.Stroke(badge, Colors.Ink, 2)
		UIKit.Label({ Name = "Text", Text = keyHint, TextSize = 16, Size = UDim2.fromScale(1, 1), ZIndex = 7, Parent = badge })
		badge.Parent = b
		hints[b] = { Key = keyHint, Pad = padHint }
		return b
	end

	local upgradesButton = sideButton("@Book", "Upgrades", Colors.Good, "Tab", "Y", function()
		UIKit.ToggleWindow("Upgrades")
	end)
	local shopButton = sideButton("@Bag", "Shop", Colors.Bad, "G", "Y", function()
		UIKit.ToggleWindow("Shop")
	end)
	local petsButton = sideButton("@Pup", "Pets", Colors.Warning, "P", "LB", function()
		UIKit.ToggleWindow("Pets")
	end)
	local ranksButton = sideButton("@Medal", "Ranks", Colors.Accent, "R", "RB", function()
		UIKit.ToggleWindow("Ranks")
	end)
	local leaveButton = sideButton("@Door", "Leave", Colors.PanelLight, "", "", function()
		UIKit.OpenWindow("LeaveConfirm")
	end)
	local clubsButton = sideButton("@Group", "Clubs", Colors.Primary, "C", "", function()
		UIKit.ToggleWindow("Clubs")
	end)
	-- The Treasure Chest event (only while it runs), with a "FREE" tag while a free chest waits.
	-- It (and E) takes you to the chest in the lobby, where the opening happens.
	local eventButton = sideButton("@Chest", "Event", Colors.Coin, "E", "", function()
		(require(script.Parent:WaitForChild("ChestUI")) :: any).GoToChest()
	end)
	local freeTag = Instance.new("Frame")
	freeTag.Name = "FreeTag"
	freeTag.AnchorPoint = Vector2.new(1, 0.5) -- on the top right corner, clear of the "Event" label below the icon
	freeTag.Position = UDim2.new(1, 8, 0, 2)
	freeTag.Size = UDim2.fromOffset(56, 22)
	freeTag.BackgroundColor3 = Colors.Bad
	freeTag.ZIndex = 8
	freeTag.Visible = false
	UIKit.Corner(freeTag, 11)
	UIKit.Stroke(freeTag, Colors.Ink, 2)
	UIKit.Label({ Text = "FREE", TextSize = 15, Size = UDim2.fromScale(1, 1), ZIndex = 9, Parent = freeTag })
	freeTag.Parent = eventButton

	--------------------------------------------------------------------------------------------------
	-- Left column (lobby only): Daily reward (with a "!" when one is waiting), Codes, Free Rewards.
	--------------------------------------------------------------------------------------------------
	local leftColumn = Instance.new("Frame")
	leftColumn.Name = "LeftColumn"
	leftColumn.AnchorPoint = Vector2.new(0, 0.5)
	leftColumn.Size = UDim2.fromOffset(84, 0)
	leftColumn.AutomaticSize = Enum.AutomaticSize.Y
	leftColumn.BackgroundTransparency = 1
	leftColumn.Parent = root
	local leftLayout = Instance.new("UIListLayout")
	leftLayout.SortOrder = Enum.SortOrder.LayoutOrder
	leftLayout.Padding = UDim.new(0, 10)
	leftLayout.Parent = leftColumn
	local function leftButton(order: number, icon: string, label: string, color: Color3, window: string): TextButton
		return UIKit.IconButton({
			Icon = icon,
			Label = label,
			Color = color,
			Size = UDim2.fromOffset(80, 80),
			LayoutOrder = order,
			Parent = leftColumn,
			OnClick = function()
				UIKit.ToggleWindow(window)
			end,
		})
	end
	local dailyButton = leftButton(1, "@Gift", "Daily", Colors.Bubble, "Daily")
	local codesButton = leftButton(2, "@Ticket", "Codes", Colors.Primary, "Codes")
	local freeButton = leftButton(3, "@Love", "Free", Colors.Good, "Free")
	-- Trade lives in the right column (under Ranks), leaving room above Daily for the boost badges.
	local tradeButton = sideButton("@Trade", "Trade", Color3.fromRGB(45, 212, 191), "T", "", function()
		UIKit.ToggleWindow("Trade")
	end)
	-- Music on / off (MusicPlayer). Under Trade; the staff Admin button goes below it.
	local musicButton: TextButton
	musicButton = UIKit.IconButton({
		Name = "MusicButton",
		Icon = "@Notes",
		Label = "Music",
		Color = Colors.PanelLight,
		Size = UDim2.fromOffset(80, 80),
		LayoutOrder = 5,
		Parent = leftColumn,
		OnClick = function()
			local MusicPlayer = require(script.Parent:WaitForChild("MusicPlayer")) :: any
			local on = not MusicPlayer.IsEnabled()
			MusicPlayer.SetEnabled(on)
			local label = musicButton:FindFirstChild("Label", true)
			if label and label:IsA("TextLabel") then
				label.Text = if on then "Music" else "Muted"
			end
			UIKit.SetButtonColor(musicButton, if on then Colors.PanelLight else Colors.Disabled)
		end,
	})
	-- Pets on / off: switched off, your pets just follow you around instead of cleaning (saved).
	-- Only in a run, and only when you have pets out.
	local petsToggle: TextButton
	local function petsToggleWanted(inRun: boolean): boolean
		local meta = ClientState.Meta :: any
		return inRun and meta ~= nil and type(meta.Equipped) == "table" and #meta.Equipped &gt; 0
	end
	local function paintPetsToggle()
		local meta = ClientState.Meta :: any
		local resting = meta ~= nil and meta.PetsResting == true
		local label = petsToggle:FindFirstChild("Label", true)
		if label and label:IsA("TextLabel") then
			label.Text = if resting then "Pets Off" else "Pets On"
		end
		UIKit.SetButtonColor(petsToggle, if resting then Colors.Disabled else Colors.Warning)
	end
	petsToggle = UIKit.IconButton({
		Name = "PetsToggle",
		Icon = "@Pup",
		Label = "Pets On",
		Color = Colors.Warning,
		Size = UDim2.fromOffset(80, 80),
		LayoutOrder = 6,
		Parent = leftColumn,
		OnClick = function()
			local meta = ClientState.Meta :: any
			local resting = not (meta ~= nil and meta.PetsResting == true)
			task.spawn(function()
				local result = ClientState.MetaRequest("SetPetsResting", resting)
				if result.Ok then
					UIKit.Toast(if resting then "Pets off: they'll just follow you." else "Pets on: back to cleaning!", "Info")
				else
					UIKit.Toast(result.Error or "Couldn't change that.", "Bad")
				end
			end)
		end,
	})
	ClientState.Changed:Connect(function(kind)
		if kind == "Meta" then
			paintPetsToggle()
		end
	end)
	paintPetsToggle()

	local function makeAdminButton()
		if adminButton or not adminClick then
			return
		end
		adminButton = UIKit.IconButton({
			Name = "AdminButton",
			Icon = "@Gavel",
			Label = "Admin",
			Color = Colors.PanelLight,
			Size = UDim2.fromOffset(80, 80),
			LayoutOrder = 7, -- bottom of the left column, under Music / Pets On
			Parent = leftColumn,
			OnClick = function()
				if adminClick then
					adminClick()
				end
			end,
		})
		local inRun = ClientState.Run ~= nil
		dailyButton.Visible = true
		codesButton.Visible = not inRun
		freeButton.Visible = not inRun
		tradeButton.Visible = not inRun
		musicButton.Visible = true
		petsToggle.Visible = petsToggleWanted(inRun) -- in the lobby pets only ever follow you
		leftColumn.Visible = true
	end
	addAdminButton = makeAdminButton
	makeAdminButton()
	local dailyDot = Instance.new("Frame")
	dailyDot.Name = "Ready"
	dailyDot.AnchorPoint = Vector2.new(0.5, 0.5)
	dailyDot.Position = UDim2.new(1, -4, 0, 4)
	dailyDot.Size = UDim2.fromOffset(28, 28)
	dailyDot.BackgroundColor3 = Colors.Bad
	dailyDot.ZIndex = 8
	dailyDot.Visible = false
	UIKit.Corner(dailyDot, 14)
	UIKit.Stroke(dailyDot, Colors.Ink, 2)
	UIKit.Label({ Text = "!", TextSize = 20, Size = UDim2.fromScale(1, 1), ZIndex = 9, Parent = dailyDot })
	dailyDot.Parent = dailyButton
	task.spawn(function()
		local DailyUI = require(script.Parent:WaitForChild("DailyUI")) :: any
		while true do
			dailyDot.Visible = DailyUI.Ready()
			task.wait(1)
		end
	end)

	--------------------------------------------------------------------------------------------------
	-- Hotbar (in a run): one slot per tool. Owned tools can be put in your hand (click / tap, keys
	-- 1-6, gamepad D-pad left/right); locked ones show a lock and open the Upgrade Book.
	--------------------------------------------------------------------------------------------------
	local SLOT = 68
	local hotbar = Instance.new("Frame")
	hotbar.Name = "Hotbar"
	hotbar.AnchorPoint = Vector2.new(0.5, 1)
	hotbar.Size = UDim2.fromOffset(#Config.Tools * (SLOT + 8), SLOT + 18)
	hotbar.BackgroundTransparency = 1
	hotbar.Visible = false
	hotbar.Parent = root
	local hotbarLayout = Instance.new("UIListLayout")
	hotbarLayout.FillDirection = Enum.FillDirection.Horizontal
	hotbarLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	hotbarLayout.VerticalAlignment = Enum.VerticalAlignment.Bottom
	hotbarLayout.SortOrder = Enum.SortOrder.LayoutOrder
	hotbarLayout.Padding = UDim.new(0, 8)
	hotbarLayout.Parent = hotbar

	local equipping = false
	local function equipTool(index: number)
		local run = ClientState.Run :: Types.RunState?
		if not run or equipping then
			return
		end
		if not (run.OwnedTools and run.OwnedTools[index]) then
			-- Not yours yet: buy it (or get offered its pass if you're short of coins).
			local ShopUI = require(script.Parent:WaitForChild("ShopUI")) :: any
			local result = ShopUI.GetTool(index)
			if result and not result.Ok then
				UIKit.Toast(result.Error or "Can't buy that yet.", "Bad")
			end
			return
		end
		if run.ToolIndex == index then
			return
		end
		equipping = true
		local result = ClientState.RunRequest("EquipTool", index)
		equipping = false
		if not result.Ok then
			UIKit.Toast(result.Error or "Can't use that yet.", "Bad")
		end
	end

	local slots: { TextButton } = {}
	for i, tool in Config.Tools do
		local slot = UIKit.IconButton({
			Name = "Slot" .. i,
			Icon = tool.Icon,
			Label = "",
			Color = Colors.PanelLight,
			Size = UDim2.fromOffset(SLOT, SLOT),
			LayoutOrder = i,
			Parent = hotbar,
			OnClick = function()
				task.spawn(equipTool, i)
			end,
		})
		local num = UIKit.Label({ Name = "Key", Text = tostring(i), TextSize = 16, Position = UDim2.fromOffset(6, 2), Size = UDim2.fromOffset(16, 18), ZIndex = 8, Parent = slot })
		num.TextXAlignment = Enum.TextXAlignment.Left
		slots[i] = slot
	end

	local function refreshHotbar()
		local run = ClientState.Run :: Types.RunState?
		for i, slot in slots do
			local owned = run ~= nil and run.OwnedTools ~= nil and run.OwnedTools[i] == true
			local inHand = run ~= nil and run.ToolIndex == i
			slot.BackgroundColor3 = if inHand then Colors.Good elseif owned then Colors.Primary else Colors.PanelDark
			slot:SetAttribute("Icon", if owned then Config.Tools[i].Icon else "🔒")
			UIKit.Bounce(slot)
		end
	end
	local lastHotbarKey = ""
	local function hotbarKey(): string
		local run = ClientState.Run :: Types.RunState?
		if not run then
			return ""
		end
		local parts = { tostring(run.ToolIndex) }
		for i in Config.Tools do
			table.insert(parts, if run.OwnedTools and run.OwnedTools[i] then "1" else "0")
		end
		return table.concat(parts)
	end

	local function refreshHints()
		local touch = UIKit.IsTouch()
		local pad = UIKit.IsGamepad()
		for button, hint in hints do
			local badge = button:FindFirstChild("KeyHint") :: Frame?
			if badge then
				local text = if pad then hint.Pad else hint.Key
				badge.Visible = not touch and text ~= ""
				local lbl = badge:FindFirstChild("Text") :: TextLabel?
				if lbl then
					lbl.Text = text
				end
				badge.Size = UDim2.fromOffset(math.max(28, 12 + #text * 10), 28)
			end
		end
	end

	--------------------------------------------------------------------------------------------------
	-- In-run corner widgets: money + tank bottom-left, timer bottom-right.
	--------------------------------------------------------------------------------------------------
	local moneyBlock = Instance.new("Frame")
	moneyBlock.Name = "Money"
	moneyBlock.AnchorPoint = Vector2.new(0, 1)
	moneyBlock.Size = UDim2.fromOffset(300, 150)
	moneyBlock.BackgroundTransparency = 1
	moneyBlock.Visible = false
	moneyBlock.Parent = root

	UIKit.Icon("Coin", 50, { Position = UDim2.fromOffset(0, 6), Parent = moneyBlock })
	local coinsLabel = UIKit.Label({
		Name = "Coins",
		Text = "0",
		TextSize = 54,
		Position = UDim2.fromOffset(58, 0),
		Size = UDim2.new(1, -58, 0, 62),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Color3.fromRGB(90, 235, 110),
		StrokeThickness = 3,
		Parent = moneyBlock,
	})
	-- Green "+" right after the number: opens the shop on the Coins tab.
	local coinsPlus = UIKit.Button({
		Name = "CoinsPlus",
		Text = "+",
		Size = UDim2.fromOffset(44, 44),
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromOffset(200, 31),
		Color = Colors.Good,
		TextSize = 32,
		CornerRadius = 10,
		Parent = moneyBlock,
		OnClick = function()
			UIKit.OpenWindow("Shop", "Coins")
		end,
	})
	coinsLabel:GetPropertyChangedSignal("TextBounds"):Connect(function()
		coinsPlus.Position = UDim2.fromOffset(math.floor(coinsLabel.TextBounds.X / UIKit.GetScale()) + 12 + 58, 31)
	end)
	local coinsNV = Instance.new("NumberValue")
	coinsNV.Parent = moneyBlock
	coinsNV:GetPropertyChangedSignal("Value"):Connect(function()
		coinsLabel.Text = UIKit.Commas(math.floor(coinsNV.Value + 0.5))
	end)
	local coinsShown = -1
	local function setCoins(value: number)
		value = math.max(0, math.floor((tonumber(value) or 0) + 0.5))
		if value == coinsShown then
			return
		end
		local increased = coinsShown &gt;= 0 and value &gt; coinsShown
		if coinsShown &lt; 0 then
			coinsNV.Value = value
		else
			UIKit.Tween(coinsNV, { Value = value }, 0.4)
		end
		coinsShown = value
		if increased then
			UIKit.Bounce(coinsLabel)
		end
	end

	UIKit.Icon("Drop", 40, { Position = UDim2.fromOffset(2, 72), Parent = moneyBlock })
	local tankBar = UIKit.ProgressBar({
		Size = UDim2.new(0, 240, 0, 44),
		Position = UDim2.fromOffset(48, 70),
		Color = Colors.Primary,
		Text = "0/0",
		TextSize = 24,
		Parent = moneyBlock,
	})
	tankBar.Frame.Name = "Tank"

	-- Bubble-jet fuel (BubbleJets writes the LocalPlayer's JetFuel attribute, 0..1).
	local jetBar = UIKit.ProgressBar({
		Size = UDim2.new(0, 280, 0, 26),
		Position = UDim2.fromOffset(0, 122),
		Color = Color3.fromRGB(150, 215, 255),
		Text = "Hold jump to fly",
		TextSize = 16,
		Value = 1,
		Parent = moneyBlock,
	})
	jetBar.Frame.Name = "JetFuel"
	local lastJet = 1
	Players.LocalPlayer:GetAttributeChangedSignal("JetFuel"):Connect(function()
		local f = tonumber(Players.LocalPlayer:GetAttribute("JetFuel")) or 1
		if math.abs(f - lastJet) &gt; 0.02 or (f &gt;= 1 and lastJet &lt; 1) then
			lastJet = f
			jetBar.Set(f, if f &lt;= 0.01 then "Land to refill" else "Hold jump to fly")
		end
	end)

	local tankFlash: Tween? = nil
	local function setTankFull(isFull: boolean)
		if isFull and not tankFlash then
			tankBar.SetColor(Colors.Bad)
			local info = TweenInfo.new(0.4, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)
			local tw = TweenService:Create(tankBar.Fill, info, { BackgroundTransparency = 0.55 })
			tankFlash = tw
			tw:Play()
		elseif not isFull and tankFlash then
			tankFlash:Cancel()
			tankFlash = nil
			tankBar.Fill.BackgroundTransparency = 0
			tankBar.SetColor(Colors.Primary)
		end
	end

	local timerLabel = UIKit.Label({
		Name = "Timer",
		Text = "00:00:00",
		TextSize = 48,
		AnchorPoint = Vector2.new(1, 1),
		Size = UDim2.fromOffset(260, 56),
		TextXAlignment = Enum.TextXAlignment.Right,
		Visible = false,
		Parent = root,
	})

	--------------------------------------------------------------------------------------------------
	-- Top centre, in-run: dishwasher name and cleaning progress (under the currency pill).
	--------------------------------------------------------------------------------------------------
	local topBar = Instance.new("Frame")
	topBar.Name = "TopBar"
	topBar.AnchorPoint = Vector2.new(0.5, 0)
	topBar.Size = UDim2.new(0, 460, 0, 70)
	topBar.BackgroundTransparency = 1
	topBar.Visible = false
	topBar.Parent = root

	local levelLabel = UIKit.Label({
		Text = "",
		Size = UDim2.new(1, 0, 0, 28),
		TextSize = 22,
		TextXAlignment = Enum.TextXAlignment.Center,
		Parent = topBar,
	})
	local progressBar = UIKit.ProgressBar({
		Size = UDim2.new(0, 400, 0, 32),
		Position = UDim2.new(0.5, 0, 0, 32),
		AnchorPoint = Vector2.new(0.5, 0),
		Color = Colors.Good,
		Parent = topBar,
	})

	--------------------------------------------------------------------------------------------------
	-- Layout: keeps everything inside the safe area and clear of the touch thumbstick/jump zones.
	--------------------------------------------------------------------------------------------------
	local function relayoutHud()
		local canvas = UIKit.CanvasSize()
		local inset = UIKit.TopInset()
		local safe = UIKit.SafeInsets()
		local touch = UIKit.IsTouch()

		-- The pill sits in the topbar row itself (the middle of Roblox's topbar is empty), like the
		-- big simulators do; the run's progress bar goes right under it.
		topCurrency.Position = UDim2.new(0.5, 0, 0, 2)
		gemsPill.Position = UDim2.new(0.5, 133, 0, 7)
		hotbar.Position = UDim2.new(0.5, 0, 1, -(if touch then 24 else 12) - safe.Bottom)
		topBar.Position = UDim2.new(0.5, 0, 0, 72)

		-- Right column: vertically centred, but on touch kept above the jump button.
		local colH = rightColumn.AbsoluteSize.Y / UIKit.GetScale()
		local centerY = canvas.Y / 2
		if touch then
			centerY = math.min(centerY, canvas.Y - 300 - colH / 2)
		end
		centerY = math.max(centerY, inset + 80 + colH / 2)
		-- PC: Roblox's own player list (top right; games can't move it) grows down by a row per
		-- player. Keep Shop / Pets / Ranks below it while there's room (the list scrolls itself
		-- once it's long). Phones and consoles keep it closed until opened from the menu.
		if not touch and not UserInputService.GamepadEnabled and ClientState.Run == nil then
			local listPx = 48 + 40 * #Players:GetPlayers() -- the list is drawn in real pixels
			local below = inset + listPx / UIKit.GetScale() + 14 + colH / 2
			centerY = math.max(centerY, math.min(below, canvas.Y - 12 - safe.Bottom - colH / 2))
		end
		-- The side columns only keep half of the notch / rounded-corner inset: close to the edges on
		-- phones, still clear of the notch itself.
		local sideLeft = 12 + math.floor(safe.Left * 0.5)
		local sideRight = 12 + math.floor(safe.Right * 0.5)
		rightColumn.Position = UDim2.new(1, -sideRight, 0, math.floor(centerY))
		-- Left column: mirrors the right one (above the thumbstick on touch).
		local leftH = leftColumn.AbsoluteSize.Y / UIKit.GetScale()
		local leftY = canvas.Y / 2
		if touch then
			leftY = math.min(leftY, canvas.Y - 300 - leftH / 2)
		end
		-- Money block: bottom-left on desktop/console; above the thumbstick on touch.
		local bottom = canvas.Y - (if touch then 20 else 16) - safe.Bottom
		moneyBlock.Position = UDim2.new(0, 20 + safe.Left, 0, math.floor(bottom))
		-- In a run the column (the owner's Admin button) stays clear above the money block.
		if moneyBlock.Visible then
			leftY = math.min(leftY, bottom - moneyBlock.Size.Y.Offset - 16 - leftH / 2)
		end
		leftY = math.max(leftY, inset + 80 + leftH / 2)
		-- The boost badges stack above the column (StayOffer): off touch, slide the column down so
		-- they fit (on phones they go beside the column instead).
		local badgeH = tonumber(LocalPlayer:GetAttribute("BadgeStackHeight")) or 0
		if badgeH &gt; 0 and not touch then
			local wanted = inset + 12 + badgeH + 10 + leftH / 2
			local lowest = (if moneyBlock.Visible then bottom - moneyBlock.Size.Y.Offset - 16 else canvas.Y - 16 - safe.Bottom) - leftH / 2
			leftY = math.max(leftY, math.min(wanted, lowest))
		end
		leftColumn.Position = UDim2.new(0, sideLeft, 0, math.floor(leftY))

		-- Timer: bottom-right on desktop/console; top-right under the topbar on touch.
		if touch then
			-- Phones: centred under the progress bar (the corners hold Roblox's buttons and the
			-- jump button).
			timerLabel.AnchorPoint = Vector2.new(0.5, 0)
			timerLabel.TextSize = 30
			timerLabel.Position = UDim2.new(0.5, 0, 0, 72 + 70 + 2)
		else
			timerLabel.AnchorPoint = Vector2.new(1, 1)
			timerLabel.TextSize = 48
			timerLabel.Position = UDim2.new(1, -(20 + safe.Right), 1, -(12 + safe.Bottom))
		end
		-- Pop-ups start below the progress bar (and the phone timer) while cleaning.
		UIKit.SetToastTop(if topBar.Visible then (if touch then 182 else 146) else 0)
		refreshHints()
	end
	rightColumn:GetPropertyChangedSignal("AbsoluteSize"):Connect(relayoutHud)
	Players.PlayerAdded:Connect(relayoutHud)
	LocalPlayer:GetAttributeChangedSignal("BadgeStackHeight"):Connect(relayoutHud)
	Players.PlayerRemoving:Connect(function()
		task.defer(relayoutHud)
	end)
	leftColumn:GetPropertyChangedSignal("AbsoluteSize"):Connect(relayoutHud)
	moneyBlock:GetPropertyChangedSignal("Visible"):Connect(relayoutHud)

