local function guest(shirt: Color3, pants: Color3, hair: Color3, long: boolean, hat1: Color3, hat2: Color3, scale: number?): Look
	return {
		Shirt = shirt, Pants = pants, Sleeves = "short", Scale = scale,
		Build = function(a)
			if long then
				hairLong(hair)(a)
			else
				hairShort(hair)(a)
			end
			partyHat(a, hat1, hat2)
		end,
	}
end
