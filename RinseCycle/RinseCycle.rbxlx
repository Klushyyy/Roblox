		{ "rect", x = 0.25, y = 0.55, w = 0.2, h = 0.74, r = 0.18, fill = { rgb(214, 150, 92), rgb(160, 100, 56) }, o = true },
		{ "disc", x = 0.31, y = 0.57, d = 0.07, fill = rgb(255, 214, 90) },
		"|",
		{ "rect", x = 0.66, y = 0.5, w = 0.3, h = 0.11, r = 0.5, fill = red, o = true },
