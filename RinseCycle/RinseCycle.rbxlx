end

----------------------------------------------------------------------------------------------------
-- Hatch reveal animation (its own high-DisplayOrder ScreenGui, per DESIGN.md)
----------------------------------------------------------------------------------------------------

local hatchGui: ScreenGui
local hatchRoot: Frame
local hatchDarken: Frame
local hatchEggHolder: Frame
local hatchEggViewport: ViewportFrame
local hatchFlash: Frame
local hatchCardsHolder: Frame
local hatchClickCatcher: TextButton
local hatchToken = 0
-- "wobble" while the egg is shaking, "revealed" once the cards are up (click closes instead of skips).
local hatchPhase: string? = nil

local function bestRarity(pets: { Types.PetEntry })
	local best = "Common"
	local bestOrder = 0
	for _, pet in pets do
		local def = petDef(pet.Id)
		local order = rarityOrder(def.Rarity)
		if order &gt; bestOrder then
			bestOrder = order
			best = def.Rarity
		end
	end
	return best
end

local function buildHatchCard(parent: Instance, pet: Types.PetEntry, index: number, total: number)
	local def = petDef(pet.Id)
	local color = UIKit.RarityColor(def.Rarity)
	local isEpicPlus = rarityOrder(def.Rarity) &gt;= rarityOrder("Epic")

	local width = if total &gt; 1 then 220 else 280
	local card = Instance.new("Frame")
	card.Name = "Card" .. index
	card.AnchorPoint = Vector2.new(0.5, 0.5)
	card.Size = UDim2.fromOffset(width, 320)
	card.BackgroundTransparency = 1
	card.LayoutOrder = index
	card.Parent = parent

	if isEpicPlus then
		local glow = Instance.new("ImageLabel")
		glow.Name = "Glow"
		glow.AnchorPoint = Vector2.new(0.5, 0.5)
		glow.Position = UDim2.fromScale(0.5, 0.5)
		glow.Size = UDim2.fromOffset(width + 120, 440)
		glow.BackgroundTransparency = 1
		glow.Image = "rbxasset://textures/particles/forcefield_glow_main.dds"
		glow.ImageColor3 = color
		glow.ImageTransparency = 0.35
		glow.ZIndex = 1
		glow.Parent = card
		local pulse = UIKit.Tween(glow, { ImageTransparency = 0.6 }, 0.9)
		pulse.Completed:Connect(function()
			if glow.Parent then
				UIKit.Tween(glow, { ImageTransparency = 0.35 }, 0.9)
			end
		end)
	end

	local panel = UIKit.Card({
		Size = UDim2.new(1, 0, 1, 0),
		Color = C.PanelDark,
		StrokeColor = color,
		Parent = card,
	})
	panel.ZIndex = 2
	local panelStroke = panel:FindFirstChildOfClass("UIStroke")
	if panelStroke then
		panelStroke.Thickness = 4
	end

	UIKit.Viewport({
		Model = PetModels.Build(pet.Id),
		Size = UDim2.fromOffset(width - 40, 200),
		Position = UDim2.new(0.5, 0, 0, 16),
		AnchorPoint = Vector2.new(0.5, 0),
		Spin = true,
		Parent = panel,
		ZIndex = 3,
	})
	UIKit.Label({
		Text = def.Name,
		Size = UDim2.new(1, -16, 0, 32),
		Position = UDim2.new(0.5, 0, 0, 226),
		AnchorPoint = Vector2.new(0.5, 0),
		TextSize = 26,
		TextScaled = true,
		Parent = panel,
		ZIndex = 3,
	})
	UIKit.Label({
		Text = def.Rarity,
		Size = UDim2.new(1, -16, 0, 26),
		Position = UDim2.new(0.5, 0, 0, 262),
		AnchorPoint = Vector2.new(0.5, 0),
		TextSize = 20,
		TextColor3 = color,
		Parent = panel,
		ZIndex = 3,
	})

	-- Pop in, staggered per card.
	card.Position = UDim2.fromScale(0.5, 0.6)
	local scaler = Instance.new("UIScale")
	scaler.Scale = 0.2
	scaler.Parent = card
	task.delay((index - 1) * 0.12, function()
		if not card.Parent then
			return
		end
		UIKit.Tween(scaler, { Scale = 1 }, 0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	end)
	return card
end

local function layoutHatchCards(count: number)
	local layout = hatchCardsHolder:FindFirstChildOfClass("UIListLayout")
	if not layout then
		layout = Instance.new("UIListLayout")
		layout.FillDirection = Enum.FillDirection.Horizontal
		layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
		layout.VerticalAlignment = Enum.VerticalAlignment.Center
		layout.Padding = UDim.new(0, if count &gt; 1 then 20 else 0)
		layout.Parent = hatchCardsHolder
	else
		layout.Padding = UDim.new(0, if count &gt; 1 then 20 else 0)
	end
end

local function ensureHatchGui()
	if hatchGui then
		return
	end
	hatchGui, hatchRoot = UIKit.CreateScreen("PetsHatch", 60)

	hatchDarken = Instance.new("Frame")
	hatchDarken.Name = "Darken"
	hatchDarken.Size = UDim2.fromScale(1, 1)
	hatchDarken.BackgroundColor3 = Color3.new(0, 0, 0)
	hatchDarken.BackgroundTransparency = 1
	hatchDarken.Visible = false
	hatchDarken.ZIndex = 1
	hatchDarken.Parent = hatchRoot

	hatchEggHolder = Instance.new("Frame")
	hatchEggHolder.Name = "EggHolder"
	hatchEggHolder.AnchorPoint = Vector2.new(0.5, 0.5)
	hatchEggHolder.Position = UDim2.fromScale(0.5, 0.5)
	hatchEggHolder.Size = UDim2.fromOffset(260, 260)
	hatchEggHolder.BackgroundTransparency = 1
	hatchEggHolder.Visible = false
	hatchEggHolder.ZIndex = 2
	hatchEggHolder.Parent = hatchRoot
	hatchEggViewport = UIKit.Viewport({
		Size = UDim2.fromScale(1, 1),
		Parent = hatchEggHolder,
		ZIndex = 2,
	})

	hatchCardsHolder = Instance.new("Frame")
	hatchCardsHolder.Name = "Cards"
	hatchCardsHolder.AnchorPoint = Vector2.new(0.5, 0.5)
	hatchCardsHolder.Position = UDim2.fromScale(0.5, 0.5)
	hatchCardsHolder.Size = UDim2.new(1, -40, 0, 360)
	hatchCardsHolder.BackgroundTransparency = 1
	hatchCardsHolder.Visible = false
	hatchCardsHolder.ZIndex = 2
	hatchCardsHolder.Parent = hatchRoot

	hatchFlash = Instance.new("Frame")
	hatchFlash.Name = "Flash"
	hatchFlash.Size = UDim2.fromScale(1, 1)
	hatchFlash.BackgroundColor3 = Color3.new(1, 1, 1)
	hatchFlash.BackgroundTransparency = 1
	hatchFlash.ZIndex = 3
	hatchFlash.Parent = hatchRoot

	hatchClickCatcher = Instance.new("TextButton")
	hatchClickCatcher.Name = "ClickCatcher"
	hatchClickCatcher.Size = UDim2.fromScale(1, 1)
	hatchClickCatcher.BackgroundTransparency = 1
	hatchClickCatcher.Text = ""
	hatchClickCatcher.AutoButtonColor = false
	hatchClickCatcher.ZIndex = 4
	hatchClickCatcher.Visible = false
	hatchClickCatcher.Parent = hatchRoot
	hatchClickCatcher.Activated:Connect(function()
		if hatchPhase == "wobble" then
			hatchToken += 1 -- cancel the wobble/flash coroutine; it jumps straight to the reveal
			PetsUI._revealNow()
		elseif hatchPhase == "revealed" then
			PetsUI._closeHatch()
		end
	end)
end

function PetsUI._closeHatch()
	hatchToken += 1
	hatchPhase = nil
	hatchRoot.Visible = false
	hatchDarken.Visible = false
	hatchEggHolder.Visible = false
	hatchCardsHolder.Visible = false
	hatchClickCatcher.Visible = false
	for _, child in hatchCardsHolder:GetChildren() do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
end

local pendingReveal: { Types.PetEntry }? = nil -- captured so a skip click can jump straight to the reveal

function PetsUI._revealNow()
	if not pendingReveal then
		return
	end
	local pets = pendingReveal
	pendingReveal = nil
	hatchPhase = "revealed"
	hatchEggHolder.Visible = false
	hatchFlash.BackgroundTransparency = 1
	hatchDarken.BackgroundTransparency = 0.55

	for _, child in hatchCardsHolder:GetChildren() do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
	layoutHatchCards(#pets)
	hatchCardsHolder.Visible = true
	local order = 0
	for _, pet in pets do
		order += 1
		buildHatchCard(hatchCardsHolder, pet, order, #pets)
	end
end

-- Plays the wobble -&gt; flash -&gt; reveal sequence for a completed hatch. `pets` is the RequestResult's
-- Pets list (already added to the profile server-side).
function PetsUI.PlayHatchAnimation(eggId: string, pets: { Types.PetEntry })
	ensureHatchGui()
	if #pets == 0 then
		return
	end
	hatchToken += 1
	local token = hatchToken
	pendingReveal = pets
	hatchPhase = "wobble"

	hatchRoot.Visible = true
	hatchClickCatcher.Visible = true
	hatchDarken.Visible = true
	hatchDarken.BackgroundTransparency = 1
	UIKit.Tween(hatchDarken, { BackgroundTransparency = 0.55 }, 0.2)

	hatchEggHolder.Visible = true
	hatchEggHolder.Rotation = 0
	UIKit.SetViewportModel(hatchEggViewport, PetModels.Egg(eggId), true)
	hatchCardsHolder.Visible = false

	UIKit.PlaySound("Hatch")

	task.spawn(function()
		-- Three wobbles of rising intensity.
		for wobble = 1, 3 do
			if hatchToken ~= token then
				return
			end
			local angle = 6 * wobble
			local time = 0.16
			hatchEggHolder.Rotation = 0
			local a = UIKit.Tween(hatchEggHolder, { Rotation = angle }, time)
			a.Completed:Wait()
			if hatchToken ~= token then
				return
			end
			local b = UIKit.Tween(hatchEggHolder, { Rotation = -angle }, time * 2, Enum.EasingStyle.Sine)
			b.Completed:Wait()
			if hatchToken ~= token then
				return
			end
			local c = UIKit.Tween(hatchEggHolder, { Rotation = 0 }, time)
			c.Completed:Wait()
			if hatchToken ~= token then
				return
			end
			task.wait(0.08)
		end
		if hatchToken ~= token then
			return
		end

		-- Flash tinted by the best rarity hatched.
		local color = UIKit.RarityColor(bestRarity(pets))
		hatchFlash.BackgroundColor3 = color
		hatchFlash.BackgroundTransparency = 1
		local up = UIKit.Tween(hatchFlash, { BackgroundTransparency = 0.05 }, 0.12)
		up.Completed:Wait()
		if hatchToken ~= token then
			return
		end
		task.wait(0.05)
		UIKit.Tween(hatchFlash, { BackgroundTransparency = 1 }, 0.35)

		if hatchToken ~= token then
			return
		end
		PetsUI._revealNow()
	end)
end

----------------------------------------------------------------------------------------------------
-- Init
----------------------------------------------------------------------------------------------------

function PetsUI.Init()
	if initialized then
		return
	end
	initialized = true

	local _gui
	_gui, root = UIKit.CreateScreen("PetsUI", 10)

	buildPetsWindow()
	buildEggsWindow()
	ensureHatchGui()

	ClientState.Changed:Connect(function(kind: string)
		if kind ~= "Meta" then
			return
		end
		if UIKit.IsWindowOpen("Pets") then
			PetsUI._refreshGrid()
		end
		if UIKit.IsWindowOpen("Eggs") then
			PetsUI._refreshEggButtons()
		end
	end)
end

return PetsUI</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000040"><Properties><string name="Name">PollUI</string><ProtectedString name="Source">--[[
	PollUI - the community poll card (admin panel &gt; Global &gt; Poll, AdminServer "GlobalPoll").

	  * A poll starts: a card comes up near the bottom with the question, an answer button each and
	    a countdown. Tap an answer to vote (tap another to change your mind).
	  * Once you've voted the card tucks itself away, leaving a small "POLL" tab with an up arrow to
	    bring it back.
	  * When every server's votes are in ("Result"), the card comes back up as POLL FINISHED with the
	    results (answer, votes, percent) and an X. Closed, it's gone for good.
	  * It sits under every window (and hides while one is open).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Client = script.Parent
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local UIKit = require(Client:WaitForChild("UIKit"))

local PollUI = {}

local Colors = UIKit.Theme.Colors

local CARD_H = 180
local TAB_H = 34

local initialized = false

-- The event countdown pill (admin panel &gt; Global &gt; Event countdown): top-left, under every window.
-- "ADMIN ABUSE starts in 23:59:30", then "ADMIN ABUSE IS LIVE NOW!" for the hour after.
local function setupCountdown()
	local remote = ReplicatedStorage:WaitForChild("GlobalCountdown", 30)
	if not remote then
		return
	end
	local _gui, root = UIKit.CreateScreen("EventCountdown", 7)
	local pill = Instance.new("Frame")
	pill.Name = "Countdown"
	pill.Size = UDim2.fromOffset(300, 46)
	pill.BackgroundColor3 = Colors.PanelDark
	pill.Visible = false
	UIKit.Corner(pill, 14)
	local stroke = UIKit.Stroke(pill, Colors.Coin, 3, 0)
	pill.Parent = root
	local title = UIKit.Label({ Text = "", TextSize = 15, TextScaled = true, TextColor3 = Colors.Coin, Position = UDim2.fromOffset(8, 3), Size = UDim2.new(1, -16, 0, 18), Parent = pill })
	local clock = UIKit.Label({ Text = "", TextSize = 22, Position = UDim2.fromOffset(8, 20), Size = UDim2.new(1, -16, 0, 24), Parent = pill })
	local info: { Name: string, EndsAt: number, Live: number }? = nil
	remote.OnClientEvent:Connect(function(kind, name, endsAt, liveMinutes)
		if kind == "Set" and type(name) == "string" and type(endsAt) == "number" then
			info = { Name = string.upper(name), EndsAt = endsAt, Live = (tonumber(liveMinutes) or 60) * 60 }
		else
			info = nil
		end
	end)
	task.spawn(function()
		while true do
			local current = info
			local nowT = Config.Now()
			if current and nowT &lt; current.EndsAt + current.Live then
				local inset = UIKit.TopInset()
				local safe = UIKit.SafeInsets()
				pill.Position = UDim2.fromOffset(16 + math.floor(safe.Left * 0.5), math.floor(inset + 8))
				pill.Visible = true
				if nowT &lt; current.EndsAt then
					local left = current.EndsAt - nowT
					title.Text = current.Name .. " STARTS IN"
					title.TextColor3 = Colors.Coin
					stroke.Color = Colors.Coin
					clock.Text = if left &gt;= 86400
						then string.format("%dd %02d:%02d:%02d", left // 86400, (left % 86400) // 3600, (left % 3600) // 60, left % 60)
						else string.format("%02d:%02d:%02d", left // 3600, (left % 3600) // 60, left % 60)
				else
					title.Text = current.Name
					title.TextColor3 = Colors.Good
					stroke.Color = Colors.Good
					clock.Text = "IS LIVE NOW!"
				end
			else
				pill.Visible = false
			end
			task.wait(0.5)
		end
	end)
end

function PollUI.Init()
	if initialized then
		return
	end
	initialized = true
	task.spawn(setupCountdown)

	-- Display order 8: under every window (10+), over the HUD.
	local _gui, root = UIKit.CreateScreen("PollUI", 8)
	local holder = Instance.new("Frame")
	holder.Name = "PollHolder"
	holder.AnchorPoint = Vector2.new(0.5, 1)
	holder.Position = UDim2.new(0.5, 0, 1, -110)
	holder.Size = UDim2.fromOffset(480, CARD_H + TAB_H)
	holder.BackgroundTransparency = 1
	holder.ClipsDescendants = true
	holder.Visible = false
	holder.Parent = root

	local slider = Instance.new("Frame")
	slider.Name = "Slider"
	slider.BackgroundTransparency = 1
	slider.Size = UDim2.new(1, 0, 0, CARD_H + TAB_H)
	slider.Parent = holder

	-- The pull tab (only while tucked away).
	local tab = Instance.new("TextButton")
	tab.Name = "PullTab"
	tab.Text = ""
	tab.AutoButtonColor = false
	tab.AnchorPoint = Vector2.new(0.5, 0)
	tab.Position = UDim2.new(0.5, 0, 0, 0)
	tab.Size = UDim2.fromOffset(150, TAB_H + 12)
	tab.BackgroundColor3 = Colors.Primary
	UIKit.Corner(tab, 12)
	UIKit.Stroke(tab, Colors.Ink, 2)
	local tabLabel = UIKit.Label({ Text = "POLL  ^", TextSize = 18, Size = UDim2.new(1, 0, 0, TAB_H), Parent = tab })
	tab.Parent = slider

	local card = UIKit.Card({
		Name = "Poll",
		Position = UDim2.fromOffset(0, TAB_H),
		Size = UDim2.new(1, 0, 0, CARD_H),
		Color = Colors.PanelDark,
		Parent = slider,
	})
	UIKit.Stroke(card, Colors.Primary, 3, 0)
	local title = UIKit.Label({ Text = "POLL", TextSize = 16, TextColor3 = Colors.Primary, Position = UDim2.fromOffset(14, 6), Size = UDim2.fromOffset(200, 20), TextXAlignment = Enum.TextXAlignment.Left, Parent = card })
	local timer = UIKit.Label({ Text = "", TextSize = 16, TextColor3 = Colors.TextDim, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -52, 0, 6), Size = UDim2.fromOffset(150, 20), TextXAlignment = Enum.TextXAlignment.Right, Parent = card })
	local question = UIKit.Label({ Text = "", TextSize = 20, TextWrapped = true, TextScaled = true, Position = UDim2.fromOffset(14, 30), Size = UDim2.new(1, -28, 0, 44), Parent = card })
	local row = Instance.new("Frame")
	row.Name = "Answers"
	row.BackgroundTransparency = 1
	row.Position = UDim2.fromOffset(14, 82)
	row.Size = UDim2.new(1, -28, 0, 86)
	row.Parent = card
	local layout = Instance.new("UIGridLayout")
	layout.CellPadding = UDim2.fromOffset(8, 8)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = row
	local hideButton = UIKit.Button({
		Text = "v",
		Color = Colors.PanelLight,
		TextSize = 16,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -8, 0, 6),
		Size = UDim2.fromOffset(36, 30),
		Parent = card,
	})

	local currentId: string? = nil
	local endsAt = 0
	local phase = "None" -- "Voting" | "Counting" | "Result"
	local closed: { [string]: boolean } = {}
	local buttons: { GuiObject } = {}

	local voteRemote = ReplicatedStorage:WaitForChild("GlobalPollVote", 30)
	local pollRemote = ReplicatedStorage:WaitForChild("GlobalPoll", 30)
	if not pollRemote or not voteRemote then
		return
	end

	local function setTucked(value: boolean, instant: boolean?)
		tab.Visible = value
		local y = if value then CARD_H else 0
		local goal = { Position = UDim2.fromOffset(0, y) }
		if instant then
			slider.Position = goal.Position
		else
			TweenService:Create(slider, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), goal):Play()
		end
	end

	local function clearAnswers()
		for _, b in buttons do
			b:Destroy()
		end
		table.clear(buttons)
	end

	local function showVoting(id: string, text: string, options: { string }, closesAt: number)
		currentId = id
		endsAt = closesAt
		phase = "Voting"
		title.Text = "POLL"
		title.TextColor3 = Colors.Primary
		question.Text = text
		hideButton.Visible = true
		clearAnswers()
		local count = math.max(1, #options)
		layout.CellSize = if count &lt;= 2 then UDim2.new(1 / count, -8, 0, 70) else UDim2.new(0.5, -4, 0, 38)
		for i, option in options do
			local b = UIKit.Button({
				Text = tostring(option),
				Color = Colors.PanelLight,
				TextSize = 16,
				LayoutOrder = i,
				Parent = row,
				OnClick = function()
					if currentId ~= id or phase ~= "Voting" then
						return
					end
					voteRemote:FireServer(id, i)
					for j, other in buttons do
						UIKit.SetButtonColor(other, if j == i then Colors.Good else Colors.PanelLight)
					end
					-- Voted: tuck away (the tab brings it back to change your vote).
					task.delay(0.4, function()
						if currentId == id and phase == "Voting" then
							setTucked(true)
						end
					end)
				end,
			})
			table.insert(buttons, b)
		end
		holder.Visible = true
		setTucked(false, true)
		UIKit.Bounce(card)
	end

	local function showResult(id: string, text: string, options: { string }, counts: { number })
		if closed[id] then
			return
		end
		currentId = id
		phase = "Result"
		title.Text = "POLL FINISHED"
		title.TextColor3 = Colors.Good
		timer.Text = ""
		question.Text = text
		hideButton.Visible = true
		clearAnswers()
		local total = 0
		for i = 1, #options do
			total += tonumber(counts[i]) or 0
		end
		layout.CellSize = if #options &lt;= 2 then UDim2.new(1 / #options, -8, 0, 70) else UDim2.new(0.5, -4, 0, 38)
		for i, option in options do
			local n = tonumber(counts[i]) or 0
			local pct = if total &gt; 0 then math.floor(n / total * 100 + 0.5) else 0
			local cell = UIKit.Card({ Name = "Result", LayoutOrder = i, Color = Colors.PanelLight, Parent = row })
			-- A bar for the share of votes.
			local bar = Instance.new("Frame")
			bar.BackgroundColor3 = Colors.Good
			bar.BackgroundTransparency = 0.45
			bar.Size = UDim2.fromScale(pct / 100, 1)
			UIKit.Corner(bar, 10)
			bar.Parent = cell
			UIKit.Label({ Text = string.format("%s  %d (%d%%)", tostring(option), n, pct), TextSize = 16, TextScaled = true, Size = UDim2.new(1, -10, 1, -6), Position = UDim2.fromOffset(5, 3), Parent = cell })
			table.insert(buttons, cell)
		end
		timer.Text = string.format("%d vote%s", total, if total == 1 then "" else "s")
		holder.Visible = true
		setTucked(false)
		UIKit.Bounce(card)
		UIKit.PlaySound("Sparkle")
	end

	local function close()
		if currentId then
			closed[currentId] = true
		end
		currentId = nil
		phase = "None"
		holder.Visible = false
	end

	tab.Activated:Connect(function()
		setTucked(false)
	end)
	hideButton.Activated:Connect(function()
		if phase == "Result" then
			close()
		else
			setTucked(true)
		end
	end)

	pollRemote.OnClientEvent:Connect(function(kind, id, text, options, extra)
		if kind == "Start" and type(id) == "string" and type(options) == "table" then
			showVoting(id, tostring(text), options, tonumber(extra) or Config.Now())
		elseif kind == "Close" and id == currentId then
			close() -- a show poll: gone the second it ends
		elseif kind == "End" and id == currentId and phase == "Voting" then
			phase = "Counting"
			timer.Text = "Counting votes..."
			for _, b in buttons do
				UIKit.SetDisabled(b, true)
			end
		elseif kind == "Result" and type(id) == "string" and type(options) == "table" and type(extra) == "table" then
			showResult(id, tostring(text), options, extra)
		end
	end)

	task.spawn(function()
		while true do
			-- Under every window: out of the way while one is open.
			if currentId then
				holder.Visible = not UIKit.IsWindowOpen()
			end
			if phase == "Voting" then
				local left = math.max(0, endsAt - Config.Now())
				timer.Text = string.format("%d s left", left)
				tabLabel.Text = string.format("POLL  ^  %ds", left)
			elseif phase == "Counting" then
				tabLabel.Text = "POLL  ^"
			end
			hideButton.Text = if phase == "Result" then "X" else "v"
			local label = hideButton:FindFirstChild("Label", true)
			if label and label:IsA("TextLabel") then
				label.Text = hideButton.Text
			end
			task.wait(0.5)
		end
	end)
end

return PollUI</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000041"><Properties><string name="Name">RanksUI</string><ProtectedString name="Source">--[[
	RanksUI - the "Ranks" window (Rank Shrine in the lobby, the HUD's Ranks button, R / gamepad RB).

	Left: your equipped rank (icon, name in its rarity colour, perk), a big ROLL button that costs
	Config.RankRoll.Cost gems, and your gems. Rolling opens a full-screen popup: a slot reel of rank
	cards spins while the server rolls, slows down and lands on your new rank.
	Right: every rank with its exact odds (x2 Luck applied if you own the pass: gems can be bought with
	Robux, so the odds are always shown before rolling), its perk, and Equip for the ones you own.

	All rolling happens on the server (MetaRequest "RollRank"). A roll REPLACES your rank (there is
	no collection), so rolling again is a gamble; the button stays locked until the reel has landed.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Types = require(Shared:WaitForChild("Types"))

local Client = script.Parent
local ClientState = require(Client:WaitForChild("ClientState"))
local UIKit = require(Client:WaitForChild("UIKit"))
local ShopUI = require(Client:WaitForChild("ShopUI"))

local Colors = UIKit.Theme.Colors

local RanksUI = {}

local WINDOW_SIZE = Vector2.new(900, 560)

local initialized = false
local rolling = false

local leftPanel: Frame
local list: ScrollingFrame
local reel: TextLabel
local rollButton: TextButton
local gemsLabel: TextLabel
local luckButton: TextButton
local luckActive: Frame? = nil
local inviteButton: TextButton
local luckSummary: TextLabel

-- Your luck right now: the total multiplier (Config.LuckMult) and the friends who joined through your invites.
local function currentLuck(meta: any): (number, number)
	local hasPass = meta ~= nil and meta.Passes.DoubleLuck == true
	local friends = if meta then math.clamp(tonumber(meta.Referrals) or 0, 0, Config.RankRoll.FriendLuck.MaxFriends) else 0
	return Config.LuckMult(hasPass, friends), friends
end

local function multText(mult: number): string
	local s = string.format("%.1f", mult)
	return "x" .. (string.gsub(s, "%.0$", ""))
end

local function rarityColor(rarity: string): Color3
	local r = Config.RankRarities[rarity]
	return if r then r.Color else Colors.Text
end

local function clear(frame: Instance)
	for _, child in frame:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
end

----------------------------------------------------------------------------------------------------
-- Left panel: current rank + roll
----------------------------------------------------------------------------------------------------

local currentCard: Frame

local function renderCurrent()
	clear(currentCard)
	local meta = ClientState.Meta :: Types.MetaState?
	local rank = meta and Config.GetRank(meta.Rank)
	local color = if rank then rarityColor(rank.Rarity) else Colors.TextDim
	local old = currentCard:FindFirstChildOfClass("UIGradient")
	if old then
		old:Destroy()
	end
	UIKit.Gradient(currentCard, UIKit.Lighten(color, 0.15), UIKit.Darken(color, 0.45))
	UIKit.Label({ Text = "YOUR RANK", TextSize = 18, Position = UDim2.fromOffset(0, 8), Size = UDim2.new(1, 0, 0, 22), Parent = currentCard })
	UIKit.Label({ Text = if rank then rank.Icon else "❔", TextSize = 64, Position = UDim2.fromOffset(0, 32), Size = UDim2.new(1, 0, 0, 70), Stroke = false, Parent = currentCard })
	UIKit.Label({
		Text = if rank then rank.Name else "No rank yet",
		TextSize = 30,
		Position = UDim2.fromOffset(8, 104),
		Size = UDim2.new(1, -16, 0, 34),
		TextScaled = true,
		Parent = currentCard,
	})
	UIKit.Label({
		Text = if rank then string.format("%s  •  %s", rank.Rarity, rank.Desc) else "Roll to get your first rank!",
		TextSize = 16,
		Position = UDim2.fromOffset(8, 140),
		Size = UDim2.new(1, -16, 0, 40),
		TextWrapped = true,
		Parent = currentCard,
	})
end

local function renderGems()
	local meta = ClientState.Meta :: Types.MetaState?
	local gems = if meta then meta.Gems or 0 else 0
	local luck = meta ~= nil and meta.Passes.DoubleLuck == true
	gemsLabel.Text = string.format("You have %s Gems", UIKit.Commas(gems))
	UIKit.SetDisabled(rollButton, rolling) -- short of gems, Roll opens the Gems shop instead
	if luckActive then
		luckActive.Visible = luck
	end
	if inviteButton then
		local mult, friends = currentLuck(meta)
		local fl = Config.RankRoll.FriendLuck
		local label = inviteButton:FindFirstChildWhichIsA("TextLabel", true)
		if label then
			label.Text = string.format("INVITE FRIENDS  +%d%% Luck each (%d/%d)", math.floor(fl.PerFriend * 100 + 0.5), friends, fl.MaxFriends)
		end
		UIKit.SetButtonColor(inviteButton, if friends &gt;= fl.MaxFriends then Colors.Good else Colors.Primary)
		if mult &gt; 1 then
			luckSummary.Text = string.format("LUCK %s  •  from %d friend%s%s", multText(mult), friends, if friends == 1 then "" else "s", if meta ~= nil and meta.Passes.DoubleLuck == true then " + x2 pass" else "")
			luckSummary.TextColor3 = Colors.Good
		else
			luckSummary.Text = string.format("Invite %d friends for x2 luck (x4 with the pass)", fl.MaxFriends)
			luckSummary.TextColor3 = Colors.TextDim
		end
	end
	if luckButton then
		local pass = Config.GetPass("DoubleLuck")
		luckButton.Visible = not luck
		local label = luckButton:FindFirstChildWhichIsA("TextLabel", true)
		if label and pass then
			ShopUI.WatchPrice(pass, true, function(price)
				label.Text = string.format("x2 Luck  R$ %d", price)
			end)
		end
	end
end

----------------------------------------------------------------------------------------------------
-- Right panel: odds list
----------------------------------------------------------------------------------------------------

local function pct(chance: number): string
	return if chance &lt; 1 then string.format("%.2f%%", chance) else string.format("%.1f%%", chance)
end

local function renderList()
	clear(list)
	local meta = ClientState.Meta :: Types.MetaState?
	local mult = currentLuck(meta)
	local luck = mult &gt; 1
	local weights, total = Config.RankWeights(mult)
	-- The chances both ways, so a boosted rank can show what it was / what it would be.
	local plain, plainTotal = Config.RankWeights(false)
	local lucky, luckyTotal = Config.RankWeights(true)
	for i, entry in weights do
		local rank = entry.Rank
		local equipped = meta ~= nil and meta.Rank == rank.Id
		local color = rarityColor(rank.Rarity)
		local row = UIKit.Card({ Size = UDim2.new(1, -8, 0, 68), LayoutOrder = i, Parent = list })
		UIKit.Stroke(row, color, if equipped then 3 else 1.5)
		UIKit.Label({ Text = rank.Icon, TextSize = 30, Position = UDim2.fromOffset(6, 0), Size = UDim2.fromOffset(44, 68), Stroke = false, Parent = row })
		UIKit.Label({
			Text = rank.Name,
			TextSize = 20,
			TextColor3 = color,
			TextXAlignment = Enum.TextXAlignment.Left,
			Position = UDim2.fromOffset(54, 6),
			Size = UDim2.new(1, -250, 0, 24),
			TextScaled = true,
			Parent = row,
		})
		UIKit.Label({
			Text = rank.Desc,
			TextSize = 14,
			TextColor3 = Colors.TextDim,
			TextXAlignment = Enum.TextXAlignment.Left,
			Position = UDim2.fromOffset(54, 34),
			Size = UDim2.new(1, -250, 0, 26),
			TextWrapped = true,
			Parent = row,
		})
		local boosted = Config.RankRarities[rank.Rarity].Order &gt;= 3
		local chance = entry.Weight / total * 100
		UIKit.Label({
			Text = string.format("%s\n%s", rank.Rarity, pct(chance)),
			TextSize = 15,
			TextColor3 = color,
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -112, 0, if boosted then 4 else 12),
			Size = UDim2.fromOffset(96, 40),
			Parent = row,
		})
		if boosted then
			-- With luck (pass and/or ads): a green "x2.6" on the row and what the chance was without
			-- it. Without: what it would be with the pass.
			local other = if luck then plain[i].Weight / plainTotal * 100 else lucky[i].Weight / luckyTotal * 100
			UIKit.Label({
				Text = if luck then "was " .. pct(other) else "x2 Luck: " .. pct(other),
				TextSize = 12,
				TextColor3 = if luck then Colors.TextDim else Colors.Good,
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, -112, 0, 46),
				Size = UDim2.fromOffset(96, 16),
				Parent = row,
			})
			if luck then
				local tag = Instance.new("Frame")
				tag.Name = "LuckTag"
				tag.Position = UDim2.fromOffset(4, 4)
				tag.Size = UDim2.fromOffset(36, 18)
				tag.BackgroundColor3 = Colors.Good
				tag.ZIndex = 3
				UIKit.Corner(tag, 9)
				UIKit.Label({ Text = multText(mult), TextSize = 13, Size = UDim2.fromScale(1, 1), ZIndex = 4, Parent = tag })
				tag.Parent = row
			end
		end
		if equipped then
			UIKit.Label({ Text = "Yours", TextSize = 18, TextColor3 = Colors.Good, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.fromOffset(96, 36), Parent = row })
		end
	end
end

local function render()
	renderCurrent()
	renderGems()
	renderList()
end

----------------------------------------------------------------------------------------------------
-- Rolling
----------------------------------------------------------------------------------------------------

----------------------------------------------------------------------------------------------------
-- Roll popup: a full-screen slot reel. Rank cards race past a gold marker, slow down and stop on
-- the rank the server rolled, then the result is revealed (rarity banner, glow, confetti for Epic+).
----------------------------------------------------------------------------------------------------
local CARD_W, CARD_GAP = 136, 12
local PITCH = CARD_W + CARD_GAP
local REEL_W, REEL_H = 780, 176
local SPIN_SPEED = 1900 -- px/s while waiting for the server
local CARD_COUNT = 90

local roll: () -&gt; ()
local popupGui: ScreenGui? = nil
local popup: {
	Dim: TextButton,
	Panel: Frame,
	Title: TextLabel,
	Strip: Frame,
	Cards: { Frame },
	Result: Frame,
	Buttons: Frame,
	Again: TextButton,
}? = nil

local function pickWeighted(weights: { any }, total: number): any
	local x = math.random() * total
	for _, e in weights do
		x -= e.Weight
		if x &lt;= 0 then
			return e.Rank
		end
	end
	return weights[#weights].Rank
end

local function paintCard(card: Frame, rank: any)
	local color = rarityColor(rank.Rarity)
	card.BackgroundColor3 = UIKit.Darken(color, 0.55)
	local stroke = card:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Color = color
	end
	local icon = card:FindFirstChild("Icon") :: TextLabel
	local name = card:FindFirstChild("RankName") :: TextLabel
	local bar = card:FindFirstChild("Bar") :: Frame
	icon.Text = rank.Icon
	name.Text = rank.Name
	name.TextColor3 = UIKit.Lighten(color, 0.35)
	bar.BackgroundColor3 = color
end

local function makeCard(parent: Instance, index: number): Frame
	local card = Instance.new("Frame")
	card.Name = "Card" .. index
	card.Size = UDim2.fromOffset(CARD_W, REEL_H - 24)
	card.Position = UDim2.fromOffset((index - 1) * PITCH, 12)
	card.BorderSizePixel = 0
	UIKit.Corner(card, 14)
	UIKit.Stroke(card, Colors.Text, 3)
	local grad = Instance.new("UIGradient")
	grad.Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(170, 170, 170))
	grad.Rotation = 90
	grad.Parent = card
	UIKit.Label({ Name = "Icon", Text = "", TextSize = 56, Position = UDim2.fromOffset(0, 12), Size = UDim2.new(1, 0, 0, 70), Stroke = false, Parent = card })
	UIKit.Label({ Name = "RankName", Text = "", TextSize = 20, Position = UDim2.fromOffset(8, 88), Size = UDim2.new(1, -16, 0, 30), TextScaled = true, Parent = card })
	local bar = Instance.new("Frame")
	bar.Name = "Bar"
	bar.BorderSizePixel = 0
	bar.AnchorPoint = Vector2.new(0.5, 1)
	bar.Position = UDim2.new(0.5, 0, 1, -8)
	bar.Size = UDim2.new(1, -24, 0, 6)
	UIKit.Corner(bar, 3)
	bar.Parent = card
	card.Parent = parent
	return card
end

local function ensurePopup()
	if popup then
		return popup
	end
	local gui, root = UIKit.CreateScreen("RankRollPopup", 40)
	popupGui = gui
	gui.Enabled = false

	local dim = Instance.new("TextButton") -- a button so clicks don't fall through to the world
	dim.Name = "Dim"
	dim.Text = ""
	dim.AutoButtonColor = false
	dim.Size = UDim2.fromScale(1, 1)
	dim.BackgroundColor3 = Color3.fromRGB(4, 10, 26)
	dim.BackgroundTransparency = 0.3
	dim.BorderSizePixel = 0
	dim.Parent = root

	local panel = Instance.new("Frame")
	panel.Name = "Panel"
	panel.AnchorPoint = Vector2.new(0.5, 0.5)
	panel.Position = UDim2.fromScale(0.5, 0.5)
	panel.Size = UDim2.fromOffset(REEL_W + 60, 460)
	panel.BackgroundTransparency = 1
	panel.Parent = root
	local panelScale = Instance.new("UIScale")
	panelScale.Name = "PopScale"
	panelScale.Parent = panel

	local title = UIKit.Label({ Name = "Title", Text = "ROLLING...", TextSize = 46, Position = UDim2.fromOffset(0, 0), Size = UDim2.new(1, 0, 0, 50), Parent = panel })

	-- The reel window.
	local reelFrame = Instance.new("Frame")
	reelFrame.Name = "Reel"
	reelFrame.AnchorPoint = Vector2.new(0.5, 0)
	reelFrame.Position = UDim2.new(0.5, 0, 0, 64)
	reelFrame.Size = UDim2.fromOffset(REEL_W, REEL_H)
	reelFrame.BackgroundColor3 = Color3.fromRGB(14, 24, 48)
	reelFrame.ClipsDescendants = true
	reelFrame.BorderSizePixel = 0
	UIKit.Corner(reelFrame, 18)
	UIKit.Stroke(reelFrame, Colors.Ink, 4)
	reelFrame.Parent = panel
	local strip = Instance.new("Frame")
	strip.Name = "Strip"
	strip.BackgroundTransparency = 1
	strip.Size = UDim2.fromOffset(CARD_COUNT * PITCH, REEL_H)
	strip.Parent = reelFrame
	local cards = {}
	for i = 1, CARD_COUNT do
		cards[i] = makeCard(strip, i)
	end
	-- Fade the edges so cards slide in and out of darkness.
	for _, side in { 0, 1 } do
		local fade = Instance.new("Frame")
		fade.Name = "Fade"
		fade.BorderSizePixel = 0
		fade.BackgroundColor3 = Color3.fromRGB(14, 24, 48)
		fade.AnchorPoint = Vector2.new(side, 0)
		fade.Position = UDim2.fromScale(side, 0)
		fade.Size = UDim2.new(0, 120, 1, 0)
		fade.ZIndex = 3
		local g = Instance.new("UIGradient")
		g.Transparency = if side == 0 then NumberSequence.new(0, 1) else NumberSequence.new(1, 0)
		g.Parent = fade
		fade.Parent = reelFrame
	end
	-- Gold marker down the middle with a pointer at each end.
	local marker = Instance.new("Frame")
	marker.Name = "Marker"
	marker.AnchorPoint = Vector2.new(0.5, 0.5)
	marker.Position = UDim2.new(0.5, 0, 0, 64 + REEL_H / 2)
	marker.Size = UDim2.fromOffset(4, REEL_H + 8)
	marker.BackgroundTransparency = 1 -- just the two pointers: a line would cover the card's name
	marker.BorderSizePixel = 0
	marker.ZIndex = 4
	marker.Parent = panel
	for _, y in { 0, 1 } do
		local tip = Instance.new("Frame")
		tip.Name = "Pointer"
		tip.AnchorPoint = Vector2.new(0.5, 0.5)
		tip.Position = UDim2.fromScale(0.5, y)
		tip.Size = UDim2.fromOffset(22, 22)
		tip.Rotation = 45
		tip.BackgroundColor3 = Color3.fromRGB(255, 214, 70)
		tip.BorderSizePixel = 0
		tip.ZIndex = 4
		UIKit.Stroke(tip, Colors.Ink, 2)
		tip.Parent = marker
	end

	-- Result text under the reel.
	local result = Instance.new("Frame")
	result.Name = "Result"
	result.BackgroundTransparency = 1
	result.Position = UDim2.fromOffset(0, 64 + REEL_H + 12)
	result.Size = UDim2.new(1, 0, 0, 110)
	result.Parent = panel
	UIKit.Label({ Name = "Rarity", Text = "", TextSize = 38, Size = UDim2.new(1, 0, 0, 40), Parent = result })
	UIKit.Label({ Name = "Perk", Text = "", TextSize = 21, Position = UDim2.fromOffset(20, 42), Size = UDim2.new(1, -40, 0, 26), TextWrapped = true, Parent = result })
	UIKit.Label({ Name = "Replaced", Text = "", TextSize = 15, TextColor3 = Colors.TextDim, Position = UDim2.fromOffset(20, 72), Size = UDim2.new(1, -40, 0, 22), Parent = result })

	local buttons = Instance.new("Frame")
	buttons.Name = "Buttons"
	buttons.BackgroundTransparency = 1
	buttons.Position = UDim2.fromOffset(0, 64 + REEL_H + 128)
	buttons.Size = UDim2.new(1, 0, 0, 60)
	buttons.Parent = panel
	local again = UIKit.Button({
		Text = string.format("Roll again (%d Gems)", Config.RankRoll.Cost),
		Size = UDim2.fromOffset(300, 56),
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(0.5, -8, 0, 0),
		Color = Colors.Accent,
		TextSize = 22,
		Parent = buttons,
		OnClick = function()
			task.spawn(roll)
		end,
	})
	UIKit.Button({
		Text = "Close",
		Size = UDim2.fromOffset(180, 56),
		Position = UDim2.new(0.5, 8, 0, 0),
		Color = Colors.PanelLight,
		TextSize = 22,
		Parent = buttons,
		OnClick = function()
			gui.Enabled = false
		end,
	})
	popup = { Dim = dim, Panel = panel, Title = title, Strip = strip, Cards = cards, Result = result, Buttons = buttons, Again = again }
	return popup
end

local function setResultText(rank: any?, previous: string?)
	local pp = ensurePopup()
	local rarity = pp.Result:FindFirstChild("Rarity") :: TextLabel
	local perk = pp.Result:FindFirstChild("Perk") :: TextLabel
	local replaced = pp.Result:FindFirstChild("Replaced") :: TextLabel
	if not rank then
		rarity.Text, perk.Text, replaced.Text = "", "", ""
		return
	end
	rarity.Text = string.upper(rank.Rarity) .. "!  " .. rank.Name
	rarity.TextColor3 = rarityColor(rank.Rarity)
	perk.Text = rank.Desc
	local before = previous and Config.GetRank(previous)
	replaced.Text = if before and before.Id ~= rank.Id then string.format("(replaced %s %s)", before.Icon, before.Name) else ""
end

local function celebrate(rank: any, card: Frame?)
	local pp = ensurePopup()
	local order = Config.RankRarities[rank.Rarity].Order
	pp.Title.Text = if order &gt;= 5 then "INCREDIBLE!" elseif order &gt;= 4 then "AMAZING!" elseif order &gt;= 3 then "NICE!" else "YOU GOT"
	pp.Title.TextColor3 = if order &gt;= 3 then rarityColor(rank.Rarity) else Colors.Text
	setResultText(rank, nil)
	UIKit.Bounce(pp.Title)
	if card then
		UIKit.Bounce(card)
		local glow = card:FindFirstChildOfClass("UIStroke")
		if glow then
			glow.Thickness = 6
		end
	end
	UIKit.PlaySound("Hatch")
	if order &gt;= 4 then
		UIKit.Confetti(if order &gt;= 5 then 140 else 90)
	elseif order &gt;= 3 then
		UIKit.PlaySound("Sparkle")
	end
end

-- Spins the reel until `getResult()` returns a rank id (or false on failure), then lands on it.
-- Returns once the reel has stopped.
local function spinReel(getResult: () -&gt; any, weights: { any }, total: number): boolean
	local pp = ensurePopup()
	local cards = pp.Cards
	for _, card in cards do
		paintCard(card, pickWeighted(weights, total))
		local stroke = card:FindFirstChildOfClass("UIStroke")
		if stroke then
			stroke.Thickness = 3
		end
	end
	local centre = REEL_W / 2 - CARD_W / 2 -- strip offset that puts card 1 under the marker
	local offset = 0 -- how far the strip has scrolled left
	pp.Strip.Position = UDim2.fromOffset(centre, 0)
	local lastTick = 0
	local function place(o: number)
		offset = o
		pp.Strip.Position = UDim2.fromOffset(math.floor(centre - o + 0.5), 0)
		local passed = math.floor((o + CARD_W / 2) / PITCH)
		if passed ~= lastTick then
			lastTick = passed
			UIKit.PlaySound("Click", 1.1 + (passed % 3) * 0.06)
		end
	end

	-- Phase 1: full speed until the server answers (at least half a second, for the feel).
	local started = os.clock()
	local result = nil
	while true do
		local dt = RunService.RenderStepped:Wait()
		place(offset + SPIN_SPEED * dt)
		result = getResult()
		if result ~= nil and os.clock() - started &gt; 0.5 then
			break
		end
		if offset &gt; (CARD_COUNT - 30) * PITCH then
			offset = 0 -- very slow server: loop the strip (the cards are random anyway)
		end
	end
	if result == false then
		return false
	end
	local rank = Config.GetRank(result)
	if not rank then
		return false
	end

	-- Phase 2: pick a landing card ~18 cards ahead, paint it with the result, and ease out onto it
	-- (a cubic ease-out whose starting speed matches the spin, so there is no jolt).
	local target = math.floor(offset / PITCH) + 18
	paintCard(cards[target], rank)
	local jitter = (math.random() - 0.5) * CARD_W * 0.6
	local land = (target - 1) * PITCH + jitter
	local distance = land - offset
	local duration = 3 * distance / SPIN_SPEED
	local from = offset
	local t = 0
	while t &lt; duration do
		t += RunService.RenderStepped:Wait()
		local k = math.min(t / duration, 1)
		place(from + distance * (1 - (1 - k) ^ 3))
	end
	-- Settle onto the middle of the card.
	local settleFrom = offset
	local settle = 0
	while settle &lt; 0.3 do
		settle += RunService.RenderStepped:Wait()
		local k = math.min(settle / 0.3, 1)
		local e = k * k * (3 - 2 * k)
		place(settleFrom + ((target - 1) * PITCH - settleFrom) * e)
	end
	celebrate(rank, cards[target])
	return true
end

local function showPopup()
	local pp = ensurePopup()
	if popupGui then
		popupGui.Enabled = true
	end
	pp.Title.Text = "ROLLING..."
	pp.Title.TextColor3 = Colors.Text
	setResultText(nil)
	pp.Buttons.Visible = false
	local scale = pp.Panel:FindFirstChild("PopScale") :: UIScale
	scale.Scale = 0.85
	TweenService:Create(scale, TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
end

local function finishPopup(ok: boolean)
	local pp = ensurePopup()
	pp.Buttons.Visible = true
	UIKit.SetDisabled(pp.Again, false) -- short of gems, it opens the Gems shop
	if not ok then
		pp.Title.Text = "Couldn't roll"
		pp.Title.TextColor3 = Colors.Bad
	end
end

local function roll_()
	-- Not enough gems: straight to the Gems shop.
	local metaNow = ClientState.Meta :: Types.MetaState?
	if not rolling and (if metaNow then metaNow.Gems or 0 else 0) &lt; Config.RankRoll.Cost then
		if popupGui then
			popupGui.Enabled = false
		end
		UIKit.Toast(string.format("You need %d Gems to roll. Get more here!", Config.RankRoll.Cost), "Info")
		UIKit.OpenWindow("Shop", "Gems")
		return
	end
	if rolling then
		return
	end
	rolling = true
	renderGems()
	local meta = ClientState.Meta :: Types.MetaState?
	local weights, total = Config.RankWeights((currentLuck(meta)))
	showPopup()

	-- Ask the server in the background; the reel spins until it answers.
	local answer: any = nil
	local response: any = nil
	task.spawn(function()
		local r = ClientState.MetaRequest("RollRank")
		response = r
		answer = if r and r.Ok and r.Rank then r.Rank else false
	end)

	local pp = ensurePopup()
	for _, card in pp.Cards do
		card.Visible = true
	end
	local ok = spinReel(function()
		return answer
	end, weights, total)
	if ok and response then
		local rank = Config.GetRank(response.Rank)
		setResultText(rank, response.Previous)
		if rank then
			reel.Text = rank.Icon .. " " .. rank.Name
			reel.TextColor3 = rarityColor(rank.Rarity)
		end
	elseif response and response.Error then
		UIKit.Toast(response.Error, "Bad")
	end
	rolling = false
	finishPopup(ok)
	render()
end

roll = function()
	local ok, err = pcall(roll_)
	if not ok then
		rolling = false
		warn("[RanksUI] roll failed: " .. tostring(err))
		finishPopup(false)
	end
end

function RanksUI.Init()
	if initialized then
		return
	end
	initialized = true

	local _gui, screenRoot = UIKit.CreateScreen("RanksUI", 10)
	local _window, content = UIKit.Window({
		Name = "Ranks",
		Title = "Ranks",
		Icon = "💎",
		Size = WINDOW_SIZE,
		Parent = screenRoot,
	})

	leftPanel = Instance.new("Frame")
	leftPanel.Name = "Left"
	leftPanel.BackgroundTransparency = 1
	leftPanel.Size = UDim2.new(0, 330, 1, 0)
	leftPanel.Parent = content

	currentCard = Instance.new("Frame")
	currentCard.Name = "Current"
	currentCard.Size = UDim2.new(1, 0, 0, 184)
	currentCard.BackgroundColor3 = Color3.new(1, 1, 1)
	currentCard.BorderSizePixel = 0
	UIKit.Corner(currentCard, 16)
	UIKit.Stroke(currentCard, Colors.Ink, 3)
	currentCard.Parent = leftPanel

	reel = UIKit.Label({
		Name = "Reel",
		Text = "Try your luck!",
		TextSize = 26,
		Position = UDim2.fromOffset(0, 190),
		Size = UDim2.new(1, 0, 0, 32),
		TextScaled = true,
		Parent = leftPanel,
	})

	rollButton = UIKit.Button({
		Text = string.format("ROLL  (%d Gems)", Config.RankRoll.Cost),
		Size = UDim2.new(1, 0, 0, 62),
		Position = UDim2.fromOffset(0, 228),
		Color = Colors.Accent,
		TextSize = 30,
		Parent = leftPanel,
		OnClick = function()
			task.spawn(roll)
		end,
	})

	gemsLabel = UIKit.Label({
		Text = "",
		TextSize = 20,
		Position = UDim2.fromOffset(0, 296),
		Size = UDim2.new(1, 0, 0, 24),
		Parent = leftPanel,
	})

	-- Two side by side: the x2 Luck pass (or "x2 LUCK OWNED") and the rewarded ad.
	luckButton = UIKit.Button({
		Text = "x2 Luck pass",
		Size = UDim2.new(0.5, -4, 0, 46),
		Position = UDim2.fromOffset(0, 330),
		Color = Color3.fromRGB(90, 190, 110),
		TextSize = 15,
		Parent = leftPanel,
		OnClick = function()
			ShopUI.BuyPass("DoubleLuck")
		end,
	})
	-- When you own x2 Luck: a clear green badge where the buy button was.
	local active = Instance.new("Frame")
	active.Name = "LuckActive"
	active.Size = UDim2.new(0.5, -4, 0, 46)
	active.Position = UDim2.fromOffset(0, 330)
	active.BackgroundColor3 = Colors.Good
	active.Visible = false
	UIKit.Corner(active, 12)
	UIKit.Stroke(active, Color3.fromRGB(220, 255, 230), 3, 0)
	UIKit.Label({ Text = "x2 LUCK OWNED", TextSize = 18, Size = UDim2.fromScale(1, 1), Parent = active })
	active.Parent = leftPanel
	luckActive = active
	inviteButton = UIKit.Button({
		Text = "INVITE FRIENDS",
		Size = UDim2.new(0.5, -4, 0, 46),
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 330),
		Color = Colors.Primary,
		TextSize = 14,
		Parent = leftPanel,
		OnClick = function()
			local RewardsUI = require(script.Parent:WaitForChild("RewardsUI")) :: any
			RewardsUI.Invite()
		end,
	})
	luckSummary = UIKit.Label({
		Name = "LuckSummary",
		Text = "",
		TextSize = 16,
		TextScaled = true,
		Position = UDim2.fromOffset(0, 380),
		Size = UDim2.new(1, 0, 0, 22),
		Parent = leftPanel,
	})
	UIKit.Label({
		Text = "A roll replaces your current rank! Luck makes Rare ranks and higher more likely.",
		TextSize = 14,
		TextColor3 = Colors.Warning,
		TextWrapped = true,
		TextScaled = true,
		Position = UDim2.fromOffset(0, 408),
		Size = UDim2.new(1, 0, 0, 38),
		Parent = leftPanel,
	})

	local right = Instance.new("Frame")
	right.Name = "Odds"
	right.BackgroundTransparency = 1
	right.Position = UDim2.fromOffset(346, 0)
	right.Size = UDim2.new(1, -346, 1, 0)
	right.Parent = content
	UIKit.Label({ Text = "ALL RANKS &amp; ODDS", TextSize = 20, Size = UDim2.new(1, 0, 0, 26), Parent = right })
	list = Instance.new("ScrollingFrame")
	list.Position = UDim2.fromOffset(0, 32)
	list.Size = UDim2.new(1, 0, 1, -32)
	list.BackgroundTransparency = 1
	list.BorderSizePixel = 0
	list.ScrollBarThickness = 8
	list.ScrollBarImageColor3 = Colors.Accent
	list.AutomaticCanvasSize = Enum.AutomaticSize.Y
	list.CanvasSize = UDim2.new()
	list.Parent = right
	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, 8)
	layout.Parent = list
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 4)
	pad.PaddingLeft = UDim.new(0, 4)
	pad.Parent = list

	UIKit.RegisterWindow("Ranks", {
		Open = function()
			render()
		end,
	})
	ClientState.Changed:Connect(function(kind)
		if kind == "Meta" and UIKit.IsWindowOpen("Ranks") and not rolling then
			render()
		end
	end)
	-- The ad luck countdown; the odds change back when it runs out.
	task.spawn(function()
		local wasActive = false
		while true do
			task.wait(1)
			if UIKit.IsWindowOpen("Ranks") and not rolling then
				local _mult, stacks = currentLuck(ClientState.Meta)
				renderGems()
				if wasActive and stacks == 0 then
					renderList()
				end
				wasActive = stacks &gt; 0
			end
		end
	end)
end

return RanksUI</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000042"><Properties><string name="Name">RebirthUI</string><ProtectedString name="Source">--[[
	RebirthUI - the "Rebirth" window (the Rebirth Fountain in the lobby).

	The endgame loop: once you've cleaned the last dishwasher, trade your Bubbles, unlocked
	dishwashers and perks for a permanent bonus (Config.Rebirth). Shows how many rebirths you have,
	your current bonuses, what the next one gives, the two requirements (with ticks), exactly what
	resets and what you keep, and the REBIRTH button. The server does all the checks (MetaRequest
	"Rebirth").
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Types = require(Shared:WaitForChild("Types"))

local Client = script.Parent
local ClientState = require(Client:WaitForChild("ClientState"))
local UIKit = require(Client:WaitForChild("UIKit"))

local Colors = UIKit.Theme.Colors

local RebirthUI = {}

local initialized = false
local busy = false

local countLabel: TextLabel
local nowLabel: TextLabel
local nextLabel: TextLabel
local reqLevel: TextLabel
local reqBubbles: TextLabel
local rebirthButton: TextButton

local function pct(x: number): string
	return string.format("%d%%", math.floor(x * 100 + 0.5))
end

local function render()
	local meta = ClientState.Meta :: Types.MetaState?
	local rebirths = (meta and meta.Rebirths) or 0
	local rb = Config.Rebirth
	countLabel.Text = string.format("Rebirth %d", rebirths)
	nowLabel.Text = if rebirths &gt; 0
		then string.format("Now: +%s coins, +%s Bubbles", pct(rb.CoinsPer * rebirths), pct(rb.BubblesPer * rebirths))
		else "No rebirth bonuses yet."
	nextLabel.Text = string.format(
		"Next rebirth: +%s coins and +%s Bubbles forever, and %d Gems",
		pct(rb.CoinsPer * (rebirths + 1)),
		pct(rb.BubblesPer * (rebirths + 1)),
		Config.RebirthGems(rebirths + 1)
	)
	local last = Config.Levels[#Config.Levels]
	local levelDone = meta ~= nil and meta.RebirthReady == true
	reqLevel.Text = string.format("%s  Clean %s", if levelDone then "Done:" else "To do:", last.Name)
	reqLevel.TextColor3 = if levelDone then Colors.Good else Colors.Text
	local cost = Config.RebirthCost(rebirths)
	local have = (meta and meta.Bubbles) or 0
	local enough = have &gt;= cost
	reqBubbles.Text = string.format("%s  Have %s / %s Bubbles", if enough then "Done:" else "To do:", UIKit.Commas(have), UIKit.Commas(cost))
	reqBubbles.TextColor3 = if enough then Colors.Good else Colors.Text
	UIKit.SetButtonColor(rebirthButton, if levelDone and enough then Colors.Good else Colors.Disabled)
end

local function doRebirth()
	if busy then
		return
	end
	busy = true
	local result = ClientState.MetaRequest("Rebirth")
	busy = false
	if not result.Ok then
		UIKit.Toast(result.Error or "Can't rebirth yet.", "Bad")
		return
	end
	UIKit.PlaySound("Sparkle")
	UIKit.Confetti(80)
	UIKit.Toast("Rebirthed! Your bonuses are now permanent.", "Good")
	render()
end

function RebirthUI.Init()
	if initialized then
		return
	end
	initialized = true

	local _gui, screenRoot = UIKit.CreateScreen("RebirthUI", 10)
	local _window, content = UIKit.Window({
		Name = "Rebirth",
		Title = "Rebirth",
		Icon = "✨",
		Size = Vector2.new(620, 520),
		Parent = screenRoot,
	})

	local y = 0
	local function line(props: { [string]: any }, height: number): TextLabel
		props.Size = UDim2.new(1, -20, 0, height)
		props.Position = UDim2.new(0.5, 0, 0, y)
		props.AnchorPoint = Vector2.new(0.5, 0)
		props.Parent = content
		props.TextWrapped = true
		y += height + 6
		return UIKit.Label(props)
	end

	countLabel = line({ Text = "", TextSize = 34, TextColor3 = Color3.fromRGB(255, 220, 110) }, 42)
	nowLabel = line({ Text = "", TextSize = 18, TextColor3 = Colors.TextDim }, 24)
	nextLabel = line({ Text = "", TextSize = 20 }, 50)

	local reqCard = UIKit.Card({
		Size = UDim2.new(1, -20, 0, 96),
		Position = UDim2.new(0.5, 0, 0, y),
		AnchorPoint = Vector2.new(0.5, 0),
		Color = Colors.PanelDark,
		Parent = content,
	})
	y += 104
	reqLevel = UIKit.Label({ Text = "", TextSize = 20, Size = UDim2.new(1, -24, 0, 36), Position = UDim2.fromOffset(12, 8), TextXAlignment = Enum.TextXAlignment.Left, Parent = reqCard })
	reqBubbles = UIKit.Label({ Text = "", TextSize = 20, Size = UDim2.new(1, -24, 0, 36), Position = UDim2.fromOffset(12, 50), TextXAlignment = Enum.TextXAlignment.Left, Parent = reqCard })

	line({
		Text = "Resets: Bubbles, unlocked levels and perks.\nYou keep: pets, gems, ranks, passes and best times.",
		TextSize = 16,
		TextColor3 = Colors.TextDim,
	}, 48)

	rebirthButton = UIKit.Button({
		Text = "REBIRTH",
		Icon = "✨",
		Size = UDim2.new(1, -40, 0, 64),
		Position = UDim2.new(0.5, 0, 0, y + 4),
		AnchorPoint = Vector2.new(0.5, 0),
		Color = Colors.Disabled,
		TextSize = 30,
		Parent = content,
		OnClick = doRebirth,
	})

	UIKit.RegisterWindow("Rebirth", {
		Open = function()
			render()
		end,
	})
	ClientState.Changed:Connect(function(kind)
		if kind == "Meta" and UIKit.IsWindowOpen("Rebirth") then
			render()
		end
	end)
end

return RebirthUI</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000043"><Properties><string name="Name">RewardsUI</string><ProtectedString name="Source">--[[
	RewardsUI - two small windows opened from the buttons on the left of the lobby HUD.

	  * "Codes" (🎟️): type a code (Config.Codes) and redeem it. "Look out for codes in the game's
	    description and our community!"
	  * "Free" (🎉 Free Rewards), one reward each (Config.Social):
	      - Join the community: JOIN opens Roblox's own join prompt in game
	        (GroupService:PromptJoinAsync); as soon as it closes, the server checks membership live
	        and pays out. No rejoin needed.
	      - Follow the dev / Favorite the game: the button checks straight away (SocialService). A
	        follow Roblox can't show yet says to leave and rejoin (it's re-checked on join).
]]

local AvatarEditorService = game:GetService("AvatarEditorService")
local ExperienceNotificationService = game:GetService("ExperienceNotificationService")
local GroupService = game:GetService("GroupService")
local SocialService = game:GetService("SocialService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Types = require(Shared:WaitForChild("Types"))

local Client = script.Parent
local ClientState = require(Client:WaitForChild("ClientState"))
local UIKit = require(Client:WaitForChild("UIKit"))

local Colors = UIKit.Theme.Colors
local Fonts = UIKit.Theme.Fonts
local LocalPlayer = Players.LocalPlayer

local RewardsUI = {}

local initialized = false
local busy = false
local groupButton: TextButton
local groupStatus: TextLabel
local socialRows: { [string]: { Button: TextButton, Status: TextLabel } } = {}

----------------------------------------------------------------------------------------------------
-- Codes
----------------------------------------------------------------------------------------------------

local function buildCodes(screenRoot: Instance)
	local _window, content = UIKit.Window({
		Name = "Codes",
		Title = "Codes",
		Icon = "🎟️",
		Size = Vector2.new(560, 320),
		Parent = screenRoot,
	})
	UIKit.Label({
		Text = "Look out for codes in the game's description and in our community!",
		TextSize = 18,
		TextWrapped = true,
		TextColor3 = Colors.TextDim,
		Size = UDim2.new(1, -30, 0, 48),
		Position = UDim2.new(0.5, 0, 0, 4),
		AnchorPoint = Vector2.new(0.5, 0),
		Parent = content,
	})
	local boxFrame = UIKit.Card({
		Size = UDim2.new(1, -60, 0, 60),
		Position = UDim2.new(0.5, 0, 0, 62),
		AnchorPoint = Vector2.new(0.5, 0),
		Color = Colors.PanelDark,
		Parent = content,
	})
	local box = Instance.new("TextBox")
	box.Name = "CodeBox"
	box.BackgroundTransparency = 1
	box.Size = UDim2.new(1, -24, 1, 0)
	box.Position = UDim2.fromOffset(12, 0)
	box.Font = Fonts.Title
	box.TextSize = 26
	box.TextColor3 = Colors.Text
	box.PlaceholderText = "Enter code..."
	box.PlaceholderColor3 = Colors.TextDim
	box.Text = ""
	box.ClearTextOnFocus = false
	box.Parent = boxFrame
	local function redeem()
		if busy then
			return
		end
		local text = box.Text
		if text == "" then
			box:CaptureFocus()
			return
		end
		busy = true
		local result = ClientState.MetaRequest("RedeemCode", text)
		busy = false
		if result.Ok then
			box.Text = ""
			UIKit.PlaySound("Sparkle")
			UIKit.Confetti(40)
			UIKit.Toast("Code redeemed: " .. (result.Message or "") .. "!", "Good")
		else
			UIKit.Toast(result.Error or "That code doesn't work.", "Bad")
		end
	end
	box.FocusLost:Connect(function(enterPressed)
		if enterPressed then
			task.spawn(redeem)
		end
	end)
	UIKit.Button({
		Text = "REDEEM",
		Size = UDim2.fromOffset(220, 56),
		Position = UDim2.new(0.5, 0, 0, 140),
		AnchorPoint = Vector2.new(0.5, 0),
		Color = Colors.Good,
		TextSize = 26,
		Parent = content,
		OnClick = function()
			task.spawn(redeem)
		end,
	})
	UIKit.RegisterWindow("Codes", {})
end

----------------------------------------------------------------------------------------------------
-- Free rewards
----------------------------------------------------------------------------------------------------

local function refreshGroup()
	local meta = ClientState.Meta :: Types.MetaState?
	local claimed = meta ~= nil and meta.GroupReward == true
	groupButton.Text = if claimed then "Claimed" else "JOIN &amp; CLAIM"
	UIKit.SetButtonColor(groupButton, if claimed then Colors.Disabled else Colors.Good)
	groupStatus.Text = if claimed then "Thanks for joining!" else "Reward: " .. Config.RewardText(Config.Social.GroupReward)
end

local function refreshSocial()
	local meta = ClientState.Meta :: Types.MetaState?
	for kind, rowParts in socialRows do
		local state = if meta then (if kind == "Follow" then meta.FollowState else meta.LikeState) else ""
		local reward = if kind == "Follow" then Config.Social.FollowReward else Config.Social.LikeReward
		if state == "Claimed" then
			rowParts.Button.Text = "Claimed"
			UIKit.SetButtonColor(rowParts.Button, Colors.Disabled)
			rowParts.Status.Text = "Thank you!"
		elseif state == "Pending" then
			rowParts.Button.Text = "Check again"
			UIKit.SetButtonColor(rowParts.Button, Colors.Warning)
			rowParts.Status.Text = "Not working? Leave and rejoin."
		else
			rowParts.Button.Text = if kind == "Follow" then "I followed!" else "Favorite &amp; Like"
			UIKit.SetButtonColor(rowParts.Button, Colors.Good)
			rowParts.Status.Text = "Reward: " .. Config.RewardText(reward :: any)
		end
	end
end

-- Favorite: is the game favorited on this account? If not, Roblox's own favorite prompt, then
-- check again. Returns true only when Roblox says it's favorited.
local function favoriteGame(): boolean
	local placeId = game.PlaceId
	if placeId == 0 then
		return false
	end
	local function isFavorited(): boolean
		local ok, result = pcall(function()
			return AvatarEditorService:GetFavorite(placeId, Enum.AvatarItemType.Asset)
		end)
		return ok and result == true
	end
	if isFavorited() then
		return true
	end
	local done = false
	local conn = AvatarEditorService.PromptSetFavoriteCompleted:Connect(function()
		done = true
	end)
	local ok = pcall(function()
		AvatarEditorService:PromptSetFavorite(placeId, Enum.AvatarItemType.Asset, true)
	end)
	local waited = 0
	while ok and not done and waited &lt; 60 do
		waited += task.wait(0.2)
	end
	conn:Disconnect()
	task.wait(0.5)
	return isFavorited()
end

local function markDone(kind: string)
	local meta = ClientState.Meta :: Types.MetaState?
	local state = if meta then (if kind == "Follow" then meta.FollowState else meta.LikeState) else ""
	if busy or state == "Claimed" then
		return
	end
	busy = true
	local row = socialRows[kind]
	if row then
		row.Button.Text = "Checking..."
	end
	if kind == "Favorite" and not favoriteGame() then
		busy = false
		UIKit.Toast("Favorite and like the game to get this reward!", "Info")
		refreshSocial()
		return
	end
	local result = ClientState.MetaRequest("SocialDone", kind)
	busy = false
	if result.Ok then
		UIKit.PlaySound("Sparkle")
		UIKit.Confetti(50)
		UIKit.Toast(result.Message or "Reward claimed!", "Good")
	else
		UIKit.Toast(result.Error or "Couldn't do that.", "Info")
	end
	refreshSocial()
end

local function socialButton(parent: Frame, kind: string)
	local button = UIKit.Button({
		Text = "",
		Size = UDim2.fromOffset(210, 52),
		Position = UDim2.new(1, -14, 0.5, -10),
		AnchorPoint = Vector2.new(1, 0.5),
		Color = Colors.Good,
		TextSize = 20,
		Parent = parent,
		OnClick = function()
			task.spawn(markDone, kind)
		end,
	})
	local status = UIKit.Label({ Text = "", TextSize = 15, TextColor3 = Colors.Coin, Size = UDim2.fromOffset(230, 20), Position = UDim2.new(1, -4, 1, -8), AnchorPoint = Vector2.new(1, 1), Parent = parent })
	socialRows[kind] = { Button = button, Status = status }
end

local function joinGroup()
	local meta = ClientState.Meta :: Types.MetaState?
	if busy or (meta and meta.GroupReward) then
		return
	end
	local groupId = Config.GetGroupId()
	if groupId &lt;= 0 then
		UIKit.Toast("The community isn't set up yet!", "Info")
		return
	end
	busy = true
	-- Already a member? Claim straight away. Otherwise Roblox's join prompt, in game; when it
	-- closes (joined or not), ask the server to check.
	local result = ClientState.MetaRequest("ClaimGroup")
	if not result.Ok then
		pcall(function()
			GroupService:PromptJoinAsync(groupId)
		end)
		result = ClientState.MetaRequest("ClaimGroup")
	end
	busy = false
	if result.Ok then
		UIKit.PlaySound("Sparkle")
		UIKit.Confetti(60)
		UIKit.Toast("Welcome to the community! " .. (result.Message or ""), "Good")
	else
		UIKit.Toast(result.Error or "Join the community first, then claim!", "Info")
	end
	refreshGroup()
end

local function card(parent: Instance, order: number, icon: string, title: string, body: string): Frame
	local c = UIKit.Card({
		Size = UDim2.new(1, -24, 0, 104),
		LayoutOrder = order,
		Color = Colors.PanelLight,
		Parent = parent,
	})
	UIKit.Label({ Text = icon, TextSize = 44, Size = UDim2.fromOffset(70, 70), Position = UDim2.new(0, 10, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), Stroke = false, Parent = c })
	UIKit.Label({ Name = "Title", Text = title, TextSize = 22, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -330, 0, 30), Position = UDim2.fromOffset(88, 12), Parent = c })
	UIKit.Label({ Name = "Body", Text = body, TextSize = 16, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextColor3 = Colors.TextDim, Size = UDim2.new(1, -330, 0, 52), Position = UDim2.fromOffset(88, 44), Parent = c })
	return c
end

local function buildFree(screenRoot: Instance)
	local _window, content = UIKit.Window({
		Name = "Free",
		Title = "Free Rewards",
		Icon = "🎉",
		Size = Vector2.new(720, 470),
		Parent = screenRoot,
	})
	-- Scrolls: five reward cards don't all fit at once.
	local list = Instance.new("ScrollingFrame")
	list.BackgroundTransparency = 1
	list.BorderSizePixel = 0
	list.Size = UDim2.new(1, 0, 1, 0)
	list.CanvasSize = UDim2.new()
	list.AutomaticCanvasSize = Enum.AutomaticSize.Y
	list.ScrollBarThickness = 8
	list.ScrollBarImageColor3 = Colors.Primary
	list.Parent = content
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 4)
	pad.PaddingBottom = UDim.new(0, 8)
	pad.Parent = list
	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.Padding = UDim.new(0, 12)
	layout.Parent = list

	-- Community (the real reward).
	local group = card(list, 1, "👥", "Join our community", "Join the Rinse Cycle community for a free reward, news and codes!")
	groupButton = UIKit.Button({
		Text = "JOIN &amp; CLAIM",
		Size = UDim2.fromOffset(210, 52),
		Position = UDim2.new(1, -14, 0.5, -10),
		AnchorPoint = Vector2.new(1, 0.5),
		Color = Colors.Good,
		TextSize = 20,
		Parent = group,
		OnClick = function()
			task.spawn(joinGroup)
		end,
	})
	groupStatus = UIKit.Label({ Text = "", TextSize = 15, TextColor3 = Colors.Coin, Size = UDim2.fromOffset(230, 20), Position = UDim2.new(1, -4, 1, -8), AnchorPoint = Vector2.new(1, 1), Parent = group })

	-- "Favorite &amp; Like the game". Only the favorite is checked (on this device); likes can't be
	-- checked by any game, so the text asks for both.
	if Config.Social.LikeReward then
		local fav = card(list, 2, "⭐", "Favorite &amp; Like the game", "Favorite and like the game, then tap the button. We check it straight away.")
		socialButton(fav, "Favorite")
	end

	-- Follow the dev (their headshot and name): follow, tap the button, rejoin (checked on join).
	local creatorId = Config.Social.CreatorUserId
	local follow = card(list, 3, "", "Follow the dev", "Follow on their Roblox profile, then tap the button to check.")
	local shot = Instance.new("ImageLabel")
	shot.BackgroundTransparency = 1
	shot.Size = UDim2.fromOffset(70, 70)
	shot.Position = UDim2.new(0, 10, 0.5, 0)
	shot.AnchorPoint = Vector2.new(0, 0.5)
	shot.Image = string.format("rbxthumb://type=AvatarHeadShot&amp;id=%d&amp;w=150&amp;h=150", creatorId)
	shot.Parent = follow
	UIKit.Corner(shot, 35)
	socialButton(follow, "Follow")
	task.spawn(function()
		local ok, name = pcall(function()
			return Players:GetNameFromUserIdAsync(creatorId)
		end)
		if ok and type(name) == "string" then
			local title = follow:FindFirstChild("Title")
			if title and title:IsA("TextLabel") then
				title.Text = "Follow @" .. name
			end
		end
	end)

	-- Invite friends (Roblox's invite prompt; the invite carries your UserId so the game knows who
	-- brought them in: SocialService pays you both when a NEW player joins through it).
	local referral = Config.Social.ReferralReward
	local invite = card(list, 4, "🤝", "Invite friends", string.format("A friend who's new joins from your invite: you get %s, they get %s.", Config.RewardText(referral), Config.RewardText(Config.Social.ReferredReward)))
	UIKit.Button({
		Text = "INVITE",
		Size = UDim2.fromOffset(210, 52),
		Position = UDim2.new(1, -14, 0.5, -10),
		AnchorPoint = Vector2.new(1, 0.5),
		Color = Colors.Good,
		TextSize = 20,
		Parent = invite,
		OnClick = function()
			RewardsUI.Invite()
		end,
	})
	local inviteStatus = UIKit.Label({ Text = "", TextSize = 15, TextColor3 = Colors.Coin, Size = UDim2.fromOffset(230, 20), Position = UDim2.new(1, -4, 1, -8), AnchorPoint = Vector2.new(1, 1), Parent = invite })
	local function refreshInvite()
		local meta = ClientState.Meta :: any
		local n = meta and tonumber(meta.Referrals) or 0
		inviteStatus.Text = if n &gt; 0 then string.format("Friends joined: %d", n) else ""
	end

	-- Notifications: Roblox's own opt-in prompt (experience notifications, e.g. "your daily reward is
	-- ready"). Roblox decides when it may be shown again.
	local notify = card(list, 5, "🔔", "Turn on notifications", "Get a Roblox notification when your next daily reward is ready.")
	UIKit.Button({
		Text = "NOTIFY ME",
		Size = UDim2.fromOffset(210, 52),
		Position = UDim2.new(1, -14, 0.5, -10),
		AnchorPoint = Vector2.new(1, 0.5),
		Color = Colors.Primary,
		TextSize = 20,
		Parent = notify,
		OnClick = function()
			task.spawn(function()
				if RewardsUI.PromptNotifications() == "AlreadyOn" then
					UIKit.Toast("Notifications are already on!", "Info")
				end
			end)
		end,
	})

	UIKit.RegisterWindow("Free", {
		Open = function()
			refreshGroup()
			refreshSocial()
			refreshInvite()
		end,
	})
	ClientState.Changed:Connect(function(kind)
		if kind == "Meta" and UIKit.IsWindowOpen("Free") then
			refreshGroup()
			refreshSocial()
			refreshInvite()
		end
	end)
end

-- Roblox's notification opt-in prompt, if Roblox allows it right now. `fromButton`: say so when
-- it can't be shown (already on, or asked too recently).
-- Shows Roblox's notification opt-in. Returns "Asked" (the pop-up was shown) or "AlreadyOn" (can't
-- ask: they're on already, or Roblox won't ask again yet). The CALLER says something about it, once.
-- Opens Roblox's invite prompt; the invite carries your UserId so a new friend who joins through it
-- counts for you (rewards in Free, and +luck in Ranks).
function RewardsUI.Invite()
	task.spawn(function()
		local okCan, can = pcall(function()
			return SocialService:CanSendGameInviteAsync(LocalPlayer)
		end)
		if okCan and can == false then
			UIKit.Toast("Invites aren't available on this account.", "Info")
			return
		end
		local ok = pcall(function()
			local options = Instance.new("ExperienceInviteOptions")
			options.PromptMessage = "Come clean dishes with me in Rinse Cycle!"
			options.LaunchData = tostring(LocalPlayer.UserId)
			SocialService:PromptGameInvite(LocalPlayer, options)
		end)
		if not ok then
			UIKit.Toast("Couldn't open the invite. Try again!", "Info")
		end
	end)
end

function RewardsUI.PromptNotifications(): string
	local okCan, can = pcall(function()
		return ExperienceNotificationService:CanPromptOptInAsync()
	end)
	if okCan and can then
		pcall(function()
			ExperienceNotificationService:PromptOptIn()
		end)
		return "Asked"
	end
	return "AlreadyOn"
end

function RewardsUI.Init()
	if initialized then
		return
	end
	initialized = true
	local _gui, screenRoot = UIKit.CreateScreen("RewardsUI", 11)
	buildCodes(screenRoot)
	buildFree(screenRoot)
end

return RewardsUI</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000044"><Properties><string name="Name">ShopUI</string><ProtectedString name="Source">--[[
	ShopUI - the lobby "Shop" window: Perks (bought with Bubbles, permanent) and Robux (game passes).
	Opened from the Soap Shop ProximityPrompt (routed by Effects via OpenWindow="Shop"), the HUD [🛒 Shop]
	button, or the G key - all outside our scope, they just call UIKit.OpenWindow("Shop").

	Everything here reads ClientState.Meta, which is nil until the profile finishes loading; the window
	shows a "loading" placeholder rather than erroring if it's opened in that window.
]]

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Types = require(Shared:WaitForChild("Types"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local Client = script.Parent
local ClientState = require(Client:WaitForChild("ClientState"))
local UIKit = require(Client:WaitForChild("UIKit"))

local Colors = UIKit.Theme.Colors
local LocalPlayer = Players.LocalPlayer

local ShopUI = {}

-- Live Robux prices. With Roblox's regional pricing on, players in some countries pay a different
-- price than the one in Config, so once an item has a real Id the shop asks Roblox for the price
-- this player will actually see and shows that (Config's Price is only the fallback).
local livePrice: { [string]: number } = {}
local priceWaiters: { [string]: { (number) -&gt; () } } = {}
function ShopUI.WatchPrice(def: any, isPass: boolean, apply: (number) -&gt; ())
	apply(def.Price or 0)
	if type(def.Id) ~= "number" or def.Id &lt;= 0 then
		return
	end
	local key = (if isPass then "P" else "D") .. def.Id
	if livePrice[key] then
		apply(livePrice[key])
		return
	end
	local waiting = priceWaiters[key]
	if waiting then
		table.insert(waiting, apply)
		return
	end
	priceWaiters[key] = { apply }
	task.spawn(function()
		local ok, info = pcall(function()
			return MarketplaceService:GetProductInfo(def.Id, if isPass then Enum.InfoType.GamePass else Enum.InfoType.Product)
		end)
		local price = if ok and type(info) == "table" and type(info.PriceInRobux) == "number" then info.PriceInRobux else nil
		local list = priceWaiters[key] or {}
		priceWaiters[key] = nil
		if price then
			livePrice[key] = price
			for _, fn in list do
				pcall(fn, price)
			end
		end
	end)
end

local WINDOW_SIZE = Vector2.new(880, 560)

local initialized = false
type Tab = "Perks" | "Passes" | "Bubbles" | "Gems" | "Coins"
local activeTab: Tab = "Perks"
local TABS: { { Key: Tab, Text: string, Color: Color3 } } = {
	{ Key = "Perks", Text = "Perks", Color = Colors.Bubble },
	{ Key = "Passes", Text = "Passes", Color = Colors.Good },
	{ Key = "Bubbles", Text = "Bubbles", Color = Colors.Primary },
	{ Key = "Gems", Text = "Gems", Color = Colors.Accent },
	{ Key = "Coins", Text = "Coins", Color = Colors.Coin },
}
local tabButtons: { [string]: TextButton } = {}

local content: Frame
local tabsRow: Frame
local list: ScrollingFrame

----------------------------------------------------------------------------------------------------
-- Perks tab
----------------------------------------------------------------------------------------------------

local function buildPerkRow(def: any): Frame
	local meta = ClientState.Meta
	local level = (meta and meta.Perks[def.Id]) or 0
	local bubbles = (meta and meta.Bubbles) or 0

	local row = UIKit.Card({ Size = UDim2.new(1, 0, 0, 84), Name = def.Id })

	UIKit.Label({
		Text = def.Icon,
		TextSize = 32,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 12, 0.5, 0),
		Size = UDim2.fromOffset(44, 44),
		Parent = row,
	})

	local textCol = Instance.new("Frame")
	textCol.BackgroundTransparency = 1
	textCol.AnchorPoint = Vector2.new(0, 0.5)
	textCol.Position = UDim2.new(0, 66, 0.5, 0)
	textCol.Size = UDim2.new(1, -66 - 150, 1, -12)
	textCol.Parent = row
	UIKit.Label({
		Text = def.Name .. "   Lv " .. level .. "/" .. def.Max,
		TextSize = 18,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, 0, 0, 22),
		Parent = textCol,
	})
	UIKit.Label({
		Text = def.Desc,
		TextSize = 13,
		TextColor3 = Colors.TextDim,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true,
		Position = UDim2.fromOffset(0, 24),
		Size = UDim2.new(1, 0, 0, 40),
		Parent = textCol,
	})

	local cost = Config.PerkCost(def.Id, level)
	if not cost then
		UIKit.Button({
			Text = "MAX",
			Size = UDim2.fromOffset(130, 46),
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -14, 0.5, 0),
			Color = Colors.Disabled,
			Disabled = true,
			Sound = false,
			Parent = row,
		})
	else
		UIKit.Button({
			Text = UIKit.Short(cost) .. " Bubbles",
			Size = UDim2.fromOffset(130, 46),
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -14, 0.5, 0),
			Color = Colors.Bubble,
			Disabled = not meta or bubbles &lt; cost,
			Parent = row,
			OnClick = function()
				local result = ClientState.MetaRequest("BuyPerk", def.Id)
				if result.Ok then
					UIKit.Bounce(row)
					UIKit.PlaySound("Coins")
				else
					UIKit.Toast(result.Error or "Couldn't buy that.", "Bad")
					UIKit.PlaySound("Error")
				end
			end,
		})
	end

	return row
end

----------------------------------------------------------------------------------------------------
-- Robux tab
----------------------------------------------------------------------------------------------------

-- Buying a pass for yourself: Roblox's prompt (MarketService grants it), or a free Studio test.
local function buyPassForSelf(def: any)
	if type(def.Id) == "number" and def.Id ~= 0 then
		pcall(function()
			MarketplaceService:PromptGamePassPurchase(LocalPlayer, def.Id)
		end)
		return
	end
	-- No Id yet: test mode (Studio only by default). See Config.GamePasses.
	local result = ClientState.MetaRequest("TestPass", def.Key)
	if not result.Ok then
		UIKit.Toast(result.Error or "Coming soon!", "Info")
	end
end

local function openPassBuy(def: any, giftOnly: boolean?)
	-- A sub-menu of the Shop: its Back button returns to the Passes tab.
	UIKit.OpenSubWindow("PassBuy", { Def = def, GiftOnly = giftOnly == true }, "Shop", "Passes")
end

local function buildPassRow(def: any): Frame
	local meta = ClientState.Meta
	local owned = meta ~= nil and meta.Passes[def.Key] == true

	local row = UIKit.Card({ Size = UDim2.new(1, 0, 0, 84), Name = def.Key })

	UIKit.Label({
		Text = def.Icon,
		TextSize = 32,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 12, 0.5, 0),
		Size = UDim2.fromOffset(44, 44),
		Parent = row,
	})

	local textCol = Instance.new("Frame")
	textCol.BackgroundTransparency = 1
	textCol.AnchorPoint = Vector2.new(0, 0.5)
	textCol.Position = UDim2.new(0, 66, 0.5, 0)
	textCol.Size = UDim2.new(1, -66 - 150, 1, -12)
	textCol.Parent = row
	UIKit.Label({
		Text = def.Name,
		TextSize = 18,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, 0, 0, 22),
		Parent = textCol,
	})
	UIKit.Label({
		Text = def.Desc,
		TextSize = 13,
		TextColor3 = Colors.TextDim,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true,
		Position = UDim2.fromOffset(0, 24),
		Size = UDim2.new(1, 0, 0, 40),
		Parent = textCol,
	})

	-- The same price button whether you own it or not (so it's clear it can still be gifted);
	-- owning it just adds a small "Owned" above, and the buy window says so.
	if owned then
		UIKit.Label({
			Text = "Owned",
			TextSize = 14,
			TextColor3 = Colors.Good,
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -14, 0, 2),
			Size = UDim2.fromOffset(130, 16),
			TextXAlignment = Enum.TextXAlignment.Center,
			Parent = row,
		})
	end
	local buyButton = UIKit.Button({
		Text = "R$ " .. tostring(def.Price or "?"),
		Size = UDim2.fromOffset(130, 46),
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -14, 0.5, if owned then 6 else 0),
		Color = Colors.Good,
		Parent = row,
		OnClick = function()
			-- For yourself, or as a gift? (PassBuy window)
			openPassBuy(def)
		end,
	})
	ShopUI.WatchPrice(def, true, function(price)
		if buyButton.Parent then
			buyButton.Text = "R$ " .. price
		end
	end)

	return row
end

----------------------------------------------------------------------------------------------------
-- Developer products (Bubbles / Gems / Coins packs)
----------------------------------------------------------------------------------------------------

-- Buy helpers other windows use too (Ranks' x2 Luck button, the "not enough coins" offer).
function ShopUI.BuyPass(key: string)
	local def = Config.GetPass(key)
	if not def then
		return
	end
	if type(def.Id) == "number" and def.Id ~= 0 then
		pcall(function()
			MarketplaceService:PromptGamePassPurchase(LocalPlayer, def.Id)
		end)
		return
	end
	-- No Id pasted yet: in Studio this gives the pass free for the test (never in the live game).
	local result = ClientState.MetaRequest("TestPass", def.Key)
	if result.Ok then
		UIKit.Toast(string.format("Studio test: the %s pass has no ID yet, so you got it free. In the live game this is the Robux prompt.", def.Name), "Info")
	else
		UIKit.Toast(result.Error or "Coming soon!", "Info")
	end
end

-- "I want this tool": buy it with coins if you can afford it, otherwise offer its tool pass
-- (Config.Tools[i].PassKey), which gives it in every run. Returns the RunRequest result, or nil
-- when a pass was offered instead.
local offering = false
function ShopUI.GetTool(index: number): Types.RequestResult?
	local run = ClientState.Run
	local tool = Config.Tools[index]
	if not run or not tool or offering then
		return nil
	end
	local cost = Config.ToolCost(index, run.Level) or 0
	if run.Coins &lt; cost and tool.PassKey then
		local pass = Config.GetPass(tool.PassKey)
		if pass and not (ClientState.Meta and ClientState.Meta.Passes[tool.PassKey]) then
			UIKit.Toast(string.format("Need %s more coins for the %s - or get it forever!", UIKit.Commas(cost - run.Coins), tool.Name), "Info")
			ShopUI.BuyPass(tool.PassKey)
			return nil
		end
	end
	offering = true
	local result = ClientState.RunRequest("BuyTool", index)
	offering = false
	return result
end

-- Returns true if the purchase went through right away (test mode); a real prompt returns false
-- (MarketService grants the goods when Roblox confirms it).
function ShopUI.BuyProduct(key: string): boolean
	local def = Config.GetProduct(key)
	if not def then
		return false
	end
	if type(def.Id) == "number" and def.Id ~= 0 then
		pcall(function()
			MarketplaceService:PromptProductPurchase(LocalPlayer, def.Id)
		end)
		return false
	end
	local result = ClientState.MetaRequest("TestProduct", def.Key)
	if not result.Ok then
		UIKit.Toast(result.Error or "Coming soon!", "Info")
		return false
	end
	UIKit.Confetti(50)
	return true
end

local function buildProductRow(def: any): Frame
	local run = ClientState.Run
	local row = UIKit.Card({ Size = UDim2.new(1, 0, 0, 84), Name = def.Key })
	UIKit.Label({
		Text = def.Icon,
		TextSize = 32,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 12, 0.5, 0),
		Size = UDim2.fromOffset(44, 44),
		Parent = row,
	})
	local amount = def.Amount
	local unit = if def.Kind == "Gems" then "💎" elseif def.Kind == "Coins" then "💰" else "🧼"
	local note = ""
	if def.Kind == "Coins" then
		if run then
			amount = math.floor(def.Amount * Config.GetLevel(run.Level).Mult + 0.5)
			note = "  (added to this run)"
		else
			note = "  (buy inside a dishwasher)"
		end
	end
	UIKit.Label({
		Text = def.Name,
		TextSize = 18,
		TextXAlignment = Enum.TextXAlignment.Left,
		Position = UDim2.fromOffset(66, 10),
		Size = UDim2.new(1, -226, 0, 22),
		Parent = row,
	})
	UIKit.Label({
		Text = string.format("+%s %s%s", UIKit.Commas(amount), unit, note),
		TextSize = 20,
		TextColor3 = if def.Kind == "Gems" then Color3.fromRGB(220, 180, 255) elseif def.Kind == "Coins" then Colors.Coin else Colors.Bubble,
		TextXAlignment = Enum.TextXAlignment.Left,
		Position = UDim2.fromOffset(66, 40),
		Size = UDim2.new(1, -226, 0, 26),
		Parent = row,
	})
	local buyButton = UIKit.Button({
		Text = "R$ " .. tostring(def.Price),
		Size = UDim2.fromOffset(130, 46),
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -14, 0.5, 0),
		Color = Colors.Good,
		Disabled = def.Kind == "Coins" and not run,
		Parent = row,
		OnClick = function()
			if type(def.Id) == "number" and def.Id ~= 0 then
				pcall(function()
					MarketplaceService:PromptProductPurchase(LocalPlayer, def.Id)
				end)
				return
			end
			-- No Id yet: test mode (Studio only by default). See Config.DevProducts.
			local result = ClientState.MetaRequest("TestProduct", def.Key)
			if result.Ok then
				UIKit.Confetti(50)
				UIKit.Toast(string.format("+%s %s!", UIKit.Commas(amount), unit), "Good")
				UIKit.Bounce(row)
			else
				UIKit.Toast(result.Error or "Coming soon!", "Info")
			end
		end,
	})
	ShopUI.WatchPrice(def, false, function(price)
		if buyButton.Parent then
			buyButton.Text = "R$ " .. price
		end
	end)
	return row
end

----------------------------------------------------------------------------------------------------
-- Render
----------------------------------------------------------------------------------------------------

local function render()
	-- Coins only exist inside a dishwasher, so the Coins tab only shows there.
	local inRun = ClientState.Run ~= nil
	if activeTab == "Coins" and not inRun then
		activeTab = "Perks"
	end
	for _, tab in TABS do
		local button = tabButtons[tab.Key]
		if button then
			button.Visible = tab.Key ~= "Coins" or inRun
			UIKit.SetButtonColor(button, if activeTab == tab.Key then tab.Color else Colors.PanelLight)
		end
	end

	list:ClearAllChildren()
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 10)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = list

	if not ClientState.Meta then
		UIKit.Label({
			Text = "Loading your profile...",
			TextSize = 20,
			TextColor3 = Colors.TextDim,
			Size = UDim2.new(1, 0, 0, 40),
			Parent = list,
		})
		return
	end

	if activeTab == "Perks" then
		for _, def in Config.Perks do
			buildPerkRow(def).Parent = list
		end
	elseif activeTab ~= "Passes" then
		for i, def in Config.DevProducts or {} do
			if def.Kind == activeTab then
				local row = buildProductRow(def)
				row.LayoutOrder = i
				row.Parent = list
			end
		end
	else
		local shown = 0
		for i, def in Config.GamePasses do
			local row = buildPassRow(def)
			row.LayoutOrder = i
			row.Parent = list
			shown += 1
		end
		if shown == 0 then
			UIKit.Label({
				Text = "More coming soon!",
				TextSize = 22,
				TextColor3 = Colors.TextDim,
				TextXAlignment = Enum.TextXAlignment.Center,
				Size = UDim2.new(1, 0, 0, 60),
				Parent = list,
			})
		end
	end
end

local function setTab(tab: Tab)
	if activeTab == tab then
		return
	end
	activeTab = tab
	render()
end

function ShopUI.Init()
	if initialized then
		return
	end
	initialized = true

	local _gui, screenRoot = UIKit.CreateScreen("ShopUI", 10)

	local _window, windowContent = UIKit.Window({
		Name = "Shop",
		Title = "Shop",
		Icon = "🛒",
		Size = WINDOW_SIZE,
		Parent = screenRoot,
	})
	content = windowContent

	------------------------------------------------------------------ Buy for yourself, or gift it
	local _passWindow, passContent = UIKit.Window({
		Name = "PassBuy",
		Title = "Get a Pass",
		Icon = "🎁",
		Size = Vector2.new(560, 470),
		Parent = screenRoot,
	})
	local passBody = Instance.new("Frame")
	passBody.BackgroundTransparency = 1
	passBody.Size = UDim2.fromScale(1, 1)
	passBody.Parent = passContent
	local function clearBody()
		for _, child in passBody:GetChildren() do
			child:Destroy()
		end
	end
	local function header(def: any)
		UIKit.Label({ Text = def.Icon .. "  " .. def.Name, TextSize = 28, Size = UDim2.new(1, 0, 0, 40), Parent = passBody })
	end
	local function giftTo(def: any, target: Player)
		local ok, result = pcall(function()
			return Remotes.Function("GiftRequest"):InvokeServer(def.Key, target.UserId)
		end)
		if not ok or type(result) ~= "table" then
			UIKit.Toast("Couldn't start the gift. Try again!", "Bad")
			return
		end
		if not result.Ok then
			UIKit.Toast(result.Error or "Couldn't gift that.", "Bad")
			return
		end
		UIKit.CloseWindow("PassBuy")
		if type(result.ProductId) == "number" then
			pcall(function()
				MarketplaceService:PromptProductPurchase(LocalPlayer, result.ProductId)
			end)
		end
	end
	local function drawPicker(def: any)
		clearBody()
		header(def)
		UIKit.Label({ Text = "Who do you want to gift it to?", TextSize = 20, TextColor3 = Colors.TextDim, Position = UDim2.fromOffset(0, 44), Size = UDim2.new(1, 0, 0, 26), Parent = passBody })
		local list = Instance.new("ScrollingFrame")
		list.BackgroundTransparency = 1
		list.BorderSizePixel = 0
		list.Position = UDim2.fromOffset(0, 80)
		list.Size = UDim2.new(1, 0, 1, -80)
		list.ScrollBarThickness = 6
		list.CanvasSize = UDim2.new()
		list.AutomaticCanvasSize = Enum.AutomaticSize.Y
		list.Parent = passBody
		local layout = Instance.new("UIListLayout")
		layout.Padding = UDim.new(0, 8)
		layout.SortOrder = Enum.SortOrder.LayoutOrder
		layout.Parent = list
		local count = 0
		for i, plr in Players:GetPlayers() do
			if plr == LocalPlayer or plr:GetAttribute("AdminInvis") == true then
				continue
			end
			count += 1
			local r = UIKit.Card({ Size = UDim2.new(1, -12, 0, 58), Color = Colors.PanelLight, Parent = list })
			r.LayoutOrder = i
			UIKit.Label({ Text = plr.DisplayName .. "  @" .. plr.Name, TextSize = 18, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Position = UDim2.fromOffset(14, 0), Size = UDim2.new(1, -160, 1, 0), Parent = r })
			UIKit.Button({
				Text = "Gift",
				Color = Colors.Good,
				TextSize = 18,
				Size = UDim2.fromOffset(130, 44),
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -8, 0.5, 0),
				Parent = r,
				OnClick = function()
					giftTo(def, plr)
				end,
			})
		end
		if count == 0 then
			UIKit.Label({ Text = "Nobody else is in this server yet.", TextSize = 18, TextColor3 = Colors.TextDim, Size = UDim2.new(1, 0, 0, 50), Parent = list })
		end
	end
	local function drawChoice(def: any)
		clearBody()
		header(def)
		UIKit.Label({ Text = tostring(def.Desc or ""), TextSize = 18, TextColor3 = Colors.TextDim, TextWrapped = true, Position = UDim2.fromOffset(10, 46), Size = UDim2.new(1, -20, 0, 60), Parent = passBody })
		local meta = ClientState.Meta
		local owned = meta ~= nil and meta.Passes[def.Key] == true
		local selfButton = UIKit.Button({
			Text = if owned then "Game Pass already owned" else "Buy for myself  (R$ " .. tostring(def.Price or "?") .. ")",
			Color = if owned then Colors.Disabled else Colors.Good,
			TextSize = 22,
			Size = UDim2.new(1, -40, 0, 70),
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0.5, 0, 0, 124),
			Parent = passBody,
			OnClick = function()
				if owned then
					UIKit.Toast("You already own " .. tostring(def.Name) .. ". You can still gift it!", "Info")
					return
				end
				UIKit.CloseWindow("PassBuy")
				buyPassForSelf(def)
			end,
		})
		ShopUI.WatchPrice(def, true, function(price)
			if selfButton.Parent and not owned then
				selfButton.Text = "Buy for myself  (R$ " .. price .. ")"
			end
		end)
		UIKit.Button({
			Text = "Gift it to a friend",
			Color = Colors.Primary,
			TextSize = 22,
			Size = UDim2.new(1, -40, 0, 70),
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0.5, 0, 0, 210),
			Parent = passBody,
			OnClick = function()
				drawPicker(def)
			end,
		})
	end
	UIKit.RegisterWindow("PassBuy", {
		Open = function(arg)
			local def = type(arg) == "table" and arg.Def
			if not def then
				return
			end
			if arg.GiftOnly or not Config.GetGiftProduct(def.Key) then
				local meta = ClientState.Meta
				if arg.GiftOnly then
					drawPicker(def)
				elseif meta ~= nil and meta.Passes[def.Key] == true then
					UIKit.CloseWindow("PassBuy")
					UIKit.Toast("You already own " .. tostring(def.Name) .. "!", "Info")
				else
					UIKit.CloseWindow("PassBuy")
					buyPassForSelf(def)
				end
			else
				drawChoice(def)
			end
		end,
	})

	tabsRow = Instance.new("Frame")
	tabsRow.Name = "Tabs"
	tabsRow.Size = UDim2.new(1, 0, 0, 44)
	tabsRow.BackgroundTransparency = 1
	tabsRow.Parent = content
	local tabsLayout = Instance.new("UIListLayout")
	tabsLayout.SortOrder = Enum.SortOrder.LayoutOrder
	tabsLayout.FillDirection = Enum.FillDirection.Horizontal
	tabsLayout.Padding = UDim.new(0, 10)
	tabsLayout.Parent = tabsRow

	for i, tab in TABS do
		tabButtons[tab.Key] = UIKit.Button({
			Text = tab.Text,
			Size = UDim2.fromOffset(146, 44),
			CornerRadius = 10,
			TextSize = 20,
			LayoutOrder = i,
			Parent = tabsRow,
			OnClick = function()
				setTab(tab.Key)
			end,
		})
	end

	list = Instance.new("ScrollingFrame")
	list.Name = "List"
	list.Position = UDim2.fromOffset(0, 54)
	list.Size = UDim2.new(1, 0, 1, -54)
	list.BackgroundTransparency = 1
	list.BorderSizePixel = 0
	list.ScrollBarThickness = 8
	list.ScrollBarImageColor3 = Colors.Primary
	list.CanvasSize = UDim2.new(0, 0, 0, 0)
	list.AutomaticCanvasSize = Enum.AutomaticSize.Y
	list.Parent = content

	-- The Shop opens on the tab that's most useful where you are: Coins in a run, Perks outside.
	UIKit.RegisterWindow("Shop", {
		Open = function(arg)
			if type(arg) == "string" then
				activeTab = arg :: Tab
			elseif ClientState.Run then
				activeTab = "Coins"
			end
			render()
		end,
	})
	ClientState.Changed:Connect(function(kind)
		if kind == "Run" and UIKit.IsWindowOpen("Shop") then
			render()
		end
	end)

	-- Celebrate a purchase the moment it happens, never just because a pass you already own showed
	-- up (ownership is re-checked on every join and server hop). MarketService sends the message.
	-- Roblox's own "purchase complete" box takes a few seconds to go away, so we show dots meanwhile
	-- ("Confirming your purchase...") and congratulate once it has.
	local function confirmPurchase(name: string?)
		local done = UIKit.Busy("Confirming your purchase", true)
		task.delay(5, function()
			done()
			UIKit.PlaySound("Sparkle")
			UIKit.Confetti(120)
			UIKit.Toast(if name then string.format("Purchase complete: %s! Thank you!", name) else "Purchase complete! Thank you!", "Good")
		end)
	end
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if player == LocalPlayer and purchased then
			local name: string? = nil
			for _, pass in Config.GamePasses do
				if pass.Id == passId then
					name = pass.Name
				end
			end
			confirmPurchase(name)
		end
	end)
	MarketplaceService.PromptProductPurchaseFinished:Connect(function(userId, productId, purchased)
		if userId ~= LocalPlayer.UserId or not purchased then
			return
		end
		for _, product in Config.DevProducts do
			if product.Id == productId then
				confirmPurchase(product.Name)
				return
			end
		end
		-- Gifts, chests and the luck ad have their own celebration.
		for _, id in Config.EventProducts do
			if id == productId then
				return
			end
		end
		for _, gift in Config.GiftProducts do
			if gift.Id == productId then
				return
			end
		end
		confirmPurchase(nil)
	end)
	ClientState.Changed:Connect(function(kind)
		if kind == "Meta" and UIKit.IsWindowOpen("Shop") then
			render()
		end
	end)
end

return ShopUI</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000045"><Properties><string name="Name">SprayController</string><ProtectedString name="Source">-- SprayController: aiming, spray input, spray visuals, and sending Scrub to the server.
--
-- Active only while ClientState.Run.Phase == "Playing" and the run's arena has replicated in.
-- Aim comes from the mouse on PC, the finger on touch (tap / hold the dirt), or the screen centre
-- (with a crosshair) on gamepad, cast
-- as a ray Include-filtered to just the arena Model. One Heartbeat connection drives everything so
-- there is exactly one place that decides whether to send, one place that moves the visuals, and
-- one place that cleans up (run end, character death, respawn).
--
-- The server is the authority on whether a Scrub lands: this module only decides whether it is
-- worth SENDING one (aim exists, in reach, tool is enough, tank isn't full) so we don't spam
-- packets the server would reject anyway, and so the local visuals never lie about what's about
-- to happen.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Types = require(Shared:WaitForChild("Types"))

local Client = script.Parent
local ClientState = require(Client:WaitForChild("ClientState"))
local UIKit = require(Client:WaitForChild("UIKit"))
local Bubbles = require(Client:WaitForChild("Bubbles"))
local WaterFX = require(Client:WaitForChild("WaterFX"))

local SprayController = {}

local LocalPlayer = Players.LocalPlayer
local ScrubEvent = Remotes.Event("Scrub")

----------------------------------------------------------------------------------------------------
-- Constants
----------------------------------------------------------------------------------------------------

local MAX_AIM_DISTANCE = 250
local RING_TRANSPARENCY = 0.35
local RING_THICKNESS = 0.15
local TANK_FULL_TOAST_GAP = 1.5 -- don't spam the toast every frame while stuck at a full tank
local SPLASH_EMIT_COUNT = 6
local TOUCH_BUTTON_SIZE = 132
local TOUCH_BUTTON_MARGIN = 20
local JUMP_ZONE_CLEARANCE = 300 -- keep the SPRAY button above Roblox's bottom-right jump button
local JUMP_ZONE_WIDTH = 270 -- the TURN button sits just left of the jump button

----------------------------------------------------------------------------------------------------
-- State
----------------------------------------------------------------------------------------------------

local initialized = false

local active = false -- Run exists, Phase == "Playing", arena replicated
local arenaModel: Model? = nil
local raycastParams = RaycastParams.new()
raycastParams.FilterType = Enum.RaycastFilterType.Include
raycastParams.IgnoreWater = true

local mouseHeld = false
local r2Held = false
local touchHeld = false
local touchInput: InputObject? = nil -- the finger that's spraying (touch screens)

local clickCount = 0
local lastSendAt = 0
local lastTankFullToastAt = 0

-- Visuals, built lazily and reused for the whole session.
local ring: BasePart? = nil
local ringAttachment: Attachment? = nil
local muzzleMist: ParticleEmitter? = nil -- fine spray puffing out right at the nozzle
local handAttachment: Attachment? = nil
local handPart: BasePart? = nil
local splashEmitter: ParticleEmitter? = nil
local hintAnchor: BasePart? = nil
local hintBillboard: BillboardGui? = nil
local hintLabel: TextLabel? = nil
-- Health bar over the dirt spot under the aim (drains as the server's HP attribute drops).
local hpAnchor: BasePart? = nil
local hpBillboard: BillboardGui? = nil
local hpFill: Frame? = nil
-- Pressure Washer line: a thin glowing blade on the surface (the water sheet to it is WaterFX).
local linePart: BasePart? = nil
local lastSudsAt = 0
-- Spray Nozzle water: droplets flying from the nozzle to the target, and a splash where it lands.
local sprayAttachment: Attachment? = nil
local sprayDrops: ParticleEmitter? = nil
local waterSplash: ParticleEmitter? = nil
local lastFoamAt = 0
-- Pressure Washer: the line runs across (false) or up and down (true). T / D-pad up / touch button.
local washerVertical = false
local turnButton: TextButton? = nil
local turnHint: TextLabel? = nil
local currentMode = "Scrub"

-- Touch-only UI.
local touchGui: ScreenGui? = nil
local touchRoot: Frame? = nil
local sprayButton: TextButton? = nil
local crosshair: Frame? = nil

local characterConns: { RBXScriptConnection } = {}

----------------------------------------------------------------------------------------------------
-- Small helpers
----------------------------------------------------------------------------------------------------

-- Fired when ClientState.Changed listens; kept local so combo/click bookkeeping resets per run.
local function resetPerRunState()
	clickCount = 0
	lastSendAt = 0
end

local function findHandPart(character: Model): BasePart?
	-- Tools with a nozzle (the washer's lance) spray from its tip.
	local held = character:FindFirstChild("HeldTool")
	local muzzle = held and held:FindFirstChild("Muzzle")
	if muzzle and muzzle:IsA("BasePart") then
		return muzzle
	end
	local hand = character:FindFirstChild("RightHand") -- R15
	if hand and hand:IsA("BasePart") then
		return hand
	end
	local arm = character:FindFirstChild("Right Arm") -- R6
	if arm and arm:IsA("BasePart") then
		return arm
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root :: BasePart
	end
	return nil
end

----------------------------------------------------------------------------------------------------
-- Visual builders (created once, reused and repositioned every frame)
----------------------------------------------------------------------------------------------------

local function ensureRing()
	if ring and ring.Parent then
		return
	end
	local part = Instance.new("Part")
	part.Name = "ScrubRing"
	part.Shape = Enum.PartType.Cylinder
	part.Material = Enum.Material.Neon
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.CastShadow = false
	part.Transparency = 1 -- hidden until the first valid aim
	part.Size = Vector3.new(RING_THICKNESS, 1, 1)
	part.Color = Color3.new(1, 1, 1)

	local attach = Instance.new("Attachment")
	attach.Name = "BeamTarget"
	attach.Parent = part

	local splash = Instance.new("ParticleEmitter")
	splash.Name = "Splash"
	splash.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	splash.Lifetime = NumberRange.new(0.2, 0.4)
	splash.Speed = NumberRange.new(4, 9)
	splash.Rate = 0 -- emits only via :Emit()
	splash.SpreadAngle = Vector2.new(35, 35)
	splash.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 0) })
	splash.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
	splash.LightEmission = 0.6
	splash.Parent = attach

	part.Parent = workspace
	ring = part
	ringAttachment = attach
	splashEmitter = splash
end

local function ensureBeam(character: Model)
	local hand = findHandPart(character)
	if not hand then
		return
	end
	if handPart ~= hand or not handAttachment or not handAttachment.Parent then
		if handAttachment then
			handAttachment:Destroy()
		end
		handPart = hand

		local origin = Instance.new("Attachment")
		origin.Name = "SprayOrigin"
		origin.Position = if hand.Name == "Muzzle" then Vector3.zero else Vector3.new(0, 0, -0.2)
		origin.Parent = hand
		handAttachment = origin

		ensureRing()
		local mist = Instance.new("ParticleEmitter")
		mist.Name = "MuzzleMist"
		mist.Texture = "rbxasset://textures/particles/smoke_main.dds"
		mist.Color = ColorSequence.new(Color3.fromRGB(235, 248, 255), Color3.fromRGB(140, 200, 255))
		mist.LightEmission = 0.4
		mist.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.12), NumberSequenceKeypoint.new(1, 0.55) })
		mist.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 1) })
		mist.Lifetime = NumberRange.new(0.15, 0.3)
		mist.Speed = NumberRange.new(4, 9)
		mist.SpreadAngle = Vector2.new(25, 25)
		mist.EmissionDirection = Enum.NormalId.Front
		mist.Rate = 0
		mist.Parent = origin
		muzzleMist = mist
	end
end

local function ensureLine()
	if linePart and linePart.Parent then
		return
	end
	local part = Instance.new("Part")
	part.Name = "WasherLine"
	part.Material = Enum.Material.Neon
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.CastShadow = false
	part.Transparency = 1
	part.Size = Vector3.new(4, 0.12, 0.9)
	part.Parent = workspace
	linePart = part
end

local function ensureWater(hand: BasePart)
	if sprayAttachment and sprayAttachment.Parent == hand and sprayDrops and waterSplash and waterSplash.Parent then
		return
	end
	if sprayAttachment then
		sprayAttachment:Destroy()
	end
	local a = Instance.new("Attachment")
	a.Name = "SprayWater"
	a.Parent = hand
	sprayAttachment = a
	local drops = Instance.new("ParticleEmitter")
	drops.Name = "Droplets"
	-- Water droplets drawn as streaks along their flight (not sparkles), so they read as spray.
	drops.Texture = "rbxasset://textures/particles/smoke_main.dds"
	drops.Color = ColorSequence.new(Color3.fromRGB(235, 248, 255), Color3.fromRGB(140, 200, 255))
	drops.LightEmission = 0.45
	drops.Orientation = Enum.ParticleOrientation.VelocityParallel
	drops.Squash = NumberSequence.new(1.6)
	drops.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.07), NumberSequenceKeypoint.new(1, 0.14) })
	drops.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.15), NumberSequenceKeypoint.new(1, 0.85) })
	drops.Lifetime = NumberRange.new(0.3, 0.45)
	drops.Speed = NumberRange.new(65, 80)
	drops.SpreadAngle = Vector2.new(3, 3)
	drops.Acceleration = Vector3.new(0, -40, 0)
	drops.EmissionDirection = Enum.NormalId.Front
	drops.Rate = 0
	drops.Parent = a
	sprayDrops = drops
	-- Splash at the target: rides on the aim ring's attachment.
	if ringAttachment then
		local splash = Instance.new("ParticleEmitter")
		splash.Name = "WaterSplash"
		splash.Texture = "rbxasset://textures/particles/smoke_main.dds"
		splash.Color = ColorSequence.new(Color3.fromRGB(215, 240, 255))
		splash.LightEmission = 0.3
		splash.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 1.4) })
		splash.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 1) })
		splash.Lifetime = NumberRange.new(0.25, 0.5)
		splash.Speed = NumberRange.new(8, 16)
		splash.SpreadAngle = Vector2.new(70, 70)
		splash.Acceleration = Vector3.new(0, -30, 0)
		splash.EmissionDirection = Enum.NormalId.Right -- the ring's X axis is the surface normal
		splash.Rate = 0
		splash.Parent = ringAttachment
		waterSplash = splash
	end
end

local function hideLine()
	if linePart then
		linePart.Transparency = 1
	end
end

-- A foam blob flying from the hand to the target in a short arc (the splat itself comes back from
-- the server as a "Foam" FX, so everyone in the party sees it).
local function launchFoam(from: Vector3, to: Vector3, color: Color3)
	local blob = Instance.new("Part")
	blob.Name = "FoamBlob"
	blob.Shape = Enum.PartType.Ball
	blob.Material = Enum.Material.SmoothPlastic
	blob.Color = Color3.new(1, 1, 1):Lerp(color, 0.15)
	blob.Size = Vector3.one * 1.3
	blob.Anchored = true
	blob.CanCollide = false
	blob.CanQuery = false
	blob.CanTouch = false
	blob.CastShadow = false
	blob.CFrame = CFrame.new(from)
	blob.Parent = workspace
	local flight = math.clamp((to - from).Magnitude / 90, 0.12, 0.35)
	local arc = math.min(4, (to - from).Magnitude * 0.08)
	task.spawn(function()
		local t = 0
		while t &lt; flight and blob.Parent do
			t += RunService.Heartbeat:Wait()
			local k = math.min(t / flight, 1)
			local pos = from:Lerp(to, k) + Vector3.new(0, math.sin(k * math.pi) * arc, 0)
			blob.CFrame = CFrame.new(pos)
			if math.random() &lt; 0.5 then
				Bubbles.Emit(pos, { Count = 1, Spread = 0.3, Velocity = Vector3.new(0, 1, 0), Jitter = 1, Size = { 0.25, 0.6 }, Life = { 0.4, 0.8 } })
			end
		end
		blob:Destroy()
	end)
end

local function ensureHealthBar()
	if hpAnchor and hpAnchor.Parent then
		return
	end
	local part = Instance.new("Part")
	part.Name = "DirtHealthAnchor"
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.CastShadow = false
	part.Transparency = 1
	part.Size = Vector3.new(0.2, 0.2, 0.2)
	part.Parent = workspace
	hpAnchor = part

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "DirtHealth"
	billboard.Size = UDim2.fromOffset(90, 14)
	billboard.StudsOffsetWorldSpace = Vector3.new(0, 1.6, 0)
	billboard.AlwaysOnTop = true
	billboard.Enabled = false
	billboard.Parent = part
	hpBillboard = billboard

	local back = Instance.new("Frame")
	back.Size = UDim2.fromScale(1, 1)
	back.BackgroundColor3 = UIKit.Theme.Colors.PanelDark
	back.BorderSizePixel = 0
	UIKit.Corner(back, 999)
	UIKit.Stroke(back, UIKit.Theme.Colors.Ink, 2)
	back.Parent = billboard
	local fill = Instance.new("Frame")
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = UIKit.Theme.Colors.Good
	fill.BorderSizePixel = 0
	UIKit.Corner(fill, 999)
	fill.Parent = back
	hpFill = fill
end

-- Shows the bar over `part` if it's a dirt spot (it carries HP/MaxHP attributes), else hides it.
local function updateHealthBar(part: BasePart?)
	if not hpBillboard or not hpAnchor or not hpFill then
		return
	end
	local hp = part and part:GetAttribute("HP")
	local maxHp = part and part:GetAttribute("MaxHP")
	if not part or not part.Parent or type(hp) ~= "number" or type(maxHp) ~= "number" or maxHp &lt;= 0 then
		hpBillboard.Enabled = false
		return
	end
	local fraction = math.clamp(hp / maxHp, 0, 1)
	hpAnchor.CFrame = CFrame.new(part.Position)
	hpFill.Size = UDim2.fromScale(math.max(fraction, 0.04), 1)
	hpFill.BackgroundColor3 = UIKit.Theme.Colors.Bad:Lerp(UIKit.Theme.Colors.Good, fraction)
	hpBillboard.Enabled = true
end

local function ensureHint()
	if hintAnchor and hintAnchor.Parent then
		return
	end
	local part = Instance.new("Part")
	part.Name = "SprayHintAnchor"
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.CastShadow = false
	part.Transparency = 1
	part.Size = Vector3.new(0.2, 0.2, 0.2)
	part.Parent = workspace
	hintAnchor = part

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "MinToolHint"
	billboard.Size = UDim2.fromOffset(220, 44)
	billboard.StudsOffset = Vector3.new(0, 1.2, 0)
	billboard.AlwaysOnTop = true
	billboard.Enabled = false
	billboard.Parent = part
	hintBillboard = billboard

	hintLabel = UIKit.Label({
		Size = UDim2.fromScale(1, 1),
		TextSize = 22,
		TextColor3 = UIKit.Theme.Colors.Text,
		Parent = billboard,
	})
end

-- Touch SPRAY button + PC/gamepad crosshair, placed just above Roblox's bottom-right jump button.
local function ensureTouchUI()
	if touchGui and touchGui.Parent then
		return
	end
	touchGui, touchRoot = UIKit.CreateScreen("Spray", 5)

	local cross = UIKit.New("Frame", {
		Name = "Crosshair",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(10, 10),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.25,
		Visible = false,
		Parent = touchRoot,
	}) :: Frame
	UIKit.Corner(cross, 999)
	UIKit.Stroke(cross, UIKit.Theme.Colors.Stroke, 2, 0.3)
	crosshair = cross

	turnHint = UIKit.Label({
		Name = "WasherHint",
		Text = "",
		TextSize = 18,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -150),
		Size = UDim2.fromOffset(420, 26),
		Visible = false,
		Parent = touchRoot,
	})

	sprayButton = UIKit.IconButton({
		Name = "SprayButton",
		Icon = "💧",
		Label = "SPRAY",
		Color = UIKit.Theme.Colors.Primary,
		Size = UDim2.fromOffset(TOUCH_BUTTON_SIZE, TOUCH_BUTTON_SIZE),
		AnchorPoint = Vector2.new(1, 1),
		Visible = false,
		Sound = false, -- the scrub sound plays instead of a click
		Parent = touchRoot,
	})

	local function reposition()
		local insets = UIKit.SafeInsets()
		local pos = UDim2.new(
			1,
			-(TOUCH_BUTTON_MARGIN + insets.Right),
			1,
			-(JUMP_ZONE_CLEARANCE + TOUCH_BUTTON_MARGIN + insets.Bottom)
		)
		;(sprayButton :: TextButton).Position = pos
		if turnButton then
			-- Bottom right, just left of Roblox's jump button (clear of Shop / Upgrades above).
			turnButton.Position = UDim2.new(1, -(JUMP_ZONE_WIDTH + insets.Right), 1, -(TOUCH_BUTTON_MARGIN + insets.Bottom))
		end
	end
	turnButton = UIKit.IconButton({
		Name = "TurnLine",
		Icon = "↕️",
		Label = "TURN",
		Color = UIKit.Theme.Colors.Accent,
		Size = UDim2.fromOffset(96, 96),
		AnchorPoint = Vector2.new(1, 1),
		Visible = false,
		Parent = touchRoot,
		OnClick = function()
			SprayController.ToggleWasher()
		end,
	})
	reposition()
	UIKit.LayoutChanged:Connect(reposition)

	local button = sprayButton :: TextButton
	button.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
			touchHeld = true
		end
	end)
	button.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
			touchHeld = false
			touchInput = nil
		end
	end)
end

local function updateTouchUIVisibility()
	if not sprayButton or not crosshair then
		return
	end
	local touch = UIKit.IsTouch()
	local gamepad = UIKit.IsGamepad()
	-- Touch sprays wherever you tap, so there's no SPRAY button and no centre dot.
	sprayButton.Visible = false
	crosshair.Visible = active and gamepad
	local line = active and currentMode == "Line"
	if turnButton then
		turnButton.Visible = line and touch
	end
	if turnHint then
		turnHint.Visible = line and not touch
		turnHint.Text = string.format("%s  %s: turn the line", if washerVertical then "Up and down" else "Across", if gamepad then "D-pad ↑" else "T")
	end
	if not active then
		touchHeld = false
		touchInput = nil
	end
end

----------------------------------------------------------------------------------------------------
-- Hiding / showing
----------------------------------------------------------------------------------------------------

local function hideVisuals()
	if ring then
		ring.Transparency = 1
	end
	WaterFX.Hide()
	if muzzleMist then
		muzzleMist.Rate = 0
	end
	if hintBillboard then
		hintBillboard.Enabled = false
	end
	if hpBillboard then
		hpBillboard.Enabled = false
	end
	hideLine()
	if sprayDrops then
		sprayDrops.Rate = 0
	end
	if waterSplash then
		waterSplash.Rate = 0
	end
end

local function cleanupForRunEnd()
	hideVisuals()
	mouseHeld = false
	r2Held = false
	touchHeld = false
	touchInput = nil
end

----------------------------------------------------------------------------------------------------
-- Aiming
----------------------------------------------------------------------------------------------------

-- Only dishes and dirt can be aimed at, so walls, rack floors and invisible safety walls never
-- swallow the aim ray. Falls back to the whole arena for arenas built without those folders.
local function aimTargets(arena: Model): { Instance }
	local targets: { Instance } = {}
	for _, name in { "Dishes", "Grime" } do
		local folder = arena:FindFirstChild(name)
		if folder then
			table.insert(targets, folder)
		end
	end
	if #targets == 0 then
		table.insert(targets, arena)
	end
	return targets
end

-- Touch: wherever the finger is (tap or hold on the dirt itself). Nil when no finger is down, so
-- nothing is aimed at (no dot stuck in the middle of the screen).
local function aimRay(camera: Camera): Ray?
	if UIKit.IsTouch() and not UIKit.IsGamepad() then
		local touch = touchInput
		if not touch then
			return nil
		end
		return camera:ScreenPointToRay(touch.Position.X, touch.Position.Y)
	end
	if UIKit.IsGamepad() then
		local size = camera.ViewportSize
		return camera:ViewportPointToRay(size.X * 0.5, size.Y * 0.5)
	end
	local loc = UserInputService:GetMouseLocation()
	return camera:ViewportPointToRay(loc.X, loc.Y)
end

----------------------------------------------------------------------------------------------------
-- Sending
----------------------------------------------------------------------------------------------------

-- The cheapest tool that can clean dirt needing `tier`.
local function toolName(tier: number): string
	for _, tool in Config.Tools do
		if (tool.Tier or 1) &gt;= tier then
			return tool.Name
		end
	end
	return "a bigger tool"
end

local function sendScrub(hitPosition: Vector3, holding: boolean, pitchJitter: number, extra: { [string]: any }?)
	ScrubEvent:FireServer(hitPosition, holding, extra)
	UIKit.PlaySound("Scrub", 0.9 + pitchJitter * 0.25)
	if splashEmitter then
		splashEmitter:Emit(SPLASH_EMIT_COUNT)
	end
end

----------------------------------------------------------------------------------------------------
-- Per-frame update
----------------------------------------------------------------------------------------------------

local function onHeartbeat(dt: number)
	if not active then
		return
	end
	local run = ClientState.Run :: Types.RunState?
	if not run or run.Phase ~= "Playing" then
		return
	end
	local character = LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local camera = workspace.CurrentCamera
	if not character or not root or not root:IsA("BasePart") or not camera or not arenaModel or not arenaModel.Parent then
		hideVisuals()
		return
	end
	ensureBeam(character)
	ensureRing()
	ensureHint()
	ensureHealthBar()

	raycastParams.FilterDescendantsInstances = aimTargets(arenaModel :: Model)
	local ray = aimRay(camera)
	if not ray then
		hideVisuals()
		return
	end
	local result = workspace:Raycast(ray.Origin, ray.Direction.Unit * MAX_AIM_DISTANCE, raycastParams)

	local pressed = mouseHeld or r2Held or touchHeld
	local stats = run.Stats

	if not result then
		hideVisuals()
		return
	end

	local hitPart = result.Instance
	local hitPos = result.Position
	local distance = (hitPos - (root :: BasePart).Position).Magnitude
	local inReach = distance &lt;= stats.Reach
	local toolColor = (Config.Tools[stats.ToolIndex] or Config.Tools[1]).Color

	local mode = stats.Mode or "Scrub"
	if mode ~= currentMode then
		currentMode = mode
		updateTouchUIVisibility()
	end
	local normal = result.Normal
	local r = ring :: BasePart

	-- Aim marker. Scrub / Spray: a ring the size of the cleaning circle. Foam: a fainter ring the
	-- size of the splat. Line: the washer's blade, turned with the camera, lying on the surface.
	local lineDir: Vector3? = nil
	if mode == "Line" then
		r.Transparency = 1
		r.CFrame = CFrame.lookAt(hitPos, hitPos + normal) * CFrame.Angles(0, math.rad(90), 0) -- splash source
		ensureLine()
		local base = if washerVertical then camera.CFrame.UpVector else camera.CFrame.RightVector
		local dir = base - normal * base:Dot(normal)
		dir = if dir.Magnitude &gt; 1e-3 then dir.Unit else normal:Cross(Vector3.xAxis).Unit
		lineDir = dir
		local len = stats.LineLength or 5
		local lp = linePart :: BasePart
		lp.Size = Vector3.new(len, 0.12, stats.LineWidth or 0.9)
		lp.CFrame = CFrame.fromMatrix(hitPos + normal * 0.08, dir, normal)
		lp.Color = if inReach then toolColor else UIKit.Theme.Colors.Bad
		lp.Transparency = if inReach then 0.3 else 0.6
	else
		hideLine()
		r.CFrame = CFrame.lookAt(hitPos, hitPos + normal) * CFrame.Angles(0, math.rad(90), 0)
		r.Size = Vector3.new(RING_THICKNESS, stats.Radius * 2, stats.Radius * 2)
		if inReach then
			r.Color = toolColor
			r.Transparency = if mode == "Foam" then 0.6 else RING_TRANSPARENCY
		else
			r.Color = UIKit.Theme.Colors.Bad
			r.Transparency = 0.5
		end
	end

	updateHealthBar(hitPart)

	-- MinTool lock hint: shown whenever the aimed part needs a tool we don't have yet.
	local minTool = hitPart:GetAttribute("MinTool")
	local needsTool = type(minTool) == "number" and minTool &gt; (stats.Tier or stats.ToolIndex)
	if needsTool and hintAnchor and hintBillboard and hintLabel then
		hintAnchor.CFrame = CFrame.new(hitPos)
		hintLabel.Text = "A " .. toolName(minTool :: number) .. " cleans this much faster"
		hintBillboard.Enabled = true
	elseif hintBillboard then
		hintBillboard.Enabled = false
	end

	local tankFull = run.Tank &gt;= run.TankMax
	local canSend = pressed and inReach and not tankFull

	local now = os.clock()
	local sending = false

	if canSend then
		if mode == "Foam" then
			-- One blob per FoamInterval while held.
			if now - lastFoamAt &gt;= (stats.FoamInterval or 0.4) then
				lastFoamAt = now
				local from = if handAttachment then handAttachment.WorldPosition else (root :: BasePart).Position
				launchFoam(from, hitPos, toolColor)
				sendScrub(hitPos, true, math.random(), { Normal = normal })
			end
		elseif now - lastSendAt &gt;= Config.Round.ScrubSendInterval then
			lastSendAt = now
			sendScrub(hitPos, true, math.random(), if lineDir then { Dir = lineDir, Normal = normal } else nil)
			sending = true
		else
			sending = true
		end
		-- Scrubbing tools froth up suds right on the dish (bare hands don't: no soap).
		if sending and mode == "Scrub" and stats.ToolIndex &gt; 1 and now - lastSudsAt &gt; 0.12 then
			lastSudsAt = now
			Bubbles.Emit(hitPos + normal * 0.3, { Count = 4, Spread = stats.Radius * 0.7, Velocity = normal * 1.5 + Vector3.new(0, 0.8, 0), Jitter = 1, Size = { 0.25, 0.8 }, Life = { 1.4, 2.6 }, Rise = 1.2 })
		end
	elseif tankFull and pressed then
		if now - lastTankFullToastAt &gt; TANK_FULL_TOAST_GAP then
			lastTankFullToastAt = now
			UIKit.Toast("TANK FULL! Go sell at the drain!", "Bad")
		end
	end

	-- Spray Nozzle (and the washer): a real spray of droplets from the nozzle to the target,
	-- splashing where it lands.
	local jetting = sending and mode == "Line"
	local spraying = sending and mode == "Spray"
	if handPart then
		ensureWater(handPart)
	end
	if sprayAttachment and (spraying or jetting) then
		sprayAttachment.WorldCFrame = CFrame.lookAt(sprayAttachment.WorldPosition, hitPos)
	end
	if sprayDrops then
		sprayDrops.Rate = if spraying then 140 elseif jetting then 90 else 0
		sprayDrops.Speed = if jetting then NumberRange.new(100, 120) else NumberRange.new(65, 80)
	end
	if waterSplash then
		waterSplash.Rate = if spraying then 45 elseif jetting then 70 else 0
	end
	if muzzleMist then
		muzzleMist.Rate = if spraying then 30 elseif jetting then 45 else 0
	end

	-- The water itself (WaterFX): the hose's streams over the circle, or the washer's sheet to its
	-- line. Scrubbing tools work right on the dish.
	local nozzle = handPart
	if spraying and nozzle then
		WaterFX.Spray(nozzle, hitPos, normal, stats.Radius)
	elseif jetting and nozzle and linePart and lineDir then
		local half = (stats.LineLength or 5) / 2
		local center = hitPos + normal * 0.08
		WaterFX.Fan(nozzle, center - lineDir * half, center + lineDir * half, normal)
	else
		WaterFX.Hide()
	end
end

-- The single-click (non-Hold) rising edge is handled on input, not in the Heartbeat, so a very
-- short tap always registers even if the render thread is briefly behind.
local function onPressBegan()
	if not active then
		return
	end
	local run = ClientState.Run :: Types.RunState?
	if not run or run.Phase ~= "Playing" or run.Stats.Hold then
		return
	end
	-- Re-validate against the last known aim by re-raycasting right now, so a tap while moving the
	-- mouse doesn't scrub whatever was under the crosshair a frame ago.
	local camera = workspace.CurrentCamera
	local character = LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not camera or not root or not root:IsA("BasePart") or not arenaModel or not arenaModel.Parent then
		return
	end
	raycastParams.FilterDescendantsInstances = aimTargets(arenaModel :: Model)
	local ray = aimRay(camera)
	if not ray then
		return
	end
	local result = workspace:Raycast(ray.Origin, ray.Direction.Unit * MAX_AIM_DISTANCE, raycastParams)
	if not result then
		return
	end
	local distance = (result.Position - (root :: BasePart).Position).Magnitude
	if distance &gt; run.Stats.Reach or run.Tank &gt;= run.TankMax then
		return
	end

	lastSendAt = os.clock()
	sendScrub(result.Position, false, math.random())

	clickCount += 1
end

----------------------------------------------------------------------------------------------------
-- Input wiring
----------------------------------------------------------------------------------------------------

function SprayController.ToggleWasher()
	washerVertical = not washerVertical
	UIKit.PlaySound("Click")
	if turnButton then
		local label = turnButton:FindFirstChild("Icon", true)
		if label and label:IsA("TextLabel") then
			label.Text = if washerVertical then "↔️" else "↕️"
		end
	end
	updateTouchUIVisibility()
end

local function onInputBegan(input: InputObject, processed: boolean)
	if processed then
		return
	end
	if active and currentMode == "Line" and (input.KeyCode == Enum.KeyCode.T or input.KeyCode == Enum.KeyCode.DPadUp) then
		SprayController.ToggleWasher()
		return
	end
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		mouseHeld = true
		onPressBegan()
	elseif input.UserInputType == Enum.UserInputType.Touch and active and touchInput == nil then
		-- A finger on the world (not on a button or the thumbstick): spray right there, and keep
		-- spraying wherever it moves until it lifts.
		touchInput = input
		touchHeld = true
		onPressBegan()
	elseif input.KeyCode == Enum.KeyCode.ButtonR2 then
		r2Held = true
		onPressBegan()
	end
end

local function onInputEnded(input: InputObject, _processed: boolean)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		mouseHeld = false
	elseif input == touchInput then
		touchInput = nil
		touchHeld = false
	elseif input.KeyCode == Enum.KeyCode.ButtonR2 then
		r2Held = false
	end
end

----------------------------------------------------------------------------------------------------
-- Run / character lifecycle
----------------------------------------------------------------------------------------------------

local function disconnectCharacterConns()
	for _, c in characterConns do
		c:Disconnect()
	end
	table.clear(characterConns)
end

local function onCharacterAdded(character: Model)
	disconnectCharacterConns()
	handPart = nil -- force ensureBeam to rebuild for the new character
	local humanoid = character:WaitForChild("Humanoid", 5)
	if humanoid and humanoid:IsA("Humanoid") then
		table.insert(
			characterConns,
			humanoid.Died:Connect(function()
				cleanupForRunEnd()
			end)
		)
	end
end

local function refreshActive()
	local run = ClientState.Run :: Types.RunState?
	local wasActive = active
	if run and run.Phase == "Playing" then
		arenaModel = ClientState.GetArena()
		active = arenaModel ~= nil
	else
		arenaModel = nil
		active = false
	end
	if not wasActive and active then
		resetPerRunState()
	end
	if not active then
		cleanupForRunEnd()
	end
	updateTouchUIVisibility()
end

----------------------------------------------------------------------------------------------------
-- Init
----------------------------------------------------------------------------------------------------

function SprayController.Init()
	if initialized then
		return
	end
	initialized = true

	ensureTouchUI()
	ensureRing()
	ensureHint()

	ClientState.Changed:Connect(function(kind)
		if kind == "Run" then
			refreshActive()
		end
	end)
	refreshActive()

	UserInputService.InputBegan:Connect(onInputBegan)
	UserInputService.InputEnded:Connect(onInputEnded)
	UIKit.LayoutChanged:Connect(updateTouchUIVisibility)

	if LocalPlayer.Character then
		onCharacterAdded(LocalPlayer.Character)
	end
	LocalPlayer.CharacterAdded:Connect(onCharacterAdded)
	LocalPlayer.CharacterRemoving:Connect(function()
		disconnectCharacterConns()
		cleanupForRunEnd()
	end)

	RunService.Heartbeat:Connect(onHeartbeat)
end

return SprayController</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000046"><Properties><string name="Name">StayOffer</string><ProtectedString name="Source">--[[
	StayOffer - "WAIT! Don't leave yet!" When a player opens the Roblox menu (usually on the way to
	Leave), they're offered a free x2 cleaning boost for 15 minutes, once a day
	(DataService.ClaimStayBoost; saved to their data, so leaving and rejoining can't claim it twice).
	The popup is big and loud on purpose: it sits behind Roblox's menu, so it's the first thing they
	see the moment they close it.

	Also the boost badges: a column of small chips beside the left-hand buttons showing what's boosting you
	right now - "x2 Cleaning 14:32" while the stay boost runs, and one chip per owned multiplier
	pass (x2 Coins, x2 Bubbles, x2 Luck, ...).
]]

local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local Client = script.Parent
local UIKit = require(Client:WaitForChild("UIKit"))
local ClientState = require(Client:WaitForChild("ClientState"))

local StayOffer = {}

local Colors = UIKit.Theme.Colors

-- Passes that multiply something, in the order their chips appear: grouped by colour (green
-- next to the green x2 Cleaning chip, then yellows, blues, pink).
local PASS_BADGES = {
	{ Key = "DoubleLuck", Text = "x2 Luck", Color = Colors.Good },
	{ Key = "DoubleCoins", Text = "x2 Coins", Color = Colors.Coin },
	{ Key = "LuckyCharm", Text = "x2 Gold Dirt", Color = Colors.Coin },
	{ Key = "VIP", Text = "VIP +25%", Color = Colors.Coin },
	{ Key = "MegaTank", Text = "x2 Tank", Color = Colors.Primary },
	{ Key = "SuperScrub", Text = "+50% Clean", Color = Colors.Primary },
	{ Key = "DoubleBubbles", Text = "x2 Bubbles", Color = Colors.Bubble },
}

local initialized = false
local offeredThisSession = false

local function boostLeft(): number
	local meta = ClientState.Meta :: any
	local untilTime = meta and tonumber(meta.BoostUntil) or 0
	return math.max(0, untilTime - os.time())
end

local function claim()
	local result = ClientState.MetaRequest("ClaimStayBoost")
	UIKit.CloseWindow("StayOffer")
	if result.Ok then
		UIKit.PlaySound("Sparkle")
		UIKit.Confetti(80)
		UIKit.Toast(result.Message or "x2 Cleaning for 15 minutes!", "Good")
	else
		UIKit.Toast(result.Error or "Couldn't claim that.", "Info")
	end
end

-- Grows and shrinks a GUI forever (while it's visible), to pull the eye.
local function pulse(gui: GuiObject, amount: number, period: number)
	local scale = Instance.new("UIScale")
	scale.Parent = gui
	local tween = TweenService:Create(
		scale,
		TweenInfo.new(period / 2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
		{ Scale = 1 + amount }
	)
	tween:Play()
end

local BADGE_WIDTH = 124 -- fits the longest, "x2 Clean 14:59"
local BADGE_HEIGHT = 22
local BADGE_GAP = 4
local BADGES_PER_COLUMN = 4

local function badge(parent: GuiObject, text: string, color: Color3, order: number, width: number?): (Frame, TextLabel)
	local chip = Instance.new("Frame")
	chip.Name = "Badge"
	chip.LayoutOrder = order
	chip.Size = UDim2.fromOffset(width or BADGE_WIDTH, BADGE_HEIGHT) -- all one width, so they line up
	chip.BackgroundColor3 = color
	chip.BorderSizePixel = 0
	chip.Visible = false
	UIKit.Corner(chip, 7)
	UIKit.Stroke(chip, Colors.Ink, 2)
	local label = UIKit.Label({
		Text = text,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
		Position = UDim2.fromOffset(8, 0),
		Size = UDim2.new(1, -10, 1, 0),
		Parent = chip,
	})
	chip.Parent = parent
	return chip, label
end

function StayOffer.Init()
	if initialized then
		return
	end
	initialized = true

	local _gui, root = UIKit.CreateScreen("StayOffer", 35)
	local _window, content = UIKit.Window({
		Name = "StayOffer",
		Title = "Before you go...",
		Size = Vector2.new(940, 580), -- as big as the screen allows (windows shrink to fit)
		Parent = root,
	})
	local headline = UIKit.Label({
		Text = "WAIT! DON'T LEAVE YET!",
		TextSize = 72,
		TextScaled = true,
		TextColor3 = Colors.Bad,
		Size = UDim2.new(1, -40, 0, 82),
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 6),
		Parent = content,
	})
	pulse(headline, 0.06, 0.9)
	UIKit.Label({
		Text = "FREE x2 Cleaning Speed for 15 minutes!",
		TextSize = 44,
		TextScaled = true,
		TextColor3 = Colors.Coin,
		Size = UDim2.new(1, -60, 0, 54),
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 96),
		Parent = content,
	})
	UIKit.Label({
		Text = "Everything you and your pets clean counts DOUBLE. Only once a day, and it's gone if you leave now!",
		TextSize = 26,
		TextWrapped = true,
		Size = UDim2.new(1, -80, 0, 70),
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 158),
		Parent = content,
	})
	local claimButton = UIKit.Button({
		Text = "CLAIM x2 BOOST!",
		Color = Colors.Good,
		TextSize = 52,
		Size = UDim2.new(1, -160, 0, 110),
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 244),
		Parent = content,
		OnClick = function()
			task.spawn(claim)
		end,
	})
	pulse(claimButton, 0.05, 0.8)
	UIKit.Button({
		Text = "No thanks, I'll leave",
		Color = Colors.Disabled,
		TextSize = 18,
		Size = UDim2.fromOffset(260, 44),
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 378),
		Parent = content,
		OnClick = function()
			UIKit.CloseWindow("StayOffer")
		end,
	})
	UIKit.RegisterWindow("StayOffer", { Open = function() end })

	-- Boost badges: a neat column just right of the left-hand buttons (Daily, Codes, ...), clear of
	-- the Bubbles pill, the pop-up messages, the run's progress bar and Roblox's player list.
	local row = Instance.new("Frame")
	row.Name = "BoostBadges"
	row.AnchorPoint = Vector2.new(0, 0)
	row.Position = UDim2.fromOffset(108, 140)
	row.Size = UDim2.fromOffset(BADGE_WIDTH, 300)
	row.BackgroundTransparency = 1
	-- Its own screen layer under every window (HUD is 5, windows 10+), so menus cover the badges.
	local _badgeGui, badgeRoot = UIKit.CreateScreen("BoostBadges", 4)
	row.Parent = badgeRoot
	-- Laid out by hand: columns of BADGES_PER_COLUMN, the next column to the right
	-- (1-2-3-4, then 1-2-3), so the stack never gets taller than four.

	-- Above the HUD's left column (it moves for phones, the thumbstick and runs; on PC the HUD
	-- slides it down to make room, from the "BadgeStackHeight" attribute). If there isn't room
	-- above it (phones), beside it instead.
	local function placeRow(count: number)
		local rows = math.min(count, BADGES_PER_COLUMN)
		local height = if rows &gt; 0 then rows * (BADGE_HEIGHT + BADGE_GAP) - BADGE_GAP else 0
		if Players.LocalPlayer:GetAttribute("BadgeStackHeight") ~= height then
			Players.LocalPlayer:SetAttribute("BadgeStackHeight", height)
		end
		local hud = Players.LocalPlayer:FindFirstChildOfClass("PlayerGui")
		local column = hud and hud:FindFirstChild("LeftColumn", true)
		local inset = UIKit.TopInset()
		if column and column:IsA("GuiObject") and column.Visible and column.AbsoluteSize.Y &gt; 0 then
			local colH = column.AbsoluteSize.Y / UIKit.GetScale()
			local colTop = column.Position.Y.Offset - colH / 2
			local x = column.Position.X.Offset
			if colTop - 10 - height &gt;= inset + 6 then
				row.Position = UDim2.fromOffset(x, math.floor(colTop - 10 - height))
			else
				row.Position = UDim2.fromOffset(x + column.Size.X.Offset + 12, math.floor(colTop + 4))
			end
		else
			local safe = UIKit.SafeInsets()
			row.Position = UDim2.fromOffset(16 + math.floor(safe.Left * 0.5), math.floor(inset + 90))
		end
	end

	local boostChip, boostLabel = badge(row, "", Colors.Good, 0)
	local passChips = {}
	for i, def in PASS_BADGES do
		passChips[def.Key] = badge(row, def.Text, def.Color, i)
	end

	local function cutscenePlaying(): boolean
		local ok, playing = pcall(function()
			return (require(Client:WaitForChild("Cutscene")) :: any).IsPlaying()
		end)
		return ok and playing == true
	end

	task.spawn(function()
		while true do
			local meta = ClientState.Meta :: any
			local passes = meta and meta.Passes or {}
			row.Visible = not cutscenePlaying()
			local left = boostLeft()
			boostChip.Visible = left &gt; 0
			if left &gt; 0 then
				boostLabel.Text = string.format("x2 Clean %d:%02d", left // 60, left % 60)
			end
			local shown = {}
			if left &gt; 0 then
				table.insert(shown, boostChip)
			end
			for _, def in PASS_BADGES do
				local chip = passChips[def.Key]
				chip.Visible = passes[def.Key] == true
				if chip.Visible then
					table.insert(shown, chip)
				end
			end
			for i, chip in shown do
				local col, line = (i - 1) // BADGES_PER_COLUMN, (i - 1) % BADGES_PER_COLUMN
				chip.Position = UDim2.fromOffset(col * (BADGE_WIDTH + BADGE_GAP + 2), line * (BADGE_HEIGHT + BADGE_GAP))
			end
			row.Size = UDim2.fromOffset(BADGE_WIDTH * 2 + BADGE_GAP + 2, 300)
			placeRow(#shown)
			task.wait(1)
		end
	end)

	-- Opening the Roblox menu: offer today's boost (once a session, and only if it's still free).
	GuiService.MenuOpened:Connect(function()
		local meta = ClientState.Meta :: any
		if offeredThisSession or not meta or meta.StayBoostReady ~= true or boostLeft() &gt; 0 then
			return
		end
		offeredThisSession = true
		UIKit.OpenWindow("StayOffer")
	end)
end

return StayOffer</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000047"><Properties><string name="Name">TradeUI</string><ProtectedString name="Source">--[[
	TradeUI - pet trading (lobby only; TradeService on the server checks everything).

	  * The 🤝 Trade button (HUD) opens the Trade window: everyone in the server with a Request
	    button. A sent request can be cancelled while it's open; the same player can only be asked
	    again after a wait (shown on the button), unless they've accepted one before.
	  * A request you receive pops up at the top of the screen with Accept / Decline (it goes away
	    if the sender cancels).
	  * During a trade the window shows both offers, and your pets below: tap a pet to offer it,
	    tap it in your offer to take it back. Both press Ready; after a "3, 2, 1" countdown the pets
	    swap (either side can still cancel or un-ready during it). Any change un-readies both sides. Closing the window cancels the trade.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local PetModels = require(Shared:WaitForChild("PetModels"))

local Client = script.Parent
local UIKit = require(Client:WaitForChild("UIKit"))
local ClientState = require(Client:WaitForChild("ClientState"))

local TradeUI = {}

local Colors = UIKit.Theme.Colors
local LocalPlayer = Players.LocalPlayer

local CELL = Vector2.new(96, 112)

local initialized = false
local state: any = nil -- the current TradeState, nil when not trading
-- Requests I've sent: [tostring(userId)] = { PendingUntil?, WaitUntil? } (server time).
local outgoing: { [string]: { PendingUntil: number?, WaitUntil: number? } } = {}
local pickerRows: { { Button: TextButton, Cancel: TextButton, UserId: number } } = {}
local inviteCards: { [number]: Frame } = {}
local content: Frame
local body: Frame
local actionRemote: RemoteEvent

local function send(action: string, value: any?)
	actionRemote:FireServer(action, value)
end

local function clear(frame: Instance)
	for _, child in frame:GetChildren() do
		child:Destroy()
	end
end

local function petName(id: string, tier: number?): string
	local def = Config.Pets[id]
	local name = if def then def.Name else id
	local tierName = Config.PetTier(tier).Name
	return if tierName ~= "" then tierName .. " " .. name else name
end

-- One pet tile. onClick is optional.
local function petCell(parent: Instance, entry: any, order: number, onClick: (() -&gt; ())?, highlight: boolean?): Frame
	local card = UIKit.Card({
		Size = UDim2.fromOffset(CELL.X, CELL.Y),
		Color = if highlight then Colors.Primary else Colors.PanelLight,
		Parent = parent,
	})
	card.LayoutOrder = order
	local vp = UIKit.Viewport({
		Model = PetModels.Build(entry.Id, entry.Tier),
		Size = UDim2.fromOffset(CELL.X - 12, 72),
		Position = UDim2.new(0.5, 0, 0, 4),
		AnchorPoint = Vector2.new(0.5, 0),
		Parent = card,
	})
	vp.ZIndex = 1
	UIKit.Label({
		Text = petName(entry.Id, entry.Tier),
		TextSize = 14,
		TextScaled = true,
		TextColor3 = Config.PetTier(entry.Tier).Color or Colors.Text,
		Size = UDim2.new(1, -8, 0, 30),
		Position = UDim2.new(0.5, 0, 0, 78),
		AnchorPoint = Vector2.new(0.5, 0),
		TextWrapped = true,
		Parent = card,
	})
	if onClick then
		local hit = Instance.new("TextButton")
		hit.BackgroundTransparency = 1
		hit.Text = ""
		hit.Size = UDim2.fromScale(1, 1)
		hit.ZIndex = 5
		hit.Parent = card
		hit.MouseButton1Click:Connect(onClick)
	end
	return card
end

local function grid(parent: Instance, size: UDim2, position: UDim2): ScrollingFrame
	local s = Instance.new("ScrollingFrame")
	s.BackgroundTransparency = 1
	s.BorderSizePixel = 0
	s.Size = size
	s.Position = position
	s.ScrollBarThickness = 6
	s.CanvasSize = UDim2.new()
	s.AutomaticCanvasSize = Enum.AutomaticSize.Y
	s.Parent = parent
	local layout = Instance.new("UIGridLayout")
	layout.CellSize = UDim2.fromOffset(CELL.X, CELL.Y)
	layout.CellPadding = UDim2.fromOffset(8, 8)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = s
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 4)
	pad.PaddingLeft = UDim.new(0, 4)
	pad.Parent = s
	return s
end

-- A small grey heading. position / size are UDim2s so the two halves follow the window's width.
local function heading(text: string, position: UDim2, size: UDim2)
	UIKit.Label({
		Text = text,
		TextSize = 18,
		TextScaled = true,
		TextColor3 = Colors.TextDim,
		TextXAlignment = Enum.TextXAlignment.Left,
		Position = position,
		Size = size,
		Parent = body,
	})
end

-- One side's offer: a dark panel holding the pet tiles, with a centred hint while it's empty
-- (the hint sits on the panel, not in the tile grid, so it's never cut to one tile's width).
local function offerPanel(position: UDim2, hint: string, empty: boolean): ScrollingFrame
	local panel = UIKit.Card({
		Size = UDim2.new(0.5, -8, 0, CELL.Y + 20),
		Position = position,
		Color = Colors.PanelDark,
		Parent = body,
	})
	local tiles = grid(panel, UDim2.new(1, -8, 1, -4), UDim2.fromOffset(4, 2))
	if empty then
		UIKit.Label({
			Text = hint,
			TextSize = 20,
			TextScaled = true,
			TextWrapped = true,
			TextColor3 = Colors.TextDim,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.new(1, -24, 0, 48),
			Parent = panel,
		})
	end
	return tiles
end

----------------------------------------------------------------------------------------------------
-- Pages
----------------------------------------------------------------------------------------------------

-- The button on a player's row: Request / Requested (+ Cancel) / Wait m:ss.
local function paintPickerRow(row: { Button: TextButton, Cancel: TextButton, UserId: number })
	local info = outgoing[tostring(row.UserId)]
	local now = Workspace:GetServerTimeNow()
	local pending = info and info.PendingUntil and info.PendingUntil &gt; now
	local wait = info and info.WaitUntil and info.WaitUntil &gt; now and info.WaitUntil - now
	row.Cancel.Visible = pending == true
	if pending then
		row.Button.Text = "Requested..."
		UIKit.SetButtonColor(row.Button, Colors.Disabled)
	elseif wait then
		local left = math.ceil(wait :: number)
		row.Button.Text = string.format("Wait %d:%02d", left // 60, left % 60)
		UIKit.SetButtonColor(row.Button, Colors.Disabled)
	else
		row.Button.Text = "Request"
		UIKit.SetButtonColor(row.Button, Colors.Good)
	end
end

local function drawPicker()
	clear(body)
	table.clear(pickerRows)
	UIKit.Label({
		Text = "Click someone to request to trade with them",
		TextSize = 22,
		Size = UDim2.new(1, 0, 0, 30),
		Parent = body,
	})
	local list = Instance.new("ScrollingFrame")
	list.BackgroundTransparency = 1
	list.BorderSizePixel = 0
	list.Size = UDim2.new(1, 0, 1, -40)
	list.Position = UDim2.fromOffset(0, 40)
	list.ScrollBarThickness = 6
	list.CanvasSize = UDim2.new()
	list.AutomaticCanvasSize = Enum.AutomaticSize.Y
	list.Parent = body
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 8)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = list
	local count = 0
	for i, plr in Players:GetPlayers() do
		-- Invisible admins aren't there as far as everyone else is concerned.
		if plr == LocalPlayer or plr:GetAttribute("AdminInvis") == true then
			continue
		end
		count += 1
		local card = UIKit.Card({ Size = UDim2.new(1, -12, 0, 60), Color = Colors.PanelLight, Parent = list })
		card.LayoutOrder = i
		UIKit.Label({
			Text = plr.DisplayName .. "  @" .. plr.Name,
			TextSize = 20,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Position = UDim2.fromOffset(16, 0),
			Size = UDim2.new(1, -330, 1, 0),
			Parent = card,
		})
		local userId = plr.UserId
		local button = UIKit.Button({
			Text = "Request",
			Color = Colors.Good,
			TextSize = 18,
			Size = UDim2.fromOffset(160, 44),
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -10, 0.5, 0),
			Parent = card,
			OnClick = function()
				send("Request", userId)
			end,
		})
		local cancel = UIKit.Button({
			Text = "Cancel",
			Color = Colors.Bad,
			TextSize = 18,
			Size = UDim2.fromOffset(120, 44),
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -178, 0.5, 0),
			Parent = card,
			OnClick = function()
				send("CancelRequest", userId)
			end,
		})
		local row = { Button = button, Cancel = cancel, UserId = userId }
		table.insert(pickerRows, row)
		paintPickerRow(row)
	end
	if count == 0 then
		UIKit.Label({
			Text = "No one else is here to trade with yet.",
			TextSize = 20,
			TextColor3 = Colors.TextDim,
			Size = UDim2.new(1, 0, 0, 60),
			Parent = list,
		})
	end
end

local function drawTrade()
	clear(body)
	local s = state
	UIKit.Label({
		Text = "Trading with " .. tostring(s.Partner.Name),
		TextSize = 22,
		Size = UDim2.new(1, 0, 0, 28),
		Parent = body,
	})

	heading(string.format("YOUR OFFER  (%d/%d)%s", #s.Mine, s.MaxOffer, if s.MyReady then "  ✅ READY" else ""), UDim2.fromOffset(4, 32), UDim2.new(0.5, -12, 0, 22))
	heading(string.format("%s'S OFFER%s", string.upper(tostring(s.Partner.Name)), if s.TheirReady then "  ✅ READY" else ""), UDim2.new(0.5, 8, 0, 32), UDim2.new(0.5, -12, 0, 22))
	local mine = offerPanel(UDim2.fromOffset(0, 58), "Select pets below to offer them", #s.Mine == 0)
	local theirs = offerPanel(UDim2.new(0.5, 8, 0, 58), "Nothing offered yet", #s.Theirs == 0)
	for i, entry in s.Mine do
		petCell(mine, entry, i, function()
			send("Remove", entry.Uid)
		end)
	end
	for i, entry in s.Theirs do
		petCell(theirs, entry, i)
	end

	heading("YOUR PETS  (tap to offer)", UDim2.fromOffset(4, 200), UDim2.new(1, -200, 0, 22))
	local offered: { [string]: boolean } = {}
	for _, e in s.Mine do
		offered[e.Uid] = true
	end
	local pets = grid(body, UDim2.new(1, -196, 1, -228), UDim2.fromOffset(0, 226))
	local meta = ClientState.Meta
	for i, entry in (meta and meta.Pets or {}) do
		if not offered[entry.Uid] then
			petCell(pets, entry, i, function()
				send("Add", entry.Uid)
			end)
		end
	end

	-- Right column: status, Ready, Cancel.
	local status = "Add pets, then both press Ready."
	if s.ConfirmAt then
		status = "Trading in 3..."
	elseif s.MyReady then
		status = "Waiting for " .. tostring(s.Partner.Name) .. "..."
	elseif s.TheirReady then
		status = tostring(s.Partner.Name) .. " is ready!"
	end
	local statusLabel = UIKit.Label({
		Text = status,
		TextSize = 18,
		TextWrapped = true,
		TextScaled = true,
		TextColor3 = if s.ConfirmAt then Colors.Good else Colors.Text,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 222),
		Size = UDim2.fromOffset(176, 70),
		Parent = body,
	})
	UIKit.Button({
		Text = if s.MyReady then "Not ready" else "Ready",
		Color = if s.MyReady then Colors.Warning else Colors.Good,
		TextSize = 22,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 300),
		Size = UDim2.fromOffset(176, 56),
		Parent = body,
		OnClick = function()
			send("Ready", not s.MyReady)
		end,
	})
	UIKit.Button({
		Text = "Cancel",
		Color = Colors.Bad,
		TextSize = 20,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 366),
		Size = UDim2.fromOffset(176, 48),
		Parent = body,
		OnClick = function()
			send("Cancel")
		end,
	})
	-- The countdown ticks on screen.
	if s.ConfirmAt then
		local at = s.ConfirmAt
		task.spawn(function()
			while state == s and statusLabel.Parent do
				local left = math.ceil(at - Workspace:GetServerTimeNow())
				if left &lt;= 0 then
					statusLabel.Text = "Trading!"
					break
				end
				statusLabel.Text = "Trading in " .. left .. "..."
				task.wait(0.2)
			end
		end)
	end
end

local function redraw()
	if not body then
		return
	end
	if state then
		drawTrade()
	else
		drawPicker()
	end
end

----------------------------------------------------------------------------------------------------
-- Invites
----------------------------------------------------------------------------------------------------

local inviteRoot: Frame

local function showInvite(from: { UserId: number, Name: string })
	local card = UIKit.Card({
		Size = UDim2.fromOffset(420, 120),
		Color = Colors.Panel,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 90),
		Parent = inviteRoot,
	})
	UIKit.Stroke(card, Colors.Ink, 3)
	UIKit.Label({
		Text = "🤝 " .. tostring(from.Name) .. " wants to trade pets!",
		TextSize = 20,
		TextScaled = true,
		Position = UDim2.fromOffset(12, 8),
		Size = UDim2.new(1, -24, 0, 34),
		Parent = card,
	})
	local old = inviteCards[from.UserId]
	if old and old.Parent then
		old:Destroy()
	end
	inviteCards[from.UserId] = card
	local function close()
		if card.Parent then
			card:Destroy()
		end
		if inviteCards[from.UserId] == card then
			inviteCards[from.UserId] = nil
		end
	end
	UIKit.Button({
		Text = "Accept",
		Color = Colors.Good,
		TextSize = 20,
		Size = UDim2.fromOffset(170, 50),
		Position = UDim2.new(0.5, -178, 1, -60),
		Parent = card,
		OnClick = function()
			send("Accept", from.UserId)
			close()
		end,
	})
	UIKit.Button({
		Text = "Decline",
		Color = Colors.Bad,
		TextSize = 20,
		Size = UDim2.fromOffset(170, 50),
		Position = UDim2.new(0.5, 8, 1, -60),
		Parent = card,
		OnClick = function()
			send("Decline", from.UserId)
			close()
		end,
	})
	task.delay(30, close)
end

----------------------------------------------------------------------------------------------------
-- Init
----------------------------------------------------------------------------------------------------

function TradeUI.Init()
	if initialized then
		return
	end
	initialized = true
	actionRemote = Remotes.Event("TradeAction")

	local _gui, root = UIKit.CreateScreen("TradeUI", 11)
	local _window, windowContent = UIKit.Window({
		Name = "Trade",
		Title = "Trade Pets",
		Icon = "🤝",
		Size = Vector2.new(880, 600),
		Parent = root,
	})
	content = windowContent
	body = Instance.new("Frame")
	body.Name = "Body"
	body.BackgroundTransparency = 1
	body.Size = UDim2.fromScale(1, 1)
	body.Parent = content

	local _igui, iroot = UIKit.CreateScreen("TradeInvites", 40)
	inviteRoot = iroot

	UIKit.RegisterWindow("Trade", {
		Open = function()
			redraw()
		end,
		Close = function()
			-- Walking away from the trade window ends the trade.
			if state then
				send("Cancel")
			end
		end,
	})

	Remotes.Event("TradeState").OnClientEvent:Connect(function(first, second)
		if first == "Invite" then
			if type(second) == "table" then
				showInvite(second)
			end
			return
		elseif first == "InviteCancelled" then
			local card = type(second) == "table" and inviteCards[tonumber(second.UserId) or 0]
			if card then
				card:Destroy()
				inviteCards[second.UserId] = nil
			end
			return
		elseif first == "Outgoing" then
			outgoing = if type(second) == "table" then second else {}
			for _, row in pickerRows do
				paintPickerRow(row)
			end
			return
		end
		local was = state
		state = first
		if state and not UIKit.IsWindowOpen("Trade") then
			UIKit.OpenWindow("Trade")
		elseif not state and was and UIKit.IsWindowOpen("Trade") then
			UIKit.CloseWindow("Trade")
		end
		redraw()
	end)
	-- Your pets list changes when a trade completes (or you hatch meanwhile).
	ClientState.Changed:Connect(function(kind)
		if kind == "Meta" and state and UIKit.IsWindowOpen("Trade") then
			redraw()
		end
	end)
	-- The Wait m:ss / Requested timers tick down while the picker is open.
	task.spawn(function()
		while true do
			task.wait(1)
			if not state and UIKit.IsWindowOpen("Trade") then
				for _, row in pickerRows do
					if row.Button.Parent then
						paintPickerRow(row)
					end
				end
			end
		end
	end)
	Players.PlayerAdded:Connect(function()
		if not state and UIKit.IsWindowOpen("Trade") then
			redraw()
		end
	end)
	Players.PlayerRemoving:Connect(function()
		if not state and UIKit.IsWindowOpen("Trade") then
			task.defer(redraw)
		end
	end)
end

return TradeUI</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000048"><Properties><string name="Name">UIKit</string><ProtectedString name="Source">--[[
	UIKit - Rinse Cycle's design system. Every screen, window, button and toast in the game is built
	with it, so the whole game shares one look: bright aqua, deep navy glass panels, chunky rounded
	buttons with a darker "lip" and a soap-bubble shine, white FredokaOne text with a dark outline.

	USAGE
		local UIKit = require(script.Parent:WaitForChild("UIKit"))
		local C = UIKit.Theme.Colors

		-- 1. A screen. `root` is a virtual ~1280x720 canvas: build in reference pixels and UIKit
		--    scales everything to the real screen (landscape phones get ~0.46, 4K gets up to 2).
		local gui, root = UIKit.CreateScreen("Shop", 10)

		-- 2. A window (hidden by default). The same name in Window and RegisterWindow links them:
		--    UIKit shows, animates and hides the frame itself, the handlers only refresh content.
		local window, content = UIKit.Window({ Name = "Shop", Title = "Soap Shop", Icon = "🛒",
			Size = Vector2.new(820, 520), Parent = root })
		UIKit.RegisterWindow("Shop", { Open = function(arg) refresh() end, Close = function() end })
		UIKit.ToggleWindow("Shop")        -- OpenWindow / CloseWindow / IsWindowOpen / WindowChanged
		window:SetAttribute("Title", "…") -- live title change (also "Icon")

		-- 3. Buttons. OnClick plays the click sound, respects the Disabled attribute and ignores new
		--    clicks while a previous OnClick is still yielding (no double purchases).
		local buy = UIKit.Button({ Text = "Buy", Size = UDim2.fromOffset(160, 56), Color = C.Good,
			Parent = content, OnClick = function() ... end })
		buy:SetAttribute("Disabled", true) -- greyed out, ignores clicks (a little wobble); false/nil re-enables
		buy.Text = "MAX"                   -- Text / TextColor3 / TextSize / BackgroundColor3 (= the face
		buy.BackgroundColor3 = C.Bad       -- colour) restyle a UIKit button live, tweens included

		-- 4. Everything else
		UIKit.Toast("Not enough coins!", "Bad")        -- "Info" | "Good" | "Bad"
		local bar = UIKit.ProgressBar({ Size = UDim2.fromOffset(300, 34), Parent = root })
		bar.Set(0.42, "42% clean")                     -- bar.SetColor(C.Bad) recolours the fill
		UIKit.LayoutChanged:Connect(relayout)          -- re-place things that use TopInset()/IsTouch()

	RULES OF THUMB
		* Anything near the top of the screen sits below UIKit.TopInset() (canvas units).
		* On touch (UIKit.IsTouch()) keep the bottom-left 420x320 and bottom-right 300x300 clear.
		* TextSize 18 minimum for anything important (the HUD must read at 0.46 scale).
		* UIKit.Label adds a dark text outline; pass Stroke = false to skip it.
		* Use OnClick, not button.Activated, or the Disabled attribute is not respected.
		* UIGradient tints everything its parent draws, text included. Put text in a child label.
]]

local ContentProvider = game:GetService("ContentProvider")
local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TextService = game:GetService("TextService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local Util = require(Shared:WaitForChild("Util"))
local IconArt = require(script.Parent:WaitForChild("IconArt"))

local UIKit = {}

-- The reference canvas every screen is designed on.
local REF_W, REF_H = 1280, 720
local MIN_SCALE, MAX_SCALE = 0.4, 2
-- The topbar inset reads 0 for the first moments of a session, so it is re-read at these times.
local INSET_REREADS = { 0.25, 0.5, 1, 2, 3, 5 }

local WINDOW_MARGIN = 16
local WINDOW_TITLE_H = 56
local WINDOW_SHADOW_T = 0.55

local TOAST_MAX = 4
local TOAST_GAP = 8
local TOAST_TEXT_SIZE = 22
local TOAST_MAX_TEXT_W = 620

local SOUND_LOAD_TIMEOUT = 3 -- seconds before a sound that hasn't loaded is swapped for Fallback
local SOUND_MAX_VOICES = 8 -- simultaneous copies of one sound key
local SOUND_MIN_GAP = 0.03 -- the same key can't restart faster than this (20 pops in one frame = 1 pop)

----------------------------------------------------------------------------------------------------
-- Theme
----------------------------------------------------------------------------------------------------
local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

UIKit.Theme = {
	Colors = {
		Primary = rgb(56, 189, 248), -- #38BDF8 aqua
		PrimaryDark = rgb(2, 132, 199), -- #0284C7
		Accent = rgb(167, 139, 250), -- #A78BFA lavender soap
		Good = rgb(52, 211, 153), -- #34D399
		Bad = rgb(248, 113, 113), -- #F87171
		Warning = rgb(251, 146, 60), -- #FB923C
		Panel = rgb(19, 49, 92), -- #13315C
		PanelDark = rgb(11, 37, 69), -- #0B2545
		Text = rgb(255, 255, 255),
		TextDim = rgb(166, 196, 228),
		Coin = rgb(255, 200, 61), -- #FFC83D
		Bubble = rgb(255, 126, 182), -- #FF7EB6
		White = rgb(255, 255, 255),
		-- Extras (not in the DESIGN list, safe to use):
		PanelLight = rgb(30, 72, 128), -- inset cards and rows on a panel
		TextDark = rgb(11, 37, 69), -- navy text on light surfaces
		Stroke = rgb(6, 22, 46), -- text outlines
		Ink = rgb(5, 16, 36), -- the dark tone lips, outlines and shadows are mixed toward
		Disabled = rgb(128, 142, 162),
	},
	Fonts = {
		Title = Enum.Font.LuckiestGuy,
		Body = Enum.Font.SourceSansBold,
		Medium = Enum.Font.SourceSansSemibold,
	},
	Corner = 12,
	CornerLarge = 16,
	StrokeThickness = 3,
}

local Colors = UIKit.Theme.Colors
local Fonts = UIKit.Theme.Fonts
local WHITE = Color3.new(1, 1, 1)

----------------------------------------------------------------------------------------------------
-- Small builders used everywhere below
----------------------------------------------------------------------------------------------------
local function lighten(color: Color3, t: number): Color3
	return color:Lerp(WHITE, t)
end

local function darken(color: Color3, t: number): Color3
	return color:Lerp(Colors.Ink, t)
end

-- Colour helpers for other modules (e.g. a hover tint or a darker outline of a rarity colour).
UIKit.Lighten = lighten
UIKit.Darken = darken

local function tween(
	inst: Instance,
	goal: { [string]: any },
	time: number?,
	style: Enum.EasingStyle?,
	direction: Enum.EasingDirection?
): Tween
	local info = TweenInfo.new(time or 0.25, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out)
	local tw = TweenService:Create(inst, info, goal)
	tw:Play()
	return tw
end

local function addCorner(parent: Instance, radius: UDim): UICorner
	local c = Instance.new("UICorner")
	c.CornerRadius = radius
	c.Parent = parent
	return c
end

local function addStroke(
	parent: Instance,
	color: Color3,
	thickness: number,
	transparency: number?,
	mode: Enum.ApplyStrokeMode?
): UIStroke
	local s = Instance.new("UIStroke")
	s.Color = color
	s.Thickness = thickness
	s.Transparency = transparency or 0
	s.LineJoinMode = Enum.LineJoinMode.Round
	s.ApplyStrokeMode = mode or Enum.ApplyStrokeMode.Border
	s.Parent = parent
	return s
end

-- Outline for text: thicker for big headings, lighter for small print so the letters stay open.
local function addTextStroke(label: Instance, textSize: number, color: Color3?, thickness: number?, transparency: number?): UIStroke
	local auto = if textSize &gt;= 30 then 3 elseif textSize &gt;= 18 then 2 else 1.5
	local autoT = if textSize &lt; 16 then 0.3 else 0
	return addStroke(label, color or Colors.Stroke, thickness or auto, transparency or autoT, Enum.ApplyStrokeMode.Contextual)
end

local function addGradient(parent: Instance, top: Color3, bottom: Color3): UIGradient
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new(top, bottom)
	g.Rotation = 90
	g.Parent = parent
	return g
end

-- The glossy highlight across the top of every button, bar and banner (the "soap bubble" shine).
-- strength = opacity at the top edge; it fades to nothing at the bottom.
local function addShine(parent: Instance, radius: UDim, inset: number, heightScale: number, strength: number): Frame
	local shine = Instance.new("Frame")
	shine.Name = "Shine"
	shine.BackgroundColor3 = WHITE
	shine.BorderSizePixel = 0
	shine.Position = UDim2.fromOffset(inset, math.max(2, math.floor(inset * 0.6)))
	shine.Size = UDim2.new(1, -inset * 2, heightScale, 0)
	shine.ZIndex = 1
	addCorner(shine, radius)
	local fade = Instance.new("UIGradient")
	fade.Rotation = 90
	fade.Transparency = NumberSequence.new(1 - strength, 1)
	fade.Parent = shine
	shine.Parent = parent
	return shine
end

-- A faint soap bubble (ring + glint) used to decorate panels.
local function addDecorBubble(parent: Instance, position: UDim2, diameter: number, zIndex: number): Frame
	local bubble = Instance.new("Frame")
	bubble.Name = "Bubble"
	bubble.AnchorPoint = Vector2.new(0.5, 0.5)
	bubble.Position = position
	bubble.Size = UDim2.fromOffset(diameter, diameter)
	bubble.BackgroundColor3 = WHITE
	bubble.BackgroundTransparency = 0.95
	bubble.BorderSizePixel = 0
	bubble.ZIndex = zIndex
	addCorner(bubble, UDim.new(0.5, 0))
	addStroke(bubble, WHITE, 2, 0.8)
	local glint = Instance.new("Frame")
	glint.Name = "Glint"
	glint.AnchorPoint = Vector2.new(0.5, 0.5)
	glint.Position = UDim2.fromScale(0.3, 0.3)
	glint.Size = UDim2.fromScale(0.2, 0.2)
	glint.BackgroundColor3 = WHITE
	glint.BackgroundTransparency = 0.6
	glint.BorderSizePixel = 0
	glint.ZIndex = zIndex
	addCorner(glint, UDim.new(0.5, 0))
	glint.Parent = bubble
	bubble.Parent = parent
	return bubble
end

-- Copies props onto an instance, skipping the keys in `skip`. Returns the Parent (set it last).
local function assign(inst: Instance, props: { [string]: any }?, skip: { [string]: boolean }?): Instance?
	local parent = nil
	if props then
		for key, value in props do
			if key == "Parent" then
				parent = value
			elseif type(key) == "string" and not (skip and skip[key]) then
				(inst :: any)[key] = value
			end
		end
	end
	return parent
end

local function safeCall(fn: (...any) -&gt; ...any, ...: any)
	local ok, err = xpcall(fn, debug.traceback, ...)
	if not ok then
		warn("[UIKit] callback failed:\n" .. tostring(err))
	end
end

----------------------------------------------------------------------------------------------------
-- Screen scaling
----------------------------------------------------------------------------------------------------
type Screen = { Gui: ScreenGui, Root: Frame, Scale: UIScale }

local initialized = false
local scale = 1
local viewport = Vector2.new(REF_W, REF_H)
local insetPx = 0
local lastTouch = false
local lastGamepad = false
local safePx = Vector3.zero -- device safe-area insets in real pixels: (left, right, bottom)
local safeProbes: { Full: ScreenGui, Safe: ScreenGui }? = nil
local screens: { Screen } = {}
-- Internal re-layout steps (windows, toasts) that must run before LayoutChanged listeners do.
local layoutHooks: { () -&gt; () } = {}

-- Fired (no arguments) when the viewport, scale, top inset, safe insets or preferred input type
-- changes. Windows and toasts have already been re-laid out when it fires.
UIKit.LayoutChanged = Util.Signal.new()

-- Console text boost: TVs are read from the sofa, so text is 20% bigger with a gamepad (boxes keep
-- their size; scaled text still fits because it shrinks to its box). Every label made through
-- UIKit.Label / UIKit.Button registers here with its design size.
local GAMEPAD_TEXT_BOOST = 1.2
type TextEntry = { Base: number, Limit: UITextSizeConstraint?, Scale: number? }
local textEntries: { [TextLabel]: TextEntry } = setmetatable({}, { __mode = "k" }) :: any
local textBoost = 1

-- Phone text minimum: on a small touch screen the whole canvas is shrunk (scale ~0.4 to 0.55), which
-- left many labels at 6 to 8 real pixels. Any label that would land under PHONE_MIN_PX is made bigger,
-- up to PHONE_MAX_BOOST times its design size (scaled text still shrinks to its box).
local PHONE_MIN_PX = 10
local PHONE_MAX_BOOST = 1.45
local TITLE_FONT_SCALE = 0.84
local phoneScale = 0 -- the screen scale while on a phone, 0 everywhere else

local function applyTextBoost(label: TextLabel, entry: TextEntry)
	local base = entry.Base * (entry.Scale or 1)
	local factor = textBoost
	if phoneScale &gt; 0 then
		factor = math.max(factor, math.clamp(PHONE_MIN_PX / (base * phoneScale), 1, PHONE_MAX_BOOST))
	end
	local size = math.clamp(math.floor(base * factor + 0.5), 1, 100)
	label.TextSize = size
	if entry.Limit then
		entry.Limit.MaxTextSize = size
	end
end

local function registerText(label: TextLabel, base: number, limit: UITextSizeConstraint?)
	-- Luckiest Guy is wider and taller than the size number suggests: a size that fits other fonts
	-- clips or overlaps with it, so its text is drawn at TITLE_FONT_SCALE of the size asked for.
	local entry = { Base = base, Limit = limit, Scale = if label.Font == Fonts.Title then TITLE_FONT_SCALE else 1 }
	textEntries[label] = entry
	if textBoost ~= 1 or phoneScale &gt; 0 or entry.Scale ~= 1 then
		applyTextBoost(label, entry)
	end
end

local function readViewport(): Vector2
	-- The truth is the size of a full-screen ScreenGui (ScreenInsets None, IgnoreGuiInset): that is
	-- exactly the space every Root lives in. The camera's ViewportSize can disagree with it on some
	-- phones (iOS), which used to leave the canvas narrower than the screen - side buttons ended up
	-- towards the middle and windows off-centre.
	local probes = safeProbes
	if probes and probes.Full.Parent then
		local abs = probes.Full.AbsoluteSize
		if abs.X &gt;= 2 and abs.Y &gt;= 2 then
			return abs
		end
	end
	for _, s in screens do
		local abs = s.Gui.AbsoluteSize
		if abs.X &gt;= 2 and abs.Y &gt;= 2 then
			return abs
		end
	end
	local camera = workspace.CurrentCamera
	if camera then
		local size = camera.ViewportSize
		if size.X &gt;= 2 and size.Y &gt;= 2 then
			return size
		end
	end
	-- Very early the camera can report 1x1; any of our full-screen guis knows the real size.
	for _, s in screens do
		local abs = s.Gui.AbsoluteSize
		if abs.X &gt;= 2 and abs.Y &gt;= 2 then
			return abs
		end
	end
	return Vector2.new(REF_W, REF_H)
end

-- Height of the Roblox topbar in real pixels (58 on PC, taller on consoles).
local function readInsetPx(): number
	local px = 0
	local okRect, rect = pcall(function()
		return GuiService.TopbarInset
	end)
	if okRect and typeof(rect) == "Rect" then
		px = math.max(px, rect.Max.Y, rect.Height)
	end
	local okInset, topLeft = pcall(function()
		return (GuiService:GetGuiInset())
	end)
	if okInset and typeof(topLeft) == "Vector2" then
		px = math.max(px, topLeft.Y)
	end
	return px
end

local function preferredInput(): EnumItem?
	local ok, value = pcall(function()
		return (UserInputService :: any).PreferredInput
	end)
	if ok and typeof(value) == "EnumItem" then
		return value
	end
	return nil
end

function UIKit.IsTouch(): boolean
	local pref = preferredInput()
	if pref then
		return pref == (Enum :: any).PreferredInput.Touch
	end
	return UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
end

function UIKit.IsGamepad(): boolean
	local pref = preferredInput()
	if pref then
		local enum = (Enum :: any).PreferredInput
		return pref == enum.Gamepad or pref == enum.MicroGamepad
	end
	return string.sub(UserInputService:GetLastInputType().Name, 1, 7) == "Gamepad"
end

-- Notch / home-bar insets, measured by comparing two empty probe guis (full screen vs device-safe)
-- so the result doesn't depend on which coordinate space AbsolutePosition uses.
local function readSafePx(): Vector3
	local probes = safeProbes
	if not probes or not probes.Full.Parent or not probes.Safe.Parent then
		return Vector3.zero
	end
	local fp, fs = probes.Full.AbsolutePosition, probes.Full.AbsoluteSize
	local sp, ss = probes.Safe.AbsolutePosition, probes.Safe.AbsoluteSize
	if fs.X &lt; 2 or fs.Y &lt; 2 or ss.X &lt; 2 or ss.Y &lt; 2 then
		return Vector3.zero
	end
	local maxSide = fs.X * 0.25
	local left = math.clamp(sp.X - fp.X, 0, maxSide)
	local right = math.clamp((fp.X + fs.X) - (sp.X + ss.X), 0, maxSide)
	local bottom = math.clamp((fp.Y + fs.Y) - (sp.Y + ss.Y), 0, fs.Y * 0.25)
	return Vector3.new(math.floor(left), math.floor(right), math.floor(bottom))
end

local function canvasSize(): Vector2
	-- ceil so the scaled canvas always covers the last pixel column/row
	return Vector2.new(math.ceil(viewport.X / scale), math.ceil(viewport.Y / scale))
end

local function applyLayout(force: boolean)
	local vp = readViewport()
	local newScale = math.clamp(math.min(vp.X / REF_W, vp.Y / REF_H), MIN_SCALE, MAX_SCALE)
	local newInset = readInsetPx()
	local touch = UIKit.IsTouch()
	local pad = UIKit.IsGamepad()
	local newSafe = readSafePx()
	if
		not force
		and vp == viewport
		and newScale == scale
		and newInset == insetPx
		and touch == lastTouch
		and pad == lastGamepad
		and newSafe == safePx
	then
		return
	end
	viewport, scale, insetPx, lastTouch, lastGamepad, safePx = vp, newScale, newInset, touch, pad, newSafe
	local boost = if pad then GAMEPAD_TEXT_BOOST else 1
	local newPhoneScale = if touch and newScale &lt; 0.8 then newScale else 0
	if boost ~= textBoost or newPhoneScale ~= phoneScale then
		textBoost = boost
		phoneScale = newPhoneScale
		for label, entry in textEntries do
			if label.Parent then
				applyTextBoost(label, entry)
			end
		end
	end

	for _, s in screens do
		s.Root.Size = UDim2.fromScale(1 / scale, 1 / scale)
		s.Scale.Scale = scale
	end
	for _, hook in layoutHooks do
		safeCall(hook)
	end
	UIKit.LayoutChanged:Fire()
end

-- Viewport drags fire ViewportSize many times per frame; coalesce into one layout pass.
local refreshQueued = false
local function queueRefresh()
	if refreshQueued then
		return
	end
	refreshQueued = true
	task.defer(function()
		refreshQueued = false
		applyLayout(false)
	end)
end

-- Two empty ScreenGuis whose AbsolutePosition/AbsoluteSize reveal the device safe area. They also
-- tell us when it moves (a phone flipped 180 degrees swaps the notch side without a size change).
local function ensureSafeProbes(playerGui: Instance?)
	if safeProbes and safeProbes.Full.Parent and safeProbes.Safe.Parent then
		return
	end
	if not playerGui then
		return
	end
	if safeProbes then
		safeProbes.Full:Destroy()
		safeProbes.Safe:Destroy()
	end
	local function probe(name: string, insets: Enum.ScreenInsets): ScreenGui
		local g = Instance.new("ScreenGui")
		g.Name = name
		g.IgnoreGuiInset = true
		g.ResetOnSpawn = false
		g.ScreenInsets = insets
		g:GetPropertyChangedSignal("AbsoluteSize"):Connect(queueRefresh)
		g:GetPropertyChangedSignal("AbsolutePosition"):Connect(queueRefresh)
		g.Parent = playerGui
		return g
	end
	safeProbes = {
		Full = probe("UIKitProbeFull", Enum.ScreenInsets.None),
		Safe = probe("UIKitProbeSafe", Enum.ScreenInsets.DeviceSafeInsets),
	}
	queueRefresh()
end

local function ensureInit()
	if not initialized then
		UIKit.Init()
	end
end

function UIKit.GetScale(): number
	ensureInit()
	return scale
end

-- Roblox topbar height in canvas units. Keep anything near the top of the screen below this.
function UIKit.TopInset(): number
	ensureInit()
	return insetPx / scale
end

-- Size of the virtual canvas (= every Root's size) in reference pixels. One side is ~1280 or ~720.
function UIKit.CanvasSize(): Vector2
	ensureInit()
	return canvasSize()
end

-- Extra (not in DESIGN): notch / home-indicator insets in canvas units. Every Root spans the whole
-- screen (ScreenInsets None), so add Left/Right to margins of anything hugging a side edge on phones.
-- All zeros on devices without cutouts. LayoutChanged fires when they change.
function UIKit.SafeInsets(): { Left: number, Right: number, Bottom: number }
	ensureInit()
	return { Left = safePx.X / scale, Right = safePx.Y / scale, Bottom = safePx.Z / scale }
end

function UIKit.CreateScreen(name: string, displayOrder: number?): (ScreenGui, Frame)
	ensureInit()
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	ensureSafeProbes(playerGui)

	local gui = Instance.new("ScreenGui")
	gui.Name = tostring(name)
	gui.DisplayOrder = displayOrder or 0
	gui.IgnoreGuiInset = true
	gui.ScreenInsets = Enum.ScreenInsets.None
	gui.ClipToDeviceSafeArea = false -- the canvas covers the whole screen, so don't clip it either
	gui.ResetOnSpawn = false
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

	-- Root is the virtual canvas: viewport / scale in size, scaled back up by its UIScale.
	local root = Instance.new("Frame")
	root.Name = "Root"
	root.BackgroundTransparency = 1
	root.BorderSizePixel = 0
	root.Position = UDim2.fromOffset(0, 0)
	-- Scale-based so the (UIScale'd) root always covers its ScreenGui exactly, whatever the
	-- device reports elsewhere; canvasSize() is only used for layout maths.
	root.Size = UDim2.fromScale(1 / scale, 1 / scale)
	local uiScale = Instance.new("UIScale")
	uiScale.Scale = scale
	uiScale.Parent = root
	root.Parent = gui

	local entry: Screen = { Gui = gui, Root = root, Scale = uiScale }
	table.insert(screens, entry)
	gui.Destroying:Connect(function()
		local i = table.find(screens, entry)
		if i then
			table.remove(screens, i)
		end
	end)

	gui.Parent = playerGui
	return gui, root
end

----------------------------------------------------------------------------------------------------
-- Primitives
----------------------------------------------------------------------------------------------------

-- Instance.new + props + children, Parent set last. GuiObjects default to BorderSizePixel = 0.
function UIKit.New(className: string, props: { [string]: any }?, children: { Instance }?): Instance
	local inst = Instance.new(className :: any)
	if inst:IsA("GuiObject") then
		inst.BorderSizePixel = 0
	end
	local parent = assign(inst, props)
	if children then
		for _, child in children do
			child.Parent = inst
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

-- radius in canvas px (default 12). Pass something huge (999) for a pill / circle.
function UIKit.Corner(parent: Instance, radius: number?): UICorner
	return addCorner(parent, UDim.new(0, radius or UIKit.Theme.Corner))
end

-- On a TextLabel the stroke outlines the text; on anything else (frames, buttons, text boxes) it
-- outlines the border. Set .ApplyStrokeMode on the result to override.
function UIKit.Stroke(parent: Instance, color: Color3?, thickness: number?, transparency: number?): UIStroke
	local mode = if parent:IsA("TextLabel") then Enum.ApplyStrokeMode.Contextual else Enum.ApplyStrokeMode.Border
	return addStroke(parent, color or Colors.Stroke, thickness or UIKit.Theme.StrokeThickness, transparency, mode)
end

function UIKit.Padding(parent: Instance, px: number): UIPadding
	local p = Instance.new("UIPadding")
	local u = UDim.new(0, px or 8)
	p.PaddingTop = u
	p.PaddingBottom = u
	p.PaddingLeft = u
	p.PaddingRight = u
	p.Parent = parent
	return p
end

-- Top-to-bottom gradient. Sets the parent's BackgroundColor3 to white so the colours come out exactly.
function UIKit.Gradient(parent: Instance, top: Color3, bottom: Color3): UIGradient
	if parent:IsA("GuiObject") then
		parent.BackgroundColor3 = WHITE
	end
	return addGradient(parent, top, bottom)
end

local LABEL_SKIP = { Text = true, Stroke = true, StrokeColor = true, StrokeThickness = true, StrokeTransparency = true }

--[[
	Text label with the house style: transparent background, white text, dark outline.
	props: any TextLabel property (Text, Size, Position, AnchorPoint, TextSize, Font, TextColor3,
	TextXAlignment, TextWrapped, ZIndex, LayoutOrder, Parent...) plus:
	  Stroke = false            no outline
	  StrokeColor / StrokeThickness / StrokeTransparency
	Font defaults to FredokaOne for TextSize &gt;= 18 and GothamBold for smaller print.
	With TextScaled = true, TextSize becomes the maximum size.
]]
function UIKit.Label(props: { [string]: any }?): TextLabel
	local p: { [string]: any } = props or {}
	local textSize = tonumber(p.TextSize) or 22
	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.BackgroundTransparency = 1
	label.BorderSizePixel = 0
	label.Size = UDim2.fromOffset(200, textSize + 10)
	label.Font = if textSize &gt;= 18 then Fonts.Title else Fonts.Body
	label.TextSize = textSize
	label.TextColor3 = Colors.Text
	label.Text = if p.Text ~= nil then tostring(p.Text) else ""
	local parent = assign(label, p, LABEL_SKIP)
	local labelLimit: UITextSizeConstraint? = nil
	if label.TextScaled then
		local limit = Instance.new("UITextSizeConstraint")
		limit.MaxTextSize = math.clamp(math.floor(textSize), 1, 100)
		limit.MinTextSize = math.clamp(math.min(12, math.floor(textSize)), 1, 100)
		limit.Parent = label
		labelLimit = limit
	end
	registerText(label, textSize, labelLimit)
	if p.Stroke ~= false then
		addTextStroke(label, textSize, p.StrokeColor, p.StrokeThickness, p.StrokeTransparency)
	end
	if parent then
		label.Parent = parent
	end
	return label
end

-- A rounded inset card for rows and tiles inside a window (lighter navy with a soft rim).
-- props: any Frame property plus Color, CornerRadius, StrokeColor.
-- One of the game's drawn icons (see IconArt): Coin, Bubble, Gem, Drop, Gift, Ticket, Heart, Star, Medal,
-- Shield, Lock, and the level emblems Pasta, Pizza, Crown.
function UIKit.Icon(kind: string, size: number?, props: { [string]: any }?): Frame
	local root = IconArt.Draw(kind, size or 32)
	if props then
		for k, v in props do
			if k == "ZIndex" then
				IconArt.SetZIndex(root, v)
			else
				(root :: any)[k] = v
			end
		end
	end
	return root
end

local CARD_SKIP = { Color = true, CornerRadius = true, StrokeColor = true }
function UIKit.Card(props: { [string]: any }?): Frame
	local p: { [string]: any } = props or {}
	local card = Instance.new("Frame")
	card.Name = "Card"
	card.Size = UDim2.fromOffset(200, 100)
	card.BackgroundColor3 = p.Color or Colors.PanelLight
	card.BorderSizePixel = 0
	addCorner(card, UDim.new(0, p.CornerRadius or UIKit.Theme.Corner))
	addStroke(card, p.StrokeColor or lighten(Colors.PanelLight, 0.2), 2, 0.25)
	local parent = assign(card, p, CARD_SKIP)
	if parent then
		card.Parent = parent
	end
	return card
end

----------------------------------------------------------------------------------------------------
-- Sounds
----------------------------------------------------------------------------------------------------
local soundFolder: Folder? = nil
local templates: { [string]: Sound } = {}
local failedKeys: { [string]: boolean } = {}
local voices: { [string]: number } = {}
local lastPlayedAt: { [string]: number } = {}

local function getSoundFolder(): Folder
	if soundFolder and soundFolder.Parent then
		return soundFolder
	end
	local folder = Instance.new("Folder")
	folder.Name = "UIKitSounds"
	folder.Parent = SoundService
	soundFolder = folder
	return folder
end

-- One cached template Sound per Config.Sounds key. Plays use short-lived clones so the same sound
-- can overlap itself (pop combos, rapid clicks).
local function getTemplate(key: string): Sound?
	local existing = templates[key]
	if existing and existing.Parent then
		return existing
	end
	local def = (Config.Sounds :: any)[key]
	if type(def) ~= "table" or type(def.Id) ~= "string" then
		return nil
	end
	local sound = Instance.new("Sound")
	sound.Name = key
	sound.SoundId = def.Id
	sound.Volume = tonumber(def.Volume) or 0.5
	sound.Parent = getSoundFolder()
	templates[key] = sound

	if key ~= "Fallback" and not sound.IsLoaded then
		-- If it hasn't loaded after a few seconds (deleted / private asset), play Fallback instead.
		-- A late load clears the flag again.
		sound.Loaded:Once(function()
			failedKeys[key] = nil
		end)
		task.delay(SOUND_LOAD_TIMEOUT, function()
			if templates[key] == sound and not sound.IsLoaded then
				failedKeys[key] = true
			end
		end)
	end
	return sound
end

local function preloadSounds()
	local list = {}
	for key in Config.Sounds do
		local sound = getTemplate(tostring(key))
		if sound then
			table.insert(list, sound)
		end
	end
	pcall(function()
		ContentProvider:PreloadAsync(list, function(contentId: string, status: Enum.AssetFetchStatus)
			if status ~= Enum.AssetFetchStatus.Failure then
				return
			end
			for key, sound in templates do
				if key ~= "Fallback" and sound.SoundId == contentId then
					failedKeys[key] = true
				end
			end
		end)
	end)
end

-- Plays Config.Sounds[key] (no-op for unknown keys). pitch = PlaybackSpeed, default 1.
function UIKit.PlaySound(key: string, pitch: number?)
	if type(key) ~= "string" then
		return
	end
	local template = getTemplate(key)
	if not template then
		return
	end
	local now = os.clock()
	if now - (lastPlayedAt[key] or 0) &lt; SOUND_MIN_GAP or (voices[key] or 0) &gt;= SOUND_MAX_VOICES then
		return
	end
	lastPlayedAt[key] = now

	local source = template
	if failedKeys[key] then
		source = getTemplate("Fallback") or template
	end
	local speed = tonumber(pitch) or 1
	if speed ~= speed then
		speed = 1
	end

	local voice = source:Clone()
	voice.PlaybackSpeed = math.clamp(speed, 0.2, 4)
	voice.Parent = getSoundFolder()
	voices[key] = (voices[key] or 0) + 1

	local done = false
	local function finish()
		if done then
			return
		end
		done = true
		voices[key] = math.max(0, (voices[key] or 1) - 1)
		voice:Destroy()
	end
	voice.Ended:Once(finish)
	task.delay(10, finish) -- safety net: a clone that never loads never fires Ended
	voice:Play()
end

----------------------------------------------------------------------------------------------------
-- Buttons
----------------------------------------------------------------------------------------------------
type Chunky = {
	Visual: Frame,
	Press: UIScale,
	Lip: Frame,
	LipStroke: UIStroke,
	Face: Frame,
	FaceGradient: UIGradient,
	Shine: Frame,
}

-- One shared rounded highlight for gamepad selection instead of Roblox's square default.
local selectionImage: Frame? = nil
local function getSelectionImage(): Frame
	if selectionImage then
		return selectionImage
	end
	local frame = Instance.new("Frame")
	frame.Name = "UIKitSelection"
	frame.BackgroundTransparency = 1
	frame.Position = UDim2.fromOffset(-4, -4)
	frame.Size = UDim2.new(1, 8, 1, 8)
	addCorner(frame, UDim.new(0, 16))
	addStroke(frame, WHITE, 4)
	selectionImage = frame
	return frame
end

--[[
	The chunky look. The TextButton itself is an invisible hitbox; inside it:
	  Visual (centred, carries the hover/press UIScale so it grows from the middle)
	    Lip   the full silhouette in a darker tone, with the outline
	    Face  `lip` px shorter, gradient + shine, so a darker band shows along the bottom
]]
local function buildChunky(button: GuiButton, radius: UDim, lip: number): Chunky
	local visual = Instance.new("Frame")
	visual.Name = "Visual"
	visual.AnchorPoint = Vector2.new(0.5, 0.5)
	visual.Position = UDim2.fromScale(0.5, 0.5)
	visual.Size = UDim2.fromScale(1, 1)
	visual.BackgroundTransparency = 1
	visual.BorderSizePixel = 0

	local press = Instance.new("UIScale")
	press.Name = "PressScale"
	press.Parent = visual

	local lipFrame = Instance.new("Frame")
	lipFrame.Name = "Lip"
	lipFrame.Size = UDim2.fromScale(1, 1)
	lipFrame.BorderSizePixel = 0
	lipFrame.ZIndex = 1
	addCorner(lipFrame, radius)
	local lipStroke = addStroke(lipFrame, Colors.Ink, UIKit.Theme.StrokeThickness)
	lipFrame.Parent = visual

	local face = Instance.new("Frame")
	face.Name = "Face"
	face.Size = UDim2.new(1, 0, 1, -lip)
	face.BackgroundColor3 = WHITE
	face.BorderSizePixel = 0
	face.ZIndex = 2
	addCorner(face, radius)
	local gradient = addGradient(face, WHITE, WHITE)
	local shineRadius = if radius.Scale &gt; 0 then radius else UDim.new(0, math.max(4, radius.Offset - 4))
	local shine = addShine(face, shineRadius, 5, 0.42, 0.5)
	face.Parent = visual

	visual.Parent = button
	return {
		Visual = visual,
		Press = press,
		Lip = lipFrame,
		LipStroke = lipStroke,
		Face = face,
		FaceGradient = gradient,
		Shine = shine,
	}
end

local function paintChunky(parts: Chunky, color: Color3, disabled: boolean)
	local base = if disabled then Colors.Disabled else color
	parts.FaceGradient.Color = ColorSequence.new(lighten(base, 0.32), base)
	parts.Lip.BackgroundColor3 = darken(base, 0.4)
	parts.LipStroke.Color = darken(base, 0.7)
	parts.Shine.Visible = not disabled
end

local function isPressInput(input: InputObject): boolean
	local t = input.UserInputType
	return t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch or input.KeyCode == Enum.KeyCode.ButtonA
end

-- Hover / press / click behaviour shared by Button and IconButton. Every connection here is on the
-- button's own signals, so it all goes away when the button is destroyed.
local function wireButton(
	button: TextButton,
	parts: Chunky,
	restyle: () -&gt; (),
	onClick: any,
	soundKey: string?
)
	local hovered = false
	local pressed = false
	local busySince: number? = nil

	local function isDisabled(): boolean
		return button:GetAttribute("Disabled") == true
	end

	local function settle()
		local disabled = isDisabled()
		local target = 1
		if not disabled and pressed then
			target = 0.95
		elseif not disabled and hovered then
			target = 1.05
		end
		tween(parts.Press, { Scale = target }, if pressed then 0.06 else 0.14)
		-- The pressed face also loses a little of its shine, like the light shifting on a real key.
		parts.Shine.BackgroundTransparency = if pressed and not disabled then 0.35 else 0
	end

	button.MouseEnter:Connect(function()
		hovered = true
		settle()
	end)
	button.MouseLeave:Connect(function()
		hovered = false
		pressed = false
		settle()
	end)
	button.SelectionGained:Connect(function()
		hovered = true
		settle()
	end)
	button.SelectionLost:Connect(function()
		hovered = false
		pressed = false
		settle()
	end)
	button.InputBegan:Connect(function(input)
		if isPressInput(input) then
			pressed = true
			settle()
		end
	end)
	button.InputEnded:Connect(function(input)
		if isPressInput(input) then
			pressed = false
			-- Touch has no MouseLeave after a tap; don't leave the button stuck at hover size.
			if input.UserInputType == Enum.UserInputType.Touch then
				hovered = false
			end
			settle()
		end
	end)

	button.Activated:Connect(function()
		if isDisabled() then
			-- A little "nope" wobble instead of silently doing nothing.
			parts.Visual.Rotation = 5
			tween(parts.Visual, { Rotation = 0 }, 0.45, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out)
			return
		end
		-- Ignore clicks while the previous OnClick is still yielding (e.g. waiting on the server),
		-- with a safety timeout so a lost request can't lock the button forever.
		if busySince and os.clock() - busySince &lt; 8 then
			return
		end
		if soundKey then
			UIKit.PlaySound(soundKey)
		end
		if type(onClick) == "function" then
			busySince = os.clock()
			safeCall(onClick)
			busySince = nil
		end
	end)

	button:GetAttributeChangedSignal("Disabled"):Connect(function()
		restyle()
		settle()
	end)
	button:GetPropertyChangedSignal("BackgroundColor3"):Connect(restyle)
	button:GetPropertyChangedSignal("TextColor3"):Connect(restyle)
end

local BUTTON_SKIP = {
	Text = true,
	Icon = true,
	Color = true,
	TextColor3 = true,
	TextSize = true,
	Font = true,
	Size = true,
	OnClick = true,
	Sound = true,
	Disabled = true,
	CornerRadius = true,
}

--[[
	Chunky rounded button: gradient face, darker lip, outline, shine. Hover grows 1.05, press 0.95.
	props: Text, Size, Position, AnchorPoint, Color, TextColor3, TextSize, Parent, OnClick, plus
	  Icon (emoji put before Text), Font, Name, LayoutOrder, ZIndex, Visible (any TextButton property),
	  Disabled (initial), Sound (Config.Sounds key, default "Click"; false = silent),
	  CornerRadius (px, default 12; 999 = pill/circle).
	Disabled state: button:SetAttribute("Disabled", true) greys it out and ignores clicks.
	Live restyle: setting button.Text / TextColor3 / TextSize / BackgroundColor3 updates the visuals
	(the TextButton's own text and background are kept invisible).
]]
function UIKit.Button(props: { [string]: any }?): TextButton
	local p: { [string]: any } = props or {}
	local size: UDim2 = p.Size or UDim2.fromOffset(180, 56)
	local height = if size.Y.Scale == 0 and size.Y.Offset &gt; 0 then size.Y.Offset else 56
	local lip = if height &gt;= 40 then 4 else 3
	local textSize = tonumber(p.TextSize) or math.clamp(math.floor(height * 0.44), 16, 34)
	local radiusPx = tonumber(p.CornerRadius) or math.min(UIKit.Theme.Corner, math.floor(height / 2))
	local text = tostring(p.Text or "")
	if p.Icon then
		text = tostring(p.Icon) .. (if text ~= "" then " " .. text else "")
	end

	local button = Instance.new("TextButton")
	button.Name = "Button"
	button.Size = size
	button.AutoButtonColor = false
	button.BackgroundTransparency = 1
	button.BackgroundColor3 = p.Color or Colors.Primary
	button.BorderSizePixel = 0
	button.Text = text
	button.TextTransparency = 1
	button.TextSize = textSize
	button.TextColor3 = p.TextColor3 or Colors.Text
	button.Font = p.Font or Fonts.Title
	button.SelectionImageObject = getSelectionImage()
	local parent = assign(button, p, BUTTON_SKIP)
	if p.Disabled then
		button:SetAttribute("Disabled", true)
	end

	local parts = buildChunky(button, UDim.new(0, radiusPx), lip)

	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.AnchorPoint = Vector2.new(0.5, 0.5)
	label.Position = UDim2.fromScale(0.5, 0.5)
	label.Size = UDim2.new(1, -14, 1, -6)
	label.BackgroundTransparency = 1
	label.FontFace = button.FontFace
	label.RichText = button.RichText
	label.Text = button.Text
	label.TextSize = textSize
	label.TextScaled = true -- shrinks long text to fit; TextSize is the cap
	label.TextWrapped = true
	label.ZIndex = 2
	local limit = Instance.new("UITextSizeConstraint")
	limit.MaxTextSize = math.clamp(math.floor(textSize), 1, 100)
	limit.MinTextSize = 10
	registerText(label, textSize, limit)
	limit.Parent = label
	addTextStroke(label, textSize)
	label.Parent = parts.Face

	local function restyle()
		local disabled = button:GetAttribute("Disabled") == true
		paintChunky(parts, button.BackgroundColor3, disabled)
		label.TextColor3 = if disabled then Color3.fromRGB(228, 234, 242) else button.TextColor3
	end
	restyle()

	button:GetPropertyChangedSignal("Text"):Connect(function()
		label.Text = button.Text
	end)
	button:GetPropertyChangedSignal("RichText"):Connect(function()
		label.RichText = button.RichText
	end)
	button:GetPropertyChangedSignal("FontFace"):Connect(function()
		label.FontFace = button.FontFace
	end)
	button:GetPropertyChangedSignal("TextSize"):Connect(function()
		limit.MaxTextSize = math.clamp(math.floor(button.TextSize), 1, 100)
	end)
	button:GetPropertyChangedSignal("TextTransparency"):Connect(function()
		if button.TextTransparency ~= 1 then
			button.TextTransparency = 1 -- the visible text is the inner label
		end
	end)

	local soundKey = if p.Sound == false then nil elseif type(p.Sound) == "string" then p.Sound else "Click"
	wireButton(button, parts, restyle, p.OnClick, soundKey)

	if parent then
		button.Parent = parent
	end
	return button
end

local ICON_SKIP = {
	Icon = true,
	Label = true,
	Color = true,
	Size = true,
	OnClick = true,
	Sound = true,
	Disabled = true,
	TextSize = true,
}

--[[
	Square HUD button: a big emoji with a small caption along the bottom.
	props: Icon (emoji), Label (caption, optional), Color, Size (default 84x84), OnClick, plus
	  Position, AnchorPoint, Name, LayoutOrder, ZIndex..., Disabled, Sound (as Button).
	Live changes: button.Text sets the caption, button:SetAttribute("Icon", "🛒") the emoji,
	BackgroundColor3 the colour, SetAttribute("Disabled", true) disables it.
]]
function UIKit.IconButton(props: { [string]: any }?): TextButton
	local p: { [string]: any } = props or {}
	local size: UDim2 = p.Size or UDim2.fromOffset(84, 84)
	local height = if size.Y.Scale == 0 and size.Y.Offset &gt; 0 then size.Y.Offset else 84
	local lip = if height &gt;= 70 then 5 else 4
	local radius = UDim.new(0, math.min(UIKit.Theme.CornerLarge, math.floor(height / 2)))
	local captionSize = math.max(14, math.floor(height * 0.2))

	local button = Instance.new("TextButton")
	button.Name = "IconButton"
	button.Size = size
	button.AutoButtonColor = false
	button.BackgroundTransparency = 1
	button.BackgroundColor3 = p.Color or Colors.Primary
	button.BorderSizePixel = 0
	button.Text = tostring(p.Label or "")
	button.TextTransparency = 1
	button.TextColor3 = Colors.Text
	button.SelectionImageObject = getSelectionImage()
	button:SetAttribute("Icon", tostring(p.Icon or ""))
	local parent = assign(button, p, ICON_SKIP)
	if p.Disabled then
		button:SetAttribute("Disabled", true)
	end

	local parts = buildChunky(button, radius, lip)

	local icon = Instance.new("TextLabel")
	icon.Name = "Icon"
	icon.AnchorPoint = Vector2.new(0.5, 0.5)
	icon.BackgroundTransparency = 1
	icon.Font = Fonts.Title
	icon.TextColor3 = WHITE
	icon.ZIndex = 2
	icon.Parent = parts.Face

	local caption = Instance.new("TextLabel")
	caption.Name = "Label"
	caption.AnchorPoint = Vector2.new(0.5, 1)
	caption.Position = UDim2.new(0.5, 0, 1, -3)
	caption.Size = UDim2.new(1, -8, 0, captionSize + 4)
	caption.BackgroundTransparency = 1
	caption.Font = Fonts.Title
	caption.TextSize = captionSize
	caption.TextScaled = true
	caption.ZIndex = 3
	local limit = Instance.new("UITextSizeConstraint")
	limit.MaxTextSize = captionSize
	limit.MinTextSize = 10
	limit.Parent = caption
	addTextStroke(caption, captionSize)
	caption.Parent = parts.Face

	-- The icon sits higher when there is a caption under it. "@Kind" draws one of the IconArt
	-- icons instead of an emoji.
	local art: Frame? = nil
	local artKey = ""
	local function layoutContent()
		local text = button.Text
		local hasCaption = text ~= ""
		caption.Text = text
		caption.Visible = hasCaption
		local value = tostring(button:GetAttribute("Icon") or "")
		local kind = string.match(value, "^@(%a+)$")
		local artSize = 2 * math.floor(height * (if hasCaption then 0.3 else 0.36)) -- even: stays centred
		local key = if kind then kind .. artSize .. tostring(hasCaption) else ""
		if key ~= artKey then
			artKey = key
			if art then
				art:Destroy()
				art = nil
			end
			if kind then
				local drawn = IconArt.Draw(kind, artSize)
				drawn.Name = "Art"
				drawn.AnchorPoint = Vector2.new(0.5, 0.5)
				drawn.Position = UDim2.fromScale(0.5, if hasCaption then 0.36 else 0.5)
				IconArt.SetZIndex(drawn, 2)
				drawn.Parent = parts.Face
				art = drawn
			end
		end
		icon.Text = if kind then "" else value
		icon.Position = UDim2.fromScale(0.5, if hasCaption then 0.36 else 0.5)
		icon.Size = UDim2.fromScale(1, if hasCaption then 0.62 else 0.9)
		icon.TextSize = math.floor(height * (if hasCaption then 0.42 else 0.52))
	end
	layoutContent()
	button:GetPropertyChangedSignal("Text"):Connect(layoutContent)
	button:GetAttributeChangedSignal("Icon"):Connect(layoutContent)

	local function restyle()
		local disabled = button:GetAttribute("Disabled") == true
		paintChunky(parts, button.BackgroundColor3, disabled)
		caption.TextColor3 = if disabled then Color3.fromRGB(228, 234, 242) else button.TextColor3
		icon.TextTransparency = if disabled then 0.35 else 0
	end
	restyle()

	local soundKey = if p.Sound == false then nil elseif type(p.Sound) == "string" then p.Sound else "Click"
	wireButton(button, parts, restyle, p.OnClick, soundKey)

	if parent then
		button.Parent = parent
	end
	return button
end

-- Convenience wrappers for the attribute/property conventions above.
function UIKit.SetDisabled(button: Instance, disabled: boolean)
	button:SetAttribute("Disabled", disabled == true)
end

function UIKit.SetButtonColor(button: GuiObject, color: Color3)
	button.BackgroundColor3 = color
end

----------------------------------------------------------------------------------------------------
-- Windows
----------------------------------------------------------------------------------------------------
type WindowRecord = {
	Name: string,
	Frame: Frame,
	Content: Frame,
	Scale: UIScale,
	Veil: Frame,
	Shadow: Frame,
	CloseButton: TextButton,
	BaseSize: Vector2,
	Fit: number,
	Token: number,
	Animating: boolean,
	Closing: boolean,
	AutoPlace: boolean,
	PlacedAt: UDim2?,
	LinkedName: string?,
	OnClose: any,
}

type WindowHandlers = {
	Open: ((arg: any?) -&gt; ())?,
	Close: (() -&gt; ())?,
	Frame: GuiObject?, -- optional: the frame to show/hide if it isn't a UIKit.Window of the same name
}

local windowRecords: { [string]: WindowRecord } = {} -- by UIKit.Window Name
local linkedRecords: { [string]: WindowRecord } = {} -- registered name -&gt; window it turned out to show
local registry: { [string]: WindowHandlers } = {}
local openName: string? = nil

-- Fired with the open window's name, or nil when every window is closed.
UIKit.WindowChanged = Util.Signal.new()

local function toVector2(value: any, fallback: Vector2): Vector2
	if typeof(value) == "Vector2" then
		return value
	end
	if typeof(value) == "UDim2" then
		-- Scale parts are resolved against the reference canvas.
		return Vector2.new(value.X.Offset + value.X.Scale * REF_W, value.Y.Offset + value.Y.Scale * REF_H)
	end
	return fallback
end

-- Centre the window in the area below the topbar and shrink it (never grow) until it fits.
local function layoutWindow(rec: WindowRecord)
	local canvas = canvasSize()
	local inset = insetPx / scale
	local availW = canvas.X - WINDOW_MARGIN * 2
	local availH = canvas.Y - inset - WINDOW_MARGIN * 2
	rec.Fit = math.clamp(math.min(availW / rec.BaseSize.X, availH / rec.BaseSize.Y), 0.35, 1)
	if rec.AutoPlace then
		if rec.PlacedAt and rec.Frame.Position ~= rec.PlacedAt then
			-- The owner moved it themselves: stop managing its position.
			rec.AutoPlace = false
		else
			local pos = UDim2.new(0.5, 0, 0.5, math.floor(inset / 2 + 0.5))
			rec.Frame.Position = pos
			rec.PlacedAt = pos
		end
	end
	if not rec.Animating then
		rec.Scale.Scale = rec.Fit
	end
end

table.insert(layoutHooks, function()
	for _, rec in windowRecords do
		layoutWindow(rec)
	end
end)

-- Open: pop from 0.9 to full size (Back ease) while a panel-coloured veil over the contents fades
-- away, so the window "materialises" instead of blinking in.
local function showRecord(rec: WindowRecord)
	rec.Token += 1
	local token = rec.Token
	layoutWindow(rec)
	rec.Closing = false
	rec.Animating = true
	rec.Frame.Visible = true
	rec.Scale.Scale = rec.Fit * 0.9
	rec.Veil.Visible = true
	rec.Veil.BackgroundTransparency = 0
	rec.Shadow.BackgroundTransparency = 1
	local pop = tween(rec.Scale, { Scale = rec.Fit }, 0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	tween(rec.Veil, { BackgroundTransparency = 1 }, 0.22)
	tween(rec.Shadow, { BackgroundTransparency = WINDOW_SHADOW_T }, 0.25)
	pop.Completed:Once(function()
		if rec.Token ~= token then
			return
		end
		rec.Animating = false
		rec.Veil.Visible = false
		rec.Scale.Scale = rec.Fit -- the layout may have changed mid-animation
	end)
end

-- Close: a quick shrink, then hide. Re-opening mid-animation cancels the hide (token check).
local function hideRecord(rec: WindowRecord)
	rec.Token += 1
	local token = rec.Token
	if not rec.Frame.Visible then
		rec.Animating = false
		rec.Closing = false
		rec.Veil.Visible = false
		rec.Scale.Scale = rec.Fit
		return
	end
	rec.Closing = true
	rec.Animating = true
	rec.Veil.Visible = true
	local shrink = tween(rec.Scale, { Scale = rec.Fit * 0.9 }, 0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	tween(rec.Veil, { BackgroundTransparency = 0.2 }, 0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	tween(rec.Shadow, { BackgroundTransparency = 1 }, 0.12)
	shrink.Completed:Once(function()
		if rec.Token ~= token then
			return
		end
		rec.Frame.Visible = false
		rec.Closing = false
		rec.Animating = false
		rec.Veil.Visible = false
		rec.Scale.Scale = rec.Fit
	end)
end

local function callHandler(name: string, key: string, arg: any?)
	local handlers = registry[name]
	local fn = handlers and (handlers :: any)[key]
	if type(fn) ~= "function" then
		return
	end
	local ok, err = xpcall(fn, debug.traceback, arg)
	if not ok then
		warn(string.format("[UIKit] window %s %s() failed:\n%s", name, key, tostring(err)))
	end
end

local function explicitFrame(name: string): GuiObject?
	local handlers = registry[name]
	local frame = handlers and handlers.Frame
	if typeof(frame) == "Instance" and frame:IsA("GuiObject") then
		return frame
	end
	return nil
end

local function recordFor(name: string): WindowRecord?
	local frame = explicitFrame(name)
	if frame then
		for _, rec in windowRecords do
			if rec.Frame == frame then
				return rec
			end
		end
	end
	return windowRecords[name] or linkedRecords[name]
end

local function selectFirstButton(rec: WindowRecord)
	if not UIKit.IsGamepad() then
		return
	end
	local target: GuiObject = rec.CloseButton
	for _, d in rec.Content:GetDescendants() do
		if d:IsA("GuiButton") and d.Visible and d.Selectable then
			target = d
			break
		end
	end
	pcall(function()
		GuiService.SelectedObject = target
	end)
end

local function clearSelectionInside(frame: GuiObject)
	pcall(function()
		local selected = GuiService.SelectedObject
		if selected and selected:IsDescendantOf(frame) then
			GuiService.SelectedObject = nil
		end
	end)
end

local function closeOpenWindow(fireSignal: boolean)
	local name = openName
	if not name then
		return
	end
	openName = nil
	callHandler(name, "Close")
	local rec = recordFor(name)
	if rec then
		clearSelectionInside(rec.Frame)
		hideRecord(rec)
		if type(rec.OnClose) == "function" then
			task.spawn(safeCall, rec.OnClose)
		end
	else
		local frame = explicitFrame(name)
		if frame then
			frame.Visible = false
		end
	end
	if fireSignal then
		UIKit.WindowChanged:Fire(nil)
	end
end

--[[
	handlers = { Open = function(arg) end, Close = function() end, Frame = optionalGuiObject }
	If a UIKit.Window has the same Name (or is handlers.Frame), UIKit shows/animates/hides it for you.
	Keep Open quick: it runs before the open animation starts. task.spawn anything slow.
]]
function UIKit.RegisterWindow(name: string, handlers: WindowHandlers)
	if type(name) ~= "string" or type(handlers) ~= "table" then
		warn("[UIKit] RegisterWindow needs (name: string, handlers: table)")
		return
	end
	registry[name] = handlers
end

-- Closes any other open window first, then runs Open(arg) and plays the open animation.
-- Opening the window that is already open just calls Open(arg) again (e.g. switching eggs).
-- Sub-menus: a window opened with UIKit.OpenSubWindow remembers where it came from. Its X turns
-- into a "&lt;" Back button, and Back / Escape / B take you there instead of closing everything.
local backOf: { [string]: { Name: string, Arg: any } } = {}

local function setBackLook(name: string, isBack: boolean)
	local rec = windowRecords[name]
	local button = rec and rec.CloseButton
	if button then
		button.Text = if isBack then "&lt;" else "X"
		pcall(UIKit.SetButtonColor, button, if isBack then Colors.Primary else Colors.Bad)
	end
end

-- Where the open window's Back goes (nil = it just closes).
local function backTarget(): { Name: string, Arg: any }?
	return if openName then backOf[openName] else nil
end

function UIKit.OpenWindow(name: string, arg: any?)
	ensureInit()
	if type(name) ~= "string" then
		return
	end
	if backOf[name] then
		backOf[name] = nil
		setBackLook(name, false)
	end
	if not registry[name] and not windowRecords[name] then
		warn("[UIKit] OpenWindow: no window called " .. name)
		return
	end
	if openName == name then
		callHandler(name, "Open", arg)
		return
	end
	closeOpenWindow(false)
	openName = name

	-- Note which windows are visible now, so a window that the Open handler shows itself (registered
	-- under a different name than its UIKit.Window) still gets linked and animated.
	local wasVisible: { [WindowRecord]: boolean } = {}
	for _, rec in windowRecords do
		wasVisible[rec] = rec.Frame.Visible
	end
	callHandler(name, "Open", arg)
	if openName ~= name then
		return -- the handler closed it or opened something else
	end

	local rec = recordFor(name)
	if not rec then
		for _, candidate in windowRecords do
			if candidate.Frame.Visible and not wasVisible[candidate] then
				rec = candidate
				candidate.LinkedName = name
				linkedRecords[name] = candidate
				break
			end
		end
	end
	if rec then
		showRecord(rec)
		selectFirstButton(rec)
	else
		local frame = explicitFrame(name)
		if frame then
			frame.Visible = true
		end
	end
	UIKit.WindowChanged:Fire(name)
end

-- nil closes whatever is open; a name only closes that window if it is the open one.
-- Opens `name` as a sub-menu of `parentName`: its Back button reopens the parent (with parentArg).
function UIKit.OpenSubWindow(name: string, arg: any?, parentName: string, parentArg: any?)
	UIKit.OpenWindow(name, arg)
	if openName == name then
		backOf[name] = { Name = parentName, Arg = parentArg }
		setBackLook(name, true)
	end
end

-- Back: to the parent of a sub-menu, otherwise just close.
function UIKit.GoBack()
	local target = backTarget()
	if target then
		UIKit.OpenWindow(target.Name, target.Arg)
	else
		UIKit.CloseWindow()
	end
end

function UIKit.CloseWindow(name: string?)
	if openName == nil or (name ~= nil and name ~= openName) then
		return
	end
	closeOpenWindow(true)
end

function UIKit.ToggleWindow(name: string, arg: any?)
	if openName ~= nil and openName == name then
		UIKit.CloseWindow(name)
	else
		UIKit.OpenWindow(name, arg)
	end
end

-- nil = is any window open?
function UIKit.IsWindowOpen(name: string?): boolean
	if name == nil then
		return openName ~= nil
	end
	return openName == name
end

local function onCloseClicked(rec: WindowRecord)
	local current = openName
	if current and (current == rec.Name or current == rec.LinkedName or recordFor(current) == rec) then
		UIKit.GoBack()
	else
		-- Not driven by the window system (or already closing): just hide it.
		clearSelectionInside(rec.Frame)
		hideRecord(rec)
		if type(rec.OnClose) == "function" then
			task.spawn(safeCall, rec.OnClose)
		end
	end
end

local WINDOW_SKIP = {
	Name = true,
	Title = true,
	Icon = true,
	Size = true,
	OnClose = true,
	Position = true,
	AnchorPoint = true,
}

--[[
	Window chrome: navy glass panel, aqua title banner with icon + title, round red X, padded content.
	props: Name, Title, Icon (emoji), Size (Vector2 in canvas px, default 760x500), Parent (a Root),
	  OnClose (called after the window closes, however it was closed), optional Position/AnchorPoint
	  (turns off auto-centring), any other Frame property.
	Returns (window, content). Hidden by default. Auto-centred below TopInset and scaled down to fit
	small canvases. window:SetAttribute("Title" / "Icon", ...) updates the banner.
]]
function UIKit.Window(props: { [string]: any }?): (Frame, Frame)
	ensureInit()
	local p: { [string]: any } = props or {}
	local name = tostring(p.Name or "Window")
	local baseSize = toVector2(p.Size, Vector2.new(760, 500))
	baseSize = Vector2.new(math.max(160, baseSize.X), math.max(120, baseSize.Y))

	local window = Instance.new("Frame")
	window.Name = name
	window.AnchorPoint = p.AnchorPoint or Vector2.new(0.5, 0.5)
	window.Size = UDim2.fromOffset(baseSize.X, baseSize.Y)
	window.BackgroundTransparency = 1
	window.BorderSizePixel = 0
	window.ZIndex = 20
	window.Visible = false
	window:SetAttribute("Title", tostring(p.Title or name))
	window:SetAttribute("Icon", tostring(p.Icon or ""))

	local winScale = Instance.new("UIScale")
	winScale.Name = "WindowScale"
	winScale.Parent = window

	local shadow = Instance.new("Frame")
	shadow.Name = "Shadow"
	shadow.Position = UDim2.fromOffset(0, 8)
	shadow.Size = UDim2.fromScale(1, 1)
	shadow.BackgroundColor3 = Colors.Ink
	shadow.BackgroundTransparency = WINDOW_SHADOW_T
	shadow.BorderSizePixel = 0
	shadow.ZIndex = 1
	addCorner(shadow, UDim.new(0, UIKit.Theme.CornerLarge + 2))
	shadow.Parent = window

	local panel = Instance.new("Frame")
	panel.Name = "Panel"
	panel.Size = UDim2.fromScale(1, 1)
	panel.BackgroundColor3 = WHITE
	panel.BorderSizePixel = 0
	panel.Active = true -- swallow clicks so they never reach the world (or the spray) behind it
	panel.ZIndex = 2
	addCorner(panel, UDim.new(0, UIKit.Theme.CornerLarge))
	addGradient(panel, Colors.Panel, Colors.PanelDark)
	addStroke(panel, Colors.Ink, UIKit.Theme.StrokeThickness)
	panel.Parent = window

	-- A faint inner rim makes the panel read as glossy glass rather than a flat box.
	local rim = Instance.new("Frame")
	rim.Name = "Rim"
	rim.Position = UDim2.fromOffset(3, 3)
	rim.Size = UDim2.new(1, -6, 1, -6)
	rim.BackgroundTransparency = 1
	rim.ZIndex = 1
	addCorner(rim, UDim.new(0, UIKit.Theme.CornerLarge - 3))
	addStroke(rim, WHITE, 1.5, 0.84)
	rim.Parent = panel

	addDecorBubble(panel, UDim2.new(1, -48, 1, -46), 66, 1)
	addDecorBubble(panel, UDim2.new(1, -100, 1, -26), 24, 1)
	addDecorBubble(panel, UDim2.new(0, 34, 1, -36), 40, 1)

	local titleBar = Instance.new("Frame")
	titleBar.Name = "TitleBar"
	titleBar.Position = UDim2.fromOffset(10, 10)
	titleBar.Size = UDim2.new(1, -20, 0, WINDOW_TITLE_H)
	titleBar.BackgroundColor3 = WHITE
	titleBar.BorderSizePixel = 0
	titleBar.ZIndex = 3
	addCorner(titleBar, UDim.new(0, UIKit.Theme.Corner))
	addGradient(titleBar, lighten(Colors.Primary, 0.28), Colors.Primary:Lerp(Colors.PrimaryDark, 0.3))
	addStroke(titleBar, darken(Colors.PrimaryDark, 0.55), 2.5)
	addShine(titleBar, UDim.new(0, UIKit.Theme.Corner - 3), 6, 0.45, 0.45)
	titleBar.Parent = panel

	local badge = Instance.new("Frame")
	badge.Name = "IconBadge"
	badge.AnchorPoint = Vector2.new(0, 0.5)
	badge.Position = UDim2.new(0, 8, 0.5, 0)
	badge.Size = UDim2.fromOffset(42, 42)
	badge.BackgroundColor3 = WHITE
	badge.BackgroundTransparency = 0.25
	badge.BorderSizePixel = 0
	badge.ZIndex = 2
	addCorner(badge, UDim.new(0.5, 0))
	addStroke(badge, darken(Colors.PrimaryDark, 0.35), 2)
	badge.Parent = titleBar

	local iconLabel = Instance.new("TextLabel")
	iconLabel.Name = "Icon"
	iconLabel.Size = UDim2.fromScale(1, 1)
	iconLabel.BackgroundTransparency = 1
	iconLabel.Font = Fonts.Title
	iconLabel.TextSize = 26
	iconLabel.ZIndex = 2
	iconLabel.Parent = badge

	local titleLabel = UIKit.Label({
		Name = "Title",
		AnchorPoint = Vector2.new(0, 0.5),
		TextSize = 30,
		TextScaled = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 2,
		StrokeThickness = 2.5,
		Parent = titleBar,
	})

	local rec: WindowRecord
	local closeButton = UIKit.Button({
		Name = "Close",
		Text = "X",
		Size = UDim2.fromOffset(42, 42),
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -7, 0.5, 0),
		Color = Colors.Bad,
		CornerRadius = 999,
		TextSize = 26,
		ZIndex = 3,
		Parent = titleBar,
		OnClick = function()
			if rec then
				onCloseClicked(rec)
			end
		end,
	})

	local function applyTitle()
		-- Title-only banners: emoji icons on every window read as clutter.
		local icon = ""
		local hasIcon = false
		badge.Visible = hasIcon
		iconLabel.Text = icon
		local left = if hasIcon then 60 else 16
		titleLabel.Position = UDim2.new(0, left, 0.5, 0)
		titleLabel.Size = UDim2.new(1, -(left + 58), 0, 38)
		titleLabel.Text = tostring(window:GetAttribute("Title") or "")
	end
	applyTitle()
	window:GetAttributeChangedSignal("Title"):Connect(applyTitle)
	window:GetAttributeChangedSignal("Icon"):Connect(applyTitle)
	-- If the owner resizes the window later, fit against the new size.
	window:GetPropertyChangedSignal("Size"):Connect(function()
		if rec then
			local size = toVector2(window.Size, rec.BaseSize)
			rec.BaseSize = Vector2.new(math.max(160, size.X), math.max(120, size.Y))
			layoutWindow(rec)
		end
	end)

	local content = Instance.new("Frame")
	content.Name = "Content"
	content.Position = UDim2.fromOffset(0, WINDOW_TITLE_H + 16)
	content.Size = UDim2.new(1, 0, 1, -(WINDOW_TITLE_H + 16))
	content.BackgroundTransparency = 1
	content.BorderSizePixel = 0
	content.ZIndex = 4
	local padding = UIKit.Padding(content, 16)
	padding.PaddingTop = UDim.new(0, 4)
	content.Parent = panel

	local veil = Instance.new("Frame")
	veil.Name = "Veil"
	veil.Size = UDim2.fromScale(1, 1)
	veil.BackgroundColor3 = Colors.Panel
	veil.BackgroundTransparency = 1
	veil.BorderSizePixel = 0
	veil.Visible = false
	veil.ZIndex = 50
	addCorner(veil, UDim.new(0, UIKit.Theme.CornerLarge))
	veil.Parent = window

	rec = {
		Name = name,
		Frame = window,
		Content = content,
		Scale = winScale,
		Veil = veil,
		Shadow = shadow,
		CloseButton = closeButton,
		BaseSize = baseSize,
		Fit = 1,
		Token = 0,
		Animating = false,
		Closing = false,
		AutoPlace = p.Position == nil,
		PlacedAt = nil,
		LinkedName = nil,
		OnClose = p.OnClose,
	}
	if p.Position ~= nil then
		window.Position = p.Position
	end

	local previous = windowRecords[name]
	if previous and previous.Frame.Parent ~= nil then
		warn("[UIKit] two windows are named " .. name .. "; the newest one wins")
	end
	windowRecords[name] = rec

	window.Destroying:Connect(function()
		if windowRecords[name] == rec then
			windowRecords[name] = nil
		end
		for key, linked in linkedRecords do
			if linked == rec then
				linkedRecords[key] = nil
			end
		end
		if openName and (openName == rec.Name or openName == rec.LinkedName) then
			openName = nil
			UIKit.WindowChanged:Fire(nil)
		end
	end)

	local parent = assign(window, p, WINDOW_SKIP)
	layoutWindow(rec)
	if parent then
		window.Parent = parent
	end
	return window, content
end

-- Convenience for window:SetAttribute("Title"/"Icon", ...).
function UIKit.SetWindowTitle(window: Instance, title: string, icon: string?)
	window:SetAttribute("Title", tostring(title))
	if icon ~= nil then
		window:SetAttribute("Icon", tostring(icon))
	end
end

----------------------------------------------------------------------------------------------------
-- Toasts
----------------------------------------------------------------------------------------------------
type ToastFade = { Inst: Instance, Prop: string, Shown: number }
type ToastRecord = {
	Frame: Frame,
	Text: string,
	Kind: string,
	Height: number,
	Alive: boolean,
	Token: number,
	Duration: number,
	Fades: { ToastFade },
}

local TOAST_STYLES = {
	Info = { Color = Colors.Primary, Icon = "🧼" },
	Good = { Color = Colors.Good, Icon = "✨" },
	Bad = { Color = Colors.Bad, Icon = "⚠️" },
	Warning = { Color = Colors.Warning, Icon = "⚠️" },
}

local toastHolder: Frame? = nil
local toasts: { ToastRecord } = {} -- newest first

-- Toasts start under the topbar, or lower when something owns the space (UIKit.SetToastTop: the
-- HUD's progress bar during a run).
local toastMinTop = 0
local function toastTop(): number
	return math.max(math.floor(insetPx / scale + 12), toastMinTop)
end

local function getToastHolder(): Frame
	if toastHolder and toastHolder:IsDescendantOf(game) then
		return toastHolder
	end
	table.clear(toasts) -- anything from a lost holder is gone with it
	local _, root = UIKit.CreateScreen("UIKitToasts", 100)
	local holder = Instance.new("Frame")
	holder.Name = "Toasts"
	holder.AnchorPoint = Vector2.new(0.5, 0)
	holder.Position = UDim2.new(0.5, 0, 0, toastTop())
	holder.Size = UDim2.fromOffset(10, 10)
	holder.BackgroundTransparency = 1
	holder.Parent = root
	toastHolder = holder
	return holder
end

table.insert(layoutHooks, function()
	if toastHolder then
		toastHolder.Position = UDim2.new(0.5, 0, 0, toastTop())
	end
end)

-- The lowest point toasts may start at (canvas units); 0 = right under the topbar.
function UIKit.SetToastTop(y: number?)
	toastMinTop = math.max(0, math.floor(tonumber(y) or 0))
	if toastHolder then
		toastHolder.Position = UDim2.new(0.5, 0, 0, toastTop())
	end
end

local function fadeToast(t: ToastRecord, hidden: boolean, time: number)
	for _, f in t.Fades do
		tween(f.Inst, { [f.Prop] = if hidden then 1 else f.Shown }, time)
	end
end

local function stackToasts()
	local y = 0
	for _, t in toasts do
		tween(t.Frame, { Position = UDim2.new(0.5, 0, 0, y) }, 0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
		y += t.Height + TOAST_GAP
	end
end

local function dismissToast(t: ToastRecord, fast: boolean)
	if not t.Alive then
		return
	end
	t.Alive = false
	local i = table.find(toasts, t)
	if i then
		table.remove(toasts, i)
	end
	local time = if fast then 0.12 else 0.25
	fadeToast(t, true, time)
	tween(t.Frame, { Position = t.Frame.Position - UDim2.fromOffset(0, 14) }, time)
	task.delay(time + 0.05, function()
		t.Frame:Destroy()
	end)
	stackToasts()
end

local function armToast(t: ToastRecord)
	t.Token += 1
	local token = t.Token
	task.delay(t.Duration, function()
		if t.Alive and t.Token == token then
			dismissToast(t, false)
		end
	end)
end

-- A burst of confetti across the whole screen (a pass bought, something big unlocked). Purely
-- cosmetic; every piece cleans itself up after it lands.
local CONFETTI_COLORS = {
	Color3.fromRGB(255, 90, 110),
	Color3.fromRGB(255, 200, 60),
	Color3.fromRGB(90, 220, 140),
	Color3.fromRGB(80, 170, 255),
	Color3.fromRGB(190, 120, 255),
	Color3.fromRGB(255, 255, 255),
}
function UIKit.Confetti(pieces: number?)
	local player = Players.LocalPlayer
	local playerGui = player and player:FindFirstChildOfClass("PlayerGui")
	if not playerGui then
		return
	end
	local gui = Instance.new("ScreenGui")
	gui.Name = "Confetti"
	gui.IgnoreGuiInset = true
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 100
	gui.Parent = playerGui
	local count = pieces or 90
	for _ = 1, count do
		local piece = Instance.new("Frame")
		local w = math.random(8, 14)
		piece.Size = UDim2.fromOffset(w, math.floor(w * (0.5 + math.random())))
		piece.AnchorPoint = Vector2.new(0.5, 0.5)
		piece.Position = UDim2.new(math.random(), 0, 0, -math.random(10, 200))
		piece.Rotation = math.random(0, 360)
		piece.BackgroundColor3 = CONFETTI_COLORS[math.random(1, #CONFETTI_COLORS)]
		piece.BorderSizePixel = 0
		piece.Parent = gui
		local fall = 1.6 + math.random() * 1.6
		TweenService:Create(piece, TweenInfo.new(fall, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			Position = UDim2.new(piece.Position.X.Scale + (math.random() - 0.5) * 0.25, 0, 1.1, 0),
			Rotation = piece.Rotation + math.random(-540, 540),
		}):Play()
	end
	task.delay(3.5, function()
		gui:Destroy()
	end)
	UIKit.PlaySound("Sparkle")
end

-- Pill notification, top-centre below the topbar. Newest on top, max 4, ~3 s each (longer for long
-- messages). Repeating a message that is still showing restarts its timer instead of stacking.
function UIKit.Toast(text: string, kind: string?)
	ensureInit()
	local message = tostring(if text == nil then "" else text)
	if message == "" then
		return
	end
	local kindName = if type(kind) == "string" and (TOAST_STYLES :: any)[kind] then kind else "Info"
	local style = (TOAST_STYLES :: any)[kindName]

	for _, t in toasts do
		if t.Alive and t.Text == message and t.Kind == kindName then
			armToast(t)
			UIKit.Bounce(t.Frame)
			return
		end
	end

	local holder = getToastHolder()
	local okSize, bounds = pcall(function()
		return TextService:GetTextSize(message, TOAST_TEXT_SIZE, Fonts.Title, Vector2.new(TOAST_MAX_TEXT_W, 1000))
	end)
	local textW, textH
	if okSize and typeof(bounds) == "Vector2" then
		textW, textH = math.ceil(bounds.X) + 8, math.ceil(bounds.Y)
	else
		textW, textH = math.min(TOAST_MAX_TEXT_W, #message * 11), TOAST_TEXT_SIZE
	end
	local height = math.max(50, textH + 22)
	local width = 24 + textW + 24
	local multiline = textH &gt; TOAST_TEXT_SIZE * 1.5

	local frame = Instance.new("Frame")
	frame.Name = "Toast"
	frame.AnchorPoint = Vector2.new(0.5, 0)
	frame.Position = UDim2.new(0.5, 0, 0, -height - TOAST_GAP)
	frame.Size = UDim2.fromOffset(width, height)
	frame.BackgroundColor3 = WHITE
	frame.BackgroundTransparency = 1
	frame.BorderSizePixel = 0
	local radius = UDim.new(0, if multiline then 18 else math.floor(height / 2))
	addCorner(frame, radius)
	addGradient(frame, lighten(style.Color, 0.25), style.Color)
	local stroke = addStroke(frame, darken(style.Color, 0.6), UIKit.Theme.StrokeThickness, 1)
	local shine = addShine(frame, if multiline then UDim.new(0, 14) else radius, 10, 0.45, 0.45)
	shine.BackgroundTransparency = 1

	local icon = Instance.new("TextLabel")
	icon.Name = "Icon"
	icon.AnchorPoint = Vector2.new(0, 0.5)
	icon.Position = UDim2.new(0, 16, 0.5, 0)
	icon.Size = UDim2.fromOffset(30, 30)
	icon.BackgroundTransparency = 1
	icon.Font = Fonts.Title
	icon.Text = ""
	icon.Visible = false -- toasts are text only (the colour says what kind it is)
	icon.TextSize = 26
	icon.TextTransparency = 1
	icon.ZIndex = 2
	icon.Parent = frame

	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.AnchorPoint = Vector2.new(0, 0.5)
	label.Position = UDim2.new(0, 24, 0.5, 0)
	label.Size = UDim2.fromOffset(textW, textH + 4)
	label.BackgroundTransparency = 1
	label.Font = Fonts.Title
	label.Text = message
	label.TextSize = TOAST_TEXT_SIZE
	label.TextColor3 = Colors.Text
	label.TextWrapped = true
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextTransparency = 1
	label.ZIndex = 2
	local labelStroke = addTextStroke(label, TOAST_TEXT_SIZE, nil, nil, 1)
	label.Parent = frame

	local t: ToastRecord = {
		Frame = frame,
		Text = message,
		Kind = kindName,
		Height = height,
		Alive = true,
		Token = 0,
		Duration = math.clamp(3 + (utf8.len(message) or #message) / 40, 3, 6),
		Fades = {
			{ Inst = frame, Prop = "BackgroundTransparency", Shown = 0 },
			{ Inst = stroke, Prop = "Transparency", Shown = 0 },
			{ Inst = shine, Prop = "BackgroundTransparency", Shown = 0 },
			{ Inst = icon, Prop = "TextTransparency", Shown = 0 },
			{ Inst = label, Prop = "TextTransparency", Shown = 0 },
			{ Inst = labelStroke, Prop = "Transparency", Shown = 0 },
		},
	}
	frame.Parent = holder

	table.insert(toasts, 1, t)
	while #toasts &gt; TOAST_MAX do
		dismissToast(toasts[#toasts], true)
	end
	fadeToast(t, false, 0.2)
	stackToasts()
	armToast(t)
end

----------------------------------------------------------------------------------------------------
-- Motion
----------------------------------------------------------------------------------------------------

-- TweenService:Create + Play. Defaults: 0.25 s, Quad, Out.
function UIKit.Tween(
	inst: Instance,
	props: { [string]: any },
	time: number?,
	style: Enum.EasingStyle?,
	dir: Enum.EasingDirection?
): Tween
	return tween(inst, props, time, style, dir)
end

-- Quick 1 -&gt; 1.15 -&gt; 1 pop. Uses the gui's UIScale (or creates "BounceScale") and returns to
-- whatever scale it had, so bouncing a scaled element is safe. Spamming it restarts the pop.
function UIKit.Bounce(gui: GuiObject)
	if typeof(gui) ~= "Instance" or not gui:IsA("GuiObject") then
		return
	end
	local found = gui:FindFirstChild("BounceScale")
	if not (found and found:IsA("UIScale")) then
		found = gui:FindFirstChildOfClass("UIScale")
	end
	local uiScale: UIScale
	if found and found:IsA("UIScale") then
		uiScale = found
	else
		uiScale = Instance.new("UIScale")
		uiScale.Name = "BounceScale"
		uiScale.Parent = gui
	end

	local base = uiScale:GetAttribute("BounceBase")
	if type(base) ~= "number" then
		base = uiScale.Scale
		uiScale:SetAttribute("BounceBase", base)
	end
	local baseScale = base :: number
	local token = (tonumber(uiScale:GetAttribute("BounceToken")) or 0) + 1
	uiScale:SetAttribute("BounceToken", token)

	local up = tween(uiScale, { Scale = baseScale * 1.15 }, 0.08)
	up.Completed:Once(function()
		if uiScale:GetAttribute("BounceToken") ~= token then
			return
		end
		local down = tween(uiScale, { Scale = baseScale }, 0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
		down.Completed:Once(function()
			if uiScale:GetAttribute("BounceToken") == token then
				uiScale:SetAttribute("BounceBase", nil)
			end
		end)
	end)
end

----------------------------------------------------------------------------------------------------
-- Progress bar
----------------------------------------------------------------------------------------------------
export type ProgressBar = {
	Frame: Frame,
	Fill: Frame,
	Label: TextLabel,
	Set: (fraction: number, text: string?) -&gt; (),
	SetColor: (color: Color3) -&gt; (),
}

local BAR_SKIP = { Size = true, Color = true, Text = true, TextSize = true, Value = true, BackColor = true }

--[[
	Rounded pill bar with a glossy gradient fill and centred outlined text.
	props: Size, Position, AnchorPoint, Color, Parent, plus Text, TextSize, Value (initial 0..1),
	  BackColor (track colour), Name, ZIndex, LayoutOrder...
	Returns { Frame, Fill, Label, Set = (fraction, text?) -&gt; (), SetColor = (Color3) -&gt; () }.
	Set animates the fill; text nil keeps the current text. bar:Set(...) works too.
]]
function UIKit.ProgressBar(props: { [string]: any }?): ProgressBar
	local p: { [string]: any } = props or {}
	local size: UDim2 = p.Size or UDim2.fromOffset(300, 34)
	local height = if size.Y.Scale == 0 and size.Y.Offset &gt; 0 then size.Y.Offset else 34
	local color: Color3 = p.Color or Colors.Primary

	local track = Instance.new("Frame")
	track.Name = "ProgressBar"
	track.Size = size
	track.BackgroundColor3 = p.BackColor or Colors.PanelDark
	track.BorderSizePixel = 0
	addCorner(track, UDim.new(0.5, 0))
	addStroke(track, Colors.Ink, UIKit.Theme.StrokeThickness)
	local parent = assign(track, p, BAR_SKIP)

	local inner = Instance.new("Frame")
	inner.Name = "Inner"
	inner.Position = UDim2.fromOffset(3, 3)
	inner.Size = UDim2.new(1, -6, 1, -6)
	inner.BackgroundTransparency = 1
	inner.BorderSizePixel = 0
	inner.ZIndex = 1
	inner.Parent = track

	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(0, 1)
	fill.BackgroundColor3 = WHITE
	fill.BorderSizePixel = 0
	fill.Visible = false
	addCorner(fill, UDim.new(0.5, 0))
	local fillGradient = addGradient(fill, lighten(color, 0.3), color)
	addShine(fill, UDim.new(0.5, 0), 4, 0.45, 0.55)
	fill.Parent = inner

	local label = UIKit.Label({
		Name = "Text",
		Text = p.Text or "",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, -16, 1, 0),
		TextSize = tonumber(p.TextSize) or math.max(16, math.floor(height * 0.56)),
		ZIndex = 2,
		Parent = track,
	})

	-- A pill narrower than it is tall squashes into an oval, so the fill never gets narrower than
	-- a circle: width = minFrac + (1 - minFrac) * fraction, where minFrac = height / width.
	local current = 0
	local hideToken = 0
	local lastRatio = -1
	local function widthScale(f: number): number
		local abs = inner.AbsoluteSize
		local minFrac = if abs.X &gt; 0 then math.clamp(abs.Y / abs.X, 0, 1) else 0
		return minFrac + (1 - minFrac) * f
	end
	local function render(animate: boolean)
		hideToken += 1
		local token = hideToken
		local shown = current &gt; 0.0005
		local goal = UDim2.fromScale(widthScale(current), 1)
		if not animate then
			fill.Size = goal
			fill.Visible = shown
			return
		end
		if shown and not fill.Visible then
			fill.Size = UDim2.fromScale(widthScale(0), 1) -- grow out of a dot, not from a stale width
			fill.Visible = true
		end
		local tw = tween(fill, { Size = goal }, 0.25)
		if not shown then
			tw.Completed:Once(function()
				if token == hideToken then
					fill.Visible = false
				end
			end)
		end
	end
	inner:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		local abs = inner.AbsoluteSize
		local ratio = if abs.X &gt; 0 then abs.Y / abs.X else 0
		if math.abs(ratio - lastRatio) &gt; 0.001 then
			lastRatio = ratio
			render(false)
		end
	end)

	local bar = {} :: any
	bar.Frame = track
	bar.Fill = fill
	bar.Label = label
	bar.Set = function(a: any, b: any, c: any)
		local fraction, text = a, b
		if a == bar then -- called as bar:Set(...)
			fraction, text = b, c
		end
		local f = tonumber(fraction) or 0
		if f ~= f then
			f = 0
		end
		current = math.clamp(f, 0, 1)
		render(true)
		if text ~= nil then
			label.Text = tostring(text)
		end
	end
	bar.SetColor = function(a: any, b: any)
		local c = if a == bar then b else a
		if typeof(c) == "Color3" then
			fillGradient.Color = ColorSequence.new(lighten(c, 0.3), c)
		end
	end

	local initial = tonumber(p.Value) or 0
	current = if initial ~= initial then 0 else math.clamp(initial, 0, 1)
	render(false)
	if parent then
		track.Parent = parent
	end
	return bar :: ProgressBar
end

----------------------------------------------------------------------------------------------------
-- 3D previews (ViewportFrame)
----------------------------------------------------------------------------------------------------
type ViewState = {
	Camera: Camera,
	Model: Instance?,
	Center: Vector3,
	Radius: number,
	Yaw: number,
	Pitch: number,
	Zoom: number,
	SpinSpeed: number,
}

local viewStates: { [ViewportFrame]: ViewState } = {}
local spinning: { [ViewportFrame]: ViewState } = {}
local spinConnection: RBXScriptConnection? = nil

-- Orbit the camera around the model's bounding sphere so it always fits, whatever the frame's
-- aspect ratio. Yaw 0 looks at the model's front (-Z, the way pets face).
local function frameCamera(vpf: ViewportFrame, st: ViewState)
	local abs = vpf.AbsoluteSize
	local aspect = if abs.X &gt; 0 and abs.Y &gt; 0 then abs.X / abs.Y else 1
	local halfV = math.rad(st.Camera.FieldOfView) / 2
	local halfH = math.atan(math.tan(halfV) * aspect)
	local half = math.min(halfV, halfH)
	local distance = st.Radius / math.sin(half) * st.Zoom
	local rotation = CFrame.Angles(0, st.Yaw, 0) * CFrame.Angles(st.Pitch, 0, 0)
	local eye = st.Center + rotation:VectorToWorldSpace(Vector3.new(0, 0, -distance))
	st.Camera.CFrame = CFrame.lookAt(eye, st.Center)
end

-- One RenderStepped connection drives every spinning viewport; it exists only while one does.
local function updateSpinLoop()
	if next(spinning) == nil then
		if spinConnection then
			spinConnection:Disconnect()
			spinConnection = nil
		end
		return
	end
	if spinConnection then
		return
	end
	spinConnection = RunService.RenderStepped:Connect(function(dt: number)
		for vpf, st in spinning do
			if vpf.Visible and vpf.Parent then
				st.Yaw = (st.Yaw + dt * st.SpinSpeed) % (math.pi * 2)
				frameCamera(vpf, st)
			end
		end
	end)
end

-- Swap the model shown in a UIKit.Viewport (cloned unless noClone). nil clears it.
function UIKit.SetViewportModel(vpf: ViewportFrame, model: Instance?, noClone: boolean?)
	local st = viewStates[vpf]
	if not st then
		return
	end
	if st.Model then
		st.Model:Destroy()
		st.Model = nil
	end
	if typeof(model) ~= "Instance" then
		return
	end
	local instance: Instance? = model
	if not noClone then
		local ok, clone = pcall(function()
			return model:Clone()
		end)
		instance = if ok then clone else nil
	end
	if not instance then
		return
	end

	local center, radius = Vector3.zero, 2
	if instance:IsA("Model") then
		local ok, cf, size = pcall(function()
			return (instance :: Model):GetBoundingBox()
		end)
		if ok and typeof(cf) == "CFrame" and typeof(size) == "Vector3" then
			center, radius = cf.Position, math.max(size.Magnitude / 2, 0.25)
		end
	elseif instance:IsA("BasePart") then
		center, radius = instance.Position, math.max(instance.Size.Magnitude / 2, 0.25)
	end
	st.Center = center
	st.Radius = radius
	st.Model = instance
	instance.Parent = vpf
	frameCamera(vpf, st)
end

function UIKit.SetViewportSpin(vpf: ViewportFrame, spin: boolean)
	local st = viewStates[vpf]
	if not st then
		return
	end
	if spin then
		spinning[vpf] = st
	else
		spinning[vpf] = nil
	end
	updateSpinLoop()
end

local VIEWPORT_SKIP = {
	Model = true,
	Spin = true,
	SpinSpeed = true,
	Yaw = true,
	Pitch = true,
	Zoom = true,
	NoClone = true,
	FieldOfView = true,
}

--[[
	A 3D preview. props: Model (cloned in), Size, Position, Parent, Spin (slow turntable), plus
	  AnchorPoint, ZIndex, LayoutOrder, Name..., SpinSpeed (rad/s, default 0.8), Yaw / Pitch
	  (radians, default a friendly 3/4 view), Zoom (&lt; 1 = closer, default 0.9), FieldOfView,
	  NoClone (use Model itself instead of a copy).
	Cleans itself up (spin loop entry, model) when the frame is destroyed.
]]
function UIKit.Viewport(props: { [string]: any }?): ViewportFrame
	local p: { [string]: any } = props or {}
	local vpf = Instance.new("ViewportFrame")
	vpf.Name = "Viewport"
	vpf.Size = UDim2.fromOffset(120, 120)
	vpf.BackgroundTransparency = 1
	vpf.BorderSizePixel = 0
	vpf.Ambient = Color3.fromRGB(190, 198, 212)
	vpf.LightColor = Color3.fromRGB(255, 250, 240)
	vpf.LightDirection = Vector3.new(-0.4, -1, 0.5)

	local camera = Instance.new("Camera")
	camera.FieldOfView = math.clamp(tonumber(p.FieldOfView) or 32, 5, 90)
	camera.Parent = vpf
	vpf.CurrentCamera = camera

	local st: ViewState = {
		Camera = camera,
		Model = nil,
		Center = Vector3.zero,
		Radius = 2,
		Yaw = tonumber(p.Yaw) or math.rad(-25),
		Pitch = tonumber(p.Pitch) or math.rad(12),
		Zoom = math.clamp(tonumber(p.Zoom) or 0.9, 0.2, 5),
		SpinSpeed = tonumber(p.SpinSpeed) or 0.8,
	}
	viewStates[vpf] = st

	vpf:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		if not spinning[vpf] then
			frameCamera(vpf, st)
		end
	end)
	vpf.Destroying:Connect(function()
		viewStates[vpf] = nil
		if spinning[vpf] then
			spinning[vpf] = nil
			updateSpinLoop()
		end
	end)

	local parent = assign(vpf, p, VIEWPORT_SKIP)
	UIKit.SetViewportModel(vpf, p.Model, p.NoClone == true)
	frameCamera(vpf, st)
	if p.Spin then
		spinning[vpf] = st
		updateSpinLoop()
	end
	if parent then
		vpf.Parent = parent
	end
	return vpf
end

----------------------------------------------------------------------------------------------------
-- Formatting and colours
----------------------------------------------------------------------------------------------------
UIKit.Short = Format.Short
UIKit.Time = Format.Time
UIKit.Commas = Format.Commas

function UIKit.RarityColor(rarity: string): Color3
	local def = (Config.Rarities :: any)[rarity]
	if def and typeof(def.Color) == "Color3" then
		return def.Color
	end
	return Config.Rarities.Common.Color
end

----------------------------------------------------------------------------------------------------
-- Init
----------------------------------------------------------------------------------------------------
local cameraConnection: RBXScriptConnection? = nil

local function hookCamera()
	if cameraConnection then
		cameraConnection:Disconnect()
		cameraConnection = nil
	end
	local camera = workspace.CurrentCamera
	if camera then
		cameraConnection = camera:GetPropertyChangedSignal("ViewportSize"):Connect(queueRefresh)
	end
	queueRefresh()
end

-- Escape (keyboard) and B (gamepad) close the open window.
local function onInputBegan(input: InputObject, _processed: boolean)
	local key = input.KeyCode
	if key ~= Enum.KeyCode.Escape and key ~= Enum.KeyCode.ButtonB then
		return
	end
	if openName == nil or UserInputService:GetFocusedTextBox() ~= nil then
		return
	end
	UIKit.GoBack()
end

-- Safe to call more than once; every other entry point calls it lazily too.
function UIKit.Init()
	if initialized then
		return
	end
	initialized = true

	hookCamera()
	workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(hookCamera)
	pcall(function()
		GuiService:GetPropertyChangedSignal("TopbarInset"):Connect(queueRefresh)
	end)
	local hasPreferredInput = pcall(function()
		UserInputService:GetPropertyChangedSignal("PreferredInput" :: any):Connect(queueRefresh)
	end)
	if not hasPreferredInput then
		-- Older engines: infer the input type from the last input and device capabilities.
		UserInputService.LastInputTypeChanged:Connect(queueRefresh)
	end
	for _, seconds in INSET_REREADS do
		task.delay(seconds, queueRefresh)
	end
	UserInputService.InputBegan:Connect(onInputBegan)
	task.spawn(preloadSounds)
	ensureSafeProbes(Players.LocalPlayer:FindFirstChildOfClass("PlayerGui"))

	applyLayout(true)
end

----------------------------------------------------------------------------------------------------
-- Busy: a small card with bouncing dots ("Deleting...") over everything while something slow happens.
-- local done = UIKit.Busy("Creating your club") ... done()
-- It only appears if the wait lasts more than DELAY seconds (unless `immediate`), so quick actions
-- never flash it. Several
-- can be active at once; the newest text shows, and it goes when the last one finishes.
----------------------------------------------------------------------------------------------------
local BUSY_DELAY = 0.3
local busyStack: { { Text: string } } = {}
local busyGui: GuiObject? = nil
local busyLabel: TextLabel? = nil

local function refreshBusy()
	if #busyStack == 0 then
		if busyGui then
			busyGui.Visible = false
		end
		return
	end
	if not busyGui then
		local _gui, root = UIKit.CreateScreen("BusyOverlay", 90)
		local dim = Instance.new("TextButton") -- eats clicks while it's up
		dim.Name = "Dim"
		dim.Text = ""
		dim.AutoButtonColor = false
		dim.BackgroundColor3 = Colors.Ink
		dim.BackgroundTransparency = 0.6
		dim.Size = UDim2.fromScale(1, 1)
		dim.BorderSizePixel = 0
		dim.Parent = root
		local card = Instance.new("Frame")
		card.AnchorPoint = Vector2.new(0.5, 0.5)
		card.Position = UDim2.fromScale(0.5, 0.5)
		card.Size = UDim2.fromOffset(320, 120)
		card.BackgroundColor3 = Colors.Panel
		addCorner(card, UDim.new(0, UIKit.Theme.CornerLarge))
		addStroke(card, Colors.Primary, 3, 0)
		card.Parent = dim
		local label = Instance.new("TextLabel")
		label.BackgroundTransparency = 1
		label.Font = Fonts.Title
		label.TextSize = 24
		label.TextColor3 = Colors.Text
		label.Size = UDim2.new(1, -20, 0, 36)
		label.Position = UDim2.fromOffset(10, 14)
		label.Parent = card
		addStroke(label, Colors.Stroke, 2, 0)
		for i = 1, 3 do
			local dot = Instance.new("Frame")
			dot.AnchorPoint = Vector2.new(0.5, 0.5)
			dot.Position = UDim2.new(0.5, (i - 2) * 30, 0, 84)
			dot.Size = UDim2.fromOffset(16, 16)
			dot.BackgroundColor3 = Colors.Primary
			addCorner(dot, UDim.new(0.5, 0))
			dot.Parent = card
			TweenService:Create(dot, TweenInfo.new(0.35, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true, i * 0.12), { Position = UDim2.new(0.5, (i - 2) * 30, 0, 72) }):Play()
		end
		busyGui = dim
		busyLabel = label
	end
	(busyLabel :: TextLabel).Text = busyStack[#busyStack].Text
	;(busyGui :: GuiObject).Visible = true
end

function UIKit.Busy(text: string?, immediate: boolean?): () -&gt; ()
	local entry = { Text = tostring(text or "Working") .. "..." }
	local finished = false
	if immediate then
		table.insert(busyStack, entry)
		refreshBusy()
	else
		task.delay(BUSY_DELAY, function()
			if not finished then
				table.insert(busyStack, entry)
				refreshBusy()
			end
		end)
	end
	return function()
		if finished then
			return
		end
		finished = true
		local i = table.find(busyStack, entry)
		if i then
			table.remove(busyStack, i)
			refreshBusy()
		end
	end
end


return UIKit</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000049"><Properties><string name="Name">UpgradesUI</string><ProtectedString name="Source">--[[
	UpgradesUI - the in-run "Upgrades" window, drawn as an open book:
	  * left page: your current tool (big), its stats, and the four Coins upgrades as cards with a
	    level pip bar, the next-level preview and a buy button
	  * right page: every tool. Buy any of them in any order; owned ones go in your hand with Equip
	    (or the hotbar, keys 1-6). Power and Size are per tool; Tank and Sneakers count for all.

	Only meaningful inside a run, so it closes itself the moment ClientState.Run goes nil. Everything it
	shows comes from ClientState.Run (server-authoritative) and Config's pure helpers.
	Open it with the HUD button, Tab/Q, or gamepad Y.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Types = require(Shared:WaitForChild("Types"))

local Client = script.Parent
local ClientState = require(Client:WaitForChild("ClientState"))
local UIKit = require(Client:WaitForChild("UIKit"))
local ShopUI = require(Client:WaitForChild("ShopUI"))

local Colors = UIKit.Theme.Colors

local UpgradesUI = {}

local WINDOW_SIZE = Vector2.new(920, 580)

local PAGE = Color3.fromRGB(252, 246, 228)
local PAGE_EDGE = Color3.fromRGB(226, 212, 176)
local COVER = Color3.fromRGB(40, 90, 170)
local INK = Color3.fromRGB(40, 70, 140)
local INK_DIM = Color3.fromRGB(120, 110, 90)

local initialized = false

local book: Frame
local leftPage: Frame
local rightPage: Frame

----------------------------------------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------------------------------------

local function fmtNum(n: number): string
	if n ~= n then
		return "0"
	end
	if math.abs(n - math.floor(n + 0.5)) &lt; 0.05 then
		return UIKit.Short(math.floor(n + 0.5))
	end
	return string.format("%.1f", n)
end

local PREVIEW: { [string]: { Label: string, Get: (Types.RunStats) -&gt; number, Suffix: string? } } = {
	-- Size is the circle for scrub/spray tools, the line length for the washer, the splat for foam.
	HandSize = { Label = "Size", Get = function(s) return s.LineLength or s.Radius end },
	ScrubPower = { Label = "Power", Get = function(s) return s.Power end, Suffix = "/s" },
	TankSize = { Label = "Tank", Get = function(s) return s.TankMax end },
	Sneakers = { Label = "Speed", Get = function(s) return s.WalkSpeed end },
}

local function previewStats(run: Types.RunState, upgradeId: string): Types.RunStats
	local meta = ClientState.Meta
	local perks = (meta and meta.Perks) or {}
	local passes = (meta and meta.Passes) or {}
	local petBonus = if meta then Config.PetCoinBonus(meta.Pets, meta.Equipped, meta.PetIndex) else 0
	local nextUpgrades = table.clone(run.Upgrades)
	;(nextUpgrades :: any)[upgradeId] = ((run.Upgrades :: any)[upgradeId] or 0) + 1
	return Config.GetRunStats(run.Level, nextUpgrades, run.ToolIndex, perks, passes, petBonus, meta and meta.Rank or nil, meta and meta.Rebirths or 0)
end

local function buy(action: string, value: any, onRow: GuiObject)
	local result = if action == "BuyTool" then ShopUI.GetTool(value) else ClientState.RunRequest(action, value)
	if not result then
		return -- short of coins: the tool's pass was offered
	end
	if result.Ok then
		UIKit.Bounce(onRow)
		UIKit.PlaySound("Coins")
	else
		UIKit.Toast(result.Error or "Couldn't buy that.", "Bad")
		UIKit.PlaySound("Error")
	end
end

-- Dark "ink" text for the paper pages (no white outline).
local function ink(props: { [string]: any }): TextLabel
	props.TextColor3 = props.TextColor3 or INK
	props.Stroke = false
	return UIKit.Label(props)
end

local function clear(frame: Instance)
	for _, child in frame:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
end

local function tile(parent: Instance, size: UDim2, pos: UDim2, color: Color3): Frame
	local f = Instance.new("Frame")
	f.Size = size
	f.Position = pos
	f.BackgroundColor3 = color
	f.BorderSizePixel = 0
	UIKit.Corner(f, 12)
	UIKit.Stroke(f, PAGE_EDGE, 2)
	f.Parent = parent
	return f
end

----------------------------------------------------------------------------------------------------
-- Left page: current tool + upgrades
----------------------------------------------------------------------------------------------------

local function upgradeCard(parent: Instance, def: any, run: Types.RunState, order: number): Frame
	local level = ((run.Upgrades :: any)[def.Id] :: number?) or 0
	local card = tile(parent, UDim2.new(0.5, -6, 0, 140), UDim2.new(), Color3.fromRGB(255, 252, 240))
	card.Name = def.Id
	card.LayoutOrder = order

	ink({ Text = def.Icon, TextSize = 34, Position = UDim2.fromOffset(8, 6), Size = UDim2.fromOffset(42, 42), Parent = card })
	ink({
		Text = def.Name,
		TextSize = 20,
		Position = UDim2.fromOffset(52, 6),
		Size = UDim2.new(1, -58, 0, 22),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextScaled = true,
		Parent = card,
	})
	ink({
		Text = string.format("Lv %d/%d  •  %s", level, def.Max, if def.PerTool then "this tool" else "all tools"),
		TextSize = 15,
		TextColor3 = INK_DIM,
		Position = UDim2.fromOffset(52, 28),
		Size = UDim2.new(1, -58, 0, 18),
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = card,
	})

	-- Level pips.
	local pips = Instance.new("Frame")
	pips.BackgroundTransparency = 1
	pips.Position = UDim2.fromOffset(10, 54)
	pips.Size = UDim2.new(1, -20, 0, 12)
	pips.Parent = card
	local pipLayout = Instance.new("UIListLayout")
	pipLayout.FillDirection = Enum.FillDirection.Horizontal
	pipLayout.Padding = UDim.new(0, 2)
	pipLayout.Parent = pips
	for i = 1, def.Max do
		local pip = Instance.new("Frame")
		pip.Size = UDim2.new(1 / def.Max, -2, 1, 0)
		pip.BackgroundColor3 = if i &lt;= level then Colors.Good else Color3.fromRGB(220, 210, 185)
		pip.BorderSizePixel = 0
		UIKit.Corner(pip, 3)
		pip.Parent = pips
	end

	local spec = PREVIEW[def.Id]
	local previewText = def.Desc
	if spec then
		local now = spec.Get(run.Stats)
		if level &lt; def.Max then
			previewText = string.format("%s %s → %s%s", spec.Label, fmtNum(now), fmtNum(spec.Get(previewStats(run, def.Id))), spec.Suffix or "")
		else
			previewText = string.format("%s %s%s (max)", spec.Label, fmtNum(now), spec.Suffix or "")
		end
	end
	ink({
		Text = previewText,
		TextSize = 16,
		Position = UDim2.fromOffset(10, 69),
		Size = UDim2.new(1, -20, 0, 18),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextScaled = true,
		Parent = card,
	})

	local cost = Config.UpgradeCost(def.Id, level, run.Level, run.ToolIndex)
	UIKit.Button({
		Text = if cost then UIKit.Short(cost) .. " coins" else "MAX",
		Size = UDim2.new(1, -20, 0, 42),
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -8),
		Color = if cost then Colors.Good else Colors.Disabled,
		Disabled = cost == nil or run.Coins &lt; (cost or 0),
		Sound = if cost then nil else false,
		Parent = card,
		OnClick = function()
			if cost then
				buy("BuyUpgrade", def.Id, card)
			end
		end,
	})
	return card
end

local function renderLeft(run: Types.RunState)
	clear(leftPage)
	local tool = Config.Tools[run.ToolIndex] or Config.Tools[1]
	ink({ Text = "In your hand", TextSize = 34, Size = UDim2.new(1, 0, 0, 38), Parent = leftPage })

	-- Current tool banner.
	local banner = tile(leftPage, UDim2.new(1, 0, 0, 92), UDim2.fromOffset(0, 42), Color3.fromRGB(255, 252, 240))
	local iconTile = tile(banner, UDim2.fromOffset(76, 76), UDim2.fromOffset(8, 8), tool.Color)
	UIKit.Label({ Text = tool.Icon, TextSize = 46, Size = UDim2.fromScale(1, 1), Stroke = false, Parent = iconTile })
	ink({
		Text = tool.Name,
		TextSize = 26,
		Position = UDim2.fromOffset(94, 8),
		Size = UDim2.new(1, -100, 0, 30),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextScaled = true,
		Parent = banner,
	})
	local s = run.Stats
	ink({
		Text = string.format(
			"Power %s/s   %s   Reach %s",
			fmtNum(s.Power),
			if s.Mode == "Line" then "Line " .. fmtNum(s.LineLength or 0)
				elseif s.Mode == "Foam" then "Splat " .. fmtNum(s.Radius)
				else "Size " .. fmtNum(s.Radius),
			fmtNum(s.Reach)
		),
		TextSize = 16,
		TextColor3 = INK_DIM,
		Position = UDim2.fromOffset(94, 42),
		Size = UDim2.new(1, -100, 0, 20),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextScaled = true,
		Parent = banner,
	})
	ink({
		Text = tool.Desc,
		TextSize = 14,
		TextColor3 = INK_DIM,
		Position = UDim2.fromOffset(94, 64),
		Size = UDim2.new(1, -100, 0, 18),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextScaled = true,
		Parent = banner,
	})

	local grid = Instance.new("Frame")
	grid.BackgroundTransparency = 1
	grid.Position = UDim2.fromOffset(0, 144)
	grid.Size = UDim2.new(1, 0, 1, -144)
	grid.Parent = leftPage
	local layout = Instance.new("UIGridLayout")
	layout.CellSize = UDim2.new(0.5, -6, 0, 140)
	layout.CellPadding = UDim2.fromOffset(12, 10)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = grid
	for i, def in Config.Upgrades do
		upgradeCard(grid, def, run, i)
	end
end

----------------------------------------------------------------------------------------------------
-- Right page: tool ladder + money
----------------------------------------------------------------------------------------------------

local function toolCard(parent: Instance, index: number, run: Types.RunState): Frame
	local tool = Config.Tools[index]
	local owned = run.OwnedTools ~= nil and run.OwnedTools[index] == true
	local inHand = index == run.ToolIndex
	local card = tile(parent, UDim2.fromOffset(120, 140), UDim2.new(), if owned then Color3.fromRGB(225, 250, 230) else Color3.fromRGB(255, 252, 240))
	card.LayoutOrder = index
	if inHand then
		UIKit.Stroke(card, Colors.Good, 3)
	end

	local iconTile = tile(card, UDim2.fromOffset(72, 58), UDim2.new(0.5, -36, 0, 8), tool.Color)
	UIKit.Label({ Text = tool.Icon, TextSize = 38, Size = UDim2.fromScale(1, 1), Stroke = false, Parent = iconTile })
	ink({
		Text = tool.Name,
		TextSize = 16,
		Position = UDim2.fromOffset(4, 68),
		Size = UDim2.new(1, -8, 0, 20),
		TextScaled = true,
		Parent = card,
	})

	if inHand then
		ink({
			Text = "In hand",
			TextSize = 16,
			TextColor3 = Color3.fromRGB(40, 150, 80),
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -12),
			Size = UDim2.new(1, -8, 0, 22),
			Parent = card,
		})
	elseif owned then
		UIKit.Button({
			Text = "Equip",
			Size = UDim2.new(1, -14, 0, 40),
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -6),
			Color = Colors.Primary,
			Parent = card,
			OnClick = function()
				buy("EquipTool", index, card)
			end,
		})
	else
		local cost = Config.ToolCost(index, run.Level) or 0
		UIKit.Button({
			Text = UIKit.Short(cost) .. " coins",
			Size = UDim2.new(1, -14, 0, 40),
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -6),
			Color = Colors.Coin,
			TextColor3 = Colors.Text,
			Disabled = run.Coins &lt; cost,
			Parent = card,
			OnClick = function()
				buy("BuyTool", index, card)
			end,
		})
	end
	return card
end

local function renderRight(run: Types.RunState)
	clear(rightPage)
	ink({ Text = "Tools (any order!)", TextSize = 30, Size = UDim2.new(1, 0, 0, 38), Parent = rightPage })

	local grid = Instance.new("Frame")
	grid.BackgroundTransparency = 1
	grid.Position = UDim2.fromOffset(0, 44)
	grid.Size = UDim2.new(1, 0, 1, -110)
	grid.Parent = rightPage
	local layout = Instance.new("UIGridLayout")
	layout.CellSize = UDim2.fromOffset(120, 140)
	layout.CellPadding = UDim2.fromOffset(12, 12)
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = grid
	for i in Config.Tools do
		toolCard(grid, i, run)
	end

	local money = Instance.new("Frame")
	money.BackgroundTransparency = 1
	money.AnchorPoint = Vector2.new(0.5, 1)
	money.Position = UDim2.new(0.5, 0, 1, -6)
	money.Size = UDim2.new(1, 0, 0, 50)
	money.Parent = rightPage
	ink({
		Text = "your money:",
		TextSize = 24,
		Size = UDim2.new(0.5, 0, 1, 0),
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = money,
	})
	UIKit.Label({
		Text = UIKit.Commas(run.Coins) .. " coins",
		TextSize = 30,
		TextColor3 = Color3.fromRGB(90, 235, 110),
		Position = UDim2.new(0.5, 10, 0, 0),
		Size = UDim2.new(0.5, -10, 1, 0),
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = money,
	})
end

----------------------------------------------------------------------------------------------------
-- Render / init
----------------------------------------------------------------------------------------------------

local function render()
	local run = ClientState.Run
	if not run then
		return
	end
	renderLeft(run)
	renderRight(run)
end

local function buildBook(content: Frame)
	book = Instance.new("Frame")
	book.Name = "Book"
	book.Size = UDim2.fromScale(1, 1)
	book.BackgroundColor3 = COVER
	book.BorderSizePixel = 0
	UIKit.Corner(book, 18)
	UIKit.Stroke(book, Colors.Ink, 3)
	book.Parent = content

	local function page(x: UDim, name: string): Frame
		local p = Instance.new("Frame")
		p.Name = name
		p.Position = UDim2.new(x.Scale, x.Offset, 0, 10)
		p.Size = UDim2.new(0.5, -18, 1, -20)
		p.BackgroundColor3 = PAGE
		p.BorderSizePixel = 0
		UIKit.Corner(p, 12)
		UIKit.Gradient(p, PAGE, Color3.fromRGB(245, 236, 210))
		UIKit.Stroke(p, PAGE_EDGE, 2)
		p.Parent = book
		local inner = Instance.new("Frame")
		inner.Name = "Inner"
		inner.BackgroundTransparency = 1
		inner.Size = UDim2.fromScale(1, 1)
		inner.Parent = p
		UIKit.Padding(inner, 14)
		return inner
	end
	leftPage = page(UDim.new(0, 12), "LeftPage")
	rightPage = page(UDim.new(0.5, 6), "RightPage")

	-- Spine rings down the middle.
	for i = 0, 7 do
		local ring = Instance.new("Frame")
		ring.AnchorPoint = Vector2.new(0.5, 0.5)
		ring.Position = UDim2.new(0.5, 0, (i + 0.5) / 8, 0)
		ring.Size = UDim2.fromOffset(16, 26)
		ring.BackgroundColor3 = Color3.fromRGB(230, 190, 90)
		ring.BorderSizePixel = 0
		ring.ZIndex = 3
		UIKit.Corner(ring, 999)
		UIKit.Stroke(ring, Color3.fromRGB(120, 90, 30), 2)
		ring.Parent = book
	end
end

function UpgradesUI.Init()
	if initialized then
		return
	end
	initialized = true

	local _gui, screenRoot = UIKit.CreateScreen("UpgradesUI", 10)

	local _window, windowContent = UIKit.Window({
		Name = "Upgrades",
		Title = "Upgrades",
		Icon = "📖",
		Size = WINDOW_SIZE,
		Parent = screenRoot,
	})
	buildBook(windowContent)

	UIKit.RegisterWindow("Upgrades", {
		Open = function()
			if not ClientState.InRun() then
				task.defer(UIKit.CloseWindow, "Upgrades")
				return
			end
			render()
		end,
	})

	ClientState.Changed:Connect(function(kind)
		if kind == "Run" then
			if not ClientState.Run then
				if UIKit.IsWindowOpen("Upgrades") then
					UIKit.CloseWindow("Upgrades")
				end
			elseif UIKit.IsWindowOpen("Upgrades") then
				render()
			end
		elseif kind == "Meta" and UIKit.IsWindowOpen("Upgrades") then
			render()
		end
	end)
end

return UpgradesUI</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000004A"><Properties><string name="Name">WaterFX</string><ProtectedString name="Source">--[[
	WaterFX - the water coming out of your own hose and pressure washer, built from real parts so
	it looks solid from every angle (a camera-facing Beam flattens to nothing when you look straight
	down it, which is exactly the first-person view).

	  * Hose (Spray Nozzle): 20 thin see-through streams fanning out from the nozzle over the
	    cleaning circle, around one thicker core stream. The streams wobble a little every frame
	    so the spray looks alive.
	  * Pressure Washer: a flat see-through sheet of water from the lance tip to the cleaning line
	    (across or up and down, whichever way the line is turned), with bright streaks running
	    through it and a hard jet down the middle.

	SprayController says what to draw each Heartbeat (Spray / Fan / Hide). The parts are placed in
	a RenderStep after the camera moves, from the nozzle's position that frame, so the
	water never lags behind or comes loose from the tip.
]]

local RunService = game:GetService("RunService")

local WaterFX = {}

local STREAMS = 20
local FAN_STREAKS = 9
local GOLDEN_ANGLE = math.pi * (3 - math.sqrt(5))
local WATER = Color3.fromRGB(190, 230, 255)
local WATER_DEEP = Color3.fromRGB(120, 195, 255)

local initialized = false
local folder: Folder? = nil
local streams: { BasePart } = {}
local core: BasePart? = nil
local fanA: BasePart? = nil
local fanB: BasePart? = nil
local fanStreaks: { BasePart } = {}
local jet: BasePart? = nil

-- What to draw: nil (nothing), "Spray" or "Fan", plus where.
local mode: string? = nil
local muzzle: BasePart? = nil
local target = Vector3.zero
local normal = Vector3.yAxis
local radius = 1
local lineA = Vector3.zero
local lineB = Vector3.zero

local function newPart(name: string, shape: Enum.PartType?, color: Color3, transparency: number): BasePart
	local p: BasePart
	if shape == nil then
		p = Instance.new("WedgePart")
	else
		local part = Instance.new("Part")
		part.Shape = shape
		p = part
	end
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.Neon
	p.Color = color
	p.Transparency = 1
	p:SetAttribute("Look", transparency)
	p.Size = Vector3.new(1, 0.1, 0.1)
	p.Parent = folder
	return p
end

local function build()
	if folder and folder.Parent then
		return
	end
	local f = Instance.new("Folder")
	f.Name = "WaterFX"
	f.Parent = workspace
	folder = f
	table.clear(streams)
	table.clear(fanStreaks)
	for i = 1, STREAMS do
		streams[i] = newPart("HoseStream", Enum.PartType.Cylinder, if i % 3 == 0 then WATER_DEEP else WATER, 0.45)
	end
	core = newPart("HoseCore", Enum.PartType.Cylinder, WATER, 0.3)
	fanA = newPart("WasherSheet", nil, WATER_DEEP, 0.62)
	fanB = newPart("WasherSheet", nil, WATER_DEEP, 0.62)
	for i = 1, FAN_STREAKS do
		fanStreaks[i] = newPart("WasherStreak", Enum.PartType.Cylinder, WATER, 0.35)
	end
	jet = newPart("WasherJet", Enum.PartType.Cylinder, Color3.fromRGB(235, 248, 255), 0.15)
end

local function show(p: BasePart, visible: boolean)
	p.Transparency = if visible then p:GetAttribute("Look") :: number else 1
end

-- A cylinder from `a` to `b`, `width` thick.
local function stretch(p: BasePart, a: Vector3, b: Vector3, width: number)
	local d = b - a
	local len = d.Magnitude
	if len &lt; 1e-3 then
		show(p, false)
		return
	end
	p.Size = Vector3.new(len, width, width)
	p.CFrame = CFrame.lookAt((a + b) / 2, b) * CFrame.Angles(0, math.rad(90), 0)
	show(p, true)
end

-- A flat triangle a-b-c made of two wedges (the usual right-angle split).
local function triangle(w1: BasePart, w2: BasePart, a: Vector3, b: Vector3, c: Vector3, thickness: number)
	local ab, ac, bc = b - a, c - a, c - b
	local abd, acd, bcd = ab:Dot(ab), ac:Dot(ac), bc:Dot(bc)
	if abd &gt; acd and abd &gt; bcd then
		c, a = a, c
	elseif acd &gt; bcd and acd &gt; abd then
		a, b = b, a
	end
	ab, ac, bc = b - a, c - a, c - b
	local cross = ac:Cross(ab)
	if cross.Magnitude &lt; 1e-4 or bc.Magnitude &lt; 1e-4 then
		show(w1, false)
		show(w2, false)
		return
	end
	local right = cross.Unit
	local up = bc:Cross(right).Unit
	local back = bc.Unit
	local height = math.abs(ab:Dot(up))
	w1.Size = Vector3.new(thickness, height, math.abs(ab:Dot(back)))
	w1.CFrame = CFrame.fromMatrix((a + b) / 2, right, up, back)
	w2.Size = Vector3.new(thickness, height, math.abs(ac:Dot(back)))
	w2.CFrame = CFrame.fromMatrix((a + c) / 2, -right, up, -back)
	show(w1, true)
	show(w2, true)
end

local function hideAll()
	for _, p in streams do
		show(p, false)
	end
	for _, p in fanStreaks do
		show(p, false)
	end
	for _, p in { core, fanA, fanB, jet } do
		if p then
			show(p, false)
		end
	end
end

local function render()
	if not folder then
		return
	end
	local m = muzzle
	if mode == nil or not m or not m.Parent then
		hideAll()
		return
	end
	local from = m.Position
	local t = os.clock()
	if mode == "Spray" then
		for _, p in fanStreaks do
			show(p, false)
		end
		for _, p in { fanA, fanB, jet } do
			if p then
				show(p, false)
			end
		end
		-- Spread the stream ends evenly over the cleaning circle (sunflower pattern), each
		-- wobbling on its own so the spray shimmers.
		local u = normal:Cross(if math.abs(normal.Y) &lt; 0.9 then Vector3.yAxis else Vector3.xAxis).Unit
		local v = normal:Cross(u).Unit
		for i, p in streams do
			local a = i * GOLDEN_ANGLE + math.sin(t * 7 + i * 1.7) * 0.12
			local r = radius * 0.9 * math.sqrt((i - 0.5) / STREAMS) * (1 + 0.08 * math.sin(t * 11 + i))
			local tip = target + (u * math.cos(a) + v * math.sin(a)) * r + normal * 0.05
			stretch(p, from, tip, 0.08 + 0.03 * (0.5 + 0.5 * math.sin(t * 13 + i * 2.3)))
		end
		if core then
			stretch(core, from, target + normal * 0.05, 0.2)
		end
	else
		for _, p in streams do
			show(p, false)
		end
		if core then
			show(core, false)
		end
		if fanA and fanB then
			triangle(fanA, fanB, from, lineA, lineB, 0.03)
		end
		for i, p in fanStreaks do
			local k = (i - 1) / (FAN_STREAKS - 1) + math.sin(t * 9 + i * 1.3) * 0.025
			stretch(p, from, lineA:Lerp(lineB, math.clamp(k, 0, 1)) + normal * 0.04, 0.045)
		end
		if jet then
			stretch(jet, from, lineA:Lerp(lineB, 0.5) + normal * 0.04, 0.1 + 0.02 * math.sin(t * 20))
		end
	end
end

-- The hose: from `nozzle` over the circle of `size` radius at `at` (surface `facing`).
function WaterFX.Spray(nozzle: BasePart, at: Vector3, facing: Vector3, size: number)
	mode = "Spray"
	muzzle = nozzle
	target = at
	normal = facing
	radius = size
end

-- The pressure washer: a sheet from `nozzle` to the line a-b on a surface facing `facing`.
function WaterFX.Fan(nozzle: BasePart, a: Vector3, b: Vector3, facing: Vector3)
	mode = "Fan"
	muzzle = nozzle
	lineA = a
	lineB = b
	normal = facing
end

function WaterFX.Hide()
	mode = nil
end

function WaterFX.Init()
	if initialized then
		return
	end
	initialized = true
	build()
	-- After the camera (Camera) and HoldPose (Camera + 1).
	RunService:BindToRenderStep("RinseCycleWater", Enum.RenderPriority.Camera.Value + 2, function()
		build()
		render()
	end)
end

return WaterFX</ProtectedString></Properties></Item>
</Item>
<Item class="LocalScript" referent="RBX0000004B"><Properties><string name="Name">AdminClient</string><bool name="Disabled">false</bool><ProtectedString name="Source">--[[
	AdminClient - Rinse Cycle's admin panel and the admin effects every player can see.

	Everyone:
	  * Notices from staff (a centred card with an OK button), announcements (a banner across the
	    top), and status chips under the top bar: 🧊 Frozen, 🔇 Muted (with time left; the chat bar
	    is switched off too), 🎮 Being controlled, 🕊️ Flying (tap it or press F to take off / land).
	  * The full-screen cover that hides admin teleports (jail, spectate, control).

	The owner only (the server's GetAdminInfo decides; nobody else gets any of the panel):
	  * A 🛡️ Admin button under Trade in the left column (HUD.AddAdminButton). It opens the Admin window,
	    built with the game's own UIKit window style.
	  * Left: every player in the server (search, tap to pick). Top: command groups. Middle: that
	    group's commands. Bottom: the picked command's options (reason, amount, duration, rank, pet,
	    pass...) and a RUN button. There's also a command line (":mute name reason") for speed.
	  * Ban / mute / warn lists, the command log and inventories open inside the window, with
	    Modify / Remove / View on each row.
	  * Spectate and Control Player show a bar at the bottom with a Stop button.

	The server checks every command again (tier, owner, Studio-only). This script only draws.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TextChatService = game:GetService("TextChatService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local Client = script.Parent:WaitForChild("Client")
local UIKit = require(Client:WaitForChild("UIKit"))
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local Colors = UIKit.Theme.Colors
local Fonts = UIKit.Theme.Fonts

local function remote(name: string): any
	return ReplicatedStorage:WaitForChild(name)
end

local GetAdminInfo = remote("GetAdminInfo")
local AdminCommand = remote("AdminCommand")
local AdminNotice = remote("AdminNotice")
local AdminFeedback = remote("AdminFeedback")
local AdminWarningsList = remote("AdminWarningsList")
local AdminViewWarnings = remote("AdminViewWarnings")
